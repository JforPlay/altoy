---
/**
 * Skin Detail Viewer — three-column console (renewal 2026-09-21).
 *
 * NOTHING sits above the art but the global navbar. The page-level top bar was
 * deleted in the 2026-09-21 polish round: 함순이 검색 and 찾아보기 · 랜덤 moved into
 * the rail's head (a column with a thousand spare pixels), and the skin's own
 * caption, the 일러 picker and the 표정 picker all FLOAT on the art instead of
 * stacking bands over it. That is worth ~143px of art height at 1080p, which is
 * the whole point — see §13 of the renewal doc.
 *
 * Static shell only. Every data region below is filled at runtime and its owner
 * is fixed by the DOM contract in dev/active/2026-09-21-skin-detail-viewer-renewal.md §3.1:
 *   controller (skin.detail.viewer.js) → #skin-rail, #skin-title/#skin-rarity/#skin-meta,
 *                                        #voice-tabs, #voice-bank, #voice-desc,
 *                                        #voice-list, #player-bar
 *   stage module (skin.detail.stage.js) → #skin-stage, #stage-art-label, #stage-tools,
 *                                        #stage-assets, #asset-rail, #stage-dock,
 *                                        #face-grid, #stage-viewer
 *   search module (skin.detail.search.js) → #sf-results / #sf-count inside #skin-search-modal
 * Those elements ship EMPTY on purpose — do not seed them with placeholder markup.
 *
 * The six legacy skin.detail.viewer.{header,gallery,content,responsive,dark-mode,expression}
 * sheets are deliberately NOT imported here any more; they now serve cn-preview.astro only.
 */
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/Modal.astro';
import '../../styles/common.css';
import '../../styles/skin/skin.common.css';
import '../../styles/rarity.css';
import '../../styles/skin/skin.detail.viewer.console.css';
import '../../styles/skin/skin.detail.viewer.stage.css';
import '../../styles/skin/skin.detail.viewer.voice.css';
import '../../styles/skin/skin.detail.viewer.search.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="함순이 스킨/대사보기" theme="accent" {base}>
    <div class="main-container sdv-page">
        <div class="sdv-console">
            <aside class="sdv-rail" aria-label="함순이 · 스킨 선택">
                <!-- The page's whole navigation, in the column that can afford it. -->
                <div class="sdv-rail-head">
                    <div class="sdv-rail-brand">
                        <h1 class="sdv-title">함순이 스킨 / 대사보기</h1>
                        <button id="info-button" class="info-button" aria-label="도움말 보기" type="button">
                            <i class="fas fa-info-circle" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="dropdown-container sdv-rail-pick">
                        <i class="fas fa-search sdv-pick-icon" aria-hidden="true"></i>
                        <input type="text" id="character-search-input" placeholder="함순이 이름으로 검색" autocomplete="off" aria-label="함순이 검색" aria-autocomplete="list" aria-controls="character-dropdown-content">
                        <div class="dropdown-icon"><i class="fas fa-chevron-down" aria-hidden="true"></i></div>
                        <div class="dropdown-content scroll-styled" id="character-dropdown-content" role="listbox"></div>
                    </div>

                    <button id="skin-browse-btn" class="btn btn-outline sdv-browse-btn" type="button" aria-haspopup="dialog" aria-controls="skin-search-modal" aria-label="함순이 찾아보기 또는 랜덤으로 보기">
                        <span class="sdv-browse-part"><i class="fas fa-search" aria-hidden="true"></i> 찾아보기</span>
                        <span class="sdv-browse-sep" aria-hidden="true"></span>
                        <span class="sdv-browse-part"><i class="fas fa-dice" aria-hidden="true"></i> 랜덤</span>
                    </button>
                </div>

                <p id="skin-rail-count" class="sdv-rail-count" aria-live="polite"></p>
                <div id="skin-rail" class="sdv-rail-list scroll-styled" role="group" aria-label="스킨 목록"></div>
            </aside>

            <main class="sdv-stage">
                <!-- Caption. Absolutely positioned over the art on a soft scrim, so
                     the skin's identity costs zero height above the picture. -->
                <header class="sdv-stage-head">
                    <h2 id="skin-title" class="sdv-stage-title"></h2>
                    <span id="skin-rarity" class="sdv-stage-rarity"></span>
                    <p id="skin-meta" class="sdv-stage-meta"></p>
                    <span id="stage-art-label" class="sdv-art-label"></span>
                    <div id="stage-tools" class="sdv-stage-tools"></div>
                </header>

                <div id="loading-skeleton" class="loading-skeleton sdv-skeleton hidden" aria-hidden="true">
                    <div class="skeleton-line skeleton-title"></div>
                    <div class="skeleton-line skeleton-text"></div>
                    <div class="skeleton-image sdv-skeleton-art"></div>
                </div>

                <div id="skin-stage" class="sdv-stage-body"></div>

                <!-- 일러 picker: a vertical glass column on the art's right edge. Six
                     cards at most, so it costs horizontal space and no height at all —
                     and its position never depends on how tall the art is, which is what
                     stranded it a screen below a 150px SD sprite before. -->
                <div id="stage-assets" class="sdv-assets sdv-glass">
                    <div id="asset-rail" class="sdv-asset-rail" role="group" aria-label="일러스트 종류 선택"></div>
                </div>

                <!-- 표정 picker: filled by the stage module. Folded to a pill by default
                     (0.5% of the drawing); the thumbnail row unfolds on hover, on focus,
                     or when pinned. Horizontal by necessity — face patches keep their own
                     box ratio, so a vertical strip runs past 1800px for 21 faces. -->
                <div id="stage-dock" class="sdv-dock sdv-glass"></div>
            </main>

            <section id="sdv-voice" class="sdv-voice" aria-label="대사">
                <button id="voice-toggle" class="sdv-voice-toggle" type="button" aria-expanded="true" aria-controls="sdv-voice" aria-label="대사 패널 접기">
                    <i class="fas fa-chevron-right" aria-hidden="true"></i>
                </button>
                <div class="sdv-voice-head">
                    <div id="voice-tabs" class="sdv-tabs" role="tablist" aria-label="대사 종류"></div>
                    <div id="voice-bank" class="sdv-voice-bank"></div>
                </div>
                <div id="voice-desc" class="sdv-voice-desc scroll-styled"></div>
                <div id="voice-list" class="sdv-voice-list scroll-styled"></div>
                <div id="player-bar" class="sdv-player"></div>
            </section>
        </div>
    </div>

    <div id="info-popup" class="info-popup" role="dialog" aria-labelledby="popup-title" aria-hidden="true">
        <div class="info-popup-content">
            <div class="popup-header">
                <h2 id="popup-title">초간단 설명서</h2>
                <button class="close-popup-btn" aria-label="닫기" type="button"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="popup-body">
                <div class="info-step">
                    <div class="info-icon">1</div>
                    <div class="info-content">
                        <h3>함순이를 고르기</h3>
                        <p>검색창에 이름을 입력하면 드랍다운에서 글자 검색이 가능합니다.</p>
                    </div>
                </div>
                <div class="info-step">
                    <div class="info-icon">2</div>
                    <div class="info-content">
                        <h3>고른 함순이의 스킨 고르기</h3>
                        <p>선택한 스킨의 대사를 전부 보고 들을 수 있습니다.</p>
                    </div>
                </div>
                <div class="warning-box">
                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                    <div>
                        <strong>주의사항</strong>
                        <p>서약 대사는 해당 스킨이 서약대사가 있을때만 보입니다.<br>극소수를 제외하면 거의 대부분 기본 스킨에만 서약대사가 보입니다.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <Modal id="skin-search-modal" title="함순이 찾아보기" maxWidth="960px">
        <div class="sdv-search-filters filter-bar">
            <!-- Name box FIRST and wider: it narrows the grid below, which is a
                 different job from the topbar combobox (that one JUMPS to a 함순이).
                 Keeping both is deliberate — see the renewal spec §6. -->
            <div class="sdv-search-field sdv-search-field--name">
                <label for="sf-name">이름</label>
                <input type="search" id="sf-name" placeholder="함순이 · 스킨 이름으로 좁히기" autocomplete="off">
            </div>
            <div class="sdv-search-field">
                <label for="sf-shiptype">함종</label>
                <select id="sf-shiptype"><option value="">전체</option></select>
            </div>
            <div class="sdv-search-field">
                <label for="sf-rarity">레어도</label>
                <select id="sf-rarity"><option value="">전체</option></select>
            </div>
            <div class="sdv-search-field">
                <label for="sf-nation">진영</label>
                <select id="sf-nation"><option value="">전체</option></select>
            </div>
            <div class="sdv-search-field">
                <label for="sf-gimmick">기믹</label>
                <select id="sf-gimmick"><option value="">전체</option></select>
            </div>
            <div class="sdv-search-field">
                <label for="sf-type">스킨 타입</label>
                <select id="sf-type"><option value="">전체</option></select>
            </div>
        </div>

        <div id="sf-results" class="sdv-search-results card-grid scroll-styled" aria-live="polite"></div>
        <button id="sf-more" class="btn btn-secondary sdv-search-more hidden" type="button">더 보기</button>

        <div class="sdv-search-foot">
            <span id="sf-count"></span>
            <span class="sdv-search-hint">고르기 어렵다면</span>
            <button id="sf-random" class="btn btn-primary" type="button">
                <i class="fas fa-dice" aria-hidden="true"></i> 이 중에서 랜덤으로 보기
            </button>
        </div>
    </Modal>

    <div id="face-grid" class="sdv-overlay hidden" role="dialog" aria-modal="true" aria-label="전체 표정"></div>
    <div id="stage-viewer" class="sdv-overlay hidden" role="dialog" aria-modal="true" aria-label="일러스트 전체화면"></div>

    <button id="voice-peek" class="sdv-voice-peek hidden" type="button" aria-label="대사 패널 열기">
        <i class="fas fa-comment-dots" aria-hidden="true"></i>
        <span>대사</span>
    </button>

    <script is:inline type="module" src={`${base}/js/skin/skin.detail.viewer.js`}></script>
</Layout>
