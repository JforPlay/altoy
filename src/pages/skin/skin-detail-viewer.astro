---
/**
 * Skin Detail Viewer
 * Converted from pages/skin/skin-detail-viewer.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/common.css';
import '../../styles/skin/skin.common.css';
import '../../styles/skin/skin.detail.viewer.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="함순이 스킨/대사보기 (Modern UI)" theme="accent" {base}>
    <div class="main-container">
        <header class="controls-header">
            <div class="title-wrapper">
                <h1 class="page-title">함순이 스킨 / 대사보기</h1>
                <button id="info-button" class="info-button" aria-label="도움말 보기" type="button">
                    <i class="fas fa-info-circle"></i>
                </button>
                <button id="random-skin-btn" class="random-skin-btn" title="랜덤 스킨 구경가기" aria-label="랜덤 스킨 구경가기" aria-expanded="false" aria-controls="random-skin-modal" type="button">
                    <i class="fas fa-dice"></i>
                    <span>랜덤 스킨 구경가기</span>
                </button>
            </div>

            <div id="info-popup" class="info-popup" role="dialog" aria-labelledby="popup-title" aria-hidden="true">
                <div class="info-popup-content">
                    <div class="popup-header">
                        <h2 id="popup-title">초간단 설명서</h2>
                        <button class="close-popup-btn" aria-label="닫기" type="button"><i class="fas fa-times"></i></button>
                    </div>
                    <div class="popup-body">
                        <div class="info-step">
                            <div class="info-icon">1</div>
                            <div class="info-content">
                                <h3>함순이를 고르기</h3>
                                <p>검색창에 이름을 입력하면 드랍다운에서 글자 검색이 가능합니다.</p>
                            </div>
                        </div>
                        <div class="info-step">
                            <div class="info-icon">2</div>
                            <div class="info-content">
                                <h3>고른 함순이의 스킨 고르기</h3>
                                <p>선택한 스킨의 대사를 전부 보고 들을 수 있습니다.</p>
                            </div>
                        </div>
                        <div class="warning-box">
                            <i class="fas fa-exclamation-triangle"></i>
                            <div>
                                <strong>주의사항</strong>
                                <p>서약 대사는 해당 스킨이 서약대사가 있을때만 보입니다.<br>극소수를 제외하면 거의 대부분 기본 스킨에만 서약대사가 보입니다.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="selectors">
                <div class="selector-wrapper">
                    <label for="character-search-input"><i class="fas fa-user"></i> 함순이 선택</label>
                    <div class="dropdown-container">
                        <input type="text" id="character-search-input" placeholder="함순이를 검색/선택해주세요..." autocomplete="off" aria-label="함순이 검색" aria-autocomplete="list" aria-controls="character-dropdown-content">
                        <div class="dropdown-icon"><i class="fas fa-chevron-down"></i></div>
                        <div class="dropdown-content" id="character-dropdown-content" role="listbox"></div>
                    </div>
                </div>
                <div class="selector-wrapper">
                    <label for="skin-search-input"><i class="fas fa-palette"></i> 스킨 선택</label>
                    <div class="dropdown-container">
                        <input type="text" id="skin-search-input" placeholder="함순이를 먼저 선택해주세요..." autocomplete="off" disabled aria-label="스킨 검색" aria-autocomplete="list" aria-controls="skin-dropdown-content">
                        <div class="dropdown-icon"><i class="fas fa-chevron-down"></i></div>
                        <div class="dropdown-content" id="skin-dropdown-content" role="listbox"></div>
                    </div>
                </div>
                <button id="clear-filters-btn" class="clear-btn" title="검색 초기화" aria-label="검색 초기화" type="button">
                    <i class="fas fa-redo-alt"></i>
                    <span>검색 초기화</span>
                </button>
            </div>
        </header>

        <div id="loading-skeleton" class="loading-skeleton hidden">
            <div class="skeleton-card">
                <div class="skeleton-line skeleton-title"></div>
                <div class="skeleton-line skeleton-text"></div>
                <div class="skeleton-line skeleton-text"></div>
            </div>
            <div class="skeleton-card skeleton-gallery">
                <div class="skeleton-image"></div>
            </div>
        </div>

        <div id="skin-info-box" class="skin-info-box card hidden"></div>
        <div id="image-gallery" class="image-gallery card hidden"></div>
        <div id="text-content-area" class="text-content-area hidden"></div>
        <div id="oath-table-area" class="text-content-area hidden"></div>
        <div id="asmr-table-area" class="text-content-area hidden"></div>
    </div>

    <div id="random-skin-modal" class="random-skin-modal" style="display: none;" role="dialog" aria-label="랜덤 스킨 선택" aria-modal="true" aria-hidden="true">
        <div class="random-skin-modal-backdrop"></div>
        <div class="random-skin-modal-content">
            <h3><i class="fas fa-dice"></i> 랜덤 스킨 구경가기</h3>
            <div class="random-skin-filters">
                <div class="random-filter-group">
                    <label for="random-rarity-filter">레어도</label>
                    <select id="random-rarity-filter"><option value="">전체</option></select>
                </div>
                <div class="random-filter-group">
                    <label for="random-type-filter">스킨 타입</label>
                    <select id="random-type-filter"><option value="">전체</option></select>
                </div>
                <div class="random-filter-group">
                    <label for="random-tag-filter">스킨 태그</label>
                    <select id="random-tag-filter"><option value="">전체</option></select>
                </div>
                <div class="random-filter-group">
                    <label for="random-nation-filter">진영</label>
                    <select id="random-nation-filter"><option value="">전체</option></select>
                </div>
            </div>
            <div class="random-skin-actions">
                <span id="random-skin-count" class="random-skin-count"></span>
                <button id="random-skin-go" class="btn btn-primary random-skin-go-btn" type="button"><i class="fas fa-random"></i> 랜덤 구경가기!</button>
                <button id="random-skin-close" class="btn btn-close random-skin-close-btn" type="button">닫기</button>
            </div>
        </div>
    </div>

    <div id="lightbox-modal" class="lightbox-modal" role="dialog" aria-label="이미지 확대 보기" aria-hidden="true">
        <button class="lightbox-close" aria-label="닫기" type="button"><i class="fas fa-times"></i></button>
        <button class="lightbox-download" aria-label="이미지 저장" type="button"><i class="fas fa-download"></i></button>
        <button class="lightbox-prev" aria-label="이전 이미지" type="button"><i class="fas fa-chevron-left"></i></button>
        <button class="lightbox-next" aria-label="다음 이미지" type="button"><i class="fas fa-chevron-right"></i></button>
        <div class="lightbox-content">
            <img id="lightbox-image" src="" alt="">
            <div class="lightbox-caption"></div>
        </div>
        <div class="lightbox-counter"></div>
    </div>

    <script is:inline type="module" src={`${base}/js/skin/skin.audio.js`}></script>
    <script is:inline type="module" src={`${base}/js/skin/skin.expression.js`}></script>
    <script is:inline type="module" src={`${base}/js/skin/skin.data.js`}></script>
    <script is:inline type="module" src={`${base}/js/skin/skin.detail.viewer.js`}></script>
</Layout>
