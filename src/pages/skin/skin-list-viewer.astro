---
/**
 * Skin List Viewer
 * Converted from pages/skin/skin-list-viewer.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/common.css';
import '../../styles/skin/skin.common.css';
import '../../styles/skin/skin.list.viewer.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람 스킨목록보기" theme="accent" {base}>
    <div class="main-container">
        <header class="page-header">
            <h1 class="page-title">
                함순이 스킨검색기
                <button id="info-button" class="info-button info-button-inline" aria-label="도움말 보기" type="button">
                    <i class="fas fa-info-circle"></i>
                </button>
            </h1>

            <div id="info-popup" class="info-popup" role="dialog" aria-labelledby="popup-title" aria-hidden="true">
                <div class="info-popup-content">
                    <div class="popup-header">
                        <h2 id="popup-title">초간단 설명서</h2>
                        <button class="close-popup-btn" aria-label="닫기" type="button"><i class="fas fa-times"></i></button>
                    </div>
                    <div class="popup-body">
                        <div class="info-step">
                            <div class="info-icon"><i class="fas fa-filter"></i></div>
                            <div class="info-content">
                                <h3>필터링 기능</h3>
                                <p>원하는 필터링을 선택하면 맞춰서 스킨 목록이 필터링됩니다. 레어도의 경우엔 선택된 레어도의 함순이들 스킨만 표시됩니다.</p>
                            </div>
                        </div>
                        <div class="info-step">
                            <div class="info-icon"><i class="fas fa-mouse-pointer"></i></div>
                            <div class="info-content">
                                <h3>상세 페이지 이동</h3>
                                <p>해당 스킨의 이미지를 클릭하면 상세정보/대사 페이지로 이동됩니다.</p>
                            </div>
                        </div>
                        <div class="info-step">
                            <div class="info-icon"><i class="fas fa-heart"></i></div>
                            <div class="info-content">
                                <h3>내 컬렉션</h3>
                                <p>각 스킨 카드에 마우스를 올리면 <strong><i class="fas fa-check"></i> 보유</strong>와 <strong><i class="fas fa-heart"></i> 찜</strong> 버튼이 나타납니다. 보유 중인 스킨과 사고 싶은 스킨을 표시해보세요! 찜한 스킨은 오른쪽 하단 <strong><i class="fas fa-shopping-cart"></i> 장바구니</strong>에서 총 가격과 함께 확인할 수 있습니다.</p>
                            </div>
                        </div>
                        <div class="warning-box">
                            <i class="fas fa-exclamation-triangle"></i>
                            <div>
                                <strong>주의사항</strong>
                                <p>ex 대사 있는 함순이 체크박스는 스킨에 서약대사가 있는 경우에만 표시됩니다. 거의 대다수가 기본스킨에만 서약대사가 있으니 스킨 타입 필터링이 전체 혹은 기본인지 확인해주세요.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="search-container">
            <div class="search-input-group">
                <label for="search-input" class="search-label">함순이/스킨 이름검색 </label>
                <div class="autocomplete-wrapper">
                    <input type="text" id="search-input" placeholder="함순이 또는 스킨 이름을 검색...">
                </div>
            </div>
            <select id="sort-select" class="sort-select">
                <option value="default">정렬: 기본</option>
                <option value="release-desc">출시일 ↓</option>
                <option value="release-asc">출시일 ↑</option>
                <option value="rerun-desc">최근복각 ↓</option>
                <option value="rerun-asc">최근복각 ↑</option>
            </select>
            <button id="clear-all-btn" class="btn btn-danger" title="Clear All Filters" type="button">
                <i class="fas fa-redo-alt"></i> 필터 초기화
            </button>
        </div>

        <button id="filter-toggle-btn" class="filter-toggle-btn" type="button" aria-expanded="false" aria-controls="filter-container">
            필터 옵션 보기/숨기기
            <i class="fas fa-chevron-down"></i>
        </button>

        <div class="filter-container" id="filter-container">
            <div class="filter-group">
                <label for="skin-type-select">스킨 타입</label>
                <select id="skin-type-select">
                    <option value="all">전체</option>
                    <option>크리스마스</option><option>정월</option><option>이스트 글림 스타일</option>
                    <option>학교</option><option>수영복</option><option>파티</option><option>할로윈</option>
                    <option>사복</option><option>여름 축제</option><option>Live</option><option>특수 훈련</option>
                    <option>스포츠</option><option>극속광열</option><option>병원</option><option>카니발</option>
                    <option>메이드 타임</option><option>블러드 문</option><option>동화 속 세계</option><option>홈웨어</option>
                    <option>댄스</option><option>온천 타임</option><option>오피스 타임</option><option>이세계 모험</option>
                    <option>웨스턴</option><option>이집트 스타일</option><option>닌자의 성</option><option>기본</option>
                    <option>개조</option><option>서약</option><option>기타</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="tag-select">스킨 태그</label>
                <select id="tag-select">
                    <option value="all">전체</option>
                    <option>듀얼</option><option>L2D+</option><option>L2D</option><option>쁘띠모션</option><option>ASMR</option><option>X</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="period-select">판매 기간</label>
                <select id="period-select">
                    <option value="all">전체</option><option value="한정">한정</option><option value="상시">상시</option>
                </select>
            </div>
            <div class="filter-group">
                <label>함순이 레어도</label>
                <div id="rarity-checkboxes" class="checkbox-group">
                    <label><input type="checkbox" value="all" checked> 전체보기</label>
                    <label><input type="checkbox" value="UR"> UR</label>
                    <label><input type="checkbox" value="SSR"> SSR</label>
                    <label><input type="checkbox" value="SR"> SR</label>
                    <label><input type="checkbox" value="R"> R</label>
                    <label><input type="checkbox" value="N"> N</label>
                </div>
            </div>
            <div class="filter-group">
                <label for="faction-select">함순이 진영</label>
                <select id="faction-select">
                    <option value="all">전체</option>
                    <option>UNIV</option><option>USS</option><option>HMS</option><option>IJN</option><option>KMS</option>
                    <option>ROC</option><option>RN</option><option>SN</option><option>FFNF (FF, iris libre)</option>
                    <option>MNF</option><option>FFNF (FR, iris orthodoxy)</option><option>HNLMS</option>
                    <option>MOT</option><option>META</option>
                    <option>UNIV (bulin)</option><option>LINK (collab)</option><option>HDN (neptune)</option><option>BILI</option>
                    <option>UM (utawarerumono)</option><option>AI (kizuna)</option><option>HOLO</option><option>DOA</option>
                    <option>IMAS</option><option>SSSS</option><option>RYZA</option><option>SENRAN</option>
                    <option>ToLove</option><option>BRS</option><option>YUMIA</option>
                    <option>DanMachi</option><option>DateALive</option>
                </select>
            </div>
        </div>

        <div class="filter-footer">
            <span class="hint-icons"><i class="fas fa-check"></i> 보유 &nbsp; <i class="fas fa-heart"></i> 찜 표시</span>
            <span class="filter-footer-divider"></span>
            <label class="filter-footer-label">내 컬렉션</label>
            <select id="ownership-select" class="ownership-select">
                <option value="all">전체</option>
                <option value="owned">보유중</option>
                <option value="not-owned">미보유</option>
                <option value="wanted">찜</option>
            </select>
            <span class="filter-footer-divider"></span>
            <label class="hint-checkbox"><input type="checkbox" id="ex-dialogue-checkbox"> ex 대사 있는 스킨만 보기</label>
            <span id="result-count" class="result-count"></span>
        </div>

        <div class="skin-section" id="new-skins-section">
            <h2>판매 중인 한정 신상/복각 스킨들</h2>
            <div id="new-skins-container" class="skin-list-container"></div>
        </div>
        <div class="skin-section" id="limited-skins-section">
            <h2>한정 스킨 (Limited)</h2>
            <div id="limited-skins-container" class="skin-list-container"></div>
        </div>
        <div class="skin-section" id="permanent-skins-section">
            <h2>상시 스킨 (Permanent)</h2>
            <div id="permanent-skins-container" class="skin-list-container"></div>
        </div>
        <div class="skin-section" id="other-skins-section">
            <h2>기타 스킨 - 콜라보 / 배포한정 / 상설화 (Other)</h2>
            <div id="other-skins-container" class="skin-list-container"></div>
        </div>
    </div>

    <!-- Image Popup (Lightbox) -->
    <div id="image-popup" class="image-popup" role="dialog" aria-label="스킨 이미지 확대 보기" aria-modal="true" aria-hidden="true">
        <div class="image-popup-content">
            <button class="btn btn-close close-image-popup-btn" aria-label="닫기" type="button">&times;</button>
            <img id="popup-full-image" class="popup-image" src="" alt="전체일러">
            <div class="popup-skin-info">
                <div class="popup-skin-name" id="popup-skin-name"></div>
                <div class="popup-char-name" id="popup-char-name"></div>
                <a id="popup-detail-link" class="popup-detail-link" href="#">
                    <i class="fas fa-info-circle"></i> 상세정보 / 대사 보기
                </a>
            </div>
        </div>
    </div>

    <!-- Owned Showcase FAB -->
    <button id="owned-fab" class="owned-fab" title="내 옷장 (보유 스킨)" type="button" aria-label="내 옷장 열기">
        <i class="fas fa-shirt"></i>
        <span id="owned-badge" class="badge badge--count cart-badge">0</span>
    </button>

    <!-- Owned Showcase Modal -->
    <div id="owned-modal" class="cart-modal" style="display:none" role="dialog" aria-label="내 옷장" aria-modal="true" aria-hidden="true">
        <div class="cart-modal-content">
            <div class="cart-header">
                <h2><i class="fas fa-shirt"></i> 내 옷장</h2>
                <div class="cart-header-actions">
                    <div class="owned-group-toggle btn-group">
                        <button class="btn btn-secondary btn-sm owned-toggle-btn is-active" data-group="type" type="button" aria-pressed="true">스킨 타입</button>
                        <button class="btn btn-secondary btn-sm owned-toggle-btn" data-group="tag" type="button" aria-pressed="false">스킨 태그</button>
                    </div>
                    <button class="btn btn-close cart-close-btn" aria-label="닫기" type="button">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="owned-hint">보유 표시해둔 스킨이 여기 표시됩니다</div>
            <div id="owned-body" class="cart-body"></div>
            <div id="owned-footer" class="cart-footer">
                <div class="cart-summary">
                    <div class="cart-summary-row">
                        <span>보유 스킨</span>
                        <span id="owned-count">0개</span>
                    </div>
                    <div class="cart-summary-row">
                        <span><img src={`${base}/assets/icon/60px-Ruby.webp`} class="gem-icon" alt="Gem"> 총 가치</span>
                        <span id="owned-total-gems">0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cart FAB -->
    <button id="cart-fab" class="cart-fab" title="장바구니 (찜 목록)" type="button" aria-label="장바구니 열기">
        <i class="fas fa-shopping-cart"></i>
        <span id="cart-badge" class="badge badge--count cart-badge">0</span>
    </button>

    <!-- Cart Modal -->
    <div id="cart-modal" class="cart-modal" style="display:none" role="dialog" aria-label="장바구니" aria-modal="true" aria-hidden="true">
        <div class="cart-modal-content">
            <div class="cart-header">
                <h2><i class="fas fa-shopping-cart"></i> 장바구니</h2>
                <div class="cart-header-actions">
                    <button id="cart-buyall-btn" class="btn btn-secondary btn-sm cart-buyall-btn" title="모두 보유표시" type="button">
                        <i class="fas fa-check-double"></i> 모두 보유표시
                    </button>
                    <button id="cart-share-btn" class="btn btn-secondary btn-sm" title="공유용 보기" type="button">
                        <i class="fas fa-camera"></i> 캡처용
                    </button>
                    <button id="cart-back-btn" class="btn btn-secondary btn-sm" title="돌아가기" style="display:none" type="button">
                        <i class="fas fa-arrow-left"></i> 돌아가기
                    </button>
                    <button class="btn btn-close cart-close-btn" aria-label="닫기" type="button">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div id="cart-body" class="cart-body"></div>
            <div id="cart-footer" class="cart-footer">
                <div class="cart-summary">
                    <div class="cart-summary-row">
                        <span>찜한 스킨</span>
                        <span id="cart-count">0개</span>
                    </div>
                    <div class="cart-summary-row">
                        <span><img src={`${base}/assets/icon/60px-Ruby.webp`} class="gem-icon" alt="Gem"> 필요 다이아</span>
                        <span id="cart-total-gems">0</span>
                    </div>
                    <div class="cart-summary-row cart-krw">
                        <span>예상 금액</span>
                        <span id="cart-total-krw">약 0원</span>
                    </div>
                    <div class="cart-summary-row cart-truck">
                        <span>깡트럭 환산</span>
                        <span id="cart-total-truck">0 깡트럭</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="progress-bar" class="progress-bar"></div>

    <script is:inline type="module" src={`${base}/js/skin/skin.list.viewer.js`}></script>
</Layout>
