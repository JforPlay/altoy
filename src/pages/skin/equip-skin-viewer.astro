---
/**
 * Equipment Skin Viewer — Browse and preview equipment cosmetic skins
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/common.css';
import '../../styles/skin/skin.common.css';
import '../../styles/simulators/sim.common.css';
import '../../styles/skin/equip-skin-viewer.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="장비 스킨 뷰어" theme="accent" {base}>
    <div class="sim-page">
        <header class="sim-header">
            <div class="header-title-container">
                <span class="material-symbols-outlined header-icon">palette</span>
                <h1>장비 스킨 뷰어</h1>
            </div>
        </header>

        <!-- Simulation Canvas -->
        <div id="simulation-container">
            <div id="fps-display">FPS: --</div>
            <div id="player-area"></div>
            <div id="vanguard">
                <img src={`${base}/assets/img/vanguard_chibi.webp`} alt="vanguard">
            </div>
            <div id="enemy">
                <img src={`${base}/assets/img/enemy_chibi.webp`} alt="enemy">
            </div>
            <div id="visual-log"></div>
        </div>

        <!-- Playback Controls -->
        <div class="playback-bar">
            <button id="fire-button" class="btn btn-primary" type="button">
                <span class="material-symbols-outlined">play_arrow</span>
                발사
            </button>
            <button id="loop-button" class="btn btn-secondary" title="자동 반복" type="button" aria-label="자동 반복" aria-pressed="false">
                <span class="material-symbols-outlined">repeat</span>
            </button>
            <div class="speed-control" role="group" aria-label="재생 속도">
                <button class="speed-btn" data-speed="0.5" type="button" aria-pressed="false">0.5x</button>
                <button class="speed-btn active" data-speed="1" type="button" aria-pressed="true">1x</button>
                <button class="speed-btn" data-speed="2" type="button" aria-pressed="false">2x</button>
                <button class="speed-btn" data-speed="3" type="button" aria-pressed="false">3x</button>
            </div>
            <button id="pause-button" class="btn btn-icon" title="일시정지" type="button" aria-label="일시정지" aria-pressed="false">
                <span class="material-symbols-outlined">pause</span>
            </button>
        </div>

        <!-- Main Content: Theme Sidebar + Skin Area -->
        <div class="esv-content">
            <!-- Left: Theme Sidebar -->
            <aside class="esv-sidebar">
                <div class="esv-sidebar-header">
                    <h3>테마</h3>
                    <span id="theme-total-count" class="esv-theme-total" aria-live="polite"></span>
                </div>
                <input type="text" id="theme-search" class="search-input" placeholder="테마 검색..." aria-label="테마 검색" />
                <div id="theme-list" class="esv-theme-list scroll-styled" role="group" aria-label="장비 스킨 테마"></div>
            </aside>

            <!-- Right: Skin Info + Grid -->
            <div class="esv-main">
                <!-- Selected Skin Info -->
                <div id="skin-info" class="card esv-skin-info hidden" aria-live="polite">
                    <div class="esv-skin-info-content">
                        <img id="skin-icon" class="esv-skin-icon" src="" alt="" />
                        <div class="esv-skin-meta">
                            <h3 id="skin-name"></h3>
                            <p id="skin-desc" class="esv-skin-desc"></p>
                            <div id="skin-type-chips" class="esv-type-chips"></div>
                        </div>
                        <img id="skin-sprite-preview" class="esv-sprite-preview" src="" alt="" />
                    </div>
                </div>

                <!-- Skin Grid -->
                <div id="skin-grid-container">
                    <div class="card placeholder-card">
                        <p>테마를 선택하여 스킨을 확인하세요.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline type="module" src={`${base}/js/skin/equip-skin-viewer.js`}></script>
</Layout>
