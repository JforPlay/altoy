---
/**
 * Skin SD Viewer (Spine animation viewer)
 * Converted from pages/skin/skin-sd-viewer.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/common.css';
import '../../styles/skin/skin.sd.viewer.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람항로 설비스킨 뷰어" theme="accent" {base}>
    <Fragment slot="head">
        <script is:inline src="https://cdn.jsdelivr.net/npm/pixi.js@5.3.12/dist/pixi.min.js"></script>
        <!-- Patches PIXI's ShaderSystem so it doesn't use new Function() — required under our strict CSP (no 'unsafe-eval'). Must load before pixi-spine. -->
        <script is:inline src="https://cdn.jsdelivr.net/npm/@pixi/unsafe-eval@5.3.12/dist/unsafe-eval.min.js"></script>
        <script is:inline src="https://cdn.jsdelivr.net/npm/pixi-spine@2.1.14/dist/pixi-spine.min.js"></script>
    </Fragment>

    <div class="container">
        <h1>벽람항로 설비스킨 뷰어</h1>

        <div id="status" class="status" role="status" aria-live="polite">캐릭터를 선택하여 애니메이션 보기</div>

        <div class="viewer-section">
            <div class="viewer-box">
                <h2>애니메이션 미리보기</h2>
                <div id="spineContainer"></div>
            </div>

            <div class="viewer-box">
                <h2>컨트롤</h2>
                <div class="control-group">
                    <label for="charSelect">캐릭터 선택</label>
                    <select id="charSelect"><option value="">-- 캐릭터를 선택하세요 --</option></select>
                </div>
                <div class="control-group">
                    <label for="equipSelect">장비 스킨 선택</label>
                    <select id="equipSelect"><option value="">-- 장비 스킨을 선택하세요 --</option></select>
                </div>
                <div class="control-group">
                    <label id="displayModeLabel">디스플레이 모드</label>
                    <div class="btn-group" id="displayModeBtns" role="group" aria-labelledby="displayModeLabel">
                        <button id="charOnlyBtn" class="btn btn-secondary btn-sm is-active" type="button" aria-pressed="true">캐릭터만</button>
                        <button id="equipOnlyBtn" class="btn btn-secondary btn-sm" type="button" aria-pressed="false">장비만</button>
                        <button id="bothBtn" class="btn btn-secondary btn-sm" type="button" aria-pressed="false">둘 다 표시</button>
                    </div>
                </div>

                <div id="animationControls" class="hidden">
                    <div class="control-group">
                        <label>애니메이션 (<span id="animCount">0</span>)</label>
                        <div class="animation-list" id="animationList"></div>
                    </div>
                    <div class="control-group">
                        <label>스킨 (<span id="skinCount">0</span>)</label>
                        <div class="skin-list" id="skinList"></div>
                    </div>
                    <div class="control-group">
                        <label>크기: <span id="scaleValue">100</span>%</label>
                        <input type="range" id="scale" min="20" max="300" value="100" step="5">
                    </div>
                    <div class="control-group">
                        <label>애니메이션 속도: <span id="speedValue">100</span>%</label>
                        <input type="range" id="speed" min="10" max="200" value="100" step="5">
                    </div>
                    <div class="control-group">
                        <label style="font-weight: normal; display: flex; align-items: center;">
                            <input type="checkbox" id="loopAnim" checked>
                            애니메이션 반복
                        </label>
                    </div>
                    <div class="button-row">
                        <button id="playBtn" class="btn btn-primary" type="button">재생</button>
                        <button id="pauseBtn" class="btn btn-secondary" type="button">일시정지</button>
                    </div>
                    <button id="resetBtn" class="btn btn-secondary btn-block" type="button">위치 초기화</button>
                </div>
            </div>
        </div>
    </div>

    <script is:inline type="module" src={`${base}/js/skin/skin.sd.viewer.js`}></script>
</Layout>
