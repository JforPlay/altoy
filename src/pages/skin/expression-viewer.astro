---
/**
 * Expression Viewer
 * Converted from pages/skin/expression-viewer.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/skin/skin.common.css';
import '../../styles/skin/expression.viewer.css';
---

<Layout title="표정 일러스트 뷰어">
    <div class="main-container">
        <header class="controls-header">
            <div class="title-wrapper">
                <h1 class="page-title">표정 일러스트 뷰어</h1>
                <button id="info-button" class="info-button" aria-label="도움말 보기">
                    <i class="fas fa-info-circle"></i>
                </button>
            </div>

            <div id="info-popup" class="info-popup" role="dialog" aria-labelledby="popup-title" aria-hidden="true">
                <div class="info-popup-content">
                    <div class="popup-header">
                        <h2 id="popup-title">표정 일러스트 뷰어 사용법</h2>
                        <button class="close-popup-btn" aria-label="닫기"><i class="fas fa-times"></i></button>
                    </div>
                    <div class="popup-body">
                        <div class="info-step">
                            <div class="info-icon">1</div>
                            <div class="info-content">
                                <h3>캐릭터 검색</h3>
                                <p>검색창에서 캐릭터 이름 또는 ID로 검색할 수 있습니다.</p>
                            </div>
                        </div>
                        <div class="info-step">
                            <div class="info-icon">2</div>
                            <div class="info-content">
                                <h3>표정 선택</h3>
                                <p>썸네일을 클릭하면 해당 표정으로 변경됩니다.</p>
                            </div>
                        </div>
                        <div class="info-step">
                            <div class="info-icon">3</div>
                            <div class="info-content">
                                <h3>확대 일러</h3>
                                <p>확대 일러(painting_n)가 있는 경우 탭으로 전환할 수 있습니다.</p>
                            </div>
                        </div>
                        <div class="warning-box">
                            <i class="fas fa-info-circle"></i>
                            <div>
                                <strong>안내</strong>
                                <p>이 페이지는 스킨/대사보기 페이지에 없는 일러스트를 보여줍니다.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="search-section">
                <div class="dropdown-container">
                    <input type="text" id="search-input" placeholder="캐릭터 이름 또는 ID로 검색..." autocomplete="off" aria-label="캐릭터 검색" aria-autocomplete="list" aria-controls="search-dropdown">
                    <div class="dropdown-icon"><i class="fas fa-search"></i></div>
                    <div class="dropdown-content" id="search-dropdown" role="listbox"></div>
                </div>
                <div class="stats-display">
                    <span id="total-count">0</span>개의 일러스트
                </div>
            </div>
        </header>

        <div id="loading-state" class="loading-state">
            <div class="spinner"></div>
            <p>데이터 로딩 중...</p>
        </div>

        <div id="main-content" class="main-content hidden">
            <aside id="character-list" class="character-list">
                <div class="list-header">
                    <h2>캐릭터 목록</h2>
                    <span class="list-count" id="filtered-count">0개</span>
                </div>
                <div id="character-grid" class="character-grid"></div>
            </aside>

            <main id="viewer-panel" class="viewer-panel">
                <div class="viewer-placeholder">
                    <i class="fas fa-image"></i>
                    <p>왼쪽에서 캐릭터를 선택하세요</p>
                </div>
            </main>
        </div>
    </div>

    <div id="lightbox-modal" class="lightbox-modal" role="dialog" aria-label="이미지 확대 보기" aria-hidden="true">
        <button class="lightbox-close" aria-label="닫기"><i class="fas fa-times"></i></button>
        <div class="lightbox-content">
            <img id="lightbox-image" src="" alt="">
            <div class="lightbox-caption"></div>
        </div>
    </div>

    <script is:inline type="module" src="/altoy/js/skin/expression.viewer.js"></script>
</Layout>
