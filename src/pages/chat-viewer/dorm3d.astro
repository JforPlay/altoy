---
/**
 * 3D숙소 JUUS — the 3D 숙소 쥬톡 on the same two-pane messenger as JUUS 보기.
 * Shell: src/components/ChatViewerApp.astro; engine: chat-viewer.engine.js.
 */
import Layout from '../../layouts/Layout.astro';
import ChatViewerApp from '../../components/ChatViewerApp.astro';
import '../../styles/chat-viewer/chat-viewer.common.vars.css';
import '../../styles/chat-viewer/chat-viewer.common.base.css';
import '../../styles/chat-viewer/chat-viewer.common.sidebar.css';
import '../../styles/chat-viewer/chat-viewer.common.header.css';
import '../../styles/chat-viewer/chat-viewer.common.messages.css';
import '../../styles/chat-viewer/chat-viewer.common.special.css';
import '../../styles/chat-viewer/chat-viewer.common.responsive.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람항로 3D숙소 쥬톡보기" bodyClass="chat-viewer" {base}>
    <div class="chat-page">
        <header class="page-header">
            <h1 class="page-header-title">벽람항로 3D숙소 쥬톡</h1>
        </header>
        <ChatViewerApp />
    </div>

    <script is:inline type="module" src={`${base}/js/chat-viewer/dorm3d.js`}></script>
</Layout>
