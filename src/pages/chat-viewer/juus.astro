---
/**
 * JUUS 보기 — 쥬톡 as a two-pane messenger (chat list + search | open chat),
 * with 재생 / 전체 대본 modes. Shell: src/components/ChatViewerApp.astro;
 * engine: public/js/chat-viewer/chat-viewer.engine.js (shared with dorm3d.astro).
 */
import Layout from '../../layouts/Layout.astro';
import ChatViewerApp from '../../components/ChatViewerApp.astro';
import '../../styles/chat-viewer/chat-viewer.common.vars.css';
import '../../styles/chat-viewer/chat-viewer.common.base.css';
import '../../styles/chat-viewer/chat-viewer.common.sidebar.css';
import '../../styles/chat-viewer/chat-viewer.common.header.css';
import '../../styles/chat-viewer/chat-viewer.common.messages.css';
import '../../styles/chat-viewer/chat-viewer.common.special.css';
import '../../styles/chat-viewer/chat-viewer.common.responsive.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람항로 쥬톡 뷰어" bodyClass="chat-viewer" {base}>
    <div class="chat-page">
        <header class="page-header">
            <h1 class="page-header-title">
                <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                벽람항로 쥬톡 뷰어
            </h1>
        </header>
        <ChatViewerApp />
    </div>

    <script is:inline type="module" src={`${base}/js/chat-viewer/juus.js`}></script>
</Layout>
