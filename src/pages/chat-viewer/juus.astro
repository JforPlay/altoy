---
/**
 * JUUS Chat Viewer
 * Converted from pages/chat-viewer/juus.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/chat-viewer/chat-viewer.common.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람항로 쥬톡 뷰어" {base}>
    <header class="main-header">
        <h1>벽람항로 쥬톡 뷰어</h1>
    </header>

    <main class="content-container">
        <section id="character-selection-section">
            <h3>
                1. 캐릭터/그룹 선택
                <span class="selected-character-display" id="selected-character-name"></span>
            </h3>
            <div id="character-selector-grid" class="character-grid juus">
                 <p class="loading-message">캐릭터 정보 불러오는 중...</p>
            </div>
        </section>

        <section id="story-display-section" class="hidden juus">
            <div class="story-controls">
                <div class="story-controls-left">
                    <div class="story-select-wrapper">
                        <label for="story-dropdown" class="story-select-label">2. 스토리 선택 :</label>
                        <select id="story-dropdown" autocomplete="off"></select>
                    </div>
                    <div id="flavor-text-box" class="flavor-text-box">
                        <p id="unlock-desc-text"></p>
                    </div>
                </div>
                <button id="restart-button" class="restart-button">다시 재생하기</button>
            </div>

            <div class="story-container" id="story-container"></div>
            <div class="options-container juus" id="options-container"></div>
        </section>
    </main>

    <script is:inline type="module" src={`${base}/js/chat-viewer/juus.js`}></script>
</Layout>
