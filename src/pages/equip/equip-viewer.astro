---
/**
 * Equipment Viewer
 * Browse, search, filter, and compare Azur Lane equipment data
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/equip/equip.style.css';
import '../../styles/equip/equip.detail.css';
import '../../styles/equip/equip.compare.css';
import '../../styles/equip/equip.hearing.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="장비 DB" {base}>
    <div id="app">
        <!-- ===== List View ===== -->
        <div id="mainView" class="view">
            <header class="equip-header">
                <div class="header-top">
                    <div class="header-title-container">
                        <span class="material-symbols-outlined">settings</span>
                        <h1>장비 DB</h1>
                        <div class="credits" id="creditsInfo">
                            <button class="credits-trigger" id="creditsTrigger" type="button"
                                    aria-label="출처 · Special thanks to" aria-expanded="false" aria-controls="creditsBubble">
                                <i class="fas fa-info-circle"></i>
                            </button>
                            <div class="credits-bubble" id="creditsBubble" role="tooltip">
                                <p class="credits-title">한줄평 출처 · Special thanks to</p>
                                <p class="credits-line">
                                    많은 원본 코멘트 출처 : <a href="https://arca.live/b/azurlane/45593816" target="_blank" rel="noopener noreferrer">장비설명회 ↗</a>
                                </p>
                                <p class="credits-line">
                                    여러 챈 유저들의 재능 기부 : <a href="https://arca.live/b/azurlane/173732729" target="_blank" rel="noopener noreferrer">챈글 링크 ↗</a>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="header-controls">
                        <div class="stats-container">
                            <div class="stat-item">
                                <span class="stat-label">총 장비:</span>
                                <span class="stat-value" id="totalCount">0</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">표시 중:</span>
                                <span class="stat-value" id="filteredCount">0</span>
                            </div>
                        </div>
                        <div class="view-toggle" id="viewToggle" role="tablist" aria-label="보기 방식">
                            <button class="view-toggle-btn" type="button" data-view="grid" role="tab" aria-selected="false" title="간략히 — 아이콘 그리드">
                                <span class="material-symbols-outlined">grid_view</span>
                                <span class="view-toggle-label">간략히</span>
                            </button>
                            <button class="view-toggle-btn active" type="button" data-view="hearing" role="tab" aria-selected="true" title="자세히 — 별명·한줄평">
                                <span class="material-symbols-outlined">view_agenda</span>
                                <span class="view-toggle-label">자세히</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="search-filter-container">
                    <input type="text" id="searchInput" placeholder="장비 이름/별명, 한줄평 검색">
                    <div class="rarity-chips-container" id="rarityChips">
                        <button class="rarity-chip rarity-chip-2" type="button" data-rarity="2">N</button>
                        <button class="rarity-chip rarity-chip-3" type="button" data-rarity="3">R</button>
                        <button class="rarity-chip rarity-chip-4" type="button" data-rarity="4">SR</button>
                        <button class="rarity-chip rarity-chip-5" type="button" data-rarity="5">SSR</button>
                        <button class="rarity-chip rarity-chip-6" type="button" data-rarity="6">UR</button>
                    </div>
                    <select id="typeFilter">
                        <option value="">모든 장비</option>
                    </select>
                    <select id="nationalityFilter">
                        <option value="">모든 진영</option>
                    </select>
                    <div class="sort-container">
                        <select id="sortStat">
                            <option value="">정렬 없음</option>
                            <option value="cannon">포격</option>
                            <option value="torpedo">뇌장</option>
                            <option value="air">항공</option>
                            <option value="antiaircraft">대공</option>
                            <option value="hit">명중</option>
                            <option value="dodge">기동</option>
                            <option value="durability">내구</option>
                            <option value="reload">장전</option>
                            <option value="antisub">대잠</option>
                            <option value="speed">항속</option>
                            <option value="_reload">사속</option>
                        </select>
                        <button id="sortDirection" class="sort-direction-btn" type="button">내림차순</button>
                    </div>
                </div>
                <div class="label-filter" id="labelFilter">
                    <button class="label-filter-toggle" id="labelFilterToggle" type="button" aria-expanded="false" aria-controls="labelChips">
                        <span class="material-symbols-outlined">sell</span>
                        <span>태그 필터</span>
                        <span class="badge badge--count" id="labelFilterCount" hidden></span>
                        <span class="material-symbols-outlined label-filter-chevron">expand_more</span>
                    </button>
                    <div class="label-chips-container" id="labelChips"></div>
                </div>
            </header>
            <!-- 청문회 mode guidance — shown only while 자세히 is active (toggled in equip.viewer.js) -->
            <div id="hearingNote" class="hearing-note" role="note">
                <span class="material-symbols-outlined hearing-note-icon">tips_and_updates</span>
                <div class="hearing-note-text">
                    <p>코멘트가 없는 장비는 <strong>청문회 모드(자세히)</strong>에선 보이지 않습니다.</p>
                    <p>특별한 언급이 없는 <b class="r-n">흰딱</b>·<b class="r-r">파딱</b>·<b class="r-sr">보딱</b> 장비들은 있는 걸로 대충 쓰다가 갈아타면 됩니다.</p>
                </div>
            </div>
            <div id="equipGrid" class="equip-grid"></div>
        </div>

        <div id="loading" class="page-status page-status-loading" style="display:none;">
            <div class="spinner"></div>
            <p class="page-status-msg">로딩 중...</p>
        </div>

        <!-- ===== Detail Side Panel ===== -->
        <div id="detailBackdrop" class="equip-panel-backdrop"></div>
        <aside id="detailPanel" class="equip-detail-panel">
            <div class="equip-detail-panel-header">
                <span class="panel-title">장비 상세</span>
                <button id="detailPanelClose" class="panel-close-btn" type="button">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div id="detailPanelContent" class="equip-detail-panel-body"></div>
            <div class="equip-detail-panel-footer">
                <a id="detailResearchLink" class="detail-action-btn" href="#" style="display:none; text-decoration:none;">
                    <span class="material-symbols-outlined">science</span>
                    연구 트리
                </a>
                <button id="detailCompareBtn" class="detail-action-btn" type="button">
                    <span class="material-symbols-outlined">compare_arrows</span>
                    비교하기
                </button>
                <button id="detailDownloadBtn" class="detail-action-btn" type="button">
                    <span class="material-symbols-outlined">download</span>
                    아이콘 저장
                </button>
            </div>
        </aside>

        <!-- ===== Compare Mode Floating Bar ===== -->
        <div id="compareModeBar" class="compare-mode-bar" style="display:none;">
            <div class="compare-mode-info">
                <span class="material-symbols-outlined">compare_arrows</span>
                <span id="compareModeText">비교할 장비를 선택하세요</span>
            </div>
            <button id="compareModeCancel" class="compare-mode-cancel" type="button">
                <span class="material-symbols-outlined">close</span>
                취소
            </button>
        </div>

        <!-- ===== Compare Modal ===== -->
        <div id="compareModal" class="equip-compare-modal" style="display:none;">
            <div class="equip-compare-modal-content">
                <div class="compare-modal-header">
                    <span class="compare-modal-title">장비 비교</span>
                    <button class="modal-close compare-modal-close" type="button">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div id="compareModalBody" class="compare-modal-body"></div>
            </div>
        </div>
    </div>

    <script is:inline type="module" src={`${base}/js/equip/equip.viewer.js`}></script>
</Layout>
