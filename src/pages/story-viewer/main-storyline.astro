---
/**
 * Main Storyline Timeline
 * Converted from pages/story-viewer/main-storyline.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/story-viewer/main-storyline.css';
---

<Layout title="벽람 메인스 타임라인">
    <div id="loading-overlay" class="loading-overlay">
        <div class="loading-spinner"></div>
        <p>타임라인 로딩 중...</p>
    </div>
    <div class="main-container">
        <header class="timeline-header">
            <a href="/altoy/story-viewer/main-story/" id="story-viewer-nav-button" class="nav-button">전체스토리 보기</a>
            <h1>벽람항로 메인스토리 타임라인</h1>

            <div class="search-container">
                <input type="text" id="search-input" placeholder="스토리 검색..." />
                <span class="material-symbols-outlined search-icon">search</span>
            </div>

            <div class="filter-container">
                <button id="filter-button" class="nav-button">
                    <span class="material-symbols-outlined">filter_list</span>
                    진영 필터
                    <span id="filter-badge" class="filter-badge hidden">0</span>
                </button>
                <div id="filter-panel" class="filter-panel hidden">
                </div>
            </div>
        </header>

        <div class="timeline-wrapper">
            <div id="timeline-container">
                <canvas id="timeline-canvas"></canvas>
            </div>
        </div>

        <footer class="chapter-nav">
            <div id="progress-bar-container">
                <div id="progress-bar"></div>
                <div id="chapter-markers"></div>
                <div id="timeline-indicator"></div>
            </div>
        </footer>
    </div>

    <div id="details-modal" class="modal">
        <div class="modal-content">
            <span class="close-button">&times;</span>
            <h2 id="modal-title"></h2>
            <div id="modal-body">
                <h3>설명</h3>
                <p id="modal-description"></p>
                <h3>요약</h3>
                <p id="modal-summary"></p>
                <h3>소속 진영</h3>
                <p id="modal-shipnation"></p>
            </div>
            <div class="modal-footer">
                <audio id="modal-bgm" controls></audio>
            </div>
        </div>
    </div>

    <script is:inline type="module" src="/altoy/js/story-viewer/main-storyline.js"></script>
</Layout>
