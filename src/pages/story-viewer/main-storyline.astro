---
/**
 * Main Storyline Timeline
 * Converted from pages/story-viewer/main-storyline.html
 */
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/Modal.astro';
import '../../styles/story-viewer/main-storyline.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{/* define:vars injects CSS vars as inline styles on the component's slotted
   elements (descendants of <body>), never on :root/<body> — and CSS custom
   properties only inherit downward, so body::before could never read it. Write
   the build-time URL straight onto :root so body::before resolves it. */}
<style is:global set:html={`:root { --storyline-bg: url("${base}/assets/img/background.webp"); }`}></style>


<Layout title="벽람 메인스 타임라인" {base}>
    <div id="loading-overlay" class="page-status page-status-loading page-status--overlay">
        <div class="spinner"></div>
        <p class="page-status-msg">타임라인 로딩 중...</p>
    </div>
    <div class="main-container">
        <header class="timeline-header">
            <a href={`${base}/story-viewer/main-story/`} id="story-viewer-nav-button" class="btn btn-secondary nav-button">전체스토리 보기</a>
            <h1>벽람항로 메인스토리 타임라인</h1>

            <div class="search-container">
                <input type="text" id="search-input" placeholder="스토리 검색..." />
                <span class="material-symbols-outlined search-icon">search</span>
            </div>

            <div class="filter-container">
                <button id="filter-button" class="btn btn-secondary nav-button">
                    <span class="material-symbols-outlined">filter_list</span>
                    진영 필터
                    <span id="filter-badge" class="badge badge--count hidden">0</span>
                </button>
                <div id="filter-panel" class="filter-bar filter-panel hidden">
                </div>
            </div>
        </header>

        <div class="timeline-wrapper">
            <div id="timeline-container">
                <canvas id="timeline-canvas"></canvas>
            </div>
        </div>

        <footer class="chapter-nav">
            <div id="progress-bar-container">
                <div id="progress-bar"></div>
                <div id="chapter-markers"></div>
                <div id="timeline-indicator"></div>
            </div>
        </footer>
    </div>

    <Modal id="details-modal">
        <h2 id="modal-title"></h2>
        <div id="modal-body">
            <h3>설명</h3>
            <p id="modal-description"></p>
            <h3>요약</h3>
            <p id="modal-summary"></p>
            <h3>소속 진영</h3>
            <p id="modal-shipnation"></p>
        </div>
        <div class="modal-footer" slot="footer">
            <audio id="modal-bgm" controls></audio>
        </div>
    </Modal>

    <script is:inline type="module" src={`${base}/js/story-viewer/main-storyline.js`}></script>
</Layout>
