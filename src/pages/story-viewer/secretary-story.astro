---
/**
 * Secretary Story Viewer
 * Converted from pages/story-viewer/secretary-story.html
 */
import Layout from '../../layouts/Layout.astro';
import StoryPlayer from '../../components/StoryPlayer.astro';
import '../../styles/story-viewer/story-viewer.common.vars.css';
import '../../styles/story-viewer/story-viewer.common.utilities.css';
import '../../styles/story-viewer/story-viewer.common.selection.css';
import '../../styles/story-viewer/story-viewer.common.layout.css';
import '../../styles/story-viewer/story-viewer.common.modals.css';
import '../../styles/story-viewer/story-viewer.common.effects.css';
import '../../styles/story-viewer/story-viewer.common.responsive.css';
import '../../styles/rarity.css';
import '../../styles/story-viewer/secretary-story.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="비서함 스토리 뷰어" {base}>
    <div id="error-container" class="error-container hidden"></div>

    <div id="event-selection-view">
        <header class="viewer-header">
            <h1 class="header-title">비서함 스토리 뷰어</h1>
            <div class="search-and-filter-container">
                <div id="visible-count" class="visible-count" aria-live="polite"></div>
                <div class="filter-container">
                    <button class="filter-btn active" data-filter="all">전체 보기</button>
                    <button class="filter-btn" data-filter="completed">완료됨 보기</button>
                    <button class="filter-btn" data-filter="unmarked">미진행 보기</button>
                </div>
            </div>
            <div class="chip-filters">
                <div class="filter-bar">
                    <span class="chip-row-label">진영</span>
                    <div id="faction-chips" class="filter-bar chip-group--dim-idle" role="group" aria-label="진영 필터"></div>
                </div>
                <div class="filter-bar" style="--filter-bar-gap:0.3rem">
                    <span class="chip-row-label">희귀도</span>
                    <div id="rarity-chips" class="filter-bar chip-group--dim-idle" role="group" aria-label="희귀도 필터"></div>
                </div>
                <div class="filter-bar chip-row--search">
                    <span class="chip-row-label">검색</span>
                    <div class="dropdown-container">
                        <input type="text" id="search-bar" placeholder="함순이 이름으로 검색..." autocomplete="off">
                        <div id="search-results" class="dropdown-content"></div>
                    </div>
                </div>
            </div>
        </header>
        <main id="event-grid" class="story-grid-container card-grid card-grid--fit"></main>
    </div>

    <div id="memory-selection-view" class="hidden">
        <header class="viewer-header">
            <button id="back-to-event-selection" class="btn btn-secondary nav-button">&#x2190; 함순이 선택으로 돌아가기</button>
            <h1 id="memory-view-title" class="header-title"></h1>
        </header>
        <div class="flavor-text-box">
            <p>스토리 재생시 브금 자동재생에 주의하세요</p>
        </div>
        <main id="memory-grid" class="story-grid-container card-grid"></main>
    </div>

    <StoryPlayer />

    <script is:inline type="module" src={`${base}/js/story-viewer/story-viewer.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/story-viewer/secretary-story.js`}></script>
</Layout>
