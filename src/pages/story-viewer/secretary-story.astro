---
/**
 * Secretary Story Viewer
 * Converted from pages/story-viewer/secretary-story.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/story-viewer/story-viewer.common.css';
import '../../styles/story-viewer/secretary-story.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="비서함 스토리 뷰어" {base}>
    <div id="error-container" class="error-container hidden"></div>

    <div id="event-selection-view">
        <header class="viewer-header">
            <h1 class="header-title">비서함 스토리 뷰어</h1>
            <div class="search-and-filter-container">
                <div id="visible-count" class="visible-count" aria-live="polite"></div>
                <div class="filter-container">
                    <button class="filter-btn active" data-filter="all">전체 보기</button>
                    <button class="filter-btn" data-filter="completed">완료됨 보기</button>
                    <button class="filter-btn" data-filter="unmarked">미진행 보기</button>
                </div>
            </div>
            <div class="chip-filters">
                <div class="filter-bar">
                    <span class="chip-row-label">진영</span>
                    <div id="faction-chips" class="filter-bar chip-group--dim-idle" role="group" aria-label="진영 필터"></div>
                </div>
                <div class="filter-bar" style="--filter-bar-gap:0.3rem">
                    <span class="chip-row-label">희귀도</span>
                    <div id="rarity-chips" class="filter-bar chip-group--dim-idle" role="group" aria-label="희귀도 필터"></div>
                </div>
                <div class="filter-bar chip-row--search">
                    <span class="chip-row-label">검색</span>
                    <div class="dropdown-container">
                        <input type="text" id="search-bar" placeholder="함순이 이름으로 검색..." autocomplete="off">
                        <div id="search-results" class="dropdown-content"></div>
                    </div>
                </div>
            </div>
        </header>
        <main id="event-grid" class="story-grid-container card-grid card-grid--fit"></main>
    </div>

    <div id="memory-selection-view" class="hidden">
        <header class="viewer-header">
            <button id="back-to-event-selection" class="btn btn-secondary nav-button">&#x2190; 함순이 선택으로 돌아가기</button>
            <h1 id="memory-view-title" class="header-title"></h1>
        </header>
        <div class="flavor-text-box">
            <p>스토리 재생시 브금 자동재생에 주의하세요</p>
        </div>
        <main id="memory-grid" class="story-grid-container card-grid"></main>
    </div>

    <div id="story-viewer-view" class="hidden">
        <div id="fade-overlay" class="fade-overlay"></div>
        <div id="viewer-container" class="viewer-container">
            <div class="story-background"></div>
            <div id="painting-layer" class="painting-layer"></div>
            <header id="story-header" class="story-header">
                <button id="back-to-memory-selection" class="btn btn-icon nav-button back-button">&#x2190;</button>
                <h2 id="story-title"></h2>
                <div id="progress-indicator" class="progress-indicator"></div>
                <button id="view-script-btn" class="btn btn-secondary nav-button" title="View Full Script">
                    <span class="material-symbols-outlined">menu_book</span>
                    전체 대사보기
                </button>
            </header>

            <div id="info-screen" class="info-screen hidden">
                <p id="info-screen-text"></p>
            </div>
            <div id="dialogue-box" class="dialogue-box">
                <div id="actor-portrait" class="actor-portrait"></div>
                <div class="dialogue-content">
                    <p id="actor-name" class="actor-name"></p>
                    <p id="dialogue-text" class="dialogue-text"></p>
                </div>
                <div id="next-page-indicator" class="next-page-indicator">▼</div>
            </div>
            <div id="options-box" class="options-box"></div>

            <div class="bottom-bar-container">
                <div id="audio-player-container" class="audio-player-container hidden">
                    <button id="play-pause-btn" class="btn btn-icon audio-btn"><span class="material-symbols-outlined">play_arrow</span></button>
                    <div class="waveform-container">
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                    </div>
                    <span id="bgm-name" class="bgm-name"></span>
                    <div class="volume-control">
                        <button id="mute-btn" class="btn btn-icon audio-btn"><span class="material-symbols-outlined">volume_up</span></button>
                        <input type="range" id="volume-slider" min="0" max="1" step="0.01" value="0.01">
                    </div>
                </div>
                <div class="story-nav-arrows">
                    <button id="prev-line-btn" class="btn btn-secondary story-nav-btn">&#x2190; 이전</button>
                    <button id="next-line-btn" class="btn btn-secondary story-nav-btn">다음 →</button>
                    <button id="next-story-btn" class="btn btn-secondary story-nav-btn hidden">다음 스토리 보기 →</button>
                    <button id="return-btn" class="btn btn-secondary story-nav-btn hidden">돌아가기</button>
                </div>
                <div class="bottom-bar-spacer"></div>
            </div>
        </div>
    </div>

    <div id="script-modal-overlay" class="modal-overlay hidden">
        <div class="modal-content">
            <button id="close-modal-btn" class="btn btn-close close-modal-btn" title="Close"><span class="material-symbols-outlined">close</span></button>
            <div id="full-script-content" class="full-script-content"></div>
        </div>
    </div>

    <script is:inline type="module" src={`${base}/js/story-viewer/story-viewer.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/story-viewer/secretary-story.js`}></script>
</Layout>
