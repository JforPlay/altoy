---
/**
 * World File Viewer
 * Converted from pages/story-viewer/world-file.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/story-viewer/world-file.css';
---

<Layout title="벽람항로 대작전 파일 문서 뷰어">
    <header>
        <h1>벽람항로 대작전 파일 문서 뷰어</h1>
    </header>

    <div id="main-container">
        <aside id="gallery-container">
        </aside>
        <main id="content-container">
            <div class="top-controls">
                <div id="font-controls">
                    <button id="font-decrease" title="글자 크기 작게">-</button>
                    <button id="font-increase" title="글자 크기 크게">+</button>
                </div>
            </div>
            <div class="placeholder">항목을 선택하여 이야기를 확인하세요.</div>
        </main>
    </div>

    <script is:inline type="module" src="/altoy/js/story-viewer/world-file.js"></script>
</Layout>
