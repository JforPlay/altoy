---
/**
 * Main Story Viewer
 * Converted from pages/story-viewer/main-story.html
 */
import Layout from '../../layouts/Layout.astro';
import StoryPlayer from '../../components/StoryPlayer.astro';
import '../../styles/story-viewer/story-viewer.common.vars.css';
import '../../styles/story-viewer/story-viewer.common.utilities.css';
import '../../styles/story-viewer/story-viewer.common.selection.css';
import '../../styles/story-viewer/story-viewer.common.layout.css';
import '../../styles/story-viewer/story-viewer.common.modals.css';
import '../../styles/story-viewer/story-viewer.common.effects.css';
import '../../styles/story-viewer/story-viewer.common.responsive.css';
import '../../styles/story-viewer/story-viewer.faction-filter.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람 스토리뷰어" {base}>
    <div id="error-container" class="error-container hidden"></div>

    <div id="event-selection-view">
        <header class="viewer-header">
            <a href={`${base}/story-viewer/main-storyline/`} class="btn btn-secondary nav-button">스토리 타임라인</a>
            <h1 class="header-title">벽람항로 메인스토리 뷰어</h1>
            <div class="search-container">
                <input type="text" id="search-bar" placeholder="이벤트 이름으로 검색...">
            </div>
            <div class="filter-container">
                <button id="filter-button" class="btn btn-secondary nav-button">
                    <span class="material-symbols-outlined">filter_list</span>
                    진영 필터
                    <span id="filter-badge" class="badge badge--count filter-count-badge hidden">0</span>
                </button>
                <div id="filter-panel" class="filter-bar filter-panel hidden"></div>
            </div>
        </header>
        <main id="event-grid" class="story-grid-container card-grid card-grid--fit"></main>
    </div>

    <div id="memory-selection-view" class="hidden">
        <header class="viewer-header">
            <button id="back-to-event-selection" class="btn btn-secondary nav-button">&#x2190; 메인스토리로 돌아가기</button>
            <h1 id="memory-view-title" class="header-title"></h1>
            <button id="group-script-btn" class="btn btn-secondary nav-button hidden" type="button">
                <span class="material-symbols-outlined">menu_book</span>
                전체 대사 모아보기
            </button>
        </header>
        <div class="flavor-text-box">
            <p>스토리 재생시 브금 자동재생에 주의하세요</p>
        </div>
        <main id="memory-grid" class="story-grid-container card-grid"></main>
    </div>

    <StoryPlayer />

    <script is:inline type="module" src={`${base}/js/story-viewer/story-viewer.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/story-viewer/main-story.js`}></script>
</Layout>
