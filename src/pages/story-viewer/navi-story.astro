---
/**
 * Navi Story Viewer
 * Converted from pages/story-viewer/navi-story.html
 */
import Layout from '../../layouts/Layout.astro';
import StoryPlayer from '../../components/StoryPlayer.astro';
import '../../styles/story-viewer/story-viewer.common.vars.css';
import '../../styles/story-viewer/story-viewer.common.utilities.css';
import '../../styles/story-viewer/story-viewer.common.selection.css';
import '../../styles/story-viewer/story-viewer.common.layout.css';
import '../../styles/story-viewer/story-viewer.common.modals.css';
import '../../styles/story-viewer/story-viewer.common.effects.css';
import '../../styles/story-viewer/story-viewer.common.responsive.css';
import '../../styles/story-viewer/child-story.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="네비 스토리 뷰어" {base}>
    <div id="error-container" class="error-container hidden"></div>

    <div id="tab-navigation-view">
        <header class="viewer-header navi-header">
            <div class="header-content">
                <h1 class="header-title">네비키우기 한눈에 보기</h1>
                <p class="header-subtitle">각종 회상 / 폴라로이드 / 기타 이미지 모음</p>
            </div>
        </header>

        <nav class="tab-navigation">
            <button class="tab-btn active" data-tab="memories">
                <span class="material-symbols-outlined">auto_stories</span>
                <span>회상</span>
            </button>
            <button class="tab-btn" data-tab="endings">
                <span class="material-symbols-outlined">celebration</span>
                <span>엔딩</span>
            </button>
            <button class="tab-btn" data-tab="visits">
                <span class="material-symbols-outlined">location_city</span>
                <span>네비의 현실방문</span>
            </button>
            <button class="tab-btn" data-tab="daily">
                <span class="material-symbols-outlined">calendar_today</span>
                <span>네비의 일상</span>
            </button>
            <button class="tab-btn" data-tab="polaroids">
                <span class="material-symbols-outlined">photo_library</span>
                <span>폴라로이드</span>
            </button>
            <button class="tab-btn" data-tab="photos">
                <span class="material-symbols-outlined">collections</span>
                <span>기타 사진들</span>
            </button>
        </nav>

        <div class="flavor-text-box">
            <p>스토리 재생시 브금 자동재생에 주의하세요</p>
        </div>

        <div id="memories-content" class="tab-content active">
            <main id="memories-grid" class="navi-grid-container card-grid"></main>
        </div>
        <div id="endings-content" class="tab-content">
            <main id="endings-grid" class="navi-grid-container card-grid"></main>
        </div>
        <div id="visits-content" class="tab-content">
            <main id="visits-grid" class="navi-grid-container card-grid"></main>
        </div>
        <div id="daily-content" class="tab-content">
            <main id="daily-grid" class="navi-grid-container card-grid"></main>
        </div>
        <div id="polaroids-content" class="tab-content">
            <main id="polaroids-grid" class="navi-grid-container card-grid"></main>
        </div>
        <div id="photos-content" class="tab-content">
            <main id="photos-grid" class="navi-grid-container card-grid"></main>
        </div>
    </div>

    <StoryPlayer backButtonId="back-to-tabs" transcriptToolbar={false} />

    <div id="polaroid-modal" class="modal-overlay hidden">
        <div class="polaroid-modal-content">
            <button id="close-polaroid-modal" class="btn btn-close close-modal-btn" title="Close">
                <span class="material-symbols-outlined">close</span>
            </button>
            <div id="polaroid-detail" class="polaroid-detail">
                <div class="polaroid-images">
                    <img id="polaroid-img-front" class="polaroid-img" alt="Polaroid Front">
                    <img id="polaroid-img-back" class="polaroid-img hidden" alt="Polaroid Back">
                </div>
                <button id="flip-polaroid-btn" class="btn flip-polaroid-btn">
                    <span class="material-symbols-outlined">flip</span>
                    뒤집기
                </button>
                <div id="polaroid-info" class="polaroid-info"></div>
            </div>
        </div>
    </div>

    <!-- Hidden dummy elements for story engine compatibility -->
    <div id="event-selection-view" class="hidden"></div>
    <div id="memory-selection-view" class="hidden"></div>
    <div id="event-grid" class="hidden"></div>
    <div id="memory-grid" class="hidden"></div>
    <div id="search-bar" class="hidden"></div>
    <div id="back-to-event-selection" class="hidden"></div>
    <div id="back-to-memory-selection" class="hidden"></div>
    <div id="memory-view-title" class="hidden"></div>
    <div id="summary-modal-overlay" class="hidden"></div>
    <div id="close-summary-modal-btn" class="hidden"></div>
    <div id="summary-modal-content" class="hidden"></div>

    <script is:inline type="module" src={`${base}/js/story-viewer/story-viewer.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/story-viewer/child-story.js`}></script>
    <script is:inline type="module" src={`${base}/js/story-viewer/child-navi-init.js`}></script>
</Layout>
