---
/**
 * Main landing page
 * Converted from index.html
 */
import Layout from '../layouts/Layout.astro';
import '../styles/mainpage/mainpage.core.css';
import '../styles/mainpage/mainpage.navbar.css';
import '../styles/mainpage/mainpage.carousel.css';
import '../styles/mainpage/mainpage.bento.css';
import '../styles/mainpage/mainpage.responsive.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value: string) => `${base}/${value}`;

// Build-time hrefs so anchors render with correct URLs at first paint.
// Mirror of LINKS in public/js/global.script.js — keep in sync if either is edited.
const hrefs = {
    SKIN_LIST: path('skin/skin-list-viewer/'),
    EQUIP_VIEWER: path('equip/equip-viewer/'),
    RESEARCH_TRACKER: path('shipgirl/research-tracker/'),
    ISLAND: path('island/'),
    JUUSTAGRAM: path('juustagram/'),
    SHIPGIRL_BIRTHDAY: path('shipgirl/shipgirl-birthday/'),
    SKIN_POLL: path('skin/skin-poll/'),
    EVENT_TIMELINE: path('event-timeline/'),
    MAIN_STORY: path('story-viewer/main-story/'),
    CHAT_JUUS: path('chat-viewer/juus/'),
    COMIC_VIEWER: path('misc/comic-viewer/'),
    EXTERNAL_HEARING: 'https://999dulgi.github.io/azurlane-hearing/ships',
    EXTERNAL_EQUIPMENT: 'https://gateisbug.github.io/alit/#/item',
    EXTERNAL_ARCA_AZUR: 'https://arca.live/b/azurlane',
    EXTERNAL_ARCA_MANJUU: 'https://arca.live/b/manjuugame',
    EXTERNAL_BUG_REPORT: 'https://arca.live/b/azurlane/148734027',
    EXTERNAL_GODROOKLYN: 'https://godrooklyn.tistory.com/',
    EXTERNAL_GITHUB: 'https://github.com/JforPlay/altoy'
};
---

<Layout title="ALtoy - 벽람 장난감" {base}>
    <main class="home-container">
        <!-- Hero Carousel Section -->
        <section class="hero-carousel">
            <div class="carousel-track">

                <!-- Slide 1: Skin Gallery -->
                <div class="carousel-slide" data-slide="2">
                    <div class="slide-background">
                        <img src={`${base}/assets/img/main_page_skin.webp`} alt="Gallery Background"
                            loading="lazy">
                        <div class="slide-overlay"></div>
                    </div>
                    <div class="slide-content">
                        <div class="slide-badge">
                            <span class="material-symbols-outlined">apparel</span> 1000+
                        </div>
                        <h2 class="slide-title">스킨 모음집</h2>
                        <p class="slide-description">
                            1000개 이상의 스킨을 필터링하고 각종 일러스트들을 감상하세요
                        </p>
                        <a href={hrefs.SKIN_LIST} class="slide-cta">
                            <span>스킨 보러가기</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Slide 2: Equip DB -->
                <div class="carousel-slide" data-slide="3">
                    <div class="slide-background">
                        <img src={`${base}/assets/img/anchorage.webp`} alt="Equip DB Background"
                            loading="lazy">
                        <div class="slide-overlay"></div>
                    </div>
                    <div class="slide-content">
                        <div class="slide-badge">New Update</div>
                        <h2 class="slide-title">장비 데이터베이스</h2>
                        <p class="slide-description">
                            모든 장비의 스펙을 비교하고 분석하세요
                        </p>
                        <a href={hrefs.EQUIP_VIEWER} class="slide-cta">
                            <span>장비 보러가기</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Slide 3: Research Tracker -->
                <div class="carousel-slide" data-slide="4">
                    <div class="slide-background">
                        <img src={`${base}/assets/img/research_tracker.webp`} alt="Research Tracker Background"
                            loading="lazy">
                        <div class="slide-overlay"></div>
                    </div>
                    <div class="slide-content">
                        <div class="slide-badge">New Update</div>
                        <h2 class="slide-title">개발함 육성 트래커</h2>
                        <p class="slide-description">
                            개발함 육성 현황을 한눈에 관리하세요
                        </p>
                        <a href={hrefs.RESEARCH_TRACKER} class="slide-cta">
                            <span>트래커 보러가기</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Slide 4: island planner -->
                <div class="carousel-slide active" data-slide="0">
                    <div class="slide-background">
                        <img src={`${base}/assets/img/islandplanner.webp`}
                            alt="Island Planner Background" loading="lazy">
                        <div class="slide-overlay"></div>
                    </div>
                    <div class="slide-content">
                        <div class="slide-badge">Featured</div>
                        <h2 class="slide-title">벽뜌땨 계획 페이지 오픈</h2>
                        <p class="slide-description">
                            벽타듀를 즐기는데 필요한 정보들을 확인해보세요<br>
                        </p>
                        <a href={hrefs.ISLAND} class="slide-cta">
                            <span>보러가기</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Slide 5: Juustagram -->
                <div class="carousel-slide" data-slide="1">
                    <div class="slide-background">
                        <img src="https://line3-patch-blhx.bilibiligame.net/pic/251218_boteB8R5oh3g1KImYkrV.png" alt="Juustagram Background"
                            loading="lazy">
                        <div class="slide-overlay"></div>
                    </div>
                    <div class="slide-content">
                        <div class="slide-badge">HOT</div>
                        <h2 class="slide-title">쥬스타그램</h2>
                        <p class="slide-description">
                            함순이들의 일상이 담긴 SNS를 엿보고<br>
                            숨겨진 이야기를 발견해보세요
                        </p>
                        <a href={hrefs.JUUSTAGRAM} class="slide-cta">
                            <span>둘러보기</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Carousel Controls -->
            <button class="carousel-nav prev" aria-label="Previous slide">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="carousel-nav next" aria-label="Next slide">
                <i class="fas fa-chevron-right"></i>
            </button>

            <!-- Carousel Indicators -->
            <!-- Active indicator must match the .active slide's DOM index (4th here, the Featured slide). -->
            <div class="carousel-indicators">
                <button class="indicator" data-slide="0" aria-label="Go to slide 1"></button>
                <button class="indicator" data-slide="1" aria-label="Go to slide 2"></button>
                <button class="indicator" data-slide="2" aria-label="Go to slide 3"></button>
                <button class="indicator active" data-slide="3" aria-label="Go to slide 4"></button>
                <button class="indicator" data-slide="4" aria-label="Go to slide 5"></button>
            </div>
        </section>

        <!-- Info and Events Section -->
        <section class="info-and-events-section">
            <!-- Birthday Section (spans 4 rows on left) -->
            <div class="birthday-container">
                <div class="birthday-header">
                    <h3>
                        <span class="material-symbols-outlined">cake</span>
                        <span class="birthday-title-text">오늘의 생일함순이</span>
                        <span class="birthday-date" id="birthdayDate"></span>
                    </h3>
                </div>
                <div class="bento-card birthday-card">
                    <div class="birthday-list" id="birthdayList">
                        <div class="birthday-loading">
                            <i class="fas fa-spinner fa-spin"></i>
                            로딩 중...
                        </div>
                    </div>
                    <div class="card-footer birthday-footer">
                        <a href={hrefs.SHIPGIRL_BIRTHDAY} class="birthday-more-link">
                            생일 캘린더 보기 <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Event Carousel Section -->
            <div class="event-carousel-container">
                <div class="event-carousel-header">
                    <h2>
                        <span class="material-symbols-outlined">celebration</span>
                        진행 중인 이벤트
                    </h2>
                    <div class="event-carousel-loading">
                        <i class="fas fa-spinner fa-spin"></i>
                        로딩 중...
                    </div>
                </div>
                <div class="event-carousel">
                    <div class="event-carousel-track">
                        <!-- Banners will be loaded here dynamically -->
                    </div>
                    <button class="event-carousel-nav prev" aria-label="Previous event">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="event-carousel-nav next" aria-label="Next event">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    <div class="event-carousel-indicators"></div>
                </div>
            </div>

            <!-- Patch Notes Section -->
            <div class="patch-notes-container">
                <div class="patch-notes-header">
                    <h3>
                        <i class="fas fa-bullhorn"></i>
                        안내사항
                    </h3>
                </div>
                <div class="bento-card patch-notes-card">
                    <div class="patch-notes-content">
                        <ul>
                            <li><strong>함순이DB 스킬검색 기능 추가</strong></li>
                            <li><strong>전체 데이터 동기화 기능 추가</strong></li>
                            <li><strong>이미지/음성 출력 안되는 버그 수정</strong></li>
                            <li><strong>기타 최적화</strong></li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <span class="card-meta">최신 업데이트: 2026-4-30</span>
                    </div>
                </div>
            </div>

            <!-- Skin Poll (promoted from bento grid) -->
            <a href={hrefs.SKIN_POLL} class="bento-card medium featured">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fa-solid fa-square-poll-vertical"></i>
                    </div>
                    <h3>스킨 선호도 투표</h3>
                </div>
                <p>개편 후 새롭게 오픈한 벽챈 스킨선호도 조사!<br>인기 스킨을 확인하고 투표하세요</p>
                <div class="card-footer">
                    <span class="card-meta">실시간 동기화 / 서버 상태표시 기능추가</span>
                </div>
            </a>

            <!-- Event Timeline (promoted from bento grid) -->
            <a href={hrefs.EVENT_TIMELINE} class="bento-card medium">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fa-solid fa-timeline"></i>
                    </div>
                    <h3>역대 이벤트 보기</h3>
                </div>
                <p>각종 필터링 + 함순이 리스트와 함께 <br>역대 이벤트를 확인해보세요</p>
            </a>
        </section>

        <!-- Bento Grid -->
        <div class="bento-grid">
            <a href={hrefs.MAIN_STORY} class="bento-card medium">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fa-solid fa-book-open-reader"></i>
                    </div>
                    <h3>메인스토리 뷰어</h3>
                </div>
                <p>타임라인형 뷰어 + 브금/배경들과 함께 <br>
                    메인스토리를 감상해보세요</p>
            </a>

            <!-- Small Cards -->
            <a href={hrefs.CHAT_JUUS} class="bento-card small">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fa-solid fa-comments-dollar"></i>
                    </div>
                    <h3>JUUS 뷰어</h3>
                </div>
            </a>

            <a href={hrefs.EXTERNAL_GODROOKLYN} target="_blank" rel="noopener noreferrer" class="bento-card small featured">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fa-solid fa-square-rss"></i>
                    </div>
                    <h3>최신스토리 + 다른이벤스들 보기</h3>
                </div>
            </a>

            <a href={hrefs.COMIC_VIEWER} class="bento-card small">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fa-solid fa-images"></i>
                    </div>
                    <h3>인게임 만화들 보러가기</h3>
                </div>
            </a>

            <a href={hrefs.EXTERNAL_BUG_REPORT} target="_blank" rel="noopener noreferrer" class="bento-card small">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fa-solid fa-bug"></i>
                    </div>
                    <h3>버그 제보 / 건의사항은 여기로</h3>
                </div>
            </a>

            <!-- External Links Section (Auto new row) -->
            <div class="external-links-section">
                <a href={hrefs.EXTERNAL_HEARING} target="_blank" rel="noopener noreferrer" class="bento-card small external-link">
                    <span class="external-badge">외부</span>
                    <div class="card-header">
                        <i class="fas fa-gavel external-link-icon"></i>
                        <div class="external-link-label">함순이 청문회 웹버전</div>
                    </div>
                    <div class="external-link-desc">함순이들의 스킬정보 / 간단평을 볼 수 있습니다</div>
                </a>
                <a href={hrefs.EXTERNAL_EQUIPMENT} target="_blank" rel="noopener noreferrer" class="bento-card small external-link">
                    <span class="external-badge">외부</span>
                    <div class="card-header">
                        <i class="fa-solid fa-wrench external-link-icon"></i>
                        <div class="external-link-label">장비 설명회 웹버전</div>
                    </div>
                    <div class="external-link-desc">벽람 모든 장비들의 상세스펙 / 코멘트를 볼 수 있습니다</div>
                </a>
                <div class="bento-card small external-link dual-external">
                    <span class="external-badge">외부</span>
                    <div class="dual-links-container">
                        <a href={hrefs.EXTERNAL_ARCA_AZUR} target="_blank" rel="noopener noreferrer" class="dual-link-item">
                            <img src={`${base}/assets/icon/arca.svg`} alt="Arca" class="dual-link-svg-icon">
                            <div class="dual-link-content">
                                <div class="dual-link-label">벽챈 바로가기</div>
                            </div>
                        </a>
                        <a href={hrefs.EXTERNAL_ARCA_MANJUU} target="_blank" rel="noopener noreferrer" class="dual-link-item">
                            <img src={`${base}/assets/icon/arca.svg`} alt="Arca" class="dual-link-svg-icon">
                            <div class="dual-link-content">
                                <div class="dual-link-label">맍챈 바로가기</div>
                            </div>
                        </a>
                    </div>
                </div>
                <a href={hrefs.EXTERNAL_GITHUB} target="_blank" rel="noopener noreferrer" class="bento-card small external-link">
                    <span class="external-badge">외부</span>
                    <div class="card-header">
                        <i class="fab fa-github external-link-icon"></i>
                        <div class="external-link-label">원본 소스코드 보러가기</div>
                    </div>
                    <div class="external-link-desc">원본 소스코드 보러가기</div>
                </a>
            </div>
        </div>

        <!-- About ALtoy — keeps the "app purpose" text on the homepage for
             OAuth verification re-audits, positioned at the bottom so it
             doesn't dominate the landing view. -->
        <section class="about-altoy" aria-label="About ALtoy">
            <h1 class="about-altoy-title">ALtoy</h1>
            <p class="about-altoy-desc">
                ALtoy는 모바일 게임 <strong>Azur Lane (벽람항로)</strong> 한국 서버의 팬 메이드 웹 뷰어입니다.
                함순이 정보, 스토리, 스킨, 장비 데이터베이스, 해역 정보, 아일랜드 계획 도구 등 각종 인게임
                에셋과 자료를 한 곳에서 확인할 수 있습니다.
            </p>
            <p class="about-altoy-desc-en">
                <em>ALtoy is a non-profit fan-made web viewer for the mobile game Azur Lane (Korean server),
                aggregating ship information, story scripts, skins, equipment data, map information, and
                in-game planning tools. Static site hosted on GitHub Pages with no server or user accounts.</em>
            </p>
        </section>
    </main>

    <script is:inline type="module" src={`${base}/js/mainpage.script.js`}></script>
</Layout>

<style>
    /* The .bento-grid above uses grid-auto-rows: 90px while its nested
       .external-links-section uses 120px rows, so those cards visually
       overflow the grid's computed height. We render the About section
       below both with explicit clearing and a generous top margin so
       it can't overlap the overflowing content. */
    .about-altoy {
        clear: both;
        position: relative;
        max-width: 720px;
        margin: 6rem auto 1rem;
        padding: 1.5rem 1.5rem 0.5rem;
        text-align: center;
        color: var(--text-secondary);
        border-top: 1px solid var(--card-border, rgba(128, 128, 128, 0.2));
        opacity: 0.75;
    }
    .about-altoy-title {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0 0 0.5rem;
        letter-spacing: 0.04em;
        color: var(--text-primary);
    }
    .about-altoy-desc {
        font-size: 0.8rem;
        line-height: 1.5;
        margin: 0 0 0.4rem;
    }
    .about-altoy-desc-en {
        font-size: 0.75rem;
        line-height: 1.45;
        margin: 0;
        opacity: 0.85;
    }
</style>
