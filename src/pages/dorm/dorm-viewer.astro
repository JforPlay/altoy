---
import Layout from '../../layouts/Layout.astro';
import '../../styles/dorm/dorm.style.css';
import '../../styles/dorm/dorm.grid.css';
import '../../styles/dorm/dorm.responsive.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="숙소 가구 뷰어" bodyClass="dorm-page" {base}>
    <div id="dormApp" class="dorm-app">

        <!-- Side Panel -->
        <aside id="dormPanel" class="dorm-panel" aria-label="가구 목록">
            <div class="panel-header">
                <h2 class="panel-title">가구 목록</h2>
                <input
                    type="text"
                    id="furnitureSearch"
                    class="panel-search"
                    placeholder="가구 검색..."
                    autocomplete="off"
                    aria-label="가구 검색"
                />
            </div>

            <div id="themeList" class="theme-list scroll-styled">
                <!-- Theme accordion sections rendered by JS -->
            </div>
            <div id="themeEmptyState" class="page-status page-status-empty page-status--compact hidden" role="status">
                <span class="material-symbols-outlined page-status-icon">inbox</span>
                <p class="page-status-msg">검색 결과가 없습니다.</p>
            </div>

            <div id="hoverInfo" class="hover-info" aria-live="polite">
                <div class="hover-info-placeholder">가구에 마우스를 올려보세요</div>
            </div>
        </aside>

        <!-- Main Area -->
        <main class="dorm-main">
            <!-- Toolbar -->
            <div id="dormToolbar" class="dorm-toolbar">
                <div class="toolbar-actions">
                    <button id="btnRotate" class="toolbar-btn" type="button" disabled title="회전 (R)" aria-label="선택한 가구 회전">
                        <span class="material-symbols-outlined" aria-hidden="true">rotate_right</span>
                        <span class="btn-label">회전</span>
                    </button>
                    <button id="btnDelete" class="toolbar-btn" type="button" disabled title="삭제 (Del)" aria-label="선택한 가구 삭제">
                        <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                        <span class="btn-label">삭제</span>
                    </button>
                    <button id="btnClear" class="toolbar-btn toolbar-btn--danger" type="button" title="전체 삭제">
                        <span class="material-symbols-outlined" aria-hidden="true">delete_sweep</span>
                        <span class="btn-label">전체 삭제</span>
                    </button>
                </div>
                <div class="toolbar-stats">
                    <span class="stat-comfort">
                        쾌적도: <strong id="comfortValue">0</strong>
                    </span>
                    <span class="stat-count">
                        가구: <strong id="itemCount">0</strong>개
                    </span>
                </div>
            </div>

            <!-- Canvas Area -->
            <div id="canvasContainer" class="canvas-container">
                <canvas id="dormCanvas" role="img" aria-label="숙소 가구 배치 캔버스"></canvas>
                <div class="zoom-controls">
                    <button id="btnZoomIn" class="zoom-btn" type="button" title="확대" aria-label="확대">+</button>
                    <button id="btnZoomOut" class="zoom-btn" type="button" title="축소" aria-label="축소">&minus;</button>
                </div>
                <div id="canvasLoading" class="canvas-loading" role="status" aria-live="polite">
                    <div class="page-status page-status-loading">
                        <div class="spinner"></div>
                        <p class="page-status-msg">데이터 로딩 중...</p>
                    </div>
                </div>
            </div>
        </main>

        <!-- Mobile panel toggle -->
        <button id="btnTogglePanel" class="mobile-panel-toggle" type="button" aria-controls="dormPanel" aria-expanded="false" aria-label="가구 목록 열기">
            <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
        </button>
    </div>

    <script is:inline type="module" src={`${base}/js/dorm/dorm.viewer.js`}></script>
</Layout>
