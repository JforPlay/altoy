---
/**
 * Aircraft Simulator — Aircraft flight & weapon visualization
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/skin/skin.common.css';
import '../../styles/simulators/sim.common.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="함재기 시뮬레이터" {base}>
    <Fragment slot="head">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    </Fragment>

    <div class="sim-page">
        <header class="sim-header">
            <div class="header-title-container">
                <span class="material-symbols-outlined header-icon">flight</span>
                <h1>함재기 시뮬레이터</h1>
            </div>
        </header>

        <!-- Simulation Canvas -->
        <div id="simulation-container">
            <div id="fps-display">FPS: --</div>
            <div id="player-area"></div>
            <div id="vanguard">
                <img src={`${base}/assets/img/vanguard_chibi.webp`} alt="vanguard">
            </div>
            <div id="mainfleet">
                <img src={`${base}/assets/img/mainfleet_chibi.webp`} alt="mainfleet">
            </div>
            <div id="enemy">
                <img src={`${base}/assets/img/enemy_chibi.webp`} alt="enemy">
            </div>
            <div id="visual-log"></div>
        </div>

        <!-- Playback Controls Bar -->
        <div class="playback-bar">
            <button id="fire-button" class="btn btn-primary" type="button">
                <span class="material-symbols-outlined">play_arrow</span>
                발사
            </button>
            <div class="speed-control" role="group" aria-label="재생 속도">
                <button class="speed-btn" data-speed="0.5" type="button" aria-pressed="false">0.5x</button>
                <button class="speed-btn active" data-speed="1" type="button" aria-pressed="true">1x</button>
                <button class="speed-btn" data-speed="2" type="button" aria-pressed="false">2x</button>
                <button class="speed-btn" data-speed="3" type="button" aria-pressed="false">3x</button>
            </div>
            <button id="pause-button" class="btn btn-icon" title="일시정지" type="button" aria-label="일시정지" aria-pressed="false">
                <span class="material-symbols-outlined">pause</span>
            </button>
            <div class="bar-separator"></div>
            <button id="enemy-toggle" class="btn btn-secondary" type="button" aria-pressed="false">적 위치: 상단</button>
            <div id="level-toggle-container"></div>
        </div>

        <!-- Two-column content area -->
        <div class="sim-content">
            <!-- Left: Aircraft Selection -->
            <div class="sim-sidebar">
                <div class="card selector-card">
                    <div class="card-header">
                        <h3>함재기 선택</h3>
                    </div>
                    <div id="type-filter" class="type-filter-bar"></div>
                    <select id="aircraft-select"></select>
                </div>

                <div id="aircraft-info-card" class="card hidden">
                    <div id="aircraft-meta"></div>
                </div>
            </div>

            <!-- Right: Weapon Info -->
            <div class="sim-main">
                <div id="weapon-cards-container">
                    <div class="card placeholder-card">
                        <p>함재기를 선택하여 무기 정보를 확인하세요.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.engine.oceanbg.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.engine.bullet.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.engine.common.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.aircraft.data.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.aircraft.main.js`}></script>
</Layout>
