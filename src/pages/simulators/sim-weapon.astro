---
/**
 * Weapon Simulator — Skill barrage visualization
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/skin/skin.common.css';
import '../../styles/simulators/sim.common.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="스킬/장비 탄막 시뮬레이터" {base}>
    <Fragment slot="head">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    </Fragment>

    <div class="sim-page">
        <header class="sim-header">
            <div class="header-title-container">
                <span class="material-symbols-outlined header-icon">rocket_launch</span>
                <h1>스킬 탄막 시뮬레이터</h1>
            </div>
        </header>

        <!-- Simulation Canvas -->
        <div id="simulation-container">
            <div id="fps-display">FPS: --</div>
            <div id="player-area"></div>
            <div id="vanguard">
                <img src={`${base}/assets/img/vanguard_chibi.webp`} alt="vanguard">
            </div>
            <div id="mainfleet">
                <img src={`${base}/assets/img/mainfleet_chibi.webp`} alt="mainfleet">
            </div>
            <div id="enemy">
                <img src={`${base}/assets/img/enemy_chibi.webp`} alt="enemy">
            </div>
            <div id="visual-log"></div>
        </div>

        <!-- Playback Controls Bar -->
        <div class="playback-bar">
            <button id="fire-button" class="btn btn-primary">
                <span class="material-symbols-outlined">play_arrow</span>
                발사
            </button>
            <div class="speed-control">
                <button class="speed-btn" data-speed="0.75">0.75x</button>
                <button class="speed-btn active" data-speed="1.5">1.5x</button>
                <button class="speed-btn" data-speed="2">2x</button>
                <button class="speed-btn" data-speed="3">3x</button>
            </div>
            <button id="pause-button" class="btn btn-icon" title="일시정지">
                <span class="material-symbols-outlined">pause</span>
            </button>
            <div class="bar-separator"></div>
            <button id="enemy-toggle" class="btn btn-secondary">적 위치: 상단</button>
            <div id="level-toggle-container"></div>
        </div>

        <!-- Two-column content area -->
        <div class="sim-content">
            <!-- Left: Skill Selection -->
            <div class="sim-sidebar">
                <div class="card selector-card">
                    <div class="card-header">
                        <h3>스킬 선택</h3>
                        <button id="ship-browse-btn" class="btn btn-icon" title="함순이 검색">
                            <span class="material-symbols-outlined">search</span>
                        </button>
                    </div>
                    <select id="skill-select"></select>
                </div>

                <div id="shipgirl-card" class="card shipgirl-card hidden"></div>

                <div id="skill-info-card" class="card hidden">
                    <div id="skill-meta"></div>
                </div>
            </div>

            <!-- Right: Weapon Info -->
            <div class="sim-main">
                <div id="weapon-cards-container">
                    <div class="card placeholder-card">
                        <p>스킬을 선택하여 무기 정보를 확인하세요.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Shipgirl Browse Modal -->
    <div id="ship-browse-modal" class="modal-overlay hidden">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog card">
            <div class="modal-header">
                <h3>함순이 검색</h3>
                <button class="modal-close-btn btn btn-icon">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <input type="text" id="ship-search-input" placeholder="함순이 이름 검색..." class="search-input" />
            <div id="ship-browse-list" class="ship-grid"></div>
        </div>
    </div>

    <!-- Class Group Modal -->
    <div id="class-group-modal" class="modal-overlay hidden">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog card">
            <div class="modal-header">
                <h3 id="class-group-title"></h3>
                <button class="modal-close-btn btn btn-icon">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div id="class-group-list" class="ship-grid"></div>
        </div>
    </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.engine.oceanbg.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.engine.bullet.factory.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.engine.bullet.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.engine.common.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.weapon.data.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/sim.weapon.main.js`}></script>
</Layout>
