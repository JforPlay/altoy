---
/**
 * Fleet Build Simulator — 6-ship fleet composition with equipment, stats, and reload timings
 */
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/Modal.astro';
import '../../styles/skin/skin.common.css';
import '../../styles/simulators/sim.common.css';
import '../../styles/simulators/fleet-sim.css';
import '../../styles/simulators/fleet-sim.damage.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="편성 시뮬레이터" theme="accent" {base}>
    <div class="sim-page fleet-sim-page">
        <!-- Page Header -->
        <header class="sim-header">
            <div class="header-title-container">
                <span class="material-symbols-outlined header-icon">groups</span>
                <h1>편성 시뮬레이터</h1>
            </div>
            <div class="header-actions">
                <button id="save-load-btn" class="btn btn-secondary" title="저장/불러오기">
                    <span class="material-symbols-outlined">save</span>
                    저장/불러오기
                </button>
                <button id="share-btn" class="btn btn-secondary" title="공유">
                    <span class="material-symbols-outlined">share</span>
                    공유
                </button>
            </div>
        </header>

        <!-- Fleet Grid -->
        <div class="fleet-grid">
            <!-- Main Fleet (Back Row) -->
            <section class="fleet-section">
                <div class="fleet-section-header">
                    <span class="material-symbols-outlined section-icon">shield</span>
                    <h2>후열 (Main Fleet)</h2>
                </div>
                <div class="ship-card-grid" id="main-fleet-grid">
                    <div class="ship-card ship-card--empty" data-slot="0">
                        <button class="ship-card-add" aria-label="함순이 추가">
                            <span class="material-symbols-outlined">add</span>
                            <span class="add-label">함순이 추가</span>
                        </button>
                    </div>
                    <div class="ship-card ship-card--empty" data-slot="1">
                        <button class="ship-card-add" aria-label="함순이 추가">
                            <span class="material-symbols-outlined">add</span>
                            <span class="add-label">함순이 추가</span>
                        </button>
                    </div>
                    <div class="ship-card ship-card--empty" data-slot="2">
                        <button class="ship-card-add" aria-label="함순이 추가">
                            <span class="material-symbols-outlined">add</span>
                            <span class="add-label">함순이 추가</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Vanguard (Front Row) -->
            <section class="fleet-section">
                <div class="fleet-section-header">
                    <span class="material-symbols-outlined section-icon">swords</span>
                    <h2>전열 (Vanguard)</h2>
                </div>
                <div class="ship-card-grid" id="vanguard-fleet-grid">
                    <div class="ship-card ship-card--empty" data-slot="3">
                        <button class="ship-card-add" aria-label="함순이 추가">
                            <span class="material-symbols-outlined">add</span>
                            <span class="add-label">함순이 추가</span>
                        </button>
                    </div>
                    <div class="ship-card ship-card--empty" data-slot="4">
                        <button class="ship-card-add" aria-label="함순이 추가">
                            <span class="material-symbols-outlined">add</span>
                            <span class="add-label">함순이 추가</span>
                        </button>
                    </div>
                    <div class="ship-card ship-card--empty" data-slot="5">
                        <button class="ship-card-add" aria-label="함순이 추가">
                            <span class="material-symbols-outlined">add</span>
                            <span class="add-label">함순이 추가</span>
                        </button>
                    </div>
                </div>
            </section>
        </div>

        <!-- Damage Results (filled async by fleet-sim.ui.js renderDamagePanel) -->
        <section id="damage-results" class="damage-results-section"></section>

        <!-- Fleet Summary (hidden by default, shown when ships are populated) -->
        <section id="fleet-summary" class="fleet-summary hidden">
            <div class="fleet-summary-header">
                <span class="material-symbols-outlined">analytics</span>
                <h2>편성 요약</h2>
            </div>
            <div class="fleet-summary-content">
                <div id="fleet-tech-bonuses" class="summary-panel">
                    <h3>함대 기술 보너스</h3>
                    <div class="tech-bonus-list"></div>
                </div>
                <div id="fleet-passive-skills" class="summary-panel">
                    <h3>패시브 스킬</h3>
                    <div class="passive-skill-list"></div>
                </div>
            </div>
        </section>
    </div>

    <!-- Ship Picker Modal -->
    <Modal id="shipPickerModal" title="함순이 선택">
        <input type="text" id="ship-picker-search" class="picker-search-input" placeholder="함순이 이름 검색..." autocomplete="off" />
        <div class="picker-filters">
            <div class="filter-row">
                <label class="filter-label">함종</label>
                <div id="ship-type-filters" class="filter-chips"></div>
            </div>
            <div class="filter-row">
                <label class="filter-label">레어도</label>
                <div id="ship-rarity-filters" class="filter-chips"></div>
            </div>
            <div class="filter-row">
                <label class="filter-label">진영</label>
                <div id="ship-nation-filters" class="filter-chips"></div>
            </div>
        </div>
        <div id="ship-picker-grid" class="picker-grid scroll-styled"></div>
    </Modal>

    <!-- Equipment Picker Modal -->
    <Modal id="equipPickerModal" title="장비 선택">
        <input type="text" id="equip-picker-search" class="picker-search-input" placeholder="장비 이름 검색..." autocomplete="off" />
        <div class="picker-filters">
            <div class="filter-row">
                <label class="filter-label">레어도</label>
                <div id="equip-rarity-filters" class="filter-chips"></div>
            </div>
        </div>
        <div id="equip-picker-grid" class="picker-grid scroll-styled"></div>
    </Modal>

    <!-- Save/Load Modal -->
    <Modal id="saveLoadModal" title="편성 저장/불러오기">
        <div class="save-load-content">
            <div class="save-section">
                <div class="save-input-row">
                    <input type="text" id="save-name-input" class="picker-search-input" placeholder="편성 이름 입력..." maxlength="30" />
                    <button id="save-btn" class="btn btn-primary">
                        <span class="material-symbols-outlined">save</span>
                        저장
                    </button>
                </div>
            </div>
            <div class="save-divider"></div>
            <div id="save-slot-list" class="save-slot-list scroll-styled">
                <p class="save-empty-msg">저장된 편성이 없습니다.</p>
            </div>
        </div>
    </Modal>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="loading-overlay">
        <div class="loading-spinner">
            <span class="material-symbols-outlined loading-icon">sync</span>
            <span class="loading-text">데이터 로딩 중...</span>
        </div>
    </div>

    <!-- JS Modules -->
    <script is:inline type="module" src={`${base}/js/simulators/fleet-sim.data.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/fleet-sim.calc.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/fleet-sim.ui.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/fleet-sim.picker.js`}></script>
    <script is:inline type="module" src={`${base}/js/simulators/fleet-sim.main.js`}></script>
</Layout>
