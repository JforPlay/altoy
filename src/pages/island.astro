---
/**
 * Island Management Page
 * Multi-tab hub for characters, technology, quests, resources, restaurant, season calc.
 */
import Layout from '../layouts/Layout.astro';

import '../styles/island/island.style.css';
import '../styles/island/island.character.style.css';
import '../styles/island/island.technology.layout.css';
import '../styles/island/island.technology.skill-tree.css';
import '../styles/island/island.technology.cards.css';
import '../styles/island/island.technology.detail.css';
import '../styles/island/island.technology.totals.css';
import '../styles/island/island.technology.responsive.css';
import '../styles/island/island.quest.style.css';
import '../styles/island/island.resource.layout.css';
import '../styles/island/island.resource.recipe.css';
import '../styles/island/island.resource.tree.css';
import '../styles/island/island.resource.modal.css';
import '../styles/island/island.resource.costs.css';
import '../styles/island/island.resource.responsive.css';
import '../styles/island/island.resource.forest.css';
import '../styles/island/island.restaurant.base.css';
import '../styles/island/island.restaurant.controls.css';
import '../styles/island/island.restaurant.menu.css';
import '../styles/island/island.restaurant.comparison.css';
import '../styles/island/island.restaurant.responsive.css';
import '../styles/island/island.restaurant.modal.css';
import '../styles/island/island.restaurant.planner.css';
import '../styles/island/island.season-calc.style.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Island" bodyClass="dark-mode" {base}>
    <div class="island-container">
        <header class="island-header">
            <h1>
                <span class="material-symbols-outlined">forest</span>
                벽뜌땨 관리
            </h1>
            <p class="subtitle">함순이, 기술, 퀘스트, 자원, 레스토랑, 시즌 계산 정보를 한 곳에서 확인하세요</p>
        </header>

        <nav class="tab-navigation" role="tablist" aria-label="Island sections">
            <button class="tab-button active" type="button" data-tab="characters">
                <span class="material-symbols-outlined">group</span>
                캐릭터
            </button>
            <button class="tab-button" type="button" data-tab="technology">
                <span class="material-symbols-outlined">build</span>
                기술
            </button>
            <button class="tab-button" type="button" data-tab="quests">
                <span class="material-symbols-outlined">task_alt</span>
                퀘스트
            </button>
            <button class="tab-button" type="button" data-tab="resources">
                <span class="material-symbols-outlined">inventory</span>
                자원
            </button>
            <button class="tab-button" type="button" data-tab="restaurant">
                <span class="material-symbols-outlined">restaurant</span>
                레스토랑
            </button>
            <button class="tab-button" type="button" data-tab="season-calc">
                <span class="material-symbols-outlined">calculate</span>
                시즌 계산기
            </button>
        </nav>

        <div class="tab-content-wrapper">
            <section class="tab-content active" id="tab-characters">
                <div class="search-section">
                    <div class="dropdown-container">
                        <input type="text" id="character-search" placeholder="함순이 이름으로 검색..." autocomplete="off">
                        <span class="material-symbols-outlined dropdown-icon">search</span>
                    </div>
                </div>

                <div class="content-layout">
                    <aside class="character-list scroll-styled" id="character-list">
                        <div class="page-status page-status-loading">
                            <div class="spinner"></div>
                            <p class="page-status-msg">함순이 불러오는 중...</p>
                        </div>
                    </aside>

                    <main class="character-detail" id="character-detail">
                        <div class="page-status page-status-empty">
                            <span class="material-symbols-outlined page-status-icon">person_search</span>
                            <p class="page-status-msg">목록에서 함순이를 선택해 상세 정보, 스탯, 스킬, 스킨을 확인하세요.</p>
                        </div>
                    </main>
                </div>
            </section>

            <section class="tab-content" id="tab-technology">
                <div class="tech-category-filter" id="tech-category-filter">
                    <div class="page-status page-status-loading">
                        <div class="spinner"></div>
                        <p class="page-status-msg">기술 데이터를 불러오는 중...</p>
                    </div>
                </div>

                <div class="tech-layout">
                    <div class="tech-tree-container scroll-styled" id="tech-tree-container">
                        <div class="page-status page-status-loading">
                            <div class="spinner"></div>
                            <p class="page-status-msg">기술 트리를 불러오는 중...</p>
                        </div>
                    </div>

                    <div class="tech-resource-totals-wrapper">
                        <div id="tech-resource-totals"></div>
                    </div>
                </div>

                <aside class="tech-detail scroll-styled" id="tech-detail">
                    <div class="page-status page-status-empty">
                        <span class="material-symbols-outlined page-status-icon">developer_board</span>
                        <p class="page-status-msg">기술을 선택해 상세 정보, 필요 조건, 제작 정보를 확인하세요.</p>
                    </div>
                </aside>
            </section>

            <section class="tab-content" id="tab-quests">
                <div class="search-section">
                    <div class="dropdown-container">
                        <input type="text" id="quest-search" placeholder="퀘스트 이름으로 검색..." autocomplete="off">
                        <span class="material-symbols-outlined dropdown-icon">search</span>
                    </div>
                </div>

                <div class="quest-type-filter" id="quest-type-filter">
                    <div class="page-status page-status-loading">
                        <div class="spinner"></div>
                        <p class="page-status-msg">퀘스트 데이터를 불러오는 중...</p>
                    </div>
                </div>

                <div class="quest-layout">
                    <aside class="quest-list scroll-styled" id="quest-list">
                        <div class="page-status page-status-loading">
                            <div class="spinner"></div>
                            <p class="page-status-msg">퀘스트를 불러오는 중...</p>
                        </div>
                    </aside>

                    <main class="quest-detail" id="quest-detail">
                        <div class="page-status page-status-empty">
                            <span class="material-symbols-outlined page-status-icon">task_alt</span>
                            <p class="page-status-msg">목록에서 퀘스트를 선택해 상세 정보, 조건, 목표를 확인하세요.</p>
                        </div>
                    </main>
                </div>
            </section>

            <section class="tab-content" id="tab-resources">
                <div class="resource-category-filter" id="resource-category-filter">
                    <div class="page-status page-status-loading">
                        <div class="spinner"></div>
                        <p class="page-status-msg">레시피 데이터를 불러오는 중...</p>
                    </div>
                </div>

                <div class="resource-layout">
                    <aside class="recipe-list scroll-styled" id="recipe-list">
                        <div class="page-status page-status-loading">
                            <div class="spinner"></div>
                            <p class="page-status-msg">레시피를 불러오는 중...</p>
                        </div>
                    </aside>

                    <main class="recipe-detail" id="recipe-detail">
                        <div class="page-status page-status-empty">
                            <span class="material-symbols-outlined page-status-icon">restaurant</span>
                            <p class="page-status-msg">목록에서 레시피를 선택해 재료, 생산물, 연계 레시피를 확인하세요.</p>
                        </div>
                    </main>

                    <aside class="dependency-chain scroll-styled" id="dependency-chain">
                        <div class="page-status page-status-empty">
                            <span class="material-symbols-outlined page-status-icon">account_tree</span>
                            <p class="page-status-msg">레시피를 선택하면 연결된 상위/하위 레시피를 확인할 수 있습니다.</p>
                        </div>
                    </aside>
                </div>
            </section>

            <section class="tab-content" id="tab-restaurant">
                <div class="restaurant-tabs-container">
                    <div class="restaurant-tabs" id="restaurant-tabs">
                        <div class="page-status page-status-loading">
                            <div class="spinner"></div>
                            <p class="page-status-msg">레스토랑을 불러오는 중...</p>
                        </div>
                    </div>
                </div>

                <div class="restaurant-controls">
                    <div class="rank-selector-container">
                        <div id="rank-selector">
                            <div class="page-status page-status-loading">
                                <div class="spinner"></div>
                                <p class="page-status-msg">등급을 불러오는 중...</p>
                            </div>
                        </div>
                    </div>

                    <div class="event-toggles-container">
                        <div id="event-toggles">
                            <div class="page-status page-status-loading">
                                <div class="spinner"></div>
                                <p class="page-status-msg">이벤트를 불러오는 중...</p>
                            </div>
                        </div>
                    </div>

                    <div class="shipgirl-selector-container">
                        <div id="shipgirl-1-selector">
                            <div class="page-status page-status-loading">
                                <div class="spinner"></div>
                                <p class="page-status-msg">함순이를 불러오는 중...</p>
                            </div>
                        </div>
                    </div>

                    <div class="shipgirl-selector-container">
                        <div id="shipgirl-2-selector">
                            <div class="page-status page-status-loading">
                                <div class="spinner"></div>
                                <p class="page-status-msg">함순이를 불러오는 중...</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="restaurant-menu-container">
                    <div class="restaurant-menu-list card-grid" id="restaurant-menu-list">
                        <div class="page-status page-status-loading">
                            <div class="spinner"></div>
                            <p class="page-status-msg">메뉴를 불러오는 중...</p>
                        </div>
                    </div>
                </div>

                <div id="restaurant-planner-view" class="hidden"></div>
            </section>

            <section class="tab-content" id="tab-season-calc">
                <div id="season-calc-pass">
                    <div class="page-status page-status-loading">
                        <div class="spinner"></div>
                        <p class="page-status-msg">시즌 패스를 불러오는 중...</p>
                    </div>
                </div>

                <div id="season-calc-total">
                    <div class="page-status page-status-loading">
                        <div class="spinner"></div>
                        <p class="page-status-msg">총합 계산 중...</p>
                    </div>
                </div>

                <div id="season-calc-controls">
                    <div class="page-status page-status-loading">
                        <div class="spinner"></div>
                        <p class="page-status-msg">계산기를 불러오는 중...</p>
                    </div>
                </div>

                <div class="season-calc-layout">
                    <div class="season-calc-grid card-grid" id="season-calc-grid">
                        <div class="page-status page-status-loading">
                            <div class="spinner"></div>
                            <p class="page-status-msg">아이템을 불러오는 중...</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div id="dependency-modal" class="recipe-modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-container">
            <div class="modal-header">
                <h3 id="modal-title">Recipe Dependencies</h3>
                <button class="btn btn-close" type="button" aria-label="Close">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-content scroll-styled" id="modal-content"></div>
        </div>
    </div>

    <div id="planner-modal" class="recipe-modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-container planner-modal-container">
            <div class="modal-header">
                <h3>
                    <span class="material-symbols-outlined">event_note</span>
                    일일 식단 계획
                </h3>
                <button class="btn btn-close" id="planner-modal-close" type="button" aria-label="Close">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-content scroll-styled" id="planner-modal-content"></div>
        </div>
    </div>

    <div id="confirm-modal" class="recipe-modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-container confirm-modal-container">
            <div class="modal-header">
                <h3>
                    <span class="material-symbols-outlined">warning</span>
                    확인
                </h3>
                <button class="btn btn-close" id="confirm-modal-close" type="button" aria-label="Close">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-content scroll-styled">
                <p id="confirm-message" class="confirm-message">진행하시겠습니까?</p>
                <div class="confirm-actions">
                    <button id="confirm-btn-cancel" class="btn btn-secondary" type="button">취소</button>
                    <button id="confirm-btn-ok" class="btn btn-primary" type="button">확인</button>
                </div>
            </div>
        </div>
    </div>

    <script is:inline type="module" src={`${base}/js/island/island.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.character.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.technology.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.quest.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.resource.tree.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.resource.render.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.resource.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.restaurant.calc.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.restaurant.planner.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.restaurant.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.season-calc.engine.js`}></script>
    <script is:inline type="module" src={`${base}/js/island/island.script.js`}></script>
</Layout>
