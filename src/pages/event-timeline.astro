---
/**
 * Event Timeline
 * Converted from pages/event-timeline.html
 */
import Layout from '../layouts/Layout.astro';
import '../styles/event-timeline.css';
---

<Layout title="이벤트 타임라인 - 벽람항로">
    <div class="container">
        <header>
            <div class="page-title">
                <h1>벽람항로 룽섭이벤트 전체보기</h1>
                <button class="info-button" id="info-button" aria-label="도움말 보기">
                    <i class="fas fa-info-circle"></i>
                </button>
            </div>

            <div id="info-popup" class="info-popup" role="dialog" aria-labelledby="popup-title" aria-hidden="true">
                <div class="info-popup-content">
                    <div class="popup-header">
                        <h2 id="popup-title">초간단 설명서</h2>
                        <button class="close-popup-btn" aria-label="닫기"><i class="fas fa-times"></i></button>
                    </div>
                    <div class="popup-body">
                        <div class="info-step">
                            <div class="info-icon"><i class="fas fa-filter"></i></div>
                            <div class="info-content">
                                <h3>필터링 기능</h3>
                                <p>• 검색창에서 이벤트명 또는 함선 이름으로 검색<br>
                                    • 이벤트 분류, 진영, 무딱이벤 (O, X) 여부로 필터링<br>
                                    • 복각/상시 현황으로 분류 가능<br>
                                    • 모든 이벤트는 신규/복각/상시 전부 각각 구현되어있습니다<br>
                                    ex) 뱅가드 이벤트 -> 신규 / 복각 / 상시 모두 존재<br>
                                    복각 or 상시편입된 이벤트만 보려면 필터링을 사용해주세요</p>
                            </div>
                        </div>
                        <div class="info-step">
                            <div class="info-icon"><i class="fas fa-mouse-pointer"></i></div>
                            <div class="info-content">
                                <h3>상세 페이지 이동</h3>
                                <p>해당 스킨의 이미지를 클릭하면 함순이 DB 페이지로 이동됩니다.</p>
                            </div>
                        </div>
                        <div class="warning-box">
                            <i class="fas fa-exclamation-triangle"></i>
                            <div>
                                <strong>주의사항</strong>
                                <p>굵직한 이벤트 외에 자잘한 이벤트들은 일섭 기반 일정으로 정리됨<br>
                                    기본적으로 숨겨져 있으며, 필터에서 활성화하면 볼 수 있습니다</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="search-container">
                <input type="text" id="searchInput" placeholder="이벤트명 또는 함선 이름으로 검색..." autocomplete="off">
                <button id="clearBtn" class="clear-btn">×</button>
            </div>
            <div class="filter-container">
                <select id="categoryFilter" aria-label="이벤트 분류 필터">
                    <option value="">모든 이벤트 분류</option>
                </select>
                <select id="factionFilter" aria-label="진영 필터">
                    <option value="">모든 진영</option>
                </select>
                <select id="mudakFilter" aria-label="무딱 이벤트 필터">
                    <option value="">무딱이벤여부 - 전체</option>
                    <option value="O">O</option>
                    <option value="X">X</option>
                </select>
                <select id="rerunStatusFilter" aria-label="복각/상시 현황 필터">
                    <option value="">복각/상시현황 - 전체</option>
                    <option value="신규">신규만</option>
                    <option value="복각">복각만</option>
                    <option value="상시편입">상시편입만</option>
                    <option value="empty">미정</option>
                </select>
                <label class="checkbox-label">
                    <input type="checkbox" id="showJpDatesFilter" aria-label="일섭 기반 일정 포함">
                    정리안된 일섭기반 일정포함보기
                </label>
            </div>
        </header>

        <div class="stats" role="status" aria-live="polite">
            <span id="eventCount">총 0개 이벤트</span>
        </div>

        <div id="eventList" class="event-list" role="region" aria-label="이벤트 목록">
            <div class="loading">데이터를 불러오는 중...</div>
        </div>
    </div>

    <script is:inline type="module" src="/altoy/js/event-timeline.js"></script>
</Layout>
