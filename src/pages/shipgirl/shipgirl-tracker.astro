---
/**
 * Shipgirl Tracker
 * Converted from pages/shipgirl/shipgirl-tracker.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/rarity.css';
import '../../styles/shipgirl/shipgirl-tracker.core.css';
import '../../styles/shipgirl/shipgirl-tracker.filters.css';
import '../../styles/shipgirl/shipgirl-tracker.cards.css';
import '../../styles/shipgirl/shipgirl-tracker.scores.css';
import '../../styles/shipgirl/shipgirl-tracker.controls.css';
import '../../styles/shipgirl/shipgirl-tracker.responsive.css';
import '../../styles/shipgirl/shipgirl-tracker.goal.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람 점수 트래커" {base}>
    <!-- Page Header -->
    <header class="st-page-header">
        <div class="header-top">
            <div class="header-title-container">
                <span class="material-symbols-outlined">calculate</span>
                <h1>기술/진영점수 계산기</h1>
                <button class="info-button" id="info-button" title="사용법 보기">
                    <i class="fas fa-info-circle"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Info Popup -->
    <div id="info-popup" class="info-popup" role="dialog" aria-labelledby="popup-title" aria-hidden="true">
        <div class="info-popup-content">
            <div class="popup-header">
                <h2 id="popup-title">초간단 설명서</h2>
                <button class="close-popup-btn" aria-label="닫기">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="popup-body">
                <div class="info-step">
                    <div class="info-icon"><i class="fas fa-check-square"></i></div>
                    <div class="info-content">
                        <h3>보유 체크</h3>
                        <p>함순이 카드를 클릭해서 보유 여부를 체크할 수 있습니다. 체크한 함순이는 기술/진영 점수에 반영됩니다.</p>
                    </div>
                </div>
                <div class="info-step">
                    <div class="info-icon"><i class="fas fa-filter"></i></div>
                    <div class="info-content">
                        <h3>필터</h3>
                        <p>상단 툴바의 <strong>필터</strong> 버튼으로 등급, 진영, 함종 등 다양한 조건으로 필터링할 수 있습니다.</p>
                    </div>
                </div>
                <div class="info-step">
                    <div class="info-icon"><i class="fas fa-chart-bar"></i></div>
                    <div class="info-content">
                        <h3>점수판 & 목표</h3>
                        <p><strong>점수판</strong>에서 현재 기술/진영 점수를 확인하고, <strong>목표</strong>에서 달성 현황을 추적할 수 있습니다.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="st-toolbar">
        <div class="st-toolbar-left">
            <div class="st-search-wrapper">
                <span class="material-symbols-outlined st-search-icon">search</span>
                <input type="text" id="search-bar" class="st-search-input" placeholder="이름으로 검색..." autocomplete="off">
                <div class="dropdown-content" id="search-dropdown"></div>
            </div>
        </div>
        <div class="st-toolbar-right">
            <button class="st-toolbar-btn" id="filter-drawer-btn">
                <span class="material-symbols-outlined">tune</span>
                <span>필터</span>
                <span class="st-badge hidden" id="filter-badge">0</span>
            </button>
            <button class="st-toolbar-btn" id="score-modal-btn">
                <span class="material-symbols-outlined">leaderboard</span>
                <span>점수판</span>
            </button>
            <button class="st-toolbar-btn" id="goal-modal-btn">
                <span class="material-symbols-outlined">flag</span>
                <span>연구 목표</span>
            </button>
        </div>
    </div>

    <!-- Active filter chips + total score -->
    <div class="st-chips-row" id="filter-chips">
        <div class="st-total-score" id="total-score-bar">
            <span class="material-symbols-outlined">military_tech</span>
            <span class="st-total-score-value" id="total-score-value">0</span>
            <span class="st-total-score-sep">/</span>
            <span class="st-total-score-max" id="total-score-max">0</span>
        </div>
    </div>

    <!-- Ship list -->
    <div id="ship-list-container"></div>

    <!-- Filter Drawer (right side) -->
    <div class="st-drawer-backdrop hidden" id="filter-drawer-backdrop"></div>
    <aside class="st-drawer" id="filter-drawer">
        <div class="st-drawer-header">
            <h2>필터</h2>
            <button class="st-drawer-close" aria-label="닫기">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="st-drawer-body scroll-styled" id="filter-drawer-body">
            <!-- Filter controls rendered by JS -->
        </div>
    </aside>

    <!-- Score Modal -->
    <div class="st-modal hidden" id="score-modal">
        <div class="st-modal-content st-modal-lg scroll-styled">
            <div class="st-modal-header">
                <h2>점수 현황</h2>
                <button class="st-modal-close modal-close" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="st-modal-body" id="score-modal-body">
                <div id="fleet-tech-container"></div>
                <div id="stat-tech-container"></div>
                <div id="faction-tech-container"></div>
            </div>
        </div>
    </div>

    <!-- Goal Modal -->
    <div class="st-modal hidden" id="goal-modal">
        <div class="st-modal-content st-modal-md scroll-styled">
            <div class="st-modal-header">
                <h2>목표 달성 현황</h2>
                <button class="st-modal-close modal-close" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="st-modal-body" id="goal-modal-body">
                <!-- Goal tracker rendered by JS -->
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="st-modal hidden" id="confirmation-modal">
        <div class="st-modal-content st-modal-sm scroll-styled">
            <div class="st-modal-header">
                <h2>확인</h2>
                <button class="st-modal-close modal-close" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="st-modal-body">
                <p id="modal-text" class="confirm-message"></p>
                <div class="modal-actions">
                    <button id="modal-confirm-btn">당장 진행시켜</button>
                    <button id="modal-cancel-btn">잘못 눌렀어요</button>
                </div>
            </div>
        </div>
    </div>

    <script is:inline type="module" src={`${base}/js/shipgirl/shipgirl-tracker-utils.js`}></script>
    <script is:inline type="module" src={`${base}/js/shipgirl/shipgirl-tracker.js`}></script>
</Layout>
