---
/**
 * Shipgirl Info Database
 * Converted from pages/shipgirl/shipgirl-info.html
 */
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/Modal.astro';
import '../../styles/rarity.css';
import '../../styles/shipgirl/shipgirl-info.core.css';
import '../../styles/shipgirl/shipgirl-info.cards.css';
import '../../styles/shipgirl/shipgirl-info.detail.css';
import '../../styles/shipgirl/shipgirl-info.controls.css';
import '../../styles/shipgirl/shipgirl-info.skills.css';
import '../../styles/shipgirl/shipgirl-info.responsive.css';
import '../../styles/shipgirl/shipgirl-info.modal.css';
import '../../styles/shipgirl/shipgirl-info.maps.css';
import '../../styles/shipgirl/shipgirl-info.skill-search.css';
import '../../styles/shipgirl/shipgirl-info.retrofit.css';
import '../../styles/shipgirl/shipgirl-info.timer.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="함순이 DB" {base}>
    <div id="app">
        <div id="mainView" class="view">
            <header>
                <div class="header-top">
                    <div class="header-title-container">
                        <span class="material-symbols-outlined">database</span>
                        <h1>함순이 DB</h1>
                        <button class="info-button" id="info-button" title="사용법 보기">
                            <i class="fas fa-info-circle"></i>
                        </button>
                    </div>
                    <div class="header-stats-row">
                        <button class="map-browser-btn" id="skillSearchBtn" title="스킬 이름/효과 검색">
                            <i class="fas fa-wand-magic-sparkles"></i>
                            <span>스킬 검색</span>
                        </button>
                        <button class="map-browser-btn" id="mapBrowserBtn" title="드랍 지역별 함순이 보기">
                            <i class="fas fa-map-marked-alt"></i>
                            <span>드랍 지역</span>
                        </button>
                        <button class="map-browser-btn" id="buildTimerBtn" title="건조 시간별 함순이 보기">
                            <i class="fas fa-hourglass-half"></i>
                            <span>건조 시간</span>
                        </button>
                        <div class="stats-container stats-header">
                            <div class="stat-item">
                                <span class="stat-label">총 함순이:</span>
                                <span class="stat-value" data-stat="total">0</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">표시 중:</span>
                                <span class="stat-value" data-stat="filtered">0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <div class="filter-rail" id="filterRail">
                <div class="rail-line">
                    <div class="search-pill">
                        <i class="fas fa-magnifying-glass search-pill-icon" aria-hidden="true"></i>
                        <input type="text" id="searchInput" placeholder="캐릭터 이름 검색..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
                    </div>
                    <div class="stats-container stats-rail">
                        <div class="stat-item">
                            <span class="stat-label">총 함순이:</span>
                            <span class="stat-value" data-stat="total">0</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">표시 중:</span>
                            <span class="stat-value" data-stat="filtered">0</span>
                        </div>
                    </div>
                    <div class="view-toggle btn-group" role="tablist" aria-label="보기 방식">
                        <button class="view-toggle-btn btn btn-outline is-active" id="gridViewBtn" type="button" role="tab" aria-selected="true" aria-label="그리드 보기" title="그리드 보기"><span class="material-symbols-outlined" aria-hidden="true">grid_view</span></button>
                        <button class="view-toggle-btn btn btn-outline" id="listViewBtn" type="button" role="tab" aria-selected="false" aria-label="리스트 보기" title="리스트 보기"><span class="material-symbols-outlined" aria-hidden="true">view_list</span></button>
                    </div>
                </div>
                <div class="rail-line rail-filters">
                    <div class="rail-selects">
                        <select id="rarityFilter">
                            <option value="">모든 등급</option>
                            <option value="N">N</option>
                            <option value="R">R</option>
                            <option value="SR">SR</option>
                            <option value="SSR">SSR</option>
                            <option value="UR">UR</option>
                        </select>
                        <select id="shipTypeFilter">
                            <option value="">모든 함종</option>
                        </select>
                        <select id="nationalityFilter">
                            <option value="">모든 진영</option>
                        </select>
                        <select id="constructionFilter">
                            <option value="all">모든 건조</option>
                            <option value="light">소형 건조</option>
                            <option value="heavy">중형 건조</option>
                            <option value="special">특형 건조</option>
                            <option value="limited">한정 건조</option>
                        </select>
                    </div>
                    <span class="rail-divider" aria-hidden="true"></span>
                    <div class="rail-toggles">
                        <button id="retrofitFilter" class="filter-toggle-btn" type="button" aria-pressed="false" title="개조 가능한 함순이만 보기">
                            <i class="fas fa-wrench" aria-hidden="true"></i>
                            <span>개조 가능</span>
                        </button>
                        <button id="spWeaponFilter" class="filter-toggle-btn" type="button" aria-pressed="false" data-flag="has_sp_weapon" title="특수장비가 있는 함순이만 보기">
                            <i class="fas fa-gem" aria-hidden="true"></i>
                            <span>특수장비 보유</span>
                        </button>
                        <button id="exVoiceFilter" class="filter-toggle-btn" type="button" aria-pressed="false" data-flag="has_ex_voice" title="EX 대사가 있는 스킨을 가진 함순이만 보기">
                            <i class="fas fa-comment-dots" aria-hidden="true"></i>
                            <span>EX 대사 있음</span>
                        </button>
                    </div>
                </div>
            </div>

            <div id="info-popup" class="info-popup" role="dialog" aria-labelledby="popup-title" aria-hidden="true">
                <div class="info-popup-content">
                    <div class="popup-header">
                        <h2 id="popup-title">초간단 설명서</h2>
                        <button class="close-popup-btn" aria-label="닫기">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="popup-body">
                        <div class="info-step">
                            <div class="info-icon"><i class="fas fa-filter"></i></div>
                            <div class="info-content">
                                <h3>필터링 기능</h3>
                                <p>• 이름 검색: 함순이 이름으로 검색할 수 있습니다<br>• 등급: N, R, SR, SSR, UR 등급으로 필터링<br>• 함종: 구축함, 경순양함, 중순양함 등으로 필터링<br>• 진영: 각 진영별로 필터링<br>• 건조: 소형/중형/특형/한정 건조로 필터링<br>• 개조 가능 / 특수장비 보유 / EX 대사 있음: 켜면 해당하는 함순이만 표시 (여러 개를 켜면 모두 해당하는 함순이만)</p>
                            </div>
                        </div>
                        <div class="info-step">
                            <div class="info-icon"><i class="fas fa-mouse-pointer"></i></div>
                            <div class="info-content">
                                <h3>상세 정보</h3>
                                <p>함순이 카드를 클릭하면 스탯, 스킬, 특수장비 등 상세 정보를 볼 수 있습니다</p>
                            </div>
                        </div>
                        <div class="info-step">
                            <div class="info-icon"><i class="fas fa-hourglass-half"></i></div>
                            <div class="info-content">
                                <h3>건조 시간표</h3>
                                <p>• 건조 시간 버튼: 건조 시간별로 함순이를 모아서 보여줍니다<br>• 시간 검색: 숫자만 입력해도 됩니다 (예: 0410 → 04:10:00, 04 → 4시간대 전체)<br>• 소형/중형/특형/한정 풀과 등급·진영·함종으로 좁힐 수 있습니다<br>• 막대그래프: 막대를 누르면 그 30분 구간만 보이고, 다시 누르면 전체가 보입니다</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="shipgirls" class="shipgirl-grid card-grid"></div>
        </div>

        <div id="detailView" class="view" style="display: none;">
            <header class="detail-view-header">
                <button id="backButton" class="back-button"><span class="material-symbols-outlined">arrow_back</span></button>
                <button id="homeButton" class="back-button"><span class="material-symbols-outlined">view_list</span></button>
                <span class="detail-nav-spacer"></span>
                <span id="detailNavCounter" class="detail-nav-counter"></span>
                <button id="prevShipBtn" class="back-button" disabled title="이전 함순이"><span class="material-symbols-outlined">navigate_before</span></button>
                <button id="nextShipBtn" class="back-button" disabled title="다음 함순이"><span class="material-symbols-outlined">navigate_next</span></button>
            </header>
            <div id="detailContent" class="detail-content"></div>
        </div>

        <div id="loading" class="page-status page-status-loading">
            <div class="spinner"></div>
            <p class="page-status-msg">로딩 중...</p>
        </div>

        <div id="mapsModal" class="shipgirl-modal maps-modal" style="display: none;">
            <div class="shipgirl-modal-content maps-modal-content">
                <div class="shipgirl-modal-header maps-modal-header">
                    <h2 id="mapsModalTitle">드랍 지역</h2>
                    <button class="shipgirl-modal-close maps-modal-close" id="closeMapsModal"><i class="fas fa-times"></i></button>
                </div>
                <div class="shipgirl-modal-body maps-modal-body">
                    <div class="maps-search-container">
                        <input type="text" id="mapsSearchInput" placeholder="지역 검색 (e.g., 13-3, 13지, 16-2)...">
                        <button id="clearMapsSearch" class="clear-search-btn" style="display: none;"><i class="fas fa-times"></i></button>
                    </div>
                    <div id="mapsContent" class="maps-content"></div>
                </div>
            </div>
        </div>

        <div id="mapBrowserModal" class="shipgirl-modal maps-modal" style="display: none;">
            <div class="shipgirl-modal-content maps-modal-content map-browser-modal-content">
                <div class="shipgirl-modal-header maps-modal-header">
                    <h2>드랍 지역별 함순이</h2>
                    <button class="shipgirl-modal-close maps-modal-close" id="closeMapBrowserModal"><i class="fas fa-times"></i></button>
                </div>
                <div class="shipgirl-modal-body maps-modal-body">
                    <div class="map-browser-filters">
                        <div class="filter-bar filter-row">
                            <select id="mapBrowserAreaFilter" class="map-browser-filter"><option value="all">모든 지역</option></select>
                            <select id="mapBrowserMapFilter" class="map-browser-filter"><option value="all">모든 맵</option></select>
                            <select id="mapBrowserTypeFilter" class="map-browser-filter">
                                <option value="all">모든 타입</option>
                                <option value="0">일반</option>
                                <option value="1">보스</option>
                            </select>
                        </div>
                        <div class="filter-bar filter-row">
                            <select id="mapBrowserRarityFilter" class="map-browser-filter">
                                <option value="all">모든 등급</option>
                                <option value="N">N</option>
                                <option value="R">R</option>
                                <option value="SR">SR</option>
                                <option value="SSR">SSR</option>
                                <option value="UR">UR</option>
                            </select>
                            <select id="mapBrowserShipTypeFilter" class="map-browser-filter"><option value="all">모든 함종</option></select>
                            <select id="mapBrowserNationalityFilter" class="map-browser-filter"><option value="all">모든 진영</option></select>
                        </div>
                        <input type="text" id="mapBrowserSearchInput" placeholder="함순이 이름 검색..." class="map-browser-search">
                    </div>
                    <div id="mapBrowserContent" class="map-browser-content"></div>
                </div>
            </div>
        </div>

        <div id="skillSearchModal" class="shipgirl-modal skill-search-modal">
            <div class="shipgirl-modal-content skill-search-modal-content">
                <div class="shipgirl-modal-header skill-search-modal-header">
                    <h2>스킬 검색</h2>
                    <button class="shipgirl-modal-close skill-search-modal-close" id="closeSkillSearchModal" aria-label="닫기"><i class="fas fa-times"></i></button>
                </div>
                <div class="shipgirl-modal-body skill-search-modal-body scroll-styled" id="skillSearchBody"></div>
            </div>
        </div>

        <Modal id="buildTimerModal" title="건조 시간표">
            <div class="bt-controls">
                <label class="bt-search">
                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                    <input type="text" id="btSearch" inputmode="numeric" placeholder="시간 검색 (예: 0410)" autocomplete="off" aria-label="건조 시간 검색">
                </label>
                <div class="btn-group bt-pools" role="group" aria-label="건조 풀">
                    <button type="button" class="btn btn-outline is-active" data-pool="all" aria-pressed="true">전체</button>
                    <button type="button" class="btn btn-outline" data-pool="light" aria-pressed="false">소형</button>
                    <button type="button" class="btn btn-outline" data-pool="heavy" aria-pressed="false">중형</button>
                    <button type="button" class="btn btn-outline" data-pool="special" aria-pressed="false">특형</button>
                    <button type="button" class="btn btn-outline" data-pool="limited" aria-pressed="false">한정</button>
                </div>
                <select id="btRarity" aria-label="등급">
                    <option value="">모든 등급</option>
                    <option value="N">N</option>
                    <option value="R">R</option>
                    <option value="SR">SR</option>
                    <option value="SSR">SSR</option>
                    <option value="UR">UR</option>
                </select>
                <select id="btNationality" aria-label="진영">
                    <option value="">모든 진영</option>
                </select>
                <select id="btType" aria-label="함종">
                    <option value="">모든 함종</option>
                </select>
            </div>
            <p id="btSummary" class="bt-summary" role="status"></p>
            <div id="btChart" class="bt-chart"></div>
            <div id="btRows" class="bt-rows"></div>
        </Modal>
    </div>

    <script is:inline type="module" src={`${base}/js/shipgirl/shipgirl-info.js`}></script>
</Layout>
