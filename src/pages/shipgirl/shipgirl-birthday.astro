---
/**
 * Shipgirl Birthday Calendar
 * Converted from pages/shipgirl/shipgirl-birthday.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/shipgirl/shipgirl-birthday.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="함순이 생일" bodyClass="calendar-page" {base}>
    <main class="birthday-container">
        <div class="calendar-controls">
            <button type="button" class="view-toggle active" data-view="year" title="연간 보기" aria-label="연간 보기로 전환" aria-pressed="true">
                <span class="material-symbols-outlined">calendar_month</span>
                연간
            </button>
            <button type="button" class="view-toggle" data-view="month" title="월간 보기" aria-label="월간 보기로 전환" aria-pressed="false">
                <span class="material-symbols-outlined">view_agenda</span>
                월간
            </button>
            <button type="button" class="view-toggle" data-view="week" title="주간 보기" aria-label="주간 보기로 전환" aria-pressed="false">
                <span class="material-symbols-outlined">view_week</span>
                주간
            </button>
            <div class="dropdown-container">
                <input type="search" id="searchInput" placeholder="함순이 검색..." aria-label="이름으로 함순이 검색" autocomplete="off">
                <span class="dropdown-icon material-symbols-outlined">search</span>
                <div class="dropdown-content" id="searchDropdown"></div>
            </div>
            <span class="calendar-title" id="calendarTitle"></span>
        </div>

        <div class="calendar-wrapper">
            <div class="calendar-view" id="calendarContainer"></div>
        </div>

        <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="다가오는 생일 사이드바 토글" aria-expanded="false" aria-controls="upcomingPanel">
            <span class="material-symbols-outlined">calendar_today</span>
        </button>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="upcoming-panel" id="upcomingPanel" aria-label="다가오는 생일 사이드바">
            <div class="upcoming-panel-header">
                <h2>다가오는 생일</h2>
                <button type="button" class="sidebar-close" id="sidebarClose" aria-label="사이드바 닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div id="upcomingList" class="upcoming-list" role="list"></div>
        </aside>
    </main>

    <template id="event-card-template">
        <div class="event-card">
            <img class="event-img" alt="" loading="lazy" />
            <div>
                <div class="title"></div>
                <div class="meta"></div>
                <div class="badges">
                    <span class="badge rarity-badge"></span>
                    <span class="badge badge--neutral type-badge"></span>
                    <span class="badge badge--neutral faction-badge"></span>
                </div>
            </div>
        </div>
    </template>

    <template id="event-card-empty-template">
        <div class="event-card">
            <div class="title"></div>
            <div class="meta"></div>
        </div>
    </template>

    <template id="upcoming-item-template">
        <div class="upcoming-item" role="listitem" tabindex="0">
            <img class="upcoming-icon" alt="" loading="lazy" />
            <div class="upcoming-info">
                <span class="upcoming-date"></span>
                <span class="upcoming-name" lang="ko"></span>
            </div>
        </div>
    </template>

    <template id="search-result-template">
        <a href="#" class="search-result-item">
            <strong lang="ko" class="search-name"></strong>
            <small class="search-meta"></small>
        </a>
    </template>

    <template id="no-results-template">
        <div class="no-results">함순이를 찾을 수 없습니다</div>
    </template>

    <script is:inline type="module" src={`${base}/js/shipgirl/shipgirl-birthday.js`}></script>
</Layout>
