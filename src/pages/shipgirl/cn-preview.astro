---
/**
 * CN 선행 컨텐츠 — ships and skins the CN server has and KR does not yet.
 * Data: public/data/preview/cn_preview.json (WSL cn_preview_process.py, §13).
 * Two views behind one toggle; the skin view reuses the skin detail viewer's
 * gallery (expression selector + composite + lightbox) and voice table, so it
 * imports that page's stylesheets and carries the same lightbox markup.
 * Off the navbar on purpose (homepage bento tile + Ctrl+K only) until KR ships it.
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/rarity.css';
import '../../styles/skin/skin.common.css';
import '../../styles/skin/skin.detail.viewer.header.css';
import '../../styles/skin/skin.detail.viewer.gallery.css';
import '../../styles/skin/skin.detail.viewer.content.css';
import '../../styles/skin/skin.detail.viewer.responsive.css';
import '../../styles/skin/skin.detail.viewer.dark-mode.css';
import '../../styles/skin/skin.detail.viewer.expression.css';
import '../../styles/skin/cn-preview.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="(스포주의) 중섭패치 미리보기" {base}>
    <main class="container cn-preview-page" id="cn-preview-page">
        <header class="page-header">
            <div class="header-title-container page-header-title">
                <span class="material-symbols-outlined">travel_explore</span>
                <h1>(스포주의) 중섭패치 미리보기</h1>
            </div>
            <p class="page-header-subtitle">2주 먼저 진행되는 중섭 패치의 함순이/스킨/대사를 간단하게 먼저 확인가능합니다</p>
            <p class="cn-preview-disclaimer">
                중섭 인게임 정보/텍스트 기반이며, 비정기적으로 패치될 수 있습니다. <span id="cn-preview-meta"></span>
            </p>
        </header>

        <div id="cn-preview-status" role="status" aria-live="polite"></div>

        <div id="cn-preview-view-toggle" class="btn-group cn-view-toggle hidden" role="tablist" aria-label="보기 선택">
            <button type="button" class="btn btn-secondary" data-view="ships" role="tab">신규 함순이</button>
            <button type="button" class="btn btn-secondary" data-view="skins" role="tab">신규 스킨</button>
        </div>

        <section id="cn-preview-ships" class="cn-panel hidden">
            <h2>신규 함순이</h2>
            <div id="cn-preview-ship-grid" class="card-grid cn-preview-grid"></div>
        </section>

        <section id="cn-preview-skins" class="cn-panel hidden">
            <h2>신규 스킨</h2>
            <div id="cn-preview-skin-picker" class="card-grid cn-skin-picker"></div>
            <div id="cn-preview-skin-detail" class="cn-skin-detail hidden">
                <h2 id="cn-preview-skin-title" class="cn-skin-title" lang="zh"></h2>
                <div id="cn-preview-skin-info" class="skin-info-box cn-box"></div>
                <div id="cn-preview-skin-desc" class="cn-skin-desc hidden" lang="zh"></div>
                <div id="image-gallery" class="image-gallery cn-box hidden"></div>
                <div id="cn-preview-skin-voices" class="text-content-area hidden"></div>
            </div>
        </section>
    </main>

    <div id="lightbox-modal" class="lightbox-modal" role="dialog" aria-label="이미지 확대 보기" aria-hidden="true">
        <button class="lightbox-close" aria-label="닫기" type="button"><i class="fas fa-times"></i></button>
        <button class="lightbox-download" aria-label="이미지 저장" type="button"><i class="fas fa-download"></i></button>
        <button class="lightbox-prev" aria-label="이전 이미지" type="button"><i class="fas fa-chevron-left"></i></button>
        <button class="lightbox-next" aria-label="다음 이미지" type="button"><i class="fas fa-chevron-right"></i></button>
        <div class="lightbox-content">
            <img id="lightbox-image" src="" alt="">
            <div class="lightbox-caption"></div>
        </div>
        <div class="lightbox-counter"></div>
    </div>

    <script is:inline type="module" src={`${base}/js/skin/cn-preview.js`}></script>
</Layout>
