---
/**
 * Loading BG Viewer
 * Converted from pages/misc/loadingbg.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/misc/loadingbg.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람 로딩일러들" {base}>
    <div class="header">
        <h1 class="title">인게임 로딩일러들 보기</h1>
    </div>

    <div class="controls">
        <div class="search-box">
            <label class="sr-only" for="searchInput">Search loading backgrounds</label>
            <input type="search" id="searchInput" placeholder="파일이름으로 이미지 검색...">
        </div>
    </div>

    <div id="gallery-status" class="gallery-status" role="status" aria-live="polite"></div>
    <div id="gallery" class="gallery card-grid" aria-label="Loading background gallery"></div>

    <div id="lightbox" class="lightbox hidden" role="dialog" aria-modal="true" aria-label="Loading background viewer">
        <button class="lightbox-close" type="button" aria-label="Close image viewer">&times;</button>
        <button class="lightbox-prev" type="button" aria-label="Previous image">&#10094;</button>
        <button class="lightbox-next" type="button" aria-label="Next image">&#10095;</button>
        <img id="lightbox-img" src="" alt="">
        <div class="lightbox-caption"></div>
    </div>

    <div id="loading" class="page-status page-status-loading page-status--overlay" role="status" aria-live="polite">
        <div class="spinner"></div>
        <p class="page-status-msg">이미지들 로딩 중...</p>
    </div>

    <script is:inline type="module" src={`${base}/js/misc/loadingbg.js`}></script>
</Layout>
