---
/**
 * Loading BG Viewer
 * Converted from pages/misc/loadingbg.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/misc/loadingbg.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="벽람항로 로딩 일러" {base}>
    <div class="header">
        <h1 class="title">벽람 로딩일러 모음</h1>
    </div>

    <div class="controls">
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="이미지 검색...">
        </div>
    </div>

    <div id="gallery" class="gallery"></div>

    <div id="lightbox" class="lightbox">
        <button class="lightbox-close">&times;</button>
        <button class="lightbox-prev">&#10094;</button>
        <button class="lightbox-next">&#10095;</button>
        <img id="lightbox-img" src="" alt="">
        <div class="lightbox-caption"></div>
    </div>

    <div id="loading" class="loading">
        <div class="spinner"></div>
        <p>이미지 로딩 중...</p>
    </div>

    <script is:inline type="module" src={`${base}/js/misc/loadingbg.js`}></script>
</Layout>
