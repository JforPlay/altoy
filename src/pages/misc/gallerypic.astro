---
/**
 * Gallery Pic
 * Converted from pages/misc/gallerypic.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/misc/gallerypic.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Gallery Pictures" bodyClass="gallerypic-body" {base}>
    <div class="gallerypic-page">
        <header class="gallerypic-header">
            <h1>인게임 삽화 보기</h1>
        </header>

        <div id="gallery-status" class="gallery-status" role="status" aria-live="polite">갤러리 이미지를 불러오는 중...</div>
        <div id="gallery" class="gallery-grid" aria-label="Gallery pictures"></div>
    </div>

    <div id="modal" class="gallery-modal hidden" role="dialog" aria-modal="true" aria-label="Gallery image viewer">
        <div class="gallery-modal-content">
            <button id="close" class="btn btn-close gallery-modal-close" type="button" aria-label="Close image viewer">&times;</button>
            <img id="modal-image" src="" alt="" class="gallery-modal-image">
        </div>
    </div>

    <script is:inline type="module" src={`${base}/js/misc/gallerypic.js`}></script>
</Layout>
