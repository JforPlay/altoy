---
/**
 * Gallery Pic
 * Converted from pages/misc/gallerypic.html
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/misc/gallerypic.css';
---

<Layout title="삽화 갤러리" bodyClass="bg-gray-100 font-sans">
    <Fragment slot="head">
        <script is:inline src="https://cdn.tailwindcss.com"></script>
    </Fragment>

    <div class="container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold text-center text-gray-800 mb-12">벽람항로 삽화뷰어</h1>
        <div id="gallery" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
        </div>
    </div>

    <div id="modal" class="hidden fixed inset-0 bg-black bg-opacity-75 z-50 flex justify-center items-center p-4">
        <div class="relative">
            <span id="close" class="absolute -top-4 -right-4 text-white text-4xl font-bold cursor-pointer hover:text-gray-400 transition-colors">&times;</span>
            <img id="modal-image" src="" alt="Full-size gallery image" class="max-w-full max-h-[90vh] rounded-lg shadow-2xl">
        </div>
    </div>

    <script is:inline type="module" src="/altoy/js/misc/gallerypic.js"></script>
</Layout>
