---
/**
 * BGM Player
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/misc/bgm-player.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="BGM Player" {base}>
    <div class="bgm-player">
        <div class="album-carousel-container">
            <button class="nav-btn prev-btn" id="prev-btn" type="button" aria-label="Previous album">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6" />
                </svg>
            </button>
            <div class="album-list" id="album-list" aria-label="Album carousel"></div>
            <button class="nav-btn next-btn" id="next-btn" type="button" aria-label="Next album">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" />
                </svg>
            </button>
        </div>
        <div class="track-player-container">
            <div class="content-wrapper">
                <div class="track-list-container scroll-styled">
                    <ul id="track-list" aria-live="polite"></ul>
                </div>
                <div class="audio-player">
                    <div class="now-playing">
                        <h3 class="album-title" id="album-name">Select an album</h3>
                        <span class="now-playing-label">Now Playing</span>
                        <p id="now-playing-track" aria-live="polite">-</p>
                    </div>
                    <div class="visualizer-container">
                        <canvas id="visualizer-canvas"></canvas>
                    </div>
                    <audio id="audio" controls></audio>
                </div>
            </div>
        </div>
    </div>
    <script is:inline type="module" src={`${base}/js/misc/bgm-player.js`}></script>
</Layout>
