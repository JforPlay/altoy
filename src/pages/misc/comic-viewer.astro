---
/**
 * Comic Viewer
 */
import Layout from '../../layouts/Layout.astro';
import '../../styles/misc/comic-viewer.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Comic Viewer" {base}>
    <header>
        <h1>Comic Viewer</h1>
        <button id="sort-button" type="button" aria-pressed="false">Sort: newest first</button>
    </header>
    <main>
        <div id="gallery" class="gallery-container" aria-label="Comic gallery"></div>
    </main>

    <div id="lightbox" class="lightbox hidden" role="dialog" aria-modal="true" aria-label="Comic image viewer">
        <button class="close-button" type="button" aria-label="Close image">&times;</button>
        <img id="lightbox-img" class="lightbox-content" src="" alt="">
    </div>

    <script is:inline type="module" src={`${base}/js/misc/comic-viewer.js`}></script>
</Layout>
