---
/**
 * Base Layout for all pages
 * Converted from _layouts/default.html
 */
interface Props {
    title?: string;
    bodyClass?: string;
    theme?: string;
    description?: string;
    base?: string;
}

const {
    title = "벽람 장난감",
    bodyClass = "",
    theme,
    description = "ALtoy - Azur Lane KR fan-made web viewer",
    base = "/altoy"
} = Astro.props;

// Import global styles
import '../styles/global.style.css';
import '../styles/sync/sync.css';
// Canonical state component (loading/empty/error) — @imports spinner.css, so
// both are available site-wide without per-page imports.
import '../styles/components/status.css';
// Canonical display badge component — available site-wide, no per-page import.
import '../styles/components/badge.css';
import { NAV_STRUCTURE, PAGE_BY_KEY } from '../../public/js/pages.catalog.js';

// CSP — Astro dev server injects inline HMR/toolbar scripts, so we loosen
// script-src with 'unsafe-inline' only in dev. Production stays strict.
const isDev = import.meta.env.DEV;
const scriptSrc = isDev
    ? "'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.gstatic.com https://accounts.google.com https://static.cloudflareinsights.com"
    : "'self' https://cdn.jsdelivr.net https://www.gstatic.com https://accounts.google.com https://static.cloudflareinsights.com";
// worker-src is declared explicitly: without it, Worker/ServiceWorker fall back
// to script-src, which has no blob: source — blocking libraries that spawn a
// blob worker. Keep 'self' so the /altoy/sw.js service worker still registers.
const csp = `default-src 'self'; script-src ${scriptSrc}; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' https://raw.githubusercontent.com https://github.com; connect-src 'self' https://api.github.com https://www.googleapis.com https://content.googleapis.com https://raw.githubusercontent.com https://cloudflareinsights.com https://cdn.jsdelivr.net https://www.gstatic.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://accounts.google.com;`;
---

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <!-- Google Search Console ownership verification (for OAuth consent screen) -->
    <meta name="google-site-verification" content="UfP4AO8zr6gInwSWpKdPbsk77R9GsE5_-JEPlMgLRNs">
    <meta http-equiv="Content-Security-Policy" content={csp}>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="icon" href={`${base}/assets/icon/favicon.ico`} type="image/x-icon">

    <!-- Preconnect to external origins for faster loading -->
    <link rel="preconnect" href="https://raw.githubusercontent.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Modulepreload: every page loads these 4 module scripts + their static
         imports; without hints the nested imports (cache.db, synced-storage,
         pages.catalog) are only discovered after the parent module downloads. -->
    <link rel="modulepreload" href={`${base}/js/utils.js`}>
    <link rel="modulepreload" href={`${base}/js/cache.db.js`}>
    <link rel="modulepreload" href={`${base}/js/synced-storage.js`}>
    <link rel="modulepreload" href={`${base}/js/pages.catalog.js`}>
    <link rel="modulepreload" href={`${base}/js/global.script.js`}>
    <link rel="modulepreload" href={`${base}/js/global-search.js`}>
    <link rel="modulepreload" href={`${base}/js/global.init.js`}>

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&family=Noto+Sans+KR:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "a34273493b4d4973a33713a7b1273213"}'></script>

    <!-- Google Identity Services is lazy-loaded by drive-sync.auth.js on first sign-in. -->

    <!-- Page-specific head content -->
    <slot name="head" />
</head>

<body class={bodyClass} data-theme={theme || undefined}>
    <!-- Navigation -->
    <slot name="nav">
        <nav class="navbar">
            <div class="nav-container">
                <a href={`${base}/`} class="nav-logo">
                    <img src={`${base}/assets/img/체루.webp`} alt="Site Portrait" class="nav-portrait">
                    <span class="material-symbols-outlined">home</span>
                </a>

                <button class="theme-toggle" aria-label="Toggle theme">
                    <span class="material-symbols-outlined theme-icon-sun">light_mode</span>
                    <span class="material-symbols-outlined theme-icon-moon">dark_mode</span>
                </button>

                <button class="global-search-trigger" aria-label="검색 (Ctrl+K)">
                    <span class="material-symbols-outlined">search</span>
                    <kbd class="search-shortcut-hint">Ctrl K</kbd>
                </button>

                <ul class="nav-menu">
                    {NAV_STRUCTURE.map((dropdown) => {
                        if (dropdown.key) {
                            const page = PAGE_BY_KEY.get(dropdown.key);
                            if (!page) throw new Error(`Layout nav: NAV_STRUCTURE references unknown page key "${dropdown.key}" — add it to PAGE_CATALOG in public/js/pages.catalog.js`);
                            return (
                                <li class="nav-item">
                                    <a href={`${base}/${page.path}`} class="nav-links nav-links-direct">
                                        <span class="material-symbols-outlined nav-direct-icon">{page.icon}</span>
                                        {dropdown.label}
                                    </a>
                                </li>
                            );
                        }
                        return (
                        <li class="nav-item mega-dropdown">
                            <a href="#" class="nav-links">{dropdown.label}</a>
                            <div class="mega-menu">
                                <div class="mega-menu-content">
                                    {dropdown.columns.map((column) => (
                                        <div class="mega-menu-column">
                                            <h3 class="mega-menu-title">{column.title}</h3>
                                            {column.keys.map((key) => {
                                                const page = PAGE_BY_KEY.get(key);
                                                if (!page) throw new Error(`Layout nav: NAV_STRUCTURE references unknown page key "${key}" — add it to PAGE_CATALOG in public/js/pages.catalog.js`);
                                                return (
                                                    <a href={`${base}/${page.path}`} class="mega-menu-link">
                                                        <span class="material-symbols-outlined">{page.icon}</span>
                                                        <div>
                                                            <strong>{page.name}</strong>
                                                            <small>{page.description}</small>
                                                        </div>
                                                    </a>
                                                );
                                            })}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </li>
                        );
                    })}
                </ul>

                <div class="menu-icon">
                    <span class="material-symbols-outlined">menu</span>
                </div>
            </div>
        </nav>
    </slot>

    <!-- Global libraries (must load before page scripts) -->
    <!-- Fuse.js is lazy-loaded by utils.js#ensureFuse() on first search use. -->
    <script is:inline type="module" src={`${base}/js/utils.js`}></script>
    <script is:inline type="module" src={`${base}/js/global.script.js`}></script>
    <script is:inline type="module" src={`${base}/js/global-search.js`}></script>

    <!-- Main content -->
    <slot />

    <!-- Global Search Modal (native <dialog>; opened with showModal()) -->
    <dialog id="global-search-modal" class="global-search-overlay">
        <div class="global-search-container">
            <div class="global-search-header">
                <span class="material-symbols-outlined">search</span>
                <input type="text" id="global-search-input" autofocus
                       placeholder="함순이 이름 또는 페이지 검색..." autocomplete="off">
                <kbd class="global-search-esc">ESC</kbd>
                <button class="global-search-close" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div id="global-search-results" class="global-search-results scroll-styled">
                <div class="page-status page-status-empty page-status--compact">
                    <span class="material-symbols-outlined page-status-icon">search</span>
                    <p class="page-status-msg">검색어를 입력하세요</p>
                </div>
            </div>
            <div class="global-search-footer">
                <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> 이동</span>
                <span><kbd>Enter</kbd> 열기</span>
                <span><kbd>ESC</kbd> 닫기</span>
            </div>
        </div>
    </dialog>

    <!-- Footer -->
    <footer class="site-footer">
        <p><strong><i>ALtoy</i></strong> is a non-profit fan project for the mobile game <strong>Azur Lane</strong><br>
        &copy; <span id="copyright-year"></span> All assets/images/music in the project are the property of Manjuu, Yongshi, Yostar, and the Korean publisher X.D. Global and creators respectively.</p>
        <p class="footer-links">
            <a href={`${base}/privacy/`}>Privacy Policy</a>
        </p>
    </footer>

    <!-- Scroll to top button -->
    <button id="scroll-to-top" class="scroll-to-top hidden" aria-label="맨 위로 가기">
        <i class="fas fa-chevron-up"></i>
    </button>

    <!-- Copyright year + Service Worker registration -->
    <script is:inline type="module" src={`${base}/js/global.init.js`}></script>
</body>
</html>
