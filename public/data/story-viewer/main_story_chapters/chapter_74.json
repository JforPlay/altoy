160","dir":1,"expression":1,"nameColor":"#A9F548FF","painting":{"alpha":0.3,"time":1},"say":"어쨌든 지금은 \"여기\" 노스 유니온을 집이라고 생각하고 편하게 있어.","side":2},{"actor":705080,"bgName":"star_level_bg_160","dir":1,"expression":2,"nameColor":"#A9F548FF","painting":{"alpha":0.3,"time":1},"say":"회복될 때까지는 안정을 취하는 게 중요해. 필요한 게 있으면 언제든 편하게 말해줘.","side":2},{"actor":9702060,"bgName":"star_level_bg_160","dir":1,"expression":2,"nameColor":"#FFC960","painting":{"alpha":0.3,"time":1},"say":"(파먀티 녀석… 대체 이 \"가지\" 함선들에게 무슨 바람을 넣은 거냐……?)","side":2},{"actor":9702060,"bgName":"star_level_bg_160","dir":1,"nameColor":"#FFC960","painting":{"alpha":0.3,"time":1},"say":"(……아니지. 다들 이렇게나 친절한 걸 보면, 녀석은 틀림없이 이 \"가지\"에 있으면서 무슨 행동을 일으킨 게 틀림없어.)","side":2},{"actor":9702060,"bgName":"star_level_bg_160","dir":1,"expression":5,"nameColor":"#FFC960","painting":{"alpha":0.3,"time":1},"say":"(그렇다면…… 아직 시간이 있다는 건가?)","side":2},{"actor":9702060,"bgName":"star_level_bg_160","dir":1,"nameColor":"#FFC960","painting":{"alpha":0.3,"time":1},"say":"(내가 할 수 있는 게 아직 있다는 말이로군.)","side":2},{"actor":9702060,"bgName":"star_level_bg_160","dir":1,"expression":4,"nameColor":"#FFC960","painting":{"alpha":0.3,"time":1},"say":"(……동료들이여.)","side":2},{"actor":9702060,"bgName":"star_level_bg_160","dir":1,"nameColor":"#FFC960","painting":{"alpha":0.3,"time":1},"say":"(……조금만 더 여기 머물게 해줘.)","side":2}]},"subtitle":"","title":"방랑자?","type":1,"unlock_pre":["BIFANGZHIYIN2"]},{"condition":"「저편에서의 메아리」DAY2 해제","icon":"memory_bifangzhiyin","id":3553,"is_open":0,"mask":"bg/bg_memory","number":0,"story":{"fadeOut":1.5,"id":"BIFANGZHIYIN3","mode":2,"scripts":[{"actor":9705040,"bgName":"star_level_bg_590","bgm":"qe-ova-15","dir":1,"expression":3,"flashin":{"alpha":[1,0],"black":true,"delay":1,"dur":1},"flashout":{"alpha":[0,1],"black":true,"dur":1},"nameColor":"#FFC960","painting":{"alpha":0.3,"time":1},"say":"환기 시스템, 정상. 조명 기구도… 좋아.","side":2},{"actor":9705040,"bgName":"star_level_bg_590","dir":1,"expression":5,"nameColor":"#FFC960","painting":{"alpha"