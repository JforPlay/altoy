[{"클뜯 id":10900020,"클뜯 함순이 id":1090002,"함순이 이름":"클라우디아 발렌츠","한글 함순이 + 스킨 이름":"클라우디아 발렌츠","영문 함순이 + 스킨 이름":"Klaudia Valentz","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900020/shipyard.png","설명":"안녕, 난 클라우디아 발렌츠야. 사정이 좀 있어서 오늘부터 신세를 지게 되었어. 최선을 다해 모두를 도울테니까 잘 부탁해!","자기소개":{"voiceline":"클라우디아 발렌츠야. 원래 살던 세상에서는 대상단의 수장인 아버지로부터 일을 일부분 맡아서 하고 있었어. 이쪽 세상으로 와서 이젠 라이자랑 모두를 못 만날 거라고 생각했는데, 다시 만나게 돼서 무척 기뻐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/profile.ogg"},"메인1":{"voiceline":"설마 라이자들이랑 다시 같이 모험을 할 수 있다니…. 정말 기적같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main1.ogg"},"메인2":{"voiceline":"방금 매점을 다녀왔는데, 아카시 씨는 장사를 참 잘하네. 같은 상인으로서 배울 점이 많아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main2.ogg"},"메인3":{"voiceline":"지휘관, 아까부터 멍하니 있던데, 괜찮은 걸까……. 일도 일단락됐으니, 잠깐 쉬자고 해야겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main3.ogg"},"전투개시":{"voiceline":"나도 아직 더 싸울 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/battle.ogg"},"상세확인":{"voiceline":"응? 나에 대해 알고 싶다고? 그럼 안에 들어가서 이야기 할까? 바로 차랑 과자를 준비할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/detail.ogg"},"드랍 설명":{"voiceline":"안녕, 난 클라우디아 발렌츠야. 사정이 좀 있어서 오늘부터 신세를 지게 되었어. 최선을 다해 모두를 도울테니까 잘 부탁해!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 사람들이 돌아온 것 같아. 지휘관, 같이 마중 나가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/expedition.ogg"},"실망":{"voiceline":"어쩔 수 없지. 일이니까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/feeling1.ogg"},"낯섦":{"voiceline":"오늘도 일이 많네…. 그래도 둘이서 하면 그만큼 빨리 끝날 거야. 같이 열심히 하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/feeling2.ogg"},"호감":{"voiceline":"지휘관은 바쁜데도 세세한 부분을 잘 챙기는 게 대단해. 나도 배워야지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/feeling3.ogg"},"기쁨":{"voiceline":"같이 일한지 꽤 됐는데, 지휘관은 정말 업무 처리가 빠르네. 무슨 비결이라도 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/feeling4.ogg"},"사랑":{"voiceline":"자, 지휘관. 이 차에는 긴장을 풀어주는 효과가 있대. 어제 매점에서 보고 지휘관한테 좋을 것 같아서 사봤어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/feeling5.ogg"},"터치3":{"voiceline":"자금 관리를 도와줬으면 한다고? 원래 살던 세상에서도 아버지가 일을 맡기셔서, 그런 거라면 자신 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와, 지휘관. 아직 일은 덜 끝났지만… 그 전에 조금 쉬는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/home.ogg"},"hp 경고":{"voiceline":"아직 분발할 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이야, 지휘관. 오늘도 일 열심히 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/login.ogg"},"실패":{"voiceline":"다, 다들 괜찮아?! 다친 애는 서둘러서 치료를……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이 왔어. 책상 위에 올려뒀으니, 어서 확인해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/mail.ogg"},"임무":{"voiceline":"지휘관, 아직 완료하지 않은 임무가 있는 것 같아. 일단은 정리해뒀는데, 먼저 처리해버리는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/mission.ogg"},"임무완료":{"voiceline":"음… 지휘관이 받을 보상은… 응, 무사히 도착했네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/mission_complete.ogg"},"서약":{"voiceline":"나, 이 세계에 와서 좋다고 생각해. 라이자들이랑도 다시 만났고, 지휘관이라는 멋진 사람과도 만났으니까. 이 만남을 소중하게 여기면서, 앞으로도 열심히 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/propose.ogg"},"스킬":{"voiceline":"받아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/skill.ogg"},"터치1":{"voiceline":"나… 친구를 잘 사귀는 편은 아니었어…. 지휘관이랑 모항 사람들이 상냥하게 대해주는 덕분에, 여기서도 즐겁게 지내고 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/touch.ogg"},"터치2":{"voiceline":"이런 일이 계속된다면, 앞으로 같이 생활하는 건 어려울 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/touch2.ogg"},"입수시":{"voiceline":"안녕, 난 클라우디아 발렌츠야. 사정이 좀 있어서 오늘부터 신세를 지게 되었어. 최선을 다해 모두를 도울테니까 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/unlock.ogg"},"강화성공":{"voiceline":"이렇게 강해질 수 있을 줄은 생각도 못했어…. 고마워, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼어! 이런 느낌으로 열심히 해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/win_mvp.ogg"},"전투개시_ex":{"voiceline":"모두와 함께라면 괜찮아……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/battle_ex.ogg"},"상세확인_ex":{"voiceline":"어서 와, 지휘관. 마침 쿠키를 갓 구운 참이야. 오랜만에 만든 거지만 그래도 꽤 맛있게 구워진 거 같은데… 괜찮으면 한번 맛볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 오늘도 일이 많이 바쁜 것 같네. 그래도 너무 무리는 하지 말았으면 해. 지휘관은 내게 소중한 사람이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 아직 졸린 것 같네. 얼굴이라도 씻고 오는 게 어때? 그 동안 내가 업무 준비를 해 놓을게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"지휘관! 임무, 이제 조금만 더 하면 끝나! 나도 도와줄 테니까, 마지막까지 힘내자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/mission_ex.ogg"},"임무완료_ex":{"voiceline":"끝났다…. 지휘관도 고생 많았어. 그럼, 차라도 마시면서 좀 쉴까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"(어떡하지, 같이 업무보는 사이라 막 대할 수도 없고….)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이겨서 다행이야…. 다들, 고생 많았어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['라이잘린 스타우트'] :  만나서 기뻐, 라이자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/couple_encourage1.ogg"},{"voiceline":"['릴라 디자이어스'] :  릴라 씨, 엄호할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/couple_encourage2.ogg"},{"voiceline":"['세리 글로스'] :  찾으면 전해줄게, 세리 씨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/couple_encourage3.ogg"}],"메인4":{"voiceline":"시라누이 씨는 정말 대단한 점원이야. 우리 상회에도 대단한 사람들은 많지만, 시라누이 씨가 와주면 더 좋을 텐데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"오늘 점심에는 라이자네랑 같이 외출하기로 했는데, 지휘관도 같이 갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main6_ex.ogg"},"메인7_ex":{"voiceline":"저쪽 서류는 확인 완료했고, 이쪽은 아직 안 끝났던가…. 아, 지휘관. 나 때문에 깼어? 서류 정리는 내가 대신할 테니까, 조금 더 쉬어도 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main7_ex.ogg"},"메인8_ex":{"voiceline":"이 곡, 플루트 음색이 예쁘네. 사실은 나도 조금은 연주할 수 있어. 응? 듣고 싶다고? 지휘관이 그렇게 말한다면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"쇼카쿠 씨의 피리, 옆으로 부는 피리인데 플루트랑은 다른 소리가 나네…. 특색있고 무척이나 아름다운 음색이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"아카시 씨, 그러니까 당신 장사의 비결은…. 어라? 아카시 씨, 어디 간 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main9_ex.ogg"},"메인10_ex":{"voiceline":"카자구모 씨? 아, 리코더 연습 중이었구나. 후후, 괜찮아. 연습하면 분명 잘 불 수 있게 될 테니까. 언젠가 자신감이 생기면, 소중한 사람에게 들려주도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900020/main10_ex.ogg"},"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"RYZA","레어도":"SSR","ex_chat_status":1},{"클뜯 id":10900021,"클뜯 함순이 id":1090002,"함순이 이름":"클라우디아 발렌츠","한글 함순이 + 스킨 이름":"굿나잇 전의 야화","영문 함순이 + 스킨 이름":"Bedtime Memories","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900021/