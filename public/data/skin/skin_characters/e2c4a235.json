/301270/expedition.ogg"},"실망":{"voiceline":"……명령을 내려주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/feeling1.ogg"},"낯섦":{"voiceline":"제대로 된 쿠노이치에게 감정이란 불필요한 것. 명령에 따라 행동할 뿐입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/feeling2.ogg"},"호감":{"voiceline":"주인님께서 말씀하시는 '커뮤니케이션' 과 '게임', 저…죄송합니다. 잘 이해가 가지 않습니다만……그래도……싫지는, 않습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/feeling3.ogg"},"기쁨":{"voiceline":"주인님, 면목없습니다. 임무 중 무심코 저번에 주인님께서 해주신 '커뮤니케이션' 을 떠올리니, 집중을 할 수 없게 되어버립니다. 부디, 이런 제게 처벌을…… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/feeling4.ogg"},"사랑":{"voiceline":"이것이 '감정'……아무것도 생각하지 않으니 편했습니다만, 그렇게 나쁜 건 아니군요……음, 주인님의 곁에 돌아가고 싶다는 '감정' 은, 저를 언제나 강하게 만들어주고 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"주인님, 피곤하십니까? 제가 할 수 있는 일은 없습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"주인님, 어서 오십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/login.ogg"},"실패":{"voiceline":"주인님, 모쪼록 철수하시지요. 뒤는 제가 맡겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/lose.ogg"},"우편":{"voiceline":"주인님, 새로운 편지가 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/mail.ogg"},"임무":{"voiceline":"주인님, 새로운 임무가 도착했습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/mission.ogg"},"임무완료":{"voiceline":"주인님, 임무 보수가 도착했습니다. 확인하여 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301270/mission_complete.ogg"},"서약":{"voiceline":"명령에 절대복종하는 것이야 말로 쿠노이치