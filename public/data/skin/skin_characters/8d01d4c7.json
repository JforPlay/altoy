[{"클뜯 id":107380,"클뜯 함순이 id":10738,"함순이 이름":"샹그릴라","한글 함순이 + 스킨 이름":"샹그릴라","영문 함순이 + 스킨 이름":"Shangri-La","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107380/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107380/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107380/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107380/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107380/shipyard.png","설명":"에식스급 항공모함 - 샹그릴라(CV-38) ","자기소개":{"voiceline":"제 이름 \"샹그릴라\"는 그 대전투의 어느 작전에서 유래했습니다. 에식스급으로서 여러 곳을 오갔던 저는, 이 노트에 수많은 사건과 이야기를 적을 수 있었습니다. 이것이야말로 저의 자랑입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/profile.ogg"},"메인1":{"voiceline":"이 아이가 신경 쓰이시나요? 실은 곤충 관찰도 제 취미 중 하나입니다. 이 아이는 파나마에서 데려왔습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/main1.ogg"},"메인2":{"voiceline":"대잠 작전 말입니까…? 기회가 있다면 도전해보고 싶군요. 어쩌면 의외로 소질이 있을 지도 모릅니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/main2.ogg"},"메인3":{"voiceline":"지휘관님의 건강을 지키는 것도 제 일입니다. 부디 건강에는 주의해주시고, 피로가 과도하게 쌓이지 않도록 해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/main3.ogg"},"전투개시":{"voiceline":"함수, 풍상 측으로! 자유의 무게, 깨닫게 해 드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/battle.ogg"},"상세확인":{"voiceline":"외부에 대한 비밀 엄수, 상관에 대한 멸사봉공, 모쪼록 철저히 준수하여 주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/detail.ogg"},"드랍 설명":{"voiceline":"에식스급 항공모함 - 샹그릴라(CV-38)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었습니다. 귀환하는 모두를 마중 나가도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/expedition.ogg"},"실망":{"voiceline":"지휘관님은 신용 정보 블랙리스트에 올라가 있습니다. 주의해주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/feeling1.ogg"},"낯섦":{"voiceline":"오늘부터 지휘관님의 모든 것을 필기하도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 아무리 시간이 아까우시더라도, 정크 푸드를 먹으면 몸에 나쁜 영향 밖에 줄 수 없습니다. …여기, 제가 직접 만든 샌드위치입니다. 모쪼록 드셔주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/feeling3.ogg"},"기쁨":{"voiceline":"하아, 건강을 챙기시라고 그렇게 말씀드렸는데…… 여기, 사프란 차를 대령했습니다. 건강에 좋답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/feeling4.ogg"},"사랑":{"voiceline":"사프란의 꽃말이 '환희'인 것을 알고 계십니까? 이렇게 가까이에서 당신의 이야기를 적고, 당신과 함께 싸우고, 당신의 일상을 돌보는 것…… 그것이야말로 제게 있어 가장 큰 환희입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/feeling5.ogg"},"터치3":{"voiceline":"이 머리 장식 말입니까? 제 이름과 어울린다고, 이셴 씨께 받은 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/headtouch.ogg"},"모항귀환":{"voiceline":"함대가 모항에 귀환하였습니다. 다 함께 잠깐 휴식한 후에, 이번 출격 검토와 전술 리포트를 확인하도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/home.ogg"},"hp 경고":{"voiceline":"소화 작업, 준비를 서둘러주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/hp_warning.ogg"},"로그인":{"voiceline":"어서 오십시오, 지휘관님. 지휘관님이 부재중이신 동안 일어난 중요한 사항은 여기 필기해두었습니다. 확인하시겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/login.ogg"},"실패":{"voiceline":"이럴… 리가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔습니다. 제가 대신 읽어드리는 것도 가능하므로, 시간이 없으실 경우에는 검토 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/mail.ogg"},"임무":{"voiceline":"본부로부터 전보가 들어왔습니다. 업무 목록에 필기해두었으니 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었습니다. 이번 보상은 무엇일까요? 무인관측기? 아니면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/mission_complete.ogg"},"서약":{"voiceline":"이 기분을 한시라도 빨리 노트에 적고 싶습니다만, 이 두 손에는 지금 더 중요한 역할이 있습니다. 그건 바로 당신을 껴안는 것…… 지금부터 샹그릴라는 언제나 당신과 함께, 당신이 가는 길 너머에 있는 '이상향'을 향하여……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/propose.ogg"},"스킬":{"voiceline":"폭풍을 넘어, 전력으로 도전한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/skill.ogg"},"터치1":{"voiceline":"지휘관님은 어떤 이야기를 듣고 싶으신가요? 사람의 발길이 닿지 않은 안식처, 아니면 수평선 너머의 이상향?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/touch.ogg"},"터치2":{"voiceline":"제 건강 상태를 확인하고 싶으셨던 겁니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/touch2.ogg"},"입수시":{"voiceline":"CV-38, 샹그릴라, 착임 했습니다. 이 노트에 적힌 수많은 이야기를 언젠가 지휘관님과도 공유하고 싶지만…… 지금은 눈앞의 일에 집중하도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/unlock.ogg"},"강화성공":{"voiceline":"감사합니다. 새로운 전과로 보답하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/upgrade.ogg"},"vote":null,"승리":{"voiceline":"당신들 정도로는 샹그릴라에 닿을 수 없다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['에식스'] : 안심하세요, 우리는 분명, 선배를 뛰어넘을 수 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/couple_encourage1.ogg"},{"voiceline":"['호넷'] : 비행기를 빌릴 수 있을까요? 그러니까…… 카우걸… 씨?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107380/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":107381,"클뜯 함순이 id":10738,"함순이 이름":"샹그릴라","한글 함순이 + 스킨 이름":"유토피아의 수집가","영문 함순이 + 스킨 이름":"Utopia's Collector","스킨 타입":"Casual","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107381/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107381/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107381/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107381/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107381/shipyard.png","설명":"지휘관님, 저의 '유토피아'에 온 것을 환영합니다. 여기 있는 것은 제 자랑스러운 컬렉션…… 그럼, 제가 일단 설명해 드리도록 할까요？ ","자기소개":null,"메인1":{"voiceline":"기회만 있다면, 제대로 개인전이라도 여는 게 좋겠네요. 전시명은… '컬러풀'으로 하면 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/main1.ogg"},"메인2":{"voiceline":"지휘관님이라면 제 컬렉션을 나눠드려도 괜찮겠죠. 꼭 소중히 간직해주실 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/main2.ogg"},"메인3":{"voiceline":"(찰칵) 좋아, 새로운 컬렉션이 생겼습니다. 이름은… '고생 많은 사람의 옆얼굴'이 어떨까요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관님께서 선물해주신 이 숄, 무척 따뜻하네요. 후후, 이러면 어떨까요. 이걸 이렇게해서… 함께 온기를 나누는 건 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 저의 '유토피아'에 온 것을 환영합니다. 여기 있는 것은 제 자랑스러운 컬렉션…… 그럼, 제가 일단 설명해 드리도록 할까요？","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"후우…… 앗, 방금 잠깐 졸았나요? 죄송합니다, 지휘관님, 지휘관님 곁에 있으면 그만 긴장이 풀어져서… 어깨 빌려주셔서 감사합니다. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 제 컬렉션에 추가할 물건이라도 발견하셨나요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오십시오, 지휘관님. 따뜻한 음료라도 드시고 몸을 덥히시지요. 커피? 코코아? 어느 쪽이 좋으신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님도 표본 만들기를 배워보고 싶으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/touch.ogg"},"터치2":{"voiceline":"컬렉션도 여자아이도, 함부로 만지는 건 금지라구요, 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 저의 '유토피아'에 온 것을 환영합니다. 여기 있는 것은 제 자랑스러운 컬렉션…… 그럼, 제가 일단 설명해 드리도록 할까요？","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107381/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"사복","상점 id":70162,"상점 카테고리 id":9,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2025/04/02)","진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":107382,"클뜯 함순이 id":10738,"함순이 이름":"샹그릴라","한글 함순이 + 스킨 이름":"잃어버린 세계의 탐험가","영문 함순이 + 스킨 이름":"Explorer of the Lost World","스킨 타입":"Casual","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107382/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107382/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107382/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107382/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107382/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107382/shipyard.png","설명":"정말 오래된 화석이네요... 네네, 지휘관은 뒤에서 저를 지켜주셔도 좋고, 원한다면 이리 와서 같이 관찰해도 좋아요. 마음껏 지금의 상황을 즐겨봐요~ ","자기소개":null,"메인1":{"voiceline":"여기서 촬영은 금지에요. 스케치나 기록만 할 수 있어요... 네, 조금 귀찮죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107382/main1.ogg"},"메인2":{"voiceline":"아, 인트레피드, 그렇게 급하게 뛰지마세요——아, 귀찮게 됐네요... 지휘관, 가서 저 아이 좀 도와줄 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107382/main2.ogg"},"메인3":{"voiceline":"이곳의 표본처럼 연대가 오래되진 않았지만, 사프란의 재배 역사도 청동기 시대까지 거슬러 올라갈 수 있어요. 제가 말하고 싶은 건——지휘관 목이 마르다면, 사프란 차 좀 드실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107382/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이야기를 기록하려면 지식도 필수죠. 배에 대한 지식이든, 사람에 대한 지식이든, 심지어는 이 행성에 대한 지식이든지요——지휘관에게 이런 말을 한 사람이 있나요? \"학문에는 끝이 없다\" 이런 거요, 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107382/detail.ogg"},"드랍 설명":{"voiceline":"정말 오래된 화석이네요... 네네, 지휘관은 뒤에서 저를 지켜주셔도 좋고, 원한다면 이리 와서 같이 관찰해도 좋아요. 마음껏 지금의 상황을 즐겨봐요~","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관, 이 전시품 어때요——하하, 지휘관의 승리에 어울릴만 한가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107382/home.ogg"},"hp 경고":null,"로그인":null,"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"아, 그런데, 요즘 새로운 학설이 있어요. 그것들의 몸이 비늘이 아니라 털로 뒤덮여 있다는... 지휘관은 어떻게 생각해요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107382/touch.ogg"},"터치2":{"voiceline":"이럴 때는 공룡처럼 \"크워어~\"하면서 겁주는 게 좋겠죠? 하하하","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107382/touch2.ogg"},"입수시":{"voiceline":"정말 오래된 화석이네요... 네네, 지휘관은 뒤에서 저를 지켜주셔도 좋고, 원한다면 이리 와서 같이 관찰해도 좋아요. 마음껏 지금의 상황을 즐겨봐요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107382/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"사복","상점 id":70390,"상점 카테고리 id":9,"스킨 태그":"X","입수 영상":"X","재화":800,"기간":"한정 (2025/04/02)","진영":"USS","레어도":"SSR","ex_chat_status":0}]