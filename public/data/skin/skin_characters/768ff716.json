[{"클뜯 id":102110,"클뜯 함순이 id":10211,"함순이 이름":"리치몬드","한글 함순이 + 스킨 이름":"리치몬드","영문 함순이 + 스킨 이름":"Richmond","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102110/shipyard.png","설명":"오마하급 경순양함·리치몬드 (CL-9)","자기소개":{"voiceline":"오마하급의 리치몬드야~ 구식이라서 주로 호위, 수송 임무를 맡았어. 성능은 약간 자랑할 거리가 안 되지만, 다양한 걸 경험해왔다구~ 지휘관, 문제가 있으면 나에게 상담해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/profile.ogg"},"메인1":{"voiceline":"지휘관, 입에 뭐가 묻어있어…… 좋아, 떼어냈다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/main1.ogg"},"메인2":{"voiceline":"여러 곳에 있던 모두와 만나다니, 정말 기뻐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/main2.ogg"},"메인3":{"voiceline":"내 자매들 모두 그 전쟁에서 살아남은 거야, 굉장하지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/main3.ogg"},"전투개시":{"voiceline":"영차, 워밍업 간다─","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/battle.ogg"},"상세확인":{"voiceline":"지휘관, 뭔 일이야~? 일 없으면, 잠시 잡담하지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/detail.ogg"},"드랍 설명":{"voiceline":"오마하급 경순양함·리치몬드 (CL-9)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 여기서 날 계속 봐도 좋지만, 의뢰가 완료됐는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/expedition.ogg"},"실망":{"voiceline":"다른 곳 찾아볼까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/feeling1.ogg"},"낯섦":{"voiceline":"많은 곳을 가봤지만, 여기만큼 여러 나라의 애들이 모인 함대는 처음이야. 꺄핫♪ 즐─겁다구─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/feeling2.ogg"},"호감":{"voiceline":"지휘관~ 나, 이제 막 함대에 익숙해진 참이라, 좀 더 많은 걸 알고 싶어. 그러니까, 잠깐만 같이 산책가줄 수 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/feeling3.ogg"},"기쁨":{"voiceline":"응, 역시 이 함대는 좋구나! 물론 지휘관도! 그럼, 나에 대한 걸 지휘관에게 가르쳐줄게♪ 응응, 잠깐 생각 좀 하고~ …우선 첫 번째 대전이 끝난 뒤에 무슨 일이 있었냐면…… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 그러고 보니, 나 여러 곳을 둘러봤지만 어울리는 상대가 없어서 딱 하나 체험 못 해본 게 있어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"전장에서 막 돌아온 지휘관, 멋져!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 시간이 꽤 흘렀는데, 무슨 재미있는 일이라도 있었어? 나도 데려가 줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/login.ogg"},"실패":{"voiceline":"어라라, 져 버렸다… 유~감~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/lose.ogg"},"우편":{"voiceline":"우편함을 확인하는 김에, 겸사겸사 지휘관 것도 가져왔다구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/mail.ogg"},"임무":{"voiceline":"이것도 임무, 저것도 임무…… 지휘관은 힘들겠구나~ 내가 도와줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/mission.ogg"},"임무완료":{"voiceline":"꺄핫♪ 지휘관, 보너스가 왔어♪ …그게 아니면 나의 뜨거운 허그 쪽이 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/mission_complete.ogg"},"서약":{"voiceline":"응! 연애야♪ 연애! 그리고… 그 다음 일도! 지휘관과 만나기 전까지 좋은 상대가 없었으니까 말이지~ 이걸 받아버리면, 지휘관이 파트너가 되어주는 거라고 생각해도 괜찮겠지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/propose.ogg"},"스킬":{"voiceline":"경험의 차이를 보여줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/skill.ogg"},"터치1":{"voiceline":"지휘관도 스킨십이 좋은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/touch.ogg"},"터치2":{"voiceline":"지─휘─과─안!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/touch2.ogg"},"입수시":{"voiceline":"하이! 당신이 지휘관? 마침 잘 됐다♪ 나는 리치몬드야. 앞으로 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/unlock.ogg"},"강화성공":{"voiceline":"꺄핫♪ 좋은 느낌♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"단결에 의한 승리야, 예이!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"N","ex_chat_status":0}]