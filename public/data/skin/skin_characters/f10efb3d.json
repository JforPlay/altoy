[{"클뜯 id":303020,"클뜯 함순이 id":30302,"함순이 이름":"카코","한글 함순이 + 스킨 이름":"카코","영문 함순이 + 스킨 이름":"Kako","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303020/shipyard.png","설명":"후루타카형 중순양함 2번함·카코","자기소개":{"voiceline":"후루타카형 중순양함 2번함, 카코입니다. 국산 중순양함으로서는 1번함, 이라 해도 되겠네요. 뭔가 이상한가요? 성격? 이건 당신에게만 대하는 태도입니다만. 어쨌든, 중순양함의 힘을 잘 봐주세요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/profile.ogg"},"메인1":{"voiceline":"이 함대는 괜찮네요, 지휘관만 빼면요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/main1.ogg"},"메인2":{"voiceline":"여기, 틀렸어요. 그리고 여기. 이런 것들까지 가르치게 하지 말아주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/main2.ogg"},"메인3":{"voiceline":"아오바 녀석, 지금쯤 뭘 하고 있을는지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/main3.ogg"},"전투개시":{"voiceline":"저, 이래 봬도 대표적인 중순양함이라구요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/battle.ogg"},"상세확인":{"voiceline":"하실 말씀이 있다면, 확실히 말씀해주시는 게 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/detail.ogg"},"드랍 설명":{"voiceline":"후루타카형 중순양함 2번함·카코","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 받고 나간 멤버들이 돌아왔습니다. 설마 당신, 성과를 가져올 때까지 여기서 기다린다든가 하는 생각하는 건 아니겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/expedition.ogg"},"실망":{"voiceline":"평생 제게 인정받을 일은 없겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/feeling1.ogg"},"낯섦":{"voiceline":"무엇이 어엿한 지휘관에 어울리는 행동인지, 처음부터 가르치지 않으면 안되겠네요… 제게 인정받는다는 건 그렇게 간단하지 않을 거예요. 각오해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/feeling2.ogg"},"호감":{"voiceline":"이 자세는 이렇게… 뭔가요? 이 정도로 부끄러워하는 건가요? …제 얼굴이 빨개지고 있다고요? 무슨 말씀 하시는 건가요!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/feeling3.ogg"},"기쁨":{"voiceline":"아직 멀었지만, 일단은 합격점에 왔다는 느낌은 있네요── 근데, 언제까지 끌어안고 있을 셈인가요? 그렇게 들떠있는 걸 보니 좀 더 정진하지 않으면 안 되겠네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/feeling4.ogg"},"사랑":{"voiceline":"최근 이해하는 속도가 빠르네요… 저… 읏… 뭐, 조금만이라면 평소처럼 이상한 짓을 하셔도, 좋…아요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"휴식인가요? 뭐, 아까 전의 노력을 봐서 이번 사무 처리는 조금 미뤄드리겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"마침 잘됐네요. 제 쪽의 서류 정리는 끝났습니다. 이쪽에 있는 건, 전부 처리하실 수 있으시겠죠? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/login.ogg"},"실패":{"voiceline":"칫… 좀 더 노력해보는 건 어떠신지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/lose.ogg"},"우편":{"voiceline":"편지입니다. 의외로 친구 많으시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/mail.ogg"},"임무":{"voiceline":"새로운 임무입니다. 설마 못 하겠다고 말씀하시진 않으시겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/mission.ogg"},"임무완료":{"voiceline":"열심히 하셨네요. 보너스예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/mission_complete.ogg"},"서약":{"voiceline":"뭐, 아슬아슬하게 합격이란 걸까요? 하지만 이건 단지 시작일 뿐이에요. 앞으로 갈 길이 멀어요… 저요? 어, 어울려 달라고 말씀하신다면, 특별히 함께 있어 드려도 좋다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/propose.ogg"},"스킬":{"voiceline":"제 실력을, 보여드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/skill.ogg"},"터치1":{"voiceline":"당신은 바보인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/touch.ogg"},"터치2":{"voiceline":"당신이란 사람은…! 여보세요, 헌병입니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/touch2.ogg"},"입수시":{"voiceline":"후루타카형 2번함, 카코, 지시를 기다립니다… 라는 게 되어버렸지만, 저를 따르게 할 지휘관으로서 어울리는지 아닌지, 확실히 가려주겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/unlock.ogg"},"강화성공":{"voiceline":"감사의 인사는 드리도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 정도로 잘 풀릴 줄이야, 일단은 인정해드리겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"N","ex_chat_status":0},{"클뜯 id":303029,"클뜯 함순이 id":30302,"함순이 이름":"카코","한글 함순이 + 스킨 이름":"카코·改","영문 함순이 + 스킨 이름":"Kako (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303029/painting.png","확대 일러":null,"sd 일러":"https://raw.gith