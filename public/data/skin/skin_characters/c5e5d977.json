[{"클뜯 id":803010,"클뜯 함순이 id":80301,"함순이 이름":"쉬프랑","한글 함순이 + 스킨 이름":"쉬프랑","영문 함순이 + 스킨 이름":"Suffren","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803010/shipyard.png","설명":"쉬프랑급 중순양함 - 쉬프랑","자기소개":{"voiceline":"나는 쉬프랑급의 네임쉽인 쉬프랑이야. 자매함이랑은 세세한 설계 같은 부분에서 차이가 많지만, 뭐 같은 쉬프랑급이긴 하니까 크게 신경 쓸 필요는 없겠지! 지휘관, 앞으로 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/profile.ogg"},"메인1":{"voiceline":"흐아아암… 음… 모항도 좋기는 하지만, 해먹이 아닌 침대에서 자는 게 좀… 흥, 누나는 침대보다 해먹이 더 편하다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/main1.ogg"},"메인2":{"voiceline":"호교 기사의 좋은 점은 식사할 때 지켜야 하는 예절 같은 게 적다는 거야. 배고프면 싸울 수 없잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/main2.ogg"},"메인3":{"voiceline":"지휘관~ 고민이 있으면 이 누나한테 털어놔 봐. 이 누나는 무슨 일이 있어도 아이리스 리브레와 지휘관 편이니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/main3.ogg"},"전투개시":{"voiceline":"아이리스 리브레의 기사 쉬프랑이 상대해 주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/battle.ogg"},"상세확인":{"voiceline":"늘 상냥한 쉬프랑 누나도 화나면 '악마 대장'이라고 불릴 만큼 무섭다구! 봐, 이렇게 '크와앙!'하고 말이야! 무섭지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/detail.ogg"},"드랍 설명":{"voiceline":"쉬프랑급 중순양함 - 쉬프랑","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 보상이 도착했어. 지휘관, 어서 확인해 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/expedition.ogg"},"실망":{"voiceline":"누나는 지휘관한테 화내고 싶지 않아. 그러니까 정신 차려.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/feeling1.ogg"},"낯섦":{"voiceline":"지휘관에게 신세를 지려니 왠지 좀 부끄럽네~ 아니, 싫다는 건 아니고… 그러니까 내 말은, 누나인 내가 지휘관을 돌보는 게 더 자연스럽잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/feeling2.ogg"},"호감":{"voiceline":"업무를 도와주거나 전투에서 지켜주거나… 음… 지휘관한테 해줄 수 있는 거, 다른 애들이랑 별 차이 없는 것 같은데… 어떻게 해야 하나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/feeling3.ogg"},"기쁨":{"voiceline":"잠깐만 기다려, 지휘관. 이 예쁘고 믿음직스러운 쉬프랑 누나가 지휘관을 위해서….. 으아아아?! 냄비에 넣어둔 식재료가 다 타버렸어! 아니, 청소기 스위치 끄는 것도 깜빡했잖아!! 지휘관, 나 좀 도와줘~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/feeling4.ogg"},"사랑":{"voiceline":"우아한 아이리스 리브레의 호교 기사로서, 그리고 누나로서 한번 실패한 정도로는 굴하지 않아. 자, 지휘관! 오늘은 마음껏 날 의지해도 돼! 내가 얼마나 성장했는지 지금 바로 보여줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/feeling5.ogg"},"터치3":{"voiceline":"으앗?! 누나한테 무슨 짓이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/headtouch.ogg"},"모항귀환":{"voiceline":"출격하느라 고생했어! 회고 끝내고 천천히 쉬자! 누나가 자료…… 자료를… 까, 까먹었다… 아하하하…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/home.ogg"},"hp 경고":{"voiceline":"아이리스 리브레의 기사는 물러서지 않아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/hp_warning.ogg"},"로그인":{"voiceline":"흐아아암~~ 아, 지휘관?! …일찍 일어나는 건 좋은 거지! 누나, 감동했다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/login.ogg"},"실패":{"voiceline":"지휘관, 전략적 후퇴야! 언젠가는 되갚아 줄 때가 올 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/lose.ogg"},"우편":{"voiceline":"우편이 왔어. 좋은 소식이기를… 자, 열어 볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/mail.ogg"},"임무":{"voiceline":"임무인가… 빨리 처리해 줘, 지휘관! 밤늦게까지 일하면 건강에 나쁘다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 도착했어. 오늘 밤 식사는 기대할 만하겠는데♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/mission_complete.ogg"},"서약":{"voiceline":"누나랑 서약을 나누게? 나야 당연히 좋지♪ 에헤헤, 지휘관을 계속 돌봐줄 수 있고, 지휘관도 나한테 계속 응석 부릴 수 있고, 좋은 점밖에 없잖아! …너무 지휘관만 챙긴다구? 그야 제일 좋아하는 사람이니까 그러는 게 당연하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/propose.ogg"},"스킬":{"voiceline":"항복할 기회는 지금뿐이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/skill.ogg"},"터치1":{"voiceline":"지휘관~ 뭐 고민이라도 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/touch.ogg"},"터치2":{"voiceline":"이상하네… 포슈랑 그렇게 차이 안 날 텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/touch2.ogg"},"입수시":{"voiceline":"아이리스 리브레 소속 호교 기사 쉬프랑이야! 자, 지휘관! 이젠 마음 푹 놓고 안심해! 누나가 왔으니까 이젠 걱정할 거 하나도 없다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 고마워! 누나도 더 열심히 할게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어때? 이게 바로 '쉬프랑급'의 힘이지! 아하하, 마음껏 의지하라구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"흥, 요새 들어 지휘관한테 신세만 지는 것 같은데….. 가끔은 이 누나한테도 멋진 모습 보여줄 수 있게 해달라구… 알았지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 오늘도 쉬프랑 누나한테 부살핌 받을 준비는 됐어? 어제와는 다른 누나의 모습을 보여줄게♪ 에헤헤♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"출격하느라 수고했어! 자료는 여기 뒀으니까 회고하기 전에 읽어봐! 아, 차랑 과자 준비하는 것도 잊지 않았다구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"앗, 지휘관?! 너무해~ 모처럼 오늘은 일찍 일어나서 멋진 모습 보여주려고 했는데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"임무 보상이 도착했어. 그럼 오늘 밤엔 뭘 만들 거야? 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"잡담 나누자고? 좋아♪ 누나가 말 상대가 되어줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/touch_ex.ogg"},"터치2_ex":{"voiceline":"음… 지휘관? 그렇게 만져도 바로 커지진 않는다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"호교 기사 쉬프랑! 예쁘고 멋진 든든한 누나! 내 말 맞지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['포슈'] :  포슈! 그걸 던질 때는 조심해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"포슈네랑 이번 휴일에 쇼핑하러 가기로 했어. 지휘관도 같이 갈래? 에헤헤, 맛있는 가게 많이 돌아보자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관, 누나한테 상담할 게 있으면 언제든… (꼬르륵) ……마침 잘됐어! 과자라도 먹으면서 천천히 이야기해 볼까? 응?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"응, 지휘관 방 침대는 해먹보다 훨씬 편안하네… 누나가 침대에 익숙하지 않은 것뿐이라구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803010/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"FFNF","레어도":"SR","ex_chat_status":1},{"클뜯 id":803011,"클뜯 함순이 id":80301,"함순이 이름":"쉬프랑","한글 함순이 + 스킨 이름":"임펄시브 액시던트","영문 함순이 + 스킨 이름":"Impulsive Incident","스킨 타입":"Sports Time","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/803011/shipyard.png","설명":"응? 들어 와~ 아니… 지휘관...이잖아? 아, 아하하하… 누나가 '사용중'이라고 팻말을 달아 놓는 걸 깜빡했네… 뭐, 딱히 지휘관이라면 봐도… 사, 상관 없나?","자기소개":null,"메인1":{"voiceline":"지휘관은 체육 잘해? 아니면 잘 못해? 종목별로 말고, 대충 전체적으로 말이야. 갑자기 궁금해져서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803011/main1.ogg"},"메인2":{"voiceline":"맞다, 모처럼 왔으니까 지휘관도 옷 갈아입고 같이 운동하자! 그럼 동료들한테 의심 살 일도 없을 거야! …아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803011/main2.ogg"},"메인3":{"voiceline":"됭케르크는 정말 나쁜 사람이야… 그래! 맨날 맛있어 보이는 과자만 만들잖아! 내가 얼마나 유혹에 안 넘어가려고 참고 있는지도 모르고! 으아앙!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/803011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관, 어때? 누나의 이런 모습, 신선하지? 후훗, 사실은 포슈나 알제리만큼이나 꾸미는 데 신경 쓰고 