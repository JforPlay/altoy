[{"클뜯 id":506010,"클뜯 함순이 id":50601,"함순이 이름":"젠하이","한글 함순이 + 스킨 이름":"젠하이","영문 함순이 + 스킨 이름":"Chen Hai","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506010/shipyard.png","설명":"수상기 항공모함—젠하이","자기소개":{"voiceline":"이스트 글림 최초의 수상기 항공모함, 젠하이입니다. \"최초\"라는 수식어가 많이 붙긴 하지만, 그것들은 전혀 영예롭지 못합니다. 다른 진정한 항공모함들에 비하면, 저는 결점이 정말 많아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/profile.ogg"},"메인1":{"voiceline":"뭔가 생각하고 계신 건가요? 아니면, 단순히 멍하니 계신 건가요? …… 아무튼 표정은 되게 귀여우시네요, 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/main1.ogg"},"메인2":{"voiceline":"저의 생각에 잠긴 표정이 좀 음침하다고요? 그게 저의 \"위장\" 중 하나가 아니라고 어떻게 확신하실 수 있죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/main2.ogg"},"메인3":{"voiceline":"억지를 부리든, 허세를 부리든, 어쩔 수 없을 때가 아니면, 다른 사람이 지휘관의 히든 카드를 볼 수 없게 하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/main3.ogg"},"전투개시":{"voiceline":"적이 가장 방심할 때가 바로 저희의 기회가 도래할 때죠——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/battle.ogg"},"상세확인":{"voiceline":"너무 심심하시다면…… 바둑 한 판 두시겠습니까? 초읽기도 없고, 승패와도 상관없이, 시간을 보낼 수만 있다면 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/detail.ogg"},"드랍 설명":{"voiceline":"수상기 항공모함—젠하이","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔나요? …… 예비 물자를 축적해서 창고를 채워, 카드를 하나 더 챙겨두면 정말 좋죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/expedition.ogg"},"실망":{"voiceline":"지휘관에 대한 저의 기대가 너무 높았나 보네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/feeling1.ogg"},"낯섦":{"voiceline":"고대에 누군가 말했죠. '늘 승리하는 자는, 적을 걱정하지 않는다.'고. 지휘관, 승전을 거듭하면서도 정리를 되새기는 것을 잊지 말아야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/feeling2.ogg"},"호감":{"voiceline":"전쟁은 불공평합니다. 상대가 부주의한 틈을 노려, 먼저 생각하고 이해하고 다음 수를 둔다면——승리는 눈앞에 있을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/feeling3.ogg"},"기쁨":{"voiceline":"바둑만 두어도 오래되면 지루할 수밖에 없습니다. 다른 규칙들을 정해서 대국에 재미를 좀 더해보죠. 예를 들어서…… 만약 지휘관이 절 이긴다면, 제가 지휘관이 원하는 것을 들어드리죠, 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/feeling4.ogg"},"사랑":{"voiceline":"어멋, 방심했네요. 계책에 정통한 제가 이런 데서 실수를 하다니…… 음, 승리를 축하드립니다. 그럼, 결과에 승복할테니, 원하는 것이 무엇인지 말씀해 주세요. 무엇이든 괜찮답니다, 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/feeling5.ogg"},"터치3":{"voiceline":"뜻밖의 행동이네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/headtouch.ogg"},"모항귀환":{"voiceline":"무사히 돌아오셨군요. 방금 전투는 훌륭했습니다만, 세세한 부분은 아직 개선할 필요가 있겠어요…… 다시 되짚어보실까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/home.ogg"},"hp 경고":{"voiceline":"호랑이 굴에 들어가지 않고서야, 어떻게 호랑이를 잡겠어요?……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/hp_warning.ogg"},"로그인":{"voiceline":"모항이 운영 중일 때, 정책을 결정하는 위치가 비어있으면 안 돼죠. 어서 지휘관의 자리로 돌아가세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/login.ogg"},"실패":{"voiceline":"한 수… 뒤쳐진 건가요… 달갑지 않군요. 다음부터 이런 일은 없을 겁니다, 후후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/lose.ogg"},"우편":{"voiceline":"중요한 메세지를 방치하는 것은 훌륭한 지휘관의 소행이 아닙니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/mail.ogg"},"임무":{"voiceline":"남은 자질구레한 사무들을 잊지 마세요. 코앞에 닥쳐왔을 때 겨우 떠오르면 늦어버리니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/mission.ogg"},"임무완료":{"voiceline":"임무를 완성했습니다. 장애물을 정리하고 나서, 어떻게 하시겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/mission_complete.ogg"},"서약":{"voiceline":"이건…… 후후, 지휘관에게 기습을 당할 줄이야… 아니, 지휘관이기에 저에게 이렇게 할 수 있는 것이겠죠. 이렇게 생각해보면, 이것 역시 저의 예상 범위 내의 일… 맞죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/propose.ogg"},"스킬":{"voiceline":"생각지도 못한 틈에 공격을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/skill.ogg"},"터치1":{"voiceline":"무슨 일이시죠? 단순히…… 저와 수다만 떨고 싶으신 건 아니시겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/touch.ogg"},"터치2":{"voiceline":"배짱이 크시군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/touch2.ogg"},"입수시":{"voiceline":"당신이 바로 지휘관, 이 모항의 \"브레인\"인가요? …후후, 명성이 드높은 지휘관을 두 눈으로 직접 보고, 함께 공감대도 형성할 수 있다니, 실로 영광입니다…… 저의 기대를 저버리면 안됩니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/unlock.ogg"},"강화성공":{"voiceline":"전 장막의 뒤에 있는 것을 더 좋아하긴 합니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"적의 전의가 하락했습니다. 저들도 겨우 이정도인가 보군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"오늘도 장기 두러 오실 건가요? 그럼, 이번에도 규칙을 추가하죠. 지는 쪽은 장기가 끝나면 둘이 어떻게 시간을 보낼지 생각하는 걸 책임지기로. 저도 가끔은 게으름을 피우고 싶으니까, 전력을 다하게끔 허락해 주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"음, 기운이 좋아 보이시네요. 졸고 있는 모습을 볼 수 있을 거라 생각했는데, 아쉽군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"비록 성인이라 할지라도, 주도면밀하다고는 할 수 없어요. 예를 들면…… 보세요, 임무 완료하는 걸 깜박한 것 같네요, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"심심한 대화라도 지휘관과 함께라면, 이 무미건조한 시간이 다채로워진답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/touch_ex.ogg"},"터치2_ex":{"voiceline":"보아하니 '각별히 배려'를 해 줄 필요가 있는 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['잉 루이', '차오 호', '하이치'] : 익숙한 얼굴이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"이른바 기습이란, 반드시 배후에서 몰래 습격하는 것만은 아니에요. 예를 들면, 이렇게 갑자기 지휘관의 얼굴에 가까이 다가가면——놀랐죠? 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"이스트 글림 외에도 장기 고수들이 많이 있어요. 다만 아쉽게도 서로 장기 규칙이 크게 달라서, 시원하게 한 판 겨뤄볼 수가 없네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506010/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":1},{"클뜯 id":506011,"클뜯 함순이 id":50601,"함순이 이름":"젠하이","한글 함순이 + 스킨 이름":"불가사의한 성전","영문 함순이 + 스킨 이름":"Vestibule of Wonders","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506011/shipyard.png","설명":"약속대로 오셨군요, 지휘관. 환영합니다~ 이곳의 인테리어에 대해서는 만족하시나요? 저희에게 시간은 많으니, 우선 앉아서 차를 드시지요. 하고 싶은 얘기는 천천히 해요.","자기소개":null,"메인1":{"voiceline":"저와 대국할 수 있는 상대는 이미 있으니, 바둑판과 바둑알이 더 있으면 더할 나위 없겠네요… 아, 급하지 않아요, 이따가 제가 가지러 갈게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/main1.ogg"},"메인2":{"voiceline":"지휘관, 어떤 물건이 맘에 드세요? 도자기? 서화? 아니면…… 이 방 전체? 후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/main2.ogg"},"메인3":{"voiceline":"하이치의 화창, 차오 호의 독무…… 오늘밤은 볼거리가 정말 많네요. 저와 함께 감상해줄 누군가가 있다면, 물론 더없이 좋겠지만요——제 말 뜻 아시겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"제 소장품에 관심이 있으신가요? 후후, 안방에 더 많은데, 저를 따라 같이 보러 가시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/detail.ogg"},"드랍 설명":{"voiceline":"약속대로 오셨군요, 지휘관. 환영합니다~ 이곳의 인테리어에 대해서는 만족하시나요? 저희에게 시간은 많으니, 우선 앉아서 차를 드시지요. 하고 싶은 얘기는 천천히 해요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이 방에서 저에게 가장 중요한 게 뭔지 아시나요? 이 화려한 장식도 아니고, 귀중해보이는 소장품도 아닙니다. 맞아요, 바로 당신이에요, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/feeling5.ogg"},"터치3":{"voiceline":"\"주객전도\"는 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/headtouch.ogg"},"모항귀환":{"voiceline":"\"네, 알겠습니다. 그렇게 하죠.\" 어머, 어서 오세요. 방금 통화 내용은…… 비밀이랍니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"엎어진 김에 쉬어 가시죠. 지휘관, 안심하세요. 박대하지 않으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/login.ogg"},"실패":null,"우편":{"voiceline":"이런 때에 새로운 우편이 오다니요…… 좀 이해하기 어렵네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/mail.ogg"},"임무":{"voiceline":"지휘관은 지금 제 손님입니다. 임무 생각을 하는 건 좋지 않다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/mission.ogg"},"임무완료":{"voiceline":"음? 제가 모르는 사이에 임무를 완성하셨다구요? 제법이신데요, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"이 전화기 써보실래요? 다이얼이 잘 눌리지 않으니 잘못 누르지 않게 조심하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/touch.ogg"},"터치2":{"voiceline":"한 가지 알려드려야 할 것 같군요. 누가 이곳의 주인인지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/touch2.ogg"},"입수시":{"voiceline":"약속대로 오셨군요, 지휘관. 환영합니다~ 이곳의 인테리어에 대해서는 만족하시나요? 저희에게 시간은 많으니, 우선 앉아서 차를 드시지요. 하고 싶은 얘기는 천천히 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70647,"상점 카테고리 id":3,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":800,"기간":"상시","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":506012,"클뜯 함순이 id":50601,"함순이 이름":"젠하이","한글 함순이 + 스킨 이름":"흔들리는 물결","영문 함순이 + 스킨 이름":"Cerulean Ripples","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506012/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506012/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506012/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506012/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506012/shipyard.png","설명":"어머, 지휘관… 설마 당신도 피서하러 온 건가요? 우연이란 참으로 기묘한 것이군요. 아니면… 다른 목적이 있다던가? 후후후….","자기소개":null,"메인1":{"voiceline":"직정경행, 분방자재…. 모처럼 평소의 잡무에서 벗어났으니, 머릿속을 비우고 천천히 즐겨봐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/main1.ogg"},"메인2":{"voiceline":"하이치 말씀이신가요? 방금 막 알게된 동료와 물놀이라도 하러 갔겠죠. 찾으러 가실 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/main2.ogg"},"메인3":{"voiceline":"잔물결에 일렁이는 가을날, 가물거리는 무지개…. 만약 하이티엔이 여기 있었다면 분명 시를 읊었겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"찌는 더위 속에서 찬물에 몸을 담그면 지극한 행복감을 맛볼 수 있죠. 물론 옷은 젖겠지만, 그래도 상관없으시다면… 한번 시험해 보시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/detail.ogg"},"드랍 설명":{"voiceline":"어머, 지휘관… 설마 당신도 피서하러 온 건가요? 우연이란 참으로 기묘한 것이군요. 아니면… 다른 목적이 있다던가? 후후후….","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"…그래서, 오늘은 어떻게 하실 건가요? 전투도 책략도 없는, 둘만의 휴일…. 모처럼 쥐고 있는 주도권을 쓰지도 않고 놓칠 수는 없잖아요? 후후후….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"땀으로 범벅이 되셨네요…. 과연, 더위에 꽤나 시달리신 모양이군요. 일단 열기를 가라앉히신 다음 편히 쉬세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"휴가를 보내려고 오신 거면, 생각이나 결단은 잠시 동안 내려두세요. 충분히 휴식을 취해 두어야, 추후 전략도 더 휼륭해질 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"왜 그러시죠? 급한 용건이 아니라면 휴가 중에 업무 이야기는 하지 않기로 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/touch.ogg"},"터치2":{"voiceline":"어머 지휘관, 여유가 없으신 거 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/touch2.ogg"},"입수시":{"voiceline":"어머, 지휘관… 설마 당신도 피서하러 온 건가요? 우연이란 참으로 기묘한 것이군요. 아니면… 다른 목적이 있다던가? 후후후….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506012/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70754,"상점 카테고리 id":7,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":800,"기간":"상시","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":506013,"클뜯 함순이 id":50601,"함순이 이름":"젠하이","한글 함순이 + 스킨 이름":"취원가수","영문 함순이 + 스킨 이름":"Sylvan Garden's Embroidery","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506013/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506013/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506013/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506013/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506013/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506013/shipyard.png","설명":"어머, 지휘관. 여기에는 혹시 저를 만나려고…? 네, 보시다시피 자수 연구를 하고 있었답니다. 이것도 바둑과 마찬가지로 생각을 정리해 주고, 사물을 더 넓은 시야에서 볼 수 있게 해 주지요. 지휘관께서도 한 번 해보시겠어요? 후후후……","자기소개":null,"메인1":{"voiceline":"조용하고 평화로운 이곳에서 대국을 하면 실력이 쑥쑥 오를 것 같네요… 지휘관, 시간 있으시면 젠하이와 한 판 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/main1.ogg"},"메인2":{"voiceline":"「아름답게 봄의 정원을 장식하면, 벚꽃 그리워져 버드나무에 내려앉네.」 ...자수의 기예는 참으로 심오하군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/main2.ogg"},"메인3":{"voiceline":"끈기뿐만 아니라, 바늘을 찔러넣는 데에도 정확한 기술이 필요하네요. 군사를 배치할 때, 기회를 노려 단숨에 정확한 행동으로 나서야 하는 것과도 통한다고 볼 수 있겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"어머, 지휘관. 여기에는 혹시 저를 만나려고…? 네, 보시다시피 자수 연구를 하고 있었답니다. 이것도 바둑과 마찬가지로 생각을 정리해 주고, 사물을 더 넓은 시야에서 볼 수 있게 해 주지요. 지휘관께서도 한 번 해보시겠어요? 후후후……","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"젠하이가 바늘을 분주히 움직이는 것은 이것이 지휘관께 드릴 '선물'이라서 그렇답니다. 네, 말로 직접 전하는 건 서툰지라, 대신 이 손수건으로 제 마음을 전하려고…… 어머? 늘 몸에 지니고 다니시겠다고요? 후후, 그렇게 말씀해 주시니 기쁘네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/feeling5.ogg"},"터치3":{"voiceline":"여전하시군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 고생 많으셨습니다. 네. 이걸 마치고 나면, 그 노고를 위로할 곡을 연주해 드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 어서 오세요. 어떤 모양을 수놓고 있는 거냐고요…? 아직 비밀이랍니다. 완성하면 아시게 될 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"임무를 순조롭게 처리하신 모양이군요. 좋습니다. 잠깐 여기서 쉬세요. 젠하이가 지휘관께 드릴 선물도 곧 완성될 거니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"? 지휘관께서도 이 \"삼람수(三藍繍)\"에 관심이 있으신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/touch.ogg"},"터치2":{"voiceline":"스스로를 다스리기에는 아직 정진이 필요할 것 같군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/touch2.ogg"},"입수시":{"voiceline":"어머, 지휘관. 여기에는 혹시 저를 만나려고…? 네, 보시다시피 자수 연구를 하고 있었답니다. 이것도 바둑과 마찬가지로 생각을 정리해 주고, 사물을 더 넓은 시야에서 볼 수 있게 해 주지요. 지휘관께서도 한 번 해보시겠어요? 후후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506013/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":0,"상점 카테고리 id":3,"스킨 태그":"브금","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":506019,"클뜯 함순이 id":50601,"함순이 이름":"젠하이","한글 함순이 + 스킨 이름":"젠하이·改","영문 함순이 + 스킨 이름":"Chen Hai (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506019/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506019/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506019/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506019/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506019/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506019/shipyard.png","설명":"젠하이, 약속대로… 새로운 모습으로 다시 찾아왔습니다. 후후… 시간은 충분하니 지금은 느긋하게 앉아서 차의 향기를 즐기며 장래의 꿈에 대해 생각해 보는 건 어떤가요?","자기소개":null,"메인1":{"voiceline":"지금 생각하면, 남을 이기는 것과 자신을 이기는 것은 완전히 다른 것 같아요… 아주 조금 \"자신\"의 한계를 건드린 것만으로 새로운 경지를 엿볼 수 있었던 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/main1.ogg"},"메인2":{"voiceline":"지휘관이 마음에 그리는 평화로운 세상은 어떤 낙원인지 제 눈으로 직접 보고 싶네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/main2.ogg"},"메인3":{"voiceline":"난세에는 권모술수를 구사하는 책사가 필요한 법이지만, 치세에는 근엄 성실한 일꾼이 필요하겠죠. 그날이 오면 세속을 떠나 산속에서 은거라도 할까요? 그쪽이 제겐 더 맞을 것 같군요. 후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"후후… 믿음직스러운 동료들이 이렇게나 많으면 전투의 승패보다 오늘 밤 식단이 뭔지가 더 궁금한 법이죠. 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/detail.ogg"},"드랍 설명":{"voiceline":"젠하이, 약속대로… 새로운 모습으로 다시 찾아왔습니다. 후후… 시간은 충분하니 지금은 느긋하게 앉아서 차의 향기를 즐기며 장래의 꿈에 대해 생각해 보는 건 어떤가요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"계속 생각하던 것인데… 만약 정말 은퇴할 수 있다면, 산자수명한 곳을 찾아 은신처를 만들고 평온한 세상에서 다정한 반려자와 여생을 보낼까 해요. 차나 바둑을 즐기면서 유유자적하게 사는 거죠… 아직은 시기상조일지도 모르지만, 언젠가 그런 날이 오기를 진심으로 바라고 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"이기고 돌아오셨네요. 지휘가 참 훌륭하더군요. 지금은 차를 음미하면서 어깨 힘을 빼고 휴식을 취하시길 바라요. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어머…? 드디어 지휘관께서 선잠에 드시는 광경을 목격했네요. 후후후, 어떠셨나요? 좋은 꿈이라도 꾸셨나요? 괜찮으시면 젠하이에게 들려주실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/login.ogg"},"실패":{"voiceline":"후후후, 당당히 저와 겨뤄서 이기다니…… 그 행운이 계속될 거라고는 생각하지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/lose.ogg"},"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 바둑 한판 어때요? 인생이라는 이름의 판세를 즐기며… 소소한 여흥 거리로… 말이죠. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/touch.ogg"},"터치2":{"voiceline":"후후후, 이렇게 저를 가볍게 대하실 줄이야… 지휘관에게 조금 \"대가\"를 받아야겠는데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/touch2.ogg"},"입수시":{"voiceline":"젠하이, 약속대로… 새로운 모습으로 다시 찾아왔습니다. 후후… 시간은 충분하니 지금은 느긋하게 앉아서 차의 향기를 즐기며 장래의 꿈에 대해 생각해 보는 건 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"후우… 이걸로 다시 평안을 누릴 수 있겠군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506019/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null