[{"클뜯 id":9706040,"클뜯 함순이 id":970604,"함순이 이름":"호쇼·META","한글 함순이 + 스킨 이름":"호쇼·META","영문 함순이 + 스킨 이름":"Houshou META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706040/shipyard.png","설명":"지휘관님, 호쇼예요. 오늘은 여·러·모·로 보살펴드릴게요. 그러니까 지휘관님, 안심하고 모든 것을 이 호쇼에게 맡겨주세요. 후후후♥","자기소개":{"voiceline":"아이처럼 마음껏 호쇼에게 의지해주세요♥ 호쇼에게는 그것 또한 「행복」이랍니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/profile.ogg"},"메인1":{"voiceline":"(지휘관님의 모습, 일거수일투족이 이렇게 뚜렷하게…… 이렇게 지휘관님을 하루 종일 바라보고 있을 수 있다면……)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/main1.ogg"},"메인2":{"voiceline":"어머? 호쇼는 지휘관님에 대해서라면 뭐든 아는 것 같다고요? 어머머~ 그런 감사한 칭찬을……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/main2.ogg"},"메인3":{"voiceline":"지휘관님은 호쇼가 필요하지 않으세요? 뭔가 이 호쇼에게 부족한 부분이라도…? 부디 알려주세요! 뭐든 고칠 테니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/main3.ogg"},"전투개시":{"voiceline":"후후후, 화려하게 흩어지세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/battle.ogg"},"상세확인":{"voiceline":"「아무도 없는데 누가 보는 것 같다」고요? 어머, 너무 피곤하셔서 그런 생각이 드는 거예요. 자꾸 신경이 쓰이시면… 더 호쇼를 의지하시는 게 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/detail.ogg"},"드랍 설명":{"voiceline":"호쇼호 항공모함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>'","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 애들이 차례로 돌아오고 있네요. 다들 무사해서 다행이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/expedition.ogg"},"실망":{"voiceline":"지휘관님, 괜찮아요…… 이렇게 돼도 호쇼는 지휘관님을 꼭 안아드릴 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/feeling1.ogg"},"낯섦":{"voiceline":"많이 피곤하신 모양이네요. …응석 부리고 싶으세요? 괜찮다면 호쇼의 품에서 아무 생각도 하지 않고… 뭐든 이 호쇼에게 털어놔 주세요♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/feeling2.ogg"},"호감":{"voiceline":"역시 항상 지휘관님과 페이스를 맞추면 호쇼도 지휘관님과 좋은 짝이 될 수 있겠죠~? 그런 사소한 부분까지 어떻게 아냐고요? ……그건 비밀이랍니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/feeling3.ogg"},"기쁨":{"voiceline":"「지금 호쇼도 충분히 아름답다」고요? 후후후, 지휘관님께서 그 정도 칭찬을 하실 줄은 생각도 못 했네요… 지휘관님, 더 많이 호쇼를 봐주세요. 호쇼도 지휘관님만을 계속, 계속… 바라보고 있을 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/feeling4.ogg"},"사랑":{"voiceline":"어떠세요, 호쇼의 품에서 쉬시는 건…? 지휘관님만 괜찮으시면 계속 쉬셔도 괜찮답니다. ……이제부터는 모두 다 이 호쇼에게 맡겨주시면 되니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/feeling5.ogg"},"터치3":{"voiceline":"이제부터는 호쇼 차례……♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 고생 많으셨어요. 드실 식사와 음료는 마련해 뒀고, 목욕물도 따뜻하게 데워놨답니다. 하지만 그 전에…… 호쇼의 품에 부디 폭 안겨주시길♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/home.ogg"},"hp 경고":{"voiceline":"지휘관님께 심려를 끼쳐 드릴 수는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/hp_warning.ogg"},"로그인":{"voiceline":"처리해야 하는 서류는 지휘관님께서 평소 하시는 것처럼 정렬해 뒀답니다. 슬슬 업무를 시작할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/login.ogg"},"실패":{"voiceline":"이 패배… 제 책임이 아니라고는 할 수 없겠네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 우편이 왔어요~ 봉투 뜯는 게 귀찮으시면 호쇼가 대신 해드릴까요? 지휘관님은 거기서 읽기만 하시면 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/mail.ogg"},"임무":{"voiceline":"지휘관님께 새로운 임무가 왔어요. 준비는 이 호쇼가 이미 해뒀답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었네요. 보상을 수령해주세요. 「딱 좋은 타이밍에 알려줬다」고요? …후후후, 호쇼는 늘 지휘관님을 보고 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/mission_complete.ogg"},"서약":{"voiceline":"꿈……? 호쇼의… 꿈? 아, 기억났어요. 호쇼의 꿈… 그건 지휘관님과 둘이서…… 늘 항상 같이 있는 거예요. 하지만 그 꿈은 이미 이뤄진 것 같은데, 안 그래요, 여보?♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/propose.ogg"},"스킬":{"voiceline":"자, 들으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/skill.ogg"},"터치1":{"voiceline":"지휘관님, 한 곡 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/touch.ogg"},"터치2":{"voiceline":"지휘관님께서 뭘 하시든, 호쇼는 뭐든 받아들일 수 있답니다♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 호쇼예요. 오늘은 여·러·모·로 보살펴드릴게요. 그러니까 지휘관님, 안심하고 모든 것을 이 호쇼에게 맡겨주세요. 후후후♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/unlock.ogg"},"강화성공":{"voiceline":"(이제부터는 지휘관님을 더 찬찬히 지켜볼 수 있겠어요……)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어서 지휘관님을 만나 뵙고 싶네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706040/win_mvp.ogg"},