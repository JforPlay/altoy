[{"클뜯 id":102330,"클뜯 함순이 id":10233,"함순이 이름":"파고","한글 함순이 + 스킨 이름":"파고","영문 함순이 + 스킨 이름":"Fargo","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102330/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102330/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102330/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102330/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102330/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102330/shipyard.png","설명":"파고급 경순양함 - 파고","자기소개":{"voiceline":"파고급 경순양함의 네임쉽 파고야. 이미 그 전쟁이 끝난 뒤에 태어난지라 이렇다 할 전적은 없어. 그렇지만 전쟁 같은 것보다는 비즈니스에 관심이 많아서 지금은 운송 회사를 경영하고 있어. 지휘관, 지분 참여를 고려해 볼 생각은 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/profile.ogg"},"메인1":{"voiceline":"이모션 데이터를 분석하지 않고 지금 기분을 알아맞혀 보라고…? 음…… 지금 지휘관은 우울해 하고 있어…… 뭐? 오히려 기쁘다고? 왜?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/main1.ogg"},"메인2":{"voiceline":"배달해 줬으면 하는 게 있으면 뭐든 말해 줘. 하루 안에 전달할 수 있어. 아, 괜찮으면 받는 사람한테 배달물을 받을 때 어떤 감정을 느끼는지 파고가 정보 수집할 수 있도록 요청해 줘. 어디까지나 데이터 수집을 위한 거니까 착각하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/main2.ogg"},"메인3":{"voiceline":"금융이나 관광 쪽 사업도 검토 중이지만…… 지휘관, 정말 제휴할 생각은 없는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/main3.ogg"},"전투개시":{"voiceline":"이모션 팩터, 레코딩……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/battle.ogg"},"상세확인":{"voiceline":"고객 페르소나 자료 중에 「비정상적인 감정 상태에 따른 충동구매 사례」라는 부분이 있는데… 이해가 잘 안 가. 지휘관, 설명 좀 부탁해도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/detail.ogg"},"드랍 설명":{"voiceline":"파고급 경순양함 - 파고","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어. 「기쁨」 지수를 2.3% 더 올린 다음에 마중 나가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/expedition.ogg"},"실망":{"voiceline":"지금까지 모니터링하고 분석한 결과, 지휘관은 비즈니스 파트너로서 최적의 선택지라고는 할 수 없겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/feeling1.ogg"},"낯섦":{"voiceline":"감정에 대한 이해도가 부족하면 사업을 전개하면서 판단을 내릴 때도 지장이 생겨. 그래서 지휘관의 협력이 필요해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/feeling2.ogg"},"호감":{"voiceline":"미소? 내가 웃었다고? 보통은 「기쁨」이나 「즐거움」과 같은 긍정적인 감정을 나타낼 때 웃는 얼굴이 되니까…… 아하, 당신 곁에 있으면 몽글몽글한 기분이 되는 게 바로 「기쁨」이라는 거구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/feeling3.ogg"},"기쁨":{"voiceline":"심박수가 기준치를 대폭 초과하고, 긍정적인 감정의 비율이 현저하게 증가하고 있어…… 이 현상을 조합하면, 이런 데이터가 일반적으로 나타내는 퍼스널 이모션은…… 「호감」？","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/feeling4.ogg"},"사랑":{"voiceline":"보기 드문 감정 경향은 아니지만, 설마 나 자신이 이렇게 될 줄은…… 정말 많은 걸 가르쳐 줬네. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/feeling5.ogg"},"터치3":{"voiceline":"쓰다듬기… 일반적으로는 「우호적」 또는 「애호」의 감정을 전하는 행위로 알려져 있지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관의 현재 감정 중 「기쁨」 지수가 74.6%를 점하고 있는 걸 보니, 출격은 순조로웠던 걸로 추측할…… 파고를 만나서 기쁘다고? 하아… 그럼 내 쪽도 「기쁨」 지수를 64.3%까지 올리는 편이 좋겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/home.ogg"},"hp 경고":{"voiceline":"괴로워…… 슬퍼…… 절망적이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘의 감정 경향은 「기쁨」…… 「걱정」…… 「초조함」…… 응? 표정은 평범한데 마음속에서는 여러 감정이 꿈틀거리고 있네. …이해가 잘 안 가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/login.ogg"},"실패":{"voiceline":"졌다— 슬프다—","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/lose.ogg"},"우편":{"voiceline":"지휘관, 수상기가 당신 앞으로 우편을 배달했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/mail.ogg"},"임무":{"voiceline":"임무를 효율적으로 처리하는 것도 지도자로서의 필수 덕목이야, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 보상받는 거, 잊지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/mission_complete.ogg"},"서약":{"voiceline":"지휘관의 현재 감정 분석 중…… 뭐, 데이터 같은 게 없어도 그 열정과 진심은 감지할 수 있어. ……우리 지금, 둘 다 같은 마음이지? 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/propose.ogg"},"스킬":{"voiceline":"슈퍼 파워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/skill.ogg"},"터치1":{"voiceline":"그걸로 감정 조절이 됐어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/touch.ogg"},"터치2":{"voiceline":"「아— 변태—!」 …이런 느낌으로 감정을 표출하면 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/touch2.ogg"},"입수시":{"voiceline":"안녕, 지휘관. 나는 파고야. ……이모션 팩터의 분석 결과에 따르면 처음 만났을 때는 「기쁨」 지수를 45.36% 올리는 편이 바람직해…… 다시 자기소개할게. 「안녕, 지휘관~ 나는 배달 운송 업무를 상담하러 온 파고야~ 잘 부탁해~」","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/unlock.ogg"},"강화성공":{"voiceline":"이모션 팩터 업데이트에 성공했어. 앞으로는 더 정확하게 다양한 감정을 분석할 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다— 신난다—","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102330/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":