[{"클뜯 id":107050,"클뜯 함순이 id":10705,"함순이 이름":"요크타운","한글 함순이 + 스킨 이름":"요크타운","영문 함순이 + 스킨 이름":"Yorktown","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107050/shipyard.png","설명":"요크타운급 항공모함·요크타운 (CV-5)","자기소개":{"voiceline":"요크타운급 항공모함의 네임쉽 요크타운. 버림받았다…? 그 아이들의 탓은 아니지만, 제게는 이제 그 어둠에서 빛으로 손을 뻗을 용기가 없어요. 지휘관님, 당신도 제게서 멀어지시는가요? 그렇지 않으면 이런 저의 손을 잡아 당겨주시는 건가요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/profile.ogg"},"메인1":{"voiceline":"이 아이는 저를 따르고 있어요. 그렇지만 저 같은 게 이 아이를 길러도 괜찮을지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/main1.ogg"},"메인2":{"voiceline":"지휘관님, 42와 24, 아무쪼록 틀리지 않도록 하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/main2.ogg"},"메인3":{"voiceline":"시간이 난다면, 여동생들과 보내는 편이… 저는 아무래도 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/main3.ogg"},"전투개시":{"voiceline":"빛을 찾아내자…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/battle.ogg"},"상세확인":{"voiceline":"저에 대한 것을 기억하지 않아도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/detail.ogg"},"드랍 설명":{"voiceline":"요크타운급 항공모함·요크타운 (CV-5)","voicelink":null},"의뢰 완료":{"voiceline":"무슨 일이니, 이글? 그렇구나, 임무 팀이 돌아온 거니? 지휘관님, 맞이하러 가봐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/expedition.ogg"},"실망":{"voiceline":"역시 지휘관님도 언젠가 제게서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님과는 상사와 부하의 관계로 있기를 바라서… 네, 저에 대한 건 관계없이, 저……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/feeling2.ogg"},"호감":{"voiceline":"지휘관님은 이상하신 분…… 더는 슬픈 이별을 하고 싶지 않다고 했는데, 제 마음으로 발을 디뎌……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님을 믿어도 되나요……? 아니, 이번이야말로 자신을 믿어도 되나요……? 믿어……보고 싶어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/feeling4.ogg"},"사랑":{"voiceline":"네, 지휘관님을, 그리고 지금의 자신을 믿고 있어요. 어둠의 너머에서 오는 빛…… 저, 드디어 찾았다고 생각해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"상처가 없어서…… 다행이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/home.ogg"},"hp 경고":{"voiceline":"빛은, 아직도 멀어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 평안하신지요. 문제가 있다면 제게 맡겨 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/login.ogg"},"실패":{"voiceline":"우선 후퇴해주세요. 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/lose.ogg"},"우편":{"voiceline":"이 아이가 편지를 가져왔어요. 확인해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/mail.ogg"},"임무":{"voiceline":"새롭게 통지된 미션의 자료는 정리했어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/mission.ogg"},"임무완료":{"voiceline":"미션 보너스가 왔습니다. 확인해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/mission_complete.ogg"},"서약":{"voiceline":"일찍이 어둠으로 떨어진 제게, 지휘관님이 준 빛, 구원의 손길을 내밀어 저를 끌어올려 주었어요. 그러니까 이번에는 제가…… 요크타운, 이 이름이 짊어진 자유와 평화를 당신에게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/propose.ogg"},"스킬":{"voiceline":"자유를 위해서……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/skill.ogg"},"터치1":{"voiceline":"지휘관님, 뭔가 있었나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/touch.ogg"},"터치2":{"voiceline":"이런 제게 당신의 표식을 새길 각오가 되어 있다는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/touch2.ogg"},"입수시":{"voiceline":"저는 요크타운급 항공모함의 네임쉽 요크타운. 이름은 과거 유니온 독립전쟁에서의 요크타운 포위전에서 따왔죠. 중립…? 저건 싸움을 마주하기 전의 매너에 지나지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/unlock.ogg"},"강화성공":{"voiceline":"고마워요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리가 평화를 가져온다면, 저는……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['쇼호'] : 말투가 변한 것만으로는 어른이라고 할 수 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/couple_encourage1.ogg"},{"voiceline":"['엔터프라이즈', '호넷'] : 오랜만에 모였네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/couple_encourage2.ogg"},{"voiceline":"['엔터프라이즈'] : 엔터프라이즈, 날개를 펼쳐라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107050/couple_encourage3.ogg"},{"voiceline":"['허먼'] : 지휘관님은 응석꾸러기가 좋으신가요?",