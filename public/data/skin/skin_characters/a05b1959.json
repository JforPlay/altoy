의 탑, 왕의 안식처... 하하, 지휘관님, 저와 함께 이상향을 향해 가시겠어요? 농담이에요~ 지휘관님과 같이 여행할 수 있어서 기뻐요~","자기소개":null,"메인1":{"voiceline":"허먼에게 어떤 특산품을 가져다 주면 좋을까요... 호신부 같은 거요...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/main1.ogg"},"메인2":{"voiceline":"조지 씨는 역시 로열의 기사에요. 많은 걸 알고 있어요. 지휘관님도 이 땅과 관련된 일화를 말씀해 주실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/main2.ogg"},"메인3":{"voiceline":"기분이 가벼워진 것 같은 느낌이에요. 이글 유니온도, 아이리스 리브레도, 모두 각자의 독특한 분위기를 가지고 있어요... 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/main3.ogg"},"전투개시":{"voiceline":"이상을 위해…！","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/battle.ogg"},"상세확인":{"voiceline":"성당, 성스러운 우물, 그리고…… 지휘관님, 다음 장소는 어딘가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/detail.ogg"},"드랍 설명":{"voiceline":"대칭된 7층 계단, 언덕 위의 탑, 왕의 안식처... 하하, 지휘관님, 저와 함께 이상향을 향해 가시겠어요? 농담이에요~ 지휘관님과 같이 여행할 수 있어서 기뻐요~","voicelink":null},"의뢰 완료":{"voiceline":"왜 그래, 이글? 의뢰조가 돌아왔어? 그랬구나, 호넷에게 연락해 볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"저에게는 엔터프라이즈와 그녀들이 있는 모항이 바로 이상향입니다. 저에게 영원한 편안함을 줄 수 있는 곳이 필요하다면…… 그건 분명 지휘관님의 곁이겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/feeling5.ogg"},"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"지휘관님, 여기서 사진 찍어요, 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/login.ogg"},"실패":{"voiceline":"자유는… 사라지지 않아요…！","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107052/lose.ogg"},"우편":null,"임무":{"voiceline":"새로운 임무 통지네요. 후드에게 맡기는 건 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane