[{"클뜯 id":107160,"클뜯 함순이 id":10716,"함순이 이름":"렉싱턴II","한글 함순이 + 스킨 이름":"렉싱턴II","영문 함순이 + 스킨 이름":"Lexington II","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107160/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107160/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107160/shipyard.png","설명":"에식스급 항공모함 - 렉싱턴II","자기소개":{"voiceline":"「블루 고스트」 렉싱턴이 긴 잠에서 돌아왔어. …지휘관, 기다려줘서 고마워. 당신과 다시 함께 할 수 있다는 게 그 무엇보다도 행복해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/profile.ogg"},"메인1":{"voiceline":"브리스톨, 푸슌, 갤런트, 푸보…… 명랑한 애들이 점점 더 늘어나고 있네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/main1.ogg"},"메인2":{"voiceline":"모항이 이렇게 바뀔 줄이야~ 지휘관, 사실 오늘은 숙소에서 길까지 잃어버렸어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/main2.ogg"},"메인3":{"voiceline":"새러토가 웬일로 오늘은 얌전하네…… 아무래도 얼마 전에 나눈 「대화」가 도움이 된 모양이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/main3.ogg"},"전투개시":{"voiceline":"다들 더 나은 미래를 위해 승리를 쟁취하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/battle.ogg"},"상세확인":{"voiceline":"렉싱턴이 또 잠들까 봐 걱정했어? 후후, 걱정하지 마. 이제 다시는 지휘관 곁을 떠나지 않을 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/detail.ogg"},"드랍 설명":{"voiceline":"에식스급 항공모함 - 렉싱턴Ⅱ","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰팀 애들이 돌아왔어. 지금 성과를 확인하고 올게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/expedition.ogg"},"실망":{"voiceline":"지휘관, 언제까지 장난치려고 그래? 슬슬 진지해져야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/feeling1.ogg"},"낯섦":{"voiceline":"아이돌은 모두에게 미소를 가져다주는 직업이야. 물론 지휘관에게도……라고 했었지? 기다리게 한 만큼 두 배로 기쁘게 해줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/feeling2.ogg"},"호감":{"voiceline":"어머? 또 눈살을 찌푸리고 있잖아. 고민 있으면 내가 들어줄게. 같이 해결하자. 언제 들어왔냐고? 후후, 그건 비밀이야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/feeling3.ogg"},"기쁨":{"voiceline":"바닷바람이 그러더라. 오늘은 푹 쉴 수 있는 날이라고. 지휘관, 오늘은 그만 쉬고, 새러토가도 데리고 같이 피크닉이라도  갈까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/feeling4.ogg"},"사랑":{"voiceline":"항구에서 바닷바람을 맞고 있으면 가끔 그 꿈이 생각나. 즐거운 여름, 차가운 바다…… 하지만 꿈은 그저 꿈일 뿐이지. 이렇게 지휘관과 손을 잡고, 온기를 느끼는 이 순간이 나에게는 진정한 행복인걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/feeling5.ogg"},"터치3":{"voiceline":"후후, 지휘관한테 격려받았네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/headtouch.ogg"},"모항귀환":{"voiceline":"화약 냄새…… 지휘관, 오늘도 수고했어. 후후후, 자. 내가 도와줄 테니까, 일을 계속하기 전에 일단 목욕부터 하고 와♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/home.ogg"},"hp 경고":{"voiceline":"전력을 다해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 어서 와. 요즘은 날씨가 변덕스러우니까 아무리 일이 바빠도 건강은 잘 챙겨야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/login.ogg"},"실패":{"voiceline":"자기 주제도 모르는 적이네…… 지휘관, 일단 전열을 가다듬은 다음에 제대로 혼쭐을 내줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/lose.ogg"},"우편":{"voiceline":"새로운 우편이야~ 후후, 누군가의 장난 편지는 들어있지 않았으면 하네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/mail.ogg"},"임무":{"voiceline":"그쪽 임무는 지휘관이… 여기 임무는 내가…… 응, 나눠서 처리하면 효율이 두 배야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/mission.ogg"},"임무완료":{"voiceline":"휴우… 드디어 임무를 다 처리했네. 온천을 예약해 뒀는데, 이따가 기분 전환하러 가지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/mission_complete.ogg"},"서약":{"voiceline":"나도 알아. 지휘관이 이 순간을 위해 얼마나 많은 배려를 해줬는지. 후후, 하나도 안 변했구나. 내 마음도 여전해. 과거에도 지금도, 어떤 곳에서든…… 우리는 영원히 함께야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/propose.ogg"},"스킬":{"voiceline":"「블루 고스트」의 이름으로 장송곡을 선사해 주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/skill.ogg"},"터치1":{"voiceline":"무슨 일이야, 지휘관? 오늘 작전을 되짚어보고 싶어서 그래? 아니면…… 내가 신경 쓰여서?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/touch.ogg"},"터치2":{"voiceline":"후후…… 그래, 바로 그런 느낌이야. 렉싱턴이 뭘 좋아하는지는 역시 지휘관 마음속에 새겨져 있구나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/touch2.ogg"},"입수시":{"voiceline":"후후, 역시 「블루 고스트」를 기나긴 잠에서 깨울 수 있는 건 당신뿐이었어. 오랜만이야, 지휘관. 렉싱턴이 이렇게 다시 당신 곁으로 돌아왔어. 응, 다녀왔어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/unlock.ogg"},"강화성공":{"voiceline":"노래를 더 잘 부를 수 있게 됐어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후후, 다시 태어난 레이디 렉스에게… 다시 반했어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지금 모항을 보고 있으면 그 기나긴 꿈이 드디어 끝났다는 게 실감이 나. …이렇게 후배들이 성장하는 모습을 보면서, 바닷바람과 태양을 느끼고, 웃음도 눈물도 함께 나눌 수 있어서… 정말 행복해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관의 넥타이를 가다듬어 주거나, 지휘관을 위해 차를 끓이거나, 일하는 옆모습을 바라보는 것…… 그런 사소한 순간들 모두 재회가 가져다준 기적이겠지. 이 이상의 사치는 바라지 않아. 나는…… 그저 계속 함께 있을 수 있다면 그걸로 충분해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"후후, 지휘관은 가끔 나한테 기대고 싶다는 듯한 표정을 짓는다니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"수고했어. 남은 작업은 다른 비서함 담당 애들한테 맡겼어. 우리는 먼저 쉬러 가자. 자♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 잠깐. 업무는 아침 식사를 한 다음에 해. 얌전히 내 말 들어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":{"voiceline":"♪♪♪~♪♪♪♪~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/skill_ex.ogg"},"터치1_ex":null,"터치2_ex":{"voiceline":"하아… 으음… 옷이 흐트러지잖아…… 후후, 괜찮아. 나중에 정리해 줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['새러토가'] : 새러토가, 지금 실력은 어떤지 한 번 볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/couple_encourage1.ogg"},{"voiceline":"['요크타운Ⅱ'] : 새로운 나, 새로운 시대…… 함께 날아오르자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/couple_encourage2.ogg"},{"voiceline":"['에식스'] : 후후, 에식스. 같이 싸우자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/couple_encourage3.ogg"}],"메인4":{"voiceline":"항공모함은 쉴 새 없이 전술을 바꾸면서 싸우니까, 당분간은 학생이 돼서 배우는 편이 좋으려나……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"요즘은 날씨도 좋고, 언덕길 꽃도 전부 피었어. 좋은 일이 이어져서 정말 기뻐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/main5_ex.ogg"},"메인6_ex":{"voiceline":"아직도 서류랑 씨름하는 중이야? 잠깐 쉬어. 생각을 정리하는 데 도움이 될 수도 있잖아…… 내가 노래로 긴장을 풀어 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/main6_ex.ogg"},"메인7_ex":{"voiceline":"파워업한 렉싱턴의 요리 먹어 볼래? 베스탈 선생님께 여러 번 배운 성과를 맛볼 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/main7_ex.ogg"},"메인8_ex":{"voiceline":"후후, 일이 끝나면 보충수업 해줄 수 있어? 선생님~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107160/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"UR","ex_chat_status":1},{"클뜯 id":107161,"클뜯 함순이 id":10716,"함순이 이름":"렉싱턴II","한글 함순이 + 스킨 이름":"사근사근한 메이드","영문 함순이 + 스킨 이름":"The Fluffiest of Maids","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107161/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107161/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107161/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107161/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107161/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107161/shipyard.png","설명":"요즘 모항에서는 메이드가 되어보는 게 유행하는 것 같아서, 나도 흥미가 생겨버렸지 뭐야♪ 자, 같이 집을 깨끗하고 편안한 곳으로 만들어볼까?","자기소개":null,"메인1":{"voiceline":"후우… 이제 곧 끝날 거야. 지휘관은 이 다음에 어떻게 쉴 거야? …물론, 내 품에서 쉬는 건 정해진 거지만♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/main1.ogg"},"메인2":{"voiceline":"어머? 지휘관, 가만히 있어 봐. 옷깃에 먼지가…… 후후, 섬세한 부분까지 신경 쓰는 게 바로 메이드잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/main2.ogg"},"메인3":{"voiceline":"늘 맡겨달라고 하면서 이렇게 허둥대다니…… 이것도 신선하고 나쁘지 않은걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"나랑 호흡이 척척 맞네~ 거의 다 정리했어. 이 정도면…… 더 푹 쉴 수 있지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/detail.ogg"},"드랍 설명":{"voiceline":"요즘 모항에서는 메이드가 되어보는 게 유행하는 것 같아서, 나도 흥미가 생겨버렸지 뭐야♪ 자, 같이 집을 깨끗하고 편안한 곳으로 만들어볼까?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이 역할극은 「메이드와 함께 하는 하루」가 주제잖아? 렉싱턴의 서비스, 잘 즐기고 있어? 후후, 지휘관이 시선을 주는 것만으로도 이렇게 두근거려…… 주인님♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/feeling5.ogg"},"터치3":{"voiceline":"읏… 머리카락이 달라붙었다고? 후후, 땀을 좀 흘렸네♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/headtouch.ogg"},"모항귀환":{"voiceline":"어머? 딱 좋은 타이밍에 왔네…… 지휘관, 거기 있는 행주 좀 건네줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"메이드 일의 즐거움이 뭔지 알 것 같아. …맡은 일을 해냈을 뿐인데, 지휘관 마음이 편안해지잖아. 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"음…… 옷차림이 이래서 섬세한 부분까지 신경써야 해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/touch.ogg"},"터치2":{"voiceline":"어휴, 열심히 역할에 몰입하려고 하는 중인데… 못됐어, 정말~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107161/touch2.ogg"},"입수시":{"voiceline":"요즘 모항에서는 메이드가 되어보는 게 유행하는 것 같아서