[{"클뜯 id":701110,"클뜯 함순이 id":70111,"함순이 이름":"오그네보이","한글 함순이 + 스킨 이름":"오그네보이","영문 함순이 + 스킨 이름":"Ognevoy","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701110/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701110/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701110/shipyard.png","설명":"30형 오그네보이급 구축함 - 오그네보이","자기소개":{"voiceline":"30형, 또는 오그네보이급 구축함인 오그네보이예요! 여러 사정 때문에 전투는 많이 못 했어요! 그리고 폭력은 별로 안 좋아해요! 그래도 안심하세요, 지휘관 동지! 오그네보이는 맡은 일은 제대로~ 한답니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/profile.ogg"},"메인1":{"voiceline":"지휘관 동지. 우울할 때는 오그네 보이가 꼭~ 안아드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/main1.ogg"},"메인2":{"voiceline":"이 리본은 방에 장식하고, 이 나비는 의장에 장식하고, 인형은 동료들한테 선물하고… 아! 내친김에 집무실도 귀엽게 해드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/main2.ogg"},"메인3":{"voiceline":"꽉~ 안아주는 걸 좋아하는 이유요? 음… 꼭 안고 있으면 따뜻해지니까요! 상대방도 따뜻해지고, 오그네보이도 따뜻해지고! \"일석이조\"라는 거죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/main3.ogg"},"전투개시":{"voiceline":"화력 전개, 풀 파워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/battle.ogg"},"상세확인":{"voiceline":"전투는 연기 때문에 콜록콜록하고, 적이 떨어뜨리는 잡동사니도 하나도 안 귀여워서 싫어요! 그래도 오그네보이의 포격으로 동료들을 지킬 수 있다면…… 적에게 따끔한 맛을 보여주겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/detail.ogg"},"드랍 설명":{"voiceline":"30형 오그네보이급 구축함 - 오그네보이","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 언니들이 돌아왔어요! 오그네보이도 귀여운 액세서리를 잔뜩 준비했으니까, 같이 전해주러 가요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/expedition.ogg"},"실망":{"voiceline":"흥! 이제 지휘관 동지는 안 안아드릴 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/feeling1.ogg"},"낯섦":{"voiceline":"지휘관 동지! 오그네보이의 새로운 무기예요! 에헤헤, 어때요? 오그네보이의 의장, 엄청 귀엽죠? 다 새로운 액세서리예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/feeling2.ogg"},"호감":{"voiceline":"집무실에 장식이 별로 없는데, 지휘관 동지는 정말 그걸로 만족하시는 건가요? 오늘 업무 끝나면 같이 이것저것 사서 멋지게 꾸며드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/feeling3.ogg"},"기쁨":{"voiceline":"저기…! 지휘관 동지가 바쁜 건 알아요. 그렇지만… 다음에 외출할 때는 오그네보이도 데려가 주시겠어요? 절대 민폐는 안 끼칠게요! ……오그네보이 혼자 집무실에 있으면 너무 쓸쓸해요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/feeling4.ogg"},"사랑":{"voiceline":"오그네보이가 꽉 안아주는 걸로 지휘관 동지가 외로움을 느끼지 않게 된다면, 언제 어디서든 꽉 안아드릴게요! 오그네보이는 언제 어디서든 지휘관 동지 곁에 있어 드릴 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/feeling5.ogg"},"터치3":{"voiceline":"……나중에 지휘관 동지 머리도 엉망으로 만들 거예요! 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/headtouch.ogg"},"모항귀환":{"voiceline":"아! 지휘관 동지, 돌아오셨네요! 다음에는 오그네보이도 데려가 주실래요? 여기서 기다리는 건 너무, 너~무 힘들어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/home.ogg"},"hp 경고":{"voiceline":"으아! 파워가 떨어졌어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/hp_warning.ogg"},"로그인":{"voiceline":"흐아암… 졸려요…… 지휘관 동지는 항상 이렇게 일찍 오세요? 힘들 것 같아요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/login.ogg"},"실패":{"voiceline":"지휘관 동지, 동료들을 보호하기 위해서라도 어서 철수해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔어요~ 새로운 우편~ 다 지휘관 동지 앞으로 온 건가요? 오그네보이한테 온 건 없구요? 히잉…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/mail.ogg"},"임무":{"voiceline":"지휘관 동지, 새로운 임무 연락이 왔어요! 같이 보러 가요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/mission.ogg"},"임무완료":{"voiceline":"음…… 물자 목록… 아마 괜찮을 거예요! 지휘관 동지도 한 번 더 체크해 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/mission_complete.ogg"},"서약":{"voiceline":"와아! 귀엽다! 오그네보이에게 주는 거예요? 에헤헤, 기뻐요! ……응? 어… 잠깐, 결혼?! 지휘관 동지가 오그네보이랑? 지휘관 동지랑 오그네보이가 결혼? 으아, 머리가 혼란스러워… 그래도 오그네보이를 항상 외롭지 않게 할 자신이 있으시다면 끼워주세요! 오그네보이는… 좋아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/propose.ogg"},"스킬":{"voiceline":"귀여운 하트 발사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/skill.ogg"},"터치1":{"voiceline":"왜 그러세요? 안아줬으면 해요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/touch.ogg"},"터치2":{"voiceline":"…지휘관 동지, 오그네보이의 포격을 맛보고 싶으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/touch2.ogg"},"입수시":{"voiceline":"지휘관 동지, 안녕하세요~! 노스 유니온 소속 30형 구축함인 오그네보이라고 해요! 지휘관 동지도 오그네보이의 의장 한번 보세요! 엄청 귀엽죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/unlock.ogg"},"강화성공":{"voiceline":"강해졌어요? 그럼… 의장을 더 귀엽게 장식해도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"귀여움의 위력, 뼈저리게 느끼셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"가끔은 이렇게 둘이 딱 붙어서 조용히 아무것도 안 하는 것도 괜찮지 않아요? 오그네보이가 지루하지는 않을까 걱정이시라구요? 괜찮아요! 오그네보이는 지휘관 동지만 곁에 있어주면 뭘 해도 즐겁다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"흥… 지휘관 동지, 나중에 귀여운 머리 모양으로 되돌려주셔야 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관 동지, 수고 많으셨어요! 상으로 사랑이 가득 담긴 포옹을 드릴게요! …피로가 다 날아갔다구요? 에헤헤~ 다행이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관 동지! 오그네보이, 너무 보고 싶었어요…… 없는 동안 좀 외로웠지만, 얌전히 기다리고 있었다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/login_ex.ogg"},"실패_ex":{"voiceline":"오그네보이가 지휘관 동지를 지킬게요! 그러는 동안 어서 도망가요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/lose_ex.ogg"},"우편_ex":null,"임무_ex":{"voiceline":"지휘관 동지! 새로운 임무 연락이 왔어요! 오그네보이가 도와주면 금방 끝낼 수 있을 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 보상 목록… 문제 없어요! 지휘관 동지, 여기 귀엽게 동그라미를 쳐주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"응? 이 장식, 오그네보이에게 주시는 건가요? 신난다! 너무 귀여워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/touch_ex.ogg"},"터치2_ex":{"voiceline":"여기서요? 오늘 지휘관 동지는 대담하시네요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['스비레피'] :  귀여움이 뭔지 보여드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"서류 업무를 전부 끝냈어요! 그것 말고 오그네보이가 도와드릴 건 없을까요? …이젠 놀아도 된다구요? 그럼, 여기서 지휘관 동지를 기다릴게요! 에헤헤~ 더 오래 같이 있고 싶어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관 동지~ 오그네보이, 집무실에 장식품을 더 늘려도 괜찮을까요? …괜찮다구요? 신난다! 음… 지휘관 동지를 꾸며 드리는 건 안 되는 거죠? 엥… 귀엽게 만들어 드리는 건데 안 되나요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관 동지, 움직이지 마세요! 리본을 제대로 달아야… 너무 귀여워서 안 어울린다고요? 무슨 말씀이세요! 귀여운 게 가장 잘 어울린다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701110/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":701111,"클뜯 함순이 id":70111,"함순이 이름":"오그네보이","한글 함순이 + 스킨 이름":"저스티스 노바!","영문 함순이 + 스킨 이름":"Blue Nova","스킨 타입":"Special Exercise","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701111/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701111/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701111/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701111/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701111/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701111/shipyard.png","설명":"신입 경찰 오그네보이예요! 체포 임무에 참여하러 왔어요! 탈주자님! 순순히 항복하세요! 이 앞은…… 으, 으아아!? 흑… 더 귀여운 배역은 없나요…?","자기소개":null,"메인1":{"voiceline":"\"신입 경찰이라고 얕보지 마세요! 지금 체포할…\" 으아아아…! 수갑을 제 손에 채우고 말았어요! 지휘관 동지! 애버크롬비! 스비레피! 누가 좀 도와주세요! 이대로 있다간 세트가 폭발할 거예요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/main1.ogg"},"메인2":{"voiceline":"음… 수갑이 너무 수수하네요… 아! 리본이랑 스티커로 귀엽고 근사하게 만들어야겠어요! …경찰의 위엄이 떨어지니까 안 된다구요? 힝……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/main2.ogg"},"메인3":{"voiceline":"\"스비레피…… 아니, 그래피티 아티스트가 탈주자에게 협력하고 있어?! 기다리고 계세요! 반드시 체포할 거예요!\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"\"신입 경찰 오그네보이예요! 체포 임무에 참여하러 왔어요! 탈주자님! 순순히 항복하세요! 이 앞은……\" 으, 으아아?! 흑… 더 귀여운 배역은 없나요…?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"\"제가 경찰이 아니었다면… 당신이 탈주자가 아니었다면 다른 결말이 기다리고 있었을지도 몰라요\"……? 으아, 이야기가 왜 이렇게 끝나는 거죠? 이야기 밖의 오그네보이와 지휘관 동지는 계속 함께 할 수 있어서 정말 다행이에요… 그렇죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/feeling5.ogg"},"터치3":{"voiceline":"조금만 살살 만져주세요 >_< 이렇게 머리를 땋으려면 꽤 힘들다구요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관 동지, 고생 많으셨어요! 꽉 안아드리고 싶지만… 촬영이 곧 시작될 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"\"탈주자님, 어서 오세요!\" …네? 탈주자에게 하는 대사니까 더 사납게 해야 한다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/login.ogg"},"실패":{"voiceline":"오그네보이가 지휘관 동지를 지킬게요! 그러니까 어서 도망치세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/lose.ogg"},"우편":{"voiceline":"\"탈주자님\" 앞으로 온 우편이네요♪ 봉투에 붙어있는 그 귀여운 우표, 오그네보이에게 주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/mail.ogg"},"임무":{"voiceline":"새로운 임무예요! 정의를 대표해서 체포하겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701111/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{