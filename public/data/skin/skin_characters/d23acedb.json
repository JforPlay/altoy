[{"클뜯 id":101100,"클뜯 함순이 id":10110,"함순이 이름":"윌리엄 D 포터","한글 함순이 + 스킨 이름":"윌리엄 D 포터","영문 함순이 + 스킨 이름":"William D. Porter","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101100/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101100/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101100/shipyard.png","설명":"플레처급 구축함 - 윌리엄 D 포터","자기소개":{"voiceline":"이글 유니온 소속, 플레처급 구축함인 윌리엄 D 포터야! 이것저것 사고를 좀 치긴 했는데, 결국엔 어떻게든 수습했어…… 어라? 왠지 어뢰가 하나 부족한 것 같은데…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/profile.ogg"},"메인1":{"voiceline":"으앗! 아이스크림을 엎질렀어… 어떡해, 어떡해… 바로 쓱쓱 닦으면…… 해피, 해피, 해피 D! 파바밧 하고 마무리!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/main1.ogg"},"메인2":{"voiceline":"지휘관! 미안해! 새 카펫에 일부러 페인트를 쏟으려던 건 아니야! 으아… 일단은 나부터 좀 여기서 꺼내줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/main2.ogg"},"메인3":{"voiceline":"여차저차해서 폭탄을 실수로 떨어뜨린 곳은 바다였으니까, 아무 문제없어! 폭탄은 왜 들고 있었냐고? 아하하하… 그건 얘기하려면 좀 길어지는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/main3.ogg"},"전투개시":{"voiceline":"오오! 또 아이디어가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/battle.ogg"},"상세확인":{"voiceline":"윌리엄 D 포터는 단짝인 「해피 D」랑 같이 쾅! 푸슝하고 하늘에 부웅~ 날아올라서… 으아아아아! 너무 빨라서 제어가 안 돼!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함 - 윌리엄 D 포터","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 「해피 D」를 타고 동료들을 마중하러 나가자. 준비 됐어? 슈퍼 소닉 대시 스타…… 어라? 으아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/expedition.ogg"},"실망":{"voiceline":"음… 더 재밌는 걸 하고 싶은데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/feeling1.ogg"},"낯섦":{"voiceline":"탄산수를 엎지른 보고서는 아마 다리미로 다리면 원래대로 돌아올… 아! 지휘관, 언제부터 거기 있었어?! 보고서는 아직이냐고……? 그, 금방 끝나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/feeling2.ogg"},"호감":{"voiceline":"내 아이디어로 이번 슈퍼 빅 트러블을 해결했어! 지휘관, 칭찬해 줘~! …신난다! 다음에는 더 대단한 걸 떠올려 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 빨리 내 의장에 타! 동료랑 함께하는 모험 여행에 지휘관이 빠지면 섭섭하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/feeling4.ogg"},"사랑":{"voiceline":"「지휘관을 좋아한다」고 고백할까 진지하게 고민 중이야. 실수 같은 건 절대…… 으아아, 큰일이다! 내일 고백하려고 했는데, 나도 모르게……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/feeling5.ogg"},"터치3":{"voiceline":"쓰담쓰담~ 악운이여, 물러가라~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와, 지휘관! 꼬~옥! 앗, 나도 모르는 사이에 손에 풀이 묻었었네! 꺄아~ 지휘관한테 달라붙어서 안 떨어져~! …이거, 어쩔 수 없이 한동안은 같이 움직여야겠네♪ 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/home.ogg"},"hp 경고":{"voiceline":"위기 상황! 빨리 좋은 아이디어를 떠올려야 해……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/hp_warning.ogg"},"로그인":{"voiceline":"흐아~ 시작 시간보다 더 빨리 도착했는데, 어때? 놀랐어?! ……뭐야, 그 「못 믿겠다」는 듯한 얼굴은…… 난 말이지, 지각하지 않기 위한 아이디어를 100개는 가지고 있거든?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/login.ogg"},"실패":{"voiceline":"으앗, 또 실수했어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로… 으아아아! 넘어졌어…… 우편이 다 바닥에…… 지금 주울게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/mail.ogg"},"임무":{"voiceline":"지휘관, 아직 임무가 남았어! 어려우면 내가 좋은 아이디어를 떠올려 줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/mission.ogg"},"임무완료":{"voiceline":"임무 완료?! ……이렇게 깔끔하게 끝나다니?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/mission_complete.ogg"},"서약":{"voiceline":"드디어 지휘관이랑 여기까지 왔네. 어라? 반지가 어디 갔지……? 서, 설마 잊어버린 건가?! …응? 다른 손에 들고 있다고? 정말이네! 휴우…… 하마터면 큰일 날 뻔 했어……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/propose.ogg"},"스킬":{"voiceline":"효과 만점인 나이스 아이디어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/skill.ogg"},"터치1":{"voiceline":"고양이 손이라도 빌리고 싶다고? 괜찮아, 나한테 좋은 생각이 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/touch.ogg"},"터치2":{"voiceline":"아하하하! 가, 간지러워…! 미안해! 용서해 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/touch2.ogg"},"입수시":{"voiceline":"지휘관, 드디어 만났어! 슈우욱! 파박! 콰앙! 「해피 D」의 착지 지점 계산 실수로 하마터면 지휘관이랑 부딪힐 뻔했네…… 크흠, 아무튼! 최고로 빛나는 윌리엄 D 포터! 최강의 아이디어와 함께 지휘관 곁에 등장♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/unlock.ogg"},"강화성공":{"voiceline":"오오! 의욕 풀 충전!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"신난다! 뭐, 과정이 생각했던 거랑은 전혀 달랐지만, 이겼으니까 결과적으로는 만점인 거 맞지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관이 준 건 계속 소중히 간직할 거야! 어떤 거냐고? 물론 소중한 사람이랑 함께 모험했던 추억이지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"지휘관 에너지, 충전! 의욕이 가득 찼어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 와 지휘관! 엄~청 오래 기다렸어! 지휘관이 없는 동안 재미있는 일이 잔뜩 있었지만, 혼자서만 즐기면 안 되잖아?! 에헤헤, 빨리 나 칭찬해 줘♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"몰래 지휘관한테 뛰어들어서 안겨야지! ……아앗!? 아야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/touch_ex.ogg"},"터치2_ex":{"voiceline":"지휘관, 더는 못 참겠어?! 나도 그래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['푸슌', '페이윈'] : 대모험…? 나도 끼워줘! 좋은 생각이 있거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/couple_encourage1.ogg"},{"voiceline":"['클래런스 K 브론슨'] : 설비 테스트? 언제든 한가해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/couple_encourage2.ogg"}],"메인4":{"voiceline":"자, 지휘관! 저기 파인 곳 좀 봐! 내 실루엣이랑 완전 똑같아! 굉장하지? …어라? 그러고 보니 어제 여기서 넘어졌던가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관, 롤러코스터 타자! 분명 재미있을 거야……! 어, 어라? 티켓이 없잖아…? 괜찮아! 「해피 D」를 타고 롤러코스터랑 시합하는 것도 재미있으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/main5_ex.ogg"},"메인6_ex":{"voiceline":"와아아! 에너지 부족으로 「해피 D」가 떨어지려고 해! 지휘관, 빨리 안아 줘! 우, 우리… 괜찮겠지……?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/main6_ex.ogg"},"메인7_ex":{"voiceline":"어디로 놀러 갈까…… 역시 지휘관이 정해 주는 편이 좋겠어! 지휘관이 낸 아이디어라면 분명 재미있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/main7_ex.ogg"},"메인8_ex":{"voiceline":"지휘관 곁에 있으면, 점점 용기가 솟아나는 것 같아…! 다음엔 분명 잘될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101100/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"UR","ex_chat_status":1},{"클뜯 id":101101,"클뜯 함순이 id":10110,"함순이 이름":"윌리엄 D 포터","한글 함순이 + 스킨 이름":"전대미문의 메이드 서비스","영문 함순이 + 스킨 이름":"The Daredevil's Maidly Service","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101101/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101101/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101101/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101101/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101101/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101101/shipyard.png","설명":"지휘관, 으음… 하루 동안 메이드 하기로 약속했잖아? 아하하하… 사실은… 제시간에 못 갈 것 같아…… 작은 사고가 생겼거든… 아무튼 부탁이야! 도와줘!!","자기소개":null,"메인1":{"voiceline":"사고를 해결해 준 보답을 하고 싶어서 오늘 일정을 짜 봤는데, 또 지휘관한테 민폐를 끼쳤네…… 이렇게 됐으니, 메이드 서비스 시간을 두 배로 늘려줘야겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/main1.ogg"},"메인2":{"voiceline":"지휘관, 지금 어디야? 사실 도와줬으면 하는 게 있는데…… 이번엔 또 무슨 사고를 친 거냐고? 아…하하하… 일단 와주면…… 사고가 아니게 될 거야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/main2.ogg"},"메인3":{"voiceline":"시, 시계탑에 뚫린 구멍은 나 때문이 아니야! 마침 지나가던 것뿐이었는데… 어라? 어뢰가 또 하나 줄었네?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"지휘관, 으음… 하루 동안 메이드 하기로 약속했잖아? 아하하하… 사실은… 제시간에 못 갈 것 같아…… 작은 사고가 생겼거든… 아무튼 부탁이야! 도와줘!!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관! 지휘관이 와줘서 걱정도 긴장도 싹 사라졌어! 메이드 서비스를 시작하기 전에 조금만 더 꼭 안아줘~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지, 지휘관, 어서 와! 으으, 아직도 사고가 잔뜩이야…! 제발 부탁이야, 도와줘…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 드디어 와줬구나! 「해피 D」는 오늘도 말썽만 잔뜩 일으키네…… 응? 나, 나 말이야? 난 그저 지름길로 가게까지 초고속으로 달려가고 싶어서…… 아, 아하하하……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/login.ogg"},"실패":{"voiceline":"위쪽으로 가야지! 위쪽! …으아, 지휘관, 「해피 D」가 내 말을 안 들어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/lose.ogg"},"우편":{"voiceline":"새 우편이 왔어! 활력 넘치는 메이드가 읽어주는 서비스는 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/mail.ogg"},"임무":{"voiceline":"지휘관, 임무 시간이야! 지금은 실제로 도와주기 어렵지만, 메이드의 리마인드 서비스만은 확실히 해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"으아아아, 설마…… 벌 받을 시간…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/touch.ogg"},"터치2":{"voiceline":"지, 지휘관?! 부스에는 언제 들어온 거야……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/touch2.ogg"},"입수시":{"voiceline":"지휘관, 으음… 하루 동안 메이드 하기로 약속했잖아? 아하하하… 사실은… 제시간에 못 갈 것 같아…… 작은 사고가 생겼거든… 아무튼 부탁이야! 도와줘!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101101/unlock.ogg"},"강화성공":nu