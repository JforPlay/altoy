[{"클뜯 id":701090,"클뜯 함순이 id":70109,"함순이 이름":"소브라지텔니","한글 함순이 + 스킨 이름":"소브라지텔니","영문 함순이 + 스킨 이름":"Soobrazitelny","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701090/shipyard.png","설명":"7U형 구축함-소브라지텔니","자기소개":{"voiceline":"스토로제보이급 구축함 겸 천재 메카닉 소브라지텔니, 예전에는 흑해 함대의 일원이기도 했어! 천재적인 재치와 약간의 행운으로 항상 적의 맹공을 멋지게 돌파해왔지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/profile.ogg"},"메인1":{"voiceline":"귀 파고 잘 들어! 이 베어링 회전 소리, 레버의 당김음, 의장이 연주하는 리듬! 홀딱 반할 것 같은 기계의 고동을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/main1.ogg"},"메인2":{"voiceline":"플라스틱? 기각이야, 기각! 금속에 비해 신뢰성이 전혀 없는 소재로 어떻게 부품을 만들라는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/main2.ogg"},"메인3":{"voiceline":"집무실도 슬쩍 보면 깔끔해 보이지만, 이 천재님에게는 구석구석 숨겨진 먼지가 보인다고! 자, 청소 시간이다! 지휘관 동지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/main3.ogg"},"전투개시":{"voiceline":"어느 장비가 더 우수한지 보여줄 때가 왔군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/battle.ogg"},"상세확인":{"voiceline":"먼지는 기계의 가장 큰 적! 작업장에 그 성가신 놈들이 침입하지 않도록 매일 구석구석까지 청소하고 있다고! 역시 난 대단해! 크하하하핫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/detail.ogg"},"드랍 설명":{"voiceline":"7U형 구축함-소브라지텔니","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 물자다! 어디 보자……. 흠, 이 철 상자는 튼튼해 보이는군……. 쓸만하겠어! 으하하핫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/expedition.ogg"},"실망":{"voiceline":"부서진 기계는 다른 사람이 고쳐줄 수 있지만, 저지른 잘못은 지휘관 동지 스스로 반성해야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/feeling1.ogg"},"낯섦":{"voiceline":"대자연의 아름다움과 달리 메카의 아름다움은 인류가 천 년 동안 발전시켜온 기술이 이룩해낸 유일무이한 증표라는 점에 있어! 내가 심취한 이유도 바로 그거지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/feeling2.ogg"},"호감":{"voiceline":"흠, 영차!! 뭘 하냐고? 의장 조정 중이지. 마모된 부분은 나중에 버프 연마로 마무리할 거니까 걱정 없어! 아하하핫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 동지, 혹시 흥미 있으면 작은 가젯이라도 만들어보는 건 어때? 아, 의장 보수용이 아니라 자신을 위해서 말이야! 이 천재 메카닉께서 자상하게 지도해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/feeling4.ogg"},"사랑":{"voiceline":"부, 분명 내가 맨날 기계 이야기만 하고, 기계만 만지작거리는 건 사실이지만, 그건 기계 페티시라든가, 좋아하는 사람이 기계이길 바란다던가 그런 건 아니니까……. 무무무, 무슨 말인지 알겠지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/feeling5.ogg"},"터치3":{"voiceline":"이 천재 메카닉 소브라지텔니의 특제 고글은 가공 작업을 할 때 눈을 확실하게 보호해주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/headtouch.ogg"},"모항귀환":{"voiceline":"출격 수고했어! 싸우느라 파손된 의장, 겸사겸사 개수해줬으면 하는 사람 없나?! 반짝반짝 쌩쌩하게 만들어줄 거라 보장한다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/home.ogg"},"hp 경고":{"voiceline":"이이이이건, 기계적으로 있을 수 없는 상황인데?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/hp_warning.ogg"},"로그인":{"voiceline":"잘 돌아왔어, 지휘관 동지! …집무실이 조금 소란스럽다고? 걱정 마! 이 천재 메카닉님께서 기계를 개조하느라 그랬던 것뿐이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/login.ogg"},"실패":{"voiceline":"왜… 왜 안 움직이지……. 의장, 움직이라고! 어째서 안 움직이는 거냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/lose.ogg"},"우편":{"voiceline":"새로운 우편이네♪ 으헉?! 얼마 전에 시킨 부품이 아직도 안 왔다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/mail.ogg"},"임무":{"voiceline":"새로운 임무다! 지휘관 동지, 힘들다고 기죽진 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/mission.ogg"},"임무완료":{"voiceline":"휴우. 이걸로 임무 끝! 역시 난 천재야! 으하핫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/mission_complete.ogg"},"서약":{"voiceline":"지휘관 동지 쪽에서 적극적으로 다가오리란 건 다 예상하고 있었지! 후후후, 지휘관 동지. 나도 많이 좋아해! 그러니까… 이 사랑이 가장 단단한 금속처럼 영원하길! …비유가 좀 이상하긴 하지만, 이걸로 내가 하고 싶은 말은 다 전해졌겠지! 하하핫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/propose.ogg"},"스킬":{"voiceline":"한꺼번에 날려주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/skill.ogg"},"터치1":{"voiceline":"사양할 거 없어! 마음껏 쓰다듬어! …응? 의장 쓰다듬으려는 거 아니었나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/touch.ogg"},"터치2":{"voiceline":"이, 이래 봬도 여자애라고……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/touch2.ogg"},"입수시":{"voiceline":"와하하핫~ 지휘관 동지! 노스 유니온의 슈퍼 천재 메카닉 소브라지텔니가 왔어! 어떤 기계라도, 모두 나에게 맡겨만 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/unlock.ogg"},"강화성공":{"voiceline":"의장 강화 성공! 난 천재야! 으하하핫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아하하핫! 네 녀석들을 처리하는 것쯤은 나사 돌리기와 마찬가지로 식은 죽 먹기다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/win_mvp.ogg"},"전투개시_ex":{"voiceline":"처분당해야 할 녀석들, 이거나 먹어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/battle_ex.ogg"},"상세확인_ex":{"voiceline":"뭐얏!? 여기도 먼지가 있어? 지휘관 동지, 빨리 창문 열어! 모니터가… 망가지겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"안심해, 지휘관 동지. 내가 평소에 기계와 그림자처럼 붙어 있긴 해도, 절대로 지휘관 동지를 잊지 않을 거니까……! 아니면, 오늘 데이트 장소를 새로 오픈한 장난감 가게로 할까? 거기 재미난 장난감 기계들이 많다던데!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관 동지의 함선을 수리해야겠어! 하나 물어보자면 무슨 요구 같은 거 있어? 예를 들면 안마 의자를 설치해 달라던가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관 동지, 복귀를 환영해! 참, 바닥에 부품들 조심해! 나도 모르게 지휘실을 또 하나의 기계 작업장으로 만들어 버렸네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"새로운 임무가 왔어! 지휘관 동지, 내가 있으니까, 어떤 어려움도 아무런 문제 되지 않않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/mission_ex.ogg"},"임무완료_ex":{"voiceline":"지휘관 동지와 천재인 내가 있다면, 이런 임무는 가볍게 완성하지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"금속의 단단함과 매끄러움에 비해, 지휘관 동지의 터치는 뭔가 다른 안도감을 느낄 수 있어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/touch_ex.ogg"},"터치2_ex":{"voiceline":"으앗!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이겼어! 하하하핫! 나 천재 메카닉님의 승리야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701090/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['잉그레이엄'] : 같이 뭐라도 만들어보지 않겠어?","