uch.ogg"},"터치2":{"voiceline":"......특수 연료를 첨가한 어뢰야, 지휘관 한번 써볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408051/touch2.ogg"},"입수시":{"voiceline":"좋아~ U-73의 이과 실험시간이 시작된다~ 지휘관, 같이 재밌게 실험해 보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408051/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"학교","상점 id":0,"상점 카테고리 id":4,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":408052,"클뜯 함순이 id":40805,"함순이 이름":"U-73","한글 함순이 + 스킨 이름":"초봄의 뜨거운 케미컬 포션","영문 함순이 + 스킨 이름":"New Year's Chemistry","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408052/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408052/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408052/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408052/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408052/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408052/shipyard.png","설명":"초봄의 추위를 누그러뜨리는 차를 더 맛있게 해주는 케미컬 포션! 어떻게 만드는지 이 누나가 알려줄게! 그나저나 지휘관, 시험 삼아 한 번 마셔보지 않을래?","자기소개":null,"메인1":{"voiceline":"알겠지? 마지막에는 이렇게 열을 조금 가해서…… 그래, 실험처럼 정확하게 해야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/main1.ogg"},"메인2":{"voiceline":"케미컬 포션…… 바꿔 말하면, 화학적인 차 같은 거 아니야? ……음, 그래도 차라고 하기에는 느낌이 좀 다른가…… 어려워…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/main2.ogg"},"메인3":{"voiceline":"응? 평소보다 어른스러워 보여서 좋다구? 에헷! 그걸 노렸어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/main3.ogg"},"전투개시":{"voiceline":"포션 재료는 이걸로 정해졌네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/battle.ogg"},"상세확인":{"voiceline":"내 모습? 이스트 글림 스타일로 꾸며봤어♪ 어때? 어울려? 에헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/detail.ogg"},"드랍 설명":{"voiceline":"초봄의 추위를 누그러뜨리는 차를 더 맛있게 해주는 케미컬 포션! 어떻게 만드는지 이 누나가 알려줄게! 그나저나 지휘관, 시험 삼아 한 번 마셔보지 않을래?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"어떻게 만드는지 알려달라고? 오케이! 우선은 이걸 이렇게 세팅해서…… 어라, 손이 떨리잖아. 아하하, 뭘 그렇게 긴장해~ 내가 있으니까 걱정 말라구~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"왜 그래? 차 한 잔 더 하고 싶어? 잠깐만 기다려~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/touch.ogg"},"터치2":{"voiceline":"아무래도 지휘관이 특별한 \"포션\"을 맛보고 싶은 모양이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/touch2.ogg"},"입수시":{"voiceline":"초봄의 추위를 누그러뜨리는 차를 더 맛있게 해주는 케미컬 포션! 어떻게 만드는지 이 누나가 알려줄게! 그나저나 지휘관, 시험 삼아 한 번 마셔보지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408052/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null