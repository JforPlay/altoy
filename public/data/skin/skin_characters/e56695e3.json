[{"클뜯 id":408050,"클뜯 함순이 id":40805,"함순이 이름":"U-73","한글 함순이 + 스킨 이름":"U-73","영문 함순이 + 스킨 이름":"U-73","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408050/shipyard.png","설명":"메탈 블러드 ⅦB형 잠수함 U-73","자기소개":{"voiceline":"메탈 블러드 잠수함 U-73, 수많은 출격 임무를 수행해 온 메탈 블러드 늑대들의 리더야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/profile.ogg"},"메인1":{"voiceline":"계속 잠항을 하고 있다 보면, 가끔은 수면에서 달리고 싶어져…아! 지휘관, 바다에서 한 번 달리고 오지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/main1.ogg"},"메인2":{"voiceline":"모항에서 가만히 있는 것 보다 해역에서 잠항해서 적에게 다가가는 게 스릴있고 좋아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/main2.ogg"},"메인3":{"voiceline":"다른 사람들의 고민을 들어주거나 그걸 해결해주는 건 재미있어. 고민 상담실…?같은 걸 열어볼까? 지휘관은 뭐 고민 같은 거 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/main3.ogg"},"전투개시":{"voiceline":"늑대를 이끄는 자, 그게 바로 나야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/battle.ogg"},"상세확인":{"voiceline":"지휘관, 뭐 너무 고민하지 마~ 전부 다 잘 될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/detail.ogg"},"드랍 설명":{"voiceline":"메탈 블러드 Ⅶ B형 잠수함 U-73","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료! 다들 잘 해줬어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/expedition.ogg"},"실망":{"voiceline":"음…모두가 기다리고 있으니까…지휘관, 미안! 먼저 갔다 올게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/feeling1.ogg"},"낯섦":{"voiceline":"오, 지휘관! 겨우 한 숨 돌린 거야? 잠깐 같이 산책하지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/feeling2.ogg"},"호감":{"voiceline":"몰래 다가가서, 천천히 찬스를 기다린 후에…자아, 기습이다! 하하하, 지휘관, 잡았다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/feeling3.ogg"},"기쁨":{"voiceline":"이제 슬슬 이 누나의 매력을 눈치챘어? 지휘관, 앞으로도 내 곁에 있어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 분명 잠항을 하면 내 속도는 느려지겠지만……지휘관은 무슨 일이 있어도 붙잡을 거야! 특히 마음을, 말이지! 흐흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서와! 흐흥, 나한테 맡길 수 있는 일은 맡기고 제대로 쉬어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/home.ogg"},"hp 경고":{"voiceline":"와아아! 여기서는 회피 행동을 취해야겠어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/hp_warning.ogg"},"로그인":{"voiceline":"야호~ 지휘관, 또 만났네! 이쪽은 준비 만반, 언제든 출격 가능! ……당신 명령 한 마디만 있다면, 말야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/login.ogg"},"실패":{"voiceline":"아니 그게……아하하….설마 질 줄은……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/lose.ogg"},"우편":{"voiceline":"메일 왔어~ 아, 내가 대신 확인하는 게 나을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/mail.ogg"},"임무":{"voiceline":"임무가 도착했구나. 지휘관, 같이 수행하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/mission.ogg"},"임무완료":{"voiceline":"내 서포트가 있으면 임무같은 건 완전 식은 죽 먹기라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/mission_complete.ogg"},"서약":{"voiceline":"후훗, 이렇게 빨리 올 줄은 몰랐지만, 이제부터 지휘관은 내 일부가 되는 거야! 좋아, 누나에게 전부 맡겨줘! 평생 돌봐줄 테니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/propose.ogg"},"스킬":{"voiceline":"이리떼 전술, 발동!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/skill.ogg"},"터치1":{"voiceline":"응? 내가 도와줄 수 있는 일 있어? 뭐든지 말해 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/touch.ogg"},"터치2":{"voiceline":"흐응…보아하니 지휘관, 어뢰 몇 발 맞고 싶은 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드 소속, U-73이 착임 했어! 자아, 명령이든 고민이든 뭐든 말해보렴. 누나에게 맡겨두시라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/unlock.ogg"},"강화성공":{"voiceline":"이제 더 정확하게 타격을 줄 수 있게 되었네~. 흐흥~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후훗! 내 힘은 잘 봤어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['U-81', 'U-556', 'U-47', 'U-557'] : 다음은 우리들 유보트 차례야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408050/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":408051,"클뜯 함순이 id"