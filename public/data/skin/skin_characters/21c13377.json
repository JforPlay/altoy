oiceline/301124/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관 씨가 또 무사히 돌아오셔서 다행이에요. …이나즈마, 계속 여기서 기다리고 있었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301124/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"? 지휘관 씨, 메이드라는 설정의 이나즈마보다 더 빨리 오셨네요… \"봉사\"하기에 늦은 건 아니죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301124/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새로운 임무가 있네요. 야근 알람이 삐비비비하고 울리고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301124/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어요. 야근 수당도 지급되었고요. ……그럭저럭 괜찮죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301124/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관 씨, 귀 청소 해드릴까요? …네, 이나즈마 무릎을 베고 누워주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301124/touch.ogg"},"터치2":{"voiceline":"……지휘관 씨, 늘 갑작스럽게 그러시네요. …이번에는 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301124/touch2.ogg"},"입수시":{"voiceline":"하나, 둘…… 네. 지휘관 씨, 이제 괜찮아요. 네. ……오늘 이나즈마는 지휘관 씨의 메이드예요. 꽃꽂이 말고는 익숙하지 않지만, 계속 계속 곁에 있어드릴 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301124/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":0,"상점 카테고리 id":17,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R",