[{"클뜯 id":702010,"클뜯 함순이 id":70201,"함순이 이름":"아브로라","한글 함순이 + 스킨 이름":"아브로라","영문 함순이 + 스킨 이름":"Avrora","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702010/shipyard.png","설명":"아브로라급 경순양함 - 아브로라 ","자기소개":{"voiceline":"순양함 아브로라입니다. 아시는 대로, 과거 혁명의 선봉을 맡았습니다. 다만 그 후에 세계가 어떻게 바뀌었는지, 지금에 와서는 잘 모르겠네요… \n어쨌든, 함대에서의 저는 단지 병사일 뿐이니 사양하지 말고 써주세요. 함대에 승리를 가져다 드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/profile.ogg"},"메인1":{"voiceline":"마음이 넓다구요……? 칭찬해주셔서 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/main1.ogg"},"메인2":{"voiceline":"아침을 맡는 자로서, 모두에게 새벽의 빛을 가져와 드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/main2.ogg"},"메인3":{"voiceline":"곰 말인가요? 예전에 기른 적이 있어요. 귀엽답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/main3.ogg"},"전투개시":{"voiceline":"우리의 목적지는 승리입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/battle.ogg"},"상세확인":{"voiceline":"전사로서 행동하는 것은 뭔가 신선하네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/detail.ogg"},"드랍 설명":{"voiceline":"아브로라급 경순양함 - 아브로라","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님? 의뢰가 완료된 모양이에요. 돌아온 아이들에게 술을 대접해 몸을 따뜻하게 해주죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/expedition.ogg"},"실망":{"voiceline":"지휘관님 마음 속의 어둠…… 저로서도 무리인 걸까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 한 잔 어때요? 저를 취하게 해서 이상한 짓을 할 수 있을 지 없을 지… 지휘관님 주량 나름이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/feeling2.ogg"},"호감":{"voiceline":"고향 말인가요? 아름다운 곳이긴 하지만, 지휘관님은 제대로 방한 대책을 해야…… 저는 아무것도 안 입어도 괜찮아요, 우후후. …보고 싶어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 제 고향 사람은 다들 대단히 솔직하답니다. 저도 마찬가지구요~ 후후, 이 보드카 한 병 다 마신 후에는, 저에게 뭘 해도 용서해드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, \"야 류블류 찌뱌(Я люблю тебя)\". 무슨 말인지 궁금하시면, 러시아어를 공부해서…… 저랑 함께 제 고향으로 돌아가시지 않을래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고하셨어요. 보드카 한 병 따서 몸 좀 녹일까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/home.ogg"},"hp 경고":{"voiceline":"고난을 딛고 일어서야 비로소 새벽이…!","voicelink":null},"로그인":{"voiceline":"아, 지휘관님, 어서오세요. 보르시라도 드시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/login.ogg"},"실패":{"voiceline":"혁명은 그 걸음을 멈추지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/lose.ogg"},"우편":{"voiceline":"머나먼 곳에서 온 우편이에요. 확인해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/mail.ogg"},"임무":{"voiceline":"새로운 임무. 왠지 두근두근하네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/mission.ogg"},"임무완료":{"voiceline":"보수에요. 당연히 받아야죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 방한 대책은 빈틈없이 하셨나요? 귀성길은 추울지도 모른답니다. 그렇게 걱정하지 않아도 괜찮아요, 제가 보드카 잔뜩 가져왔으니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/propose.ogg"},"스킬":{"voiceline":"새벽빛 속에 있는, 피와 불꽃……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/skill.ogg"},"터치1":{"voiceline":"안 춥다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/touch.ogg"},"터치2":{"voiceline":"감정을 어필할 거면 좀 더 정열적인 방법으로, 알겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/touch2.ogg"},"입수시":{"voiceline":"Здравствуйте (안녕하세요)! 아브로라, 착임했습니다. 새벽의 빛과 함께, 당신에게 승리를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/unlock.ogg"},"강화성공":{"voiceline":"곰도 들어 올릴 수 있을 것 같은 기분이에요. 후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리 뒤에 감춰진 희생을 마음 속에……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['강구트'] : 강구트, 지휘관님을 너무 괴롭히지 말아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/couple_encourage1.ogg"},{"voiceline":"['파먀티 메르쿠리야'] : 퍄쨩의 대화법은 조금… 아하하하…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/couple_encourage2.ogg"},{"voiceline":"['그로즈니', '민스크', '타슈켄트', '롤리', '차파예프'] : 노스 유니온, 갑니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702010/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_