[{"클뜯 id":11300030,"클뜯 함순이 id":1130003,"함순이 이름":"니나 프리드","한글 함순이 + 스킨 이름":"니나 프리드","영문 함순이 + 스킨 이름":"Nina Friede","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300030/shipyard.png","설명":"안녕, 나는 니나야. 조사단에 소속된… 뭐, 굳이 이런 설명까지는 필요 없겠지? 그나저나 이제는 뭘 해야 하나… 응? 집으로 오라고? 어머나~ 그런 말, 막 해버려도 괜찮은 거야?","자기소개":{"voiceline":"니나 프리드야. 알라디스 조사단에 소속되어 매일 일하느라 바빠. 출신지? 나이? 그런 건 기본적으로 비밀이야. 후후후… 조금은 비밀이 있는 편이 근사하잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/profile.ogg"},"메인1":{"voiceline":"여기 애들은 다들 멋쟁이네. 귀여운 애도 있고, 매력적인 언니까지. 아일라가 있었으면 신나서 여기저기 물어보고 다녔을걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/main1.ogg"},"메인2":{"voiceline":"여기 무기는 우리가 사용하는 것보다 훨씬 강력해… 우리 같은 용병이라도 다루기 어려워 보여.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/main2.ogg"},"메인3":{"voiceline":"요즘 허브티에 푹 빠졌는데, 여기에도 처음 보는 차가 있어서 즐거워. 다음에 같이… 이상한 걸 넣진 않을 테니까 안심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/main3.ogg"},"전투개시":{"voiceline":"금방 끝내줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/battle.ogg"},"상세확인":{"voiceline":"이래 봬도 용병일을 하고 있어. 그래서 여기서 처음 본 의장도 어떻게든 사용할 수 있는 것 같아. 진짜 전장에서는 무기를 고를 수 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/detail.ogg"},"드랍 설명":{"voiceline":"안녕, 나는 니나야. 조사단에 소속된… 뭐, 굳이 이런 설명까지는 필요 없겠지? 그나저나 이제는 뭘 해야 하나… 응? 집으로 오라고? 어머나~ 그런 말, 막 해버려도 괜찮은 거야?","voicelink":null},"의뢰 완료":{"voiceline":"심부름 담당 애들이 돌아왔어. 자, 제대로 맞이하러 가야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/expedition.ogg"},"실망":{"voiceline":"업무에 관련된 거면 도와줄게. 그 이상도, 이하도 아니니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/feeling1.ogg"},"낯섦":{"voiceline":"그래, 오늘도 힘내서 가볼까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/feeling2.ogg"},"호감":{"voiceline":"이상하네… 이럴 리가 없을텐데…… 네가 좀 더 복실복실했다면 아주 이해가 안 가는 것도 아닐 텐데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/feeling3.ogg"},"기쁨":{"voiceline":"이유는 모르겠지만 네 시선만은 느낄 수 있어. 응, 나도 이상할 정도로 신경쓰고 있는 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/feeling4.ogg"},"사랑":{"voiceline":"「얼떨결에 정신을 차려보니 여기 있었다…랄까? 미스테리한 이 장소, 동료, 그리고 여기서 만난 너…… 이 여정에는 분명 무언가 특별한 의미가 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/feeling5.ogg"},"터치3":{"voiceline":"어머, 여자 머리카락을 그렇게 쉽게 만지면 안 되지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/headtouch.ogg"},"모항귀환":{"voiceline":"피곤해 보여. 허브티라도 끓여줄까? 조금 쉬다가 가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/home.ogg"},"hp 경고":{"voiceline":"아직이야! 지금부터가 진짜야!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/hp_warning.ogg"},"로그인":{"voiceline":"안녕, 지휘관, 잘 지냈어? 오늘도 열심히 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/login.ogg"},"실패":{"voiceline":"어머, 못난 모습을 보여버렸네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/lose.ogg"},"우편":{"voiceline":"지휘관, 이건 네 앞으로 온 거야. 제대로 봐두도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/mail.ogg"},"임무":{"voiceline":"어머? 아직 끝나지 않은 임무가 있는데… 까먹은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/mission.ogg"},"임무완료":{"voiceline":"이건 다 끝났네? 확인 안 하면 방치되고 말걸~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/mission_complete.ogg"},"서약":{"voiceline":"그때 여기서 너를 만나지 못했다면 지금의 나는 없었겠지… 분명 다른 나였을 거야. 그게 어떤 의미를 가지는가는… 미래의 역사학자에게 맡기면 되겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/propose.ogg"},"스킬":null,"터치1":{"voiceline":"응? 왜 그래? 뭐 힘든 일이라도 있어? 나한테 말해 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/touch.ogg"},"터치2":{"voiceline":"후훗, 그 정도로 해 둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/touch2.ogg"},"입수시":{"voiceline":"안녕, 나는 니나야. 조사단에 소속된… 뭐, 굳이 이런 설명까지는 필요 없겠지? 그나저나 이제는 뭘 해야 하나… 응? 집으로 오라고? 어머나~ 그런 말, 막 해버려도 괜찮은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/unlock.ogg"},"강화성공":{"voiceline":"어머? 어머머머? 뭔가 잘 되는 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어머나, 벌써 끝난거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/win_mvp.ogg"},"전투개시_ex":{"voiceline":"자, 간다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/battle_ex.ogg"},"상세확인_ex":{"voiceline":"동료와 함께 일을 계속하는 용병도 없지는 않아. 어때? 관심 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300030/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"아하… 그렇구나. 알았어, 항복이야. 응? 괜찮아. 신경 쓸 필요 없어. 그냥 나대로 조금 결심이 섰다…… 그런 느낌일 뿐이니까.","voicelink"