[{"클뜯 id":402100,"클뜯 함순이 id":40210,"함순이 이름":"레겐스부르크","한글 함순이 + 스킨 이름":"레겐스부르크","영문 함순이 + 스킨 이름":"Regensburg","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402100/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402100/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402100/shipyard.png","설명":"M급 경순양함-레겐스부르크","자기소개":{"voiceline":"메탈 블러드 소속 경순양함인 레겐스부르크야. 이렇다 할 함력은 없지만, 네놈 따위가 쉽게 다룰 수 있는 존재가 아니라는 걸 증명해주지. 레지나, 우리의 힘을 저 하등한 존재에게 보여줘! (쿠구구구!!!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/profile.ogg"},"메인1":{"voiceline":"(쿠구구……) 왜 그래, 레지나? 슬슬 밥 시간인가? 야, 네놈도 슬슬 휴식을 취하는 게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/main1.ogg"},"메인2":{"voiceline":"자금 수지… 네놈, 뭐 하는 거야? 설마 빤히 보이는 낭비를 방치하는 게 지휘관의 책무라고 생각하는 건 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/main2.ogg"},"메인3":{"voiceline":"의장 길들이기는 진영마다 천차만별이야. 네놈도 비상시를 대비해서 공부해 두라고. 네놈의 전력으로 쓰진 못하더라도 도움이 될 때가 있을 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/main3.ogg"},"전투개시":{"voiceline":"의장 전개! 자, 벌벌 떨어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/battle.ogg"},"상세확인":{"voiceline":"어머, 아무리 네놈이라도 의장들에게는 손 쓸 도리가 없는 모양이네. 역시 그래봤자 인간이지. 그 힘은 네놈에겐 과분한 것 같네. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/detail.ogg"},"드랍 설명":{"voiceline":"M급 경순양함-레겐스부르크","voicelink":null},"의뢰 완료":{"voiceline":"(쿠구구구!!!) 레지나, 시끄러워! …응? 의뢰팀이 돌아왔다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/expedition.ogg"},"실망":{"voiceline":"결국은 인간일 뿐, 지배하는 것보다 지배 당하는 편이 더 어울려. 이얍!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/feeling1.ogg"},"낯섦":{"voiceline":"후후후, 하등한 존재가 우쭐대는 걸 보는 게 이렇게 재밌을 줄이야. 네놈, 착각하지 마. 내가 의장을 훈육하는 것과 네놈이 내게 지시를 내리는 건 전혀 다르니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/feeling2.ogg"},"호감":{"voiceline":"네놈은 인간치고는 꽤 하는 편이야. 그건 나도 인정하는 부분이고, 그걸 봐서 네놈 명령을 따르고 있는 거지. 그래서 뭐? 설마 네놈, 나를 부하로서가 아니라 개인적으로 밑에 두려는 생각이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/feeling3.ogg"},"기쁨":{"voiceline":"인정 못 해…. 난 인정 못 해! 네놈 따위의 지휘가 내 힘을 더 끌어낼 수 있다니…… 뭐? 이건 내 힘이 아니라 네놈 힘이라고? 그럴 수가… 네놈이… 나보다 강하다는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/feeling4.ogg"},"사랑":{"voiceline":"내가… 레겐스부르크가 겨우 이런 녀석에게…… 지휘관 따위에게 지다니…! 네놈, 대체 정체가 뭐야?! 이대로 계속 힘을 끌어내면 나, 지휘관에게 지는 게 아니라 예속되고 말아… 이럴 순 없어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/feeling5.ogg"},"터치3":{"voiceline":"뭐야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/headtouch.ogg"},"모항귀환":{"voiceline":"흥, 귀찮게 구네… 네놈하곤 상관없는 일이야. 이건 어디까지나 나랑 의장 사이의 문제라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/home.ogg"},"hp 경고":{"voiceline":"하등한 존재에게 당할 순…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/hp_warning.ogg"},"로그인":{"voiceline":"어머, 시간 맞춰서 왔네. 성실한 건지, 아니면 누구에게 혼나서 그런 건지는 불문에 부쳐두지…. 어서 오늘 근무나 시작해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/login.ogg"},"실패":{"voiceline":"내가… 내가 이런 조무래기에게… 윽!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/lose.ogg"},"우편":{"voiceline":"연락이 왔어. …레지나, 아이젠이 또 사고 친 거야? 아니구나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/mail.ogg"},"임무":{"voiceline":"상급자인 나는 싸우고, 그동안 네놈은 임무인지 뭔지를 처리하도록 해. 이렇게 결정!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/mission.ogg"},"임무완료":{"voiceline":"보상? 네 저축금으로 들어가는 게 아니라서 유감이네. 후후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/mission_complete.ogg"},"서약":{"voiceline":"윽! 내가 네놈같은 하등한 존재에게… 거스를 수 없어…. 더 강하고, 더 높은 존재인 지휘관에게…… 네놈, 대체 무슨 수법을 써서 날…… 반지? 설마, 나를 구속하려는 거야…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/propose.ogg"},"스킬":{"voiceline":"짖어, 레지나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/skill.ogg"},"터치1":{"voiceline":"레지나를 만지고 싶은 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/touch.ogg"},"터치2":{"voiceline":"혼을 내줘야겠네…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드 경순양함 레겐스부르크, 흑빛 강철의 용의를 조종하는 자. 네놈 속셈은 이미 잘 알고 있지. 후후후, 나를 다른 애들처럼 쉽게 다를 수 있을 거란 생각은 접어두라고. (쿠구구구!!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/unlock.ogg"},"강화성공":{"voiceline":"후후후, 설마 네놈, 내 상급자로서의 위치를 더 강화할 셈이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"(쿠구구구!!) 누가 위고 누가 아래인지, 이번에 직접 몸으로 잘 느꼈겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/win_mvp.ogg"},"전투개시_ex":{"voiceline":"자, 내 힘을 더 끌어내 보라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/battle_ex.ogg"},"상세확인_ex":{"voiceline":"네놈 도움따윈 필요 없어. 여기서 더 네놈에게 의존하면 이 레겐스부르크의 이름이 빛을 잃는다고……. 맘대로 도와주는 것도 허락 못 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아온 것 같네. 네놈 책무를 다할 때야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/expedition_ex.ogg"},"사랑_ex":{"voiceline":"(지금 만약 지휘관이 명령이라도 하면 분명 난 아무 의심도 없이 바로 따르겠지…. 이런 낭패가…! 언제든 마음만 먹으면 바로 짓뭉갤 수 있을 것 같은데, 설마 날 문자 그대로 사역할 수 있는 힘을 가지고 있을 줄이야…!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"(쿠구구구!!) 기다리고 있었어. 네놈이 성실하다는 점은 이미 파악하고 있었지. 자, 어서 다음 업무를 진행하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"임무인가? 흥, 도와줄게. 이건 내 힘에도 직결되는 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/mission_ex.ogg"},"임무완료_ex":{"voiceline":"(임무 보상이 저렇게나 많이… 지휘관, 대체 얼마나 더 날 앞지를 생각이야…?!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"(쿠구구구……) 레지나가 지휘관을 따르…다니?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/touch_ex.ogg"},"터치2_ex":{"voiceline":"윽…! 분해… 그렇지만…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"(쿠구구구!!) 이 고양감과 충실감…. 이게 지휘관이 가져다주는 승리의 감촉이라는 건가…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['마그데부르크'] :  원호해, 레지나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/couple_encourage1.ogg"},{"voiceline":"['에기르'] :  네 녀석이 마술을 부릴 필요도 없어! 내게 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"저금통이 또 꽉 찬 것 같네. 흥, 깔보지 말라고. 티끌 모아 태산. 작은 돈도 계속 저축하면 언젠가는 큰 재물을 이루는 법이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/main5_ex.ogg"},"메인6_ex":{"voiceline":"(언젠가 꼭 지휘관의 약점을 잡아서, 내가 상급자라는 걸 다시 인정하게 해주겠어……. 그때까진 참아야 해…!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"(쿠구구구……) 뭐? 또 작은 의장들이 무서워해? 흥, 레지나. 네 겉모습이야말로 상급자로서의 위엄 그 자체인데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402100/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":402101,"클뜯 함순이 id":40210,"함순이 이름":"레겐스부르크","한글 함순이 + 스킨 이름":"흑룡과 빛의 해안","영문 함순이 + 스킨 이름":"Dark Dragon, Brilliant Beach","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402101/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402101/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402101/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402101/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402101/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402101/shipyard.png","설명":"네놈, 이게 보고 싶은 거지? 후후후, 부정해도 소용없어. 네놈의 저속한 욕망은 손바닥 보듯이 훤히 보인다고. 어서 솔직하게 인정하는 게 어때?","자기소개":null,"메인1":{"voiceline":"? 네놈, 무슨 짓을… 꺅?! 어, 어서 꼬리에서 손 떼! 내 말 안 들려?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/main1.ogg"},"메인2":{"voiceline":"(쿠구구구……) 레지나가 꽤 먼 바다까지 나간 모양이네. 별일 없어야 하는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/main2.ogg"},"메인3":{"voiceline":"바다에 왔으니 하고 싶은 게 한두 개쯤은 있겠지? 자, 어서 네놈이 하고 싶은 걸 하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"네놈, 이게 보고 싶은 거지? 후후후, 부정해도 소용없어. 네놈의 저속한 욕망은 손바닥 보듯이 훤히 보인다고. 어서 솔직하게 인정하는 게 어때?","voicelink":null},"의뢰 완료":{"voiceline":"(쿠구구……) 의뢰팀이 돌아온 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"(내가 아니라 다른 애를 보고 있는 건가? 어이 없네. 내가… 레겐스부르크가 지휘관에게 있어서 가장… 윽?! 대체 무슨 생각을 하는 거야?! 설마 나… 질투라도 하는 건가?!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"레지나는 친구랑 즐거운 시간을 보내고 있는 것 같네. 네놈도 좀 쉬지 그래? 설마 그 지친 몸이 어디까지 버틸 수 있을지 시험해 보려는 건 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"후후후, 제아무리 네놈이라도 내 매력에 저항할 수는 없지. 자신의 감정에 지배되는 사람따윈 의장이랑 똑같이 다루기 쉬운 법이라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/login.ogg"},"실패":{"voiceline":"레지나만 여기 있었어도 네놈들 따윈…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/lose.ogg"},"우편":null,"임무":{"voiceline":"임무… 지금 바다를 즐기는 거 말고 대체 또 뭐가 있다는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/mission.ogg"},"임무완료":{"voiceline":"보상은 아무리 많아도 부족하지. 어떤 형태든지 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402101/