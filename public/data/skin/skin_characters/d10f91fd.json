[{"클뜯 id":501090,"클뜯 함순이 id":50109,"함순이 이름":"푸보","한글 함순이 + 스킨 이름":"푸보","영문 함순이 + 스킨 이름":"Fu Po","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501090/shipyard.png","설명":"창펑급 구축함 - 푸보","자기소개":{"voiceline":"창펑급 구축함 2번함 푸보야! 에헤헤~ 사실 지휘관 몸에 이미…… 어라? 왜 땅바닥에……? 바로 주워서… 헉? 벌레 모양 장난감이 어떻게 이렇게 빨리 움직이는 거지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/profile.ogg"},"메인1":{"voiceline":"으아아! 지휘관, 왜 내 노트를 가지고 있는 거야?! 어서 돌려줘! 안에는 내 비밀 계획이…… 뭐?! 어딜 봐서 그게 낙서장이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/main1.ogg"},"메인2":{"voiceline":"에헤헤, 정말 완벽한 계획이야. 창펑 언니가 청소하러 나가면 몰래 빠져나와서…… 지휘관?! 왜 창펑 언니를 데리고 온 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/main2.ogg"},"메인3":{"voiceline":"지휘관이 업무에 집중하는 동안 몰래 신발 끈을…… 응? 끈이 없…잖아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/main3.ogg"},"전투개시":{"voiceline":"헤헤헤~ 내 계획은 완벽해! 자, 출발!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/battle.ogg"},"상세확인":{"voiceline":"이걸 몰래 지휘관의 만년필에 붙이면…… 으앗, 지휘관?! 언제 왔어?! 아무것도 안 했어! 헉! 손이 옷에 들러붙었잖아! 으아아, 지휘관! 도와줘!! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/detail.ogg"},"드랍 설명":{"voiceline":"창펑급 구축함 - 푸보","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어! 어서 마중하러 다녀와! 그동안 푸보는…… 아, 아무것도 아니야! 잘못 들은 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/expedition.ogg"},"실망":{"voiceline":"지휘관, 지금 나 혼내려고 그러는 것 같은데…? 그, 그럼 나는 잠깐 멀리 떨어져 있어야겠다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/feeling1.ogg"},"낯섦":{"voiceline":"컵이 넘어진 건 내 잘못이 아니라, 에어컨 바람 때문이야…! 으… 으으으… 그렇게 빤히 쳐다보지 마… 그래, 사실 내가 했어… 지금 바로 치울게……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/feeling2.ogg"},"호감":{"voiceline":"으으으… 창펑 언니한테 또 혼났어… 이제 장난은 그만 치라고……. 흑…… 오, 지휘관 모자 뒤에 개구리를 넣어보면 어떨까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/feeling3.ogg"},"기쁨":{"voiceline":"완성! 이거 봐, 지휘관! 페이윈이랑 푸슌을 위해 만든 대모험 계획이야! 굉장하지? …응? 여기는 더 이렇게 하는 편이 좋겠다고…? 오오, 일리 있네…… 어라? 이제 내가 뭘 그렸는지 알아보네…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/feeling4.ogg"},"사랑":{"voiceline":"……왜 또 지휘관한테 들킨 거지?! 주머니 뒤지지 마! …알았어, 내가 좋아하는 사탕… 지휘관한테도 나눠 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/feeling5.ogg"},"터치3":{"voiceline":"에헤헤~ 우선은 지휘관의 경계심을 푸는 것부터… 히히히히~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/headtouch.ogg"},"모항귀환":{"voiceline":"……지휘관!! 우왁!! …에헷, 깜짝 놀랐지? 하, 하나도 안 놀랐다고? 그림자 보고 이미 다 알았다고?! 윽…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/home.ogg"},"hp 경고":{"voiceline":"아파! 그만 좀 때려! 으와앙!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/hp_warning.ogg"},"로그인":{"voiceline":"왔구나, 지휘관! 푸보가 폭신폭신하게 앉을 수 있게 쿠션을 가져다 뒀어~ 어서 앉아 봐! ……어라? 왜 소리가 안 나지…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/login.ogg"},"실패":{"voiceline":"으아아아!! 언니… 지휘관… 도와줘어어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이…… 으아아아! 후우… 하마터면 넘어질 뻔했네. 누가 여기에 물을 뿌린 거야?! 아… 내가 그랬을지도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/mail.ogg"},"임무":{"voiceline":"지휘관! 어서 임무 처리하고 와! 목록은 책상 서랍에…… 헉? 어떻게 아무렇지 않게 꺼낸 거지?! 같이 넣어둔 풍선은…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/mission.ogg"},"임무완료":{"voiceline":"내가 도와준 덕분이지! 에헤헤~ …뭐가 그려져 있는 건지 전혀 이해할 수 없었다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/mission_complete.ogg"},"서약":{"voiceline":"새로운 장난 도구야? 어디 보자~ ……응? 이, 이건 설마……? 뭐?! 나한테?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/propose.ogg"},"스킬":{"voiceline":"에헤헤, 엄청난 계획이 떠올랐어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/skill.ogg"},"터치1":{"voiceline":"아! 나한테 지금 이상한 거 붙였지! 어디 붙였는지 어서 말해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/touch.ogg"},"터치2":{"voiceline":"지휘관은 심술쟁이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/touch2.ogg"},"입수시":{"voiceline":"지휘관! 가장 똑똑한 창펑급 구축함 푸보가 왔어! 여기 되게 괜찮은 곳 같고, 내 장난……이 아니라 내… 음…… 영감이 막 떠올라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/unlock.ogg"},"강화성공":{"voiceline":"푸보는 대단……한 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에헤헤헤~ 역시 푸보는 똑똑하다니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"이 종이를 붙이고, 이런 식으로 그림을 그려두면…… 좋아! 정말 천재적인 아이디어야! …아! 지휘관, 그걸 만지면… 으아아아! 내 손에 붙어버렸잖아! 어, 어떻게 하지…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔어. 우리도 마중하러 나가자! ……아, 잠깐만. 지금 놀라게 해줄 도구를… 아, 그러면 안 돼? 알았어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/expedition_ex.ogg"},"사랑_ex":{"voiceline":"지휘관, 같이 케이크 먹자! 에헤헤, 이번에는 푸보가…… 으아아, 한입에 다 먹으면 안 돼! 사, 삼키기 전에 내가 그린 쪽지, 빨리 뱉어내!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"아! 나, 난 아무것도 안 했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"……어서 와! 파방! …응? 폭죽이 왜 안 터지지? 어째서… 으아아아?! 갑자기 솟아올랐어?! 까, 깜짝 놀랐네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"(……지휘관은 왜 아직도 날 칭찬하지 않는 거야! 서류도 정리했고, 서프라이즈도 해줬는데! ……어, 어라? 지휘관, 심각한 표정인데……)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"몰래 지휘관 뒤쪽으로 돌아가서… 그리고… 헉?! 왜 들킨 거지?! 게다가 어느새 지휘관 품에…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/touch_ex.ogg"},"터치2_ex":{"voiceline":"뭐, 뭐야?! 계획에 이런 건 없었잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['창펑'] : 언니, 나 간다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/couple_encourage1.ogg"},{"voiceline":"['페이윈'] : 에헷, 나중에 주방에 데려다 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관, 녹차라떼를 만들었어! 에헤헤, 장난치는 거 아니니까 안심하고 마셔! ……뭐?! 그렇게 별로야?! 그럼, 나도 한 모금……?! 쿨럭쿨럭쿨럭! 으, 으에엑… 방금 그 캔… 가루 와사비였나?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관이 업무에 집중하는 동안, 신발을 귀여운 인형 신발로 바꿔야지…… 아, 안 벗겨져...! 지휘관, 다리 좀 들어 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관! 다음 계획을 살펴보자! 이미 완벽하지만, 일단은 의견이나 들어볼게! …뭐? 잘 모르겠다니 무슨 소리야! 이게 지휘관이고, 이게 페이윈이고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501090/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":1},{"클뜯 id":501091,"클뜯 함순이 id":50109,"함순이 이름":"푸보","한글 함순이 + 스킨 이름":"잠재우기 힘든 짓궂은 파도","영문 함순이 + 스킨 이름":"Mischievous Tidings","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501091/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501091/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501091/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501091/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501091/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501091/shipyard.png","설명":"아. 역시 들켰네… 쉿! 내가 여기 있는 건 비밀로 해줘! 지휘관, 부탁이야!","자기소개":null,"메인1":{"voiceline":"어때? 이 야간용 망토, 멋있지! 그냥 멋있기만 한 게 아니라, 어둠 속에 몸을 감출 수 있어…! 조, 조명만 꺼준다면 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/main1.ogg"},"메인2":{"voiceline":"윽! 페이윈한테도 들킨 건가?! 대체 언제부터 들킨 거지… 잠깐, 페이윈! 조용히 해! …아. 창펑 언니의 발소리가 들려! 지휘관! 도와줘…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/main2.ogg"},"메인3":{"voiceline":"후훗, 내 계획이 궁금하다고? 그럼, 살짝 보여주지…… 음… 이건 주방에 잠입해서 소등 시간까지 기다리는 건데…… 그건 괴물이 아니라, 망토를 두른 나야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관, 아직 안 가고 뭐 해? 여기 있으면 눈에 띈다고… 그래! 그냥 나랑 같이 책상 밑에 숨어서, 춘절 맞이 장난…이 아니라! 봄맞이 서프라이즈에 참여하지 않을래?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/detail.ogg"},"드랍 설명":{"voiceline":"아… 역시 들켰네… 쉿! 내가 여기 있는 건 비밀로 해줘! 지휘관, 부탁이야!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어! 어서 마중하러 다녀와! 그동안 푸보는…… 아, 아무것도 아니야! 잘못 들은 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"괘, 괜찮아! 이런 상황일수록 임기응변으로 대처해야 해! 창펑 언니가 물어보면, 둘이서 숨바꼭질하고 있었다고 하자! 그러기로 한 거야! 약속!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/feeling5.ogg"},"터치3":{"voiceline":"지휘관 손에서 좋은 냄새가 나…… 뭐 훔쳐 먹었지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/headtouch.ogg"},"모항귀환":{"voiceline":"으아아… 지휘관, 여기 서 있으면 다들 몰려올 거야! 아무래도 예비용 계획으로 전환하는 수밖에 없겠어…… 자, 잠깐! 지금 발소리 못 들었어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"헉?! 이렇게 쉽게 지휘관한테 들키다니…?! 윽… 내 완벽한 계획이… 대체 어디부터 어긋난 거지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/login.ogg"},"실패":null,"우편":{"voiceline":"지휘관, 우편이…… 으아아아! 후우… 하마터면 넘어질 뻔했네. 누가 여기에 물을 뿌린 거야?! 아… 내가 그랬을지도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/mail.ogg"},"임무":{"voiceline":"지휘관! 어서 임무 처리하고 와! 목록은 책상 서랍에…… 헉? 어떻게 아무렇지 않게 꺼낸 거지?! 같이 넣어둔 풍선은…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/mission.ogg"},"임무완료":{"voiceline":"내가 도와준 덕분이지! 에헤헤~ …뭐가 그려져 있는 건지 전혀 이해할 수 없었다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"야간용 망토가 그렇게 마음에 들어? 그럼, 오늘 밤 계획이 성공하면 선물해 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/touch.ogg"},"터치2":{"voiceline":"으아아! 여기서 장난을 치면 어떻게 해! 끈이 잘 빠진단 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/touch2.ogg"},"입수시":{"voiceline":"아… 역시 들켰네… 쉿! 내가 여기 있는 건 비밀로 해줘! 지휘관, 부탁이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501091/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":71101,"상점 카테고리 id":3,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"한정 (2025/02/12)","진영":"ROC","레어도":"SR","ex_chat_status":0}]