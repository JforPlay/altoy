[{"클뜯 id":202220,"클뜯 함순이 id":20222,"함순이 이름":"컬루","한글 함순이 + 스킨 이름":"컬루","영문 함순이 + 스킨 이름":"Curlew","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202220/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202220/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202220/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202220/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202220/shipyard.png","설명":"세레스급 경순양함 - 컬루 (HMS Curlew) ","자기소개":{"voiceline":"세레스급 경순양함, 컬루라고 합니다. C급 경순양함, 말씀이십니까? 죄송합니다만, 그 호칭은 정확하지 않으므로 부르실 때는 되도록 사용하지 않으시길 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/profile.ogg"},"메인1":{"voiceline":"로열 네이비의 매너에는 인생의 철학이 숨겨져 있습니다. 부디 기억해주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/main1.ogg"},"메인2":{"voiceline":"제가 메이드의 귀감이라고요? ……언니인 퀴라소를 보신 적이 없으니 그런 찬사를 하신 것으로 생각됩니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/main2.ogg"},"메인3":{"voiceline":"예법이 개선되고 있군요. 하지만 주인님, 들떠서는 안 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/main3.ogg"},"전투개시":{"voiceline":"적에게 로열 메이드의 예법을 보여드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/battle.ogg"},"상세확인":{"voiceline":"언제, 어디에 있든 예법과 매너를 잊을 수는 없습니다. 메이드에게 있어서도 함선에게 있어서도 중요한 것이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/detail.ogg"},"드랍 설명":{"voiceline":"세레스급 경순양함 - 컬루 (HMS Curlew)","voicelink":null},"의뢰 완료":{"voiceline":"주인님, 의뢰가 완료되었습니다. 돌아온 분들의 마중을 나가시죠. …필요한 매너이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/expedition.ogg"},"실망":{"voiceline":"로열 네이비의 매너는 아무에게나 알맞은 것은 아닌 것 같군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/feeling1.ogg"},"낯섦":{"voiceline":"예법도 전투도, 신은 세세한 부분까지 깃듭니다. 주인님, 어떠한 때에도 덜렁대선 안 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/feeling2.ogg"},"호감":{"voiceline":"로열 네이비의 매너를 터득하는 것은 쉬운 일이 아닙니다. 저의 엄격함을 부디 용서해 주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/feeling3.ogg"},"기쁨":{"voiceline":"때와 장소에 따라 마시는 방법을 맞추는 것이 홍차의 매너입니다. 지, 지금 그것을 바라시는 겁니까…?? 아, 알겠습니다. 오랜만의 휴식이니, 그렇게까지 딱딱하게 굴지 않으셔도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/feeling4.ogg"},"사랑":{"voiceline":"주인님과 있으면 언니와의 나날이 떠오릅니다. 메이드로서의 소양과 마음가짐을 가르쳐준 소중한 언니…… 저는, 그녀와 같은 정도로 우수한 메이드가 되었을까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고하셨습니다. 오늘의 홍차는 이전의 다과회에서 주셨던 요청에 따라 준비했습니다. 맛있게 드십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/home.ogg"},"hp 경고":{"voiceline":"대, 대공 경보!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/hp_warning.ogg"},"로그인":{"voiceline":"어서 오십시오, 주인님. 넥타이가 비뚤어져 있습니다. 신사라면 외견에 흐트러짐이 있어선 안됩니다. 지금 바로잡아드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/login.ogg"},"실패":{"voiceline":"…자신을 다루는 게 아직 충분하지 않은 걸까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/lose.ogg"},"우편":{"voiceline":"주인님 앞으로 온 우편입니다. 확인하실 때에는 자리를 비워 드리겠사오니, 용무가 있으시다면 불러주시길 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/mail.ogg"},"임무":{"voiceline":"새로운 임무가 도착했습니다. 사람을 기다리게 하는 것은 실례에 해당하므로, 일찌감치 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었습니다. 기쁘시더라도 기품이 무너져선 안됩니다, 주인님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/mission_complete.ogg"},"서약":{"voiceline":"서약을 주고받은 이상, 제가 가르치기만 하는 것은 합당한 매너가 아니지요. 가르쳐 주셨으면 하는 것, 말씀입니까? 네, 알고 있습니다…… 주인님, 저에게 '사랑'을 가르쳐 주십시오……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/propose.ogg"},"스킬":{"voiceline":"그 비뚤어짐, 바로잡아 드리겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/skill.ogg"},"터치1":{"voiceline":"자신을 가지고 가슴을 편 당당한 몸가짐이야말로 타인의 경의를 받을 수 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/touch.ogg"},"터치2":{"voiceline":"읏……꺅!? 주인님… 무, 무엇을 하시는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/touch2.ogg"},"입수시":{"voiceline":"평안하시온지요. 로열 메이드대, 컬루가 착임했습니다. 주인의 예의범절을 바로잡는 것도 메이드의 책무인바, 주인님이 내면도 외면도 훌륭한 로열 네이비 신사가 될 수 있도록 서포트 하겠습니다. 주인님도 아무쪼록 정진해 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/unlock.ogg"},"강화성공":{"voiceline":"로열 메이드의 바람직한 모습에 또 한 발짝 가까워졌습니다. 주인님에게 감사의 말씀을 드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/upgrade.ogg"},"vote":null,"승리":{"voiceline":"세세한 부분에 정성을 들이면, 이기는 것도 당연하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202220/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":