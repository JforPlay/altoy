aw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499028/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"너에게서 뭘 받고 싶냐고? 아... 난 말이지, 세상에서 가장 아름다운 보물, 바로 지금의 너란다. 꼬마야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499028/detail.ogg"},"드랍 설명":{"voiceline":"아아... 정말 꿈만 같은 전개였다... 이 아름다운 악장을 영원히, 영원토록 함께 써 내려가자꾸나, 꼬마야?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"난 네 전부를 받아들이고 널 위해 앞을 가로막는 모든 걸 없애줄 것이다... 그러니까, 마음껏 내게 애교를 부리렴, 더, 더 많이... ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499028/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"보고는 급하지 않아, 우선 나에게 너를 좀 보게 해다오... 그래, 좋다, 별 이상은 없구나~ 그럼, 나에게 할 말이 있니?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499028/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘은 나의 어떤 연주를 듣고 싶니, 꼬마야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499028/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"아아, 진실한 사랑과 접촉하는 따뜻함을 갈망하니? 이리 오렴, 더 가까이 와도 된단다, 꼬마야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499028/touch.ogg"},"터치2":{"voiceline":"아아, 정말 뻔뻔한 꼬마로구나, 괜찮다. 난 너의 모든 것을 포용할 것이니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499028/touch2.ogg"},"입수시":{"voiceline":"아아... 정말 꿈만 같은 전개였다... 이 아름다운 악장을 영원히, 영원토록 함께 써 내려가자꾸나, 꼬마야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499028/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex