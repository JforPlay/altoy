갈 수도 없지. 그러니 쓸 수 있을 때 마음껏 쓰라는 거다. 널 기쁘게 할 수 있다면, 얼마를 쓰던 본전이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/main2.ogg"},"메인3":{"voiceline":"하하하! 포커나 치러갈까? 아, 걱정 마라. 패는 내가 돌릴 테니, 몇 판이든 이기게 해주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관? 무슨 일인가? 원하는 게 있으면 뭐든 사주마! 참, 날 상대로 뭘 망설이는 건가? 이 카드, 보이지? 마음껏 쓰라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/detail.ogg"},"드랍 설명":{"voiceline":"오, 드디어 왔군! 함께 부를 누리자고 했던 거, 기억하고 있나? 말뿐이면 실감이 안 날 것 같아서 이렇게 크루즈를 통째로 사들였지. 어때? 마음에 드나?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔군. 어서 마중하러 가라! …응? 나랑 같이 가고 싶다고? 그럼, 바로 출발이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"여어, 지휘관. 내가 사들인 크루즈선에서의 사치 삼매경은 만족스러운가? 하하하, 그리 대단한 것도 아닌데 뭘. 앞으로도 갖고 싶은 게 있거나, 널 바보 취급한 녀석을 혼내주고 싶으면 언제든 말하라고! 우린 누구보다도 서로 \"특별\"한 사이잖은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔군. 그렇게 기쁜 표정을 다 짓고, 무슨 좋은 일이라도 있었나? 아, 마음에 드는 게 있으면 뭐든 말해봐라. 다 사줄 테니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"왔군. 얼마나 기다렸는지 아는가! 기다리느라 지루하진 않았냐고? 당연히 아니지! 어떻게 널 \"요리\"할까 고민하고 있었다. 아하하하, 농담이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새로운 임무가 있다고? 지금 딱 좋을 때인데…… 아니, 임무 처리라면 나도 도와주마. 어서 해치우자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/mission.ogg"},"임무완료":{"voiceline":"임무를 완수했다고? 역시 대단하군! 그럼 좀 쉬고 한 판 더 뛸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"단추가 풀렸다고? 그게 뭐 대수인가? …그렇게 신경 쓰이면 직접 채워주겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/touch.ogg"},"터치2":{"voiceline":"오호라, 백주대낮에 아주 대담하군. 내게 \"요리\" 당하고 싶은 건가~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/touch2.ogg"},"입수시":{"voiceline":"오, 드디어 왔군! 함께 부를 누리자고 했던 거, 기억하고 있나? 말뿐이면 실감이 안 날 것 같아서 이렇게 크루즈를 통째로 사들였지. 어때? 마음에 드나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/unlock.ogg"},"강화성공":{"voiceline":"하하하, 네가 기쁘면 그걸로 됐다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"겨우 이 정도인가? 다음에는 더 강한 녀석을 불러와라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599012/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"수영복","상점 id":71004,"상점 카테고리 id":6,"스킨 태그":"쁘띠모션, 배경","입수 영상":"X","재화":980,"기간":"한정 (2025/06/25)","진영":"ROC","레어도":"SSR","ex_chat_status":0},{"클뜯 id":599018,"클뜯 함순이 id":59901,"함순이 이름":"하얼빈","한글 함순이 + 스킨 이름":"페오니아 레드","영문 함순이 + 스킨 이름":"Red Paeonia","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599018/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599018/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599018/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599018/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599018/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599018/shipyard.png","설명":"지휘관, 기다리게 했군. 이 모습, 어떤가? 조금 부끄럽긴 하지만… 뭐, 네가 어울린다고 하니까 됐다.","자기소개":null,"메인1":{"voiceline":"정열적인 사랑도 시간이 흐르면 점점 차분해질지도 모른다만… 아니아니, 그건 안 될 말이지! 지휘관! 다음 기념일은 떠들썩하게 보내자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/main1.ogg"},"메인2":{"voiceline":"칼의 숲도 불바다도 함께 넘자고 약속했지만, 널 무리하게 하고 싶지는 않고, 다칠까 봐 걱정돼서… 으음, 감정이란 건 참 모순투성이로군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/main2.ogg"},"메인3":{"voiceline":"뭐 먹고 싶은 건 없나? 내일 제일 좋은 레스토랑에 데려가 주마! 명색이 나 하얼빈의 연인인데 식사로 푸대접받을 순 없는 노릇이지! 하하핫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/main3.ogg"},"전투개시":{"voiceline":"내가 선두에 서마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/battle.ogg"},"상세확인":{"voiceline":"그나저나 지금 난 평소랑 뭐가 다른 것 같나? 더 여자답다든가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 기다리게 했군. 이 모습, 어떤가? 조금 부끄럽긴 하지만… 뭐, 네가 어울린다고 하니까 됐다.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 동료들이 돌아왔군! 어디 보자… 좋아! 이걸로 좋은 안주를 마련할 수 있겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"「데이트」인지 뭔지가 관계를 더욱 진전시켜 준다던데… 이렇게 하지. 네가 맘에 드는 레스토랑을 고르고, 내가 그걸 통째로 빌려서 같이 마음껏 먹고 마시는 건 어떤가? …좀 다르다고? 나, 뭔가 잘못 이해한 건가? 소설 같은 것도 참고했는데 말이다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"이렇게 흠뻑 젖은 모습을 보면 당연히 걱정하지. 어서 따뜻한 물로 샤워하다 와라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘 업무를 시작하는 건가? 어려운 일이 있으면 숨기지 말고 말하라고. 우린 가족이나 다름없으니 무슨 짐이든 같이 짊어자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/login.ogg"},"실패":{"voiceline":"윽, 여기서 당해도 내 동료들에게는 손가락 하나 못 댄다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/lose.ogg"},"우편":null,"임무":{"voiceline":"새 임무다. 그냥 몸 풀기라고 생각하면 어떤가? 매일 데스크 업무만 보다 보면 녹이 슬 거라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/mission.ogg"},"임무완료":{"voiceline":"임무 완료다. 나랑 지휘관은 호흡이 잘 맞는군. 이 기세로 보상까지 확인하자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"내가 여기 있어 주길 바란다면, 아무 데도 가지 않으마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/touch.ogg"},"터치2":{"voiceline":"오? 그렇게 적극적으로 나오면 나도 사양 않겠다만?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/touch2.ogg"},"입수시":{"voiceline":"지휘관, 기다리게 했군. 이 모습, 어떤가? 조금 부끄럽긴 하지만… 뭐, 네가 어울린다고 하니까 됐다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"압도적 승리! 이거, 돌아가면 바로 축하 연회를 열어야겠군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599018/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_e