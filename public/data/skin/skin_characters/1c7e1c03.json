[{"클뜯 id":599010,"클뜯 함순이 id":59901,"함순이 이름":"하얼빈","한글 함순이 + 스킨 이름":"하얼빈","영문 함순이 + 스킨 이름":"Harbin","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599010/shipyard.png","설명":"경순양함 - 하얼빈","자기소개":{"voiceline":"이스트 글림 소속 경순양함, 하얼빈이다. 왜지? 내가 여기 있는 게 놀라운가? 하하하, 인생에는 놀라움과 기쁨이 따르는 법이지. 어쨌든, 나와 내 함포 모두 실망스럽지 않을 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/profile.ogg"},"메인1":{"voiceline":"지휘관, 일 끝나면 잠깐 술이라도 한잔 어떤가? 물론, 술이 아니어도 괜찮다. 오늘 하루 수고한 자신을 위로해줘야지. 안 그런가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/main1.ogg"},"메인2":{"voiceline":"\"음식에는 정성을 아끼지 말고, 회에는 정교함을 아끼지 말라.\" …하이티엔 녀석은 늘 저렇게 깐깐하게 말하지만, 정작 자신은 고춧가루를 넣을 때 심하다 싶을 정도로 들이 붓지…. 자고로 밥이라면 배부르게 먹을 수 있는지 없는지, 그것이 내겐 가장 중요하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/main2.ogg"},"메인3":{"voiceline":"계략을 세운 다음에 움직이고, 착수 전에는 몇 번이고 고민을 거듭하는 게 젠하이라고 하면… 나는 뭐, 그 정반대랄까? 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/main3.ogg"},"전투개시":{"voiceline":"내 뒤를 따르라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/battle.ogg"},"상세확인":{"voiceline":"지휘관, 괜히 마음 쓰지 말고 무슨 일 있으면 솔직히 말해줘. 빙빙 돌려 말하는 건 사양이라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/detail.ogg"},"드랍 설명":{"voiceline":"경순양함 - 하얼빈","voicelink":null},"의뢰 완료":{"voiceline":"오, 아무래도 동료들이 원정에서 돌아온 것 같군! 지휘관, 노고를 치하하는 자리라도 마련해 주라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/expedition.ogg"},"실망":{"voiceline":"병졸이 기진맥진하면 그 병졸 하나로 끝나지만, 장수가 기진맥진하면 전군이 끝을 맞이하고 만다. 너도 지휘관이니 정신 차려라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/feeling1.ogg"},"낯섦":{"voiceline":"심심하면 나와 잡담이라도 나누는 건 어떤가? 하하, 뭘 부끄러워 하고 그러나. 대화라는 건 속을 터놓고 하는 거다. 자, 상대와 가까워 지려면, 이렇게 머리를 맞대고 하루종일 느긋하게 이야기를 나누는게 제일이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/feeling2.ogg"},"호감":{"voiceline":"휴일은 어떻게 보내는가? 나는… 동료들을 데리고 기분 전환하고, 겸사겸사 술에 안주도 좀 걸치곤 하지. 속이 후련해져서 기분이 좋아진다고! 그래! 모처럼이니 바로 실행에 옮기자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 지금부터 외출이다! 어디로라니, 글쎄… 적이라도 찾아서 한방 먹여주러 가는 건 어떤가? 응? 위험하지 않냐고? 내가 곁에 있으니 걱정하지 마라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 이제 슬슬 내것이 되는 건 어떤가? 바늘로 뒤덮인 산이건 불바다건 함께 돌진해서, 이득도 보고 손해도 보고… 위기가 닥칠 때는 물론 내가 구해주마. 파란만장한 연애란 바로 이런걸 두고 말하는 게 아니겠나? 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"계속 정신없이 바빠서 지쳤지? 나중에 한숨도 돌릴겸 어디라도 데려다 줄까? 목욕탕에서 등을 씻어주거나, 마사지를 해주거나… 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/home.ogg"},"hp 경고":{"voiceline":"자신 있으면 내게 덤벼라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이다, 지휘관. 오늘 내가 도와줄 건 없나? 그렇게 마음 쓸 거 없으니까, 뭐든 말해봐라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/login.ogg"},"실패":{"voiceline":"여긴 내게 맡기고 어서 도망쳐라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/lose.ogg"},"우편":{"voiceline":"겸사겸사 우편을 가지고 왔다. 어서 확인해봐라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/mail.ogg"},"임무":{"voiceline":"새로운 임무인가? 내게 맡겨라. 지금 확실하게 준비해 줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/mission.ogg"},"임무완료":{"voiceline":"잘 해냈군~! 보상 분배는 내게 맡기고, 넌 그만 쉬고 와라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/mission_complete.ogg"},"서약":{"voiceline":"결심을 굳힌 모양이군. 그렇지만, 장소가 조금 아쉽군…. 다음에는 길한 날을 골라서, 동료들을 모두 초대해서 축하연을 열자고. 이 하얼빈의 짝이 너라고 모두에게 소개시켜줘야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/propose.ogg"},"스킬":{"voiceline":"이거나 먹어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/skill.ogg"},"터치1":{"voiceline":"너무 심심해서 못 참겠으면, 내 장기인 만담이라도 보여줄까? 하하하하, 전투 말고도 그럭저럭 장기를 가지고 있는 편이거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/touch.ogg"},"터치2":{"voiceline":"오호? 배짱이 두둑한데? 얻어 터질 각오는 됐나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/touch2.ogg"},"입수시":{"voiceline":"이스트 글림의 경순양함, 하얼빈이다. 당신이 이곳의 지휘관인가? 흠… 건강하고 발랄하고, 체격도 좋군…. 훌륭해! 앞으로는 내가 돌봐주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/unlock.ogg"},"강화성공":{"voiceline":"하하하, 좀 몸이 근질근질해지기 시작했는걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥, 너무 약하군. 내 등목 역할로도 못 쓰겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/win_mvp.ogg"},"전투개시_ex":{"voiceline":"내가 앞장서마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관, 업무가 잘 진척되지 않을 것 같아서, 여기… 술을 좀 가지고 왔다. 고민거리가 있으면 담아두지 말고, 후련하게 내게 털어놓아 봐라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰로 떠난 동료들이 돌아왔다! 어디 보자… 좋아! 이거면 괜찮은 간식을 대접할 수 있을 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/expedition_ex.ogg"},"사랑_ex":{"voiceline":"'데이트'라는 게 관계를 크게 진척시키기에 좋다고 해서 말이지…. 이렇게 하자. 네가 맘에 드는 식당을 고르고, 내가 그곳을 통째로 빌려서 같이 고삐 풀고 먹고 마시는 건 어떤가? …아니라고? 나, 뭘 잘못 이해한 건가? 소설같은 것도 참고했는데 말이다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"수고했다. 네가 자주 가는 가게, 미리 통째로 빌려뒀으니까 회고가 끝나면 같이 가자고. 아, 아니면 우선은 목욕부터 하고 상쾌한 상태로 가도 되나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"좋은 아침이다, 지휘관. 밥은 잘 먹고 다니는가? 음? 뭘 그렇게 팔을 철썩 붙이냐고? 별 거 아니잖은가? 우리 사이에 뭘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/login_ex.ogg"},"실패_ex":{"voiceline":"크윽, 여기서 당해도 동료들에게는 손가락 하나 대지 못하게 할 테다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/lose_ex.ogg"},"우편_ex":null,"임무_ex":{"voiceline":"새로운 임무다. 한숨 돌릴 겸, 한 세트 같이 어떤가? 너도 책상에서 업무만 보면 몸에 녹이 슬 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 완료로군. 나랑 지휘관은 합이 잘 맞는단 말이지. 이 기세로 보상 확인까지 끝내자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"내게도 널 사로잡을 수 있는 구석이 있다는 건가? 하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"압도적 승리! 이거, 돌아가면 축하연을 열어야겠는걸?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"얼마 전, 사르데냐 엠파이어의 숙소를 견학했는데, 엄청난 넓이의 대욕탕이 있더군…. 게다가 초대까지 받아서 같이 들어가봤는데… 이거 참 기가 막히던데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/main5_ex.ogg"},"메인6_ex":{"voiceline":"너도 나처럼 의장을 장비할 수 있었다면, 함께 적진에 뛰어들 수 있었을텐데…. 뭐, 지금은 무방비 상태니, 얌전히 내 보호를 받도록 하라고. 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"모항에는 술을 잘 마시는 녀석들이 많다고 들었다만, 소문대로더군…. 지휘관, 이번 술모임에는 꼭 참여해야 한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599010/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SSR","ex_chat_status":1},{"클뜯 id":599011,"클뜯 함순이 id":59901,"함순이 이름":"하얼빈","한글 함순이 + 스킨 이름":"분방한 수천일색","영문 함순이 + 스킨 이름":"Union Between Sea and Sky","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/599011/shipyard.png","설명":"휴우… 좋은 날씨에, 기분 좋은 바닷바람. 지휘관, 모처럼 여기 왔으니 지금은 집무실이나 서류는 모두 잊어버리는 게 어떤가? 바다를 만끽하고 오라고!","자기소개":null,"메인1":{"voiceline":"저기 있는 건 '사천왕'인가? …아무래도 모래성을 다같이 만들고 있는 모양이다만……. 우리도 만들어 보는 건 어떠한가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/main1.ogg"},"메인2":{"voiceline":"감자튀김을 손 위에 올려 두면, 갈매기들이 그걸 노리고 앞다퉈 날아든다고 한다. 그러고 보니 마침 감자튀김이 있지 않은가? 시험 삼아 해보지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/main2.ogg"},"메인3":{"voiceline":"해변을 전세내서 너와 단둘이 있는 건… 응? 다른 동료들이 눈치챌 거라고? 그렇군… 너도 참 힘들겠구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"괜찮다. 보고 싶다면 정정당당하게 봐라! 게다가 이 수영복 차림은 지휘관, 너에게 보여주려고 준비한 거니까 말이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/detail.ogg"},"드랍 설명":{"voiceline":"휴우… 좋은 날씨에, 기분 좋은 바닷바람. 지휘관, 모처럼 여기 왔으니 지금은 집무실이나 서류는 모두 잊어버리는 게 어떤가? 바다를 만끽하고 오라고!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아온 모양이군. 다들 불러오는 건 어떤가? 사람이 많은 편이 떠들썩해서 더 즐겁겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"탕에 몸을 담그면 기지개를 켜고 싶어지고, 바다에 들어가면 헤엄치고 싶어지지…. 사람은 장소가 바뀌면 마음도 움직이는 법이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 녀석! 나를 이렇게 기다리게 하다니, 간이 크구나. …하하하! 농담이다! 왔으니까 됐다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"임무 보상인가…. 오, 시원한 수박도 있는 건가?! 마침 더위를 식힐만한 걸 생각하고 있던 참인데, '때맞춰 내리는 단비'란 이런 걸 말하는 거겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"오, 물놀이를 하고 싶은 건가? 봐주진 않으마! 받아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/599011/touch.ogg"},"터치2":{"voiceline":"너… 이런 백주 대낮에 그렇게 당당히…… 좀 아닌 것 같군…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voicel