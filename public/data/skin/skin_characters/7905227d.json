[{"클뜯 id":203030,"클뜯 함순이 id":20303,"함순이 이름":"켄트","한글 함순이 + 스킨 이름":"켄트","영문 함순이 + 스킨 이름":"Kent","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203030/shipyard.png","설명":"켄트급 중순양함·켄트 (HMS Kent)","자기소개":{"voiceline":"나는 카운티급 순양함이면서 켄트급의 네임쉽이기도 해! 굉장하지? 장갑 같은 건 노력과 근성으로 보충할 수 있잖아! 엣, 안 돼!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/profile.ogg"},"메인1":{"voiceline":"끄앗! 큰일 났다! 타이거가 없단 걸 잊어버렸어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/main1.ogg"},"메인2":{"voiceline":"지휘관, 켄트 선수와 시합하지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/main2.ogg"},"메인3":{"voiceline":"켄트, 이스트 글림의 사람을 본 적 있어~ 그 애들, 엄청나게 노력했겠지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/main3.ogg"},"전투개시":{"voiceline":"Huh, 적에게 이쪽의 힘을 보여주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/battle.ogg"},"상세확인":{"voiceline":"Errr, 내 장갑과 화력은 무시해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/detail.ogg"},"드랍 설명":{"voiceline":"켄트급 중순양함·켄트 (HMS Kent)","voicelink":null},"의뢰 완료":{"voiceline":"Good! 의뢰팀은 무사히 돌아왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/expedition.ogg"},"실망":{"voiceline":"Disappointed…… 지휘관과 켄트 선수, 별로 안 맞는 걸지도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 게임 안 할래? …응? 말버릇? 그건 대충 붙이고 있는 거라 언제든 바꿀 수 있어! 그것보다 게임 하자! 게임!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/feeling2.ogg"},"호감":{"voiceline":"Hey, 지휘관! 아, 괜찮아 괜찮아 그쪽에 집중해도 돼~ 나, 지휘관을 보고 있기만 해도 즐거우니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/feeling3.ogg"},"기쁨":{"voiceline":"(빤히──)아, 아무것도 아냐! 아무것도 아냐! 그게, 그러고 보니 어째서 지휘관은 저렇게 근사할까~ 켄트 선수, 종일 바라보고 있어도 질리지 않는걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/feeling4.ogg"},"사랑":{"voiceline":"지휘관 지휘관, 장갑이 얇은 켄트 선수가 옷을 몇 겹 입었는지 맞혀봐~ 맞추면 포상이 있다구! 못 맞춰도 확인해보는 거… 된다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"Welcome! 나는 아직 멀쩡해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"Yo! 지휘관, 함께 콰쾅 해버리자?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/login.ogg"},"실패":{"voiceline":"Ouch…… 켄트 선수, 져 버리고 말았어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/lose.ogg"},"우편":{"voiceline":"Caution! 새로운 편지로 만든 종이비행기, 급속 접근!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/mail.ogg"},"임무":{"voiceline":"Hmmm, 새로운 미션, 해버려?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/mission.ogg"},"임무완료":{"voiceline":"Wow! 미션 보너스! 빨리 열어보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/mission_complete.ogg"},"서약":{"voiceline":"아…… 와아! 지휘관 고마워~이렇게 소중한 건 어딘가에서 없어지지 않게 안전한 장소에 보관하지 않으면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/propose.ogg"},"스킬":{"voiceline":"켄트 선수, 라스트스퍼트!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/skill.ogg"},"터치1":{"voiceline":"Yahoo! 지휘관, 놀자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/touch.ogg"},"터치2":{"voiceline":"Oh…… 지휘관 개변태……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/touch2.ogg"},"입수시":{"voiceline":"Hey! 지휘관, 켄트야! 최근 어때? 좋든 나쁘든 이 켄트가 온 이상 좋아질 거라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/unlock.ogg"},"강화성공":{"voiceline":"Woah! 켄트 선수, 강해져 버렸다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"Yeah! 켄트 선수, 일등!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0}]