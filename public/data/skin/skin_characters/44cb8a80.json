[{"클뜯 id":401280,"클뜯 함순이 id":40128,"함순이 이름":"Z28","한글 함순이 + 스킨 이름":"Z28","영문 함순이 + 스킨 이름":"Z28","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401280/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401280/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401280/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401280/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401280/shipyard.png","설명":"1936 A “나르비크”형 구축함—Z28","자기소개":{"voiceline":"저는 항로 안내 구축함이기 때문에, 무기는 자매들에 비해 조금 떨어져요. 이건 제가 직접적인 방법보다는 다른 방식으로 문제를 해결하길 더 선호하는 이유이기도 하죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/profile.ogg"},"메인1":{"voiceline":"귀여운 동물들이랑 하루 종일 놀고 싶어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/main1.ogg"},"메인2":{"voiceline":"큰 사무실은, 텅 비었지만 차분한 분위기를 자아내며, 더욱 집중할 수 있게 해줘요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/main2.ogg"},"메인3":{"voiceline":"이 서류를 제때 처리하신다면, 지휘관님께 맛있는 간식을 준비해드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/main3.ogg"},"전투개시":{"voiceline":"모두 저를 따라오세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 제 어뢰를 보여드릴게요~ 제가 다양한 표정들을 그려놓았어요, 귀엽죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 안녕하세요! 저는 1936 A형 구축함 중앙에 위치한 Z28입니다! 지휘관님의 업무를 전력 지원하는게 바로 저의 임무입니다!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 끝났어요~ 지휘관님, 일 보세요, 제가 의뢰조를 맞이하러 갈게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/expedition.ogg"},"실망":{"voiceline":"지휘관이 잘못을 시정하고 다시 사람들이 수용하기 전까지는 제가 돌봐줄게요. 그러니까 자신감을 잃지마세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/feeling1.ogg"},"낯섦":{"voiceline":"전 항상 궁금했어요. 나무 위에서 재잘거리는 새들은 무슨 재미있는 이야기를 하고 있을까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/feeling2.ogg"},"호감":{"voiceline":"휴가를 내고 쉬신다고요? 좋아요, 이유는 제가 대신 생각할게요. 하지만, 지휘관님의 업무는 제가 도와드릴 수 없을 것 같아요... 나중에 꼭 마무리하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/feeling3.ogg"},"기쁨":{"voiceline":"오늘 업무도 원만히 끝내셨나요? 음, 그럼 지휘관님께 보상으로 포옹을 드릴게요! 최고 최고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 피곤하세요? 그럼, 제 무릎을 베고 좋은 꿈과 함께 피로와 번뇌를 조금씩 조금씩 잊어주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/feeling5.ogg"},"터치3":{"voiceline":"헤헤, 저도 이렇게 지휘관님을 쓰담쓰담~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님 수고했어요! 이건 안전 회항의 포옹~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/home.ogg"},"hp 경고":{"voiceline":"적이 꽤 강합니다, 모두 조심하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/hp_warning.ogg"},"로그인":{"voiceline":"음... 지휘관님, 분명 무슨 이유가 있어서 지각하신 거죠? 하지만 괜찮아요, 지금부터 힘내서 업무를 시작하자구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/login.ogg"},"실패":{"voiceline":"지휘관님, 저희 모두 안전하게 퇴각했어요, 상심하지 마세요~ 다음엔 반드시 이길 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/lose.ogg"},"우편":{"voiceline":"새들이 편지를 가져왔어요. 제가 읽어드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/mail.ogg"},"임무":{"voiceline":"새로운 임무요...? 지휘냥 데리고 노는 임무 같은 건 없나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/mission.ogg"},"임무완료":{"voiceline":"임무를 완벽하게 마쳤어요! 이건 추가 보상으로 드리는 포옹이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/mission_complete.ogg"},"서약":{"voiceline":"지휘관님에게 이걸 받을 거라곤 생각해본 적 없는데... 정말 너무 기뻐요! 앞으로도, 저에게 마음껏 지휘관님의 심정을 털어놓으세요. 제가 다 받아 줄게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/propose.ogg"},"스킬":{"voiceline":"총 공격! 헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/skill.ogg"},"터치1":{"voiceline":"주무세요~ 쉬고 나서 다시 일해도 괜찮아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/touch.ogg"},"터치2":{"voiceline":"이런 짓을 하면 여자 아이들한테 미움 받을 텐데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 안녕하세요! 저는 1936 A형 구축함 중앙에 위치한 Z28입니다! 지휘관님의 업무를 전력 지원하는게 바로 저의 임무입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/unlock.ogg"},"강화성공":{"voiceline":"음, 함장이 더 귀엽게 변했으면 좋을텐데...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다, 이겼다! 지휘관님 최고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['Z23'] : z23 언니, 지휘관님한테 너무 엄격하게 굴지마~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401280/couple_encourage1.ogg"},{"voiceline":"['Z24'] : z24 언니가 하는 말은 