 모두 사라질 거예요. 동물들도 먹을 걸 노리고 있는 거 같고….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401282/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"잘 오셨어요, 지휘관님. 파티는 이제 막 시작한 참이니, 마음껏 즐기고 가세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401282/login.ogg"},"실패":null,"우편":{"voiceline":"어라? 작은 새 씨가 편지를 물어다 준 거 같아요. 어서 열어봐요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401282/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"동물들이 아니라 절 쓰다듬어주고 싶으시다구요? 상관 없어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401282/touch.ogg"},"터치2":null,"입수시":{"voiceline":"지휘관님도 건배~! 어쩌다 달콤한 향기에 이끌려 동물들 틈에 섞이고 말았지만, 다들 얌전하고 착해서 쓰담쓰담 해주고 있어요. 지휘관님도 쓰담쓰담 해드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401282/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70753,"상점 카테고리 id":7,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"KMS","레어도":"SR","ex_chat_status":0}]