rcontent.com/Fernando2603/AzurLane/main/audio/voiceline/401281/main2.ogg"},"메인3":{"voiceline":"신년 찹쌀 경단! 지휘관님, 드실래요? ... 그럼, 입 벌리세요! 아——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401281/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"신사에 가서 축복을 먼저 할까요, 아니면 동료들이랑 하네츠키를 먼저 할까요... 으음, 신년에 하고 싶은 일이 너무너무 많아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401281/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 해피 뉴 이어! 신년 명절 때 하고 싶은 일이 있으신가요? 그럼 바로 지금, 단숨에 전부 실현시켜요!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"제가 이 달마 오뚝이들을 귀여운 표정으로 바꿔줄게요! 음... 붓, 붓 어디있지...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401281/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 오셨군요! 코타츠 안에 있는줄 알았네요, 헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401281/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지치셨나요? 그럼 좀 쉬시죠! 새로운 컨텐츠가 생기면 제가 깨워드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401281/touch.ogg"},"터치2":{"voiceline":"저랑 약속해요. 다음부터 이러지 않겠다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401281/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 해피 뉴 이어! 신년 명절 때 하고 싶은 일이 있으신가요? 그럼 바로 지금, 단숨에 전부 실현시켜요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401281/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메