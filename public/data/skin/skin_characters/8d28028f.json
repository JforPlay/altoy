[{"클뜯 id":9600020,"클뜯 함순이 id":960002,"함순이 이름":"상 마르티뉴","한글 함순이 + 스킨 이름":"상 마르티뉴","영문 함순이 + 스킨 이름":"São Martinho","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600020/shipyard.png","설명":"범선 - 상 마르티뉴","자기소개":{"voiceline":"황금은 가장 웅장한 궁전으로, 전력은 가장 웅장한 시집으로… 무적함대는 찬란한 황금빛 영광을 받으며, 지금도 원정을 계속하고 있다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/profile.ogg"},"메인1":{"voiceline":"내 날개… 찬란한 황금빛이 내려준 성스러운 기적이지. 만져보고 싶은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/main1.ogg"},"메인2":{"voiceline":"무적의 템페스타가 읊는 시를 듣고 싶은가? 그렇다면 때를 기다려라. 증오스러운 적과의 전투가 시작되면 자연스레 돛에서 울려 퍼질 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/main2.ogg"},"메인3":{"voiceline":"함대의 보급… 특별히 식료품 보급에 신경을 쓰도록 해라. 음… 내가 실제로 겪은 바에 따른 결론이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/main3.ogg"},"전투개시":{"voiceline":"우리의 원수를 향해 파멸의 곡조를 노래하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/battle.ogg"},"상세확인":{"voiceline":"그 무적함대의 광휘는 이 상 마르티뉴가 계승했다. 같이 함대를 이끄는 존재로서 지휘관은 내가 짊어진 것이 무엇인지 이해하겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 상 마르티뉴","voicelink":null},"의뢰 완료":{"voiceline":"원정 함대가 귀환했고, 보물도 있어야 할 곳으로 돌아왔다고 하는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/expedition.ogg"},"실망":{"voiceline":"같은 함대를 이끄는 존재로서 기대하고 있었다만… 이 상 마르티뉴가 사람을 잘못 보는 날이 오다니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 출정길에서는 나를 확실히 따라왔으면 한다. 찬란한 황금빛이 우리를 지켜줄 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/feeling2.ogg"},"호감":{"voiceline":"출정을 떠날 때마다 이렇게 승리와 평안을 위해 기도를 드리지. 지휘관, 너를 위해서도 기도하마. 찬란한 황금빛의 비호가 함께 하기를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/feeling3.ogg"},"기쁨":{"voiceline":"폭풍이 오는군. 지휘관, 내 날개 밑에서 비를 피해라. 음……? 너무 가깝다고? 따뜻하다고? 그야 바싹 붙어있으니 당연한 것 아닌가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 조용한 정박지를 발견했다. 단둘이서…… 보물을 있어야 할 곳으로 되돌려 놓지 않겠는가? 아, 아니… 사실은 그저 너와 함께 있고 싶을 뿐이다만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 돌아왔으니 우선은 몸 점검부터…… 팔다리 모두 이상 없고… 어디 빠진 부분은 없는 듯하군. 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/home.ogg"},"hp 경고":{"voiceline":"이 정도로는…… 아직 멀었다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘은 또 어떤 위대한 출정을 시작할까…… 우선은 눈앞에 있는 업무부터……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/login.ogg"},"실패":{"voiceline":"권토중래를 기할 수밖에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/lose.ogg"},"우편":{"voiceline":"새 우편? 흠… 역시 지휘관이 직접 확인하는 편이 좋겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/mail.ogg"},"임무":{"voiceline":"새로운 임무? 음… 출정 나가기 전에 선체 점검과 보수는 잊지 말아라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/mission.ogg"},"임무완료":{"voiceline":"임무 보상… 우리의 대출정으로 소모된 전비에 상응하는 것이면 좋으련만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/mission_complete.ogg"},"서약":{"voiceline":"찬란한 황금빛에 걸고 우리의 맹세를 나누자. 상 마르티뉴의 창은 지휘관을 위해 적을 찌르고, 상 마르티뉴의 날개는 지휘관을 지키고, 만일의 경우에는 부러짐도 불사할 것임을……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/propose.ogg"},"스킬":{"voiceline":"무적함대, 내 명령을 따르라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/skill.ogg"},"터치1":{"voiceline":"점검해 주는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/touch.ogg"},"터치2":{"voiceline":"이 미열은 대체……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/touch2.ogg"},"입수시":{"voiceline":"무적함대의 기함으로 찬란한 황금빛을 잇는 자, 무적의 템페스타 '상 마르티뉴'다. 지휘관, 다음 대출정은 어디로 떠날 예정이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/unlock.ogg"},"강화성공":{"voiceline":"Gracias.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"빛나는 황금빛이 승리의 항로에 뿌려지리라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"어서 와. 그럼 평소처럼 신체검사를…… 좋아, 이상은 없는 듯하군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"드디어 나타났군. 찬란한 황금빛을 몸에 두르고… 어, 어서 오라고 말하고 싶었던 것뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600020/login_ex.ogg"},"실패_ex":{"voiceline":"네 앞이라면