[{"클뜯 id":202300,"클뜯 함순이 id":20230,"함순이 이름":"카리브디스","한글 함순이 + 스킨 이름":"카리브디스","영문 함순이 + 스킨 이름":"Charybdis","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202300/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202300/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202300/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202300/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202300/shipyard.png","설명":"다이도급 경순양함—카리브디스","자기소개":{"voiceline":"다이도급 경순양함 카리브디스입니다. 그 대전쟁에서는 \"어디서든, 무엇이든\"을 모토로 삼고 다양한 바다에서 활약했습니다. 주인님, 언제든, 어디서든, 무엇이든, 필요한 게 있으시면 제게 말씀해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/profile.ogg"},"메인1":{"voiceline":"부디 안전하고 쾌적한 항해를……. 주인님, 다음 출격에도 절 꼭 데려가 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/main1.ogg"},"메인2":{"voiceline":"지금 맡길 업무는 없으시다구요……? 그, 그럴 수가…… 주인님…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/main2.ogg"},"메인3":{"voiceline":"주인님~ 혹시 괜찮으시면 이걸로 갈아입으시고…… 아, 서류가 안 보인다구요……? 흐흑, 죄송합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/main3.ogg"},"전투개시":{"voiceline":"대공전 준비 완료! 주인님, 물러나 계세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/battle.ogg"},"상세확인":{"voiceline":"주인님, 혹시 외출할 때에 걸칠 옷 같은 거 새로 필요하지 않으신가요? ……만약 그러시다면 제게 맡겨 주세요! 재봉은…… 제 특기랍니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/detail.ogg"},"드랍 설명":{"voiceline":"다이도급 경순양함—카리브디스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었습니다. 주인님, 성과가 기대되네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/expedition.ogg"},"실망":{"voiceline":"주, 주인님…… 설마 저희를 버리시려는 건가요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/feeling1.ogg"},"낯섦":{"voiceline":"♪~ 주인님의 메이드로서 언제 어디서든 늘 봉사해드릴게요~ ……가끔은 좀 민폐라니, 그럴 수가…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/feeling2.ogg"},"호감":{"voiceline":"분명 \"언제 어디서든\"이라는 건 조금 과했을지도 모르겠네요……. 주인님이 언제 부르셔도 봉사할 수 있었으면 해서……. 죄송합니다…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/feeling3.ogg"},"기쁨":{"voiceline":"계속 그렇게 응석을 받아주니 무능한 폐인이 될 것 같다구요? 주인님을 폐인으로 만들어버릴 수도 있다니, 제가 그렇게 대단한가요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/feeling4.ogg"},"사랑":{"voiceline":"저, 절도 있게 주인님을 폐인으로……가 아니라! 주인님의 피로만 풀어드리는 거였죠~ 알겠습니다. 주의할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 오세요, 주인님! 과로는 건강에 안 좋으니, 우선은 푹 쉬세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/home.ogg"},"hp 경고":{"voiceline":"저, 적은 어디에??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침입니다, 주인님. 지금부터 업무를 시작하시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/login.ogg"},"실패":{"voiceline":"구조를 서둘러 주세요! 주인님! 동료들은 제게 맡기고 어서 피신하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/lose.ogg"},"우편":{"voiceline":"우편을 전해드리러 왔습니다, 주인님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/mail.ogg"},"임무":{"voiceline":"주인님, 새로운 임무가 왔어요. 이, 이미 알고 계셨다구요……? 흐흑…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/mission.ogg"},"임무완료":{"voiceline":"보상이 왔습니다. 주인님, 확인 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/mission_complete.ogg"},"서약":{"voiceline":"이건…… 주인님? 여, 역시 그냥 피로만 풀어드리는 걸로는 부족했던 건가요?! 하아……. 딱히 이런 반지같은 거 없어도……. 아! 설마 이거, 주인님의 피로를 더~ 더~ 풀어드려도 된다는 허가인가요? 우후훗, 사랑스러운 나의 주인님……. 물론 사랑하고 있답니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/propose.ogg"},"스킬":{"voiceline":"침착하게 응전하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/skill.ogg"},"터치1":{"voiceline":"카리브디스에게 뭐든 맡겨주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/touch.ogg"},"터치2":{"voiceline":"주인님, 왜 그러세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/touch2.ogg"},"입수시":{"voiceline":"다이도급 경순양함 카리브디스입니다. 만나서 영광입니다, 주인님. 당신과 보내는 하루하루가, 따뜻한 햇살로 감싸인 평온한 나날이 되기를…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/unlock.ogg"},"강화성공":{"voiceline":"이게 바로 진정한 힘이죠! 우후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우아한 승리, 그것이야말로 로열 메이드대……. 아얏! 부, 불발탄…….?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"부비부비~ 헤헤~ 주인님, 편하세요? 헤헷, 모처럼의 기회이니, 듬뿍 치유해드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"오래 기다리셨습니다, 친애하는 주인님. 후후, 오늘도 수고 많으십니다… 자! 쓰담쓰담, 착하다, 착하다~ 이제 놓아주지 않을 거예요, 얌전히 제 치유를 받으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202300/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"네, 주인님. 외투는 제게 주세요~ 수건, 따뜻한 커피는 여기 있습니다. 그리고 제 포옹도요——","voicelink":"https://raw.githubusercontent.com/Fernando2603/