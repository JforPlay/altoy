[{"클뜯 id":10500060,"클뜯 함순이 id":1050006,"함순이 이름":"무라사키 시온","한글 함순이 + 스킨 이름":"무라사키 시온","영문 함순이 + 스킨 이름":"Murasaki Shion","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500060/shipyard.png","설명":"천재 마법사 무라사키 시온이야! 어른스러운 매력이 물씬 풍기는 이 코스튬을 한번 느껴보라구!","자기소개":{"voiceline":"천재 마법사 시온님이 있으면 어떤 상대라도 흑마법으로 쉽게 해결할 수 있지! 식은 죽 먹기라구! 조금 더 시온에게 기대도 좋다구~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/profile.ogg"},"메인1":{"voiceline":"있잖아! 이 목걸이와 머리 장식 귀엽지 않아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/main1.ogg"},"메인2":{"voiceline":"흐응~ 이 옷이 신경 쓰이는 구나? 잘 어울리지? 완전 마음에 든다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/main2.ogg"},"메인3":{"voiceline":"흐응~ 모두의 마음을 사로잡으려면 역시 본래의 이미지를 바꿔야겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/main3.ogg"},"전투개시":{"voiceline":"시온을 얕보지 말라구. 속공 작전 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/battle.ogg"},"상세확인":{"voiceline":"키도 스타일도 모두 어린애 같다구? 시, 시끄러! 시온은 어른이라고. 대단한 어른! 지휘관도 언젠가는 깨닫게 될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/detail.ogg"},"드랍 설명":{"voiceline":"천재 마법사 무라사키 시온이야! 어른스러운 매력이 물씬 풍기는 이 코스튬을 한번 느껴보라구!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어. 시온도 물자 정리를 도와야겠네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/expedition.ogg"},"실망":{"voiceline":"와아아아, 방송 프로그램이 꺼지지 않은 거야? 분명히 안녕이라고 했는데… 어떻게 꺼야하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/feeling1.ogg"},"낯섦":{"voiceline":"오셀로 하자, 흐응~ 시온은 엄청 잘 한다구. 제대로 상대하란 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/feeling2.ogg"},"호감":{"voiceline":"‘시온 성장 계획’을 만든다구?…그러니까 결국엔 시온에게 선물을 주겠다는 거지? 이봐! 애들용 장난감만 사주지 말란 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/feeling3.ogg"},"기쁨":{"voiceline":"방송은 MP를 많이 소모하지만, 지휘관과 같이 있으니까 순식간에 MP가 꽉 차네. 신기해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/feeling4.ogg"},"사랑":{"voiceline":"천재 시온 곁에 항상 있으면 지휘관도 점점 더 천재가 될 거야! 앞으로도 둘이 함께 노력해서 더 멋진 방송을 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/feeling5.ogg"},"터치3":{"voiceline":"헤헤, 모두가 칭찬해주는 말은 보통 ‘대단해, 똑똑해’ 잖아? 하지만 가끔은 다른 칭찬도 받고 싶은걸~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/headtouch.ogg"},"모항귀환":{"voiceline":"돌아온 걸 환영해, 지휘관! 하얀 옷을 입어도 시온이 천재 마법사라는 사실은 절대 변하지 않을 거라구! 내 마법이 보고 싶어? 그럼 라이브를 시작하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/home.ogg"},"hp 경고":{"voiceline":"아파라… 하지만 시온은 천재니까 이런 사소한 것으로 꺾이지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침, 지휘관! 이 코스튬을 입은 시온은 모항이든 바다든 어디에서건 모두의 마음을 사로잡을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/login.ogg"},"실패":{"voiceline":"Neeeeee! 유감! 하지만 천재니까 가끔은 실패해도 용서받을 수 있겠지… ?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/lose.ogg"},"우편":{"voiceline":"시온에게 온 편지인가…? 아, 지휘관 것이네. 자, 어서 열어봐~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/mail.ogg"},"임무":{"voiceline":"임무가 남아 있으면 찝찝하잖아…? 헤헤, 힘내 지휘관! 시온과 함께 모든 임무를 끝내버리자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/mission.ogg"},"임무완료":{"voiceline":"흐응, 시온님이 있어서 살았지? 임무는 이미 끝났으니 어서 보상을 받자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 드디어 시온의 매력을 깨달았네. 앞으로도 계속 응원해줘! 지휘관과 함께 나누고 싶은 즐거운 일들이 아직 많으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/propose.ogg"},"스킬":{"voiceline":"시온이 진지해지기 시작하면, 지구도 터질 수 있다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/skill.ogg"},"터치1":{"voiceline":"손을 모자 쪽에 두고 상쾌한 스마일을 더하면! 시온에게도 아이돌의 잠재력이 있는 것 같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/touch.ogg"},"터치2":{"voiceline":"으아… 뭐뭐뭐뭐… 뭐야 갑자기! 깜짝 놀랐잖아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/touch2.ogg"},"입수시":{"voiceline":"천재 마법사 무라사키 시온이야! 어른스러운 매력이 물씬 풍기는 이 코스튬을 한번 느껴보라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/unlock.ogg"},"강화성공":{"voiceline":"오오~ 시온의 흑마법, 강해진 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이런 건 당연, 당연한 일이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['미나토 아쿠아'