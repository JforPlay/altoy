[{"클뜯 id":10600080,"클뜯 함순이 id":1060008,"함순이 이름":"루나","한글 함순이 + 스킨 이름":"루나","영문 함순이 + 스킨 이름":"Luna","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10600080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10600080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10600080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10600080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10600080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10600080/shipyard.png","설명":"으, 으음… 여, 여긴 어디죠…? 저 말씀이신가요? 저는 루나, 학자입니다. …그 …지휘관…님? 일단은… 배가 좀 고픈데…. 뭐라도 먹을 거 없을까요? …가능하면 군고구마로….","자기소개":{"voiceline":"뿅뿅… 토끼인 줄 알았다구요? …아쉽지만, 진짜 이름은 루나…랍니다뿅. 학자 겸 비너스를 하고 있어요. 좋아하는 건 군고구마와 토끼예요. 지휘관님, 같이 현장 조사하러 가지 않으실래요? …뿅.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/profile.ogg"},"메인1":{"voiceline":"바다 위를 걸을 수 있다니… 무척 흥미롭네요. 그럼, 지휘관님. 저 넓은 바다를 조사하러 가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/main1.ogg"},"메인2":{"voiceline":"이 세상에도 3시에 간식을 먹는 풍습이 있나요? …흠, 다행이다. 그럼, 5시에는 군고구마를 먹는 풍습도 분명히 있겠죠. …농담이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/main2.ogg"},"메인3":{"voiceline":"처음 보는 서적이… 한가득. 시간이 아무리 많아도 부족해서… 즐거워….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/main3.ogg"},"전투개시":{"voiceline":"루나, 참전.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 여긴 좋은 곳이네요. 밥도 맛있고, 흥미로운 것도 많고… 행복해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/detail.ogg"},"드랍 설명":{"voiceline":"으, 으음… 여, 여긴 어디죠…? 저 말씀이신가요? 저는 루나, 학자입니다. …그 …지휘관…님? 일단은… 배가 좀 고픈데…. 뭐라도 먹을 거 없을까요? …가능하면 군고구마로….","voicelink":null},"의뢰 완료":{"voiceline":"다들 돌아오신 것 같네요. 후후, 어떤 이야기를 들려주실지 기대돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/expedition.ogg"},"실망":{"voiceline":"죄송해요. 생각하는 중이니 잠깐만 기다려...주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/feeling1.ogg"},"낯섦":{"voiceline":"후후. 지휘관님에 대해 조금은 알 것 같은 기분이 들어요. …그렇지만 아직 흥미로운 부분이 많아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/feeling2.ogg"},"호감":{"voiceline":"저기, 지휘관님. 잠깐 시간… 괜찮으세요? 그게… 저에게도 관심을 가져주셨으면 해서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/feeling3.ogg"},"기쁨":{"voiceline":"후후… 지휘관님이라면… 루나의 소중한 걸 보여드릴 수 있어요…. 더욱더 같이 있어 주셨으면… 하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/feeling4.ogg"},"사랑":{"voiceline":"음~ …으흠흠, 그렇구나. 후후, 지휘관님은 아무리 관찰해도 흥미가 사라지지 않네요. 오히려… 더 궁금증이 깊어진달까…? 아주 훌륭한… 연구 대상이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/feeling5.ogg"},"터치3":{"voiceline":"……? 왜 그러시죠? 군고구마 먹을 시간인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요. 식사 준비는 끝났으니, 지휘관님도 같이… 먹어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/home.ogg"},"hp 경고":{"voiceline":"아직이에요. 아직 안 끝났다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침입니다. 아침 먹을 시간인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/login.ogg"},"실패":{"voiceline":"안타깝게도… 지고 말았어요… 다음엔 열심히 해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/lose.ogg"},"우편":{"voiceline":"우편이 도착한 것 같네요. 정보는 중요하다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/mail.ogg"},"임무":{"voiceline":"업무가… 아직 끝나지 않은 것 같네요…. 그럼 전 응원을… 힘내라, 힘내라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/mission.ogg"},"임무완료":{"voiceline":"…업무가 끝난 것 같네요. 그 말은 즉, 현장 조사하러 나갈 시간이라는 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/mission_complete.ogg"},"서약":{"voiceline":"이 세상은 무척이나 흥미로워요. 아무리 조사해도 끝이 보이지 않는걸요. 그렇지만… 지휘관님 마음속에는 더… 흥미가 많은데, 아직 잘 모르겠어요… 그러니까 더 많이, 알려주셨으면 해요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/propose.ogg"},"스킬":{"voiceline":"이런 건… 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/skill.ogg"},"터치1":{"voiceline":"……? 무슨 볼일이라도 있으신가요? 아니… 딱히 볼일이 없으셔도… 괜찮아요. 지휘관님이라면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/touch.ogg"},"터치2":{"voiceline":"…저기 …이런 건, 곤란한데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/touch2.ogg"},"입수시":{"voiceline":"으, 으음… 여, 여긴 어디죠…? 저 말씀이신가요? 저는 루나, 학자입니다. …그 …지휘관…님? 일단은… 배가 좀 고픈데…. 뭐라도 먹을 거 없을까요? …가능하면 군고구마로….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/unlock.ogg"},"강화성공":{"voiceline":"이건… 흠, 파워가 느껴져요. …흥미롭네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"해냈어요…. 신난다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/win_mvp.ogg"},"전투개시_ex":{"voiceline":"출발~ 루나에게 맡겨…주세요뿅.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10600080/battle_ex.ogg"},"상세확인_