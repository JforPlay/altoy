[{"클뜯 id":105080,"클뜯 함순이 id":10508,"함순이 이름":"캘리포니아","한글 함순이 + 스킨 이름":"캘리포니아","영문 함순이 + 스킨 이름":"California","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105080/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105080/shipyard.png","설명":"테네시급 전함·캘리포니아 (BB-44)","자기소개":{"voiceline":"헬로~ 나는 테네시급 전함 2번함 캘리포니아야. 태평양 함대의 기함을 맡아, 대서양 함대에도 참가했어. 어때? 이렇게 인기 많을 줄 몰랐다고? 후후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/profile.ogg"},"메인1":{"voiceline":"언니와 많이 다르다고? 그런 거 아니야, 언니는 그래 봬도 상냥하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/main1.ogg"},"메인2":{"voiceline":"아~ 오늘은 웬일로 언니에게 잔소리듣지 않았네… 아! 아무것도 아냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/main2.ogg"},"메인3":{"voiceline":"앗, 팬티 어디다 뒀더라… 데헷~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/main3.ogg"},"전투개시":{"voiceline":"당황하지 말고, 침착하자… 응! 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/battle.ogg"},"상세확인":{"voiceline":"지휘관, 기대에 부응할 수 있게 힘낼게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/detail.ogg"},"드랍 설명":{"voiceline":"테네시급 전함·캘리포니아 (BB-44)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰 팀 아이들이 돌아왔어. 다음엔 나도 보내줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/expedition.ogg"},"실망":{"voiceline":"지휘관, 먼저 놀러 갈게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/feeling1.ogg"},"낯섦":{"voiceline":"친구가 될 수 있을지는, 해보지 않으면 모르는 거야~ 지휘관, 어디 놀러 가지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/feeling2.ogg"},"호감":{"voiceline":"흥~ 흥~ 흥♪ 어라, 지휘관~ 마침 잘됐네. 지금 놀러 가자고 권할까 하고 생각했던 참이야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/feeling3.ogg"},"기쁨":{"voiceline":"이 함대의 정박지에서 놀기엔 이제 질렸어~ 어디 좀 먼 곳으로 가지 않을래? 둘이서 몰래 말야, 헤헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/feeling4.ogg"},"사랑":{"voiceline":"언니는 연애할 상대는 신중하게 고르라면서, 정해지면 우선 자기한테 알리라고 잔소릴 하지만, 뭐, 지휘관이라면 언니도 아무 말 안 하겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"조금 전의 지휘관, 멋있었어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"날씨 OK, 풍향 OK~ 응, 출항하기 좋은 날이야. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/login.ogg"},"실패":{"voiceline":"큭! 언니에게 잔소리 듣겠네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/lose.ogg"},"우편":{"voiceline":"새로운 편지야! 바로 개봉해둘까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/mail.ogg"},"임무":{"voiceline":"지휘관~ 임무, 잊지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/mission.ogg"},"임무완료":{"voiceline":"하하하, 이거 좋네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 오늘도 어디 놀러 가지 않을래? …우왓! …정말이지, 싫진 않… 기쁘지만 말야, 이런 몰래카메라는 하지 마~ 깜짝 놀랐잖아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105080/propose.ogg"},"스킬":{"voiceline":"긴장 풀어~"