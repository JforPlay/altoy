[{"클뜯 id":9704060,"클뜯 함순이 id":970406,"함순이 이름":"됭케르크·META","한글 함순이 + 스킨 이름":"됭케르크·META","영문 함순이 + 스킨 이름":"Dunkerque META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704060/shipyard.png","설명":"순양전함 됭케르크야. 아, 마침 전장에서 복귀한 참이라, 원래는 이런 딱딱한 표정을 보여줄 생각은 없었는데…… 「디저트의 악마」라고 불리기도 해. 지휘관, 왜 그렇게 불리는지 알고 싶어?","자기소개":{"voiceline":"「과자의 악마」인 됭케르크, 지휘관에게 인사 올릴게. 모처럼이니까 새로 만든 디저트를 맛보고 가지 않을래? ……앗, 지휘관! 도망가지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/profile.ogg"},"메인1":{"voiceline":"싸우는 이유? 물론 이 세계의 희망과 아름다운 것들을 지키기 위해서야. 내가 마음을 담아 만든 디저트가 성질 더러운 적들에게 더럽혀지는 건 싫으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/main1.ogg"},"메인2":{"voiceline":"디저트 재료를 구하려고 긴박한 전투를 여러 번 겪었어. 궁금하면 다음에 이야기를 들려 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/main2.ogg"},"메인3":{"voiceline":"작은 디저트로도 사람의 마음을 흔들 수 있지…… 지휘관, 마치 악마의 유혹같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/main3.ogg"},"전투개시":{"voiceline":"큰일이야, 오븐의 타이머가……! 방해하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/battle.ogg"},"상세확인":{"voiceline":"지휘관, 입을 벌려 봐…… 응? 그냥 평범한 초콜릿 도넛이야. 어때? 맛있지? 자, 이번에는 「평범하지 않은」 디저트를 먹어 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/detail.ogg"},"드랍 설명":{"voiceline":"됭케르크급 순양전함 됭케르크<color=#92fc63>(1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 마중? 그럼 내가 만든 디저트도 가지고 가. 분명 더 즐겁게 맞이할 수 있을 거야, 후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/expedition.ogg"},"실망":{"voiceline":"지휘관의 의견은 디저트 만들기에는 별 참고가 안 되네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/feeling1.ogg"},"낯섦":{"voiceline":"맛있는 디저트가 있는데 먹어 볼래? ……어머, 필요없어? 좀처럼 할 수 없는 경험인데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/feeling2.ogg"},"호감":{"voiceline":"직접 먹여준다고 해도 싫어? 으음…… 어떻게 해야 지휘관이 절대로 거절할 수 없는 특별한 디저트를 만들 수 있을까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 막 구워낸 디저트는 어때? 안심해, 이번에는 평범한 디저트니까…… 어머! 망설임 없이 먹어줬네. 후훗, 어때? 맛있지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/feeling4.ogg"},"사랑":{"voiceline":"행복은 복잡한 맛을 가진 디저트 같아. 은은한 쓴맛과 달콤함이 절묘하게 뒤엉켜 떨어지지 않지…… 지휘관, 나와 함께 이 감미로움에 빠져볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/feeling5.ogg"},"터치3":{"voiceline":"부들부들해서 감촉이 꽤 괜찮지? 어머, 초콜릿 분수 같다고? 후훗…… 혹시 배고픈 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/headtouch.ogg"},"모항귀환":{"voiceline":"전투가 끝났어? 수고했어. 배고프지? 갓 구워낸 과자로 운을 시험해 볼래? 안심해, 가장 나쁜 결과가 나와도…… 웃음으로 넘길 수 있는 정도니까. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/home.ogg"},"hp 경고":{"voiceline":"후훗…… 이 씁쓸한 느낌……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/hp_warning.ogg"},"로그인":{"voiceline":"어서 와, 지휘관. 잠도 깰겸 디저트라도 어때? ……너무 시다고? ……후훗, 처음에는 조금 시게 느껴질지도 모르지만, 금방 달콤함이 퍼질거야. 그래도 덕분에 개운해졌지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/login.ogg"},"실패":{"voiceline":"후후…… 오랜만에 느껴보는 이 감각…… 새로운 디저트에 대한 영감이 샘솟기 시작했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/lose.ogg"},"우편":{"voiceline":"우편? 확실하게 구분해 뒀어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/mail.ogg"},"임무":{"voiceline":"임무가 꽤 쌓였네…… 괜찮아. 이 검으로 지휘관의 고민을 전부 지워줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/mission.ogg"},"임무완료":{"voiceline":"임무 보상이라면 벌써 도착했어. 가지고 올까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/mission_complete.ogg"},"서약":{"voiceline":"지휘관은…… 악마의 유혹에도 꿈쩍 하지 않는구나. 후후훗…… 어쩌면 나는 지휘관과 함께 하기 위해 태어난 걸지도 몰라. 안심해. 지옥의 끝까지 간다고 해도 내가 최고의 달콤함으로 채워줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/propose.ogg"},"스킬":{"voiceline":"승리를 가져오는 힘을 보라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/skill.ogg"},"터치1":{"voiceline":"내가 출격할 순서가 된 거야? 아니면…… 드디어 내 특제 디저트를 먹을 마음이 생긴 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/touch.ogg"},"터치2":{"voiceline":"맛있는 디저트보다 나를 찾는다니…… 후후, 어쩔 수 없네. 천천히 맛 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/touch2.ogg"},"입수시":{"voiceline":"순양전함 됭케르크야. 아, 마침 전장에서 복귀한 참이라, 원래는 이런 딱딱한 표정을 보여줄 생각은 없었는데…… 「디저트의 악마」라고 불리기도 해. 지휘관, 왜 그렇게 불리는지 알고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/unlock.ogg"},"강화성공":{"voiceline":"힘…… 후후, 나쁘지 않은 기분이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"훌륭한 전투였어. 나도 자랑스러워, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernan