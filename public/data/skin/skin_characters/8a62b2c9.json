[{"클뜯 id":203130,"클뜯 함순이 id":20313,"함순이 이름":"데본셔","한글 함순이 + 스킨 이름":"데본셔","영문 함순이 + 스킨 이름":"Devonshire","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203130/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203130/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203130/shipyard.png","설명":"런던급 중순양함 - 데본셔","자기소개":{"voiceline":"런던급 중순양함 데본셔입니다. 로열 메이드대의 구성원으로서 함력상 자랑할 만한 실적이라고 하면, 세계 곳곳을 떠돌며 중요한 인사들을 호송한 것 등이 있겠군요. 견문이 넓을 것 같다고요? \"흠, 칭찬이 과하십니다.\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/profile.ogg"},"메인1":{"voiceline":"지휘관님의 메이드로서 일정은 확실하게 관리하고 있습니다. 네, 중요한 회의에 참석하실 때 입으실 옷도 빠짐없이 다림질하고 있으니, 걱정 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/main1.ogg"},"메인2":{"voiceline":"급하게 예정을 변경하고 싶으시다고요? 꽤 변경점이 많군요…… \"쳇, 반드시 필요하다고 하시니 일정을 다시 짜야겠군요.\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/main2.ogg"},"메인3":{"voiceline":"으흠, 믿음직스러운 메이드는 여기까지입니다. 지금부터는 애교 듬뿍 모드 ON. \"어떡하죠? 너무 난감해요… 모항의 디저트 가게에 새로 나온 도너츠, 지금 먹고 싶은걸요~ 지휘관님, 부탁해요~♡\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/main3.ogg"},"전투개시":{"voiceline":"청소 모드, ON.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/battle.ogg"},"상세확인":{"voiceline":"음, 이거 꽤 좋은 표정이로군요. 놀라면서도 애교스러움이 느껴지는 당황하는 모습… 좋아요, 조금 더 거울로 연습하도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/detail.ogg"},"드랍 설명":{"voiceline":"런던급 중순양함 – 데본셔","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔습니다. 마중 나갈 때는 정장으로 갈아입으시기 바랍니다. 지휘관으로서의 품격을 항상 의식해 주셨으면 합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/expedition.ogg"},"실망":{"voiceline":"하아… 사무 모드를 철저히 유지하는 편이 좋을 것 같군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/feeling1.ogg"},"낯섦":{"voiceline":"\"디저트 만들기는 메이드의 기본 소양이라, 저도 꽤 자신이 있어요~ 후후후, 지휘관님. 여기 제가 직접 만든 도너츠예요♪ 가다랑어 맛이긴 하지만♪\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/feeling2.ogg"},"호감":{"voiceline":"지휘관님은 어떤 데본셔가 마음에 드시나요? \"애교 듬뿍♪\", \"차가운 쿨녀\", \"쭈뼛쭈뼛 소심녀 모드\"까지… 원하시는 게 있으면 뭐든 맞춰드릴 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/feeling3.ogg"},"기쁨":{"voiceline":"\"애교 듬뿍 모드에도 여러 바리에이션이 있어요♪ 원하는 느낌이 있으시면 요청하셔도 돼요♪\" 원래 데본셔가 어떤 느낌인지 알고 싶다고요? 정말…… 욕심이 많으시군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/feeling4.ogg"},"사랑":{"voiceline":"데본셔의 진실을 진짜로 알고 싶어 하다니, 역시 지휘관님은 욕심이 많으신 분이군요. …지휘관님의 마음은 확실히 전해졌습니다. 진심이 되어주신 만큼, 저도 제 진정한 모습을 보여드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/feeling5.ogg"},"터치3":{"voiceline":"\"지휘관님, 저를 애 취급하시는 건 아니겠지요?\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오십시오. 다과가 준비되어 있으니 천천히 휴식을 취하시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/home.ogg"},"hp 경고":{"voiceline":"읏… 흐트러진 모습을 보여드리고 말았군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/hp_warning.ogg"},"로그인":{"voiceline":"오셨군요. 그럼 오늘 업무를 시작할까요? …안심하시길. 준비는 모두 끝났으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/login.ogg"},"실패":{"voiceline":"쓰레기 \"청소\"에 실패했습니다. 만일의 사태에 대비하여 철수하시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/lose.ogg"},"우편":{"voiceline":"우편 정리가 완료되었습니다. 지휘관님, 언제 확인하실 예정이신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/mail.ogg"},"임무":{"voiceline":"지휘관님, 아직 끝나지 않은 임무가 있습니다. 부디 잊지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/mission.ogg"},"임무완료":{"voiceline":"도너츠가 보상이라면 제가 대신 수령하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/mission_complete.ogg"},"서약":{"voiceline":"다양한 상황에 대처할 수 있어야 어엿한 메이드로 여겨지기에, 여러 \"얼굴\"을 만들고 나누어 쓰는 것에 어쩔 수 없이 익숙해지고 말았지요…… 지휘관님을 향한 데본셔의 진짜 \"마음\"은 오직 하나뿐입니다. 네, 그것만은 영원히 변하지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/propose.ogg"},"스킬":{"voiceline":"필살 모드, ON!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/skill.ogg"},"터치1":{"voiceline":"네? 업무 모드로 전환할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/touch.ogg"},"터치2":{"voiceline":"여기 말씀인가요? ……오늘 지휘관님은 참…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/touch2.ogg"},"입수시":{"voiceline":"\"처음 뵙겠습니다, 지휘관님. 런던급 중순양함 데본셔입니다. 전투든 본업인 메이드 업무든 어느 정도는 숙달하고 있는 편입니다. 앞으로는 당신을 따르는 메이드로서 \"봉사\"할 테니, 모쪼록 잘 부탁드립니다.\" ――조금 분위기를 바꿔서 인사를 해봤는데, 너무 차가운 느낌인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/unlock.ogg"},"강화성공":{"voiceline":"시간의 흐름과 기술의 진보는 참 빠르군요. 강해진 게 몸으로 느껴집니다. 지휘관님, 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"예상보다 1초 더 걸렸군요. 다음에는 좀 더 기민하게 움직이겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"진실이라는 것은 추악한 부분도 포함됩니다. 따라서 그것을 타인에게 드러내는 것이 반드시 행복과 연결되는 것은 아니랍니다.차라리 가면을 쓴 채로 평생을 지내는 편이 더 편할 수 도 있습니다. 하지만, 지휘관님이라면....... 진실 된 모습으로 대해도 안심할 수 있겠군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"어린 아이와 같은 보상으로 저를 만족시킬 수 있다고 생각하셨습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어서 오십시오. 작전 수고하셨습니다. 방금 만든 도넛과 홍차입니다. 부디 편히 쉬시길","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 어서오세요. 그러고 보니까..... 「지휘관님」보다는 「주인님」이라고 부르는 편이 더 친군하게 느껴질 것 같은데, 어떻습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"피곤하시면 임무는 조금 휴식을 취하신 다음에 처리해도 괜찮습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/mission_ex.ogg"},"임무완료_ex":{"voiceline":"보상은 여기 있습니다. \"도넛이 없다니 실망이에요~ …사주신다구요? 신난다♡\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"치마 안의 관심이 있으십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/touch_ex.ogg"},"터치2_ex":{"voiceline":"「정말이지~ 이런 특별한 취미가 있는 줄은 몰랐는데요?」","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['런던'] : 런던 언니는 너무 사람들한테 물러요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203130/couple_encourage1.ogg"},{"voiceline":"['서식스'] : 서식스도 참, 그렇게 