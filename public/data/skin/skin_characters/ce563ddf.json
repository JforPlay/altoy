[{"클뜯 id":105200,"클뜯 함순이 id":10520,"함순이 이름":"앨라배마","한글 함순이 + 스킨 이름":"앨라배마","영문 함순이 + 스킨 이름":"Alabama","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105200/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105200/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105200/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105200/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105200/shipyard.png","설명":"사우스다코타급 전열함-앨라배마, BB-60 ","자기소개":{"voiceline":"내 이름은 앨라배마. 사우스다코타급의 4번함이야. 다들 나를 행운의 A라고 불러. 무슨 일을 했는지도 얘기 해 달라고? 생각해보자… 노르웨이, 마셜 제도, 마리아나에서 공을 세웠던 것 같기도? 그 다음은 레이테만, 그리고 사쿠라 엠파이어에 갔었지… 그 뒤론 쭉 모빌만에 누워있었어. 엄청 편했다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/profile.ogg"},"메인1":{"voiceline":"지휘관, 지. 휘. 관. 지-휘-관… 응, 별거 아냐. 그냥 부르고 싶었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/main1.ogg"},"메인2":{"voiceline":"칠면조 사냥 하고 싶다… 지휘관, 함선은 왜 비행기를 못 타? 아니면 날 수 있어도 좋을텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/main2.ogg"},"메인3":{"voiceline":"날씨 좋다. 지휘관, 잔디밭에 가서 일광욕하자. 난 햇볕 쬐면서 하루 종일 누워있을 수도 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/main3.ogg"},"전투개시":{"voiceline":"끝까지 놀아줘야 갈 수 있다구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/battle.ogg"},"상세확인":{"voiceline":"지휘관, 배고파. 칠면조 먹고싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/detail.ogg"},"드랍 설명":{"voiceline":"사우스다코타급 전열함-앨라배마, BB-60","voicelink":null},"의뢰 완료":{"voiceline":"수평선에 뭔가 있는 것 같은데… 아, 지휘관. 의뢰팀이 돌아왔어. 응. 내 시력은 좋다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/expedition.ogg"},"실망":{"voiceline":"…………누구였더라?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 티르피츠 찾아와도 돼? 꼭 한번 붙어보고 싶었는데 나오질 않아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/feeling2.ogg"},"호감":{"voiceline":"사쿠라 엠파이어 녀석들과 친구가 되었어. 날 싫어할 줄 알았는데. 사쿠라 엠파이어 녀석들, 재밌더라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 안아줘…… 역시 지휘관이 안아주면 편하고 안심돼. 조금 좋을지도.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 오늘 밤 내 방에 와줄 수 있어? 응… 왜냐면 뭔가 안고 자는 게 좋아서. 예전엔 베개를 껴안고 잤는데, 지금은 지휘관을 안고 자고 싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 내 다리 베고 누울래? …다른 애들은 다 그렇게 하던데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/home.ogg"},"hp 경고":{"voiceline":"너희들 대단하잖아, 히히…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관이야? 나쁜 사람인 줄 알고 날려버릴 뻔 했잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/login.ogg"},"실패":{"voiceline":"퇴각할거야? …알았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/lose.ogg"},"우편":{"voiceline":"지휘관, 왜 그래? 우편...? 아, 까먹었다. 우편을 가져다 주는 길이었지. 자, 여기.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/mail.ogg"},"임무":{"voiceline":"지휘관, 이 종이는 다 뭐야? 그렇구나...이게 다 임무구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/mission.ogg"},"임무완료":{"voiceline":"지휘관, 임무 보상은 내가 가지러 갈게. 나 힘 세거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/mission_complete.ogg"},"서약":{"voiceline":"이건… 영구쿠션서약? 매일 지휘관을 안고 자도 돼? 와… 기쁘다. 지휘관, 지금 당장 안아봐도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/propose.ogg"},"스킬":{"voiceline":"이 정도 가지고 쓰러진다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/skill.ogg"},"터치1":{"voiceline":"지휘관, 내 복근 만져볼래? 탄력있다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/touch.ogg"},"터치2":{"voiceline":"……………………에, 지휘관? 뭐 하는거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/touch2.ogg"},"입수시":{"voiceline":"나는 앨라배마. 무슨 일 있어? 아...함대인가. 뭐, 할 일도 없는데 같이 가줄게. Let's Go~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/unlock.ogg"},"강화성공":{"voiceline":"느낌이 약간… 뭔가 날려버리고 싶은…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/upgrade.ogg"},"vote":null,"승리":{"voiceline":"그냥 적들을 다 처치했을 뿐인데 왜 칭찬해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관의 포옹은 햇볕에 말린 이불보다 더 따뜻해…… 응, 이대로 계속 꼭 안고 있자. 지휘관도 좋지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"왔네, 지휘관. 날 만나러 온 거야? 나도 그래.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관 냄새, 마음이 놓여…… 더 꼭 안고 싶어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105200/touch_ex.ogg"},"터치2_ex":{"voiceline":"후우… 정말 특별한 느낌이야……","voi