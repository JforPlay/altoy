[{"클뜯 id":501020,"클뜯 함순이 id":50102,"함순이 이름":"푸슌","한글 함순이 + 스킨 이름":"푸슌","영문 함순이 + 스킨 이름":"Fu Shun","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501020/shipyard.png","설명":"안샨급 구축함 - 푸슌 ","자기소개":{"voiceline":"이스트 글림 안샨급 구축함, '사천왕'의 차녀, 푸슌이야! '레스키'는 어릴 적 이름이야. 많은 임무를 해냈는데 실전 경험이 없는 건 역시 조금 분하달까~ 어쨌든, 전장에서 마음껏 활약하게 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/profile.ogg"},"메인1":{"voiceline":"이걸 타이위안에게 선물하면 분명히 기뻐해 주겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/main1.ogg"},"메인2":{"voiceline":"해 질 녘 북쪽 해역에 나타나는 유령선? 어디선가 들은 것 같은…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/main2.ogg"},"메인3":{"voiceline":"창춘은 여동생이지만 자주 이것저것 알려줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/main3.ogg"},"전투개시":{"voiceline":"언니, 이번엔 연습이 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/battle.ogg"},"상세확인":{"voiceline":"알고 싶은 게 있으면 같이 알아볼게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/detail.ogg"},"드랍 설명":{"voiceline":"안샨급 구축함 - 푸슌","voicelink":null},"의뢰 완료":{"voiceline":"내가 갖고 싶은 것도 가져왔어. 밀수는 아니야! …라고 생각합니다아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/expedition.ogg"},"실망":{"voiceline":"와! 창춘, 타이위안, 지휘관이 왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/feeling1.ogg"},"낯섦":{"voiceline":"아, 지휘관? 나, 난 아무것도 안 했다고? 엑, 학교 창문이 깨졌어? ……아마 창춘이 말한 '유령'의 짓이 아닐까… 하고 생각합니다아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/feeling2.ogg"},"호감":{"voiceline":"지휘관, 이게 내가 만든 미사일이야! 멋있지? 지휘관이 여기에 타면 무조건 높이 날 수 있을 거야! 내릴 때는 어떡하냐고? 괜찮아! 나랑 창춘이 받아줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 좋은 아침! 아, 어제는 뭐 하고 있었냐고? 왜, 왜 갑자기… 별로 나쁜 짓은 안 했다고? 집무실이 엉망진창으로…? 나, 나 아니라니까! 늑대의 짓이야! …라고 생각합니다아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/feeling4.ogg"},"사랑":{"voiceline":"거기는 내 비밀기지! 어때, 멋있지! 이거야말로 나의 최고의 비밀이야! 응? 그냥 문득 생각난 거야! 별로 아무것도 꾸미고 있지 않다니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"그럼, '모항의 불가사의' 조사를 계속해볼까~ 창춘도 올래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/home.ogg"},"hp 경고":{"voiceline":"에잇! 진심으로 할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/hp_warning.ogg"},"로그인":{"voiceline":"오늘의 푸슌도, 의욕 MAX!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/login.ogg"},"실패":{"voiceline":"우으…… 어, 언니, 어디…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/lose.ogg"},"우편":{"voiceline":"긴급 우편은 아닌 것 같고, 일부러 지휘관에게 알릴 것도 없을까나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/mail.ogg"},"임무":{"voiceline":"임무를 해내러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/mission.ogg"},"임무완료":{"voiceline":"임무 완료했어. 응? 모항에 검은 연기가? 지휘관, 잘못 본 거 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/mission_complete.ogg"},"서약":{"voiceline":"이걸로 지휘관과는 가족이네! ……창고 열쇠를 빌려도 돼? 부탁이야! 하루만이라도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/propose.ogg"},"스킬":{"voiceline":"주명이화의 주작, 나의 항로를 밝혀라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/skill.ogg"},"터치1":{"voiceline":"꺅! 아, 아니아니아니, 마침 손을 등 뒤로 돌렸을 뿐이고 별로 아무것도 숨기는 거 없… 다고 생각합니다아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/touch.ogg"},"터치2":{"voiceline":"꺅!? 지휘관 어딜 만지는 거야! 아무것도 숨기지 않았다니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/touch2.ogg"},"입수시":{"voiceline":"구축함 푸슌, 착임했습니다~ 어라? 창춘은? 아까까지 뒤에 붙어있었는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/unlock.ogg"},"강화성공":{"voiceline":"더 강해질 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흐흥, 나 아직 진심이 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['안샨'] : 언니가 있으면 아무것도 무섭지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/couple_encourage1.ogg"},{"voiceline":"['타이위안'] : 타이위안, 뭔가 공부가 됐어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501020/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,