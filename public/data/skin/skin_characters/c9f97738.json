"voiceline":"그러고 보니 의뢰 보상에 강력분이 들어 있던데…… 설마 만두피부터 만드려는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501021/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"쉿! 안샨 언니가 이쪽으로 오고 있어… 들키면 더는 못 즐긴다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 행복한 새해 보내~! 자, 잠깐만! 어떻게 사다리도 없이 올라온 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501021/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관도 한번 해볼래? 장난이 성공하면 엄청 즐겁다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501021/touch.ogg"},"터치2":{"voiceline":"으아아, 위험해! 떨어지면 지금까지 한 짓이 들통난다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501021/touch2.ogg"},"입수시":{"voiceline":"오! 또 빠오즈를 한 판 낚았어~! 오늘은 대물이 잘 낚이는걸~! ……어, 앗, 지휘관?! 이, 이건…… 그러니까…… 그냥 게임하고 있는 거…라고 할까…나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501021/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":0,"상점 카테고리 id":3,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":501029,"클뜯 함순이 id":50102,"함순이 이름":"푸슌","한글 함순이 + 스킨 이름":"푸슌·改","영문 함순이 + 스킨 이름":"Fu Shun (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Ferna