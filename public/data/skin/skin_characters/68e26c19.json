[{"클뜯 id":301310,"클뜯 함순이 id":30131,"함순이 이름":"마츠카제","한글 함순이 + 스킨 이름":"마츠카제","영문 함순이 + 스킨 이름":"Matsukaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301310/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301310/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301310/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301310/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301310/shipyard.png","설명":"카미카제급 구축대 4번함·카미카제 ","자기소개":{"voiceline":"난 카미카제급의 마츠카제! 자매들과 함께 제5구축대에 배속되었었어. 무츠키급과 비교했을 때 살짝 구형이지만, 전투도 호위도 후배들에겐 지지 않는다고~! …후우… 내가 아니면, 아사카제랑 다른 애들은 어떻게 될까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/profile.ogg"},"메인1":{"voiceline":"손에 든거? 국자라는 거야. 응응, 좀 더 작았으면 차도 끓일 때도 쓸 수 있었을 텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/main1.ogg"},"메인2":{"voiceline":"여기는 생기가 좀 부족한 거 같네… 화분에 나무라도 심어보자, 지휘관~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/main2.ogg"},"메인3":{"voiceline":"으~음, 마른 세탁물에서 햇빛 냄새가 나~ 기분 좋네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/main3.ogg"},"전투개시":{"voiceline":"위험한 일만은 하지 말아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/battle.ogg"},"상세확인":{"voiceline":"자매들, 괜찮으려나… 걱정돼……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/detail.ogg"},"드랍 설명":{"voiceline":"카미카제급 구축대 4번함·카미카제","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰 나간 애들이 돌아왔어. 너무 오래 기다리게 하면 좋지 않다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/expedition.ogg"},"실망":{"voiceline":"하아… 어디에 문제가 생긴 걸까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 할 게 없으면 정리정돈이라도 좀 해. 자기 주변은 깔끔하게 하는 게 기본이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/feeling2.ogg"},"호감":{"voiceline":"응… '전자기기' 같은 거, 역시 잘 못 다루겠어… 지휘관, 쓰는 법을 알려줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/feeling3.ogg"},"기쁨":{"voiceline":"요즘 혼자 있으면, 지휘관의 신변은 괜찮나, 밥은 잘 먹고 다니나, 내 생각은 하려나… 막 이러고…… 아앗! 마지막 말은 취소, 취소야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 큰 목표를 노리고 열심히 하면 되니까, 사소한 건 내게 맡겨. 난 전투나 임무 이외에도 지휘관에게 도움이 되서 행복한 걸~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"아까 전투 때문에 피곤하지? …이제 무리 안해도 되니까, 빨리 일로 와서 쉬라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 배가 고프면 싸울 수 없다고! 나, 맛있는 걸 한~가득 만들었으니까, 많~이 먹어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/login.ogg"},"실패":{"voiceline":"우으… 난 괜찮으니까, 모두 도망쳐…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/lose.ogg"},"우편":{"voiceline":"지휘관, 전서야. 읽어줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/mail.ogg"},"임무":{"voiceline":"지휘관, 공직은 제대로 보고 있지? 나도 옆에 있으니까 말야","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/mission.ogg"},"임무완료":{"voiceline":"지휘관 고생했어. 장하다 장해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/mission_complete.ogg"},"서약":{"voiceline":"지휘관은 이런 나랑 평생의 계약을 맺겠다는 거야? 에헤헤, 좋아! 그럼 마츠카제, 지휘관의 시중을 계속 계속 받아줄게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/propose.ogg"},"스킬":{"voiceline":"나의 지휘관을 다치게 하지마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/skill.ogg"},"터치1":{"voiceline":"응? 지휘관 지쳤어? 잠깐만 기다려봐… 지금 과자를 좀 줄게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/touch.ogg"},"터치2":{"voiceline":"꺅?! ……지휘관, 거기 앉아! 혼나야겠네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/touch2.ogg"},"입수시":{"voiceline":"모두 다 있는 함대네? 뭔가 시끌벅적하네~ 나는 마츠카제, 잘 부탁해~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/unlock.ogg"},"강화성공":{"voiceline":"고마워~! 내 건 나중에 해줘도 된다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흐흥, 선배를 깔보면 큰코다친다고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301310/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_status":0},{"클뜯 id":301319,"클뜯 함순이 id":30131,"함순이 이름":"마츠카제","한글 함순이 + 스킨 이름":"마츠카제·改","영문 함순이 + 스킨 이름":"Matsukaze (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301319/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301319/chibi.png","아이콘 일러