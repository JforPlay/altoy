[{"클뜯 id":502090,"클뜯 함순이 id":50209,"함순이 이름":"지안","한글 함순이 + 스킨 이름":"지안","영문 함순이 + 스킨 이름":"Chi An","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502090/shipyard.png","설명":"CNT 조선소 1800톤급 소형 방호 순양함—지안","자기소개":{"voiceline":"이스트 글림 소속 지안이에요. 노바라급 순양함의 설계를 개량해서 만든 경순양함이랍니다. 출신은… 혹시 CNT68이라는 코드 네임, 들어보신 적 있으세요? 후후, 지휘관님은 지안이 생각한 것보다 견문이 넓으신 것 같네요♪","voicelink":null},"메인1":{"voiceline":"\"병자궤도야\"라고들 하지만, 사용할 수 있는 자원에는 한계가 있죠… 기회를 엿봐서 전황 변화를 꾀할 건지, 대국을 내다보고 형세를 굳힐 건지… 이것이야말로 전술가와 전략가의 차이라고 할 수 있겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/main1.ogg"},"메인2":{"voiceline":"바둑을 두는 건 참 즐거워요. …음, 대국에서 느껴지는 긴장감이 좋다기보다는 그냥 바둑을 두면서 상대와 이야기를 나누는 게 좋아서요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/main2.ogg"},"메인3":{"voiceline":"…이거 큰일이네요. 푸슌이 주방에 다시는 들어오지 말라고 하네요… 지휘관님, 요리 실력 늘리는 것 좀 도와주실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/main3.ogg"},"전투개시":{"voiceline":"선수를 치는 쪽이 유리한 법♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/battle.ogg"},"상세확인":{"voiceline":"뭘 고민하고 계신 거죠? 해결하지 못했거나 결론을 내리지 못한 문제, 미래에 대한 불안감… 뭐든 이 지안에게 털어놓으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/detail.ogg"},"드랍 설명":{"voiceline":"CNT 조선소 1800톤급 소형 방호 순양함—지안","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 돌아왔어요. …네, 감사 인사는 확실히 건네는 게 좋겠죠. 사람 간의 화합은 중요하니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/expedition.ogg"},"실망":{"voiceline":"정말… 고민거리가 있으면 언제든 털어놓으라고 말씀드렸는데, 이 상태라면… 하아… 이젠 저도 몰라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/feeling1.ogg"},"낯섦":{"voiceline":"어려운 일이 있을 땐 지안에게 털어놓으면 언제든 만사 해결…이라고 한다구요? 후후후, 다들 호들갑이 심하네요. 저는 그저 적당히 이야기를 들어준 것뿐인걸요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/feeling2.ogg"},"호감":{"voiceline":"이야기를 들어주기만 하고 따로 조언을 하거나 판단하지 않는 데에는 다 이유가 있답니다. \"모르는 것은 모른다고 하는 것이 바로 아는 것이다.\"…후후후, 지휘관님도 잘 알고 계신 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/feeling3.ogg"},"기쁨":{"voiceline":"어머… 지휘관님, 털어놓을 고민이 있으시다구요? 지안이 한 말을 기억해 주시다니 너무 기쁘네요. 후후후, 그럼 그 대신 지안도 지휘관님을 구석구석 탐구할 수 있게 해주세요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/feeling4.ogg"},"사랑":{"voiceline":"…그나저나 가끔은 지안의 고민도 지휘관님께 털어놔도 괜찮을까요…? 네, 시간을 많이 뺏지는 않을게요… 사실… 그… 올해 칠석에 혹시 시간 있으신가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/feeling5.ogg"},"터치3":{"voiceline":"그 대신 지휘관님 머리도 쓰다듬게 해주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 아, 옷깃이 흐트러져 있네요… 후후, 이젠 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/home.ogg"},"hp 경고":{"voiceline":"성가시게 됐네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/hp_warning.ogg"},"로그인":{"voiceline":"평안하신지요. 후후후, 활기가 넘치시네요. 오늘 업무도 분명 순조롭게 진행되겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/login.ogg"},"실패":{"voiceline":"이기고 지는 건 병가상사죠. 다시 도전하면 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/lose.ogg"},"우편":{"voiceline":"우편이에요. 어머, 제 요리책도 같이 도착한 모양이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/mail.ogg"},"임무":{"voiceline":"지휘관님, 임무 처리하는 거 잊지 마세요~ 우위성이라는 건 매일 착실히 쌓아나가는 거라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어요. 일취월장… 우위성이란 건 이렇게 확립되는 법이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/mission_complete.ogg"},"서약":{"voiceline":"중요한 이야기라는 건… 후후, 이거였군요. 후훗, 전혀 예상 못 했어요. 지휘관님이 이렇게 과감하게 나설 줄은 꿈에도 생각 못 했네요. 네, 다음에는 지휘관님이 마음의 준비를 해두셔야 할 걸요. 왜냐면 지안은 더 뜨거운 마음으로 보답할 거니까요~♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/propose.ogg"},"스킬":{"voiceline":"승기는 내 쪽으로 넘어왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/skill.ogg"},"터치1":{"voiceline":"어머, 지안이 만든 요리는 어떠세요? 사양하겠다구요…? 흑……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/touch.ogg"},"터치2":{"voiceline":"어머… 어머나… 후후, 꽤 대담하시네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/touch2.ogg"},"입수시":{"voiceline":"이스트 글림 소속 경순양함 지안이 인사드립니다. 좋아, 성실한 자기소개는 이 정도로 하고…… 지휘관님, 앞으로는 고민이 있으면 뭐든 이 지안에게 털어놓으세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/unlock.ogg"},"강화성공":{"voiceline":"응, 괜찮은 느낌이네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"계책을 짜는 건 장막 안에서, 승부를 결정짓는 건 천리 밖에서~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"바둑 한 판 어떠세요? …고민이 있으시면 뭐든 바둑을 두면서 제게 털어놓으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"그나저나, 지휘관님 오늘 한가하세요…? 저기… 같이 칠석에는… 칠석은 아직 멀었다구요? 지휘관님 달력이 조금 안 맞는 걸 거예요. 왜냐면 지안의 달력에서는 오늘도, 내일도… 지휘관님과 보내는 매일이 칠석인걸요///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"평안하신지요. 업무 시작할 준비는 다 되셨나요? 후후, 지안도 같이 열심히 할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"요리 지도를 해주시려는 건가요? 기뻐요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/touch_ex.ogg"},"터치2_ex":{"voiceline":"어머, 이대로 끝낼 생각은 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['젠하이'] :  저와는 방식이 다르네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관께서 특훈을 해주신 덕분에 사람들을 설득해서 주방에 들어설 수 있게 되었답니다. 후후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"젠하이를 상대로 반집승을 거두셨다구요? 어머, 지안의 가르침이 뛰어난 것만은 아니랍니다. 뭐, 이긴 건 이긴 거니까요. 보상은 물론 지안 몫도 따로 있겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502090/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":1},{"클뜯 id":502091,"클뜯 함순이 id":50209,"함순이 이름":"지안","한글 함순이 + 스킨 이름":"화등과 밤놀이","영문 함순이 + 스킨 이름":"Lanternlit Stroll","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502091/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502091/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502091/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502091/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502091/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502091/shipyard.png","설명":"지휘관님께 새해 인사드립니다. ……제 모습이요? 후후, 늘 바쁘신 지휘관님이 명절에 시간을 내서 오셨으니, 지안도 전력을 다해야죠. 자, 고민은 모두 잊고 이 현란한 밤을 함께 즐겨요♪","자기소개":null,"메인1":{"voiceline":"어, 어라? 또 갈림길이… 왼쪽? 아니 오른쪽? 지안도 길을 잃을 때가 있냐니 놀리지 마세요. 어디로 가는 게 더 좋을지 같이 생각해 주셔야죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/main1.ogg"},"메인2":{"voiceline":"그러고 보니 강을 따라 흘러가는 화등에는 새해에 만사가 형통하기를 바라는 마음이 담겨있다고 해요. 이렇게 화등이 흘러가는 걸 보니, 분명 우리 사이도 순조롭게… 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/main2.ogg"},"메인3":{"voiceline":"아, 저기 선착장 근처에는 가판대 거리가 있는 것 같네요! 후후, 이거 재밌는 음식이 많이 있을 것 같은 예감이… 나중에 뭐 좀 사 올까요? 물론 지휘관님 몫도♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이 여흥의 종점에는 뭐가 있을까요? 떠들썩한 축제? 현란한 불꽃놀이? 아니면 수면을 가득 메운 화등…… 지안도 예상하기 어려운 경치를 함께 기대해 볼까요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님께 새해 인사드립니다. ……제 모습이요? 후후, 늘 바쁘신 지휘관님이 명절에 시간을 내서 오셨으니, 지안도 전력을 다해야죠. 자, 고민은 모두 잊고 이 현란한 밤을 함께 즐겨요♪","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지금도 충분히 만족하고 있는걸요? 아름다운 경치를 감상할 뿐만 아니라, 당신과 함께 이 밤놀이를 즐길 수 있다니… 후후, 앞으로도 계속 이렇게 함께 할 수 있다면… 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어머, 강이 또 여기서 합쳐지네요. 다른 코스에서 보고 오신 경치는 어땠나요? 후후, 빨리 지안에게 알려주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 시간에 맞춰 오셨네요. 쇠뿔도 단김에 빼라고 하니, 북적이는 하천에서 밤놀이를 즐기러 바로 가볼까요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"어머? 지안이랑 같은 화등을 타고 싶다구요? 물론 좋아요. 그럼…… 제 품으로 오세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/touch.ogg"},"터치2":{"voiceline":"어머나…… 무슨 생각 하시는지 훤히 보이네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/touch2.ogg"},"입수시":{"voiceline":"지휘관님께 새해 인사드립니다. ……제 모습이요? 후후, 늘 바쁘신 지휘관님이 명절에 시간을 내서 오셨으니, 지안도 전력을 다해야죠. 자, 고민은 모두 잊고 이 현란한 밤을 함께 즐겨요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502091/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70965,"상점 카테고리 id":3,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":800,"기간":"한정 (2025/02/12)","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502092,"클뜯 함순이 id":50209,"함순이 이름":"지안","한글 함순이 + 스킨 이름":"이국의 몽상향","영문 함순이 + 스킨 이름":"Exotic Dreamland","스킨 타입":"Nile Colors","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502092/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502092/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502092/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502092/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502092/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502092/shipyard.png","설명":"후우…… 눈을 뜨자마자 꿈이 보여준 운명의 짝을 만나다니~ 우후후, 이것이 운명의 인도하심이라면… 나그네님, 잠시 걸음을 멈추고 여기서 오랜 여행의 피로를 푸는 건 어떠신가요…?","자기소개":null,"메인1":{"voiceline":"수많은 절경을 마주한 당신도 마음 놓고 편히 쉴 고요한 공간은 필요할 테죠…… 어쩌면 이곳이 어깨의 짐을 내려놓기에 딱 좋은 공간일지도 몰라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/main1.ogg"},"메인2":{"voiceline":"이렇게 설명하는 게 너무 밋밋하면… 바둑을 두면서 설명하거나, 새로 배운 향토 요리를 만들어 주는 건…… 요리는 참아달라고요? 으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/main2.ogg"},"메인3":{"voiceline":"여긴 다 완벽한데… 머지않아 당신이 떠나버리는 것만이 옥의 티랄까요… 아, 여기 남아주셨으면 좋으련만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"어머, 혹시 나그네와 귀족이라는 설정이나 호칭이 좀 어색하신 건가요? 모처럼 다들 옷을 갈아입고 나일강 문명의 세계를 즐기고 있으니, 지휘관님도 같이 역에 몰입하시면 좋겠어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/detail.ogg"},"드랍 설명":{"voiceline":"후우…… 눈을 뜨자마자 꿈이 보여준 운명의 짝을 만나다니~ 우후후, 이것이 운명의 인도하심이라면… 나그네님, 잠시 걸음을 멈추고 여기서 오랜 여행의 피로를 푸는 건 어떠신가요…?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 돌아온 모양이네요. 이다음은 모두를 맞이한 다음에 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"우후후, 꿈이 보여준 징조로 만난 내 운명의 짝…… 신들도 축복하고 있으니, 차라리 이 여행의 휴식을 영원한 동반으로 바꾸는 편이 어때요? 이 궁전에서 두 사람의 미래를 계속해서 가꾸어 나가요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/feeling5.ogg"},"터치3":{"voiceline":"지휘관님의 자상함에는 항상 설레고 마네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/headtouch.ogg"},"모항귀환":{"voiceline":"나그네님, 오랜 여행으로 피곤하시죠? 그렇게 송구스러워하실 거 없어요~ 원하시면 여기 폭신한 침상에 얼마든 머무르셔도 된답니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어머, 당신이군요? 우후후, 운명의 짝이 제 곁으로 찾아오는 건, 휘몰아치는 모래의 폭풍도 멈출 수 없는 모양이네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/login.ogg"},"실패":null,"우편":{"voiceline":"새로운 우편이 있네요… 또 이렇게 떠나시는 걸까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/mail.ogg"},"임무":{"voiceline":"아직 끝나지 않은 임무가 있나요? 후후후, 그럼 저도 같이 힘을 모아서 다 처리한 다음에 이어서 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"음? 궁금하신 거라도 있으신가요? 뭐든 답해드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/touch.ogg"},"터치2":{"voiceline":"어머…… 나그네님, 짓궂기도 하셔라♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/touch2.ogg"},"입수시":{"voiceline":"후우…… 눈을 뜨자마자 꿈이 보여준 운명의 짝을 만나다니~ 우후후, 이것이 운명의 인도하심이라면… 나그네님, 잠시 걸음을 멈추고 여기서 오랜 여행의 피로를 푸는 건 어떠신가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502092/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex