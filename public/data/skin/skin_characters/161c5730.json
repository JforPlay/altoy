[{"클뜯 id":402030,"클뜯 함순이 id":40203,"함순이 이름":"쾰른","한글 함순이 + 스킨 이름":"쾰른","영문 함순이 + 스킨 이름":"Köln","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402030/shipyard.png","설명":"쾨니히스베르크급 경순양함·쾰른","자기소개":{"voiceline":"쾨니히스베르크급 경순양함 3번함 쾰른. 이 얇은 몸은 저희 3자매의 자랑이기도 하답니다. 예전에는 세계 일주에 참가하여, 발트해나 북해에서 활동했었습니다. 방어작전이나 침공작전도 저에게 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/profile.ogg"},"메인1":{"voiceline":"우으… 이번 달 예산이 또…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/main1.ogg"},"메인2":{"voiceline":"쾨니히스베르크 언니, 지휘관님을 이 이상 놀렸다간 이상한 취향에 눈 떠버릴 거라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/main2.ogg"},"메인3":{"voiceline":"카를스루에 언니, 지휘관님은 바쁘시니까 놀 거면 혼자서 놀아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/main3.ogg"},"전투개시":{"voiceline":"적함 발견, 뇌격전 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/battle.ogg"},"상세확인":{"voiceline":"지휘관님은 어떤 데이터를 보고 싶으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/detail.ogg"},"드랍 설명":{"voiceline":"쾨니히스베르크급 경순양함·쾰른","voicelink":null},"의뢰 완료":{"voiceline":"원정 나갔던 애들이 돌아왔네요. 살펴보러 가시겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/expedition.ogg"},"실망":{"voiceline":"지휘관님, 오피스 해러스먼트는 범죄입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/feeling1.ogg"},"낯섦":{"voiceline":"쾰른이 도와드릴 일이 있나요? 뭐든지 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/feeling2.ogg"},"호감":{"voiceline":"지휘관님이 다가가기 쉬운 분이라 다행이에요. ……저, 강압적인 분은 조금 서툴러서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/feeling3.ogg"},"기쁨":{"voiceline":"다, 다른 자매들이 지휘관님의 마수에 빠지지 않도록, 내가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/feeling4.ogg"},"사랑":{"voiceline":"저, 정말, 지휘관님은 제가 봐주지 않으면 안 되는군요. 공무든 사적인 일이든 보좌는 저에게 맡겨주세요. 따, 딱히 지휘관님을 독점하고 싶은 건 아니에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"작전 수고하셨습니다, 지휘관님. 오늘의 다음 스케쥴은… (펄럭펄럭)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요, 지휘관님. 오늘의 스케쥴입니다. 확인 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/login.ogg"},"실패":{"voiceline":"우우… 또 실패했나~, 해체만은 하지 말아줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 새로운 편지가 있습니다. 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/mail.ogg"},"임무":{"voiceline":"새로운 임무 통지네요. 지금 스케쥴에 추가할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/mission.ogg"},"임무완료":{"voiceline":"임무 완료입니다. 보수 물품 목록 작성해드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/mission_complete.ogg"},"서약":{"voiceline":"이걸로 지휘관님에게 더욱 다가갈 수 있겠어요! ……아, 아무것도 아니에요! 에헴, 지휘관님 감사합니다. 쾰른, 기대를 배신하지 않도록 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/propose.ogg"},"스킬":{"voiceline":"응, 지금이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/skill.ogg"},"터치1":{"voiceline":"음? 뭔가 지시하실 것이 있으신가요? 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/touch.ogg"},"터치2":{"voiceline":"부하에게 손을 대는 건 귀축의 소행이에요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/touch2.ogg"},"입수시":{"voiceline":"현명해 보이시는 지휘관님이시네요. 저는 쾰른, 집무 보좌는 저에게 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/unlock.ogg"},"강화성공":{"voiceline":"지휘관님은 부하에게도 신경 써주시는 좋은 분이시군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후우… 오늘은 뭐… 합격, 이겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"N","ex_chat_status":0},{"클뜯 id":402039,"클뜯 함순이 id":40203,"함순이 이름":"쾰른","한글 함순이 + 스킨 이름":"쾰른·改","영문 함순이 + 스킨 이름":"Köln (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402039/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402039/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402039/icon.p