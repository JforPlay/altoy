[{"클뜯 id":102190,"클뜯 함순이 id":10219,"함순이 이름":"꼬마 헬레나","한글 함순이 + 스킨 이름":"꼬마 헬레나","영문 함순이 + 스킨 이름":"Lena","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102190/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102190/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102190/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102190/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102190/shipyard.png","설명":"브루클린급 순양함 - 헬레나 (CL-50) ","자기소개":{"voiceline":"세인트루이스급 경순양함, 헬레나야. 이상한 곳에 와 버렸지만, 레이디라면 언제 어디서나 차분하게 있어야 한다고 세인트루이스 언니가 그랬어. 지휘관도 나쁜 사람은 아닌 것 같으니, 여기에서 당분간 신세 좀 질게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/profile.ogg"},"메인1":{"voiceline":"세인트루이스 언니는 뭔가 인형처럼 여러가지 옷을 갈아입히려고 해… 그, 그렇지만 옷이 다 귀엽기도 하고, 딱히 싫은 건 아닐지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/main1.ogg"},"메인2":{"voiceline":"어라? 저 금발의 아이, 항상 모두에게 둘러싸여 있네……엣, 따, 딱히 신경이 쓰이는 건 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/main2.ogg"},"메인3":{"voiceline":"지휘관, 오늘의 나는 귀, 귀여워?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/main3.ogg"},"전투개시":{"voiceline":"놓치지 않을 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/battle.ogg"},"상세확인":{"voiceline":"언젠가는 세인트루이스 언니처럼 예뻐질 수 있다면 좋겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/detail.ogg"},"드랍 설명":{"voiceline":"브루클린급 순양함 - 헬레나 (CL-50)","voicelink":null},"의뢰 완료":{"voiceline":"시간을 지키지 않는 아이는 미움받는다고, 세인트루이스 언니가 그랬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/expedition.ogg"},"실망":{"voiceline":"지휘관과 같이 있으면 즐겁지 않아……도, 돌아가버릴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 여자아이 방에 마음대로 들어가면 안 된다고 그렇게 말했는데! …어라?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/feeling2.ogg"},"호감":{"voiceline":"지휘관, 이 헤어 스타일이 엄청 유행하고 있다는 것 같아. 하지만 나는 역시 이쪽이 더 좋은 것 같은데…어느 쪽이 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/feeling3.ogg"},"기쁨":{"voiceline":"항상 세인트루이스 언니가 헤어스타일을 만져주거나, 화장을 도와줬는데…지금은 지휘관이 도와주고 있네. 에헤헤, 지휘관, 고마워요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/feeling4.ogg"},"사랑":{"voiceline":"어째서일까……지휘관이 헤어스타일을 만져주거나 화장을 해줄 때는 항상 두근두근거려……세인트루이스 언니가 해줬을 땐 그런 일이 없었는데……나, 괜찮은 걸까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 머리 모양 세팅하는 거 도와줄 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/home.ogg"},"hp 경고":{"voiceline":"어, 어떡하지 어떡하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/hp_warning.ogg"},"로그인":{"voiceline":"지, 지휘관, 지금 무슨 머리 할 지 고민 중이란 말야. 갑자기 들어오지 말아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/login.ogg"},"실패":{"voiceline":"우웃…지휘관, 너무해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/lose.ogg"},"우편":{"voiceline":"어라…새 메일? 지휘관, 직접 받아주면 좋겠는데…난 지금 조금 바빠서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/mail.ogg"},"임무":{"voiceline":"지휘관, 임무를 수행할 때는 이 헤어 스타일을 하는 게 어떨까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/mission.ogg"},"임무완료":{"voiceline":"와아, 이게 전부 보너스인 거야? 지휘관, 대단해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/mission_complete.ogg"},"서약":{"voiceline":"결혼이라는 건, 깊은 인연을 증명하는 거라고 세인트루이스 언니가 그랬어……그러니까, 나와 지휘관은 영원히 사이좋게 계속 함께 있을 수 있다는 거겠지? 에헤헤, 정말 기뻐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/propose.ogg"},"스킬":{"voiceline":"귀여운 것은…무적이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/skill.ogg"},"터치1":{"voiceline":"지휘관, 저, 저기, 토끼가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/touch.ogg"},"터치2":{"voiceline":"지휘관, 이런 짓을 하면 여자아이들한테 미움받을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/touch2.ogg"},"입수시":{"voiceline":"오늘은 어떤 헤어 스타일로…다, 당신 누구야?? 어째서 갑자기 여기 나타난 거지!? 어라…여긴 내 방인데…에에에엣!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 답례로 등이라도 두들겨 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에헤헤, 난 세, 세젤귀지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['꼬마 클리블랜드'] : 아, 안녕! 내 이름은 헬레나야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102190/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X",