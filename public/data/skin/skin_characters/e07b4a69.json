dio/voiceline/102254/detail.ogg"},"드랍 설명":{"voiceline":"이 가면이 뭐냐고? 무도회 연극에 쓸 건데…. 맞다, 지휘관. 연습에 어울려주지 않을래? …그럼 바로, \"같이 춤추실래요?\"","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"어서 와, 지휘관. 비련의 러브 스토리라면, 돌아가려고만 해도 갖은 고난이 닥쳐오는데, 별일 없었어? 그럼 다행이고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102254/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"배우가 다 모였군. 그럼 뭐부터 시작해볼까? 러브 스토리처럼 이대로 사랑의 도피라도 떠날래? 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102254/login.ogg"},"실패":null,"우편":{"voiceline":"우편이 온 것 같군. 지휘관이 소중히 여기는 누군가가 보낸 걸 수도 있으니, 절대 잊어버리지 말도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102254/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"내 손은 왜 잡아끄는 거지? 춤 신청을 하려는 건가? 그럼 같이…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102254/touch.ogg"},"터치2":null,"입수시":{"voiceline":"이 가면이 뭐냐고? 무도회 연극에 쓸 건데…. 맞다, 지휘관. 연습에 어울려주지 않을래? …그럼 바로, \"같이 춤추실래요?\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102254/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"동화 속 세계","상점 id":70712,"상점 카테고리 id":19,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"한정 (2025/04/02)","진영":"USS","레어도":"SR","ex_chat_status":0}]