티엔이 가르쳐준 거예요. 특별한 의미는 없어요. (작게) 하지만, 지휘관님과 함께 있는 시간은 언제나 짧게 느껴지는 것 같아요…","voicelink":null},"의뢰 완료":{"voiceline":"저기 있는 건… 아, 의뢰를 나간 동료들이 무사히 돌아왔어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501012/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"지휘관님, 잠시 홀가분하게 앉아서 쉬는게… 어떠세요? 음, 다음 업무까지는 시간이 좀 남았어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501012/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"이번 보상이 기대되네요, 지휘관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501012/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"석양이 정말 아름답네요…… 아하하하……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501012/touch2.ogg"},"입수시":{"voiceline":"\"석양의 아름다움은 무한하지만, 단지……\" 아, 이건 하이티엔이 가르쳐준 거예요. 특별한 의미는 없어요. (작게) 하지만, 지휘관님과 함께 있는 시간은 언제나 짧게 느껴지는 것 같아요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501012/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"석양 아래에서, 승리를 거머쥐어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501012/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"학교","상점 id":70665,"상점 카테고리 id":4,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":501019,"클뜯 함순이 id":50101,"함순이 이름":"안샨","한글 함순이 + 스킨 이름":"안샨·改","영문 함순이 + 스킨 이름":"A