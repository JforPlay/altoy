[{"클뜯 id":501010,"클뜯 함순이 id":50101,"함순이 이름":"안샨","한글 함순이 + 스킨 이름":"안샨","영문 함순이 + 스킨 이름":"An Shan","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501010/shipyard.png","설명":"안샨급 구축함 - 안샨 ","자기소개":{"voiceline":"이스트 글림 안샨급 구축함, '사천왕'의 장녀, 안샨입니다. 자매의 기함으로서 연습이나 해역의 순시, 적 세력 함선에 대한 경고 등 여러 임무를 성공시켰습니다! 실전 경험만 없을 뿐이지, 항해한 거리의 길이에는 자신이 있습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/profile.ogg"},"메인1":{"voiceline":"이것이 전함…… 처음 봤습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/main1.ogg"},"메인2":{"voiceline":"정말, 푸슌 또 어딜 간 거야? 조금은 언니가 하는 말을 들어 줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/main2.ogg"},"메인3":{"voiceline":"푸슌, 창춘, 타이위안, 모두 자랑스러운 여동생이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/main3.ogg"},"전투개시":{"voiceline":"무엇을 위해 싸우는 거지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/battle.ogg"},"상세확인":{"voiceline":"지휘관님은 어떤 정보를 알고 싶으십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/detail.ogg"},"드랍 설명":{"voiceline":"안샨급 구축함 - 안샨","voicelink":null},"의뢰 완료":{"voiceline":"좋아! 전원 모항으로 귀환했습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/expedition.ogg"},"실망":{"voiceline":"지휘관님, 보하이 만에 심은 산사나무가 꽃필 무렵이니, 휴가를 허가해 주셨으면 합니다만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 소중한 것을 지키는 데엔 싸움도 필요합니다. 개인의 선호는 관계없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/feeling2.ogg"},"호감":{"voiceline":"제가 싸우지 않게 되어도, 보하이…… 그 석양에 붉게 물드는 바다를 계속 바라보고 싶습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 안심하십시오. 지휘관님이 어디에 있든, 반드시 곁에서 지켜드리겠습니다. 네? 그야, 지휘관님은 저의……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님과 만나서 정말 다행입니다. 여러 친구와 여러 추억이 생겨서…… 그, 지휘관님, '사천왕'의 책무가 없어지면 저와 함께 세계 일주라도 하지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"조금 쉬도록 하죠. 계속 긴장하고 있는 건 몸에 좋지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/home.ogg"},"hp 경고":{"voiceline":"지휘관님, 정신 차리고, 집중하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/hp_warning.ogg"},"로그인":{"voiceline":"오늘 스케줄도 빡빡하네요. 같이 힘내자고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/login.ogg"},"실패":{"voiceline":"일단 퇴각해서 함대를 재편하죠! 이대로 질 수는 없습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/lose.ogg"},"우편":{"voiceline":"지휘관님, 새로운 우편이 있습니다. 대신 개봉할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/mail.ogg"},"임무":{"voiceline":"평화를 지키기 위해, 임무를 해내는 것도 중요해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/mission.ogg"},"임무완료":{"voiceline":"마음을 다잡고, 앞으로도 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 이 생명, 이 몸, 그리고 이 혼은 전부 당신에게 맡깁니다! ……확실히, 책임져 주세요(///)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/propose.ogg"},"스킬":{"voiceline":"소양둔갑의 청룡, 앞길을 열어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/skill.ogg"},"터치1":{"voiceline":"지휘관님…… 에헤헤, 가끔은 이런 것도 좋네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/touch.ogg"},"터치2":{"voiceline":"저기! ……여동생들에게 보일지도 몰라요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/touch2.ogg"},"입수시":{"voiceline":"구축함 안샨, 착임했습니다! 여동생들과 지휘관님은 제가 지키겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/unlock.ogg"},"강화성공":{"voiceline":"이걸로 '드 헤이븐' 따위에겐 지지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관님의 도움이 될 수 있어 영광입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['푸슌'] : 뛰어다니지 말고, 언니 옆으로 와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/couple_encourage1.ogg"},{"voiceline":"['창춘'] : 신중하게 움직여서 나쁠 건 없지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/couple_encourage2.ogg"},{"voiceline":"['타이위안'] : 더 용기를 가지고! 그래, 그 기세!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501010/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_