[{"클뜯 id":9702020,"클뜯 함순이 id":970202,"함순이 이름":"멤피스·META","한글 함순이 + 스킨 이름":"멤피스·META","영문 함순이 + 스킨 이름":"Memphis META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702020/shipyard.png","설명":"멤피스야. 지휘관은 내가 낯선 사람처럼 느껴질지도 모르겠지만, 당신에 대해서는 잘 알고 있어. 걱정하지 마. 이상한 사람은 아니니까 믿어주길 바라. 앞으로 당신을 착실히 보좌하며 호위해줄게.","자기소개":{"voiceline":"오마하급 경순양함 멤피스야. 이런 소개만으로 날 알기에는 한참 부족하겠지만, 언제, 어떤 상황에서라도 난 늘 당신의 맹우이자 동료라는 점, 이것만은 보증할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/profile.ogg"},"메인1":{"voiceline":"서류 업무 처리 방식이 비슷하다구? 으음… 일단 우연의 일치라고 해줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/main1.ogg"},"메인2":{"voiceline":"모항도 잘 굴러가고 있고, 자원 준비도 모자람이 없고, 인원 배치도 잘 되어 있어. …흠, 만사가 순조롭네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/main2.ogg"},"메인3":{"voiceline":"우리, 뭘 해도 호흡이 척척 맞는 거 같지 않아? 이거야말로 타고난 콤비라는 거 아니겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/main3.ogg"},"전투개시":{"voiceline":"지휘관을 위해 방해물을 제거해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/battle.ogg"},"상세확인":{"voiceline":"지휘관? …난 괜찮은데? 그래, 아무렇지도 않으니까, 걱정할 거 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/detail.ogg"},"드랍 설명":{"voiceline":"멤피스호 경순양함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔으니까, 마중 나가야… 지휘관, 평소대로 마중 나가줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/expedition.ogg"},"실망":{"voiceline":"당신이 어떻게 변한들, 난 늘 당신을 보좌할 거야. 그게 내 역할인걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/feeling1.ogg"},"낯섦":{"voiceline":"오늘은 뭐부터 착수할까? 작전 계획? 의뢰? 출격? 뭐든 자신 있어. 평소대로 맡겨만 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/feeling2.ogg"},"호감":{"voiceline":"얼마 전 외출했을 때 겸사겸사 사 온 건데, 선물하면 딱 좋겠다 싶어서… 받아줄래? …어때? 기뻐? …내가 선물을 받았을 때만큼 기쁘려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관이 임무를 착착 해치우는 데 익숙해지면, 성취감도 점점 느끼지 못하게 되려나? …갑자기 이상한 질문 해서 미안해. 지금은 눈앞에 있는 업무에 집중해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 오늘도 열심히 보좌해줄게. 그래, 모든 것이 어제와 똑같아. 똑같은 풍경에 똑같은 업무, 똑같은 당신과 나…. 이대로 변함없는 내일을 맞이하고 싶을 뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어. 주스라도 마실래? 뭘 좋아하는진 잘 알고 있으니까 내게 맡겨줘. …후후, 당신에 대해서라면 뭐든… 다 알아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/home.ogg"},"hp 경고":{"voiceline":"손상은… 아직 허용 범위 안이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/hp_warning.ogg"},"로그인":{"voiceline":"이게 오늘 일정이야. 평소 페이스대로 함께 해치워 나가자구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/login.ogg"},"실패":{"voiceline":"지휘관, 시행착오는 아직 얼마든 겪을 수 있어. …그래, 아무 문제 없으니까 기운 내.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/lose.ogg"},"우편":{"voiceline":"우편을 가지고 왔어. 어머, 그렇게 기쁜 표정을… 뭐 좋은 소식이라도 있었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/mail.ogg"},"임무":{"voiceline":"새로운 임무야. 일정표에 추가해뒀어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/mission.ogg"},"임무완료":{"voiceline":"임무 완료야. …응, 이 정도는 쉽지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/mission_complete.ogg"},"서약":{"voiceline":"이렇게 격렬한 감정을 느껴본 게 얼마 만인지…. 감사를 표할게, 지휘관. 만약 언젠가, 내가 감정의 온기를 잊어버린다고 해도, 당신이라면 분명 다시 기억할 수 있게 해주겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/propose.ogg"},"스킬":{"voiceline":"불안정한 요소는… 당장 제거해야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/skill.ogg"},"터치1":{"voiceline":"왜? …무슨 일 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/touch.ogg"},"터치2":{"voiceline":"어머, 지휘관. 외로웠어? …그래, 지휘관도 그럴 때가 있구나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/touch2.ogg"},"입수시":{"voiceline":"멤피스야. 지휘관은 내가 낯선 사람처럼 느껴질지도 모르겠지만, 당신에 대해서는 잘 알고 있어. 걱정하지 마. 이상한 사람은 아니니까 믿어주길 바라. 앞으로 당신을 착실히 보좌하며 호위해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/unlock.ogg"},"강화성공":{"voiceline":"강화에 성공했네. …응, 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼네…. 어머? 후훗, 이래 봬도 확실히 기뻐하고 있다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7