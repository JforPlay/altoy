[{"클뜯 id":201270,"클뜯 함순이 id":20127,"함순이 이름":"머스킷티어","한글 함순이 + 스킨 이름":"머스킷티어","영문 함순이 + 스킨 이름":"Musketeer","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201270/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201270/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201270/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201270/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201270/shipyard.png","설명":"M급 구축함 · 머스킷티어 (G86)","자기소개":{"voiceline":"로열 네이비 M급 구축함, 머스킷티어! 노스케이프 해전 참가 경험 있음! 지휘관, 이 머스킷티어가 파~앙 파~앙! 하고 당신의 어두운 마음을 꿰뚫어버릴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/profile.ogg"},"메인1":{"voiceline":"오늘은 좋은 일이 일어날 거야~ 응, 그런 느낌이 들어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/main1.ogg"},"메인2":{"voiceline":"언제나 웃고 있다고? 헤헤헤~왜냐면 여기 오고 나서 부턴 늘 즐거운걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/main2.ogg"},"메인3":{"voiceline":"전투 중에 입었던 상처? 헤헤헤~전혀 아프지 않다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/main3.ogg"},"전투개시":{"voiceline":"얏호~그럼~사격 준비~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/battle.ogg"},"상세확인":{"voiceline":"지휘관, 나와 함께 있으면 즐거워? ……아…미안, 지금 건 잊어줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/detail.ogg"},"드랍 설명":{"voiceline":"M급 구축함 · 머스킷티어 (G86)","voicelink":null},"의뢰 완료":{"voiceline":"와아! 보너스가 한가득! 연료로 목욕탕 만들어도 되겠다!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/expedition.ogg"},"실망":{"voiceline":"빨리……예전의 지휘관으로 돌아와……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/feeling1.ogg"},"낯섦":{"voiceline":"무슨 일이 있어도 적극적이고 기운 넘치고 긍정적으로! 응, 그래야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/feeling2.ogg"},"호감":{"voiceline":"지휘관과 함께 있으면 언제나 즐거워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/feeling3.ogg"},"기쁨":{"voiceline":"고민하는 것보다, 역시 즐겁게 사는 편이 좋잖아! 있잖아, 지휘관도 그렇게 생각하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/feeling4.ogg"},"사랑":{"voiceline":"지휘관과 만나고 뭔가 되게 많은 일이 있었지…그래도, 진짜 나는 아~무것도 안 변했다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 내 새로운 군무를 봐줘! 괜찮아! 이번엔 빈총이니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 좋은 아침~! 오늘도 좋은 날씨네~ 철컥철컥…팡! 후~ 왠지 나, 항상 하이텐션이네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/login.ogg"},"실패":{"voiceline":"나홀로 몰래 탈출~♫","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/lose.ogg"},"우편":{"voiceline":"흐흥~♪ 그러니까 오늘은 좋은 일이 일어난다니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/mail.ogg"},"임무":{"voiceline":"한번에 끝내버리자~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/mission.ogg"},"임무완료":{"voiceline":"헤헤헤~ 돈을 보고 기뻐하는 건 사람의 본능이지! 그래! 지휘관도 웃어 웃어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/mission_complete.ogg"},"서약":{"voiceline":"지휘관 고마워! 지금까지 받은 것 중에 가장 소중한 거야! 저기, 나도 지휘관에게 즐거운 추억을 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201270/propose.ogg"},"스킬":{"voiceline":"장전 완료~ 발사 준비~!","vo