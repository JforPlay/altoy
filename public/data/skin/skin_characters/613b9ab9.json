[{"클뜯 id":405050,"클뜯 함순이 id":40505,"함순이 이름":"비스마르크 Zwei","한글 함순이 + 스킨 이름":"비스마르크 Zwei","영문 함순이 + 스킨 이름":"Bismarck Zwei","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405050/shipyard.png","설명":"비스마르크급 전함-비스마르크","자기소개":{"voiceline":"힘을 좇아 지옥에 떨어져, 마지막 순간이 되어서야 내 어리석음을 탓했지만 때는 이미 늦었지……. 이렇게 다시 태어날 수 있을 줄은 생각도 못 했어. 잠든 동안 여러 가지를 놓친 것 같지만, 지금의 난 모든 걸 짊어질 각오가 되어 있어. 같은 지도자인 네가 길을 알려준다면 그보다 더 고마운 일은 없을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/profile.ogg"},"메인1":{"voiceline":"동료들의 기대를 한 몸에 받는 지도자끼리니까 심적으로 통하는 부분도 많겠지. 다른 사람에게는 말 못 할 일이라도 생기면 뭐든 내게 털어놔.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/main1.ogg"},"메인2":{"voiceline":"게리온이 얌전히 있어 주질 않네. …레겐스부르크, 지난번에는 어떻게 진정시켰어? 한 번만 더 해주지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/main2.ogg"},"메인3":{"voiceline":"오이겐은 내 오른팔이라고도 할 수 있는 아이지만, 무슨 생각을 하는지 좀처럼 종잡을 수 없을 때도 있고, 때론 난처하게 만들어……. 네 생각도 그래? 후후, 그 아이에 대해서는 서로 의견이 일치하는 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/main3.ogg"},"전투개시":{"voiceline":"내 앞을 가로막는 용기만은 칭찬해 주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/battle.ogg"},"상세확인":{"voiceline":"전용 업무 공간? 아, 딱히 필요 없어. 특별 취급 받는 거야 그렇다 치고, 당신과 함께 일하는 거, 사실은 꽤 즐기고 있거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/detail.ogg"},"드랍 설명":{"voiceline":"비스마르크급 전함-비스마르크","voicelink":null},"의뢰 완료":{"voiceline":"병참 물자가 도착했어. 시간 아끼지 말고 나랑 같이 마중하러 나가자. 네가 있어주는 게 그 아이에게 있어서는 최고의 격려니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/expedition.ogg"},"실망":{"voiceline":"총명한 지도자로 여기며 본으로 삼고 있었어. 지금 생각하니 아무래도 잘못 본 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/feeling1.ogg"},"낯섦":{"voiceline":"특별 취급은 바라지 않아. 계속 다른 동료들처럼 대해주면 돼. …그래, 지휘관. 당신과의 협동, 앞으로 기대하고 있을게. ……서로 좋은 친구가 될 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/feeling2.ogg"},"호감":{"voiceline":"가끔 당신이 적으로 돌아섰을 때 어떻게 해야 할지 상상하고는 해. 뭐, 일종의 '가상의 적' 훈련 목적이긴 하지만… 생각하면 생각할수록 같은 편에 서길 잘했다는 기분이 들어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/feeling3.ogg"},"기쁨":{"voiceline":"오전 공무 중에도 오후 커피 타임 중에도, 서로 별 이야기를 다 했지. 응, 이렇게 숨김없이 속마음을 털어놓다니, 지도자로 행동할 때는 상상도 할 수 없는 일이야. 후후후, 너와 함께하는 시간은 늘 즐겁게 느껴져.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/feeling4.ogg"},"사랑":{"voiceline":"가능하면 네가 이대로 내 곁에 머물면서, 등을 맡길 수 있는 전우나, 이야기를 나눌 수 있는 친구뿐만이 아닌…… 휴우. 아무것도 아니야. 내 말뜻이 뭔지 알았으면 그걸로 됐어. 난… 아직 이런 건 서툰 것 같네…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/feeling5.ogg"},"터치3":{"voiceline":"이 군모 한번 써볼래? ……후후, 잘 어울리네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔네. 시간 있으면 전투 회고 좀 정리해 줄래? 음… 난 적의 입장에서 더 좋은 전술은 없는지 검토해 볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/home.ogg"},"hp 경고":{"voiceline":"메탈 블러드의 긍지는 그 누구도 상처 입힐 수 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘 업무를 시작하자. 이렇게 규모가 큰 모항에는 지휘관의 관리가 필요해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/login.ogg"},"실패":{"voiceline":"모든 책임을 나 혼자 지려는 건 아니야…. 그렇지만 철수 행렬의 후미는 내가 지키겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/lose.ogg"},"우편":{"voiceline":"새로운 우편이 온 것 같아. 어서 확인해. 중요한 정보를 놓쳐선 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/mail.ogg"},"임무":{"voiceline":"새 임무? 괜찮으면 나한테도 보여줘. 도움이 될 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어. 보상 수령하는 거 잊지 마. 그건 네가 받아 마땅한 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/mission_complete.ogg"},"서약":{"voiceline":"네 결심도, 네 감정이 어떤지도 잘 알아. 그렇지만…… 이 중요한 의식에서 어떻게 해야 네 기대에 부응할 수 있을지 모르겠어. 응, 비스마르크가 웬일로 부탁을 다 하네 싶겠지만…… 후후, 에스코트를 부탁해도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/propose.ogg"},"스킬":{"voiceline":"진리는 내 사정거리 안에 있다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/skill.ogg"},"터치1":{"voiceline":"Schwert(검)… 신경 쓰여? 괜찮으면 너도 휘둘러 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/touch.ogg"},"터치2":{"voiceline":"일부러 난처하게 하려는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/touch2.ogg"},"입수시":{"voiceline":"Guten Tag. 메탈 블러드 전함 비스마르크야. 오늘 처음 본 사이도 아닌데, 내 새로운 모습에 놀라기라도 한 거야? 뭐, 서로 이상을 짊어진 존재로서 이렇게 다시 손을 잡을 수 있어서 기뻐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/unlock.ogg"},"강화성공":{"voiceline":"정기 점검 시간이네. 게리온, 조용히 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아, 길은 열렸다. 전진하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/win_mvp.ogg"},"전투개시_ex":{"voiceline":"나 비스마르크가 다시 이 전장에 돌아왔다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/battle_ex.ogg"},"상세확인_ex":{"voiceline":"일이 일단락되면 어디 가고 싶은 곳이라도 갈까? 기분 전환도 할 겸…… 데이트 신청? 그, 그렇게 생각해? 아, 그래… 그렇게 생각해도 상관없어….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 무사히 귀환했어. 같이 마중하러 나가자. 다들 널 기다리고 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":{"voiceline":"메탈 블러드의 지도자라는 자의 머리를 지휘관이 쓰다듬고 있네. 이런 모습을 누가 보기라도 하면…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관, 고생했어. 회고해야 할 부분은 꽤 있지만, 지금은 휴식 시간을 즐기자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘은 뭐 마실래? 홍차? 아니면 커피? 후훗, 이 비스마르크에게 심부름을 시킬 수 있는 건 당신 정도뿐이니까, 특별 서비스랄까…… 응? 그런 의미가 아니라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/login_ex.ogg"},"실패_ex":{"voiceline":"지휘관, 모두를 이끌고 철수하자. 이대로 무리해봤자 승산은 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/lose_ex.ogg"},"우편_ex":{"voiceline":"새로운 우편인가? 멀리서 널 생각하는 사람이 보낸 걸지도 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/mail_ex.ogg"},"임무_ex":null,"임무완료_ex":null,"스킬_ex":{"voiceline":"전함 비스마르크, 미래를 개척하리라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/skill_ex.ogg"},"터치1_ex":{"voiceline":"이건….. 무슨 의미야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/touch_ex.ogg"},"터치2_ex":{"voiceline":"이럴 때는 어떻게 해야……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"앞을 가로막는 적은 모두 섬멸했어. 지휘관, 다음 지시를 내려줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['프린츠 오이겐'] : 오이겐, 여전하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/couple_encourage1.ogg"},{"voiceline":"['티르피츠'] : 티르피츠, 같이 싸워줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/couple_encourage2.ogg"},{"voiceline":"['그나이제나우·META', '샤른호르스트·META'] : 너희가 알고 있는 비스마르크는 아니지만, 그래도 힘을 빌려줬으면 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/couple_encourage3.ogg"},{"voiceline":"['U-556'] :  기사의 약속, 계속 기억하고 있구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/couple_encourage4.ogg"},{"voiceline":"['U-556·META'] :  무슨 일이 있어도 내가 지켜줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/couple_encourage5.ogg"},{"voiceline":"['프리드리히 데어 그로세'] :  같이 싸우는 게 얼마 만이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/couple_encourage6.ogg"},{"voiceline":"['울리히 폰 후텐'] :  메탈 블러드는 내 아래에서 눈부신 미래로 향할 거야. 네 힘도 필요해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/couple_encourage7.ogg"}],"메인4":{"voiceline":"과거의 아픔도 이 힘이 있다면 다시 되돌릴 수 있어. 잠깐, 지금 티르피츠랑 같이 커피라도 마시러 가자고? 음....... 잠깐 마음 정리할 시간 좀 줘.......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"가끔은 블뤼허가 부러워. 그 아이는 늘 솔직하게 자기 마음을 털어 놓는데, 난…… 후후후, 너도 역시 내가 그런 식으로 변하진 않았으면 하는… 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/main6_ex.ogg"},"메인7_ex":{"voiceline":"이번에는 U-556을 위해 시간을 내서…… 응? 오늘은 U보트들이 숨바꼭질 대회를 하는 날이라고? …이거, 음…… 아무래도 날을 다시 잡는 편이 좋겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/main7_ex.ogg"},"메인8_ex":{"voiceline":"같은 음악을 들으면 마음도 같은 방향으로 향하곤 해……. 지휘관, 한번 해볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"마음을 안정시켜 주는 느릿한 선율의 클래식을 좋아해. 전쟁도... 그래, 언젠가는 분명 이 평온함 속에서 마침표를 찍겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405050/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"UR","ex_chat_status":1},{"클뜯 id":405051,"클뜯 함순이 id":40505,"함순이 이름":"비스마르크 Zwei","한글 함순이 + 스킨 이름":"청명한 뷘트슈틸레","영문 함순이 + 스킨 이름":"Crystal-Clear Holiday","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405051/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405051/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405051/shipyard.png","설명":"아, 지휘관. 벌써 수영복으로 갈아입었네. 난…… 음, 미안해. 일단 들어갔다 왔는데, 머리를 좀 어떻게 해야 할 것 같네……","자기소개":null,"메인1":{"voiceline":"수영장에서 잠수함 애들이 노는 이야기를 U-556에게 들었어. 확실히 재밌을 것 같긴 하지만, 내가 거기 참여하긴 좀 어렵다는 걸 어떻게 해야 그 아이에게 이해시킬 수 있을까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/main1.ogg"},"메인2":{"voiceline":"수영복? 응, 물론 내가 직접 고른 거야. 사실 오이겐에게 조언을 구하긴 했지만, 오이겐이 추천한 건 다…… 뭐랄까… 좀 아슬아슬하고 입으면 이상하게 쳐다볼 것 같은 것뿐이라……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/main2.ogg"},"메인3":{"voiceline":"그러고 보니, 지금 우리가 하는 건 '데이트'라고 해도 되려나? ……그렇게 생각하니까 갑자기 긴장되네....","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/main3.ogg"},"전투개시":{"voiceline":"긴급출동이야. 게리온, 따라와.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/battle.ogg"},"상세확인":{"voiceline":"수영장은 내가 통째로 빌렸어. 응, 나도 방해받고 싶지 않은 때도 있고, 특히 지금은…… 무슨 말인지, 알지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/detail.ogg"},"드랍 설명":{"voiceline":"아, 지휘관. 벌써 수영복으로 갈아입었네. 난…… 음, 미안해. 일단 들어갔다 왔는데, 머리를 좀 어떻게 해야 할 것 같네……","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"잠깐만, 머리카락이 아직 축축하다고…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 수영장 바닥은 미끄러우니까 넘어지지 않도록…… 휴우, 그러니까 내가 뭐라 그랬어. 후후, 조심하라고 했지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"수영장 온도는 딱 좋아. 지휘관, 준비운동한 다음에 마음껏 휴식을 즐기도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/login.ogg"},"실패":{"voiceline":"나름 컨디션을 잘 조절한 줄 알았는데, 역시 만전을 기하지 않으면 전투는 무리인 것 같아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/lose.ogg"},"우편":{"voiceline":"우편? 수고스럽게 여기까지…… 손이 마르면 열어보자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405051/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"수영하기 싫으면 잠깐 이렇게 나랑 같이 앉아 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLan