지휘관이 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701061/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"하아아아… 응? 벌써 시간이 이렇게? 좋아, 게임을 시동하고, 세이브!…가 아니라, 일할 준비를 해야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701061/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"앗, 지휘관, 언제 온 거야! 어서 같이 게임 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701061/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"… 또, 또 한 번 죽으면 나랑 바꿔야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701061/touch.ogg"},"터치2":null,"입수시":{"voiceline":"눈이 없는 날은 정말 심심해... 됐어, 게임이나 하면서 기분 좀 풀어야지! 지휘관, 이 게임들 완전 재미있어, 나랑 같이 놀자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701061/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"홈웨어","상점 id":70516,"상점 카테고리 id":20,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"SN","레어도":"SR","ex_chat_status":0},{"클뜯 id":701062,"클뜯 함순이 id":70106,"함순이 이름":"스트례미텔니","한글 함순이 + 스킨 이름":"야간 간호 당직 중","영문 함순이 + 스킨 이름":"Nurse on the Night Shift","스킨 타입":"Hospital Series","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701062/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701062/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701062/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701062/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701062/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701062/shipyard.png","설명":"헉?! 지휘관, 여기까지 혼자 힘으로 온 거야?! 몸 상태가 안 좋으면 콜 버튼을 누르면 되잖아…… 어휴, 상태도 안 좋은데 이런 한밤중에 걸어 다니기나 하고! 흥흥!","자기소개":null,"메인1":{"voiceline":"약은 꼭 시간에 맞춰서 먹어야 해. 안 그러면 눈덩이를 확… 농담이야♪ 지휘관은 지금 환자니까, 내가 잘 보살펴 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/main1.ogg"},"메인2":{"voiceline":"……야간 당직 서느라 지루하지 않냐고? 아니야, 이건 간호사로서의 업무니까 지휘관은 걱정할 거 없어. 약 먹고 푹 쉬어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/main2.ogg"},"메인3":{"voiceline":"아직 머리 아프면 이 새로운 약을 시도해 보는 건 어때? 효과가 꽤 잘 든데! 후훗… 지휘관, 혹시 주사가 무서워서 그러는 거야? 나는 하나도 안 무서운데? 에헤헷!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"잠깐만 기다려~ 지금 약 복용 시 주의 사항과 대조하면서 지휘관의 증상과 몸 상태를 확인하는 중이야! 약은 허투루 쓰면 안 되잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/detail.ogg"},"드랍 설명":{"voiceline":"헉?! 지휘관, 여기까지 혼자 힘으로 온 거야?! 몸 상태가 안 좋으면 콜 버튼을 누르면 되잖아…… 어휴, 상태도 안 좋은데 이런 한밤중에 걸어 다니기나 하고! 흥흥!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"약 먹고 어서 나아! 건강해지면 또 같이 눈사람을 만들자! 에헤헤, 다음에 어떤 눈사람을 만들지는 이미 정했어! 둘이 꼭 껴안는 느낌으로 만들 거야! 어떻게 꼭 껴안는지는…… 음…… 다 나으면 같이 생각해 보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/feeling5.ogg"},"터치3":{"voiceline":"지금 나는 한 사람 몫을 다하는 어엿한 간호사야! 간호에 필요한 건 한 차례 공부했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/headtouch.ogg"},"모항귀환":{"voiceline":"아직 머리 아파? 음…… 마사지는 두통에 효과가 있다고 다들…… 좋아, 지휘관. 마사지 해줄 테니까 빨리 누워! ……뭐? 내 무릎을 베고 싶다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 어서 앉아! 지금 진통제를 가지고 올게! 음, 분명 여기 뒀을 텐데…… 찾았다~ 물도 가지고 왔으니까 어서 마셔.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"아픈데 임무가 아직 이렇게나 많구나…… 지휘관도 정말 힘들겠다! 내가 도와줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"방으로 돌아가려고? 데려다줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/touch.ogg"},"터치2":{"voiceline":"아직 이런 짓을 할 기력이 남아 있는 거야?! 지휘관, 설마 꾀병인 건……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/touch2.ogg"},"입수시":{"voiceline":"헉?! 지휘관, 여기까지 혼자 힘으로 온 거야?! 몸 상태가 안 좋으면 콜 버튼을 누르면 되잖아…… 어휴, 상태도 안 좋은데 이런 한밤중에 걸어 다니기나 하고! 흥흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701062/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"병원","상점 id":0,"상점 카테고리 id":15,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SR","ex_chat_status":0}]