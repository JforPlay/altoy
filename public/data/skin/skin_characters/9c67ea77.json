[{"클뜯 id":108050,"클뜯 함순이 id":10805,"함순이 이름":"알바코어(μ장비)","한글 함순이 + 스킨 이름":"알바코어(μ장비)","영문 함순이 + 스킨 이름":"Albacore μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108050/shipyard.png","설명":"아이돌 알바코어, 두! 둥! 등! 장! 하하, 드디어 여기까지 왔구나! 아? 지휘관, 더 좋은 오프닝 아이디어라도 있어? 얼른 말해줘~","자기소개":{"voiceline":"아이돌 활동 중인 잠수함 알바코어야! 반짝반짝하는 아이디어와 독창성, 그리고 언제나 진심으로 활동하고 있지! 노래나 연출, 춤도 모두 맡겨달라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/profile.ogg"},"메인1":{"voiceline":"서프라이즈 타임! 알바코어가 만든 최신 아이템이야! 어때~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/main1.ogg"},"메인2":{"voiceline":"이 의상은 모두 다이도가 직접 만든 거야! …하지만 저 장난감은 대체 뭐지…? 진짜 궁금하네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/main2.ogg"},"메인3":{"voiceline":"다이호의 콘서트에 가고 싶어~ 지휘관, 지휘관! 나중에 같이 가자♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/main3.ogg"},"전투개시":{"voiceline":"기관 설치 오케이, Let's go!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/battle.ogg"},"상세확인":{"voiceline":"아이돌 활동이 바빠서 장난칠 기회가 줄었다고? 흥흥, 전부 다 해야 진정한 아이돌이지! 새러토가가 가장 좋은 모범 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/detail.ogg"},"드랍 설명":{"voiceline":"아이돌 알바코어, 두! 둥! 등! 장! 하하, 드디어 여기까지 왔구나! 아? 지휘관, 더 좋은 오프닝 아이디어라도 있어? 얼른 말해줘~","voicelink":null},"의뢰 완료":{"voiceline":"헤헤, 의뢰조 마중인가… 돌발 공연의 예감이 들어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/expedition.ogg"},"실망":{"voiceline":"일러스트리어스 일행 조차도 힘들어 한다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/feeling1.ogg"},"낯섦":{"voiceline":"아이돌은 진짜 최고야! 춤추고 노래하면서 모두에게 미소를~ 에? 전혀 나같지 않다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/feeling2.ogg"},"호감":{"voiceline":"오, 지휘관의 응원 선물! 진짜 세심하네~ 아, 모두가 열심히 레슨 받고 있을 때 내가 딴청 피우고 있었다는 건 비밀이야☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/feeling3.ogg"},"기쁨":{"voiceline":"헷, 안녕 지휘관~! \"데이트 계획\" 스케쥴을 잊어버린 건 아니지? 멤버들의 몸과 멘탈을 챙겨주는 것도 프로듀서가 해야 할 일이야~ 다른 멤버들은 내가 같이 챙겨줄테니까 꼭 체크하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/feeling4.ogg"},"사랑":{"voiceline":"지휘관을 위해서 반드시 톱 아이돌이 되어 무대 위에서 반짝반짝 빛나겠어…! 장난이야☆ 진짜~ 지휘관, \"모두\"가 함께 톱 아이돌이 되어야 하지 않겠어? 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관의 다음 말은 \"왜 알바코어는 지휘관에게 대사를 요구하는 거지?\" 겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/home.ogg"},"hp 경고":{"voiceline":"우와아, 실수했어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침, 프로듀서! 오늘도 같이 힘내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/login.ogg"},"실패":{"voiceline":"이럴 때 해야 하는 선택은… 치욕스럽지만 유용한 전술!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/lose.ogg"},"우편":{"voiceline":"타슈켄트, 지휘관의 우편 어디다 뒀어? …아, 지휘관! 난 아무것도 안 했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/mail.ogg"},"임무":{"voiceline":"오퍼가 왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/mission.ogg"},"임무완료":{"voiceline":"오퍼 완료! 아~ 힘들어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/mission_complete.ogg"},"서약":{"voiceline":"음? 아이돌은 \"연애 금지\"라고? 됐어, 우리는 아이돌이지만 \"함선\"이잖아~ 문제 없어! 그러니까~ 반지는 받아둘게~ 앞으로도 잘 부탁해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/propose.ogg"},"스킬":{"voiceline":"소리 질러!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/skill.ogg"},"터치1":{"voiceline":"지휘관의 응원 고마워☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/touch.ogg"},"터치2":{"voiceline":"내가 여기서 \"성희롱이야\" 하고 크게 외치면 지휘관은…… 어떻게 될까? 흐흥~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/touch2.ogg"},"입수시":{"voiceline":"아이돌 알바코어, 두! 둥! 등! 장! 하하, 드디어 여기까지 왔구나! 아? 지휘관, 더 좋은 오프닝 아이디어라도 있어? 얼른 말해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/unlock.ogg"},"강화성공":{"voiceline":"아이돌… 레벨업!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"다음 적을 향해서~ 앵콜~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['다이호(μ장비)'] : 아, 다이호! 나랑 같이 그룹 안 할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108050/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":nu