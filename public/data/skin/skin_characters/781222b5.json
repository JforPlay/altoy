[{"클뜯 id":107170,"클뜯 함순이 id":10717,"함순이 이름":"벙커힐","한글 함순이 + 스킨 이름":"벙커힐","영문 함순이 + 스킨 이름":"Bunker Hill","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107170/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107170/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107170/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107170/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107170/shipyard.png","설명":"에식스급 항공모함 - 벙커힐(CV-17) ","자기소개":{"voiceline":"에식스급의 벙커힐이다. 이름은 그 옛날 독립전쟁의 전장에서 따왔지. 활약한 전투는 많다만… 슬픔과 고통을 부르는 전쟁 이야기일 뿐이다. 길게 말할 필요는 없겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/profile.ogg"},"메인1":{"voiceline":"오늘도 어딘가는 전쟁의 불꽃에 휩싸여있겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/main1.ogg"},"메인2":{"voiceline":"엘드릿지의 능력? 잘은 모르겠다만…… 어디선가 본 것 같은……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/main2.ogg"},"메인3":{"voiceline":"에식스급 공격 항공모함 편대 앞에서 저항 따윈 무의미하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/main3.ogg"},"전투개시":{"voiceline":"어째서 적이 되는 길을 택한 거냐……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/battle.ogg"},"상세확인":{"voiceline":"지휘관, 왜 날 빤히 보는 거지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/detail.ogg"},"드랍 설명":{"voiceline":"에식스급 항공모함 - 벙커힐(CV-17)","voicelink":null},"의뢰 완료":{"voiceline":"잠깐 실례, 의뢰에서 돌아온 아이들을 마중하고 오겠다. 넌 여기서 결과만 기다리면 된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/expedition.ogg"},"실망":{"voiceline":"지금은 얘기하고 싶지 않다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/feeling1.ogg"},"낯섦":{"voiceline":"인간의 전쟁에 아름다움 따윈 존재하지 않아. 서로 상처입히고, 서로 죽이는 추악한 면만 존재할 뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/feeling2.ogg"},"호감":{"voiceline":"…나의 침묵은 초조함을 의미하는 것은 아니다. 생각에 잠겼거나, 아니면 생각에 잠겼다는 걸 어떻게 말해야 할지 생각에 잠긴 것뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/feeling3.ogg"},"기쁨":{"voiceline":"요즘엔 묘하게, 사고할 때 자꾸 방해받는 느낌이 든다. 생각에 잠겨 있으면, 나도 모르게 누군가의 얼굴이 떠올라서, 냉정함을 잃게 된다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/feeling4.ogg"},"사랑":{"voiceline":"싸움을 위해 태어난 우리들에겐, 전투 이외의 존재 가치 같은 건 없다고 생각했었다. 너와 함께 하는 나날을 보내면서, 우리들에겐 싸우는 것 이외에도 살아갈 가치가 있다는…… 그런… 느낌이 든다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔나. ……그럼, 다음 출격 준비를 해볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/home.ogg"},"hp 경고":{"voiceline":"이런 때에……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/hp_warning.ogg"},"로그인":{"voiceline":"지금은 비상시다. 휴일에도 '홀리데이 익스프레스'의 각오를 해두도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/login.ogg"},"실패":{"voiceline":"그 힘……'용의 턱(드래곤 죠스)'조차 능가하는 강적이란 건가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/lose.ogg"},"우편":{"voiceline":"우편… 새로운 정보는 있나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/mail.ogg"},"임무":{"voiceline":"임무… 빨리 처리하는 편이 좋다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/mission.ogg"},"임무완료":{"voiceline":"보수가 많다고? 당연한 결과다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/mission_complete.ogg"},"서약":{"voiceline":"미안… 머릿속이 새하얗다. 큭, 대체 무슨 말을 해야…… 그래! '널 향한 충성과 사랑은 영원할 거다'…… 이걸로 됐나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/propose.ogg"},"스킬":{"voiceline":"발버둥 치지 마라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/skill.ogg"},"터치1":{"voiceline":"……나의 침묵은 초조함을 의미하는 것은 아니다. 용건이 있다면 말해다오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/touch.ogg"},"터치2":{"voiceline":"아무래도 지휘관에겐 기억에 남는 '체험'이 필요한 모양이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/touch2.ogg"},"입수시":{"voiceline":"에식스급의 일원인 이 벙커힐, 함대에 합류하여 네 지휘하에 들어왔다. 걱정 마라. 곧 너도 내 실력을 보게 될 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/unlock.ogg"},"강화성공":{"voiceline":"다시… 강해졌나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/upgrade.ogg"},"vote":null,"승리":{"voiceline":"너희들이 선택한 결말은 이런 건가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['에식스', '샹그릴라'] : 에식스급 앞에서 너희들은 무력하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/couple_encourage1.ogg"},{"voiceline":"['엘드릿지'] : 레인보우 플랜?… 어감이 좋군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107170/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,