[{"클뜯 id":201360,"클뜯 함순이 id":20136,"함순이 이름":"히어로","한글 함순이 + 스킨 이름":"히어로","영문 함순이 + 스킨 이름":"Hero","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201360/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201360/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201360/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201360/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201360/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201360/shipyard.png","설명":"H급 구축함 - 히어로","자기소개":{"voiceline":"엥, 지휘관은 히어로인 내 함력이 궁금한 거야? 어쩔 수 없네. 에헴, 옛날에는 여러 전함을 호위했고, 그 후에는 '엑세스 작전'에도 참가했지…. 뭐, 사실은 항구에서 느긋하게 10월의 햇살을 만끽하고 싶었지만~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/profile.ogg"},"메인1":{"voiceline":"이거? 히어로한테는 히어로만의, 용사에게는 용사만의 검이 있는 법이지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/main1.ogg"},"메인2":{"voiceline":"집무실은 참 재밌어~ 비서함이랑 단둘이 있는 공간에선 조역 지휘관이 무슨 짓을 해도 안 들키겠지? 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/main2.ogg"},"메인3":{"voiceline":"하디 귀엽지~ 특히 그 케이크를 먹고는 싶지만, 이미지를 신경 써버렸을 때의 모습이라던가~ 나? 히어로는 뭘 하든 딱히 신경 안 쓰는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/main3.ogg"},"전투개시":{"voiceline":"순 잡몹들 뿐이잖아. 간다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/battle.ogg"},"상세확인":{"voiceline":"왜 그래? 히어로인 나한테 부탁할 거라도? 헤헤헤~ 즐겁게만 해준다면 못 도와줄 것도 없는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/detail.ogg"},"드랍 설명":{"voiceline":"H급 구축함 - 히어로","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어~ 있잖아, 지휘관. 쟤네 방치해둬도 괜찮은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/expedition.ogg"},"실망":{"voiceline":"흐음~ 겨우 이 정도로 벌써 고장난 거야? 시시하네. 뭐, 다른 재밌는 거라도 하러 가야겠다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/feeling1.ogg"},"낯섦":{"voiceline":"엥~ 지휘관, 날 보러 왔다고? 기쁘긴 하지만~ 심술쟁이 히어로인 난 겨우 만나러 와준 정도로는 고맙게 생각하지 않는걸~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/feeling2.ogg"},"호감":{"voiceline":"엥~ 지휘관, 또 날 보러 왔어? 혹시 무슨 고민이 있는데, 그걸 들어줄 사람이 없어서 히어로인 나한테 도움을 요청하러 온 거야? 에헤헤, 지휘관. 너무 불쌍한 거 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/feeling3.ogg"},"기쁨":{"voiceline":"엥~ 지휘관 말이야, 진짜 이상해~ 사실은 누구한테든 친절하게 대하는 것뿐? 내가 심술쟁이라서 마음이 안 놓여? 아니면…… 에헤헤, 지휘관이 뭘 생각하는지 난 다 알고 있거든?♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/feeling4.ogg"},"사랑":{"voiceline":"지휘관 말이야, 때론 심술 좀 부려도 손해 볼 거 없다구. 내가 얼~마나 많이 지휘관을 괴롭혔는데, 왜 받아치질 않는 건데? 아… 설마… 지휘관한테는 업계 포상 같은 거야? 정말 그런 거면 지휘관은 진짜 구제 불능인 변태 어른인 거네~♪ 후훗, 아하하♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/feeling5.ogg"},"터치3":{"voiceline":"헤에~ 지휘관은 이런 수법으로 순진한 애들을 농락해온 거구나~ 뭐, 나한테는 안 통할걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/headtouch.ogg"},"모항귀환":{"voiceline":"이기고 돌아왔네. 다른 애들이 조역 지휘관을 동경하는 이유를 조금은 알 것 같네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/home.ogg"},"hp 경고":{"voiceline":"잡몹 주제에 히어로인 날 이기려고 하다니…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/hp_warning.ogg"},"로그인":{"voiceline":"엥, 지휘관? 조금만 더 있으면 남은 시간 0초였을텐데, 진짜 아쉽네~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/login.ogg"},"실패":{"voiceline":"전투에서 졌어~ 야, 조역 지휘관. 돌아가면 반성하는 거 잊지 말라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/lose.ogg"},"우편":{"voiceline":"우편함이 벌써 꽉 찼다고 지휘관한테 알려줄까~ 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/mail.ogg"},"임무":{"voiceline":"엥~ 지휘관, 아직 안 끝낸 퀘스트는 없는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/mission.ogg"},"임무완료":{"voiceline":"드디어 퀘스트를 해치웠네. 이렇게 질질 끄느라 지휘관도 수고 많았어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/mission_complete.ogg"},"서약":{"voiceline":"헤에~ 이젠 패배를 인정한 모양이네~ 헤헷, 역시 히어로인 나한테 조역인 지휘관이 이길 수 있을 리가 없지~ 연약하고 귀여운 잡몹 지휘관이라니, 히어로인 내가 제일 좋아해줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/propose.ogg"},"스킬":{"voiceline":"져라, 져♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/skill.ogg"},"터치1":{"voiceline":"헤에~ 지휘관은 납작하고 아무것도 없는 갑판 스타일이 좋은가봐? 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/touch.ogg"},"터치2":{"voiceline":"엥~ 왜 멈춘 거야? 나한테 복수하려고 한 거 아니었어? 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/touch2.ogg"},"입수시":{"voiceline":"저기~ 전혀 믿음직스럽지 않은 어른, 설마 당신이 내 지휘관은 아니지? 어쩔 수 없네~ 난 로열 소속 구축함 히어로야. 앞으로 잘 부탁할게~☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/unlock.ogg"},"강화성공":{"voiceline":"헤에~ 날 레벨업 시키는 걸 까먹은 줄 알았잖아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/upgrade.ogg"},"vote":null,"승리":{"voiceline":"MVP? 그런 것쯤 히어로인 나한테는 쉬운 일이지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201360/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관, 나 케이크 먹고 싶어~ 에헤헤, 얼마 전에 하디가 먹었던 한정판 케이크로 부탁해♪ 사다주면 나한테 시키고 싶은 거 다 시켜도 돼~","voicelink":"https:/