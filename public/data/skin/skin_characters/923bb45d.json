ine":"핼러윈 정도는 너그럽게 봐줄게. 내일부터는 농땡이 피우지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205031/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지금, 이상한 행동 하나라도 하면……봐주지 않을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205031/touch.ogg"},"터치2":{"voiceline":"이 호박처럼 되고 싶은 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205031/touch2.ogg"},"입수시":{"voiceline":"이 의상…… 하아, 됐어. 모처럼 만의 축제인데, 여흥이 없으면 분위기가 깨질 거 아냐. 말해두겠지만, 딱히 참가하고 싶어서 온 건 아니라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205031/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"할로윈","상점 id":70116,"상점 카테고리 id":8,"스킨 태그":"X","입수 영상":"X","재화":700,"기간":"상시","진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":205032,"클뜯 함순이 id":20503,"함순이 이름":"넬슨","한글 함순이 + 스킨 이름":"파랑과 금빛의 여름 라이트","영문 함순이 + 스킨 이름":"Azure & Gold Summer Night","스킨 타입":"Summer Fest","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205032/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205032/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205032/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205032/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205032/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205032/shipyard.png","설명":"…너, 제대로 즐기고 있는 거 맞아? 모처럼 불러냈는데, 네가 즐겁지 않으면 꿈자리가 사나우니까, 제대로 좀 즐겨봐! 뒤 좀 보라고? 응? 앗…!","자기소개":null,"메인1":{"voiceline":"그 춤… 후후훗, 다들 즐겁게 추고 있었지. 분명 '아와오도리'라고 했었나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/main1.ogg"},"메인2":{"voiceline":"사쿠라 엠파이어의 쪽빛 염색… 게다가 나한테 딱 맞는 이 유카타…. 훌륭한 장인의 솜씨가 분명해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/main2.ogg"},"메인3":{"voiceline":"예쁜 불꽃… 너도 잘 보고 있는 거지? 혼자 보는 것보단 둘이서 보는 게…. 차, 착각하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"로드니는 콜로라도네랑 같이 사격 게임 하러 갔어. 궁금하면 가보지 그래? …이, 인파 속에서 내가 널 놓치기라도 할 것 같아?! 게다가… 봐! 이, 이렇게 손도 꼭 잡고 있잖아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/detail.ogg"},"드랍 설명":{"voiceline":"…너, 제대로 즐기고 있는 거 맞아? 모처럼 불러냈는데, 네가 즐겁지 않으면 꿈자리가 사나우니까, 제대로 좀 즐겨봐! 뒤 좀 보라고? 응? 앗…!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료 시간이라고? 나, 나도 알아! 네가 굳이 말 안 해도 안다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"나랑 사귀려면 조금 더 분발할 필요가 있겠어. 우선은… 이건 데이트가 아니라, 사쿠라 엠파이어 축제를 네게 안내받고 있는 것뿐이야! 몇 번을 말해야 알겠어…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/feeling5.ogg"},"터치3":{"voiceline":"……읏?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/headtouch.ogg"},"모항귀환":{"voiceline":"로열 네이비의 늠름한 모습 봤느냐?! ……헉?! 지, 지금 건 못본 거로 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘은 신나게 놀고 가! 휴, 휴일에 제대로 쉴 줄도 모르는 미숙한 지휘관은 아닐 테니….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"미션이 왔네. 조금은 부하에게 맡기는 게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/mission.ogg"},"임무완료":{"voiceline":"보너스는 만쥬에게 맡겼어. 지금은 네가 없어지면…. 따, 딱히 곤란하다는 건 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"(휴우… 평소에 입는 옷도 그렇지만, 허리끈을 너무 조였나…. 유카타인데도 가슴이……)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/touch.ogg"},"터치2":null,"입수시":{"voiceline":"…너, 제대로 즐기고 있는 거 맞아? 모처럼 불러냈는데, 네가 즐겁지 않으면 꿈자리가 사나우니까, 제대로 좀 즐겨봐! 뒤 좀 보라고? 응? 앗…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205032/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"여름 축제","상점 id":70691,"상점 카테고리 id":10,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":205039,"클뜯 함순이 id":20503,"함순이 이름":"넬슨","한글 함순이 + 스킨 이름":"넬슨·改","영문 함순이 + 스킨 이름":"Nelson (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205039/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205039/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205039/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205039/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205039/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205039/shipyard.png","설명":"저, 저기… 언제까지 잘 거야?! 개조 다 끝났어. 흥, 네 덕분에 또 나랑 차이가 벌어진 것 같은데… 앞으로는 더 열심히 정진하라구! 알겠어?!","자기소개":null,"메인1":{"voiceline":"실패한 경험을 살리면 승리로 이끌 수 있어. 너도 그걸 잊지 마. (작은 목소리로) 무리하면 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205039/main1.ogg"},"메인2":{"voiceline":"이건… 웨스트버지니아의 기타 소리? 이런 것도 할 수 있구나…. 따, 딱히 부러워하는 거 아니거든! 착각하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205039/main2.ogg"},"메인3":{"voiceline":"데, 데, 데, 데이트?! 갑자기 무슨 말을 하는 거야?! 넌 다른 사람을 이끄는 사람으로서 자신을 단련하는 게 더 우선이라구! …그래! 나, 나도 같이 단련해 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205039/main3.ogg"},"전투개시":{"voiceline":"영광을 위해 같이 싸우자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205039/battle.ogg"},"상세확인":{"voiceline":"설마 지휘관에게 이런 취미가 있을 줄이야…. 그냥 내가 몰랐던 것뿐인가? 그렇다고 로드니한테 물어보긴 싫고… 그래. 차라리 지휘관을 한 번 더 밀어서… 꺅?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205039/detail.ogg"},"드랍 설명":{"voiceline":"저, 저기… 언제까지 잘 거야?! 개조 다 끝났어. 흥, 네 덕분에 또 나랑 차이가 벌어진 것 같은데… 앞으로는 더 열심히 정진하라구! 알겠어?!","voicelink":null},"의뢰 완료":{"voiceline":"책무를 무사히 완수해 준 동료들, 믿음직스럽네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205039/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"부, 분명 너랑 함께하고 있긴 하지만, 그건 업무상으로만 그런 거잖아?! 뭐, 네가 계속 열심히 하면 업무 외적으로도… 내 기대를 저버리지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205039/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"너, 아무리 지쳤다고 해도 쓰러질 정도까진…… 서, 설마 밟히고 싶은 거야?! 이 변태!! ///","voicelink":"https://raw.githubusercontent.com/Fe