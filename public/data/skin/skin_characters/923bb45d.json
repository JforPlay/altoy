[{"클뜯 id":205030,"클뜯 함순이 id":20503,"함순이 이름":"넬슨","한글 함순이 + 스킨 이름":"넬슨","영문 함순이 + 스킨 이름":"Nelson","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205030/shipyard.png","설명":"넬슨급 전함·넬슨 (HMS Nelson)","자기소개":{"voiceline":"나를 모른다면, 사관학교부터 다시 나와야겠네. 그런 지휘관은 필요 없으니까.\n발이 느리다고…!? 뭐? 잘도 말했겠다… 거기서 움직이지 마, 일단 이 한 발로, 깨닫게 해주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/profile.ogg"},"메인1":{"voiceline":"「실패」라는 이름의 경험? 그딴 건 패자의 변명에 불과해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/main1.ogg"},"메인2":{"voiceline":"너뿐만이 아냐, 도처에 널린 우정·노력을 지껄이는 범우들과 같다면, 이 자리에 있을 자격이 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/main2.ogg"},"메인3":{"voiceline":"능력에 맞는 일을 해야 하는 거야. 너는 아직 대임을 맡기엔 멀었어…… 자신을 좀 더 갈고 닦도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/main3.ogg"},"전투개시":{"voiceline":"모두가 자신의 의무를 다해주길 기대할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/battle.ogg"},"상세확인":{"voiceline":"뭐가 이상하다는 거야! 이 이상 보면 눈을 파버릴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/detail.ogg"},"드랍 설명":{"voiceline":"넬슨급 전함·넬슨 (HMS Nelson)","voicelink":null},"의뢰 완료":{"voiceline":"지─휘─관! 의뢰 완료 시간 까먹고 있던 것 아니야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/expedition.ogg"},"실망":{"voiceline":"너 말야… 이젠 뭐라고 해야 할지… 하아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/feeling1.ogg"},"낯섦":{"voiceline":"그러고도 지휘관이야? 웃기고 있네. 알겠어? 지휘관이란 건…… (1시간 후) 알았어? 그럼 한번 열심히 해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/feeling2.ogg"},"호감":{"voiceline":"이 정도로 내가…… 너 혼자서 이걸 한 거야? ……웃지 마! 이번만큼은 특별히 칭찬해줄게. 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/feeling3.ogg"},"기쁨":{"voiceline":"──뭐야, 자기 책임이 있는 일을 제대로 해내는 인간 정도는 칭찬해준다고! 그리고 네가 믿음직스럽지 못하다고 생각한 것뿐이지, 딱히 불성실하다고 생각했던 건 아니고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/feeling4.ogg"},"사랑":{"voiceline":"사귀자고? 흥! ……뭐, 뭐어 사귀어줘도 괜찮은데? 이대로 계속 노력해준다면 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"로열 네이비의 늠름한 모습을 보았는가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/home.ogg"},"hp 경고":{"voiceline":"흥, 이까짓 것!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/hp_warning.ogg"},"로그인":{"voiceline":"흥, 땡땡이 끝났어? 서류는 준비해뒀으니까, 열심히 해봐. 기대는 해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/login.ogg"},"실패":{"voiceline":"나한테 모욕을 주다니… 기억해 둬!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/lose.ogg"},"우편":{"voiceline":"산책 하는 김에 편지 가져왔어. 감사히 확인해보라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/mail.ogg"},"임무":{"voiceline":"미션을 팽개쳐 두고 뭔 생각이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/mission.ogg"},"임무완료":{"voiceline":"보너스도 내가 갖고 오게 할 셈이야? 10초 줄 테니까 갔다 와! 1, 2, ……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/mission_complete.ogg"},"서약":{"voiceline":"똑바로 서. 이 넬슨이랑 같이 생애를 보내게 됐으니 가슴을 펴라고! ……뭐, 너한테 선택받은 것도 이 넬슨에게 있어 자랑이지만…… 틱틱거리지 않게 됐다고!? ……너, 너 말야… 그렇게 쳐맞고 싶은 거야!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/propose.ogg"},"스킬":{"voiceline":"내가 적을 깔볼 줄 알았다면 큰 착각이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/skill.ogg"},"터치1":{"voiceline":"주포 한 방 먹고 싶은 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/touch.ogg"},"터치2":{"voiceline":"트라팔가르의 물고기 밥이나 돼버려. 지·휘·관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관이야? 별로 쓸모 있어 보이지는 않는데. 나는 넬슨이야. 일단 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/unlock.ogg"},"강화성공":{"voiceline":"일단 감사해줄게. 잘했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥, 이 정도의 적, 별것도 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['리나운'] : 리나운, 내 명성을 더럽히지 말아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/couple_encourage1.ogg"},{"voiceline":"['퀸 엘리자베스'] : 폐하는 물러나주세요. 여기는 제가 맡겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205030/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_e