e/main/audio/voiceline/202274/main1.ogg"},"메인2":{"voiceline":"이 허브에는 어떤 효과가 있는 걸까요……. 나중에 다이도에게 물어봐야겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/main2.ogg"},"메인3":{"voiceline":"레시피나 재료 관리라면 자신 있어요. 메이드대 업무에도 이런게 가장 많기도 하구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"메이드대 동료들이 만들어준 이스트 글림 스타일 의상, 어때요? 지휘관님 마음에 들었으면 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/detail.ogg"},"드랍 설명":{"voiceline":"몸은 좀 어떠신가요, 지휘관님? 후후훗, 백의랑은 조금 다르지만, 이쪽도 나름 느낌 있지 않나요?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조에서 허브를 채집해왔어요! 이번 다도회 테마를 허브티로 한 번 제안해볼게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/expedition.ogg"},"실망":{"voiceline":"치료약은…… 걱정 마세요, 지휘관님! 분명 어딘가에 있을 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/feeling1.ogg"},"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님, 오늘 몸은 좀 어떠신가요? 약을 드릴 순 없지만, 약식동원이라는 말도 있으니 오늘은 좋아하는 음식을 만들어 드릴게요. 맡겨 주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"허브향을 맡는 것도 건강에 좋다고 해요, 지휘관님, 여기서 잠시 쉬다 가세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/home.ogg"},"hp 경고":null,"로그인":null,"실패":null,"우편":{"voiceline":"새로운 우편이 왔네요. 조달한 재료는…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"만져서 진찰……하는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/touch.ogg"},"터치2":{"voiceline":"지휘관님…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202274/touch2.ogg"},"입수시":{"voiceline":"몸