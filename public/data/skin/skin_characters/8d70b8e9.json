m/Fernando2603/AzurLane/main/audio/voiceline/202275/main2.ogg"},"메인3":{"voiceline":"이 시기에 선물 포장을 하는 가게는 어딜가도 사람이 많네요. 후후후, 지휘관님은 그 이유를 알고 계시겠죠? …지휘관님과 데이트를 하고 있는 걸 생각하면, 왠지 그런 부분에 있어서도 이득을 보고 있는 기분이 드네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/main3.ogg"},"전투개시":{"voiceline":"레이디의 데이트를 방해하다니… 굉장히 무례하시군요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/battle.ogg"},"상세확인":null,"드랍 설명":{"voiceline":"지휘관님, 저기… 해피 밸런타인입니다! 오늘 허마이오니 모습은 어떤가요? 후후, 데이트에 어울리는 분위기가 느껴지시죠?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"♪~ 지휘관님, 허마이오니와의 데이트는 어떠신가요? 허마이오니는… 네, 충분히 만족하고 있답니다. 이제와서 이런 말씀을 드리는 건 좀 주제 넘지만, 사실은 매일 이렇게 사랑하는 지휘관님과 데이트를 할 수 있다면…하고 바라게 되네요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 고생 많으셨습니다. 영화라도 보러 갈까요? 아니면 카페에서 쉴까요? 어쨌든 지금은 천천히 쉴 수 있는 곳부터 찾아야겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 여기예요~! …아, 저도 이제 막 도착한 참이랍니다. 오늘은 격식 같은 건 잊고 같이 밸런타인을 즐겨봐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":{"voiceline":"매너에 대해 알려드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/skill.ogg"},"터치1":{"voiceline":"자, 밸런타인 초콜릿이에요. ……타이밍도 안 재고 이렇게 그냥 줄 줄은 몰랐다구요? 에이, 아니죠. 지휘관님과 함께 있는 시간은 전부 로맨틱하고 특별하니까, 일부러 그냥 드린 거랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/touch.ogg"},"터치2":{"voiceline":"오늘은…… 후후후, 이런 것도 특별하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 저기… 해피 밸런타인입니다! 오늘 허마이오니 모습은 어떤가요? 후후, 데이트에 어울리는 분위기가 느껴지시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202275/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"사복","상점 id":70971,"상점 카테고리 id":9,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2025/02/19)","진영":"HMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":202278,"클뜯 함순이 id":20227,"함순이 이름":"허마이오니","한글 함순이 + 스킨 이름":"아침노을의 맹세","영문 함순이 + 스킨 이름":"Dawn's Oath","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202278/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202278/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202278/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202278/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202278/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202278/shipyard.png","설명":"지휘관님과 같이 여기 와서 너무 기뻐요. 이 아름다운 아침노을이 계속 우리를 지켜봐 주기를… 지휘관님, 사랑합니다.","자기소개":null,"메인1":{"voiceline":"지휘관님의 건강을 신경 쓰고, 두 사람이 함께하는 생활을 소중히 한다…는 거니까 예전과 별다를 건 없는 것 같네요. 이 말은 즉, 저랑 지휘관님은 훨씬 예전부터 서로 잘 맞았다는 게 되네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/main1.ogg"},"메인2":{"voiceline":"너무 이것저것 돌봐주면 사람을 망치게 된다는 말을 들은 적이 있어요…. 지휘관님이라면 절대 그럴 일 없을 거예요! 음, 그러니까… 가끔은 제게 어리광 부리셔도 된답니다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/main2.ogg"},"메인3":{"voiceline":"지휘관님, 편하게 계시고 싶을 때는 언제든 그렇게 하셔도 된답니다. 아무 고민 없이 느긋하게, 늘 웃는 표정의 지휘관님 얼굴이야말로 제가 가장 보고 싶은 것이니까요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이 의상을 몸에 두르고 이렇게 지휘관님과 마주하는 날이 올 줄은 생각도 못했어요. 저, 지금 정말로 무척이나… 너~무 행복해요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님과 같이 여기 와서 너무 기뻐요. 이 아름다운 아침노을이 계속 우리를 지켜봐 주기를… 지휘관님, 사랑합니다.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"♪~ 방 청소도 끝났고, 다음은… 돌아오셨네요, 지휘관님. 식사 준비를 할 테니 조금만 기다려 주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"고생 많으셨어요, 지휘관님. 워라밸은 중요하게 여기셔야 해요. 안 그러시면 조금 강경한 방법을 써서라도 쉬시게 할지도… 후후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 안색이 좋네요. 허마이오니가 뭐 도와드릴 거 있을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"피곤하신가요? 지휘관님, 허마이오니의 무릎 베개는 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/touch.ogg"},"터치2":{"voiceline":"저, 저도… 온기를 바래도 될까요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/touch2.ogg"},"입수시":{"voiceline":"지휘관님과 같이 여기 와서 너무 기뻐요. 이 아름다운 아침노을이 계속 우리를 지켜봐 주기를… 지휘관님, 사랑합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202278/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_