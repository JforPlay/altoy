[{"클뜯 id":202270,"클뜯 함순이 id":20227,"함순이 이름":"허마이오니","한글 함순이 + 스킨 이름":"허마이오니","영문 함순이 + 스킨 이름":"Hermione","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202270/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202270/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202270/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202270/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202270/shipyard.png","설명":"다이도급 경순양함-허마이오니 ","자기소개":{"voiceline":"저는 다이도급의 허마이오니라고 합니다. 함력이라면…... 비스마르크 추격에 참여한 적이 있고, 사르데냐 잠수함을 상대한 적도 있는데, 그것 외에는 아주 특별히 언급할 만한 것이 없는 것 같군요. 무엇을 또 알고 싶나요, 지휘관님? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/profile.ogg"},"메인1":{"voiceline":"눈을 과하게 사용하는 것은 좋은 일이 아니에요. 먼저 세수하고 정신을 차려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/main1.ogg"},"메인2":{"voiceline":"흠……요즘 이 식재료들의 가격이 좀 오른 것 같네요……지휘관님, 앞으로 이 식재료들이 들어가는 요리는 줄어들겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/main2.ogg"},"메인3":{"voiceline":"지휘관님이 순조롭게 일을 하나씩 해결하는 모습을 보면 왜 저까지 즐거워지는지 모르겠어요……정말 이상해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/main3.ogg"},"전투개시":{"voiceline":"적을 발견했어요~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/battle.ogg"},"상세확인":{"voiceline":"수석 메이드 벨파스트님은 능력이 매우 뛰어나고 굳건한 의지도 있어서 제가 매우 동경하죠. 언젠가 그런 존재가 됐으면 좋겠어요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/detail.ogg"},"드랍 설명":{"voiceline":"다이도급 경순양함-허마이오니 ","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 하던 일은 우선 내려놓고, 돌아오는 의뢰조를 맞이하러 가시죠. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/expedition.ogg"},"실망":{"voiceline":"지휘관님……왜 이렇게 고집스러울까요…... ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/feeling1.ogg"},"낯섦":{"voiceline":"다이도는 주인님을 잃을까 매우 두려워해요. 그렇게 노력하고 능력 있는데 지휘관님이 어떻게 그녀를 미워하겠어요……하지만 제가 몇번이나 말해도 소용없죠. 번거롭겠지만 지휘관님께서 그녀를 조금 더 보살펴주셔야지요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 오늘 야근하실건가요? 그러시면 제가 잠시후에 커피를 준비해드릴게요. 괜찮습니다. 저에게 맡기실 일이 없어도 지휘관님 옆에 있기만 해도 좋아요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 괜찮으시다면 갈아입으신 옷도 저에게 맡겨주세요. 같이 세탁하면 편리하고 손세탁한 옷을 경험시켜드리고 싶어요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/feeling4.ogg"},"사랑":{"voiceline":"휴우…방은 이렇게 청소가 끝난 셈이고, 다음은…앗! 돌아오셨네요. 그럼 먼저 식사 준비 할게요. 다른 일 먼저 하시면서 기다려주세요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 근무는 계속해서 금지입니다. 우선 휴식을 잘 취해야 한다구요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/home.ogg"},"hp 경고":{"voiceline":"조금 방심했네…... ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이네요. 지휘관님, 잘 쉬셨습니까? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/login.ogg"},"실패":{"voiceline":"아야야, 실패했잖아… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/lose.ogg"},"우편":{"voiceline":"지휘관님, 이건 지휘관님의 우편물이죠? 이곳에 둘게요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/mail.ogg"},"임무":{"voiceline":"지휘관님, 임무를 수행하지 않으면, 점점 더 많아질 거에요~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/mission.ogg"},"임무완료":{"voiceline":"와아~ 임무 보상이 정말 참 많군요. 지휘관님은 정말 대단해요~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/mission_complete.ogg"},"서약":{"voiceline":"제가 영원히 곁에 있었으면 하나요? 좋아요. 지휘관님을 모시는건 원래 제 직책인걸요..... 앗, 설마 이건 고백인가요?...... 흐음, 제 대답은 여전히 예스에요. 오늘 이후로도 많은 가르침 부탁드려요. 지휘관님! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/propose.ogg"},"스킬":{"voiceline":"명중하면 좋을텐데. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/skill.ogg"},"터치1":{"voiceline":"탄산음료요? 아……정말 어쩔 수가 없네요. 오늘은 한 병만 마시는 거에요~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/touch.ogg"},"터치2":{"voiceline":"이런 일을 할때는 그래도 상황을 고려해야죠. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/touch2.ogg"},"입수시":{"voiceline":"안녕하세요. 저는 다이도급의 허마이오니라고 하며, 로열 메이드대의 일원입니다. 우리 잘 지냈으면 해요. 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/unlock.ogg"},"강화성공":{"voiceline":"어? 제가 강해졌나요? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관님도 분명 기쁘시겠죠~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"♪～방청소는 끝났고 다음은…앗! 돌아오셨네요, 지휘관님. 금방 식사 준비해드릴게요. 잠시만 기다리시면 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"좋은 아침이에요, 지휘관님. 깊이 주무시는 걸 보고 깨우지 않았어요. 오늘도 함께 화이팅해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202270/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":