[{"클뜯 id":101410,"클뜯 함순이 id":10141,"함순이 이름":"스탠리","한글 함순이 + 스킨 이름":"스탠리","영문 함순이 + 스킨 이름":"Stanly","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101410/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101410/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101410/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101410/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101410/shipyard.png","설명":"플레처급 구축함—스탠리, 현호 DD-478 ","자기소개":{"voiceline":"스탠리는 말이야, 많은 동료들의 호송을 한 적이 있어. 그리고 비버즈 함대의 일원으로 엠프레스 오거스타 만 해전에도 참여했었지…… 낮이건 밤이건 열심 모드의 스탠리는 믿음직스러울거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/profile.ogg"},"메인1":{"voiceline":"지휘관, 나와 함께 정의의 동료가 되지 않을래? 푸하하하! 장난이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/main1.ogg"},"메인2":{"voiceline":"지휘관, 아직도 작업 모드 중이야? 정말이지, 스탠리를 너무 오래 기다리게 하지 말라고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/main2.ogg"},"메인3":{"voiceline":"지휘관의 머리카락 정말 재밌네! 돌돌~ 돌돌~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/main3.ogg"},"전투개시":{"voiceline":"전투 모드 기동! 출격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/battle.ogg"},"상세확인":{"voiceline":"아무리 봐도 스탠리는 변신같은 거 안 한다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함—스탠리, 현호 DD-478","voicelink":null},"의뢰 완료":{"voiceline":"다음 의뢰를 할 때는 스탠리가 호송해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/expedition.ogg"},"실망":{"voiceline":"오늘의 스탠리는 실망모드야! 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/feeling1.ogg"},"낯섦":{"voiceline":"오늘의 스탠리는 무엇을 하든 활기찬 즐거운 모드야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/feeling2.ogg"},"호감":{"voiceline":"비버즈 함대의 다른 동료들도 재밌지만, 지휘관과 함께 있는 게 제일 즐거워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/feeling3.ogg"},"기쁨":{"voiceline":"지휘관과 함께라면 스탠리의 행복 수치는 계속해서 올라간다고! 그러니까 지휘관, 스탠리와 조금만 더 놀아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/feeling4.ogg"},"사랑":{"voiceline":"경고. 스탠리는 이미 ‘지휘관과 3M 이상 떨어지면 셀프 디스트로이 모드’에 들어갔다고…… 진, 진짜야! 그러니까 스탠리는 지휘관의 옆에 항상 있어야해. 히히~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"윽, 지휘관. 언제 왔어? 스탠리의 휴식 모드는 아직 한참 남았는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/home.ogg"},"hp 경고":{"voiceline":"방, 방어 모드 전환!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/hp_warning.ogg"},"로그인":{"voiceline":"스탠리, 작업 모드 돌입! 한가지 알려주자면 이 모드의 지속 시간은 엄청 짧다구. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/login.ogg"},"실패":{"voiceline":"망했다. 얼른 도망가야해…… 퇴각 모드!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/lose.ogg"},"우편":{"voiceline":"새로운 소식이 있어! 내가 안 알려줬다는 말은 하면 안돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/mail.ogg"},"임무":{"voiceline":"임무를 넘길 수 있는 모드가 있으면 좋겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/mission.ogg"},"임무완료":{"voiceline":"우와! 보상이 왔어! 지휘관, 얼른 가보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 손 줘봐…… 됐다, 연결 성공! 이러면 스탠리는 지휘관과 마음이 통하게 되는거지! 히히, 스탠리의 행복이 느껴져?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/propose.ogg"},"스킬":{"voiceline":"공격! 공격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/skill.ogg"},"터치1":{"voiceline":"자기방어 모드 기동! ……거짓말이야. 하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/touch.ogg"},"터치2":{"voiceline":"아쉽네. 이상한 모드는 없거든~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/touch2.ogg"},"입수시":{"voiceline":"안녕, 지휘관. 나는 유니온 소속의 구축함 스탠리. 당신의 명령에 따라 승리를…… 푸…… 하하하! 미안해. 점잖은 자기 소개는 역시 너무 어렵네. 하하하……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/unlock.ogg"},"강화성공":{"voiceline":"강화 성공! 응, 나한테 상으로 휴식을 줘야겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/upgrade.ogg"},"vote":null,"승리":{"voiceline":"으흥, MVP는 내 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['찰스 오스본'] : 여기는, 비버즈 함대의 \"정의 모드\"!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101410/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0}]