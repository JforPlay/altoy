[{"클뜯 id":103010,"클뜯 함순이 id":10301,"함순이 이름":"펜사콜라","한글 함순이 + 스킨 이름":"펜사콜라","영문 함순이 + 스킨 이름":"Pensacola","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103010/shipyard.png","설명":"펜사콜라급 중순양함·펜사콜라 (CA-24)","자기소개":{"voiceline":"OKOK, 자기소개지? 나는 펜사콜라. 여동생으로 솔트레이크시티가 있어…… 그런데 자기소개는 뭘 말하면 돼? 호넷 씨와 요크타운 씨를 도왔다는 것도 특별히 말할 일은 아니고…… 뭐 아무튼, 무슨 일이든 나한테 맡기면 OK야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/profile.ogg"},"메인1":{"voiceline":"나는 엔터프라이즈 씨와 마찬가지로 별명이 있어… 어때? 멋있게 들리지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/main1.ogg"},"메인2":{"voiceline":"지치면 무리하지 말고 제대로 쉬어! 내가 도울 일이 있다면 팍팍 얘기하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/main2.ogg"},"메인3":{"voiceline":"이래봬도 상당히 많은 격전을 봐왔거든? 듣고 싶어? OK~그럼 그것부터 말해볼까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/main3.ogg"},"전투개시":{"voiceline":"이 정도의 상대, 힘을 절반만 써도 OK야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/battle.ogg"},"상세확인":{"voiceline":"정비? OK, 이상한 부분이 있으면 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/detail.ogg"},"드랍 설명":{"voiceline":"펜사콜라급 중순양함·펜사콜라 (CA-24)","voicelink":null},"의뢰 완료":{"voiceline":"여~어. 의뢰가 완료됐다구… 노력한 자매들을 내버려 두는 건 OK가 아니지~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/expedition.ogg"},"실망":{"voiceline":"지휘관, 전혀 OK스럽지 않거든?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/feeling1.ogg"},"낯섦":{"voiceline":"문제 있을 때 내게 맡기면 OK야! 제대로 도와줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/feeling2.ogg"},"호감":{"voiceline":"외출? OK. 어디로 갈지 정하라고. 나는 어디라도 좋으니까 지휘관 좋을 대로 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/feeling3.ogg"},"기쁨":{"voiceline":"피곤해? OK, 자 여기에 누워봐 (톡톡) 시간 지나면 깨워줄게! 잘 자~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/feeling4.ogg"},"사랑":{"voiceline":"내가 만든 걸 먹고 싶어? OK. 뭐가 먹고 싶은지 팍팍 부탁해줘. 만들어줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 마사지 어때? ……OK, 제대로 앉아봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 뭐 도울만한 거 없어? 나는 언제라도 OK야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/login.ogg"},"실패":{"voiceline":"제길…… 이런 건 전혀 OK스럽지 않아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/lose.ogg"},"우편":{"voiceline":"편지는… 이쪽! 자, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/mail.ogg"},"임무":{"voiceline":"새로운 미션? OK, 함께 정리해버리자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/mission.ogg"},"임무완료":{"voiceline":"지휘관? 보수 잊지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/mission_complete.ogg"},"서약":{"voiceline":"이걸 내게? O…… 잠깐 스톱! 너, 진심이야? 아니아니아니……가 아니라, OK는 OK지만 그래도 무슨…… 아아 정말! 당신한테 받는 거라면 OK인 게 당연하잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/propose.ogg"},"스킬":{"voiceline":"주포 OK, 장갑 OK, 해보자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/skill.ogg"},"터치1":{"voiceline":"출격이라면 언제든지 준비 OK야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/touch.ogg"},"터치2":{"voiceline":"그, 그런 제스쳐가 아니라니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/touch2.ogg"},"입수시":{"voiceline":"네가 이 함대의 지휘관? 왠지 믿음직스러운걸! ……OKOK, 나는 펜사콜라. 오늘부터 네 부하야. 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/unlock.ogg"},"강화성공":{"voiceline":"내 차례? OK~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 정도는 식은 죽 먹기지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"N","ex_chat_status":0}]