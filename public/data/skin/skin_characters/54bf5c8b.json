[{"클뜯 id":705080,"클뜯 함순이 id":70508,"함순이 이름":"폴타바","한글 함순이 + 스킨 이름":"폴타바","영문 함순이 + 스킨 이름":"Poltava","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705080/shipyard.png","설명":"강구트급 전함 - 폴타바","자기소개":{"voiceline":"노스 유니온 강구트급 전함 폴타바야. 강구트만큼 유명하진 않지만, 능력에는 자신 있어. 업무에서든 개인적으로든 늘 날 의지하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/profile.ogg"},"메인1":{"voiceline":"예의라는 건 그저 정숙하게 보이기 위함이 아니라, 세세한 부분까지 조심하는 마음가짐을 말해. 그래, 세세한 부분까지 신경을 쓰는가로 정해지는 거야. 기억해 둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/main1.ogg"},"메인2":{"voiceline":"성실한 태도를 유지하기 위해서라도 때로는 엄격하게 대할 필요가 있겠지… 지휘관 동지 생각은 어떨까 모르겠네?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/main2.ogg"},"메인3":{"voiceline":"벌써 시간이 이렇게… 후후후, 같이 야식이라도 어때? 술도 마실 거면… 적당히 마셔.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/main3.ogg"},"전투개시":{"voiceline":"내 지시에 따라서 질서 있게 적을 공격해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/battle.ogg"},"상세확인":{"voiceline":"트러블을 \"해결\"하는 건 내가 가장 잘하는 거야. 모르는 사이에 날아온 청구서부터 예의 없는 곰까지…… 이것도 다 훈육의 일환 아닐까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/detail.ogg"},"드랍 설명":{"voiceline":"강구트급 전함 - 폴타바","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 임무로 떠난 애들이 돌아왔어. 지금 마중나가는 게 지휘관이 해야 할 일이니까 잘 준비해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/expedition.ogg"},"실망":{"voiceline":"후후후후… 아무래도 강경한 수단을 취해서 지휘관 동지를 훈육할 필요가 있을 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/feeling1.ogg"},"낯섦":{"voiceline":"못을 하나 잃어버린 걸로 전쟁에 진다는 이야기가 있지… 이건 그냥 재밌는 동화 속 이야기 아니야, 지휘관 동지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/feeling2.ogg"},"호감":{"voiceline":"……흐음? 보다시피 이건 그냥 \"쇠사슬\"이야. 딱히 무언가를 쇠사슬로 묶는 취미는 없으니까 안심해도 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/feeling3.ogg"},"기쁨":{"voiceline":"화물이 무너질까 걱정이 되면 튼튼하게 묶어야 하고, 가구나 도구가 떨어질까 걱정이 되면 단단히 고정해야지. 무슨 말인지 모르겠다고? 후후, 괜찮아. 한번 거친 파도에 휩쓸려 보면 알 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/feeling4.ogg"},"사랑":{"voiceline":"후후후, 머리가 잘 돌아가는 지휘관 동지는 이미 눈치챘겠지. 이 цепь(쇠사슬)은 사슬로서 기능하지는 않지만, 함께 풍파를 겪은 지휘관 동지를 단단히 휘감아 내게 묶어두고 있다는 것을. 이게 바로 내 \"애정\"이라는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/feeling5.ogg"},"터치3":{"voiceline":"――꽤 적극적이네. 좋아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/headtouch.ogg"},"모항귀환":{"voiceline":"수고 많았어, 지휘관 동지. 자, 내 옆으로 와. ……이건 요청이 아니라 이미 결정된 사항이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/home.ogg"},"hp 경고":{"voiceline":"상황이 좋지 않아… 서둘러야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/hp_warning.ogg"},"로그인":{"voiceline":"왠지 졸린 것 같네, 지휘관 동지. 그렇게 게으른 모습을 보이면… 곤란한데. 후후후","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/login.ogg"},"실패":{"voiceline":"전투에 패배해도 후퇴는 질서 있게 해줬으면 해. 안 그러면… 알지? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/lose.ogg"},"우편":{"voiceline":"시간은 소중해. 우편 선별은 내게 맡기고 당신은 계속 해야 할 일에 집중해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/mail.ogg"},"임무":{"voiceline":"완료되지 않은 임무가 쌓여 있네… 안 되겠네. 이렇게 계속 게으름을 피울 셈이면 조금 훈육을 해줘야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/mission.ogg"},"임무완료":{"voiceline":"임무를 모두 완료했다고? 좋아. 그 근성과 집중력… 꽤 설레는걸♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/mission_complete.ogg"},"서약":{"voiceline":"이건… 영원히 함께하자는 증명이지. 이걸 내게 맡겼다는 건 나와 цепь(쇠사슬)로 계속 연결될 각오가 되어있다는 거지? 후후후♪ 앞으로는 함께 어떤 시련이든 헤쳐나가자고, 여♡보♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/propose.ogg"},"스킬":{"voiceline":"내 цепь(쇠사슬)에 복종하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/skill.ogg"},"터치1":{"voiceline":"내 의장에 관심이라도 있는 거야? 후후후, 거칠어 보여도 내부는 꽤 공업적으로 정교하게 만들어져 있다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/touch.ogg"},"터치2":{"voiceline":"후후후…… 이건 정식으로 \"유혹\"하는 걸로 받아들이면 되는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/touch2.ogg"},"입수시":{"voiceline":"음, 당신이 지휘관 동지구나? 노스 유니온 소속 전함 폴타바야. 오늘부터 당신 업무에 협력할게. 모항을 대표하는 얼굴인만큼 예의와 행동거지는 엄격히 볼 거니까 각오하고 있어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/unlock.ogg"},"강화성공":{"voiceline":"цепь(쇠사슬)이 더 단단해졌어… 좋아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"시간은 금이야. 다음 전투로 향하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"어머, 여보도 피로시키를 돌봐주고 싶어? 후후후,