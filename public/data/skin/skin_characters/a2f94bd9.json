zurLane/main/audio/voiceline/201352/detail.ogg"},"드랍 설명":{"voiceline":"괜찮아, 재너스. 옷을 갈아입는 것뿐이야, 평소랑 아무것도 다를 것 없이……으음? 지휘관님? 죄, 죄송해요! 제가 분명히 다 갈아입기 전까지 눈을 감고 있어 달라고 했는데, 갑자기 말을 걸어버렸네요……!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔다구요? 네! 바로 마중나갈게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201352/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"\"지휘관님을 재너스 방으로… 민폐라고 생각하시면 어쩌나 했지만, 나도 모르는 새 모시고 와버렸어…. 그럼 못 써, 재너스! 저비스가 또 걱정하잖아! 지휘관님은 나쁜 걸 알려준 적이 전혀 없는데, 재너스는 어쩌다 이렇게 나쁜 아이가 되어버린 거냐구…….\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201352/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어, 어어어서오세요! 재너스가 옷을 다 갈아입으면 그… 같이 외출해도 괜찮을까요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201352/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"아… 오, 오래 기다리게 해서 죄송합니다…. 조금만 더….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201352/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새로운 임무인가요? 그렇군요. 지휘관님께는 새로운 임무가 있겠죠. …가, 같이 처리해도 될까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201352/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"괜찮아, 재너스. 지휘관님이 딱히 이상한 짓을 한 건 아니니까… 괜찮아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201352/touch.ogg"},"터치2":{"voiceline":"지휘관님을 기다리게 한 재너스가 나쁜 거죠……. 아///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201352/touch2.ogg"},"입수시":{"voiceline":"괜찮아, 재너스. 옷을 갈아입는 것뿐이야, 평소랑 아무것도 다를 것 없이……으음? 지휘관님? 죄, 죄송해요! 제가 분명히 다 갈아입기 전까지 눈을 감고 있어 달라고 했는데, 갑자기 말을 걸어버렸네요……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201352/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":