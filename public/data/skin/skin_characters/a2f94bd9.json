[{"클뜯 id":201350,"클뜯 함순이 id":20135,"함순이 이름":"재너스","한글 함순이 + 스킨 이름":"재너스","영문 함순이 + 스킨 이름":"Janus","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201350/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201350/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201350/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201350/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201350/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201350/shipyard.png","설명":"J급 구축함 - 재너스","자기소개":{"voiceline":"로, 로열 네이비 소속인 평범한 J급 구축함 재너스입니다…… 이곳에서 열심히 노력할게요! 지휘관님과 다른 사람들에게 도움이 되고야 말겠어요! ……아, 또 긴장해서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/profile.ogg"},"메인1":{"voiceline":"(……집무실이 너무 조용해… 지휘관님께 말을 걸면 민폐려나…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/main1.ogg"},"메인2":{"voiceline":"오늘도 바다가 잔잔하길… 그리고 출항한 동료들이 무사히 귀환하길…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/main2.ogg"},"메인3":{"voiceline":"호, 혹시 저비스가 지휘관님께 실례되는 말을 하더라도 너무 나무라진 마세요! 제, 제가 대신 사과할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/main3.ogg"},"전투개시":{"voiceline":"괜찮아, 재너스. 너라면 할 수 있어! 반드시 적을 무찌를 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/battle.ogg"},"상세확인":{"voiceline":"오늘도 이런저런 일이 있었지… 맞다, 일기에 써둬야지…… 지, 지휘관님?! 이건 그냥 평범한 일기장인데… 죄송합니다! 보여드릴 순 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/detail.ogg"},"드랍 설명":{"voiceline":"J급 구축함 - 재너스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어요…… 마, 마중 나갈 때 저도 데려가주시면…… 꼬, 꼭 데려가주지 않으셔도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/expedition.ogg"},"실망":{"voiceline":"역시 재너스는 아무것도 못하고…… 아무런 도움도 안 돼…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/feeling1.ogg"},"낯섦":{"voiceline":"J급 이외의 사람과 말을 하는 건 아직 어렵지만…… 지휘관님과는 평범하게 인사할 수 있게 됐어! 다른 사람에게 더욱 도움이 될 수 있게 앞으로도 열심히 할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/feeling2.ogg"},"호감":{"voiceline":"저비스가 또 지휘관님께 심한 말을 했어… 나는 전혀 그렇게 생각 안 하는데…… 만약 내가 저비스처럼 지휘관님께 그런 짓을 하면…… 저, 절대로 나한텐 무리겠지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이랑 같이 있으면 즐거워. 게다가 용기도 솟아 오르는 것만 같아… 내일도 모레도, 앞으로도 매일매일 지휘관님과 함께 할 수 있기를…… 분에 넘치는 소원이지만, 이뤄지면 좋겠다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/feeling4.ogg"},"사랑":{"voiceline":"지휘관님과 헤어질 때면 늘 마음이 아파…… 저비스가 이건 병이 아니라 '욕심'이라고 했어…… 내가 그런 욕심쟁이였나? 지휘관님의 관심을 끌고 싶어서…? 지휘관님께 폐를 끼치고 싶지는 않은데, 어떻게 하면 좋을지 모르겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/feeling5.ogg"},"터치3":{"voiceline":"기분 좋다…… 어라? 죄, 죄송합니다! 방금 다른 생각 하고 있었어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/headtouch.ogg"},"모항귀환":{"voiceline":"지, 지휘관님! 작전하시느라 수고 많으셨어요! 제, 제가 도와드릴 수 있는 게 있다면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/home.ogg"},"hp 경고":{"voiceline":"모두의 발목을 잡고 싶진 않아…… 정신 차려야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/hp_warning.ogg"},"로그인":{"voiceline":"……지휘관님? 어, 어느 틈에…… 아니죠! 그… 어, 어, 어, 어서 오세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/login.ogg"},"실패":{"voiceline":"흑…… 져버렸어요… 가슴이 쓰려요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/lose.ogg"},"우편":{"voiceline":"지휘관님, 우편입니다! ……잘 전달되어서 다행이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/mail.ogg"},"임무":{"voiceline":"지휘관님, 이, 임무가…… 죄, 죄송해요! 일부러 이런 타이밍에 알려드리려고 한 건 아니었어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/mission.ogg"},"임무완료":{"voiceline":"역시 지휘관님! 벌써 임무를 완수하셨네요…… 저, 저의 덕분이기도 하다구요…? 네, 넵! 도움이 되어서 기쁩니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/mission_complete.ogg"},"서약":{"voiceline":"어라? 결혼…… 지, 지휘관님도 절…… 아, 아무것도 아니에요! 기뻐요! 더 열심히 해서 지휘관님께 도움이 될 수 있도록…… 지휘관님께 어울리는 사람이 될 수 있도록 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/propose.ogg"},"스킬":{"voiceline":"비, 비키세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/skill.ogg"},"터치1":{"voiceline":"꺅?! ……죄, 죄송해요! 좀 깜짝 놀라서, 저도 모르게…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/touch.ogg"},"터치2":{"voiceline":"흐흑… 폐를 끼친 것에 대한 벌인가요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/touch2.ogg"},"입수시":{"voiceline":"(작게)겁먹지 말자, 재너스. 그냥 간단한 인사잖아, 할 수 있어! …… 저기! 지휘관님, 아, 안녕하세요! 저는, J급의 재너스에요…… 갑작스럽게 찾아와서 실례가 되었다면 정말 죄송해요! 웅……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/unlock.ogg"},"강화성공":{"voiceline":"강화뿐만 아니라, 나 스스로도 더 노력해야 해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관님! 재너스, 해냈어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관님…… 이, 일기가 궁금하시다구요? 딱히 보여드리기 힘든 건 아니지만…… 네, 지금 표시를 해서… 저기! 이 표시를 한 페이지보다 뒤쪽은 절대로 보시면 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔어요. 저도 같이 마중 나가게 해주세요! 저…… 열심히 할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/expedition_ex.ogg"},"사랑_ex":{"voiceline":"\"서약을 나눈, 인생에서 가장 행복했던 그 날…… 이 행복이 오래오래 계속될 수 있게 업무랑 일상 생활 모두 열심히 해야 해! …여기 써놓은 걸 지휘관님이 읽기라도 하면, 분명 얼마 전에 있었던 일도…… 으아///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"괜찮아, 재너스. 이미 몇번이고 한 거니까 평소처럼…… 아, 지휘관님, 어서 오세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/login_ex.ogg"},"실패_ex":{"voiceline":"지휘관님, 괜찮아요! 저…… 이제는 옛날처럼 실패가 두렵지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/lose_ex.ogg"},"우편_ex":null,"임무_ex":{"voiceline":"지휘관님, 새로운 임무가…… 제, 제 도움이 필요하시다면, 열심히 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"이, 이런 건 저…… 여, 역시 무리에요… 흐흑…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"무서워서 앞으로 나아갈 수 없을 때는 늘 스스로를 격려하고 용기를 주곤 했어요. 지금은 지휘관님이나 동료들이 곁에 있어준 덕분에 용기는 충분해서, 그럴 필요는 없어졌지만요. 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님께 말을 걸어도 괜찮은 때는 언제인가요? …… 아, 알겠습니다. 열심히 분위기를 파악해서, 잠깐 실례해도 괜찮은 타이밍을 찾아서… 아, 아니에요! 그런 의미가 아니라…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201350/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex"