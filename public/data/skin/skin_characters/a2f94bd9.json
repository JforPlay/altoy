null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"「지휘관님께서 고생해서 알려주시고 계신데, 재너스는 하나도 못 배웠어. 왜냐하면 지휘관님께서 가까이 계셔서 자꾸 신경이 쓰여서… 그래서 지휘관님 말이 귀에 하나도 안 들어와서…… 그러면 못 써, 재너스! 이대로면 지휘관님의 시간을 헛되이 만드는 꼴이잖아!」","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201354/feeling5.ogg"},"터치3":{"voiceline":"재너스를 위로해 주시려는 건가요…? 네! 재너스는 괜찮아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201354/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 바로 당구 수업 준비를…… 아? 네, 넵! …재너스가 먼저 내려갈게요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201354/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 죄송해요! 당구는 조금 있다가 배워도 되나요…? 흑… 재너스, 스타킹을 새 걸로 갈아입고 왔으면 해서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201354/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"음… 허리를 숙이고, 손가락을 벌려서… 하아… 거, 거리를…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201354/touch.ogg"},"터치2":{"voiceline":"아… 여, 여기요…? 여, 역시 안 돼요… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201354/touch2.ogg"},"입수시":{"voiceline":"괜찮아, 재너스. 조금 있으면 고양이들도 갈 거야…… 앗… 지, 지휘관님…?! 죄, 죄송해요! 일부러 올라온 건 아니고… 고양이들이… 으아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201354/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"카니발","상점 id":71084,"상점 카테고리 id":16,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2026/01/21)","진영":"HMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":201358,"클뜯 함순이 id":20135,"함순이 이름":"재너스","한글 함순이 + 스킨 이름":"아침놀에 빛나는 맹세","영문 함순이 + 스킨 이름":"Oath under the Morning Sun","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201358/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201358/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201358/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201358/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201358/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201358/shipyard.png","설명":"괜찮아, 재너스… 계속 웃는 얼굴을 유지하자… 오늘은 가장 중요하고 멋진 날이잖아… 그런데.. 지, 지휘관님… 역시 높은 곳은 저… 무서워요… 흑…","자기소개":null,"메인1":{"voiceline":"네… 지휘관님, 괜찮아요. 재너스는 더 이상 무섭지 않아요…… 지금 재너스가 느끼는 건…… 그저 행복뿐이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/main1.ogg"},"메인2":{"voiceline":"……재너스 모습이 천사 같다고요? 그, 그럼…… 지휘관님의 수호천사가 돼서 영원히 지휘관님을 지켜드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/main2.ogg"},"메인3":{"voiceline":"지휘관님의 반려자가 되었으니…… 열심히 노력해서 더 용감하고 더 훌륭해질게요. 지휘관님께 걸맞은 존재가 되어서… 늘 곁에서 함께 걸어갈게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"아… 죄, 죄송해요. 지휘관님과 함께하는 이 순간을 어떻게 하면 전부 기억할 수 있을까 고민 중인데…… 너무 기억하려고 하면 오히려 잊어버릴 것 같아서…… 일단 지금을 즐기자고요? 네! 재너스, 지휘관님과 함께하는 매분 매초를 즐기는 데 집중할게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/detail.ogg"},"드랍 설명":{"voiceline":"괜찮아, 재너스… 계속 웃는 얼굴을 유지하자… 오늘은 가장 중요하고 멋진 날이잖아… 그런데.. 지, 지휘관님… 역시 높은 곳은 저… 무서워요… 흑…","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"…원래는 일기장에 쓰려던 말인데, 이번만큼은 지휘관님께 직접 전하고 싶어요……! 「오늘 해돋이는 새로운 미래를 가져다줬고, 이제 재너스는 지휘관님과 함께 그 길을 걸어갈 거예요. 지휘관님, 사랑해요. 영원히……」","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/feeling5.ogg"},"터치3":{"voiceline":"앞으로 매일매일…… 이렇게 재너스의 머리를 쓰다듬어 주실 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 해가 떠올랐어요…… 에헤헤, 이건 재너스가 지휘관님을 위해 준비한 선물이에요……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님이 곁에서 손을 잡아주시니까… 이제 그렇게 무섭지 않아요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"그, 그네가 흔들려요…! 지휘관님, 재너스 손을 꼭 잡으세요…! 열심히 지켜드릴게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/touch.ogg"},"터치2":{"voiceline":"너무 움직이면 위험하니까… 그, 그런 건 내린 다음에……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/touch2.ogg"},"입수시":{"voiceline":"괜찮아, 재너스… 계속 웃는 얼굴을 유지하자… 오늘은 가장 중요하고 멋진 날이잖아… 그런데.. 지, 지휘관님… 역시 높은 곳은 저… 무서워요… 흑…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201358/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"서약","상점 id":0,"상점 카테고리 id":9998,"스킨 태그":"X"