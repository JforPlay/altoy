[{"클뜯 id":10800040,"클뜯 함순이 id":1080004,"함순이 이름":"나미코","한글 함순이 + 스킨 이름":"나미코","영문 함순이 + 스킨 이름":"Namiko","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800040/shipyard.png","설명":"나는 나미코야! 근데 잠깐, 설마 이게 바로 유행하는 이세계로의 워프… 아닌 것 같기도 하고… 됐어, 아무렴 어때! 어찌 됐든 잘 부탁해ー!","자기소개":{"voiceline":"난 나미코야. 핫스네랑은 원래 있던 곳에서도 같은 학교에 다녔어. 부활동은 차도부였는데…… 뭐? 의외라고? 좋았어, 거기 앉아봐! 내 다도 예법을 보여주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/profile.ogg"},"메인1":{"voiceline":"어라라, 이상하네. 만나기로 한 곳이 여기가 아니었나……. 아, 지휘관, 혹시 핫스랑 릿카 못 봤어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/main1.ogg"},"메인2":{"voiceline":"우와! 책상 위에 쌓인 업무량, 장난 아닌데? 지휘관도 진짜 힘들겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/main2.ogg"},"메인3":{"voiceline":"헤에, 이쪽 학교는 함종별로 수업이 나눠져있구나. 흥미롭긴 한데, 공부는 좀……. 앗, 지휘관! 어딜 데려가는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/main3.ogg"},"전투개시":{"voiceline":"현역 여고딩의 힘을 깔보지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/battle.ogg"},"상세확인":{"voiceline":"아, 지휘관! 뭐 재밌는 이야기 없어? 예를 들면, 누가 누굴 좋아한다던가…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/detail.ogg"},"드랍 설명":{"voiceline":"나는 나미코야! 근데 잠깐, 설마 이게 바로 유행하는 이세계로의 워프… 아닌 것 같기도 하고… 됐어, 아무렴 어때! 어찌 됐든 잘 부탁해ー!","voicelink":null},"의뢰 완료":{"voiceline":"다들 고생 많았어! 헉, 보상도 엄청 많네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/expedition.ogg"},"실망":{"voiceline":"(음, 저 사람은 뭐랄까 좀…… 으아아악! 이쪽으로 온다!) 아, 지휘관. 무슨 일이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/feeling1.ogg"},"낯섦":{"voiceline":"이거 봐봐, 지휘관! 이 파르페 완전 대박이지?! 여기 애들이 알려준 곳에서 사온 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/feeling2.ogg"},"호감":{"voiceline":"지휘관도 SNS 같은 거 해? 혹시 하면 계정 알려줘! 내가 친히 팔로우해드릴게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/feeling3.ogg"},"기쁨":{"voiceline":"있잖아, 지휘관. 혹시 지금 한가해? 식당에 새로운 메뉴가 나왔대서 먹으러 가고 싶은데, 같이 가줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/feeling4.ogg"},"사랑":{"voiceline":"차가 마시고 싶다고? 홍차라면 분명 아까…… 아, 그게 아니라 다도를 배우고 싶다고? 그럼 다음에 다른 애들도 불러서 다도회 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/feeling5.ogg"},"터치3":{"voiceline":"어이쿠, 나한테 호감이라도 있으신가봐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/headtouch.ogg"},"모항귀환":{"voiceline":"수고했어! 그럼 빨리 카페라도 가자고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/home.ogg"},"hp 경고":{"voiceline":"여기서 끝낼 수는 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관 안녀엉! 겨우 지각은 면했네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/login.ogg"},"실패":{"voiceline":"잠깐 잠까안! 자, 여기 백기 들테니까, 그만 좀 때려~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/lose.ogg"},"우편":{"voiceline":"지휘관에게 온 편지……. 안 되지, 안 돼. 아무리 내용이 궁금해도 내 맘대로 열어보는 건 좀 그렇지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/mail.ogg"},"임무":{"voiceline":"아직 할 일이 남아 있잖아. 먼저 끝내두는 게 속 편하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/mission.ogg"},"임무완료":{"voiceline":"지휘관, 임무 완료하느라 수고했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/mission_complete.ogg"},"서약":{"voiceline":"모항이니, 전함이니, 처음엔 진짜 뭔 소린가 했는데, 지휘관 덕분에 그럭저럭 즐겁게 지내고 있어. 앞으로도 여고딩 겸 중순양함으로서 전력에 기여할 예정이니까, 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/propose.ogg"},"스킬":{"voiceline":"한 발, 박아드리지요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/skill.ogg"},"터치1":{"voiceline":"헤에, 이쪽 세상에도 SNS 같은 게 있나보네. 오, 여기 디저트 맛있어보인다. 지휘관, 다음에 같이 가볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/touch.ogg"},"터치2":{"voiceline":"성추행, 멈춰!! (휙)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/touch2.ogg"},"입수시":{"voiceline":"나는 나미코야! 근데 잠깐, 설마 이게 바로 유행하는 이세계로의 워프… 아닌 것 같기도 하고… 됐어, 아무렴 어때! 어찌 됐든 잘 부탁해ー!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/unlock.ogg"},"강화성공":{"voiceline":"좋았어, 갑자기 의욕이 솟아 올라! 고마워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"앗싸! 나도 꽤 하는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/win_mvp.ogg"},"전투개시_ex":{"voiceline":"그럼 어디, 전력을 다해서 가보실까요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800040/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관 너, 좋아하는 사람 있는 거 맞지? ……뭐? 없다고? 에이 그러지 말고, 솔직하게 말해봐. 비밀은 지켜줄 테니까.","voicelink"