ane/main/audio/voiceline/801033/detail.ogg"},"드랍 설명":{"voiceline":"플레이~★ 플레이~★ 후…… 에헤헤. 지휘관, 연습 보러 와준 거야? 그럼, 방금 건 어땠어? 의욕이 샘솟는 것 같아?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료! 다들 피곤할 테니 얼른 가서 쉬어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"난 지휘관을 응원하는 쪽이지만, 지휘관한테도 많은 힘을 받고 있어! …응? 아무것도 안 했는데 어떻게 받냐고? 음… 에헤헤, 지휘관이랑 같이 있는 것만으로도 용기가 많이 생겨! 응! 어쨌든 같이 열심히 하자♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"플레이~★ 플레이~★ 어서 와, 지휘관! 어때? 르쨩의 마중 치어리딩에 깜짝 놀랐어? 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관~! 새로운 하루가 시작됐어! 치어리더로서 응원해 줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/login.ogg"},"실패":null,"우편":{"voiceline":"우편, 우편… 으아?! 실수로 지휘관의 우편을 날려버릴 뻔했어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/mail.ogg"},"임무":{"voiceline":"지휘관, 임무가 있어! 여기서 있는 힘껏 응원할 테니까, 열심히 해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/mission.ogg"},"임무완료":{"voiceline":"임무! 완! 료~! 에헤헤, 지휘관! 방금 르쨩 응원, 어땠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관도 같이 해보자! 가끔씩은 이렇게 몸을 움직여줘야 건강에 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/touch.ogg"},"터치2":{"voiceline":"으아아아! 너, 넘어지겠어! 아! …설마, 그러길 바란 거야…?! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801033/touch2.ogg"},"입수시":{"voiceline":"플레이~★ 플레이~★ 후…… 에헤헤. 지휘관, 연습 보러 와준 거야? 그럼, 방금 건 어땠어? 의욕이 샘솟는 것 같아?","voicelink":"https://raw.githubusercontent.com/Fern