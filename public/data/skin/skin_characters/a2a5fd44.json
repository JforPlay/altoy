[{"클뜯 id":9702030,"클뜯 함순이 id":970203,"함순이 이름":"셰필드·META","한글 함순이 + 스킨 이름":"셰필드·META","영문 함순이 + 스킨 이름":"Sheffield META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702030/shipyard.png","설명":"당신이 지휘관…… 즉 주인님이시로군요. 네. 알겠습니다. 셰필드라고 합니다. 해충에게 총구를 겨누는 건 익숙하오니, 방금 전 일은 너무 괘념치 마시길.","자기소개":{"voiceline":"타운급 순양함인 셰필드입니다. 자신 있는 건 청소와 사격, 잠입 공작… 왜 그러시죠? 로열 메이드의 기초적인 기술에 놀라실 건 없으시리라 생각됩니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/profile.ogg"},"메인1":{"voiceline":"이쪽은 이상 없음……. 집무실 보안을 위한 정기 검사입니다. 신경 쓰지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/main1.ogg"},"메인2":{"voiceline":"총포든 빗자루든, 메이드에게 무기 손질은 중요합니다. 주인님도 무기가 녹슬어 후회하지 않도록 조심하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/main2.ogg"},"메인3":{"voiceline":"휴우. 무슨 일이신지요? 방금 총포 소리 말씀이십니까? 공포탄일 뿐입니다. 저 때문에 졸음이 달아났다면, 사죄 말씀 드리지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/main3.ogg"},"전투개시":{"voiceline":"그럼 '청소'를 시작하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/battle.ogg"},"상세확인":{"voiceline":"해충을 모두 구축하는 건 불가능해도, 누군가는 해야 하는 일입니다. 방 청소 또한 마찬가지이지요. 주인님께서는 \"어차피 더러워질 테니까 청소 안 해도 돼\"라고 생각하시는 건 아니시겠지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/detail.ogg"},"드랍 설명":{"voiceline":"셰필드호 경순양함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰는 완료되었습니다만, 고생한 동료들을 항구에 그대로 방치해둘 생각은 아니시겠지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/expedition.ogg"},"실망":{"voiceline":"동료에게는 총포를 겨누지 않습니다. 동료가 아직 동료인 동안에는…… 기억해두시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/feeling1.ogg"},"낯섦":{"voiceline":"해충을 구축하지 않으면 자신도 모르는 새에 상처를 입을 수 있습니다. 주인님, 친절함으로 인한 타협은 자신에게 해를 끼칠 뿐입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/feeling2.ogg"},"호감":{"voiceline":"셰필드와 함께 있는 건 이제 익숙해지셨는지요? 아직…이시면 계속 노력해서 익숙해지시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/feeling3.ogg"},"기쁨":{"voiceline":"셰필드를 걱정하시는 건가요? 네, 기쁘…지 않습니다. 주변 사람들에게 이상한 눈초리를 받고 싶지 않으시다면, 고작 메이드 하나에게 너무 신경 쓰지 않으시는 게 좋을 텐데요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/feeling4.ogg"},"사랑":{"voiceline":"자주 종적을 감춰 위험한 꼴이나 당하고, 게다가 성격까지 최악인 메이드를 소중히 하는 것만큼이나 어리석은 일은 없습니다. 그렇지만 그 어리석음이야말로 제가 주인님을 깊이 사랑하는 이유이긴 합니다만….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"작전은 순조로웠는지요? ……그렇군요. 어느 정도는 하시는 모양이군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/home.ogg"},"hp 경고":{"voiceline":"질질 끌고 있는 건가요…… 난감하군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/hp_warning.ogg"},"로그인":{"voiceline":"집무실 청소가 끝났습니다. 업무를 시작하시기 바랍니다. ……왜 그러시죠? 셰필드가 빗자루나 대걸레를 들고 있는 게 이상하신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/login.ogg"},"실패":{"voiceline":"제 앞에서 쓰러지지 마세요. 서둘러요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/lose.ogg"},"우편":{"voiceline":"누구에게 온 우편인가요? 확인하시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/mail.ogg"},"임무":{"voiceline":"정신 차리시죠. 임무 연락이 왔습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/mission.ogg"},"임무완료":{"voiceline":"임무 보상을 아직 받지 않으신 것까지 셰필드가 알려 드려야 하나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/mission_complete.ogg"},"서약":{"voiceline":"사랑하는 사람에게 상처를 주는 것에게는 이 총포의 울림으로 답할 수밖에요. ……(철컥) 주인님, 이 식은 어떻게 끝내실 생각이신지요? 셰필드에게 망신을 주고, 난동을 피우게 할 작정이시라면…… 방금 그걸로 만족하셨을 텐데요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/propose.ogg"},"스킬":{"voiceline":"여기서 더 멋대로 구는 건 봐 드릴 수 없겠군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/skill.ogg"},"터치1":{"voiceline":"안전 장치가 되어 있으니, 마음껏 보시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/touch.ogg"},"터치2":{"voiceline":"정신 안 차리시면 언젠가는 진짜로 해충 취급 당하실 겁니다. 주인님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관…… 즉 주인님이시로군요. 네. 알겠습니다. 셰필드라고 합니다. 해충에게 총구를 겨누는 건 익숙하오니, 방금 전 일은 너무 괘념치 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/unlock.ogg"},"강화성공":{"voiceline":"다음 한 발은 더욱더 완벽하게 명중시킬 수 있겠군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"총포의 울림이 답을 알려주고 있습니다. 주인님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":