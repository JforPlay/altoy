tent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/main2.ogg"},"메인3":{"voiceline":"열기구는 산을 넘고, 함재기는 수평선 너머까지 시야를 넓혀 주지. 미래의 시야는 이렇게나 넓다. 지휘관, 네 눈에는 어떻게 비치고 있는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/main3.ogg"},"전투개시":{"voiceline":"전투 경보! 전함 전투 위치로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/battle.ogg"},"상세확인":{"voiceline":"지휘관… 새로워진 주포가 멋있는 건 사실이지만… 그렇다고 날 그렇게 응시하면…… 주포가 아니라 날 보고 있었다고……? 그, 그렇군…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/detail.ogg"},"드랍 설명":{"voiceline":"네 부름을 받아 더 강력하고 대단하고 완벽한 모습으로 돌아왔다. 자, 어서 지시를 내려줘. \"빅 세븐\"의 이름으로 너를 가로막는 모든 것을 제거해 줄 테니.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관이 함께 해줘서 전투 중에 나 스스로를 잃지 않을 수 있어…… 네가 말한 미래에 그… 계속 관심이 있었지…… 괘, 괜찮으면 오늘도 이것저것 알려주지 않겠나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/feeling5.ogg"},"터치3":{"voiceline":"……응.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/headtouch.ogg"},"모항귀환":{"voiceline":"조금이나마 확실하게 목표에 다가설 수 있었어. 지휘관, 잘 돌아왔다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/home.ogg"},"hp 경고":{"voiceline":"윽, 함정인가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 콜로라도는 명령을 기다리는 중이다. 어서 지시를…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/login.ogg"},"실패":null,"우편":{"voiceline":"지휘관, 새로운 우편이다…… 그나저나 우표랑 소인이 아주 가지각색이군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":{"voiceline":"병장, 화력 전개!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/skill.ogg"},"터치1":{"voiceline":"\"많을수록 좋고, 클수록 바람직하다. 구경은 곧 정의이고, 사정거리는 진리다.\"……? 지휘관, 네 잰말놀이 문장은… 점점 더 난해한 느낌이 드는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/touch.ogg"},"터치2":{"voiceline":"지휘관을 우주까지 발사하면 어떻게 될까…… 후후, 농담이다. 지휘관의 따뜻한 손… 아직 놓고 싶지 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/touch2.ogg"},"입수시":{"voiceline":"네 부름을 받아 더 강력하고 대단하고 완벽한 모습으로 돌아왔다. 자, 어서 지시를 내려줘. \"빅 세븐\"의 이름으로 너를 가로막는 모든 것을 제거해 줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"이런 승리를 고대하고 있었지… 우리의 영광은 아직 퇴색하지 않았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105099/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"개조","상점 id":0,"상점 카테고리 id":9997,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0}]