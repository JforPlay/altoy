[{"클뜯 id":105090,"클뜯 함순이 id":10509,"함순이 이름":"콜로라도","한글 함순이 + 스킨 이름":"콜로라도","영문 함순이 + 스킨 이름":"Colorado","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105090/shipyard.png","설명":"콜로라도급 전함 콜로라도 (BB-45)","자기소개":{"voiceline":"나는 콜로라도급 전함의 1번함, 함대 결전에 유리하도록 이글 유니온에서 16인치 주포를 장착한 최초의 전함이다. '빅 세븐'… 그것은 전함인 우리에게 주어진 영광스러운 이름이지","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/profile.ogg"},"메인1":{"voiceline":"지휘관, 항공모함은 확실히 대단한 함선이지만, 전함도 아직 시대에 뒤떨어지진 않았어… 아니, 오히려 필수불가결한 역량이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/main1.ogg"},"메인2":{"voiceline":"아멜리아… 그분은 위대한 여성이었지만, 마지막까지 찾아내지 못했어……어쩌면 그녀는 지금 다른 세계에서 자유롭게 날갯짓하고 있을지도 모르지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/main2.ogg"},"메인3":{"voiceline":"그 굴욕의 날, 불쌍하게도 내 여동생이 두 명이나 상처를 입어 버렸어. 언젠가 침략자들에게는 그에 상응하는 대가를 치르게 할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/main3.ogg"},"전투개시":{"voiceline":"이번에는 마음대로 하도록 내버려 두지 않겠어……전 주포 장전 완료, 일제 사격 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/battle.ogg"},"상세확인":{"voiceline":"지휘관… 나를 너무 쳐다보진 말아 줄 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/detail.ogg"},"드랍 설명":{"voiceline":"콜로라도급 전함 콜로라도 (BB-45)","voicelink":null},"의뢰 완료":{"voiceline":"상당한 연료와 물자가 운반되어 왔군… 이걸로 다음 출격도 문제 없을 것 같다","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/expedition.ogg"},"실망":{"voiceline":"지휘관, 저기… 너무 가까이 오지 말아줄래.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/feeling1.ogg"},"낯섦":{"voiceline":" '빅 세븐', 이것은 내 자랑스러운 이름이다. 그러나 유감스럽게도 우리들 전함의 시대는 지나갔고, 새로운 시대를 맞이하지 않으면 안 될 것 같군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/feeling2.ogg"},"호감":{"voiceline":"지휘관은 왜 그렇게 나를 신경 쓰는 거지? 많은 사람이 나를 두려워하고 멀리한다. 아마 나도 그것에 익숙해져 있었던 거겠지. 하지만, 요즘은 어쩐지… 조금 외롭다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 정말 이상한 사람이군, 나 같이 성격 나쁜 사람과 이야기를 하고 싶다니… 하지만, 지휘관과 이야기하는 거, 싫지는 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/feeling4.ogg"},"사랑":{"voiceline":"매번 전투가 끝난 후 지휘관에게 칭찬을 받을 수 있는 것도, 내가 싸우는 의미 중 하나가 되었어. 지휘관, 좀 더… 좀 더 날 칭찬해주지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"무사히 모든 사람을 모항으로 귀항시키는 것, 이것은 나의 책임이기도 하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/home.ogg"},"hp 경고":{"voiceline":"함교에 탄이 명중했다고? 대미지 컨트롤, 서둘러!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 대기 시간은 이미 끝났을 텐데, 언제 출격할 수 있는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/login.ogg"},"실패":{"voiceline":"여기서 끝날 내가 아니야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔어. 어쩌면 동생들의 소식이 있을지도 모른다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/mail.ogg"},"임무":{"voiceline":"지휘관, 화력 지원이라도, 함대 결전이라도 좋아, 작전 명령을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/mission.ogg"},"임무완료":{"voiceline":"지휘관, 임무 보상이 도착했다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/mission_complete.ogg"},"서약":{"voiceline":"모르는새 나도 지휘관을 의지하게 되었군. '빅 세븐'의 일원으로서의 이 힘, 당신을 보호하기 위해 사용하겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/propose.ogg"},"스킬":{"voiceline":"이번에야말로 보여주겠어, 빅 세븐의 진정한 힘을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/skill.ogg"},"터치1":{"voiceline":"지휘관, 교정한 내 주포에 손대지 말아줘, 사격 정확도에 영향을 주니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/touch.ogg"},"터치2":{"voiceline":"역시 지휘관을 16인치 포에 집어넣고 발사하는 편이 좋을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/touch2.ogg"},"입수시":{"voiceline":"네가 날 부르고 있는 건가? 좋아, 이날을 애타게 기다리고 있었다. 이글 유니온 전함 콜로라도, '빅 세븐'의 한 사람으로서, 전투 서열에 참가하겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/unlock.ogg"},"강화성공":{"voiceline":"흠. '빅 세븐'으로서의 난 강력한 힘을 가지고 있지만, 전황에 맞는 개조도 필요하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"응? 내가 MVP인가, 빅 세븐에게 이런 것쯤 식은 죽 먹기지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":n