do2603/AzurLane/main/audio/voiceline/105093/detail.ogg"},"드랍 설명":{"voiceline":"다른 동료들이랑 바다에 안 들어가고 여기서 나와 같이 일몰을 보기로 했다고…? 모처럼 바다에 왔는데 정말 괜찮은 건가? 아, 아니… 난 네가 좋다면야……","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아온 모양이군. 다들 격려해준 다음에… 다시 내 곁으로 돌아와 주겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105093/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관이 곁에 있어줘서 우린 새로운 목표와 즐거움을 찾을 수 있었지. 그래, 「최강」이나 「세계 평화」 같은 거창한 게 아니라… 동료들과 함께 펼칠 무대, 후야제의 불꽃놀이, 눈앞에 펼쳐진 아름다운 석양…… 너와 함께 보내는 이 소중한 시간이야말로, 그 무엇보다 귀중해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105093/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"왔군, 지휘관. 메릴랜드랑 웨스트버지니아 못 봤나? ……아니, 그 둘이 걱정된다기보단, 네가 둘한테 휘둘리는 게 아닐까 싶어서 말이지… 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105093/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"♪~…… 아, 방금 그건 웨스트버지니아랑 같이 만든 신곡이다. 시간이 있을 때 조금 더 다듬어두고 싶어서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105093/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무는 잊으라고 말하고 싶지만…… 같이 처리하자. 다들 안심하고 불꽃놀이를 즐길 수 있게 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105093/mission.ogg"},"임무완료":{"voiceline":"임무 완료. 이제 후야제도 편히 즐길 수 있겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105093/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"슬슬 바닷바람이 쌀쌀해지는 것 같군… 지휘관, 같이 덮을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105093/touch.ogg"},"터치2":{"voiceline":"다들 돌아오기 전에…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105093/touch2.ogg"},"입수시":{"voiceline":"다른 동료들이랑 바다에 안 들어가고 여기서 나와 같이 일몰을 보기로 했다고…? 모처럼 바다에 왔는데 정말 괜찮은 건가? 아, 아니… 난 네가 좋다면야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/