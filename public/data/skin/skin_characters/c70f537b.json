[{"클뜯 id":207030,"클뜯 함순이 id":20703,"함순이 이름":"일러스트리어스","한글 함순이 + 스킨 이름":"일러스트리어스","영문 함순이 + 스킨 이름":"Illustrious","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207030/shipyard.png","설명":"일러스트리어스급 항공모함·일러스트리어스 (HMS Illustrious)","자기소개":{"voiceline":"장갑항모── 일러스트리어스랍니다. 안녕하세요, 지휘관님. 어머, 이래 봬도 조금 토라질 때도 있다구요~ 타란토를 야습했을 땐, 겸사겸사 파스타 쪽 함대도 괴롭혔었답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/profile.ogg"},"메인1":{"voiceline":"저기, 일러스트리어스의 함재기 못 보셨나요? 네? 발밑, 말인가요? 어머 참, 시야가… 잘 안 보이와요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/main1.ogg"},"메인2":{"voiceline":"지휘관님의 손…… 일러스트리어스의 마음의 소리, 느끼고 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/main2.ogg"},"메인3":{"voiceline":"지휘관님? 그렇게 지그시 바라보시는데, 제가 그렇게 예쁜가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/main3.ogg"},"전투개시":{"voiceline":"무의미한 싸움을 어째서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/battle.ogg"},"상세확인":{"voiceline":"저기… 일러스트리어스의 손수건을 주워주지 않으시겠나요…… 저, 숙이면 균형을 못 잡아서 잘 쓰러지거든요… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/detail.ogg"},"드랍 설명":{"voiceline":"일러스트리어스급 항공모함·일러스트리어스 (HMS Illustrious)","voicelink":null},"의뢰 완료":{"voiceline":"바라옵건대 이 세계의 어둠을 어느 곳이든 빛이 비춰지길~♬ 어머, 그 애들이 돌아왔사와요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/expedition.ogg"},"실망":{"voiceline":"이 일러스트리어스라도 지휘관님의 마음속 어둠에 미치지 못한다는 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 여자애의 어디가 제일이라고 생각하세요? ──정말~ 제 눈을 바라보고 얘기해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 전 이래 봬도 의외로 야전을 좋아한답니다? ……정말, 그런 게 아니라요~ 그래도, 지휘관님은 역시 좋아하시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님…… 연착륙…… 시험해볼래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/feeling4.ogg"},"사랑":{"voiceline":"지휘관님에 관한 거라면, 일러스트리어스는 뭐~든지 받아들일 수 있어요. 그러니까 지휘관님의 마음, 전부 일러스트리어스에게 알려줘요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지치셨나요? 조금 편하게 쉬셔요. 영차…… 등 두드려드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/home.ogg"},"hp 경고":{"voiceline":"지휘관님, 당황하지 마세요. 전 여기에 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/hp_warning.ogg"},"로그인":{"voiceline":"평안하신지요, 지휘관님. 조금 정리해뒀습니다. 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/login.ogg"},"실패":{"voiceline":"물러나 주세요. 아니하시면 제 목숨을 걸어서라도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/lose.ogg"},"우편":{"voiceline":"지휘관님. 편지네요. 가져다드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/mail.ogg"},"임무":{"voiceline":"지휘관님, 완료하지 않은 임무를 방치하면 안 된다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 보너스를 잊지 말아 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/mission_complete.ogg"},"서약":{"voiceline":"빛은 균등하게 비춰주는 법이지만, 지휘관님이라면 조금 더 비춰드릴게요. 우후훗, 일러스트리어스는 지휘관님한테서 소중한 걸 받을 거니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/propose.ogg"},"스킬":{"voiceline":"성스러운 빛이여, 나에게 힘을! ~랄까나♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/skill.ogg"},"터치1":{"voiceline":"지휘관님에게 칭찬받는 것 같아서…… 안심돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/touch.ogg"},"터치2":{"voiceline":"정말…… 지휘관님도 참 애기 같아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 평안하신지요. 일러스트리어스가 착임했습니다. 사랑과 평화를 이 바다에, 성스러운 빛을 당신에게~ 어라? 저야말로 저 수수께끼의 빛이 필요…한 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/unlock.ogg"},"강화성공":{"voiceline":"이걸로 빛을 더 먼 곳까지 비출 수 있겠네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우리의 승리의 목적지는 빛이 넘쳐 흐르는 장소랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['새러토가'] : 새러 선생님은 여전하시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207030/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X",