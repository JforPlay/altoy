[{"클뜯 id":107040,"클뜯 함순이 id":10704,"함순이 이름":"레인저","한글 함순이 + 스킨 이름":"레인저","영문 함순이 + 스킨 이름":"Ranger","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107040/shipyard.png","설명":"레인저급 항공모함·레인저 (CV-4)","자기소개":{"voiceline":"유니온 해군의 첫 항공모함으로서 설계된 함선, 레인저라고 합니다. 대서양에 배속되었을 때는 가장 큰 항공모함으로서 여러 임무에 종사했습니다. 일단 항공모함이지만… 이상한 기대를 하진 마세요! 당신을 위해서 이상한 일 같은 건 안 할 거니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/profile.ogg"},"메인1":{"voiceline":"작전 이외에 가르칠 수 있는 것은, 서, 성…… 보건 체육이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/main1.ogg"},"메인2":{"voiceline":"사쿠라 엠파이어? …에, 그게, 어… 어… 아, 알려줄 수 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/main2.ogg"},"메인3":{"voiceline":"마, 말을 듣지 않으면 벌을 줄 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/main3.ogg"},"전투개시":{"voiceline":"여러분, 가장 전적이 낮은 아이는 나중에 보충이에요~~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/battle.ogg"},"상세확인":{"voiceline":"이, 이상한 데 보지 말고 진지하게 해주세요! ──하, 함교를 보고 있던 건가요!?…… 아하하……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/detail.ogg"},"드랍 설명":{"voiceline":"레인저급 항공모함·레인저 (CV-4)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관 군~ 성과의 체크를 잊으면 나중에 그 아가씨들이 화내도 몰라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/expedition.ogg"},"실망":{"voiceline":"이제 그만둘까나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/feeling1.ogg"},"낯섦":{"voiceline":"어째서 요즘 아이는 모두 이상한 것만 생각하고 있는 거냐구…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/feeling2.ogg"},"호감":{"voiceline":"지휘관 군은 하면 할 수 있는 아이군요. 조금 기쁘네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/feeling3.ogg"},"기쁨":{"voiceline":"그그그 금단의 사랑?! 레인저 선생님은 그런 걸 생각한 적도 없고 그런 만화 읽은 적도 없고 저저저 전혀 기대하지 않는다구요! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/feeling4.ogg"},"사랑":{"voiceline":"지휘관 군은 내가 없으면 정말 글러 먹은 것 같네요. 그, 그러니까…… 그…… 유, 유급이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"숙제 끝났습니까? 네, 말했던 대로 상을 드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"좋은 날씨니까 임무를 수행하러 가고 싶네요. 그쵸, 지휘관 군?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/login.ogg"},"실패":{"voiceline":"이런 모습… 지휘관에게 보일 수는…… 저, 절대 용서하지 않겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 온 편지입니다. 답신은 제가 하나하나 자상하게~ 알려줘도오… 되지 않아… 우우우으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/mail.ogg"},"임무":{"voiceline":"임무를 확실히 해낼 수 있도록 해주세요. 안 그러면 나중에 보충이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/mission.ogg"},"임무완료":{"voiceline":"보수… 그리 좋은 게 아니라 해도, 잊어도 괜찮은 일이 되는 건 아닌 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/mission_complete.ogg"},"서약":{"voiceline":"우우…… 학생에게 이런 귀중한 물건을 받고, 거기다 기뻐하기까지 하다니…… 레인저, 향도 실격입니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/propose.ogg"},"스킬":{"voiceline":"레인저, 스트라이크!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/skill.ogg"},"터치1":{"voiceline":"꺗! 지휘관 군…… 그…… 그만둔다고 절대 말 안 한다니까~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/touch.ogg"},"터치2":{"voiceline":"이, 이상한 소리 마세요! 누가 부끄러워한다는 거죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/touch2.ogg"},"입수시":{"voiceline":"유니온 최초의 특형 항공모함·레인저입니다! 대서양에 배속되어 있는 동안에는 주로 수송과 항공모함의 호위를 맡았습니다. 특별 향도? 따, 딱히 그걸 위해서 파견된 건… 그, 그치만…… 꼭 해야 한다면(웅얼웅얼)－－아무 말도 안 했어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/unlock.ogg"},"강화성공":{"voiceline":"레인저 선생님이 좀 더 많은 걸 가르쳐 줄 수 있겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관 군은 적들처럼 금방 싫증 나지 않았으면 좋겠는데── 아앗…… 지, 지금 이상한 말 해버린 건……!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"N","ex_chat_status":0},{"클뜯 id":107049,"클뜯 함순이 id":10704,"함순이 이름":"레인저","한글 함순이 + 스킨 이름":"레인저·改","영문 함순이 + 스킨 이름":"Ranger (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/mai