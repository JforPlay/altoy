:"......? 내가 꾼 꿈을 알고 싶은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899021/headtouch.ogg"},"모항귀환":{"voiceline":"말해달라, 이 축제 의상의 의의를. 말해달라, 이 순간 내가 취해야할 행동이 무엇인지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"새해의 밤에 바라는 것——고요한 수면, 그리고 그리운 일곱 빛깔의 꿈, 그것 뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899021/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"욕망에 사로잡히는 것은 동물의 본능이지. 호기심으로 인해 금기에 도전하는 것은, 인간의 본심이다...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899021/touch2.ogg"},"입수시":{"voiceline":"희망을 운명에 맡길 것이 아니라, 축제의 따뜻한 바람에 몸을 맡겨라. 서조를 바라는 것은 인지상정이요, 신앙에 결코 어긋나지 않는 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899021/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"정월","상점 id":70478,"상점 카테고리 id":2,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":900,"기간":"상시","진영":"FFNF","레어도":"SSR","ex_chat_status":0},{"클뜯 id":899028,"클뜯 함순이 id":89902,"함순이 이름":"샹파뉴","한글 함순이 + 스킨 이름":"영원한 찬송","영문 함순이 + 스킨 이름":"Adulation Eternal","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899028/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899028/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899028/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899028/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899028/shipyard.png","설명":"찬송 받는 송가는 존귀한 아이리스에 바치고, 연주되는 명향은 맑은 기도로 결정화하네. 축복은 의식으로 내려지는 것이 아니오, 영원토록 계속되는 굴레야말로 사람의 위업일지니.","자기소개":null,"메인1":{"voiceline":"생명은 덧없이 짧고, 함선의 용골 또한 영원하지 아니하네. 찰나의 행복을 사랑하는 것은 벗어날 수 없는 인간의 숙명.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/main1.ogg"},"메인2":{"voiceline":"잔을 가득 채우는 것은 샹파뉴에게 부과된 책무. 정각을 알리는 것도, 휴식을 재촉하는 것도 마찬가지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/main2.ogg"},"메인3":{"voiceline":"전해오는 찬가는 거짓될 수 없는 것. 샹파뉴, 위업을 기리며 애정에 영원을 부여하리라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/main3.ogg"},"전투개시":{"voiceline":"지휘관을 위한 전투… 그것은 샹파뉴가 정한 신조일지니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/battle.ogg"},"상세확인":{"voiceline":"서약을 소리높여 찬송하리라. 연모, 충성, 부과된 사명, 정해진 신조…. 샹파뉴는 지금 인간의 행복을 수호하는 존재일지니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/detail.ogg"},"드랍 설명":{"voiceline":"찬송 받는 송가는 존귀한 아이리스에 바치고, 연주되는 명향은 맑은 기도로 결정화하네. 축복은 의식으로 내려지는 것이 아니오, 영원토록 계속되는 굴레야말로 사람의 위업일지니.","voicelink":null},"의뢰 완료":{"voiceline":"귀가에 전해오는 연인의 감언… 마중 채비는 더불어 치러야 할지니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"선택하라. 정화하는 성령의 세례를, 차오르는 풍요의 미각을, 탐닉케 하는 몽상의 밀회를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"감개, 감각. 이어지는 마음의 고동을, 촉촉해지는 입술의 떨림을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/login.ogg"},"실패":{"voiceline":"깨지지 않는 맹세로 샹파뉴의 수호는 영구히 이어지리니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/lose.ogg"},"우편":{"voiceline":"전해오는 소식은 기쁠까, 허망할까. 자랑스러울까, 분할까. 모든 것은 지휘관의 답신에 달려있으리.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관의 체온, 심장 소리, 여러 감촉, 샹파뉴를 광희로 이끄는 것일지니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/touch.ogg"},"터치2":{"voiceline":"연인과의 영원을 알면서도, 한순간의 쾌락을 욕망하네…. 지휘관의 소원을 실현하는 것은, 샹파뉴가 취해야 할 행동일지니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/touch2.ogg"},"입수시":{"voiceline":"찬송 받는 송가는 존귀한 아이리스에 바치고, 연주되는 명향은 맑은 기도로 결정화하네. 축복은 의식으로 내려지는 것이 아니오, 영원토록 계속되는 굴레야말로 사람의 위업일지니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"하늘에 흩날리는 거품처럼 허망하지 않게, 영원토록 새겨지는 승리로 남기를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899028/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"서약","상점 id":0,"상점 카테고리 id":9998,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"FFNF","레어도":"SSR","ex_chat_status":0}]