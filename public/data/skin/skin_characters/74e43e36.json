[{"클뜯 id":899020,"클뜯 함순이 id":89902,"함순이 이름":"샹파뉴","한글 함순이 + 스킨 이름":"샹파뉴","영문 함순이 + 스킨 이름":"Champagne","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899020/shipyard.png","설명":"전함——샹파뉴 ","자기소개":{"voiceline":"그때는 사명도, 공로도 없었다. 나는 허무에서 왔지만 이 세상에 내려왔지. 나의 지휘관, 샹파뉴가 승리자를 위한 술이 되기를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/profile.ogg"},"메인1":{"voiceline":"지휘관, 무슨 생각을 하고 있지? 생존의 의미, 아니면…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/main1.ogg"},"메인2":{"voiceline":"밀려오는 파도는 자연의 섭리. 그것을 따라 흐르는 것은 나의 숙명.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/main2.ogg"},"메인3":{"voiceline":"함대와 함께 살아가는 것은 나의 사명——지휘관이 나에게 부여한 사명.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/main3.ogg"},"전투개시":{"voiceline":"함대를 위해 싸우는 것이 나의 사명.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/battle.ogg"},"상세확인":{"voiceline":"지휘관, 당신이 추구하는 것을 알려줘——누구도 따라올 수 없는 업적인가? 세계의 정점에서 군림하는 것인가? 아니면, 자신만의 세계를 구축하는 것?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/detail.ogg"},"드랍 설명":{"voiceline":"전함——샹파뉴","voicelink":null},"의뢰 완료":{"voiceline":"새들이 다가오고 있어—— 그들이 돌아왔군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/expedition.ogg"},"실망":{"voiceline":"왜 나에게 거짓된 빛을 주려고 하는 가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/feeling1.ogg"},"낯섦":{"voiceline":"세계는 거대한 호수와 같지. 돌을 던지면 잔물결이 일어나지면, 곧 평화를 되찾고는 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/feeling2.ogg"},"호감":{"voiceline":"나무는 바람에 날아가지 않기 위해 땅속 깊이 파고들고, 물고기는 존속을 위해 물길을 거스르지. 모든 것이 허무로 돌아갈 것을 알면서도, 운명을 거스르기 위해서——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/feeling3.ogg"},"기쁨":{"voiceline":"함대를 지기키 위해 필요한 무기—— 장갑, 주포, 어뢰—— 지휘관에게 줄 수는 없는 것. 그러니 함선인 내가, 이 사명을 완수하고 지휘관과 함대를 보호하겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/feeling4.ogg"},"사랑":{"voiceline":"무력한 자는 운명을 거스르고, 힘있는 자는 지켜보지 않으니. 지휘관의 빛, 따스함, 감정—— 그것은 지킬만한 가치가 있는 것.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"잠시, 브랜디의 향기만을 느낄 수 있도록. 이 세계와 사람들에게는 '잠깐'이 필요해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/home.ogg"},"hp 경고":{"voiceline":"상처는, 갑옷이 된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/hp_warning.ogg"},"로그인":{"voiceline":"알려줘. 당신이 필요로 하는 것, 당신이 나에게 바라는 것을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/login.ogg"},"실패":{"voiceline":"여기는… 끝이 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/lose.ogg"},"우편":{"voiceline":"편지가 먼 곳의 소식을 가져왔구나. 기쁨? 슬픔? 아니면, 안부인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/mail.ogg"},"임무":{"voiceline":"날개짓을 하지 않으면 푸른 하늘에 닿을 수 없는 법. 노를 젓지 않으면 해안에 닿을 수 없는 법.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/mission.ogg"},"임무완료":{"voiceline":"가장 아름다운 붓꽃은 부지런한 정원사의 정원에 피는 법.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/mission_complete.ogg"},"서약":{"voiceline":"이 세상에 언어가 사라져도 지휘관의 호흡을 느낄 수 있고, 이 세상에 빛이 사라져도 지휘관의 얼굴을 볼 수 있겠지. 어떤 것도 나에게서 지휘관을 지울 수 없으니… 당신이 나에게 준 온기를 영원한 수호로 보답하겠어. 이것이… 나의 의지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/propose.ogg"},"스킬":{"voiceline":"짙은 푸른빛 속에 잠들어라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/skill.ogg"},"터치1":{"voiceline":"따뜻한 온기는… 잊기 어려워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/touch.ogg"},"터치2":{"voiceline":"지휘관의 모든 것은—— 원시적이고, 가장 꺼려지는… 충동.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/touch2.ogg"},"입수시":{"voiceline":"아이리스 리브레, 샹파뉴다. 지휘관, 나에게 사명과 존재의 이유를 부여해달라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/unlock.ogg"},"강화성공":{"voiceline":"예리한 칼도 언젠가는 녹슬지. 강함만을 추구하는 것에 무슨 의미가 있지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"사명은, 반드시 이뤄야 하는 것.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['Z46'] : 당신이 원한다면 이 세상은 오색찬란하게 빛날지니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/couple_encourage1.ogg"},{"voiceline":"['가스코뉴'] : 응시, 경청. 이 세상은 감정으로 가득하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899020/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex