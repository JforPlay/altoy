[{"클뜯 id":401090,"클뜯 함순이 id":40109,"함순이 이름":"Z9","한글 함순이 + 스킨 이름":"Z9","영문 함순이 + 스킨 이름":"Z9","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401090/shipyard.png","설명":"1934A형 구축함 - Z9","자기소개":{"voiceline":"메탈 블러드의 1934A형 구축함, Z9… 「볼프강 젠커」예요…… 전투와 업무 모두 예전보다 능숙해졌으니…… 지휘관님, 부디 버리지 마세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/profile.ogg"},"메인1":{"voiceline":"서, 서류는… 다 처리했지만, 한 번만 더 확인하고 싶어서…… 먼저 보여달라고요? 네…… 완벽하다고요?! 후우… 다행이다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/main1.ogg"},"메인2":{"voiceline":"지휘관님. 작은 새랑 장미가 영원히 같이 있는 그림을 그렸어요…… 그림책의 결말이 너무 슬퍼서… 제가 다시 그린 거예요… 네, 이 작은 새를요. 새처럼 안 보인다…고요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/main2.ogg"},"메인3":{"voiceline":"지휘관님, 음… 여기 앉아도 될까요? 딱히 무슨 볼일이 있는 건 아니지만…… 더 지휘관님과 가까이 있고 싶어서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/main3.ogg"},"전투개시":{"voiceline":"출격 준비……! 아마 괜찮을지도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/battle.ogg"},"상세확인":{"voiceline":"지, 지휘관님이셨군요… 흑… 또 들켰어요…… 괜찮아요. 여기서 잠깐만 혼자 있으면…… 흑, 역시 지휘관님 곁에 있게 해주세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/detail.ogg"},"드랍 설명":{"voiceline":"1934A형 구축함-Z9","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어요. 지금 물자를 확인하고 올게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/expedition.ogg"},"실망":{"voiceline":"저기…… 지휘관님. 혹시 기분이 안 좋으시면 제 코트를 빌려드릴게요… 안에 숨어 있으면 아무도 모를 거예요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/feeling1.ogg"},"낯섦":{"voiceline":"읏, 지휘관님… 죄송해요. 제가 또 실수를 저질렀어요…… 넘어져서 서류가 엉망진창이… 바로 정리할게요…흑…… 네? 제 상처부터 치료해 주시려고요……? 감사합니다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 이번 그림책에서는 공주님과 왕자님이 결국 헤어지고 말았지만…… 제가 더 좋은 결말로 그려주고 싶어서요… 지휘관님, 뭐 좋은 아이디어 없을까요? …음, 같이 그려보실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/feeling3.ogg"},"기쁨":{"voiceline":"저… 잘하고 있다고요? 정말로요?! 그러면…… 음… 혹시 안아주실 수 있나요…? 열심히 한 보상으로…… 흑…지휘관님의 품속… 따뜻해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/feeling4.ogg"},"사랑":{"voiceline":"잘하는 거 하나 없어서 늘 걱정이었는데… 지휘관님은 늘 저를 인정하고 칭찬해 주시고, 저를 버리지 않으셨죠…… 흑…… 더 노력해서 더 잘할 테니… 계속 곁에 있게 해주세요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/feeling5.ogg"},"터치3":{"voiceline":"지휘관님, 더 쓰다듬어 주세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 고생 많으셨어요… 아, 그… 사, 사실은 저도 같이 외출 임무에 나갈 수 있어요…… 차, 착실하게 준비해서 절대 폐를 끼치지 않도록 할게요…!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/home.ogg"},"hp 경고":{"voiceline":"흑… 이대로면 버려지고 말 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님… 흑… 어, 어서 오세요…… 전 또 제가 뭘 잘못해서 버리고 가신 줄 알았어요…… 흐흑…… 죄송해요… 눈물이 자꾸……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/login.ogg"},"실패":{"voiceline":"흐흑…… 다음에는 더 열심히 할 테니… 지휘관님, 제발 버리지 마세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/lose.ogg"},"우편":{"voiceline":"지휘관님, 우편을 가지고 왔어요. 전부 분류해 뒀어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/mail.ogg"},"임무":{"voiceline":"지휘관님, 임무가 아직 덜 끝났어요. 제가 도와드릴게요…… 딱히 피곤하지는 않아요. 지휘관님 곁에 있으면 저, 하나도 지치지 않는걸요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 임무가 완료되었어요. 조금 있다가 혹시 괜찮으시면…… 같이 그림책 읽지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 음… 이걸 주신 의미는…… 계속 저를 버리지 않고 곁에 두시겠다는… 거 맞죠? ……그것뿐만 아니라 제 웃는 얼굴을 더 보고 싶으시다고요…? 흑…… 아아… 음… 울면 안 돼……참아야 해……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/propose.ogg"},"스킬":{"voiceline":"……잘할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/skill.ogg"},"터치1":{"voiceline":"지휘관님, 어디 가세요……? 물을 가지러 가는 것뿐이라고요…? 네! 저, 저도 갈게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/touch.ogg"},"터치2":{"voiceline":"꺅?! 아, 음…… 방금 건 훈시인가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 지휘관님. 저는 메탈 블러드의 구축함, Z9(볼프강 젠커)예요. 지휘관님께 도움이 된다면 뭐든 할 테니…… 부탁이에요… 버리고 가지 마세요…… 흑…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/unlock.ogg"},"강화성공":{"voiceline":"더 잘해서 지휘관님의 기대를 배반하지 않도록 할게요……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후우…… 이겼어요… 지휘관님. 저, 도움이 되었나요…? 에, 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"흑…… 더 잘할 수 있었는데… 지휘관님, 죄송해요…… 이, 이런 못난 저지만 꼭 안아봐도 될까요? 흑… 고맙습니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"우는 빈도가 줄었다고요…? 네! 지휘관님께 나름 도움이 되고 있고, 게다가… 지휘관님이 꼭 안아서 제게 힘을 주시는 것처럼, 저도 웃는 얼굴로 지휘관님께 힘이 되어드리고 싶어서요…! 에헤헤…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"에헤헤…… 지휘관님, 좋아해요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"쿨쿨… 응…? 지, 지휘관님, 어서 오세요! …죄송해요. 지휘관님이 앉아계시던 자리에서 잠들어서…… 그…… 지휘관님의 냄새를 맡으면 마음이 놓여서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님이 안 계신 동안 업무를 조금 처리했는데, 음…… 딱히 별문제는 없다…고요? 에헤헤, 도움이 되어서 다행이에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/login_ex.ogg"},"실패_ex":{"voiceline":"흑… 아파요… 어서 지휘관님 곁으로 돌아가고 싶어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/lose_ex.ogg"},"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"제 포옹도 지휘관님께 위로가 될 수 있기를……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/touch_ex.ogg"},"터치2_ex":{"voiceline":"아, 으음…… 지휘관님만 괜찮으시면…… 읏…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이겼어요…! 다음에는 더 쉽게 이길 수 있게 노력할게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['Z16'] :  멋있다…! 나도 저렇게 될 수 있으면 좋을 텐데… 흑…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401090/couple_encourage1.og