[{"클뜯 id":603040,"클뜯 함순이 id":60304,"함순이 이름":"트리에스테","한글 함순이 + 스킨 이름":"트리에스테","영문 함순이 + 스킨 이름":"Trieste","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603040/shipyard.png","설명":"트렌토급 중순양함—트리에스테","자기소개":{"voiceline":"트렌토급 2번함 트리에스테야. 그 대전에서는 지중해에서 임무를 다하고, 마지막에는 항공모함도… 아무것도 아니야. 지휘관은 방금 아무 말도 못 들은 거야, 알았지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/profile.ogg"},"메인1":{"voiceline":"보급 물자 확충은 내게 맡겨. 미적지근한 지휘관에게 맡기는 것보다야 내가 하는 편이 결과적으로도 더 낫겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/main1.ogg"},"메인2":{"voiceline":"아직도 틀린 부분이 있잖아. 정말, 몇 번이나 말하게 하지 말고 알아서 좀 고쳐. 숙제 늘려버린다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/main2.ogg"},"메인3":{"voiceline":"…피자에 파인애플……?! 인정할 수 없어……. 이런 폭력적인 행동 절대 용납 못 해……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/main3.ogg"},"전투개시":{"voiceline":"열심히 안 하는 애들은 복도로 내쫓을 거야……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/battle.ogg"},"상세확인":{"voiceline":"일도 안 하고 여긴 왜 온 거야? 어서 원래 자리로 돌아가. 아직 일이 덜 끝났잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/detail.ogg"},"드랍 설명":{"voiceline":"트렌토급 중순양함—트리에스테","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네. 휴우… 다들 무사해서 다행이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/expedition.ogg"},"실망":{"voiceline":"이제 만족했어? 휴우… 이번엔 내 차례야. 단단히 혼내줄 테니까 각오해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/feeling1.ogg"},"낯섦":{"voiceline":"쉬긴 아직 일러, 지휘관… 업무가 아니라 내가 낸 숙제가 아직 남아있잖아. 제대로 끝내 놓지 않으면, 내일 내 페이스를 쫓아올 수 없게 되니까, 밀리지 않도록 미리 해둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/feeling2.ogg"},"호감":{"voiceline":"일 다 끝났어? 그래. 밥 다 먹으면 목욕이라도 하고 와. 하루 동안 쌓인 피로를 풀기에는 그만한 게 없으니까 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/feeling3.ogg"},"기쁨":{"voiceline":"힘든 작전이었지. 조금은 휴식을 취하는 편이 좋을지도 모르겠네… 연락은 내가 할 테니까, 지휘관은 계획이라도 세워두고 있어… 나랑 같이 쉬고 싶다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/feeling4.ogg"},"사랑":{"voiceline":"딱히 피곤한 것도 아닌데, 왜 난 지휘관과 함께 쉬고 있는 걸까… 뭐, 지금은 지휘관이 제대로 쉬고 있는지 확실히 감독하는 편이…… 아, 지, 지금 갈 테니까 잠깐만 기다려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"보고서 확인은 내가 대신할 테니까, 지휘관은 모두와 전투 회고를 하러 다녀와. 자, 정신 차리고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/home.ogg"},"hp 경고":{"voiceline":"난감한 상황이네…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/hp_warning.ogg"},"로그인":{"voiceline":"시간에 맞춰 왔네. 지각하지 않아서 다행이야. 내일도 늦지 않도록 주의해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/login.ogg"},"실패":{"voiceline":"내가 더 엄하게 일러뒀어야… 윽!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/lose.ogg"},"우편":{"voiceline":"잊어버리기 전에 어서 우편을 확인해 둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/mail.ogg"},"임무":{"voiceline":"조금만 더 힘내. 다 해야 하는 거잖아? 잘 끝내면 내가 직접 만든 요리를 먹여줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/mission.ogg"},"임무완료":{"voiceline":"성공적으로 완수했네. 봐, 내 말대로 메모해두길 잘했지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/mission_complete.ogg"},"서약":{"voiceline":"아, 네네~ 무슨 말을 하나 했더니…… 응? 이 반지를 건네주려고 날 부른 거라고? 혹시 다른 사람이랑 착각한 건 아니지? 나, 나, 나한테 왜 반지를? 지휘관, 날 지금까지 그런 눈으로 보고 있었던 거야? 기, 기뻐! 그렇지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/propose.ogg"},"스킬":{"voiceline":"주위를 잘 살펴봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/skill.ogg"},"터치1":{"voiceline":"좀 쉬고 싶다고? 그래, 가볍게 스트레칭이라도 좀 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/touch.ogg"},"터치2":{"voiceline":"…읏?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/touch2.ogg"},"입수시":{"voiceline":"트렌토급 중순양함 2번함, 트리에스테야. 업무를 도와주러 왔는데 말이지… 지휘관, 그렇게 쳐다만 보지 말고 어서 업무에 복귀해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/unlock.ogg"},"강화성공":{"voiceline":"어머, 착한 아이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관 덕분에 승리했어. 평소에 엄하게 대한 이유, 이제 알겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"무릎베개 해주는 건 상관없지만, 트렌토처럼 응석을 받아주진 않을 거야. …내, 내가 아니라 지휘관이 해준다고? 그래, 가끔은……. 여, 역시 내가 해줄게! 자, 지휘관! (툭툭)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"입에 뭐 묻었잖아. 정말, 먹는 것도 서툴러가지고… 진짜 애라니깐. 자, 물도 마셔가면서……. 데이트가 아닌 것 같다고? 그, 그렇긴 하네…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"다들 기다리고 있어. 나랑 같이 있는 것보단, 다른 동료들이 있는 곳으로 가줘. …알았어 알았어, 나중에 꼭 같이 있어줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"아침 준비는 어때? 문제가 없다면 좋겠는데. 부디 모두에게 폐를 끼치는 것만은 삼가줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"자, 어느 임무부터 먼저 처리할지 생각하고 행동으로 옮기도록 해. 잘했어…. 아, 알았어. 데이트 약속해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/mission_ex.ogg"},"임무완료_ex":{"voiceline":"휴우…… 제대로 해냈네. 데이트 약속은 어때? 농담으로 말한 거 아닌데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"도와주려고? 괜찮아. 지휘관 손까지 빌릴 정도는 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/touch_ex.ogg"},"터치2_ex":{"voiceline":"어머나……♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"내 평소 관심 덕분…이 아니라, 당신 자신의 노력에 의한 승리야. 축하해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['트렌토'] : 응석 부리는 것 좀 적당히 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"여기가 틀…리진 않았네. 잘했어. 이래야 내가 안심하고 맡길 수 있는 지휘관이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/main5_ex.ogg"},"메인6_ex":{"voiceline":"내일 연습 참관에 가지고 갈 응원 도시락 반찬은 뭐가 좋을까? 일이 끝나기 전까지 생각해두도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603040/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"식재료 재고가… 말도 안 돼…. 식재료 재고가 부족하잖아? 지휘관, 이건 중대한 사건이니까 당장 해결해!","