[{"클뜯 id":306070,"클뜯 함순이 id":30607,"함순이 이름":"류호","한글 함순이 + 스킨 이름":"류호","영문 함순이 + 스킨 이름":"Ryuuhou","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306070/shipyard.png","설명":"류호 급 경항공모함—류호 ","자기소개":{"voiceline":"잠수모함에서 경항공모함으로, 숱한 출격 끝에 결국은 세토 내해에 머물게 되었지만…… 가만히 머무르기만 하지는 않겠습니다. 저 류호 는 이전에 말했던 것 같이 지휘관님을 위해 승리를 가져다드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/profile.ogg"},"메인1":{"voiceline":"잠수함 아이들을 돌보기는 쉽지 않아요…… 이, 이건 제가 직접 겪은 일이니 믿어주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/main1.ogg"},"메인2":{"voiceline":"다른 사람의 시선에 얽매이지는 않습니다. 우리는 함선, 무가 출신과도 같으니 당연한 태도지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/main2.ogg"},"메인3":{"voiceline":"가끔은 정규항모들이 부럽기도 해요. 저에게도 그런 힘이 있다면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/main3.ogg"},"전투개시":{"voiceline":"쌓이고 또 쌓인 투자와 열정, 전부 적에게 쏟아부으리!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/battle.ogg"},"상세확인":{"voiceline":"잠수함의 힘에 대해서는 잘 알고 있습니다. 지금 할 말은 아니지만, 세계 대전 때 항공모함으로 개조되지 않았다면 저는 모두에게 어떤 존재가 되었을까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/detail.ogg"},"드랍 설명":{"voiceline":"류호 급 경항공모함—류호 ","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었습니다. 먼저 마중을 가보겠습니다. 큰 수확이 있으면 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/expedition.ogg"},"실망":{"voiceline":"지휘관님께는 가까이 다가가고 싶지 않은 기운이 풍겨요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/feeling1.ogg"},"낯섦":{"voiceline":"저 바다는 그립지만 복잡한 마음이 들게 하는 곳이네요…… 하지만 이제는 상관없는 일이죠. 저에게 필요한 건 노력뿐이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/feeling2.ogg"},"호감":{"voiceline":"칭찬이나 비판에 대해서 지휘관님은 어떻게 생각하세요? 아뇨, 약간 궁금해서요. 신경 쓰지 마세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/feeling3.ogg"},"기쁨":{"voiceline":"노력해서 받은 포상이라면 기꺼이 받아들이고 앞으로 나아갈 힘으로 삼겠어요. …… 그, 그러니 지휘관님. 앞으로도 저에게 출격할 기회를 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/feeling4.ogg"},"사랑":{"voiceline":"지휘관님의 곁이기 때문에 제 실력을 보여드릴 기회를 잡을 수 있었어요. 지휘관님이 없으면 오늘의 저도 없겠지요. 그러니 지휘관님 앞에서는 생각을 억누르지 않아도… 에? 평소에도 제대로 표현하고 있었다고요? 그, 그랬나요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고하셨습니다. 잠시 쉬시는 것도… 하지만 너무 풀어지면 안 됩니다. 잠시 뒤에 전술 피드백이 있으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/home.ogg"},"hp 경고":{"voiceline":"쯧, 하필 이럴 때…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/hp_warning.ogg"},"로그인":{"voiceline":"이렇게 오래 기다리게 하다니… 아, 아닙니다. 이 정도는 괜찮으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/login.ogg"},"실패":{"voiceline":"흥, 이번에는 한 수 물러나 드리지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/lose.ogg"},"우편":{"voiceline":"편지, 무슨 내용일까…… 신경 쓰이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/mail.ogg"},"임무":{"voiceline":"새로운 임무인가…… 상부의 명령이니 얼른 끝내도록 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/mission.ogg"},"임무완료":{"voiceline":"지휘관님의 노력 덕분에 임무를 순조롭게 마칠 수 있었습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/mission_complete.ogg"},"서약":{"voiceline":"류호 , 앞으로도 지휘관님의 곁에서 함께 하겠어요. …… 앞, 앞으로 숨기는 것 없이 지휘관님을 대할 테니 각오하세…………요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/propose.ogg"},"스킬":{"voiceline":"승리는… 내 손 안에!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/skill.ogg"},"터치1":{"voiceline":"화려하면서도 늠름한 이 의상, 지휘관님도 이 아름다움을 아시겠지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/touch.ogg"},"터치2":{"voiceline":"마음속 번뇌를 없애 드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/touch2.ogg"},"입수시":{"voiceline":"잠수모함 타이게이의 개조형, 즈이호급 경항공모함 류호 . 승리를 가져다드리겠습니다! 네, 이번에는 좌절이 아닌 끊이지 않는 승리만을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/unlock.ogg"},"강화성공":{"voiceline":"특별히 보살펴주셔서 감사합니다. 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승부를 막론하고 담담한 자세를 유지하는 것, 이것이 바로 사쿠라 엠파이어가 가져야 할 자세.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"이렇게 오래 기다리게 하다니…… 지휘관님, 식사는 아직인가요? 제, 제가 뭐라도 만들어 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"어서 새로운 임무를 끝내자구요. 그렇지 않으면 다들 비서함의 감독 소홀이라고 할 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306070/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null