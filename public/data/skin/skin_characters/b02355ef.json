[{"클뜯 id":502010,"클뜯 함순이 id":50201,"함순이 이름":"얏센","한글 함순이 + 스킨 이름":"얏센","영문 함순이 + 스킨 이름":"Yat Sen","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502010/shipyard.png","설명":"경순양함 - 얏센 ","자기소개":{"voiceline":"이스트 글림 해군 제1 함대 소속, 얏센이라고 합니다. 다들 여기에 있다고 들었습니다. 이번에는 절대, 지휘관님의 곁에서 떨어지지 않겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/profile.ogg"},"메인1":{"voiceline":"닝하이의 빠오즈? 으음…… 그리운 맛이네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/main1.ogg"},"메인2":{"voiceline":"역사를 잊지 말아야만 비로소 더욱 앞으로 나아갈 수 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/main2.ogg"},"메인3":{"voiceline":"가끔 모두와 함께 훈련하던 나날을 떠올립니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/main3.ogg"},"전투개시":{"voiceline":"선배님들, 이 막중한 임무는 지금 얏센이 맡고 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/battle.ogg"},"상세확인":{"voiceline":"이 얏센에 관해서 무언가 알고 싶으신가요? 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/detail.ogg"},"드랍 설명":{"voiceline":"경순양함 - 얏센","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 담당한 아이들이 돌아왔습니다. 상태를 보러 가지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/expedition.ogg"},"실망":{"voiceline":"지휘관님은…… 제가 기다리던 '그 사람'은 아닌 것 같네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님…… '그 사람'은… 당신인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/feeling2.ogg"},"호감":{"voiceline":"지휘관님의 곁으로 돌아올 수 있어 정말 다행입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/feeling3.ogg"},"기쁨":{"voiceline":"예전 일, 말인가요……? 네, 지휘관님에게만… 그때의 이야기를 해드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님의 얼굴을 보면 가끔 숨 쉬는 것 조차 잊고 말아요…… 이상한 느낌, 이네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/feeling5.ogg"},"터치3":{"voiceline":"얏센은 이제 그때의 울보가 아니에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/headtouch.ogg"},"모항귀환":{"voiceline":"집, 마음이 따뜻해지는 곳이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/home.ogg"},"hp 경고":{"voiceline":"진정한 지옥은… 이미 경험했습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/hp_warning.ogg"},"로그인":{"voiceline":"또 만났군요, 지휘관님. 부디 걱정하지 마세요. 얏센이 계속 곁에서 모시도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/login.ogg"},"실패":{"voiceline":"포기한다? 아니요, 그런 건 하지 않아요. 더는 예전의 나약한 얏센이 아니랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/lose.ogg"},"우편":{"voiceline":"우편입니까? 책상에 올려뒀어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/mail.ogg"},"임무":{"voiceline":"새로운 임무를 전달받았습니다. 네, 얏센의 준비는 완벽해요. 언제든지 지시해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/mission.ogg"},"임무완료":{"voiceline":"임무 보수의 집계가 완료되었습니다. 확인을…… 저… 말씀인가요? 아니요, 딱히 구체적으로 원하는 건 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/mission_complete.ogg"},"서약":{"voiceline":"이것은…… 인연의 힘…… 꿈 처럼 어느덧 깨어버릴지도 몰라서, 무서워서…… 아뇨, 괜찮아요… 얏센, 이제부터 쭉 곁에 있을게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/propose.ogg"},"스킬":{"voiceline":"여기까지입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/skill.ogg"},"터치1":{"voiceline":"뭔가요? 이상한 기대를 품지 말아 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/touch.ogg"},"터치2":{"voiceline":"여성에 대해 이런 식의 행동을 하시다니, 지휘관님은 마음의 준비가 되어 있으신가 보군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/touch2.ogg"},"입수시":{"voiceline":"이 때를 줄곧 손꼽아 기다려왔습니다…… 이스트 글림 제1 함대 소속 얏센, 당신을 위해 전력을 다하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/unlock.ogg"},"강화성공":{"voiceline":"더 빨리 강해졌었다면, 어쩌면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 바람이 불 때만, 자신의 존재를 확실히 느낄 수 있어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['닝하이', '핑하이'] : 예전처럼 모두와 함께 있을 수 있는 것만으로, 이미 만족해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502010/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502011,"클뜯 함순이 id":50201,"함순이 이름":"얏센","한글 함순이 + 스킨 이름":"진수아미","영문 함순이 + 스킨 이름":"Paragon of Celestial Grace","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502011/shipyard.png","설명":"경사스러운 길일에 지휘관님과 같이 아름다운 풍경을 바라볼 수 있다니 더할 나위 없이 영광스럽습니다. 그… 빈말이 아니라, 이렇게나 잘 대해주셔서 조금은 송구스러울 정도라….","자기소개":null,"메인1":{"voiceline":"동료들과 함께 보내는 평화로운 시간은 따뜻하고 행복이 느껴져요. 지휘관님과 함께 보내는 시간에는… 또 다른 행복을 느끼고 있는 걸지도 몰라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/main1.ogg"},"메인2":{"voiceline":"덕분에 모항의 춘절은 해마다 활기를 띠게 되었답니다. 물론 그만큼 돌봐줘야 할 애들도 늘어서… 행복한 고민이라는 건 이런 걸 말하는 거겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/main2.ogg"},"메인3":{"voiceline":"…아, 방금 절 보고 계셨나요? 아뇨, 지휘관님을 탓하려는 게 아니라, 저도 가끔은 이렇게… 넋을 잃고 보고 있을 때가 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"부끄럽습니다만… 이건 지휘관님과 만나는 걸 젠하이가 알아차려, 그녀에게 휩쓸려 입게된 것인데… 어떠…신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/detail.ogg"},"드랍 설명":{"voiceline":"경사스러운 길일에 지휘관님과 같이 아름다운 풍경을 바라볼 수 있다니 더할 나위 없이 영광스럽습니다. 그… 빈말이 아니라, 이렇게나 잘 대해주셔서 조금은 송구스러울 정도라….","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"머리 모양이… 신경 쓰이시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/headtouch.ogg"},"모항귀환":{"voiceline":"고생 많으셨습니다. 마침 적당한 곳에 다기가 대강 갖추어져 있기도 하니, 괜찮으시면 얏센이 모자라나마 차 한 잔 내어드려도 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 새해 복 많이 받으세요. 저도 방금 막 도착한 참이랍니다. 자, 이쪽으로 오세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/login.ogg"},"실패":null,"우편":{"voiceline":"우편 말씀이신가요? 새로운 것이 오면 집무실으로 전해주겠다고 안샨이 말했어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/mail.ogg"},"임무":{"voiceline":"아직 임무가 남아 있으신가요? 급한 건이라면 저도 돕게 해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/mission.ogg"},"임무완료":{"voiceline":"임무 보상은 벌써 모항에 도착해 있답니다. 걱정하시 않으셔도 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"이렇게 손을 포개고 있는 것만으로도 온기가 전해지네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/touch.ogg"},"터치2":{"voiceline":"만약 동료가 지나가기라도 하면……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/touch2.ogg"},"입수시":{"voiceline":"경사스러운 길일에 지휘관님과 같이 아름다운 풍경을 바라볼 수 있다니 더할 나위 없이 영광스럽습니다. 그… 빈말이 아니라, 이렇게나 잘 대해주셔서 조금은 송구스러울 정도라….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70804,"상점 카테고리 id":3,"스킨 태그":"배경, 쁘띠모션","입수 영상":"X","재화":880,"기간":"상시","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502012,"클뜯 함순이 id":50201,"함순이 이름":"얏센","한글 함순이 + 스킨 이름":"청차의 향기","영문 함순이 + 스킨 이름":"Pristine Leaves, Rich Warmth","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502012/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502012/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502012/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502012/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502012/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502012/shipyard.png","설명":"바쁘신 와중에 응해주셔서 대단히 영광입니다…. 그렇게 예의 차릴 거 없다구요? 후훗, 마침 차를 내린 참이니, 얏센 곁에 앉아주세요.","자기소개":null,"메인1":{"voiceline":"진한 맛과 담백한 맛, 사람의 취향은 저마다 다르지요. 지휘관님께서는 어떤 맛을 좋아하시는지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/main1.ogg"},"메인2":{"voiceline":"하얼빈… 동료가 말리지 않았다면 가게의 찻잎을 모조리 사재기할 뻔했죠. 다음부터는 딩안에게 부탁하는 편이 좋을지도 모르겠네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/main2.ogg"},"메인3":{"voiceline":"지휘관님, 찻잔이 비었네요. 더 따라드릴까요? 아, 지금 막 내린 차라 뜨거우니 조심하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"시냇물 소리와 자연의 향기, 마음이 안정되네요…. 아, 저도 모르게 넋을 놓고 말았네요. 죄송합니다. 흐트러진 모습을 보여드려….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/detail.ogg"},"드랍 설명":{"voiceline":"바쁘신 와중에 응해주셔서 대단히 영광입니다…. 그렇게 예의 차릴 거 없다구요? 후훗, 마침 차를 내린 참이니, 얏센 곁에 앉아주세요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관님께서는 공무로 바쁘시기 때문에 잠시 자리를 비우셔야 한다는 것쯤은 저도 알고 있습니다. 부디 괘념치 마시길. 우선은 차라도 드시면서 휴식을 취하시길 바라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 차는 곧 준비되니 조금만 기다려주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/login.ogg"},"실패":null,"우편":{"voiceline":"우편이 항구에 도착했다고 하더군요. 돌아가면 같이 확인해봐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/mail.ogg"},"임무":{"voiceline":"새로운 임무인가요? 서두르지 않으셔도 되니, 늘 하시던 페이스대로 진행하세요. 얏센은 여기서 계속 기다리고 있을테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/mission.ogg"},"임무완료":{"voiceline":"임무가 무사히 완료되었습니다. 지휘관님, 부디 노동과 휴식의 밸런스는 잘 맞춰주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님께서 따라주시는 건가요? 그럼 사양 않고 받도록 하지요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/touch.ogg"},"터치2":{"voiceline":"자, 잠깐만 기다려주세요. 지금은 차를 내리는 중이라…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/touch2.ogg"},"입수시":{"voiceline":"바쁘신 와중에 응해주셔서 대단히 영광입니다…. 그렇게 예의 차릴 거 없다구요? 후훗, 마침 차를 내린 참이니, 얏센 곁에 앉아주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502012/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":