"터치3":null,"모항귀환":{"voiceline":"남편의 귀가를 기다리는 마음은… 꽤나 따뜻한 마음이군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502018/home.ogg"},"hp 경고":null,"로그인":null,"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"왜 그러십니까, 지휘관님? 얏센은 이곳에서 언제까지 당신을 기다리고 있겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502018/touch.ogg"},"터치2":{"voiceline":"지휘관님, 너무 서두르지 마세요… 적어도 방에는 돌아가서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502018/touch2.ogg"},"입수시":{"voiceline":"오래 기다렸습니다, 지휘관님. 소인 얏센, 지휘관님의 너그러운 양해를 구합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502018/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"서약","상점 id":0,"상점 카테고리 id":9998,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502019,"클뜯 함순이 id":50201,"함순이 이름":"얏센","한글 함순이 + 스킨 이름":"얏센·改","영문 함순이 + 스킨 이름":"Yat Sen (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502019/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502019/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502019/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502019/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502019/shipyard.png","설명":"지휘관님, 걱정 마세요. 저는 아무렇지도 않답니다. 새로운 모습을 한 얏센으로서 다시금 모실 수 있도록 해주세요.","자기소개":null,"메인1":{"voiceline":"잉 루이와 차오 호… 둘의 사정을 모르는 사람이 보면 사이가 나빠 보일 수도 있지만, 사정을 알고 보면 둘이 주거니 받거니 하는 것도 흐뭇해 보인답니다. 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502019/main1.ogg"},"메인2":{"voiceline":"새로운 시대를 향한 도전에 옛 경험 그대로 임할 수는 없어요. 혜안을 가지고 계신 지휘관님이라면 옳고 그름을 판별하고, 나름의 판단을 내리실 수 있을 거라 저는 믿습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502019/main2.ogg"},"메인3":{"voiceline":"단지 강해지기만을 바란 저였지만, 지금은 세상의 풍파에 대해 더 알려고 해요. …후후, 물론 지휘관님이나 모두와 더 함께할 수 있기 위해서죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502019/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"만약 제가 지휘관님에 대해 아직 더 알고 싶은 것이 있다고 하면…… 뭔지 궁금하신가요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502019/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 걱정 마세요. 저는 아무렇지도 않답니다. 새로운 모습을 한 얏센으로서 다시금 모실 수 있도록 해주세요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"역시 가장 마음이 편안한 곳은 집이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502019/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 어서 오세요. 얏센은 평소처럼 곁에 있답니다. 오늘도 모든 일이 순조롭게 진행되기를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502019/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"무슨 일이시죠? 괜찮으시다면 저 얏센이 고민을 들어드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502019/touch.ogg"},"터치2":{"voiceline":"상황에 걸맞지 않은 행동은 그에 따른 책임을 지게 될 텐데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502019/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 걱정 마세요. 저는 아무렇지도 않답니다. 새로운 모습을 한 얏센으로서 다시금 모실 수 있도록 해주세요.","voicelin