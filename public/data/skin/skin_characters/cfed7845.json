[{"클뜯 id":499090,"클뜯 함순이 id":49909,"함순이 이름":"힌덴부르크","한글 함순이 + 스킨 이름":"힌덴부르크","영문 함순이 + 스킨 이름":"Hindenburg","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499090/shipyard.png","설명":"중순양함—힌덴부르크","자기소개":{"voiceline":"메탈 블러드 순양함 힌덴부르크야. 아무래도 나 같은 전함을 '특별계획함'이라고 부르는 것 같은데… 아무래도 상관없어. 힘으로 증명해서 내 무료함을 달래주기만 한다면, 당신과 맺은 계약은 잘 지킬 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/profile.ogg"},"메인1":{"voiceline":"계약자, 당신이 다른 함선과 맺고 있는 관계는 뭐지? 신뢰? 거래? ……그렇군, 재밌을 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/main1.ogg"},"메인2":{"voiceline":"일상은 늘 지루함으로 가득해. 계약자, 이 무료함을 달래주지 않는다면, 당신 몸을 써서라도 달랠 수밖에.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/main2.ogg"},"메인3":{"voiceline":"마시고 싶은 거 없냐고? 신경 써 주는 이 느낌, 나쁘지 않은걸. …커피로 할게. 너무 쓰지 않은 걸로.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/main3.ogg"},"전투개시":{"voiceline":"용기, 그것은 너희의 시작점이자 종착지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/battle.ogg"},"상세확인":{"voiceline":"날개? 꼬리? 그게 그렇게나 신경쓰여? 계약자, 가끔 당신 속은 도무지 알다가도 모르겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 - 힌덴부르크","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 물자가 도착했다고? 다른 사람에게 맡겨. 직접 나서서 모든 걸 다 해내는 건 한정된 시간 속에서는 불가능해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/expedition.ogg"},"실망":{"voiceline":"좋아, 계약 같은 건 없었던 걸로 할게. 당신이 지금 하고 있는 거, 언젠가 그대로 다시 돌려주겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/feeling1.ogg"},"낯섦":{"voiceline":"무슨 일이야? 겁을 먹고 날 피하는 줄 알았는데. ……뭐, 됐어. 이참에 당신에 대해 좀 더 알아야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/feeling2.ogg"},"호감":{"voiceline":"공무 때문에 부른 게 아니라고… 그럼, 이건 당신이라는 개체의 욕구에 따른 행위라고 봐도 되려나? …그래, 인정하면 됐어. 나도 '지휘관의 함선'이 아니라, 힌덴부르크라는 개체의 본성을 당신에게 보여줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/feeling3.ogg"},"기쁨":{"voiceline":"악마를 조종하려고 하지만, 오히려 조종당하고 있을 가능성도 부정할 순 없지. 답이 궁금하면 스스로 탐구해 봐. 난 당신이 도달할 그곳에서 기다리고 있을 테니. …당신을 현혹한 적은 물론 없어. 이건 어디까지 계약자 당신이 스스로 고른 길이라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/feeling4.ogg"},"사랑":{"voiceline":"여기까지 오다니 기쁘네, 계약자. 과정이나 방법이야 어떠했든 상관없어. 중요한 건 이 결과… 당신이라는 개체가 내 수중에 있다는 결과뿐이지. 분해? 무릎을 땅에 꿇는 게 그리 고통스러운 건 아닐 텐데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/feeling5.ogg"},"터치3":{"voiceline":"뿔? 보는 건 맘대로 해. 그렇지만 만지면 어떤 사태가 초래될지, 당신이라면 이미 알고 있겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/headtouch.ogg"},"모항귀환":{"voiceline":"계약자, 방금 전투에 아직도 정신이 팔려있는 거야? 신경 쓰이는 적이라도 있었나? 아니면 내 전투 방식에 불만이라도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/home.ogg"},"hp 경고":{"voiceline":"조금은 할 마음이 생기네…… 꽤 하는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/hp_warning.ogg"},"로그인":{"voiceline":"일상을 위한 고군분투… 계약자, 이게 당신이 선택한 운명이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/login.ogg"},"실패":{"voiceline":"음, 싸울만한 보람이 있는 상대네. 다음에 상대할 때도 실망시키지 않았으면 좋겠는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/lose.ogg"},"우편":{"voiceline":"계약자, 우편 확인은 늦어지기 전에 해. 한 소리 듣고 난 다음에 하지 말고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/mail.ogg"},"임무":{"voiceline":"어서 해야 할 일을 해, 계약자. …당신에게 맡겨진 임무 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/mission.ogg"},"임무완료":{"voiceline":"임무 완료야. 작은 성과로 큰 대가를 바라는, 그런 자와 계약을 맺은 기억은 없는 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/mission_complete.ogg"},"서약":{"voiceline":"지금 계약에 만족하기는커녕, 여기서 더 나아가겠다고? 계약자, 이거 점점 더 오만방자해지는걸? ……당신의 소원대로 당신이 바라는 걸 줄게. 언젠가 그 몸도 영혼도 내게 바칠 각오가 되어있다면 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/propose.ogg"},"스킬":{"voiceline":"머리를 조아려라, 버러지들아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/skill.ogg"},"터치1":{"voiceline":"어서 말해봐. 당신에 대한 흥미가 사라져 버리기 전에.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/touch.ogg"},"터치2":{"voiceline":"슬슬 교훈을 몸으로 주입해 줄 때가 왔네, 계약자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/touch2.ogg"},"입수시":{"voiceline":"나를 부른 건 당신? 인간인 당신이 내 '지휘관'? ……뭐, 됐어. '함선과 지휘관'의 계약, 일단은 인정할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/unlock.ogg"},"강화성공":{"voiceline":"스스로 정진하는 것도 잊지 마, 계약자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"괘씸한 자들에게는 아픔이야말로 최고의 레슨이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"그렇게 자꾸 꼬리만 쳐다볼 거면 이걸로 묶어 버리겠어. 그래봤자 당신은 싫어하지 않겠지만…… 설마 내 생각이 틀렸다고는 하지 않겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"왜 그래? 이미 내린 결정을 이제 와서 뒤집으려고? 날 어떻게 기쁘게 할지나 생각해 봐. 일단 주도권을 넘기면 그걸로 끝, 당신이라는 개체의 의견은 의미가 없어지지. 이 말이 어떤 의미인지 알겠지? 계약자?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"어쩔 수 없네. ……딱 한 번뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"방금 전투가 어떤 것이었든 모두 일단락됐네. 그러니 눈앞에 있는 일에 집중하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"이렇게나 오랫동안 기다리게 할 줄이야. 이거 설마 날 격앙시켜서 징벌을 받으려는 속셈인 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/login_ex.ogg"},"실패_ex":{"voiceline":"철수 시간이야, 계약자. 도주의 굴욕쯤은 아끼는 개체의 안전 보장을 위해서라면 사소한 것에 불과해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/lose_ex.ogg"},"우편_ex":{"voiceline":"당신 앞으로 온 우편이야. 어서 가지고 가. ……손이 아니라 꼬리로 건네준 거에 뭐 문제라도 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/mail_ex.ogg"},"임무_ex":{"voiceline":"해야 할 일을 해, 계약자. …당신과 보낼 시간을 이런 사소한 일에 뺏기고 싶진 않으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 완료. 계약자에게 보상을 내려줘야 할 것 같은데…… 원해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"하고 싶은 말이 있으면 어서 해. ……날 초조하게 만들면 벌어지는 사태를 당신이 모를 리는 없을 텐데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/touch_ex.ogg"},"터치2_ex":{"voiceline":"용서를 구하는 법을 잊었다면 지금 바로 일깨워 주는 수밖에 없겠네, 계약자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"내가 당신이 바라던 걸 이뤄줬다면, 이제는 당신이 무언가 해줄 차례겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['론'] :  위험한 냄새가 나는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"시간을 좀 써서라도 다른 함선에게 누가 계약자로서 올바른 위치에 있는지 알려줘야겠어……. 사이좋게 지내라고? 그래, 계약자의 체면을 위해서라도 참을게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/main5_ex.ogg"},"메인6_ex":{"voiceline":"흙탕물처럼 씁쓸한…… 이 커피는 대체 뭐지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"당신이라는 개체와 함께 있으면 일찍이 맛보지 못한 즐거움을 느껴. ……나보다 당신에게 더 인간을 홀리는 마성이 있는 건 아닐까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499090/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"UR","ex_chat_status":1},{"클뜯 id":499091,"클뜯 함순이 id":49909,"함순이 이름":"힌덴부르크","한글 함순이 + 스킨 이름":"패럴리틱 버서스","영문 함순이 + 스킨 이름":"Delirious Duel","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499091/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499091/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499091/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499091/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499091/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane