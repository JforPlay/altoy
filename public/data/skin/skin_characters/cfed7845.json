g.ogg"},"로그인":{"voiceline":"늦게 왔네, 계약자. 자리를 비운 사이에 술을 좀 마셨는데… 후후후, 내가 이 정도로 취할 거 같아? 못 믿겠으면 걷는 거라도 보여줄…… 후… 아무래도 계약자 몸으로 쓰러진 모양이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/login.ogg"},"실패":{"voiceline":"이대로 물러날 거라고 생각하면 큰 착각이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/lose.ogg"},"우편":null,"임무":{"voiceline":"임무… 이런 건 당장이라도 처리할 수 있겠지, 계약자?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/mission.ogg"},"임무완료":{"voiceline":"와인, 카드, 칩… 모두 갖춰졌어. '승부'를 계속하자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/mission_complete.ogg"},"서약":null,"스킬":{"voiceline":"로열 플러시야. 시시하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/skill.ogg"},"터치1":{"voiceline":"후후후, 왜 그렇게 성급해? 승부는 아직 끝나지 않았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/touch.ogg"},"터치2":{"voiceline":"겨우 이 정도로 만족해? 읏♡ …우쭐해할 거 없어. 당신이 주도권을 쥘 수 있는 건 지금뿐… 후후후. 이 '승부'… 질리기 전까지는 끝낼 생각이 없거든♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/touch2.ogg"},"입수시":{"voiceline":"단둘이네, 계약자. 이 자리의 흥겨운 '승부'가 주는 쾌락에 흠뻑 빠져들도록 해…… 물론 패배자에게는 오늘 밤 '징벌'이 기다리고 있을 거야♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"지금부터는 당신과의 '승부'에 흠뻑 빠질 시간이야, 계약자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499091/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인