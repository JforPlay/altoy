[{"클뜯 id":402060,"클뜯 함순이 id":40206,"함순이 이름":"마그데부르크","한글 함순이 + 스킨 이름":"마그데부르크","영문 함순이 + 스킨 이름":"Magdeburg","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402060/shipyard.png","설명":"M급 경순양함—마그데부르크","자기소개":{"voiceline":"메탈 블러드의 경순양함인 마그데부르크다. 내세울 만한 경력은 별로 없지만…… 지금 나는 여기 이렇게 있으니까, 적이든 어려운 일이든, 뭐든 내게 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/profile.ogg"},"메인1":{"voiceline":"합! 야압! ……느닷없기는 하지만 ……흡! 이렇게 백덤블링을 하고 싶어져서 말이지. 아, 놀랐어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/main1.ogg"},"메인2":{"voiceline":"업무 중에 멍 때리면 내가 꿀밤을……. 걱정 마, 힘 조절 정도는 할 테니까…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/main2.ogg"},"메인3":{"voiceline":"얼마 전에 읽은 만화책, 뒷이야기가 궁금해……. 주간 만화라는 거, 진짜 감질나네…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/main3.ogg"},"전투개시":{"voiceline":"덤벼라! 앞장은 내가 설게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/battle.ogg"},"상세확인":{"voiceline":"달리는 방법? 아, 이거 말이지, 만화에서 본 건데…… 꽤 멋지지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/detail.ogg"},"드랍 설명":{"voiceline":"M급 경순양함—마그데부르크","voicelink":null},"의뢰 완료":{"voiceline":"자, 지휘관! 돌아온 의뢰조 동료들을 맞이하러 가자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/expedition.ogg"},"실망":{"voiceline":"진짜 열받게 하네……. 너, 그 행동거지 안 고치면 가만 안 둔다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/feeling1.ogg"},"낯섦":{"voiceline":"응, 지휘관. 바쁜 것 같네? 혹시 도움 필요해? 꼭 전투가 아니더라도 간단한 서류 정도는 나도 도와줄 수 있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/feeling2.ogg"},"호감":{"voiceline":"이 커피는? ……얼마 전에 서류 정리 도와준 보답이라고? 아하하, 고마워! 잘 마실게! 그럼 우유를 조금 넣어서…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/feeling3.ogg"},"기쁨":{"voiceline":"누가 누구한테 빚을 졌네, 우리 사이에는 그런 거 없기다! 고민할 시간에 그냥 도와주고, 도움 받는 게 좋잖아! 그게 더 편하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/feeling4.ogg"},"사랑":{"voiceline":"너 정도로 마음이 맞는 사람은 없었어. 그러니까 너랑 나, 둘은 베스트 콤비네이션……. 아, 그 말은 즉, 우리가 이 모항의 최강 커플이라는 거네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/feeling5.ogg"},"터치3":{"voiceline":"응? 뭐하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/headtouch.ogg"},"모항귀환":{"voiceline":"출격 수고했다. 성가신 적은 없었고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/home.ogg"},"hp 경고":{"voiceline":"이 정돈 식전 운동이나 다름 없지! 두려워 할 거 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/hp_warning.ogg"},"로그인":{"voiceline":"응, 컨디션 좋고! 오늘 목표는 서류 안건을 정리하는 걸로 잡자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/login.ogg"},"실패":{"voiceline":"이런, 저질러 버렸군…… 미안…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/lose.ogg"},"우편":{"voiceline":"우편이다! 항상 확인하는 습관을 들이라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/mail.ogg"},"임무":{"voiceline":"봐, 새로운 임무가 왔다고. 어떻게 할 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 다음은 내 몫을 나눌 차례인가? 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/mission_complete.ogg"},"서약":{"voiceline":"솔직히 내게 이런 순간이 올 줄은 몰랐어……. 내게 그런 매력이 있는지도 좀 의심스럽고. 아! 싫다는게 아니야! 널 엄청 좋아하는 건 사실인데, 그게…… 으…… 아아아, 정말! 말이 왜 이렇게 안 나와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/propose.ogg"},"스킬":{"voiceline":"내 주먹을 받아라! ……아니지, 내 포탄 받아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/skill.ogg"},"터치1":{"voiceline":"주먹질이라도 하고 싶어진 거야? 좋아, 덤벼라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/touch.ogg"},"터치2":{"voiceline":"일부러 그런건 아닐 거라고 일단은 믿지만…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드 경순양함, 마그데부르크 착임! 앞으로 우리의 팀워크를 위해 주먹 인사하자! … 아 참, 내 장갑은 좀 단단하니까, 너무 힘 주지 말고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/unlock.ogg"},"강화성공":{"voiceline":"진짜 강해진 건지 어떤 건지는 싸워보면 알겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋았어! 승리를 축하하는 의미에서 공중제비라도 돌아야겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관, 늦다고. 하하하, 내 페이스를 따라 오는게 쉽지 않다는 건 잘 알아. 그럼 내가 괜찮은 달리기 방법이라도 알려줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"이런 관계가 되긴 했는데, 뭘 어떻게 해야 할 지 전혀 모르겠네……. \"괜히 너무 신경쓸 거 없다\"고……? 하긴, 그렇지? 지금까지 그래왔던 것처럼, 자연스럽게 하면 되는 거지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"으, 응? 으음…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어서 와! 상태를 보니, 내가 나설 차례는 없을 것 같네! 아하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"응, 컨디션 최고야! 오늘은 뭐부터 할래, 파트너?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"새로운 임무는 곧 새로운 도전이지! 이번에도 확실하게 처리하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"우정의 피스트 범프다! 받아랏!! ……하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/touch_ex.ogg"},"터치2_ex":{"voiceline":"응? 응? 이 이상한 느낌은 대체……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['Z24', 'Z25', '아드미랄 그라프 슈피'] : 역시 건틀렛이 최고지! 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/couple_encourage1.ogg"},{"voiceline":"['아카츠키', '쿠로시오'] : 그 \"진술\"이라는 건…… 진짠가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관, 멍 때리는 거야? ……히힛, 그러면 약속대로 가볍~게 꿀밤을……. 으아아, 너무 셌나? 미안, 다음에는 힘 조절 할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관, 공중제비 한 번 해볼래? 에이, 괜찮아 괜찮아~ 지휘관이 다치지 않도록 내가 밑에서 받아줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402060/main4_ex.ogg