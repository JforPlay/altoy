[{"클뜯 id":107270,"클뜯 함순이 id":10727,"함순이 이름":"랭글리Ⅱ","한글 함순이 + 스킨 이름":"랭글리Ⅱ","영문 함순이 + 스킨 이름":"Langley II","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107270/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107270/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107270/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107270/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107270/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107270/shipyard.png","설명":"인디펜던스급 경항공모함—랭글리II, 현호 CVL-27","자기소개":{"voiceline":"새로워진 이글 유니온 항공모함, 랭글리의 등장입니다! 지금의 저에겐 전투는 물론, 지도에도 빈틈이 없답니다. 기대하시길 바라요, 지휘관. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/profile.ogg"},"메인1":{"voiceline":"지휘관, 성실하게 임하세요! 규칙을 기억하는 건 중요해요. 이건 모두 과거의 교훈을 통해 얻어진 것이라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/main1.ogg"},"메인2":{"voiceline":"힘들 때 무작정 신께 비는 것 보단, 평소에 철저히 준비를 해두는 게 중요하죠, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/main2.ogg"},"메인3":{"voiceline":"함대가 나날이 정진할 수 있도록, 지휘관이 솔선수범해서—— 아니, 또 딴 생각 하고 계신 건가요? 정말…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/main3.ogg"},"전투개시":{"voiceline":"말을 안 듣는 아이들에게는… 교육이 필요하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/battle.ogg"},"상세확인":{"voiceline":"왜 계속 그런 눈으로 저를…… 아무래도 랭글리 선생님에게 물어보고 싶은 게 있는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/detail.ogg"},"드랍 설명":{"voiceline":"인디펜던스급 경항공모함—랭글리II, 현호 CVL-27","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 아이들이 돌아왔어요. ……저번에 당부드렸던 거, 기억하고 계시려나요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/expedition.ogg"},"실망":{"voiceline":"……설마 일부러 랭글리 선생님을 화나게 하려는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/feeling1.ogg"},"낯섦":{"voiceline":"업무 상황은 어떻죠? 서류 작업만 하지 말고, 다른 아이들과 소통하는 것도…… 정말, 알려줘야 할 게 아직 많은 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/feeling2.ogg"},"호감":{"voiceline":"좋아요, 오늘은 마무리가 잘 되고 있네요. 어때요? 랭글리의 지도 덕분에 능력이 향상된 거, 확실히 체감하고 계신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/feeling3.ogg"},"기쁨":{"voiceline":"저랑… 데이트…? …아니, 무슨 말씀이시죠?! 안 돼요. 학생은 학생답게! ……따, 딱히 싫다는 건 아니지만요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/feeling4.ogg"},"사랑":{"voiceline":"랭글리 선생님의 환심을 샀다고 해서, 앞으로 맘대로 행동할 수 있으리라곤 생각 마세요. ……뭐, 둘만 있을 때는 조금은 긴장을 푸셔도 되지만요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격하느라 고생하셨어요. 잠깐, 어디가시려구요?! 이제 막 강의를 시작한 참이라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/home.ogg"},"hp 경고":{"voiceline":"장난기가 많은 아이네…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/hp_warning.ogg"},"로그인":{"voiceline":"어서 오세요. 열심이시네요. 오늘도 저 랭글리가 온 힘을 다해 당신을 보좌해드리죠. 그럼, 준비 부탁드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/login.ogg"},"실패":{"voiceline":"으으…… 지도 방침이 잘못됐다는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/lose.ogg"},"우편":{"voiceline":"우편을 우편함에 그대로 두면 문제는 영원히 해결되지 않는다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/mail.ogg"},"임무":{"voiceline":"새로운 숙제는 이미 지휘관에게 보냈어요. 날짜에 맞춰서 잘 해주셔야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/mission.ogg"},"임무완료":{"voiceline":"네, 괜찮은 느낌이네요. ——지휘관, 다음에도 열심히 하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/mission_complete.ogg"},"서약":{"voiceline":"여러가지를 알려드렸지만, 지휘관은 아직 정진해야 할 부분이 많아요. 그러니 앞으로도 이 랭글리 선생님이 지도해드리죠! 기한은…… 아, 앞으로 계속!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/propose.ogg"},"스킬":{"voiceline":"다들, 잘 지켜보세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/skill.ogg"},"터치1":{"voiceline":"……설마 지휘관, 개인 지도를 원하는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/touch.ogg"},"터치2":{"voiceline":"여보세요, 해군부… 맞아요, 늘 전화 드리는―― 누군지 아시겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/touch2.ogg"},"입수시":{"voiceline":"흠흠, 저는 새로워진 랭글리랍니다. 어떠세요? 예전보다 세련된 느낌이 나죠? 더 엄격한 지도를 받을 준비는 되셨나요? 후훗, 지휘관. 기대해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/unlock.ogg"},"강화성공":{"voiceline":"흐음~ 그럭저럭이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아, 이 승리를 다음 버전 교과서에 추가해서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"어서 오세요……가 아니라, 잠깐! 응, 다친 곳은 없는 것 같네요……. 네, 이젠 괜찮아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 오세요. 랭글리 선생님이랑 외출을……? 그런 건 일단 오늘 업무를 마친 후에 하자구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107270/login_ex.ogg"},"실패_ex":n