ontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"주방이 없는 게 조금 아쉽네. 지휘관이 먹여주려는 걸까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"하아… 하아… 지휘관, 오늘은 무엇부터 할 생각이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/login.ogg"},"실패":{"voiceline":"지휘관, 미안해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/lose.ogg"},"우편":{"voiceline":"편지… 지휘관이 빨리 봐줬으면 좋겠는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/mail.ogg"},"임무":{"voiceline":"끝내지 못한 임무가 있어. 자료는 내가 이미 가져 왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/mission.ogg"},"임무완료":{"voiceline":"임무 완료야. 이제 뭘 해야 할까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"이, 이걸 내 목에 걸겠다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/touch.ogg"},"터치2":{"voiceline":"아?! 지휘관, 이런 뜻은 아니였어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/touch2.ogg"},"입수시":{"voiceline":"지휘관, 이건 뭘 하는 걸까? 설마… 내가 뭔가 잘못 한 걸까…? 분명… 평범한 연습이겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/unlock.ogg"},"강화성공":{"voiceline":"조금 더 노력해야겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이걸로 조금은 해방되겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702031/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":nul