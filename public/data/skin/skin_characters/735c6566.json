, 임무도 완수하고 착하네. 후훗, 포상은… 글쎄. 탕에 한 번 더 들어가 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702033/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"놓칠까봐 두려우면, 손이라도 잡아줄까? 아니면… 고삐를 채워주는 게 더 나으려나? 우후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702033/touch.ogg"},"터치2":{"voiceline":"후훗, 촉감 좋지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702033/touch2.ogg"},"입수시":{"voiceline":"날 찾고 있었다고…? 우후훗, 걱정시켜서 미안해. 잠깐 선선한 밤바람 좀 쐬고 싶어서…. 괜찮으면 같이 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702033/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"이것도 일종의 기분 전환…이랄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702033/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"여름 축제","상점 id":70692,"상점 카테고리 id":10,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":702034,"클뜯 함순이 id":70203,"함순이 이름":"차파예프","한글 함순이 + 스킨 이름":"백기사의 멜로디아","영문 함순이 + 스킨 이름":"Melody of the White Cavalier","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702034/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702034/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702034/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/ima