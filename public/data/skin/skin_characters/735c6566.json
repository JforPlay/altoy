[{"클뜯 id":702030,"클뜯 함순이 id":70203,"함순이 이름":"차파예프","한글 함순이 + 스킨 이름":"차파예프","영문 함순이 + 스킨 이름":"Chapayev","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702030/shipyard.png","설명":"차파예프급 경순양함—차파예프 ","자기소개":{"voiceline":"나는 68-K형, 차파예프급의 네임쉽 차파예프. 세계 대전에서 활약해야 했지만 여러가지 이유로 건조가 끝나지 않았기에 활약하지 못했어… 조금 유감이네. 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/profile.ogg"},"메인1":{"voiceline":"지휘관도 이 아이 같이 되고 싶은 걸까? … 어머? 아니야~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/main1.ogg"},"메인2":{"voiceline":"나는 사실 강하다구… 적어도 설계 초기에는 그랬어. 지금은 지휘관이 직·접 확인해 줬으면 좋겠네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/main2.ogg"},"메인3":{"voiceline":"신뢰가 깨질까봐 두려운 거라면 상대를 꽁꽁 묶어두면 되는 것 아닐까? 예를 들면 밧줄이라던가, 쇠사슬이라던가… 그렇지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/main3.ogg"},"전투개시":{"voiceline":"이 아이도 능숙하게 다뤄보이겠어. 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/battle.ogg"},"상세확인":{"voiceline":"지휘관, 대화라도 나눌까? 서로를 이해하는 것이 가장 중요하지. 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/detail.ogg"},"드랍 설명":{"voiceline":"차파예프급 경순양함—차파예프","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰를 나간 아이들이 돌아온 것 같네. 맞이할 준비를 하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/expedition.ogg"},"실망":{"voiceline":"지휘관에게 조금 더 엄격한 ‘교육'을 해야 하지 않을까… 음 … 어렵네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 무슨 할 말이라도 있어? 가벼운 대화를 나누는 것도 좋다구? 이 함대, 아무래도 오래 머무를 수 있을 것 같네. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/feeling2.ogg"},"호감":{"voiceline":"부하와의 교류인가… 좋아. 목숨을 맡기는 동료에게 있어서 신뢰는 가장 중요한 것이지. 지휘관도 내가 믿는 것처럼 나를 믿어줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/feeling3.ogg"},"기쁨":{"voiceline":"펫? 키워본 적은 없는걸. 그것보다 훨씬 더 좋은 사람이 곁에 있으니까. 혹시 지휘관도… 그런 사람이 필요한 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/feeling4.ogg"},"사랑":{"voiceline":"그렇구나… 중증인 것 같네. 완전히 믿을 수 있는 사람 곁에 있어야 겠어… 지휘관, 나에게 전부 맡겨줘. 지휘관의 고민을 전부 해결해 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"내 요리 맛이 어떤지 모르겠네. 지휘관의 입맛에 맞으면 좋을텐데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/home.ogg"},"hp 경고":{"voiceline":"윽… 조금 부주의 했나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/hp_warning.ogg"},"로그인":{"voiceline":"어서와 지휘관, 여기는 지휘실이라고? 물론 알고있어, '우리 둘만의 지휘실', 그렇지? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/login.ogg"},"실패":{"voiceline":"후… 아무래도 더 노력해야 겠는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/lose.ogg"},"우편":{"voiceline":"새로 온 우편 정리가 끝났어. 확인하는 것을 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/mail.ogg"},"임무":{"voiceline":"끝내지 못한 임무… 내가 도와주는 게 좋지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/mission.ogg"},"임무완료":{"voiceline":"어머, 임무를 끝냈네. 착해라. 후후, 나에게는 어떤 상을 줄 생각이야? 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/mission_complete.ogg"},"서약":{"voiceline":"지휘관에게서 중요한 반지를 받을 수 있어서 정말 기뻐. 답례로… 이 목걸이를 지휘관에게 줄게. 후후, 잘 어울리네. 서로 연결된 이 느낌… 지휘관도 마음에 들지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/propose.ogg"},"스킬":{"voiceline":"전부 쓸어버리자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/skill.ogg"},"터치1":{"voiceline":"만져보고 싶어? 어머? 이 아이를 말하는 게 아니라, 나라고? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/touch.ogg"},"터치2":{"voiceline":"후후후… 지휘관은 정말 나쁜 아이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관이구나. 후후… 최고야…… 아, 실례. 나는 노스 유니온의 경순양함, 차파예프. 앞으로 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/unlock.ogg"},"강화성공":{"voiceline":"계속 강화해볼까? 지휘관을 믿고 있으니 분명 가능할 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후… 이걸로 됐겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/win_mvp.ogg"},"전투개시_ex":{"voiceline":"Полный ход(전속 전진)!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관, 배 고파? 조금만 참아. 내가 ‘됐어’라고 말할 때까지… 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"아직도 불안해? 조금만 더 참아볼까? 지금의 지휘관은 나와 이렇게 연결되어야 하지만 분명… 언젠가는 아무 것도 생각할 필요가 없을 거야. 고통도, 고민도 없이—— ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702030/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"출격할 때 잘 버텼구나… 착하다, 착해. 나머지는 