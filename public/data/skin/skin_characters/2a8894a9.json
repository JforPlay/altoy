[{"클뜯 id":305030,"클뜯 함순이 id":30503,"함순이 이름":"이세","한글 함순이 + 스킨 이름":"이세","영문 함순이 + 스킨 이름":"Ise","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305030/shipyard.png","설명":"이세형 전함 1번함·이세","자기소개":{"voiceline":"이세형 전함 1번함 이세다. 진주만 때는 경비 임무를 했고, 그 후 항공전함으로 개장되었어… 뭐, 우리 초노급 전함 자매는 시대를 잘못 타고나는 바람에, 전쟁에선 너무 늦어버리고 말았지. 어쨌든, 이번엔 괜찮을 거다! 아마도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/profile.ogg"},"메인1":{"voiceline":"연료가 없어도, 출격할 때 풀 코스만 갖고 있으면 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/main1.ogg"},"메인2":{"voiceline":"하아, 후소 씨는 뭐라 부르면 좋지…… 언니? 선배?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/main2.ogg"},"메인3":{"voiceline":"이세 신궁? 멀리서 본 적은 있지만, 들어갈 순 없었지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/main3.ogg"},"전투개시":{"voiceline":"이제야 내가 날뛸 차례구만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/battle.ogg"},"상세확인":{"voiceline":"지휘관, 탄막을 뿌리는 법을 알려줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/detail.ogg"},"드랍 설명":{"voiceline":"이세형 전함 1번함·이세","voicelink":null},"의뢰 완료":{"voiceline":"북호작전은 이 정도가 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/expedition.ogg"},"실망":{"voiceline":"너 육군이였냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/feeling1.ogg"},"낯섦":{"voiceline":"또 함께 휴가와 함께 밤하늘을 볼 수 있어서, 정말 다행이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/feeling2.ogg"},"호감":{"voiceline":"그때에 비하면 지금은 즐길만한 게 정말 많구만~ 지휘관, 건배!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 안주를 가져올 테니까, 오늘도 술 상대 좀 해달라고~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/feeling4.ogg"},"사랑":{"voiceline":"나보다 강한 배는 얼마든지 있는데, 지휘관 너~ 역시 바보구만! 하하하! 나도 바보니까, 건배하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"칫……아직 땡땡이를 덜 쳤… 크흠, 지휘관, 모항 경비는 제대로 하고 있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 바다로 나가 펑펑 터뜨려보자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/login.ogg"},"실패":{"voiceline":"마지막… 주포… 일제 발사──","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/lose.ogg"},"우편":{"voiceline":"오오! 마침 책상다리에 꽃을 게 필요했는데!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/mail.ogg"},"임무":{"voiceline":"아! 나도 갈래! 잠깐 기다려줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/mission.ogg"},"임무완료":{"voiceline":"푸하─! 역시 쇼츄는 온더락이지! 지휘관도 한잔, 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/mission_complete.ogg"},"서약":{"voiceline":"고맙구만! 그럼 쭉 너랑 같이 있어도 되는 거지! 하하하! 뭐, 술은 역시…… 둘이서 마시는 게 맛있으니까 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305030/propose.ogg"},"스킬":{"voiceline":"초노급 전함── 주포, 발사─!","voicelink":"https://raw.githubusercontent.co