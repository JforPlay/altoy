[{"클뜯 id":9600160,"클뜯 함순이 id":960016,"함순이 이름":"어드벤처","한글 함순이 + 스킨 이름":"어드벤처","영문 함순이 + 스킨 이름":"Adventure","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600160/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600160/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600160/shipyard.png","설명":"범선 - 어드벤처","자기소개":{"voiceline":"만나서 반가워, 지휘관. 나는 어드벤처… 여기서 살게 됐어! 우리 집에 올 때는 미리 말해줘야 해! 안 그러면 실수로 함정 같은 걸 밟아서 큰일이 날 수도 있거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/profile.ogg"},"메인1":{"voiceline":"「떠나자~ 나는 어드벤처~♪ 임무도 겸한 대모험~♪ 집을 찾아 떠돌다 겨우 찾아낸 내 은신처♪」","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/main1.ogg"},"메인2":{"voiceline":"지휘관, 완벽하게 안전한 벙커 만들 수 있어? 거기 살게 해 줘! 제발!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/main2.ogg"},"메인3":{"voiceline":"지휘관, 여기에 끈으로 발동되는 경보 장치를 설치했어. 이러면 위험이 닥쳐도 가장 먼저 알아챌 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/main3.ogg"},"전투개시":{"voiceline":"모험… 브랜뉴 어드벤처!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/battle.ogg"},"상세확인":{"voiceline":"이, 이건 의심증 같은 게 아니라, 잠재적인 위험에 가장 효과적으로 대처하는 방법이야! 여기 기록을 봐! 그 덕분에 아직 한 번도 습격당한 적이 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 어드벤처","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 함대가 돌아온 모양이야! 보상을 지킬 사람을 보내는 편이 좋지 않을까……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/expedition.ogg"},"실망":{"voiceline":"여긴 안전하지 않아… 슬슬 이사해야겠어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/feeling1.ogg"},"낯섦":{"voiceline":"응? 사는 곳을 마음대로 바꾸면 안 된다고?! 안심하고 살 수 있는 환경을 만들겠다는 아주 합리적인 이유인데도? 으아, 지휘관~ 이렇게 부탁할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/feeling2.ogg"},"호감":{"voiceline":"지휘관, 아기 돼지 삼형제 이야기 알아? 위험을 빨리 알아채지 못해서 그런 꼴을 당한 거라구…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/feeling3.ogg"},"기쁨":{"voiceline":"지휘관! 봐봐, 숨기 딱 좋은 곳을 찾아서, 거기에 새로운 집을 지으려고 해! 이건 지휘관한테만 알려주는 거야…! 응? 지금 사는 곳은 안 되냐고? 같은 곳에 계속 살면 안전성이 떨어지잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/feeling4.ogg"},"사랑":{"voiceline":"음…… 역시 지휘관 옆이 제일 마음이 놓여! 여기 방비가 튼튼해서 그런 걸까? 아니면 지휘관이 모두에게 안정감을 줘서 그런 걸까……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/feeling5.ogg"},"터치3":{"voiceline":"에헤헤헤… 의외로 안심이 되네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/headtouch.ogg"},"모항귀환":{"voiceline":"꺅?! 지, 지휘관이구나…… 깜짝 놀랐잖아… 난 또 누가 목숨이라도 빼앗으러 온 줄 알았어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/home.ogg"},"hp 경고":{"voiceline":"으아아아! 너, 너, 너무 위험해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/hp_warning.ogg"},"로그인":{"voiceline":"(덜덜 떨며) 이, 이 근처… 뭔가 엄청 으스스한데… 설마 누가 날 노리고 있는 건 아니겠지……? 지휘관! 위험해지기 전에 어서 도망치자…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/login.ogg"},"실패":{"voiceline":"으아아아… 여, 여기… 너무 위험하잖아! 어서 도망치자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/lose.ogg"},"우편":{"voiceline":"지휘관, 우편은 무사하니까 안심하고 확인해 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/mail.ogg"},"임무":{"voiceline":"음…… 모험이나 탐사 임무는 없으려나? 해보고 싶어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/mission.ogg"},"임무완료":{"voiceline":"지휘관! 어서 임무 보상을 받으러 가야지! 늦으면 누가 훔쳐갈지도 몰라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 계속 내 곁에 있어줄 거야? 어떤 때라도? 영원히 후회하지 않을 자신 있어? 후…… 좋아. 내가 꿈꾸던 안심하고 돌아올 수 있는 곳을 찾은 기념으로… 지휘관, 내 손에 반지를 끼워줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/propose.ogg"},"스킬":{"voiceline":"위험 요소는 모두 제거해야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/skill.ogg"},"터치1":{"voiceline":"이건 모험에 쓸 중요한 도구야! 지금 지휘관한테 보여줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/touch.ogg"},"터치2":{"voiceline":"꺅! 마…… 만져지고 말았어! 역시 이 옷은 전혀 안전하지 않아!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/touch2.ogg"},"입수시":{"voiceline":"지휘관, 여기가 날 위해 마련한 새로운 집이야? 생각보다 넓은데…… 만약의 사태에 대비한 준비가 전혀 안 되어 있잖아! 경보 장치 좀 설치해도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/unlock.ogg"},"강화성공":{"voiceline":"더 강해지면 우리 집도 더 안전해질까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후…… 겨우 이겼네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관이 곁에 있으면 마음이 놓여. 응… 그래도 방심하면 안 돼. 지휘관의 안전은 내가 지킬게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관과 함께하는 매일이야말로, 내가 꿈꿔온 평온이야! 지휘관만 곁에 있어준다면, 아무리 위험한 무인도라도, 깊~은 바닷속이라도, 어디든 갈 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"잠깐! 지휘관, 우선 팔을 벌리고… 영차… 후… 있지… 꼭 안아 줄래? 더 세게… 그대로 계속해 줘～","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관, 어서 와♪ 탐험할 만한 괜찮은 곳은 있었어?! 너무 가고 싶어서 더는 못 참겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 오늘은 어디 묵을래? 산 중턱의 오두막…? 바다가 내려다 보이는 빌라…? 집무실…? 아무리 그래도… 내가 준비한 지휘관 전용 은신처가 최고겠지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관～ 소매 안에 뭐가 있는지 궁금해? 그럼 좀 더 가까이…… 와앗! 후후, 지휘관을 놀래켜보고 싶어서 그랬어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/touch_ex.ogg"},"터치2_ex":{"voiceline":"이, 이상하네…… 이미 여러 번 했는데, 이 마음이 놓이는 느낌은…… 전혀 변하지 않아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관, 더 가까이… 꼭 안아줘～ 그래, 그대로 움직이지 말고～ 후~ 정말 마음이 놓여～","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관, 여긴 이미 대대적으로 개조를 끝냈어. 반응형 함정에 사각 없는 감시 카메라도 있으니까, 나쁜 녀석들은 절대 못 들어와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"짜잔~ 지휘관만을 위한 은신처가 완성됐어! 궁금하지? 후후, 지금부터 안내해줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600160/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"MOT","레어도":"SR","ex_chat_status":1},{"클뜯 id":9600161,"클뜯 함순이 id":960016,"함순이 이름":"어드벤처","한글 함순이 + 스킨 이름":"세이프 하우스 마스터","영문 함순이 + 스킨 이름":"Master of the Safe House","스킨 타입":"Rpg Adventure","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600161/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600161/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600161/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600161/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600161/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600161/shipyard.png","설명":"드디어 찾았어…… 몰래 어슬렁거리는 수상한 녀석! 성 안의 함정들을 건드리지 않고 여기까지 오다니…… 이 은신처도 이제 안전하지 않은 건가…?!","자기소개":null,"메인1":{"voiceline":"오오~! 멋들어진 모험담 같은 변명이네! 하지만 그렇게 대단한 「주인공」이 나한테 이렇게 쉽게 잡히다니… 그건 무슨 의미려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/main1.ogg"},"메인2":{"voiceline":"이런 위기 속에서도 침착한 판단을 내리면서 치밀한 추리를 하다니… 후후, 완전히 내 흥미를 끌었어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/main2.ogg"},"메인3":{"voiceline":"이야기꾼…… 후훗, 이렇게 불러도 될까? 목이 마르면 내 와인의 샘에서 마음껏 목을 적시도록 해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"봐달라고? 좋아. 그러려면 우선 어쩌다 우연히 여기로 들어온 거고, 결코 해를 끼치지 않을 거란 걸 증명해야 해. 간단하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/detail.ogg"},"드랍 설명":{"voiceline":"드디어 찾았어…… 몰래 어슬렁거리는 수상한 녀석! 성 안의 함정들을 건드리지 않고 여기까지 오다니…… 이 은신처도 이제 안전하지 않은 건가…?!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이거 난감한걸. 나는 고작 말 몇 마디에 속는 그런 애가 아니거든~ 하지만… 생각이 바뀌었어♪ 네 모험담이 너무 흥미진진해서 말이지. 여기 남아서 그 이야기로 날 영원히 즐겁게 해주도록 해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"음…… 남의 집에 신발도 벗지 않은 채로 들어와서 주인까지 마주치다니, 이건 그냥 우연……이라고 할 줄 알았어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"무능한 침입자 녀석, 어서 목적이 뭔지 말해! 보물이야? 아니면 이 성의 주인인 가련한 내 목숨…!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"흠~ 물러서지 않고 오히려 다가오네. 아무것도 모르는 자라 두려움도 모르는 건가…? 재밌는걸♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/touch.ogg"},"터치2":{"voiceline":"여기 남아. 이건 성의 주인으로서의 명령이야……♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/touch2.ogg"},"입수시":{"voiceline":"드디어 찾았어…… 몰래 어슬렁거리는 수상한 녀석! 성 안의 함정들을 건드리지 않고 여기까지 오다니…… 이 은신처도 이제 안전하지 않은 건가…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600161/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이세계 모험","상점 id":71230,"상점 카테고리 id":24,"스킨 태그":"쁘띠모션, 배경","입수 영상":"O","재화":880,"기간":"한정 (2025/11/19)","진영":"MOT","레어도":"SR","ex_chat_status":0}]