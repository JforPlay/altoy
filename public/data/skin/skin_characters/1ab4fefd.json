[{"클뜯 id":10700050,"클뜯 함순이 id":1070005,"함순이 이름":"아키즈키 리츠코","한글 함순이 + 스킨 이름":"아키즈키 리츠코","영문 함순이 + 스킨 이름":"Ritsuko Akizuki","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700050/shipyard.png","설명":"처음 뵙겠습니다, 아키즈키 리츠코입니다. 갑자기 이곳으로 오게 되었을 때 안절부절 정신이 없었는데... 크흠, 아무튼... 앞으로 잘 부탁드립니다!","자기소개":{"voiceline":"아키즈키 리츠코입니다. 기왕 한다면 최선을 다해! 모항에서도 아이돌 활동은 게을리 하지 않겠습니다. ……그런데 지휘관님, 모항에는 아이돌이 될만한 애들이 잔뜩 있네요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/profile.ogg"},"메인1":{"voiceline":"아, 죄송합니다, 지휘관님. 그만 생각에 빠져서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/main1.ogg"},"메인2":{"voiceline":"다 함께 이곳에 온 건 좋지만, 여전히 시끌시끌하네요…… 아, 아미! 마미! 잠까 기다려! 그 삽은 대체 어디에 쓰려는 거야!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/main2.ogg"},"메인3":{"voiceline":"이 안무는 이렇게…… 움직임에 역동감을 주면 좀 더 퍼포먼스가 좋아질 것 같네요. 응, 다음 무대에 반영해 볼까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/main3.ogg"},"전투개시":{"voiceline":"정신 차리고 가보도록 하죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/battle.ogg"},"상세확인":{"voiceline":"프로필 확인은 아이돌의 개성을 살리기 위해 중요하니까요. 꼼꼼히 봐주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/detail.ogg"},"드랍 설명":{"voiceline":"처음 뵙겠습니다, 아키즈키 리츠코입니다. 갑자기 이곳으로 오게 되었을 때 안절부절 정신이 없었는데... 크흠, 아무튼... 앞으로 잘 부탁드립니다!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 임무에 나선 아이들이 돌아온 모양이에요. 자, 멍하니 계시지 마시고, 지휘관으로서 마중 나가주세요","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/expedition.ogg"},"실망":{"voiceline":"요전에 무대에서의 반성점은…… 아, 죄송해요. 지금 좀 바빠서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/feeling1.ogg"},"낯섦":{"voiceline":"아, 지휘관님. 마침 잘 오셨습니다. 전신 거울 어디 있는지 알고 계신가요? 댄스 안무를 확인하고 싶은데, 보이질 않아서요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/feeling2.ogg"},"호감":{"voiceline":"수고 많으십니다, 지휘관님. 여전히 바쁘신 것 같네요. 저는 지금 일손이 비었는데, 뭔가 도와드릴 일 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님의 업무는 프로듀서와 닮은 구석이 있군요. 지휘관님을 관찰하다 보면 새로운 걸 배울 수 있을지도…… 괜찮으시다면 다음에 업무를 견학시켜주시지 않겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/feeling4.ogg"},"사랑":{"voiceline":"지휘관님 곁에서 여러 업무를 보고, 지금까지 몰랐던 경험을 쌓은 덕분에…… 시야가 넓어진 기분이 듭니다. 지금이라면 신선한 전략이 떠오를 것 같아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/feeling5.ogg"},"터치3":{"voiceline":"제 머리카락 말씀하실 게 아니라, 지휘관님 머리야말로 새집 지어놨다구요. 정말……지휘관이시니까, 몸가짐에도 신경 써주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/headtouch.ogg"},"모항귀환":{"voiceline":"수고하셨습니다, 지휘관님. 다음 업무까지 조금 휴식하도록 할까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/home.ogg"},"hp 경고":{"voiceline":"마지막까지 포기하지 않아……!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 오늘도 잘 부탁드립니다. 바로 스케쥴을 확인하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/login.ogg"},"실패":{"voiceline":"계산이 잘못된 모양이군요…… 일단 태세를 정비하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔습니다. 잊지 말고 제때 확인해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/mail.ogg"},"임무":{"voiceline":"아직 남은 일이 있잖아요! 자, 자, 얼른 끝내주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/mission.ogg"},"임무완료":{"voiceline":"업무, 전부 끝났군요. 보수도 잊지 말고 받아주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/mission_complete.ogg"},"서약":{"voiceline":"이곳에서 쌓은 경험은 분명 제 장래에 있어서도 소중한 경험이 될 거라 생각합니다. 다시 한 번, 늘 감사합니다, 지휘관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/propose.ogg"},"스킬":{"voiceline":"지금이야말로 활약할 때군요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/skill.ogg"},"터치1":{"voiceline":"업무를 도와주길 바란다……고요? 좋습니다. 손을 댄 이상 완벽하게 처리하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/touch.ogg"},"터치2":{"voiceline":"지휘관님! 이런 짓을 할 여유가 있다면 일부터 하시라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/touch2.ogg"},"입수시":{"voiceline":"처음 뵙겠습니다, 아키즈키 리츠코입니다. 갑자기 이곳으로 오게 되었을 때 안절부절 정신이 없었는데... 크흠, 아무튼... 앞으로 잘 부탁드립니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/unlock.ogg"},"강화성공":{"voiceline":"순조롭습니다~ 전부 계획대로군요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"완수했군요. 제 계획대로입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/win_mvp.ogg"},"전투개시_ex":{"voiceline":"사전 조사도 완벽하다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/battle_ex.ogg"},"상세확인_ex":{"voiceline":"좀 더 저에 대해 알고 싶다…… 고요? 프로필에 대부분의 정보는 적혀있을 터입니다만…… 어떤 점을 알고 싶으신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님, 또 졸고 계시군요? 참, 일어나주세요. ……뭐, 요즘 바쁘셨던 모양이니, 오늘 정도는 봐 드릴까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"안녕하세요. 아침은 제대로 드셨나요? 규칙적인 생활 습관은 기본 중의 기본이라고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"아직 업무가 남은 것 같네요. 도와드릴 테니, 어서 끝내도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/mission_ex.ogg"},"임무완료_ex":{"voiceline":"꽤 훌륭한 일 처리였는걸요, 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"꺄악!? 잠깐, 지휘관님! 갑자기 뭐 하시는 건가요!? 아시겠나요? 대개 이런 짓은……(설교)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"제 덕분이라고요? 아무래도 그건 과대평가예요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['후타미 마미'] : 마미! 장난은 그만둬!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/couple_encourage1.ogg"},{"voiceline":"['미우라 아즈사'] : 아즈사 씨, 어디 가신 거예요~!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/couple_encourage2.ogg"},{"voiceline":"['아마미 하루카'] : 하루카, 그 안무는 이렇게 하는 게 좋지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"모항에 모인 아이들은 출신지가 다양하군요. 모두와 이야기할 때마다 제 경식이 넓어져서…… 무척 좋은 경험이 되고 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/main5_ex.ogg"},"메인6_ex":{"voiceline":"바쁘신 것 같군요, 지휘관님. 저로 괜찮으시다면 도와드리겠습니다. 안심해주세요. 사무 경험은 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님, 혹시 피곤하신가요? 일단 휴식하는 편이 좋지 않나요? 적당한 휴식도 필요하다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700050/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IMAS","레어도":"SR","ex_chat_status":1},{"클뜯 id":10700051,"클뜯 함순이 id":1070005,"함순이 이름":"아키즈키 리츠코","한글 함순이 + 스킨 이름":"섬머 타임 서비스","영문 함순이 + 스킨 이름":"Paddle Showdown - Summer Formation","스킨 타입":"Summer Fest","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700051/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700051/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700051/shipyard.png","설명":"에엑, 탁구 시합하자고요? 하필이면 이렇게 더운 날에…… 뭐어, 가끔은 이런 것도 좋네요. 제가 이긴다면 아이스크림 사주시길!","자기소개":null,"메인1":{"voiceline":"한여름에 실내에서 운동이라니…… 뭐, 땡볕 아래에서 하는 것보다는 낫겠지만요. 그래도 더운 건 마찬가지라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/main1.ogg"},"메인2":{"voiceline":"이 방은 꽤 통풍성이 좋아요. 문을 열어두면 에어컨이 없어도 시원해요…… 아니, 그 정도는 아닌가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/main2.ogg"},"메인3":{"voiceline":"멍하니 계시는데…… 괜찮으신가요? 지휘관이시니까 자기관리는 제대로 해주시길. 자, 스포츠 드링크입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"오늘처럼 더운 날에는 수분과 염분을 자주 섭취하는 게 중요해요. 방심하면 더위 먹을 수 있으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/detail.ogg"},"드랍 설명":null,"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관님, 잠깐 쉬시지 않겠어요? ……말해두지만, 항복한 건 아니에요. 수분 보충하면 시합 재개니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"안녕하십니까. 지금 막 일어난 참이라, 잠시 기다려주십…… 아니, 잠깐! 멋대로 들어오지 말아주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"어떤가요, 이건!! …후훗, 또 제 승리군요! 슬슬 항복하셔도 된다구요? 지휘관님♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/touch.ogg"},"터치2":{"voiceline":"꺄악!? 호, 혼란한 틈을 타 어딜 만지시는 건가요! 고소할 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/touch2.ogg"},"입수시":{"voiceline":"에엑, 탁구 시합하자고요? 하필이면 이렇게 더운 날에…… 뭐어, 가끔은 이런 것도 좋네요. 제가 이긴다면 아이스크림 사주시길!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700051/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_e