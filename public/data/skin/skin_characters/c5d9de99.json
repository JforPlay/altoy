[{"클뜯 id":105170,"클뜯 함순이 id":10517,"함순이 이름":"뉴저지","한글 함순이 + 스킨 이름":"뉴저지","영문 함순이 + 스킨 이름":"New Jersey","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105170/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105170/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105170/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105170/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105170/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105170/shipyard.png","설명":"아이오와급 전함—뉴저지, 현호 BB-62","자기소개":{"voiceline":"나는 이글 유니온 전함, 최강의 블랙 드래곤. 뉴저지. 자화자찬이 아니라고? \"최강\"이라는 말도 과언이 아니야. 날 충분히 알게 된다면 이 말에 대한 의심은 사라질 테니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/profile.ogg"},"메인1":{"voiceline":"\"아이오와 대 야마토\"인가... 확실히 뜨거운 감자네. 후후, 다들 이런 걸 좋아한다니까. 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/main1.ogg"},"메인2":{"voiceline":"좋아하는 음료는 주스야. 청사과 주스, 오렌지 주스. 탄산도 오케이라구? 커피는... 잘 못 마실걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/main2.ogg"},"메인3":{"voiceline":"비서함으로서 지휘관의 일을 대신한다면... 40% 정도 하는 게 좋다고 생각해. 내가 전부 다 해버리면 주객이 전도되는 거잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/main3.ogg"},"전투개시":{"voiceline":"전원, 1급 전투 태세! 간다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/battle.ogg"},"상세확인":{"voiceline":"장비 점검 완료, 각 시스템 정상 작동. 수고했어—— 아, 혹시 반했어? 난 상관 없는데? 어차피~ 지휘관은 이런걸 좋아 하잖아? 히히~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/detail.ogg"},"드랍 설명":{"voiceline":"아이오와급 전함—뉴저지, 현호 BB-62","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 모항에 도착했어. 가자. 지휘관의 마중이 가장 큰 보상일테니까~ 하하♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/expedition.ogg"},"실망":{"voiceline":"아, 여자를 울리면 안 되지, 지휘관! 반성하도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/feeling1.ogg"},"낯섦":{"voiceline":"서로 서먹한 상태는 좋지 않으니까 이렇게... 스킨십을 하면 조금 안심이 돼? 흐흥~ 이러면 더 가까워지지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/feeling2.ogg"},"호감":{"voiceline":"알게 모르게 모두 친해졌네~ 다음에는 어떤 이야기를 할까? 장비 기술? 아니면 일상? ...어, 내가 골라?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/feeling3.ogg"},"기쁨":{"voiceline":"응? 피곤해 보이네... 역시 과로구나? 자, 여기 누워. 이번에는 내가 돌봐줄게. 으흥... \"내 허벅지를 베개로 삼아~\" 지휘관은 이런 거 좋아하지~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/feeling4.ogg"},"사랑":{"voiceline":"적극적인 뉴저지와 소극적인 뉴저지 중에 어떤 쪽을 더 좋아해? ——잠깐~ 이제 천천히 시간을 들여서 확인할 거니까 대답하지 마. 히히~ 지휘관은 이렇게 애태우는 거 좋아하잖아~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/feeling5.ogg"},"터치3":{"voiceline":"다 만졌어? 자, 그럼 얌전히 앉아. 이젠 내 차례니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/headtouch.ogg"},"모항귀환":{"voiceline":"방금 전 전투 보고서를 보자. 누가 먼저 말 할래? 네가 먼저 하는 게 낫겠지? 그럼 나는 아이스크림을 먹으면서 잘 들어 볼게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/home.ogg"},"hp 경고":{"voiceline":"당황하지 마. 역전할 방법이 생각났으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/hp_warning.ogg"},"로그인":{"voiceline":"돌아온 걸 환영해! 업무 계획 세우는 거 도와줄까? 아니면 이미 충분한 계획을 세워뒀어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/login.ogg"},"실패":{"voiceline":"우리가 적에게 당하다니, 믿을 수 없어... 되갚아줄 방법을 찾을 때까지 쉬지 않겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/lose.ogg"},"우편":{"voiceline":"새로운 우편이 있어. 하하, 누군가의 편지를 기다리고 있었구나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/mail.ogg"},"임무":{"voiceline":"이 새로운 임무를 받았어? 좋아, 같이 해치워 버리자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/mission.ogg"},"임무완료":{"voiceline":"중요한 임무도 끝냈으니 쉬는 게 어때? 모든 일은 완급조절을 해야 순조롭다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/mission_complete.ogg"},"서약":{"voiceline":"지휘관의 생각, 전부 닿았어. 지휘관이 싫지 않다면 나도 괜찮은데~? 어쨌든 나도 지휘관에게 한 번은 고백해야 하잖아? 히히, 이게 바로 서로를 생각하는 거지♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/propose.ogg"},"스킬":{"voiceline":"화력 시스템, 록 온!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/skill.ogg"},"터치1":{"voiceline":"임무가 있다면 거절할 수 없지. 하지만 다른 부탁이라면 약간의 보수를 받을 거라고? 장난이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/touch.ogg"},"터치2":{"voiceline":"지휘관, 이미 여러가지 의미에서 \"당하는\" 상태가 되었다고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/touch2.ogg"},"입수시":{"voiceline":"이글 유니온 전함, 최강 최대의 Black Dragon, 뉴저지 등장! 내 힘을 보여주지! 농담이야~ 지휘관은 이런 느낌이 맘에 들어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/unlock.ogg"},"강화성공":{"voiceline":"전함이 시대에 뒤떨어질 수는 있어도, 아이오와급은 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우리는 지금 명확하게 올바른 방향으로 나아가고 있다—— 하하, 다들 이런 느낌 좋아하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/win_mvp.ogg"},"전투개시_ex":{"voiceline":"허니가 보고 있어! 전투 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/battle_ex.ogg"},"상세확인_ex":{"voiceline":"♪~ 뭘 그렇게 재밌게 보고 있냐고? 당연히 허니지~ 설마 멍하니 있는 모습을 나는 보면 안 되는 거야? 후후~♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"출격 수고했어! 다녀왔어요 키스부터 할까? 히히~ 바로 그거야. 이제 이번 전투를 정리해보자♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 와, 허니~♪ 오늘은 어느 임무부터 할 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"좋아. 허니, 이거 좀 사줘~ .. 안 돼? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/touch_ex.ogg"},"터치2_ex":{"voiceline":"네가 이런 걸 좋아한다는 건 이미 알고 있었지. 히히히♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['조지아'] : 구경이 더 큰 \"아이오와\"? 아니, 조금 달라...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/couple_encourage1.ogg"},{"voiceline":"['렉싱턴', '새러토가', '요크타운', '엔터프라이즈', '호넷', '와스프', '에식스', '인트레피드', '벙커힐', '샹그릴라'] : 대공은 맡길게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/couple_encourage2.ogg"},{"voiceline":"['USS'] : 우리의 의지를 막을 수 있는 것은 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/couple_encourage3.ogg"},{"voiceline":"['소비에츠카야 벨로루시아', '소비에츠카야 러시아'] : 오? 의외의 상대네. 재밌겠어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/couple_encourage4.ogg"},{"voiceline":"['엔터프라이즈'] : 이글 유니온의 히어로, 항상 고생이 많아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105170/coupl