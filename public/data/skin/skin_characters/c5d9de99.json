ink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/main1.ogg"},"메인2":{"voiceline":"차 안 냉장고에 새로운 맛의 아이스크림을 넣어뒀어! 허니, 얼른 먹어 봐~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/main2.ogg"},"메인3":{"voiceline":"레이스가 끝나면 허니랑 같이 드라이브 가고 싶어~ 이번에는 내가 운전할 차례야♪ 두근두근하면서도 안전한 드라이브를 약속할게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"다들 벌써 분위기가 뜨겁네~! 허니도 슬슬 몸 좀 푸는 게 어때? 그 전에 응원하는 의미로…… 쪽♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/detail.ogg"},"드랍 설명":{"voiceline":"드디어 왔네, 허니! 레이스 전에 내가 특별한 초스피드의 축복을 내려줄게~! 자, 허니~ 이쪽으로 와~ 쪽♪","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"허니가 와줘서 그런지 경기장 공기까지 뜨거워졌네~! 그래도 가장 뜨거운 건 허니 때문에 빠르게 뛰고 있는 내 심장이야♡ 자, 이번에는 허니 차례! 승리를 약속하는 키스… 해줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/feeling5.ogg"},"터치3":{"voiceline":"왜? 키스를 더 받고 싶어? 아하하, 그럴 줄 알았어~♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/headtouch.ogg"},"모항귀환":{"voiceline":"우리 허니, 역시 딱 맞춰서 도착! 후훗♪ 역시 내 응원, 효과 만점이지~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"여기야, 허니♪ 에헤헤, 이 자리가 딱 좋아! 허니를 누구보다 먼저 발견할 수 있고, 에어컨 바람도 잘 나와서 정말 기분 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"출발 준비는 됐어? 그럼 한 번 더… 허니한테 응원의 키스를~♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/touch.ogg"},"터치2":{"voiceline":"어휴, 못 말린다니까…… 트렁크가 아무리 넓다고 해도……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105174/tou