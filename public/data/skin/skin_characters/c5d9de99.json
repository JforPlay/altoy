elink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/main2.ogg"},"메인3":{"voiceline":"업무 고생 많으셨어요~ 정말 장해요~ 잘한다 잘한다~ 착하지 착하지~ 이걸로 다음 업무도 계속할 수 있지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/main3.ogg"},"전투개시":{"voiceline":"두 배로 가보자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/battle.ogg"},"상세확인":{"voiceline":"♪~ 뭘 그렇게 흥미진진한 눈초리로 보느냐고? 당연히 우리 자기지. 자기는 나한테 홀딱 반해놓고, 나는 자기한테 반하면 안 된다는 거야? 후후훗♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/detail.ogg"},"드랍 설명":{"voiceline":"최강, 최대…가 아니라, 최애, 최고의 웨딩드레스 차림을 한 뉴저지 등장이야! 후후훗, 반했어? 당연히 우리 자기가 안 반했을 리 없겠지♪","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어. 자기도 같이 마중 나갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"날 리드해도, 내게 리드 당해도, 내가 제일 좋아하는 자기라는 사실에는 변함이 없어♪ 그·러·니·까~ 오늘은 내가 평소와는 다른 느낌으로 변신해서, 자기를 다시 반하게 만들 거야! 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격하느라 수고했어! (쪽) 자! 이건 '어서 오세요 키스'야! 좋아하지? 이런 거♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 와요, 자기♪ 오늘 하루도 업무 힘내!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/login.ogg"},"실패":{"voiceline":"우리 자기는 이런 걸로 기죽지 않아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/lose.ogg"},"우편":null,"임무":{"voiceline":"임무다, 임무…. 자기, 다음에 처리할 건 뭐야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105178/mission.ogg"},"임무완료":{"voiceline":"임무 완료♪ 보상 수령은 내게 맡겨두고 자기는 쉬고 있어도 돼! …그럴 필요까진 없으려나…. 하하하….","voicelink":"https://raw.githubus