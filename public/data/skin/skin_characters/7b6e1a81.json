[{"클뜯 id":205160,"클뜯 함순이 id":20516,"함순이 이름":"라이온급 전함 - 라이온","한글 함순이 + 스킨 이름":"라이온급 전함 - 라이온","영문 함순이 + 스킨 이름":"Lion","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205160/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205160/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205160/shipyard.png","설명":"라이온","자기소개":{"voiceline":"로열 네이비의 라이온급 전함 라이온이다. 후후후…… 이 모항은 네 것이지만, 내 영지이기도 하다는 점 명심하라고. 너와 함께 모항을 지키는 자로서 어떠한 위협도 놓치지 않으마. 그래, 약속하고말고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/profile.ogg"},"메인1":{"voiceline":"사자 모양 장식품? 크흠흠…… 아, 그건 적에게 공포감을 주기 위한 거지, 딱히 좋아해서 놔둔 건 아니니 오해하지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/main1.ogg"},"메인2":{"voiceline":"모항 순찰은 중요해. 자기 영지는 구석구석까지 파악하고 있어야 제대로 지킬 수 있는 법이다. 물론 너도 포함해서 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/main2.ogg"},"메인3":{"voiceline":"모항을 내려다보면 기분이 좋아지지. 음? 높은 곳은 무서운가? 내가 지켜줄 테니 겁내지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/main3.ogg"},"전투개시":{"voiceline":"내 존재로 적을 위협하라고? 훌륭한 선택이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/battle.ogg"},"상세확인":{"voiceline":"오늘 일정을 짜놨다. 우선 서류 정리, 그리고 모항 순찰, 보안 시스템을 중점적으로 점검한 후, 마지막으로는…… 음, 휴식 시간도 당연히 넣어놨지. 안심해라. 오늘은 하루 종일 네 곁에 붙어있을 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/detail.ogg"},"드랍 설명":{"voiceline":"라이온급 전함 - 라이온","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔군. 그 아이들을 맞이하는 것도 우리 책임이지. 서두르자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/expedition.ogg"},"실망":{"voiceline":"실망스럽군. 그래도 네가 잘 성장할 때까지 계속 지켜봐 주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/feeling1.ogg"},"낯섦":{"voiceline":"네가 모항의 지휘관이라는 건 인정해도, 그 능력까지 인정한 건 아니다. 뭐 네 노력 여하에 따라 어쩌면 같이 잘해볼 수도 있겠지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/feeling2.ogg"},"호감":{"voiceline":"내 예상보다 훨씬 믿음직스럽군. 그래, 「같은 편」이 된 이후로 호흡도 꽤 잘 맞는 것 같고 말이지. 하하! 칭찬받으니까 그렇게 좋은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/feeling3.ogg"},"기쁨":{"voiceline":"처음엔 그저 너와 모항을 지킬 생각이었는데…… 어느새 네게서 눈을 뗄 수 없게 되었군. 뭐, 이것도 이것 나름대로 나쁘진 않다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/feeling4.ogg"},"사랑":{"voiceline":"으흠…… 뭐, 네가 모항의 지휘관으로서 모두를 이끄는 존재이기는 하다만, 만약 사적으로 내 이야기를 더 들어줄 의향이 있다면…… 그래, 둘만 있을 때는…… 나도 조금은…… 부드럽게 굴어줄 수…도 있는데, 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/feeling5.ogg"},"터치3":{"voiceline":"……제법 대담하군. 아니면 아첨이라도 할 셈인가? 후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/headtouch.ogg"},"모항귀환":{"voiceline":"모항은 아무 이상 없다. 구석구석 확인했고말고. 이 라이온이 있는 한 어떤 위협도 다가오지 못할 테니 안심하고 쉬어라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/home.ogg"},"hp 경고":{"voiceline":"후후후…… 상처 입은 사자가 가장 무섭다는 걸 보여주마…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/hp_warning.ogg"},"로그인":{"voiceline":"잘 돌아왔군. 좋아… 고개를 들어라! 주눅 들지 마라! 흥, 내 눈길 앞에서도 당당할 수 있는 배짱부터 배우도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/login.ogg"},"실패":{"voiceline":"다음에는 제대로 혼쭐을 내주겠어… 지휘관, 지금은 물러나자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔군. 위협 요소가 있는지는 이미 확인해 뒀다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/mail.ogg"},"임무":{"voiceline":"아직 임무가 안 끝난 건가? 모항을 이끄는 자가 임무를 방치하다니 실망스럽군. 그래도 걱정하지 마라. 내가 도와줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/mission.ogg"},"임무완료":{"voiceline":"임무를 잘 마무리했군. 보상 수령도 잊지 말고 챙기라고. 당당히 가슴을 펴고 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/mission_complete.ogg"},"서약":{"voiceline":"이제 완전히 이 라이온의 것이 되었군. 아아, 내 소중한… 누구에게도 빼앗기지 않을 소유물이 되었다는 점을 명심해라. 그래서 말인데, 내가 그동안 모은 귀여운 사자들을 보여줄까 하는데… 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/propose.ogg"},"스킬":{"voiceline":"갈기갈기 찢어버려라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/skill.ogg"},"터치1":{"voiceline":"응? 무슨 이상이라도 있었나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/touch.ogg"},"터치2":{"voiceline":"지금 내 인내심을 시험하는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/touch2.ogg"},"입수시":{"voiceline":"어라? 못 보던 얼굴이 있나 했더니, 우리 지휘관이었군. 부디 날 실망하게 하지 않았으면 하는군. 다시 인사하지. 나는 라이온… 내가 너와 이 모항을 지켜주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/unlock.ogg"},"강화성공":{"voiceline":"좋아, 이제 너와 이 영지를 더 잘 지켜낼 수 있겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"전장은 곧 황야다. 승자가 곧 왕이지. 이 승리가 그 이치를 증명하고 있군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"최근에 산 사자 쿠션을 어디 둘까 생각해 봤는데, 네 침대가 딱 좋을 것 같더군. 아니, 잠깐! 내 대신이라고 생각하라는 뜻은 아니야! 다만… 뭐, 내 속마음쯤은 너라면 다 알고 있을 테니, 차라리 솔직하게 나가는 편이 좋으려나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"너를 특별히 대하고는 있지만, 그렇다고 무작정 어리광을 받아줄 마음은 없다. 뭐… 주변에 아무도 없다면 「애교」 정도는…… 크흠, 부려줄 수도 있지. 흠, 다른 사람도 아니 너니, 어차피 그런 걸 기대하고 있었을 테지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"후후후… 참 쉽게도 만족하는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"우리 모항에는 아무 이상 없다. 지휘관의 피곤한 얼굴만 빼고 말이지. 좋아, 오늘 일은 모두 내게 맡기고 푹 쉬도록 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"잘 돌아왔다, 지휘관. 어떤 도전도 함께할 각오가 되어 있다고 봐도 되겠지? …후후, 그래. 그 표정이 보고 싶었다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"피곤한가? 그러면 잠시나마 긴장을 풀도록 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/touch_ex.ogg"},"터치2_ex":{"voiceline":"후후후… 이렇게까지 나올 줄이야… 나중에 울어도 책임 못 진다♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['퀸 엘리자베스'] : 폐하, 전장은 위험하니 여긴 내게 맡기라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/couple_encourage1.ogg"},{"voiceline":"['뱅가드'] : 믿음직스러운 지원군이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/couple_encourage2.ogg"}],"메인4":{"voiceline":"응? 뭐 하고 싶은 말이라도 있나? 있으면 바로 말해라. 돌려 말하는 건 싫달까… 솔직한 네 모습이 더 좋으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"너와 순찰을 돌면, 자꾸만 잡담에 빠져들게 되는군. 효율은 떨어지지만… 그게 뭐 대수인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/main5_ex.ogg"},"메인6_ex":{"voiceline":"졸린가? 잠깐 쉴까? …으흠. 어깨를 빌려주길 바란다면, 난 상관없다만?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/main6_ex.ogg"},"메인7_ex":{"voiceline":"오늘 업무가 순조롭게 끝나면, 나중에 저녁노을이라도 보러 가는 건 어떤가? 그래, 너와 나, 단둘이서 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/main7_ex.ogg"},"메인8_ex":{"voiceline":"홍차 한 잔 어떤가? 사실 사자 모양 티 세트를 사서 말이지… 음? 너무 귀여울 것 같다고? 후훗, 그렇게까지 말하니 당장 써주는 수밖에 없겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205160/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"UR","ex_chat_status":1},{"클뜯 id":205161,"클뜯 함순이 id":20516,"함순이 이름":"라이온급 전함 - 라이온","한글 함순이 + 스킨 이름":"나른한 댄딜라이온","영문 함순이 + 스킨 이름":"The Reclining Dandelion","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205161/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205161/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205161/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205161/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205161/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205161/shipyard.png","설명":"후후, 이제부터 이 해변은 내 영지다♪ 후우… 저기, 지휘관. 모처럼 느긋하게 보낼 수 있는 시간이니, 같이 즐겨보는 게 어떤가? 더… 가까이 와도 된다만?","자기소개":null,"메인1":{"voiceline