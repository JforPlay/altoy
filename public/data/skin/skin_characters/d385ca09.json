[{"클뜯 id":107120,"클뜯 함순이 id":10712,"함순이 이름":"호넷Ⅱ","한글 함순이 + 스킨 이름":"호넷Ⅱ","영문 함순이 + 스킨 이름":"Hornet II","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107120/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107120/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107120/shipyard.png","설명":"에식스급 항공모함—호넷II, 현호 CV-12","자기소개":{"voiceline":"에식스급 항공모함으로 새로운 힘을 손에 넣은 호넷 님, 그게 바로 나야! 뭐, 솔직히 말하면 함력이나 의장이나 전투력 말고는 예전에 비해 크게 달라진 건 없지만… 지휘관, 말은 이래도 엄청 고마워하고 있다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/profile.ogg"},"메인1":{"voiceline":"어떻게 해야 엔터 언니를 이길 수 있는지가 아니라, 엔터 언니보다 더 강해질 수 있을지를 고민하는 게 바로 지금의 호넷이야! 뭐, 엔터 언니한테 계속 지기만 할 생각은 아니란 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/main1.ogg"},"메인2":{"voiceline":"저건… 노샘프턴? 야, 노샘프턴! ……아하하, 딱딱하게 구는 건 여전하네~ 아니면 지휘관 앞이라서 부끄러워 하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/main2.ogg"},"메인3":{"voiceline":"자신 있어도 상황을 제대로 살피지 않으면 손해를 볼 수 있어. 싸우기 전에 이미 승부가 났다는 건 바로 그걸 말하는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/main3.ogg"},"전투개시":{"voiceline":"전투 지휘소 관제 접속, 공격 태세 이행 완료―― 다들, 한바탕 해보자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/battle.ogg"},"상세확인":{"voiceline":"아하하하, 아무래도 새로운 호넷한테 다시 푹 빠진 모양이네? 부끄러워할 거 없어. 그 정돈 이미 눈치챘으니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/detail.ogg"},"드랍 설명":{"voiceline":"에식스급 항공모함—호넷II, 현호 CV-12","voicelink":null},"의뢰 완료":{"voiceline":"흐아아암~ 큰일이야, 또 졸리네… 앗, 의뢰팀 애들이 벌써 돌아왔다구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/expedition.ogg"},"실망":{"voiceline":"지휘관은 둔감한 건지, 아니면 멍청한 건지 잘 모르겠어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/feeling1.ogg"},"낯섦":{"voiceline":"좋아하는 지휘관을 위해 호넷이 직접 만든 요리야! 마음껏 먹어♪ …어때? 엔터 언니랑 요크타운 언니가 만든 거랑은 다르지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/feeling2.ogg"},"호감":{"voiceline":"응? 혹시 러브러브 호넷보다, 좀 토라지거나 하는 호넷이 더 좋은 거야? 미안하게 됐네. 왜냐면 호넷, 토라지는 건… 상대방한테 달렸거든. 응.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/feeling3.ogg"},"기쁨":{"voiceline":"엔터 언니는 일단 제쳐두고, 요크타운 언니랑 지휘관이 사귀어도 난 딱히 질투 안 해. 즈이카쿠나 타이콘이나 노샘프턴은… 뭐, 딱히? 어라? 호넷이 토라질만한 거, 정말 없는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/feeling4.ogg"},"사랑":{"voiceline":"뭐, 무리해서 자기를 바꾸는 건 좋지 않고, 괜히 다른 애들을 의식하는 것도 무의미해. 나는 지휘관의 호넷인걸. 이걸로 충분해. ——응! 무슨 일이 있더라도, 좋아한다고 말해줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"휘익♪ 지휘관, 오늘도 멋졌어! 고생했으니 마실 거라도… 으아아?! 괘, 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/home.ogg"},"hp 경고":{"voiceline":"아직이야! 지금부터 역전할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/hp_warning.ogg"},"로그인":{"voiceline":"새로운 호넷 님이 집무실에 짜자잔하고 등장! 하하하, 지휘관! 좋은 아침이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/login.ogg"},"실패":{"voiceline":"새로운 호넷은… 여기서 끝나지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/lose.ogg"},"우편":{"voiceline":"묘기! 매직 카펫 딜리버리! ……음, 이 이름은 좀 그렇지 않아…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/mail.ogg"},"임무":{"voiceline":"좋은 날씨엔 의욕이 샘솟지! 미션하기 좋은 날이란 바로 오늘 같은 날을 말하는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/mission.ogg"},"임무완료":{"voiceline":"미션 보너스가 도착했어! 우선은 누락된 건 없는지 확인해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/mission_complete.ogg"},"서약":{"voiceline":"하아… 하아… 좋아, 준비 완료… 그럼, 지휘관. 반지 교환 의식, 이제 시작해도 돼? 바뀌는 건 아무것도 없어도, 진짜 중요한 거니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/propose.ogg"},"스킬":{"voiceline":"이걸로 끝이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/skill.ogg"},"터치1":{"voiceline":"업무 보는 거 응원해달라는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/touch.ogg"},"터치2":{"voiceline":"그, 그렇게 만지면 부끄럽다구…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/touch2.ogg"},"입수시":{"voiceline":"그레이 고스트'라는 이름의 호넷은 바로 날 말하는 거야! 하하하, 슬슬 진짜로 호넷 님이라고 불러줬으면 하는 바람인데 말이지♪ 어쨌든, 지휘관, 앞으로 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/unlock.ogg"},"강화성공":{"voiceline":"파워 업! 했다구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"상쾌한 대승리! 지휘관은 어때? 그럭저럭 괜찮은 운동이었지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"며, 면전에 대놓고 또 한 번 반했다고 하니까 역시 좀 부끄럽네…. 아하하하… 응, 호넷도 지휘관한테 또 반했어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107120/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀 애들이 돌아왔어. 이럴 때 지휘관이 취해야 할 행동은…… 하하하, 잘 알고 있네♪","voicelink":"https://ra