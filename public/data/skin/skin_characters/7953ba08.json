[{"클뜯 id":104010,"클뜯 함순이 id":10401,"함순이 이름":"컨스텔레이션","한글 함순이 + 스킨 이름":"컨스텔레이션","영문 함순이 + 스킨 이름":"Constellation","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104010/shipyard.png","설명":"렉싱턴급 순양전함—컨스텔레이션, 현호 CC-2","자기소개":{"voiceline":"페넌트 넘버 CC-2 컨스텔레이션이야. 자매함과 함께하지 못해 아쉬웠어. 그렇게 출항을 손꼽아 기다리며 언제부턴가 밤하늘을 올려다보는 게 버릇이 되었는데… 지휘관, 모항의 밤하늘은 또 어떤 모습일까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/profile.ogg"},"메인1":{"voiceline":"……'오늘의 별자리 운세' 채널이란 거 지휘관도 알아? ……후후, 그 채널은 사실 나 컨스텔레이션이 운영하는 거야. 어때? 지휘관도 오늘 운세 확인해 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/main1.ogg"},"메인2":{"voiceline":"밤에는 별을 바라보고, 낮에는 그냥 쉬고만 있어. 동료들의 모임에 참석하지 못하는 건 아쉽지만…… 어떻게 하면 좋을지 몰라서… 우으……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/main2.ogg"},"메인3":{"voiceline":"여러모로 생각해 보니 아무래도 야근하는 지휘관이 마음에 걸려서…… 오늘은 지휘관이랑 같이 있어야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/main3.ogg"},"전투개시":{"voiceline":"음… 어, 어쩔 수 없지! 단숨에 파고들어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/battle.ogg"},"상세확인":{"voiceline":"초보자에게 추천할 만한 천체관측 장소라면… 공원이나 산꼭대기 정도…려나? 비어있는 교외나 멀리 떨어진 해변도 좋겠다. 가장 추천하는 곳이라고 하면… 꽤 고르기 어렵네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/detail.ogg"},"드랍 설명":{"voiceline":"렉싱턴급 순양전함 - 컨스텔레이션 CC-2","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아왔어. 기회가 있으면 나도 멀리 나가보고 싶어…… 항구의 불빛에서 멀리 떨어진 바다의 밤하늘은 천체관측에도 적합하겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/expedition.ogg"},"실망":{"voiceline":"그렇구나… 지휘관도 컨스텔레이션을 다른 애들이랑 똑같이 평가하는구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/feeling1.ogg"},"낯섦":{"voiceline":"지휘관은 산책 중……? 나? 컨스텔레이션은 별을 기다리고…… 으흠, 그, 그게 아니라… 잠깐 바람을 쐬면서 기분 전환하고 있는 것뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/feeling2.ogg"},"호감":{"voiceline":"오늘 별자리 운세가 알려줬어. 지휘관의 소원에 좋은 대답이 있을 거라고… 안심해도 된다고 말이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/feeling3.ogg"},"기쁨":{"voiceline":"천문학 잡지를 읽어보라고 좀 가지고 왔어. ……힘들지 않냐고? 딱히 그렇게 무거운 건 아닌데? ……다 가지고 온 건 그러니까… 다 괜찮은 내용이라 어떤 걸 추천하면 좋을지 몰라서… 그래서 지휘관이 정해줬으면 해서!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/feeling4.ogg"},"사랑":{"voiceline":"무슨 고민 있냐고? …그렇게 큰 고민은 아니야. 천체망원경을 어떤 걸로 할지, 성능이랑 디자인을 비교해 봐도 고르기가 어려워서…… 사용 용도에 따라서 고르면 된다고 해도, 이건 지휘관한테 선물…… 크흠! 우, 우주 깊은 곳에 있는 별을 보려는 것뿐이야! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/feeling5.ogg"},"터치3":{"voiceline":"별을 바라볼 때 머리 위에 달린 게 걸리적거리지 않냐고? 응, 사실 사라지게도 할 수 있어. ……봐, 이렇게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/headtouch.ogg"},"모항귀환":{"voiceline":"좋아, 무사히 돌아왔네. 이젠 안심할 수 있겠어, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/home.ogg"},"hp 경고":{"voiceline":"별들의 반짝임이 어두워지고 있어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/hp_warning.ogg"},"로그인":{"voiceline":"휴우…… 어서 와, 지휘관. ……조금 맥이 빠진 것처럼 보인다고? 미안… 어제 유성우를 보려고 기다리다가 그만…… 이 정도는 아무렇지 않으니까 안심해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/login.ogg"},"실패":{"voiceline":"구름이 몰려든 탓에…… 별들이 더는 보이지 않아…… 읏.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 우편이야. ……가지고 오는 김에 천문학 잡지도 같이 가지고 오라고? 후후, 알았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/mail.ogg"},"임무":{"voiceline":"새로운 임무가 통달되었어. 지휘관, 처리할 서류가 좀 많은데… 뭐부터 시작하면 돼? …우선은 이거? 아니면…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/mission.ogg"},"임무완료":{"voiceline":"우으…… 어렵네…… 임무를 능숙하게 전부 처리하는 건 역시 지휘관만 할 수 있는 일인 걸까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/mission_complete.ogg"},"서약":{"voiceline":"이걸…… 나한테…? 마치 별이 손가락에서 반짝이는 것 같아…… 오, 오늘부터는 이건, 당신이 내게 준 이건 오로지 나만의 별이야. 후후후, 계속…… 계속 바라볼게♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/propose.ogg"},"스킬":{"voiceline":"별하늘을 바라보며… 별바다를 헤쳐가리라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/skill.ogg"},"터치1":{"voiceline":"지휘관……? 컨스텔레이션을 어디로 데려가려고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/touch.ogg"},"터치2":{"voiceline":"꺅…?! 벼, 별에만 관심이 있는 줄 알았는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/touch2.ogg"},"입수시":{"voiceline":"무한한 광년을 넘어 맑은 밤하늘을 빛내는 별들…… 눈으로 확인하고 눈동자로 바라보며, 별들의 반짝임을 껴안는 것이야말로 인간의 낭만…… 지휘관, 렉싱턴급 순양전함 컨스텔레이션이야. 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/unlock.ogg"},"강화성공":{"voiceline":"별이 보여. 더 먼 하늘에 떠 있는…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 느낌… 비유하자면 별들과의 해후랄까…… 장대하고 대범한…… 고양되는 느낌.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/win_mvp.ogg"},"전투개시_ex":{"voiceline":"바, 바로 출격하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/battle_ex.ogg"},"상세확인_ex":{"voiceline":"가장 밝게 빛나는 건 저 별이야. 지휘관도 보여? 응, 맞아. 지휘관 말처럼 컨스텔레이션처럼 빛나고 있…… 응? 아… 으아…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"올려다보면 별들뿐만 아니라 더 멀리 우주 끝에 있는 반짝임도…… 지휘관, 여기 천체망원경 받아. 앞으로는 컨스텔레이션이랑 함께 하늘을……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"지휘관 곁에서 별들을 바라볼 수 있으리라고는 생각 못 했어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"응? 오늘은 별 보러 안 갔어. 왜냐면…… 지휘관이 돌아오는 순간을 놓치고 싶지 않았으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/home_ex.ogg"},"hp 경고_ex":{"voiceline":"버티기로… 마음먹었으니까……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/hp_warning_ex.ogg"},"로그인_ex":{"voiceline":"컨스텔레이션이 가리키는 이 하늘… 모항에서도 볼 수 있겠지. 덧없이 아름다운 밤의 어둠을 가로지르는 은색 띠…… 맞아, 하늘의 강 은하수야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"바다에서 밤하늘의 별을 찍은 사진, 예쁘게 잘 찍혔네. …나한테? 지휘관, 기억하고 있었구나… 고마워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"별들은 계속 여기 있을 테니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/touch_ex.ogg"},"터치2_ex":{"voiceline":"별을 바라보는 건 이제 됐어. 휴우… 슬슬 시간이 됐으니… 지휘관, 집에… 갈까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['렉싱턴'] :  아이돌은 역시 꿈을 만들어내는 존재구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/couple_encourage1.ogg"},{"voiceline":"['새러토가'] :  기, 기다려…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"음…… 지휘관, 일부러 먼 길로 돌아가려고 하네……그나저나 나… 잔업 일을 빨리 마치는 데 도움은 좀 됐어? 그래…? 후후, 다행이다…… 아! 여기에서는 밤하늘이 선명하게 보이는구나… 아아… 정말 아름다워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"동료들을 불러서 천체 관측을…? 아하, 와스프랑 인트레피드를 불러서… 알았어. 다 같이 별을 보는 편이 더 즐겁게 밤을 보낼 수 있겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104010/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":104011,"클뜯 함순이 id":10401,"함순이 이름":"컨스텔레이션","한글 함순이 + 스킨 이름":"셀렉트 갤럭시","영문 함순이 + 스킨 이름":"Galaxy's Finest","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/104011/shipyard.png","설명":"어서 와, 지휘관. 컨스텔레이션에게 주문하려면 쥬스타그램에서 1개월 치 별자리 운세를…… 후후, 농담이야. …지휘관이 알고 싶은 게 있다면 뭐든 알려줄게.","자기소개":null,"메인1":{"voiceline":"잘 적응할까 걱정 안 해도 돼. 평소 모임에 잘 안 나간다고 이렇게 함께 떠들썩하게 보내는 걸 싫어하는 건 아니니까. 모두 함께 별들을 볼 수 있는 모임이 있다면 정말 좋겠지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/main1.ogg"},"메인2":{"voiceline":"자, 여기 지휘관이 주문한 음료야. …딱히 익숙한 건 아니야. 연습을 미리 조금 해둔 덕분이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/main2.ogg"},"메인3":{"voiceline":"지휘관, 플라네타륨이 아름답네. ……아름다운 컨스텔레이션이 보인다고…? 저, 정말! 갑자기 또 그런 소리를…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"어서 와, 지휘관. 컨스텔레이션에게 주문하려면 쥬스타그램에서 1개월 치 별자리 운세를…… 후후, 농담이야. …지휘관이 알고 싶은 게 있다면 뭐든 알려줄게.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"오늘 컨스텔레이션은 평소랑 좀 달라 보이나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 수고 많았어. 느긋하게 쉬어. …내일 운세가 궁금하다고? 그럼, 음…… 그냥 속았다고 생각하고 듣고 넘길 수 있겠어? 아하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘 음료 메뉴야. 지휘관, 뭐 마시고 싶은 거 있어? …추천해달라고? 음…… 그러니까…… 아음…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"지휘관이 처리해야 하는 임무야. 가게에서 기분 전환을 하는 동안에도 업무에 대비해야 한다니… 고생이 많네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/mission.ogg"},"임무완료":{"voiceline":"벌써 끝내고 왔네… 나라면 뭐부터 시작해야 할지 아직 망설이고 있었을 텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"음료수를 받아도 되나…? 아직 가게 일을 도와주는 중인데…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/touch.ogg"},"터치2":{"voiceline":"하아…… 괜찮아. 지휘관은 내 가장 소중한 사람이니까…… 그렇지?♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/touch2.ogg"},"입수시":{"voiceline":"어서 와, 지휘관. 컨스텔레이션에게 주문하려면 쥬스타그램에서 1개월 치 별자리 운세를…… 후후, 농담이야. …지휘관이 알고 싶은 게 있다면 뭐든 알려줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/104011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"카니발","상점 id":70938,"상점 카테고리 id":16,"스킨 태그":"배경, 쁘띠모션","입수 영상":"X","재화":980,"기간":"상시","진영":"USS","레어도":"SSR","ex_chat_status":0}]