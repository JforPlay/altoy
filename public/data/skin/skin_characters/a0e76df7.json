raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/main2.ogg"},"메인3":{"voiceline":"시합장에서 열심히 노력하는 모습은 슈퍼 히어로처럼 반짝거려…… 치어리더는 정말 좋은 직업이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"사실 팀장은 크레이븐 같이 경력이 있는 이글 유니온 함선에게 맡겨야 하지만, 나에게 넘겨버리는 바람에…… 크레이븐의 기대를 저버리지 않기 위해서라도 모두를 열심히 응원할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/detail.ogg"},"드랍 설명":{"voiceline":"역시 각 진영의 정예들이 모이는 대운동회야. 훌륭한 경기들이 계속되고 있어! 나도 치어리더로서 더 열심히 응원할게! 이글 유니온, 화이팅!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관, 마침 잘 왔어. 다음 경기가 곧 시작할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 여기라면 경기를 잘 볼수 있어. 잠깐 앉았다 가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"지휘관, 시상식 시간이야. 모두 지휘관을 기다리고 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"에? 지휘관, 이 물은 나를 주려고? 우와아, 상냥해! …… 우우, 히어로가 주는 물이라니. 너무 행복해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/touch.ogg"},"터치2":{"voiceline":"지휘관, 여기는 보는 눈이 많은데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/touch2.ogg"},"입수시":{"voiceline":"역시 각 진영의 정예들이 모이는 대운동회야. 훌륭한 경기들이 계속되고 있어! 나도 치어리더로서 더 열심히 응원할게! 이글 유니온, 화이팅!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102261/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_