[{"클뜯 id":302230,"클뜯 함순이 id":30223,"함순이 이름":"사카와","한글 함순이 + 스킨 이름":"사카와","영문 함순이 + 스킨 이름":"Sakawa","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302230/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302230/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302230/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302230/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302230/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302230/shipyard.png","설명":"아가노급 경순양함 4번함 - 사카와","자기소개":{"voiceline":"아가노급 경순양함 사카와랍니다! 그 대전에서는 여러 사정으로 별로 도움이 되기도 하고 안 된 것 같기도 하지만…. 이렇게 다시 싸울 기회를 주셔서, 모항의 동료들과 당신께 감사드려요! 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/profile.ogg"},"메인1":{"voiceline":"아, 지금 사카와를 본 거죠? 하긴, 사카와는 귀여우니까요~ 계속 보고 있어도 안 질리니까요~ 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/main1.ogg"},"메인2":{"voiceline":"뭐든 제게 맡겨주세요. 전투뿐만 아니라, 당신 일을 보좌하는 것도 여유롭게 해낼 수 있다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/main2.ogg"},"메인3":{"voiceline":"물자를 축내면 안 되지만, 업무를 잘 처리한 보상 정도는 받을 수 있겠죠? 후후후, 과자 하나만 주세요~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/main3.ogg"},"전투개시":{"voiceline":"임기응변으로 원활하게 대응하겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/battle.ogg"},"상세확인":{"voiceline":"어머, 또 절 만나러 오셨네요! 에헤헤, 뭐 사카와가 자꾸 신경 쓰여서 죽겠죠~ 저도 당신이 여러모로 신경 쓰이기도 하고, 안 쓰이기도 하답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/detail.ogg"},"드랍 설명":{"voiceline":"아가노급 경순양함 4번함 - 사카와","voicelink":null},"의뢰 완료":{"voiceline":"사카와 좀 그만 보세요~ 이제는 의뢰팀 맞이하러 가아죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/expedition.ogg"},"실망":{"voiceline":"저 좀 내버려두라고 했죠? 말 안 듣는 사람은 싫거든요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/feeling1.ogg"},"낯섦":{"voiceline":"어머, 오늘도 만났네요! 그러고 보니, 왠지 이 모항에 온 후부터 매일 당신이랑 만나는 거 같아요~ 지휘관이니까 당연한 일이긴 하죠! 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/feeling2.ogg"},"호감":{"voiceline":"♪~ 또 만나러 오신 거예요? 에헤헤, 노시로 언니한테 들켜서 질투해도 전 몰라요~ …자, 앉으세요. 지금 차랑 곁들일 과자… 제가 제일 좋아하는 사쿠라 엠파이어의 과자를 가지고 올게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/feeling3.ogg"},"기쁨":{"voiceline":"당신이 절 매일 만나러 오는 이유, 물론 잘 알고 있답니다. 제가 착각하고 있는 건 아니지만, 제 입으로 그걸 말하면 재미 없잖아요? 이럴 땐… 당신이 '사카와가 좋아'라고 큰 소리로 말해줘야 하는 거 아닌가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/feeling4.ogg"},"사랑":{"voiceline":"저, 정말 말할 줄이야…. 그야 그런 말을 얼굴에 대고 하면 부끄러운게 당연하죠. 아니면 당신, 지금까지 절 계속 놀린 건가요? 저는 그러니까… 지금까지 계속 진심이었는데…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/feeling5.ogg"},"터치3":{"voiceline":"머리 쓰담쓰담인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요~! 이기셨어요? 뭐, 당연히 이기셨겠죠? 안 그러면 제가 마중 나온 게 분위기 파악도 못한 게 되잖아요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/home.ogg"},"hp 경고":{"voiceline":"여기서 좌절할 순 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침입니다~! …아, 이럴 때는 참한 느낌으로 '평안하시온지요'라고 하는 편이 좋으려나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/login.ogg"},"실패":{"voiceline":"지고 말았어요…. 정말, 말도 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/lose.ogg"},"우편":{"voiceline":"우편이네요. 제가 읽어도 되나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/mail.ogg"},"임무":{"voiceline":"임무가 많네요…. 제가 도와드려도 좀처럼 끝나질 않네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/mission.ogg"},"임무완료":{"voiceline":"임무 완료에요! 혹시 누락은… 아, 있네요! 잠깐만 확인하고 올게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/mission_complete.ogg"},"서약":{"voiceline":"에헤헤, 지금 반지 끼워주려고 했을 때, 사카와 얼굴 봤죠? …아, 아니라구요? 흥, 다시 홀딱 반한 얼굴을 보여주려고 모처럼 마음 먹고 있었는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/propose.ogg"},"스킬":{"voiceline":"힘껏 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/skill.ogg"},"터치1":{"voiceline":"지금 사카와 본 거죠? 맞죠, 맞죠~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/touch.ogg"},"터치2":{"voiceline":"실수…하신 거죠? 미안하다고 하실 필요 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/touch2.ogg"},"입수시":{"voiceline":"아가노급 경순양함 사카와라고 해요♪ 당신이 지휘관? 그랬군요~ 어쩐지 노시로 언니가 그렇게 좋아하더라니~ 저도 좋아해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/unlock.ogg"},"강화성공":{"voiceline":"능력이 상승했으니, 전장에서 확실하게 확인을 하는 편이 좋겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다! 자, 사카와를 칭찬해주실 거죠? 어떻게 하실 거예요? 후후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/win_mvp.ogg"},"전투개시_ex":{"voiceline":"우선은 사카와쪽에서 먼저 가도록 하죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302230/battle_ex.ogg"},"상세확인_ex":{"voiceline":"어머, 오늘도 절 만나러 오신 거예요? 어쩌다 지나가던