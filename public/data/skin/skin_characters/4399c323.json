:null,"임무":{"voiceline":"아, 지휘관. 임무 땡땡이치면서까지 알바코어를 만나러 온 거구나……. 히히히, 봐, 임무가 아직도 이렇게나 많이 남아있다구~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108022/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"한 번 장난치는 대신, 지휘관에게 1분간 토크 서비스를 제공할게! 어때? 솔깃하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108022/touch.ogg"},"터치2":{"voiceline":"나한테 무슨 짓을 했는지 다른 애들한테 다 말하면~ 지휘관…… 어떻게 될까? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108022/touch2.ogg"},"입수시":{"voiceline":"Surprise! 상자 속에서 나타난 알바코어!—— 앗, 놀랬어? 그럼, 사과의 의미야, 이 할인권을 받아줘~ 꼭 매장으로 놀러와야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108022/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70640,"상점 카테고리 id":17,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"USS","레어도":"SSR","ex_chat_status":0}]