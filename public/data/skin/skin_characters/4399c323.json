[{"클뜯 id":108020,"클뜯 함순이 id":10802,"함순이 이름":"알바코어","한글 함순이 + 스킨 이름":"알바코어","영문 함순이 + 스킨 이름":"Albacore","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108020/shipyard.png","설명":"가토급 잠수함 알바코어 (SS-218)","자기소개":{"voiceline":"전적? 흠흠……아! 맞다! 다이호를 격침시켰었어! 그래도 그 사람은 그렇게 쉽게 가라앉을 리가 없……왜 가라 앉았더라?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/profile.ogg"},"메인1":{"voiceline":"지휘관은 어떤 언니한테 흥미 있어? 알려줘~ 다른 사람한텐 안 말할 테니까~♪ …아마도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/main1.ogg"},"메인2":{"voiceline":"아아아피곤해애애~지휘관, 허벅지 좀 빌려줘~ 우옷! 땡큐~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/main2.ogg"},"메인3":{"voiceline":"옷? 난 늘 이 옷차림인데? 신경 쓰여? 혹시~ 이상한 거 생각한 거 아냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/main3.ogg"},"전투개시":{"voiceline":"다음은 누굴까나~ 히히~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/battle.ogg"},"상세확인":{"voiceline":"하항? 아까부터 힐끔힐끔 여기만 쳐다보고 말야~ 혹시 지휘관……작은 게 취향인 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/detail.ogg"},"드랍 설명":{"voiceline":"가토급 잠수함 알바코어 (SS-218)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 끝났어! 자 빨리빨리! 너무 오래 기다리게 하면…안되니까☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/expedition.ogg"},"실망":{"voiceline":"바~~~~보!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/feeling1.ogg"},"낯섦":{"voiceline":"혹시 날 화나게 하면 어떤 일이 벌어지느냐고? \"지휘관의 흑역사 대공개~!!\" 이런 게 꽤 괜찮을지도~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/feeling2.ogg"},"호감":{"voiceline":"너무 헤엄쳐서 어깨가 좀 뭉쳤네……맞다! 누가 좀 마사지로 풀어주면 혹시 나, 그 누군가의 '남들에게 걸려선 안 되는 일' 을 깨~끗이 잊어줄지도……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관을 골리기만 하는 것도 미안하니까, 오늘은 내가 마사지 해줄게! 후~! 있잖아, 지금 귀에 느낌 어땠어? 너무 쉽게 믿어버린 지휘관이 순진한 거라고~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/feeling4.ogg"},"사랑":{"voiceline":"아, 저기……혹시 나, 전장에서 돌아오지 못하면, 지휘관……아하하하! 그런 일이 생길 리 없잖아~! 자! 받아랏! 간질간질 공격이닷~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 와~! ……서류가 산처럼 쌓여 피라미드가 되었다고? 글쎄, 바람이 불어와서 그런 거 아닐까~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/home.ogg"},"hp 경고":{"voiceline":"에에? 왠지 나, 주목받고 있지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 왔어? 좋아, 오늘도 신나게 장난…이 아니지, 열심히 일할게~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/login.ogg"},"실패":{"voiceline":"도망치는 거야~~!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/lose.ogg"},"우편":{"voiceline":"우편~! 부탁 한 번 들어주면 줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/mail.ogg"},"임무":{"voiceline":"어깨를 주물러주면, 땡땡이친 건 비밀로 해줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/mission.ogg"},"임무완료":{"voiceline":"보너스 GET! 저기저기, 내 거는?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/mission_complete.ogg"},"서약":{"voiceline":"반지는 받아둘게. 다른 일 없으면 이제 갈게……어라? 지휘관은 안 붙잡아? 지, 진짜 어디론가 가버린다? ……알았어 알았어, 내가 졌어! 왜냐면 나 지휘관이랑 이제 못 떨어져 있겠는걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/propose.ogg"},"스킬":{"voiceline":"서프라이즈~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/skill.ogg"},"터치1":{"voiceline":"아! 드디어 잠수함한테도 지휘관의 마수가??!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/touch.ogg"},"터치2":{"voiceline":"지금 혹시, 내가 \"도와주세요!!\" 하고 큰소리로 외치면~ 지휘관은……어떻게 되려나? 후후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/touch2.ogg"},"입수시":{"voiceline":"짜잔~! 이글 유니온의 알바코어야~! 아, 갑자기 튀어나와서 깜짝 놀랐어? 그건 쏘리~ 오늘부터 이 함대의 일원이 될 테니, 잘 부탁해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/unlock.ogg"},"강화성공":{"voiceline":"오오, 좋은 느낌!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"하하~앙, 쉽네 쉬워~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":108021,"클뜯 함순이 id":10802,"함순이 이름":"알바코어","한글 함순이 + 스킨 이름":"블랙 드레스 아래의「비밀」","영문 함순이 + 스킨 이름":"Beneath the Black Dress","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108021/shipyard.png","설명":"앗, 이런, 땅에 떨어뜨리다니! 얼른 주워야지...... 지휘관? 너, 설마 본 거야? 그럼 지금부터 넌 알바코어의 공범이야!","자기소개":null,"메인1":{"voiceline":"지휘관, 다이호 봤어? 내가 준비한 서프라이즈를 보여주고 싶은데!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108021/main1.ogg"},"메인2":{"voiceline":"지금의 나와 평소의 나 중에 어떤 쪽이 좋아? 이유는? 에이, 부끄러워 하지 말고 말해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108021/main2.ogg"},"메인3":{"voiceline":"지휘관, 여기! 우리는 공범이니까 같이 다녀야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108021/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"모두에게 폭죽을 조심하라고 알려준다고? 흥흥, 그래~ 그런데 폭죽은 전부 내 드레스 아래에 숨겨뒀는데 어떻게 안 걸까~ …지휘관, 내 말 뜻을 알겠어? 히히~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108021/detail.ogg"},"드랍 설명":{"voiceline":"앗, 이런, 땅에 떨어뜨리다니! 얼른 주워야지...... 지휘관? 너, 설마 본 거야? 그럼 지금부터 넌 알바코어의 공범이야!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지, 지휘관! 내 공범이 되어줘서 고마워! 맞아, 귀 좀 대봐. 할 말이 있어! 좀 더 가까이! 저기, 그러니까… 츄~ 히히, 또 속았지롱~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108021/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"몰래 카발라의 음료수를 술로 바꾸면—— 우으, 지휘관에게 들키다니. 알게 모르게 '어른의 맛'을 느껴보게 해주고 싶었던 것뿐이야~","voicelink":"https://raw.githubusercontent.co