[{"클뜯 id":201130,"클뜯 함순이 id":20113,"함순이 이름":"그렌빌","한글 함순이 + 스킨 이름":"그렌빌","영문 함순이 + 스킨 이름":"Grenville","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201130/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201130/shipyard.png","설명":"G급 구축함—그렌빌, 현호 H03 ","자기소개":{"voiceline":"나는 로열의 G급 구축함 그렌빌. 향도 구축함이야. 구축함대의 기함을 맡기도 했었다고! 복무 기간이 짧아 별다른 전적을 세우지 못한 것이 가장 아쉬운 점이지. 그리고 확실히 해두고 싶은 건, 나는 수뢰가 싫어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/profile.ogg"},"메인1":{"voiceline":"히히. 지휘관! 나랑 같이 ‘예절’에 대해 배워보자고~ 예를 들면… 이렇게 우~아하게 레이디의 손을 잡는 법이라던가 말이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/main1.ogg"},"메인2":{"voiceline":"향도 구축함으로서 믿을만한 전력이 되어야하는 것은 당연한 일이지. 음~음~ 나도 열심히 노력할거라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/main2.ogg"},"메인3":{"voiceline":"실적이 없는 건 무섭지 않아! 중요한 것은 미래에 닥쳐올 도전을 어떻게 견디냐는 거지…… 헤헤, 큰소리를 치는 것 같네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/main3.ogg"},"전투개시":{"voiceline":"상대에게 우리의 강함을 보여주자고~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/battle.ogg"},"상세확인":{"voiceline":"지휘관, 후드 씨에게 배운 대로 홍차를 한 잔 내려봤어~ 마셔볼래? …… 엑? 너무 달다고? 아하하하. 꿀 한 스푼은 너무 많았던 건가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/detail.ogg"},"드랍 설명":{"voiceline":"G급 구축함—그렌빌, 현호 H03","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어! 같이 놀고 싶은데…… 아, 잘못 들은 거야~ 그러니까, 같이 출항하고 싶다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/expedition.ogg"},"실망":{"voiceline":"지휘관이 정신 차리지 않으면 나도 이제 신경 안 쓸거라고~ 하하, 장난이야! 하지만 실망하게 하지 말아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/feeling1.ogg"},"낯섦":{"voiceline":"모항에는 개성이 뚜렷한 녀석들이 많은 것 같네~ 지휘관, 기회가 되면 소개해주지 않을래? 많은 사람들과 알아가고 싶어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/feeling2.ogg"},"호감":{"voiceline":"배워야 할 것이 아직 너무 많아. 그리고 지휘관이 곁에 있으면 힘이 나!~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/feeling3.ogg"},"기쁨":{"voiceline":"로열의 레이디가 음식으로 지휘관의 위장을 사로잡는 것은 당연한 일! 지휘관, 내가 만든 로열 요리 한번 먹어볼래? 헤헤, 생선 머리가 완전 새까맣게 타버리긴 했지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/feeling4.ogg"},"사랑":{"voiceline":"지휘관… 좋아해!! 에헤헤… 에? 여자아이가 직접 말하는 건 신선한 일이라고? 으… 그렇게 쳐다보지 마. 아무리 지휘관이라도 약간… 에? 한 번 더 듣고 싶다고? 정말? 히히, 좋아해! 정말 좋아해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 돌아왔으니까 얼른 내 훈련의 성과를 한번 보라고— 아… 미안, 미안. 출격했다 돌아왔으니 분명 힘들겠지? 자, 주스 한 잔 마시고 얼른 기운차려! (머리를 쓰담쓰담)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/home.ogg"},"hp 경고":{"voiceline":"얕보지 마라, 난 향도구축함이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 돌아왔구나! 푹 쉬었어? 그렇다면 빨리 오늘의 일을 시작하자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/login.ogg"},"실패":{"voiceline":"윽… 내 능력이 부족한 건가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/lose.ogg"},"우편":{"voiceline":"우편이 왔어~ 히히, 내가 열어봐 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/mail.ogg"},"임무":{"voiceline":"임무가 아직 많아. 지휘관도 게으름 피우지 말라고~ 힘내. 같이 끝내보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/mission.ogg"},"임무완료":{"voiceline":"얼른 임무 보상을 받으러 가자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/mission_complete.ogg"},"서약":{"voiceline":"처음에는 지휘관의 믿음직스러운 조수가 되고 싶었을 뿐인데, 이렇게 지휘관이 끼워주는 반지를 받게 된다니…… 지휘관, 예절이나 우아함은 잠시 내려놓고 그냥 꼭 안아줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/propose.ogg"},"스킬":{"voiceline":"곧 나의 대단함을 알게 될걸! 두고 보라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/skill.ogg"},"터치1":{"voiceline":"나도 후드 씨 같은 레이디가 될 수 있으면 좋을 텐데 말이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/touch.ogg"},"터치2":{"voiceline":"우와…… 나 화낼 거야! 지휘관, 조금 더 신사답게 행동하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/touch2.ogg"},"입수시":{"voiceline":"YAHO! 안녕, 지휘관~ G급 구축함 그렌빌, 착임! 이제 내가 있으니 안심하고 푹 자라고. 하하, 장난이야~ 사이좋게 지내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/unlock.ogg"},"강화성공":{"voiceline":"이렇다면 더 자주 출진할 수 있겠지~ 히히. 고마워, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"구축함으로서 이건 당연한 일이라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201130/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['글로우웜'] : 응응! 이렇게 밀고 들어가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/2