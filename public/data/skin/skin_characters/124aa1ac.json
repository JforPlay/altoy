oiceline":"슬슬 본 게임이네. 네가 새로운 영광을 손에 넣든, 좌절을 맛보든… 난 여기서 네 다음 출발을 기다리고 있을게.","voicelink":null},"터치3":null,"모항귀환":{"voiceline":"랩 타임이 점점 좋아지고 있네. 나도 더 빨리 움직여야겠어.","voicelink":null},"hp 경고":null,"로그인":{"voiceline":"지휘관, 차량은 여기 세워. 다음 타이어 준비도 끝났으니, 교체는 내가 도와줄게.","voicelink":null},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"걱정하지 마. 그저 타이어를 나르는 것뿐이니까. 잘할 수 있어.","voicelink":null},"터치2":{"voiceline":"적어도 트레이닝이 끝난 다음에……","voicelink":null},"입수시":{"voiceline":"지휘관, 신기록 세운 거 축하해. ……이 영광만으로 내가 기다린 시간을 충분히 보상받은 기분이야. 차량 점검은 안심하고 나한테 맡겨.","voicelink":null},"강화성공":null,"vote":null,"승리":{"voiceline":"후후, 이 영광은 모든 힘을 쏟아낸 지휘관의 것… 나는 그저 해야 할 일을 한 것뿐이지.","voicelink":null},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"극속광열","상점 id":0,"상점 카테고리 id":14,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":0}]