[{"클뜯 id":405020,"클뜯 함순이 id":40502,"함순이 이름":"티르피츠","한글 함순이 + 스킨 이름":"티르피츠","영문 함순이 + 스킨 이름":"Tirpitz","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405020/shipyard.png","설명":"비스마르크급 전함 - 티르피츠","자기소개":{"voiceline":"조금 덥군……아아, 미안, 나는 티르피츠. 북쪽에서 혼자 오랫동안 대기했던 탓인지, 언제부턴가 '고독한 북유럽의 여왕' 이라 불리게 되었지만……좋은 별명이라 생각하진 말아줘……이 이름에는 허무함 밖에 없으니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/profile.ogg"},"메인1":{"voiceline":"언니……그러고 보니, 확실히 언니가…하아, 하마터면 잊어버릴 뻔했어","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/main1.ogg"},"메인2":{"voiceline":"안전한 장소에서 전장을 바라본다, '잔혹' 하단 말밖에 안 나오는 이 감촉, 이해할 수 있나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/main2.ogg"},"메인3":{"voiceline":"전략적인 목적인가……포탑을 장비했는데, 그게 탄약을 쏘기 위해 있는 건 아니다…아이러니하지 않은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/main3.ogg"},"전투개시":{"voiceline":"지휘관, 당신을 위해 싸우겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/battle.ogg"},"상세확인":{"voiceline":"적의 선택은 신중하게 하도록, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/detail.ogg"},"드랍 설명":{"voiceline":"비스마르크급 전함 - 티르피츠","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰가 완료된 것 같네만……다음은 나도 가게 해주지 않겠나? 조금……호기심이 생겨서 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/expedition.ogg"},"실망":{"voiceline":"결국……당신도 날 따르게 할 수 없는 무능한 지휘관인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/feeling1.ogg"},"낯섦":{"voiceline":"북쪽의 추위와 외로움에는 익숙해졌을 터. 이제 와서 기대 따윈 하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/feeling2.ogg"},"호감":{"voiceline":"가지지 못한 자야말로 아무것도 두려운 게 없는 법……허나 이런 용기가 정말로 자랑스러운 일인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/feeling3.ogg"},"기쁨":{"voiceline":"가장 기분이 나쁘다고 생각했던 건, 기다려야 할지 포기해야 할지 모르겠던 시간이다. 지휘관, 당신에겐 기다릴 가치가 있는 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/feeling4.ogg"},"사랑":{"voiceline":"……아, 그렇군. 추위에 익숙해져 고독을 즐기게 된 줄 알았는데, 사람과 교류하는 즐거움과 내 곁에 사람이 있을 때의 따뜻함을 잊어버리고 있던 것뿐이었나. ……하지만 지금, 그걸 다시 떠올렸어…… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 전장에는 자주 얼굴을 비치는 게 좋아. 후방 근무를 오래 하다 보면 생명의 무게를 어느샌가 잊어버리게 되니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/home.ogg"},"hp 경고":{"voiceline":"자멸하는 것을 지킬 수 있는 사람은 없어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/hp_warning.ogg"},"로그인":{"voiceline":"기다리는 것에 익숙해지면, 기다리던 것의 가치가 사라져버리지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/login.ogg"},"실패":{"voiceline":"이건……실패와 공포에 대한 분함인가……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/lose.ogg"},"우편":{"voiceline":"당신에게 온 편지……후우…부럽군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/mail.ogg"},"임무":{"voiceline":"임무를 제대로 처리하자……임무가 있는 것만으로 얼마나 행복한 건지, 언젠간 그런 생각을 하게 되겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405020/mission.ogg