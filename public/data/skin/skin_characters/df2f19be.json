[{"클뜯 id":303040,"클뜯 함순이 id":30304,"함순이 이름":"키누가사","한글 함순이 + 스킨 이름":"키누가사","영문 함순이 + 스킨 이름":"Kinugasa","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303040/shipyard.png","설명":"아오바형 중순양함 2번함·키누가사","자기소개":{"voiceline":"안녕하세요, 저는 키누가사라고 해요. 예전엔 아오바 언니와 함께 제6 전대에 배속되어 있었습니다. 웨이크섬부터 산호해, 솔로몬에 이르기까지의 여러 전투에 참여했고, 마지막엔 언니에 비해선 살짝 운이 없었지만… 어쨌든, 지휘관은 언니처럼 일에 너무 열중해서 건강을 망가뜨리거나 하면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/profile.ogg"},"메인1":{"voiceline":"지휘관, 제대로 쉬고 있나요? 건강이 제일이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/main1.ogg"},"메인2":{"voiceline":"언니는 제대로 쉬고 있으려나… 하아… 지휘관도, 언니처럼 건강을 소홀히 해서는 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/main2.ogg"},"메인3":{"voiceline":"일할 때는 일하고, 쉴 때는 쉬어야만, 행복한 생활을 할 수 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/main3.ogg"},"전투개시":{"voiceline":"모두, 방비에 주의하세요! 혼자 따로 날뛰지 않도록 하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/battle.ogg"},"상세확인":{"voiceline":"건강이 제일이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/detail.ogg"},"드랍 설명":{"voiceline":"아오바형 중순양함 2번함·키누가사","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 직접 찾아가 주지 못하더라도, 열심히 하는 모두를 격려하고 위로하는 걸 잊지 말아 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/expedition.ogg"},"실망":{"voiceline":"이젠 아무래도 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 방 정리는 제대로 하셨나요? 문단속은요? 잊은 물건은 없으시겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/feeling2.ogg"},"호감":{"voiceline":"언니는 언제나 저런 식이지만, 그때의 일을 계속 신경 쓰고선, 아직도 미안하다고 생각하고 있는 거랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/feeling3.ogg"},"기쁨":{"voiceline":"과한 설교는 오히려 좋지 않다고 생각하고 있습니다만, 언니에겐 늘 하던 거라 그만… 게다가 지휘관도 저를 말려주지 않으시니… 네? 오히려 그게 좋다, 고요? 그럼… 사양하지 않을 거예요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/feeling4.ogg"},"사랑":{"voiceline":"언니는 가끔 제 설교를 싫어하곤 합니다만, 제게 있어서는 좋아하는 언니니까, 미움받은 정도로는 설교를 멈추지 않을 거예요. 지휘관도 마찬가지랍니다. 제게 있어 소중한 사람이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 과로를 조심하세요. 우선 조금 쉬도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/home.ogg"},"hp 경고":{"voiceline":"당황하지 마세요! 우선 대열을 바로 잡으세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/hp_warning.ogg"},"로그인":{"voiceline":"다녀오셨어요, 지휘관. 오늘의 영양은 제대로 섭취하셨나요? 부족하다면 제가 뭔가 만들어 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/login.ogg"},"실패":{"voiceline":"좀 있다가 반성회를 해야겠군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/lose.ogg"},"우편":{"voiceline":"지휘관, 우편 체크는 부지런히 하시라고 말씀드렸을 텐데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/mail.ogg"},"임무":{"voiceline":"지휘관, 일을 미뤄두기만 한다면 나중에 산더미처럼 쌓여버린답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/mission.ogg"},"임무완료":{"voiceline":"지휘관, 보상은 그냥 두기만 하면 늘어나거나 하지 않는다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/mission_complete.ogg"},"서약":{"voiceline":"정말이지 지휘관도 참, 이런 중요한 때에 소매도 옷깃도 제대로 정리하지 않으셨다니. 자, 나중에 제대로 설교할 테니까, 우선 식장 쪽으로 가도록 해요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/propose.ogg"},"스킬":{"voiceline":"규칙은 지키라고 있는 거예요!","voicelink":null},"터치1":{"voiceline":"지휘관, 간단한 체조라도 해서, 긴장을 풀고 여유를 가져보시는 건 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/touch.ogg"},"터치2":{"voiceline":"…지휘관, 여기 앉으세요. 지금부터 함대의 기강이란 무엇인가에 관해서 설명해드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/touch2.ogg"},"입수시":{"voiceline":"처음 뵙겠습니다, 키누가사라고 해요. 지휘관, 세 끼 식사와 수면은 제대로 하고 계신가요? 제 언니처럼 깔끔하지 못해선 안되니까요… 그러고 보니, 제 언니도 여기 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 낭비는 안 된답니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"여러분, 이겼다고 해도 들떠선 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아오바'] : 언니, 촐싹거리지 마세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303040/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 