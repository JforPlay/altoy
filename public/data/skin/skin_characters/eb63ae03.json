[{"클뜯 id":9705020,"클뜯 함순이 id":970502,"함순이 이름":"야마시로·META","한글 함순이 + 스킨 이름":"야마시로·META","영문 함순이 + 스킨 이름":"Yamashiro META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705020/shipyard.png","설명":"나리가 함대의 지휘관이신가요? 으음, 박력은 있지만, 아직 조금 부족한 것 같네요. 나리께 어떤 훈련을 시켜볼까……. 어쨌든 많은 기대 부탁드려요!","자기소개":{"voiceline":"후소급 전함 중 동생인 야마시로입니다. 훈련에 관해서는 야마시로 나름의 철학이 있답니다~ 나리, 후후훗, 궁금하세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/profile.ogg"},"메인1":{"voiceline":"나리, 업무 중에 주의가 흐트러지면 안 돼요. 야마시로가 새로운 서류를 가지고 왔어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/main1.ogg"},"메인2":{"voiceline":"모항 생활은 지나치게 편해요…. 이래선 훌륭한 병사를 육성할 수 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/main2.ogg"},"메인3":{"voiceline":"으아아! 꽃병이! …휴우, 아슬아슬했어요…. 평소 훈련을 해둔 덕분에 이런 사고에도 대응할 수 있게 됐네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/main3.ogg"},"전투개시":{"voiceline":"훈련 성과를 보여줄 때가 왔어요~ 후후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/battle.ogg"},"상세확인":{"voiceline":"나리께선 한가하신 것 같네요~ 설마, 평소 훈련 난이도가 너무 낮아서 그런 건가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/detail.ogg"},"드랍 설명":{"voiceline":"야마시로호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 나가는 것도 좋은 훈련이 되겠네요. 나리, 나리, 다들 참여할 수 있도록 배려해주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/expedition.ogg"},"실망":{"voiceline":"나리, 거기 계신 거 다 알아요~ 몰래 숨어 계시지 말고, 얌전히 나와서 잘못을 인정하세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/feeling1.ogg"},"낯섦":{"voiceline":"나리, 함대를 더 강하게 만들고 싶다구요? 후훗, 야마시로에게 맡겨주세요! 방법은 이미 알고 있답니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/feeling2.ogg"},"호감":{"voiceline":"으음, 어째서 항상 도중에 낙오하는 아이가 생기는 걸까요…. 또 나리는 왜 항상 그런 아이들 편을 드시는 거죠? 이래선 다들 강해지질 못하잖아요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/feeling3.ogg"},"기쁨":{"voiceline":"야마시로가 그 아이들에게 너무 엄하게 대하긴 했죠…. 뭐, 나리의 마음은 이제 잘 알았어요. 그러니 안심하세요. 그 아이들은 몰라도, 나리께는 이제까지 해온 것처럼 엄격하게 갈 거니까요~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/feeling4.ogg"},"사랑":{"voiceline":"그렇게나 엄격한 훈련을 버텨내시다니, 나리는 훌륭해요! 어쩌면 야마시로… 나리와 함께라면 평소의 불운도… 아, 아무 말도 안 했어요! 이 다음 엄격한 훈련도 집중해서 잘 버텨주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"훈련♪ 훈련♪ 오늘은 나리께 어떤 훈련을 시켜볼까~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/home.ogg"},"hp 경고":{"voiceline":"성가신 불운이네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/hp_warning.ogg"},"로그인":{"voiceline":"서류와 드실 차 모두 준비해뒀어요. 자, 나리. 바쁜 하루를 시작해볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/login.ogg"},"실패":{"voiceline":"어디 문제가 있는 걸까요…. 설마, 누가 게으름을…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/lose.ogg"},"우편":{"voiceline":"나리, 시간 괜찮으시면 우편 좀 받아주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/mail.ogg"},"임무":{"voiceline":"새로운 임무예요. 나리라면 능숙하게 처리하실 수 있으실 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/mission.ogg"},"임무완료":{"voiceline":"임무 완료하셨나요? 그럼 차를 마시면서 쉬도록 하죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/mission_complete.ogg"},"서약":{"voiceline":"이건… 나리께서 절 인정해주신다는 증표인가요? 야마시로, 너무 기뻐요! 앞으로는 업무든 뭐든, 더욱더 많이 맡겨주세요! 반드시 나리의 힘이 되고 말 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/propose.ogg"},"스킬":{"voiceline":"죽는소리 하기는 일러요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/skill.ogg"},"터치1":{"voiceline":"강해지고 싶은 아이 없나요? 야마시로에게 맡기면 안심이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/touch.ogg"},"터치2":{"voiceline":"나리? 아무런 양해 없이 만지면 벌 받아요. 그것도 아주 엄한 벌.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/touch2.ogg"},"입수시":{"voiceline":"나리가 함대의 지휘관이신가요? 으음, 박력은 있지만, 아직 조금 부족한 것 같네요. 나리께 어떤 훈련을 시켜볼까……. 어쨌든 많은 기대 부탁드려요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/unlock.ogg"},"강화성공":{"voiceline":"이 정도 강화로는 아직 부족하겠죠….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"평소에 해둔 피나는 훈련 덕분에 이렇게 쉽게 승리를 거둔 거예요. 그렇죠, 나리?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":