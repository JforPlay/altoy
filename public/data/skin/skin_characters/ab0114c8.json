[{"클뜯 id":701040,"클뜯 함순이 id":70104,"함순이 이름":"타슈켄트","한글 함순이 + 스킨 이름":"타슈켄트","영문 함순이 + 스킨 이름":"Tashkent","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701040/shipyard.png","설명":"타슈켄트급 구축함—타슈켄트 ","자기소개":{"voiceline":"타슈켄트는 노스 유니온의 향도 구축함이야. 동형함은 3… 아니… 사르데냐 제국에서 태어난데다 이런 설계 때문에 나를 하늘색 순양함이라고 부르곤 해. 분명 구축함인데… 됐어, 타슈켄트도 그 이름이 싫지는 않아. 세바스토폴 전투에서처럼 열심히 할테니 동지쨩도 기대해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/profile.ogg"},"메인1":{"voiceline":"타슈켄트는 사르데냐에서 만들어졌어. 그러니 사르데냐의 요리는 익숙해. 그런데 말이야, 노스 유니온의 입맛에 맞는지 안 맞는지는 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/main1.ogg"},"메인2":{"voiceline":"모항은 왜 이렇게 더운거야… 동지쨩, 어서 에어컨을 켜줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/main2.ogg"},"메인3":{"voiceline":"이상하네. 분명 타슈켄트는 모두에게 상냥하게 대하지 않았는데, 왜 이렇게 나를 좋아하는 거지? 동지쨩, 왜 그러는 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/main3.ogg"},"전투개시":{"voiceline":"타슈켄트가 코를 납작하게 만들어 주겠어! Ура!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/battle.ogg"},"상세확인":{"voiceline":"동지쨩도 타슈켄트가 연습하는 걸 보러온 거야? 아 그래? 그래서 볼 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/detail.ogg"},"드랍 설명":{"voiceline":"타슈켄트급 구축함—타슈켄트","voicelink":null},"의뢰 완료":{"voiceline":"이봐, 의뢰를 잊은 건 아니지? 바보같네. 역시 타슈켄트는 기억력이 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/expedition.ogg"},"실망":{"voiceline":"타슈켄트에게 다가오지 마. 이 바보!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/feeling1.ogg"},"낯섦":{"voiceline":"동지쨩, 타슈켄트에게 볼 일이 있어? 타슈켄트는 바쁘니까 별 일 없다면… 아 그래? 사실 타슈켄트와 놀고 싶어서 온 거구나? 응. 마침 마무리를 지었으니 조금 같이 놀아주도록 할까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/feeling2.ogg"},"호감":{"voiceline":"하늘색 순양함이라는 말만 듣고 타슈켄트를 귀엽고 말 잘듣는 아이라고 생각한 사람들은 실망하곤 했어… 곤란한 건 타슈켄트라고. 안 그래? 동지쨩?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/feeling3.ogg"},"기쁨":{"voiceline":"타슈켄트는 평범한 구축함일 뿐이야. 특별한 대답을 바라는 건 아니야. 지금으로도 충분해. 동지쨩도 이렇게… 응. 이걸로 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/feeling4.ogg"},"사랑":{"voiceline":"모항의 모든 동료들과 만나본 것은 아니지만, 타슈켄트는 여기가 좋아졌어. 모두가 타슈켄트의 본모습을 알고 나더라도 타슈켄트와 친구가 되어 줄까? … 동지쨩도 당연히… 좋아해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"다녀왔어? ……차? 보드카 밖에 없는데 필요해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/home.ogg"},"hp 경고":{"voiceline":"타슈켄트는 지지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/hp_warning.ogg"},"로그인":{"voiceline":"타슈켄트를 보면 즐거워? …… 아 그래? 마음대로 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/login.ogg"},"실패":{"voiceline":"이잇…! 타슈켄트는 아직 더 싸울 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/lose.ogg"},"우편":{"voiceline":"편지가 왔어. 타슈켄트가 오는 길에 가져왔으니 고마워 하지 않아도 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/mail.ogg"},"임무":{"voiceline":"임무? 재미있는 게 있어","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/mission.ogg"},"임무완료":{"voiceline":"임무 보상? 타슈켄트도 볼래… 아 그래? 그래서? 맛있는 건 없는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/mission_complete.ogg"},"서약":{"voiceline":"뭐야, 중요한 일이 이거였어? 아 그래? 좋아. 받아줄게…… 에? 타슈켄트가 지휘관을 좋아한다고 말하지 않았어? 그러니까 지휘관과 서약을 맺는 건 당연한 일이잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/propose.ogg"},"스킬":{"voiceline":"타슈켄트의 실력을 보여주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/skill.ogg"},"터치1":{"voiceline":"어라? 타슈켄트에게 부탁할 일이라도? 아 그래? 처리해 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/touch.ogg"},"터치2":{"voiceline":"……어라? 뭐 하는 거야? 타슈켄트의 옷에 달린 공을 가지고 노는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/touch2.ogg"},"입수시":{"voiceline":"타슈켄트야. 모두 나를 '하늘색 순양함'이라고 불러. 동지쨩도 타슈켄트를 자기 편으로 만들고 싶은 건가… 아 그래? 정말 어쩔 수 없네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/unlock.ogg"},"강화성공":{"voiceline":"타슈켄트에게 싸우라고 하는 거구나. 아 그래? 그럼 해볼까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"Ура! 타슈켄트의 위력을 알았겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['콘고'] : 타슈켄트는 너처럼 사르데냐 요리를 먹을 동료가 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701040/couple_encourage1.ogg"},{"voiceline":"['르 말랭', '르 트리옹팡'] : 타슈켄트가 진지해지면 절대 지지 않아!","voicelin