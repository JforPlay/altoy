[{"클뜯 id":9600040,"클뜯 함순이 id":960004,"함순이 이름":"메리 셀러스트","한글 함순이 + 스킨 이름":"메리 셀러스트","영문 함순이 + 스킨 이름":"Mary Celeste","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600040/shipyard.png","설명":"범선 - 메리 셀러스트","자기소개":{"voiceline":"나는 메리 셀러스트, 폭풍 속에서 태어난 바다 위의 유령이지. 흠… 나를 둘러싼 전설 따윈…… '사람의 눈으로는 볼 수 없는' 진실 중 하나에 지나지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/profile.ogg"},"메인1":{"voiceline":"유령선인 내 곁에 있으려면 옷을 조금 더 두껍게 입는 편이 좋아, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/main1.ogg"},"메인2":{"voiceline":"헉?! 부, 불길이?! …그냥 바비큐라고?! 음…… 지휘관, 자, 잠깐만 사라질게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/main2.ogg"},"메인3":{"voiceline":"내가 사람들을 잘 챙긴다는 평이 있다고? 글쎄… 혼자 보낸 세월이 너무 길어서 그 반동으로 다른 사람 말을 잘 들어주게 된 것뿐일지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/main3.ogg"},"전투개시":{"voiceline":"유령에게 도망칠 수는 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/battle.ogg"},"상세확인":{"voiceline":"고민이 있으면 뭐든 털어놔. 따뜻한 온기는 줄 수 없지만, 같이 있어 주는 것 정도는 할 수 있으니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 메리 셀러스트","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰에서 돌아온 동료들을 깜짝 놀라게 해주자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/expedition.ogg"},"실망":{"voiceline":"지휘관…… 외로운 건가? 걱정 마, 내가 곁에 있어 줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/feeling1.ogg"},"낯섦":{"voiceline":"나는 어둠에서 나타나…… 꺄아악?! 나, 난로에 장작 그만 넣으라고……! 크, 크흠! ……지, 지휘관. 그… 방금 넌 아무것도 못 본 거다… 알았지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/feeling2.ogg"},"호감":{"voiceline":"늘 유령처럼 모습을 숨기지 말고 정정당당하게 앉아 있으면 된다고? 음, 그건 꽤 어려운 주문인데…… 응? 지금 집무실에서 바로 해보라고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/feeling3.ogg"},"기쁨":{"voiceline":"왠지 지휘관 옆에 이렇게 서 있지 않는 편이 오히려 더 어색하네…… 응? 꾸미는 데에도 신경을 쓰는 것 같다고? 고, 고마워……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 비밀 하나 알려줄게. 실은 유령선에게도 나름 돌아갈 곳이 있는데…… 어디냐고? (포옹) 이, 이제 알았으려나……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/feeling5.ogg"},"터치3":{"voiceline":"뿔이 신경 쓰이는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔군! 수고 많았어, 지휘관! 우선은 서늘한 포옹을 해줄게! ……계속 기다린 것 같다고? 후후, 지휘관을 계속 지켜보고 있었으니까 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/home.ogg"},"hp 경고":{"voiceline":"부, 불길은 어디냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/hp_warning.ogg"},"로그인":{"voiceline":"아! 돌아왔군, 지휘관! 뭘 해줄까? 따끈한 차나 커피라도 내릴까? 아니면…… 유령의 포옹이라는 거라도 해줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/login.ogg"},"실패":{"voiceline":"괜찮아. 적은 우릴 추격할 수 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/lose.ogg"},"우편":{"voiceline":"새로운 우편이 자기 혼자 집무실로 날아간다면 지휘관은 어떨 것 같아? ……어린 함선들이 놀랄 거라고? 하긴 그렇겠지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/mail.ogg"},"임무":{"voiceline":"음~ 무언가 부탁받은 게 오랜만이라 그런지 이 소중히 여겨지는 느낌이 그리워지네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/mission.ogg"},"임무완료":{"voiceline":"임무 완료. 자, 그럼 쓰담쓰담 상을 내려줄게! 착하다, 착해~ ……하핫, 이 서늘한 느낌… 나쁘지 않지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/mission_complete.ogg"},"서약":{"voiceline":"내게 이걸 주다니… 이건 평생 함께해달라는 의미라고. …하하하, 기꺼이 함께하지. 자, 오늘부터 지휘관은 이 메리 셀러스트와 함께 앞으로 나아가는 자야. 네 품 안은 내가 계속 온기를 얻을 수 있는 '돌아갈 곳'……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/propose.ogg"},"스킬":{"voiceline":"메리는… 네 녀석 뒤에 있다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/skill.ogg"},"터치1":{"voiceline":"응? 동상에 걸리지 않도록 조심해라, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/touch.ogg"},"터치2":{"voiceline":"하하핫, 지휘관 손은 참 따뜻하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/touch2.ogg"},"입수시":{"voiceline":"흠, 네가 지휘관인가? 나는 메리 셀러스트, 전설적인 유령선 그 자체지. 그리고 이 아이는 아르고노트… 아르고다. 무서워할 거 없어. 나처럼 이 떠들썩한 세상을 좋아하는 것뿐이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/unlock.ogg"},"강화성공":{"voiceline":"후후, 어둠 속에서 사람들을 더 지켜줄 수 있겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"으하하하! 또 목격자 없는 승리로군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/win_mvp.ogg"},"전투개시_ex":{"voiceline":"폭풍 속에서 사라져라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/battle_ex.ogg"},"상세확인_ex":{"voiceline":"유령선처럼 모습을 감추는 방법을 알려달라고? ……그건 어렵겠군. 지휘관이 할 수 있을지 어떨지는 몰라도, 모습이 안 보이면 곁에 있어줄 수 없잖아. 흥.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"지휘관이 앞에서 주의를 끄는 동안 내가 뒤에서 갑자기 나타나서 놀라게 한다…… 좋아! 이걸로 결정이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/expedition_ex.ogg"},"사랑_ex":{"voiceline":"쉿. 여긴 너랑 나밖에 없긴 하지만, 다른 애들에게 들키면 큰일이잖아? 여차할 때 난 모습을 숨길 수 있지만, 지휘관은 그럴 수도 없고…… 그러니 목소리를 최대한 낮춰. 나도 참을 테니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"뿔 모양이 귀엽다…고? 그, 그걸 눈치채다니… 이거 좀 부끄러운데…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"방금 전투로 몸이 뜨거워졌다고? 아하하, 이럴 땐 내가 나서야지. 자, 내 품 안에서 얼굴을 식히도록 해♪ 꽈악~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"돌아왔군. 자, 우선은 이걸 마셔서 몸을 따뜻하게 하고, 몸에 잠깐 실례를…… 너무 뜨거워서 화상 입을 것 같네, 아하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"좋아, 임무 지원은 내게 맡겨! 지휘관, 언제 시작할 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"이렇게 지휘관의 온도를 느끼는 것도…… 나쁘지 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/touch_ex.ogg"},"터치2_ex":{"voiceline":"이걸로 지휘관이 시원함을 느낄 수 있다면…… 잠깐, 앗…? …아앗…? ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"기억해 둬. 메리는 언제나 네 곁에 있다는 사실을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['뱀파이어'] :  꽤 하는군, 뱀파이어! 우리 해적단에 들어오는 게 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/couple_encourage1.ogg"},{"voiceline":"['요크'] :  내 힘 <† 포스†>를 빌리고 싶다고? 잘은 모르겠지만 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/couple_encourage2.ogg"},{"voiceline":"['롱 아일랜드'] :  하하핫, 우리는 유령함대다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"좀 신나게 놀아볼까? 음… 노래하거나, 해변에서 놀거나… 그리고… 바비큐 파티를 한다던가…? 정말, 놀리지 말라고…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/main5_ex.ogg"},"메인6_ex":{"voiceline":"후후, 지휘관. 내가 누군가에게 보살핌을 받다니, 참 신선하네. 서로 의지하고 있는 이 느낌… 앞으로 분명 외로움은 느끼지 않겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"옆에 있을 때 느껴지는 온도가 올라간 거 같다고? 하하하, 아마 착각은 아닐 거야…… 네 곁에 있으면 나도 부끄러워서 몸이 달아오른다…고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600040/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"MOT","레어도":"SSR","ex_chat_status":1},{"클뜯 id":9600041,"클뜯 함순이 id":960004,"함순이 이름":"메리 셀러스트","한글 함순이 + 스킨 이름":"그림 나이트 리퍼","영문 함순이 + 스킨 이름":"Grim Night's Reaper","스킨 타입":"Halloween","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600041/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600041/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600041/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main