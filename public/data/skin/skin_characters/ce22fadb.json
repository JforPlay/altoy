[{"클뜯 id":305140,"클뜯 함순이 id":30514,"함순이 이름":"스루가","한글 함순이 + 스킨 이름":"스루가","영문 함순이 + 스킨 이름":"Suruga","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305140/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305140/shipyard.png","설명":"키이급 전함—스루가 ","자기소개":{"voiceline":"키이급 전함의 3번함, 스루가 입니다. 세계 대전 시기에 건조되지는 않… 아니, 아닙니다. 함대의 동료들과 어깨를 나란히 하고 싸울 수 있는 것도 일종의 인연이겠지요. 이곳에 착임했으니 최선을 다하겠습니다. 잘 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/profile.ogg"},"메인1":{"voiceline":"자료를 분석하거나 계획을 세우는 것이 저에게 더 알맞은 것 같습니다. 속독과 암기는 자신 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main1.ogg"},"메인2":{"voiceline":"물불 안 가리고 돌진하는 타입과는 맞지 않습니다. 실제로 꽤 고통스러운 경험도 있었죠… 하지만 이런 성격을 싫어하는 것은 아닙니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main2.ogg"},"메인3":{"voiceline":"비서함으로 삼아주셔서 감사드립니다. 하지만 역시 저 혼자로는 부족할지도 모르니, 다른 동료들이 도와주었으면 하는 바람입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main3.ogg"},"전투개시":{"voiceline":"스루가  함대… 전, 전력을 다하세요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/battle.ogg"},"상세확인":{"voiceline":"특별계획함의 모두는 뿔 속성이 강하… 아니, 개성이 독특하네요. 별로 부럽지는 않습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/detail.ogg"},"드랍 설명":{"voiceline":"키이급 전함—스루가 ","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔습니다. 마중을 하러 갈 때가 되었군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/expedition.ogg"},"실망":{"voiceline":"하아… 어디에 있든 좋은 일이 없네… 조금 편하게 있게 해주세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/feeling1.ogg"},"낯섦":{"voiceline":"기함 스루가 , 모항의 일원으로서 함대를 위해 전력을 다하겠습니다. 지휘관님, 언제든 명령을 내려 주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/feeling2.ogg"},"호감":{"voiceline":"저, 저보다는 다른 분들에게 신경을 써주십시오! 이렇게 자주 돌봐주실 필요는 없습니다. 저는 괜찮으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/feeling3.ogg"},"기쁨":{"voiceline":"신, 신경 써주시는 것은 알겠지만 모두의 앞에서 이러시면 부끄럽습니다! 저에게 이런 고민거리를 안겨주시는 것이 무슨 도움이 되는 거죠?! 정말이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/feeling4.ogg"},"사랑":{"voiceline":"하아… 결국 지휘관님 덕분에 모항에서 또 주목을 받게 되어버렸네요… 정말이지, 친밀감의 표현이라도 이렇게 부끄러운 방법일 필요는 없잖습니까…! 지휘관님, 대체 뭘 하고 싶으신 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/feeling5.ogg"},"터치3":{"voiceline":"뿔은 만지지 않았네… 다행이다… 아니, 아무 것도 아닙니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/headtouch.ogg"},"모항귀환":{"voiceline":"수고하셨습니다. 저는 신경 쓰지 마시고 푹 쉬시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/home.ogg"},"hp 경고":{"voiceline":"아아, 정말이지! 운이 나빠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/hp_warning.ogg"},"로그인":{"voiceline":"오늘 업무도 힘내주세요. 저의 도움이 필요하다면 부담 없이 말씀해 주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/login.ogg"},"실패":{"voiceline":"자아, 끝났다… 아니, 이런 부끄러운 일에 집중하지 마세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/lose.ogg"},"우편":{"voiceline":"새로운 우편이 있군요. 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/mail.ogg"},"임무":{"voiceline":"임무를 끝내 버리죠. 지휘관으로서 마땅히 해야 할 의무입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/mission.ogg"},"임무완료":{"voiceline":"보수를 가져왔습니다. 후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/mission_complete.ogg"},"서약":{"voiceline":"지휘관님은 정말 참견하기를 좋아하시는군요… 이제 와서 저도 별로 놀랍지는 않습니다. 조금의 거짓도 없는 지휘관님의 감정은 이미 알고 있었습니다—— 그러니 스루가 는, 진심으로 지휘관님의 사랑의 서약을 받아들이겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/propose.ogg"},"스킬":{"voiceline":"날려버리겠어!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/skill.ogg"},"터치1":{"voiceline":"지휘관님의 지시에 따르겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/touch.ogg"},"터치2":{"voiceline":"아?! 갑자기 무엇을……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/touch2.ogg"},"입수시":{"voiceline":"전함, 스루가 . 착임했습니다. 이 모항과는 인연이… 아니, 아닙니다. 신경 쓰지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/unlock.ogg"},"강화성공":{"voiceline":"승부란… 승리하지 않으면 의미가 없습니다. 그러니 승리를 위해서 강화는 필요한 일이겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/upgrade.ogg"},"vote":null,"승리":{"voiceline":"바보! 내… 아니, 우리의 승리입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/win_mvp.ogg"},"전투개시_ex":{"voiceline":"출격하고 싶지는 않지만… 어쩔 수 없네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/battle_ex.ogg"},"상세확인_ex":{"voiceline":"연합 훈련의 기함이라니. 이렇게 주목받는 위치는 안돼. 절대로 못 할거야. 왜 아무도 몰라주는 건데! … 지, 지휘관님?! … 아, 아아아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님은 제 모든 것을 전부 다 알고 계시죠. 뿔도, 성격도요. 서로에 대해 잘 알고 있으니 이제는 별로… 아니, 역시 말 하게 해주세요. 지휘실에서 이런저런 일을 하자는 건 절대 상대하지 않을 거니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"머리가 쿵쿵, 쿵쿵, 쿵쿵쿵~쿵. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"수고하셨어요. 지휘관님이라면 조금 더 빛나고 싶으시겠죠. 하지만 저는 지금처럼 이렇게 주목받지 않는 게 더 행복해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"제 도움이 필요하다면 꼭 말해주세요. 비서함의 일은 지휘관님을 돕는 것이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"음… 이 임무는… 역시 확인해보는 편이 좋겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/mission_ex.ogg"},"임무완료_ex":{"voiceline":"빙고, 끝났다. 지휘관님, 보상이 대단하네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"후후후, 지휘관님이 이걸 좋아한다는 건 알고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['나가토'] : 나가토님, 지켜드리겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/couple_encourage1.ogg"},{"voiceline":"['카가'] : 카가… 너무 무리하지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/couple_encourage2.ogg"},{"voiceline":"['아마기'] : 아마기 … 당신만 있다면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/couple_encourage3.ogg"},{"voiceline":"['이즈모'] : 만약 제가 조금 더 기다린다 해도… 가능성은 높지 않겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/couple_encourage4.ogg"},{"voiceline":"['키이'] : 키이, 돌격해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/couple_encourage5.ogg"}],"메인4":{"voiceline":"싸움을 좋아하지는 않지만, 걸어온 싸움을 피하지는 않습니다. 그것이 싸우기 위해 태어난 우리의 존재 의미이기도 하니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main4.ogg"},"메인1_ex":{"voiceline":"일이 많으신가요? 함대를 지휘하는 것은 힘들죠. 모두 알고 있어요. 그러니 조금 더 돕게 해주세요. 네?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"전쟁이 끝난 뒤의 일은 그때 가서 얘기하도록 해요. 지금 해야할 것은 신념을 지키면서 평화를 위해 싸우는 것이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main4_ex.ogg"},"메인5":{"voiceline":"모항 생활은 여러가지로 순조롭습니다. 저보다 우수한 동료들이 많기 때문이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main5.ogg"},"메인6":null,"메인2_ex":{"voiceline":"지휘관님이 있기 때문에 지금의 우리가 있을 수 있어요. 모두가 존경한다고는 할 수 없지만, 적어도 지휘관님에게 고마워하고 있답니다. 그러니까 조금 더 자신을 가지세요. 저, 저는 조금… 다르죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main2_ex.ogg"},"메인3_ex":{"voiceline":"동료들과 함께 있을 때는 눈에 띄지 않아도 좋지만, 지휘관님에게 만큼은 잘 보였으면 좋겠어요. 후후, 물론 모두와도 사이좋게 지내야 하겠지만요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305140/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":305141,"클뜯 함순이 id":30514,"함순이 이름":"스루가","한글 함순이 + 스킨 이름":"백화경운","영문 함순이 + 스킨 이름":"Hundred Flowers' Auspice","스킨 타입":"New Year Kimono","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305141/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando260