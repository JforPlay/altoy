.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306062/shipyard.png","설명":"좋아, 그거야! 그렇게만 해! 좋아, 이겼다! 헤헤~ ——으앗?! 주군?! 이, 이건... 쉬는 시간에 잠깐 한 것뿐이에요!","자기소개":null,"메인1":{"voiceline":"헤헤~ 희귀 재료네요! 헤헤, 주군과 함께하니까 역시 행운이 증가하네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/main1.ogg"},"메인2":{"voiceline":"언제든지 게임을 할 수 있다니 정말 좋네요~ 저, 절대로 중독되지 않게 자제하고 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/main2.ogg"},"메인3":{"voiceline":"숙제요? 걱정 마세요. 이미 전부 끝냈으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"제 캐릭터는 저와 같이 용감한 무사랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/detail.ogg"},"드랍 설명":{"voiceline":"좋아, 그거야! 그렇게만 해! 좋아, 이겼다! 헤헤~ ——으앗?! 주군?! 이, 이건... 쉬는 시간에 잠깐 한 것뿐이에요!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"게임 덕분에 모항의 모두와 친해지고 주군과 어울리는 새로운 방법을 발견했어요... 주공과 같이 게임을 하면 약, 약간 게으름을 피우는 것이지만... 그래도 즐거워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"게임도 최선을 다해야 해요! 지금의 저라면 L.I에게 지지 않을 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"주군, 마침 잘 오셨어요! 저랑 같이 이 상위 퀘스트에 도전하지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/login.ogg"},"실패":null,"우편":{"voiceline":"새로운 소식이네요? 누가 파티 신청을 보낸 걸까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"주군도 같이 하실래요? (덥썩) 그럼 제 옆에 앉으세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306062/touch.ogg"},"터치2":{"voiceline":"어라?!