[{"클뜯 id":306060,"클뜯 함순이 id":30606,"함순이 이름":"류조","한글 함순이 + 스킨 이름":"류조","영문 함순이 + 스킨 이름":"Ryuujou","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306060/shipyard.png","설명":"용양인진, 내 앞에 적은 없다! ","자기소개":{"voiceline":"사쿠라 엠파이어 해군 항공모함, 류조입니다! 각 항공전대에 편성되어, 함께 필리핀에서 인도네시아, 알류샨, 과달카날 해전 등 많은 작전에 참가했던, 어엿한 무사입니다! 그렇게 안 보인다고요…? 부, 분명 제4함대 작전 때부터 성장이 멈춰서 그런 걸 거에요! 제 존재의 크기를, 머지않아 보게 될 겁니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/profile.ogg"},"메인1":{"voiceline":"화과자……이런 것 따위에 마음이 흔들릴 순……흐음……모처럼 준비해준 후의를 봐서 조금만……맛있어어!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/main1.ogg"},"메인2":{"voiceline":"심란할 땐 자주 수조를 바라봅니다. 여유롭게 헤엄치는 물고기들을 바라보고 있으면, 신기하게도 마음이 가라앉지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/main2.ogg"},"메인3":{"voiceline":"저의 싸움은 대의를 위한 것! 상대가 누구든 전력을 다해 맞서 싸울 뿐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/main3.ogg"},"전투개시":{"voiceline":"자, 네놈들의 죄는 네놈들이 알렷다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/battle.ogg"},"상세확인":{"voiceline":"주군, 싸우지 않으면 살아남을 수 없다고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/detail.ogg"},"드랍 설명":{"voiceline":"류조형 항공모함 - 류조","voicelink":null},"의뢰 완료":{"voiceline":"잡다한 건 필요없습니다! 감투정신과 근성만 있으면 문제 없는 겁니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/expedition.ogg"},"실망":{"voiceline":"윗 분들과 참모는 어디든 똑같군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/feeling1.ogg"},"낯섦":{"voiceline":"주군, 싸움이란 선악보다 승패가 더 중요합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/feeling2.ogg"},"호감":{"voiceline":"주군, 제게 조금 기대셔도 문제없습니다. 주군의 명령이라면, 뭐든지 따르겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/feeling3.ogg"},"기쁨":{"voiceline":"이게 바로…주군께서 만드신 식사입니까? 그럼, 사양않고 감사히 받겠습니다! ……후우~ 잘 먹었습니다! 에? 앞으로 귀환할 때마다 만들어 준단 말씀이십니까?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/feeling4.ogg"},"사랑":{"voiceline":"출격하기 전에 주군의 얼굴을 잠깐이라도 볼 수 있으면, 전 원기충천, 백전불패입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"모항 귀환 시에도 대열이 흐트러지면 안 됩니다! 사쿠라 엠파이어의 영광은, 우리들의 일의전심에 달려있습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/home.ogg"},"hp 경고":{"voiceline":"생명이여, 불타올라라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/hp_warning.ogg"},"로그인":{"voiceline":"휴일 말입니까? 주군, 제 근무표는 월월화수목금금입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/login.ogg"},"실패":{"voiceline":"우으……내 몸은 이미 너덜너덜하군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/lose.ogg"},"우편":{"voiceline":"전보 말씀이십니까? 아, 사령부의 전투 성과 발표는 아닌 모양입니다. 그렇기 때문에, 확인할 필요가 있다고 사료됩니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/mail.ogg"},"임무":{"voiceline":"나왔구나! 새로운 임무! 자, 전투, 훈련, 뭐든지…음속으로 끝내겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/mission.ogg"},"임무완료":{"voiceline":"완료된 임무라면, 제게 안 알려주셔도……이 간식, 제게 주는 건가요? 감사합니다! 잘 받겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/mission_complete.ogg"},"서약":{"voiceline":"앞으로 어떤 위험에 처하더라도, 제가 전력을 다해 주군을 지키겠습니다! 설령 제가 바닷속에 가라앉는다 해도, 주군께는 상처 하나 남기지 않겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/propose.ogg"},"스킬":{"voiceline":"용양인진, 내 앞에 적은 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/skill.ogg"},"터치1":{"voiceline":"주군, 아무쪼록 조심하여 주십시오. 저는 일러스트리어스와 같은 탑헤비니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/touch.ogg"},"터치2":{"voiceline":"꺄악!! 앗……새러토가씨는 아니었군요…아니, 새러토가씨보다 더 너무하십니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/touch2.ogg"},"입수시":{"voiceline":"주군! 이 몸은 류조, 해가 떠오르는 나라의 무사되는 몸! 칠생을 다하여 주군에게 충의를 바치겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/unlock.ogg"},"강화성공":{"voiceline":"고맙습니다! 주군, 잠깐 같이 뛰고 올까 하는데, 같이 가시죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"절망이……네 녀석들의 종점이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0},{"클뜯 id":30