[{"클뜯 id":213020,"클뜯 함순이 id":21302,"함순이 이름":"테러","한글 함순이 + 스킨 이름":"테러","영문 함순이 + 스킨 이름":"Terror","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/213020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/213020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/213020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/213020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/213020/shipyard.png","설명":"에레버스급 모니터함·테러 (HMS Terror)","자기소개":{"voiceline":"에레버스급 모니터함 2번함, 테러예요.\n애버크롬비는 저와 언니를 이길 수 없어요. 곧잘 다르다넬스 해협에 있곤 해요. 함포 사격…? 간단할지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/profile.ogg"},"메인1":{"voiceline":"지휘관, 그 완두콩을 저쪽에 가져다주시겠어요? 그리고 전기톱도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/main1.ogg"},"메인2":{"voiceline":"제게 「마음」이 있다는 것이, 그렇게나 이상한가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/main2.ogg"},"메인3":{"voiceline":"지휘관… 지휘관은… 에어 플레이어인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/main3.ogg"},"전투개시":{"voiceline":"테러도, 긴장되기 시작했어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/battle.ogg"},"상세확인":{"voiceline":"지금의 지휘관의 눈빛, 그 이상한 사람들과 똑같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/detail.ogg"},"드랍 설명":{"voiceline":"에레버스급 모니터함·테러 (HMS Terror)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰를 완료했어요. 그러고 보니, 전에 의뢰나갔을 때 팔을 잃어버렸어요. 모두 한참을 찾았었죠…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/expedition.ogg"},"실망":{"voiceline":"테러는, 지휘관이 좀 무섭다고 느껴져요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/feeling1.ogg"},"낯섦":{"voiceline":"지휘관은… 테러가 무섭지 않으신가요? 저, 체온도 없고 감정도 별로 없으니까, 마치 죽은 사람같아요오…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/feeling2.ogg"},"호감":{"voiceline":"눈을 뜨고부터 쭉 언니가 곁에 있어줘요… 그리고 언니와 쭉 함께 있어요, 단 하나뿐인 가족이에요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/feeling3.ogg"},"기쁨":{"voiceline":"언니의 곁은 따뜻해요. 지휘관의 곁은… 마찬가지로 따뜻해요. 가족이 한 명 늘어서 기뻐요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/feeling4.ogg"},"사랑":{"voiceline":"지휘관… 테러의 마음, 만져봐요… 이렇게나 두근거리거나, 뜨거워졌던 적은 없었어요… 이건 전부… 지휘관 덕분이에요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"그래 그래, 착하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/home.ogg"},"hp 경고":{"voiceline":"테러도… 두려워졌어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/hp_warning.ogg"},"로그인":{"voiceline":"지휘관… 저, 예전부터, 지휘관과 이야기를 하고 싶어서… 저…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/login.ogg"},"실패":{"voiceline":"으으… 지휘관이 데리고 돌아갈 때까지 힘낼게요오…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/lose.ogg"},"우편":{"voiceline":"편지… 저에게 편지를 써주실 분 계신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/mail.ogg"},"임무":{"voiceline":"미션… 몸을 움직이는 것도 좋네요. 그렇지 않으면 또 무릎이 안 좋아지게 되어버려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/mission.ogg"},"임무완료":{"voiceline":"영차, 영차, 지휘관, 보너스를 가져왔어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/213020/mission_complete.ogg"},"서약":{"voiceline":"이럴 때, 