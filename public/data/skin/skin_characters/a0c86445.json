[{"클뜯 id":901140,"클뜯 함순이 id":90114,"함순이 이름":"로데슈","한글 함순이 + 스킨 이름":"로데슈","영문 함순이 + 스킨 이름":"L'Audacieux","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901140/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901140/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901140/shipyard.png","설명":"르 팡타스크급 구축함 - 로데슈","자기소개":{"voiceline":"로데슈… 그 이름처럼 과감하고 용맹한 슈발리에를 목표로 하고 있습니다. 지휘관님, 제 성장을 지켜봐 주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/profile.ogg"},"메인1":{"voiceline":"야무져 보인다…고요? 그렇군요! 쿨럭쿨럭… 카, 카발리에에게 있어서 냉정 침착은 기본 덕목이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/main1.ogg"},"메인2":{"voiceline":"오늘도 왠지 어린애 취급을 당하는 듯한 기분이 드는군요…… 슈발리에가 그렇게 쉽게 속아 넘어갈 리 없잖아요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/main2.ogg"},"메인3":{"voiceline":"아무리 강해도 지략이 없다면 무모할 뿐. 냉정하게 생각할 수 있어야 진정한 승리를 얻을 수 있는 법이죠. 지휘관님, 이것이 바로 카발리에로서 갖춰야 하는 마음가짐입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/main3.ogg"},"전투개시":{"voiceline":"아이리스의 힘 앞에 두려워하며 떨라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/battle.ogg"},"상세확인":{"voiceline":"겸손, 성실, 자비, 무용, 정의, 헌신, 영성, 명예…… 이 슈발리에의 8가지 덕목이야말로 제가 걷고자 하는 길이죠. 지휘관님, 힘 있는 호교기사로서 제가 모두를 지키겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/detail.ogg"},"드랍 설명":{"voiceline":"르 트리옹팡급 구축함 - 로데슈","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔군요, 지휘관님. 그리고 이건 그 전리품인데…… 와, 완벽한 승리로군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/expedition.ogg"},"실망":{"voiceline":"아이리스를 등지고 타락하더라도…… 저는 절대 지휘관님을 포기하지 않습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/feeling1.ogg"},"낯섦":{"voiceline":"……지휘관님에 대한 모항 동료들의 평가는 거의 찬사뿐이군요. 분명 지휘관님이 우수하고 강한 분이셔서 그런 것이겠죠! 어쩌면 슈발리에가 될 자질이 있을지도 몰라요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/feeling2.ogg"},"호감":{"voiceline":"지휘관님과 가까워질수록 제 자신의 부족함을 깨닫게 되는군요…… 하지만 그만큼 앞으로 나아가고 있는 느낌도 들어요! 맞아요! 지휘관님은 제가 동경하는 존재! 지휘관님과 가까워지고 있다는 것이 바로 제 성장의 증명입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님 곁에 있으려면 더 강해지고 우수해져야 해요! …왜냐하면 충성을 맹세한 주인에게 버려지는 슈발리에는… 그런 건 어디에도 없으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/feeling4.ogg"},"사랑":{"voiceline":"당돌하지만… 지휘관님, 저 로데슈는 충성을 모두 바치는 것뿐만 아니라, 계속 곁에 머물고 싶은 마음이 최근에 생기고 말았습니다… 네? 이, 이게 바로 「사랑」이라고요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/feeling5.ogg"},"터치3":{"voiceline":"이것 참… 마음이… 편안해지네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 고생 많으셨습니다. 방금 전 지휘는 정말 훌륭했습니다! 역시 대단하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/home.ogg"},"hp 경고":{"voiceline":"이 정도쯤은……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/hp_warning.ogg"},"로그인":{"voiceline":"오셨군요, 지휘관님. 그럼 오늘 예정을 여쭈어도 될까요? …걱정하지 마세요. 어떤 용건이든 이 충실한 호교 기사가 곁에서 함께할 테니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/login.ogg"},"실패":{"voiceline":"……적의 추격은 제가 막겠습니다. 다들 일단 철수하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/lose.ogg"},"우편":{"voiceline":"새로운 우편입니다! 네, 지휘관님. 편지칼도 준비해 뒀습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/mail.ogg"},"임무":{"voiceline":"새로운 임무입니다. 지휘관님, 뭐라도 미리 준비해 두는 편이 좋을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/mission.ogg"},"임무완료":{"voiceline":"임무 완료…… 이번에도 집무실을 지켰네요… 괜찮습니다! 인내 또한 슈발리에의 미덕 중 하나…라고 생각합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/mission_complete.ogg"},"서약":{"voiceline":"이건…… 서약을 나누었다는 증명인가요? 굳이 이런 것까지 안 주셔도 제가 계속 지켜드릴 텐데… 네? 이걸 받았다는 건 즉 앞으로 두 사람은 부…부…가 되어서… 으아아아…?! 그런 거였나요…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/propose.ogg"},"스킬":{"voiceline":"정의는 여기에 있다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/skill.ogg"},"터치1":{"voiceline":"지휘관님, 도움이 필요하신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/touch.ogg"},"터치2":{"voiceline":"지, 지휘관님? 음…… 이것도 슈발리에의 책무인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/touch2.ogg"},"입수시":{"voiceline":"아이리스의 슈발리에, 로데슈입니다. 지휘관님, 제 칼날을 휘두르는 주인이 되실 분은 당신이신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/unlock.ogg"},"강화성공":{"voiceline":"음…… 힘이 넘치는군요. 지휘관님, 앞으로도 당신을 위해 이 칼을 휘두르겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/upgrade.ogg"},"vote":null,"승리":{"voiceline":"목숨을 걸고 마지막까지 싸운 그 행동에… 경의를 표합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"저도 모르는 사이에 지휘관님께 고백했던 걸 생각하면, 얼굴이 뜨거워져서…… 네, 「사랑」하는 마음이 지휘관님께 전해졌다면, 이 정도쯤은 아무렇지도…… 않아요. ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"대, 대단해… 역시 지휘관님이십니다! 지휘관님의 칼날으로서 저도 더욱 정진해야겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 오, 오셨군요! 혹시 제가 도와드릴 건 없을까요? 예를 들면, 마사지라든가… 뭐, 뭐든 열심히 해볼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관님, 외로우신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/touch_ex.ogg"},"터치2_ex":{"voiceline":"이, 이렇게 꼭~ 껴안으면 될까요? ……저, 제대로 잘했나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"키, 키가 작은 건 힘이랑은 관계없고, 슈발리에의 자질과도 아무런 상관이 없습니다! …저, 정말 그렇게 작나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/main5_ex.ogg"},"메인6_ex":{"voiceline":"이 검을 흔들어 보고 싶으신가요? 자, 이렇게… 이렇게 하면… 으아아! 지휘관님, 조심하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님 앞에서는 마음 편히 있어도 된다고…… 그렇게 말씀은 해주셨지만, 이대로면 흐물흐물 녹아버릴 것 같습니다… 그렇게 잠깐 동안은 슈발리에가 아니어도 괜찮으시다면… 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901140/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"MNF","레어도":"SSR","ex_chat_status":1},{"클뜯 id":901141,"클뜯 함순이 id":90114,"함순이 이름":"로데슈","한글 함순이 + 스킨 이름":"양산 밑의 슈발리에","영문 함순이 + 스킨 이름":"Protector Beneath the Parasol","스킨 타입":"Race Queen","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901141/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901141/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901141/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901141/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901141/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901141/shipyard.png","설명":"읏…… 슈발리에로서 이런 모습은 낯설기만 하지만, 지휘관님을 위해서라면……좋아요! 오늘도 성스러운 책무를 열심히 완수하겠어요!","자기소개":null,"메인1":{"voiceline":"스트라스부르 씨 쪽은 나보다 자연스럽게 행동하고 있고, 몸매도…… 안 되지, 안 돼. 지금은 의기소침할 때가 아니야… 정신 차리자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/main1.ogg"},"메인2":{"voiceline":"차량 앞에서 포즈는 이런 느낌으로 취하면 될까요? 양산은…… 조금 더 뒤로요? 자, 이제 됐어요. 지휘관님, 마음껏 촬영하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/main2.ogg"},"메인3":{"voiceline":"사실 저, 모터스포츠에도 관심이 있어요. 하지만 지금은 그것보다 성스러운 책무를…… 지휘관님, 레이스가 끝나면… 운전에 대한 가르침을 부탁드려도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"질주하는 차, 피어오르는 연기, 끓어오르는 듯한 경기장의 열기…… 레이스가 이렇게 마상창 시합에 뒤지지 않을 정도로 치열할 줄은 몰랐어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/detail.ogg"},"드랍 설명":{"voiceline":"읏…… 슈발리에로서 이런 모습은 낯설기만 하지만, 지휘관님을 위해서라면……좋아요! 오늘도 성스러운 책무를 열심히 완수하겠어요!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님의 흐뭇한 얼굴을 보니 제 마음도 따뜻하고 두근두근해지네요…… 음… 지휘관님의 웃는 얼굴을 더 많이 보고 싶어요! 그래서 말인데, 뭘 해드리면 될까요…? 아! 우선은 이 양산부터 씌워드리면 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/feeling5.ogg"},"터치3":{"voiceline":"「선바이저를 쓴 로데슈가 예쁘다」고요…? 그, 그런가요…? ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/headtouch.ogg"},"모항귀환":{"voiceline":"역시 지휘관님이 계시면 승리는 떼 놓은 당상…… 네! 방금 전에 정말 대단하셨어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"휴우…… 지휘관님, 오셨군요. 본 경기가 시작되기 전에 양산으로 더위를 피할 수 있게 해드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"다음 레이스가 있군요. 지휘관님, 슬슬 관전하러 가시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/mission.ogg"},"임무완료":{"voiceline":"무사히 모든 차량이 완주했네요! …음, 지휘관님의 땀을 닦아드릴… 물티슈를 제가 어디에다 뒀었죠……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님을 위한 가장 멋진 포즈……는 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/touch.ogg"},"터치2":{"voiceline":"지, 지휘관님?! 뭐 하시는…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/touch2.ogg"},"입수시":{"voiceline":"읏…… 슈발리에로서 이런 모습은 낯설기만 하지만, 지휘관님을 위해서라면……좋아요! 오늘도 성스러운 책무를 열심히 완수하겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901141/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"극속