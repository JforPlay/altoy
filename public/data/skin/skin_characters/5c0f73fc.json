[{"클뜯 id":607020,"클뜯 함순이 id":60702,"함순이 이름":"임페로","한글 함순이 + 스킨 이름":"임페로","영문 함순이 + 스킨 이름":"Impero","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/607020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/607020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/607020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/607020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/607020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/607020/shipyard.png","설명":"항공모함—임페로","자기소개":{"voiceline":"비토리오 베네토급 4번함 임페로야. 머리를 조아려서 내게 충성을 맹세하도록 해. 임페로는 위대하고, 위대하다는 건 대단한 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/profile.ogg"},"메인1":{"voiceline":"베네토 언니는 아직 일어나 있는 건가? 일어나 있으면 반짝~하고 위광이 반짝이거든. 봐, 이렇게 반짝~하고 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/main1.ogg"},"메인2":{"voiceline":"빵과 휴대폰만 있으면 사람은 살아갈 수 있어……. 아니다, 산소콜라도… 아니, 목욕탕도 있어야겠어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/main2.ogg"},"메인3":{"voiceline":"창문에 미끄럼틀을 달면, 방에 쉽게 돌아갈 수 있겠어. 지휘관, 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/main3.ogg"},"전투개시":{"voiceline":"사르데냐의 위광을… 나의 위광을 보아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/battle.ogg"},"상세확인":{"voiceline":"무슨 일이야? 지금 목욕하러 갈 거니까, 세 시간 후에 다시 와. 급한 일이면… 같이 목욕하면서 얘기할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/detail.ogg"},"드랍 설명":{"voiceline":"항공모함—임페로","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 귀환한 것 같아. 배웅 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/expedition.ogg"},"실망":{"voiceline":"물러나. 동료를 저버린 자에게 볼일은 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/feeling1.ogg"},"낯섦":{"voiceline":"임페로의 위대함에 이유는 필요 없어. 이 위대함은 자연스럽고, 당연하고, 의심할 여지가 없지. 응, 베네토 언니가 그랬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/feeling2.ogg"},"호감":{"voiceline":"드디어 임페로에게 충성을 맹세할 결심이 선 거야? 응? 지휘관이 위대한 건 분명하지만, 나도 위대하니까, 서로 한 번씩 충성을 맹세하는 걸로 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/feeling3.ogg"},"기쁨":{"voiceline":"…임페로는 아무것도 안 해도 돼. 아무것도 안 해도 사르데냐에 도움이 되는걸. 그렇지만 지휘관을 위해서라면, 나도 분발해야지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/feeling4.ogg"},"사랑":{"voiceline":"업무를 도와봤어. 위대한 내게 이런 업무는 익숙하지 않으니까, 너그럽게 봐줘. 지휘관도 태어났을 때부터 그렇게 일을 잘한 건 아니잖아? 뭐, 그렇다는 거야…. 응, 칭찬해줘서 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/feeling5.ogg"},"터치3":{"voiceline":"…지휘관, 머리카락 가지고 놀면 재밌어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/headtouch.ogg"},"모항귀환":{"voiceline":"…돌아왔어? 일부러 일어나서 마중 나온 거니까 감사하게 여겨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/home.ogg"},"hp 경고":{"voiceline":"위대한 임페로, 지금부터 진지 모드야……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/hp_warning.ogg"},"로그인":{"voiceline":"안녕. 흐아암……. 이제 잘 거니까 출격할 때 깨워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/login.ogg"},"실패":{"voiceline":"하늘을 나는 스파게티… 들켰어? 그래… 미안해. 내 잘못이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/lose.ogg"},"우편":{"voiceline":"우편이 휙 하고 책상에…? 날아온 게 아니라 임페로가 가지고 온 거 아니냐고? 들켰군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/mail.ogg"},"임무":{"voiceline":"임무인가. 사르데냐의 위광을 떨치기 위해선 필요하겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/mission.ogg"},"임무완료":{"voiceline":"임무 완료. 귀중한 체력을 거의 써버렸어…. 뒤는 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/mission_complete.ogg"},"서약":{"voiceline":"…? 반지? 장가 오려는 거야? 이건 베네토 언니에게 어떻게 보고를 해야 좋을까……. 아직 안 해도 되려나? 응, 맞아. 임페로는 위대해서 아무것도 안 해도 되니까. 지휘관, 뒤는 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/propose.ogg"},"스킬":{"voiceline":"넙죽 엎드려라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/skill.ogg"},"터치1":{"voiceline":"내 앞에 납작 엎드리고 싶어진 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/touch.ogg"},"터치2":{"voiceline":"……………………음흉해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/touch2.ogg"},"입수시":{"voiceline":"비토리오 베네토급의 임페로야, 됐지, 난 잘게…… 응? 임페로는 대단해. 엄청 대단하니까, 지휘관은 명령 대기하면 돼. 맞아, 이제 날 혼자두고 물러가면 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/unlock.ogg"},"강화성공":{"voiceline":"하암….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"임페로가 출격하는 걸 알면서도 맞서는 건… 용기가 아니라 자신의 분수를 모르는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"휴우… 목욕하니까 개운하네…. 지휘관? 왜 그래? 이 모습…? 방금 전까지 목욕하고 있어서 그런 건데??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔어. 임페로의 위광을 보여주… 됐다. 지휘관, 다녀와.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/607020/exp