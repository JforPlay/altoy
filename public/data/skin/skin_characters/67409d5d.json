[{"클뜯 id":306030,"클뜯 함순이 id":30603,"함순이 이름":"호쇼","한글 함순이 + 스킨 이름":"호쇼","영문 함순이 + 스킨 이름":"Houshou","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306030/shipyard.png","설명":"호쇼형 항공모함·호쇼","자기소개":{"voiceline":"저는 세계 최초의 항공모함으로 설계된 함선으로, 이른바 모든 항공모함의 언니, 후훗, 어머니라고도 할 수 있겠네요. 어린아이들을 보살피는 것이 특기예요── 편하게 말 걸어주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/profile.ogg"},"메인1":{"voiceline":"다리가 긴 것도 때론 곤란한지라… 중심이 불안정하니까, 종종 균형이 무너지기 쉽답니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/main1.ogg"},"메인2":{"voiceline":"지휘관님? 과자를 준비했어요. 조금 쉬시는 건 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/main2.ogg"},"메인3":{"voiceline":"이렇게나 훌륭한 아이들을 보면, 언니로서는 기쁘지만, 가끔 쓸쓸하다는 느낌도 조금 드네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/main3.ogg"},"전투개시":{"voiceline":"실전은 서툴지만… 지휘관님에게 수치를 당하게 할 순 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/battle.ogg"},"상세확인":{"voiceline":"지휘관님은 가끔 어린아이 같아요… 자, 이리 오세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/detail.ogg"},"드랍 설명":{"voiceline":"호쇼형 항공모함·호쇼","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 여동생들이 돌아왔어요. 제가 먼저 마중 나갈 테니, 나중에 와주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/expedition.ogg"},"실망":{"voiceline":"지휘관님, 무슨 일이신지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 잠시 눈 좀 붙이는 건 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/feeling2.ogg"},"호감":{"voiceline":"제가 오이란으로 보이시나요? 그럼… 낭군님, 오늘 밤은 잠시 속세에서 벗어나, 제 온기를 가득 느끼면서 지금까지의 일들을 전부 잊어버리시는 거예요── 어땠나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/feeling3.ogg"},"기쁨":{"voiceline":"어떤 분께 예쁘다고 칭찬받았습니다만, 저는 자신이 별로 없네요… 지휘관님께 칭찬받을 수 있다면 더욱 자신감이 생길 거예요. 그러니 지휘관님, 저… 예쁘…나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 오늘 밤은 달이 예쁘네요. 술을 준비했어요. 따라드릴 테니, 달을 바라보며 한잔하시는 건 어떠신가요? 후훗, 다른 분께는 해드리지 않는, 오로지 지휘관님만을 위한 「특별 서비스」랍니다. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 수고가 많으세요. 우선 식사를 하시겠어요? 목욕을 하시겠어요? 아니면… 먼저, 한잔하시는 것은 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/home.ogg"},"hp 경고":{"voiceline":"태평하게 있을 때가 아닌 모양이네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님? 식사는 어떠신가요? 만약 아직이라면 제가 뭔가 드실만한 거라도 준비해올까요? 배가 고픈 상태에서는 일에도 집중할 수가 없답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/login.ogg"},"실패":{"voiceline":"지휘관님, 죄송합니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/lose.ogg"},"우편":{"voiceline":"지휘관님, 편지가 도착했어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/mail.ogg"},"임무":{"voiceline":"새로운 임무예요. 지휘관님, 하나 받아보는 건 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/mission.ogg"},"임무완료":{"voiceline":"어머나, 임무가 완료되어 있답니다? 정말, 지휘관님은 자주 깜빡하신다니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/mission_complete.ogg"},"서약":{"voiceline":"제 꿈은, 싸움이 끝나면 언젠가 사랑하는 사람과 함께 작은 여관을 운영하는 거예요… 지금이라면 그 꿈을 이루는 것도 그렇게 멀지 않은 것 같네요. 그렇죠? 주인님~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/propose.ogg"},"스킬":{"voiceline":"연회의 시작이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/skill.ogg"},"터치1":{"voiceline":"지휘관님, 부르셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/touch.ogg"},"터치2":{"voiceline":"꺄아앗!… 지, 지휘관님, 여기는 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/touch2.ogg"},"입수시":{"voiceline":"어머, 지휘관님이셨나요… 호쇼라고 해요. 잘 부탁드려요~ 후후, 함대의 아이들을 보살피는 건 제게 맡겨주세요, 실망시켜드리지는 않을 거예요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/unlock.ogg"},"강화성공":{"voiceline":"이걸로 지휘관님께 더욱 도움이 될 수 있겠어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관님, 이 정도면 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0},{"클뜯 id":306031,"클뜯 함순이 id":30603,"함순이 이름":"