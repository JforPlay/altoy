[{"클뜯 id":202250,"클뜯 함순이 id":20225,"함순이 이름":"셰필드(μ장비)","한글 함순이 + 스킨 이름":"셰필드(μ장비)","영문 함순이 + 스킨 이름":"Sheffield μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202250/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202250/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202250/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202250/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202250/shipyard.png","설명":"로열 메이드대의 셰필드입니다. 믿기지 않으시다는 표정을 보니 아무래도 제대로 설명을 하려면 꽤나 힘들 것 같네요.","자기소개":{"voiceline":"타운급 경순항함 셰필드, 지금부터 로열의 명에 따라 아이돌 활동을 시작하겠습니다. 왜 그러십니까, 무언가 이상한 점이라도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/profile.ogg"},"메인1":{"voiceline":"최애 멤버에게 모욕을 당하고 좋아하는 사람들이 있다고 합니다. 이해가 가지 않는군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/main1.ogg"},"메인2":{"voiceline":"노래로 적을 쓰러뜨린다, 인가요? 현실적으로는 불가능하지만 꽤 괜찮은 기획인 것 같군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/main2.ogg"},"메인3":{"voiceline":"종종 벨파스트를 감상하곤 합니다. 메이드 일 이외에도 전부 나무랄 데 없이 처리하곤 하니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/main3.ogg"},"전투개시":{"voiceline":"라이브를 방해하는 해충들을 ‘박멸’했습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/battle.ogg"},"상세확인":{"voiceline":"프로듀서? 아니, 역시 주인님이라는 호칭이 익숙합니다. 아니면, ‘해충’ 쪽이 더 마음에 드십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/detail.ogg"},"드랍 설명":{"voiceline":"로열 메이드대의 셰필드입니다. 믿기지 않으시다는 표정을 보니 아무래도 제대로 설명을 하려면 꽤나 힘들 것 같네요.","voicelink":null},"의뢰 완료":{"voiceline":"녹음해둔 총성으로 의뢰조가 돌아왔다는 것을 알려드려야 합니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/expedition.ogg"},"실망":{"voiceline":"다른 멤버들이 상처받기 전에 제가 먼저 주인님을 처리하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/feeling1.ogg"},"낯섦":{"voiceline":"유닛 활동으로 인해 메이드 일이 지연되고 있습니다. 이 부분은 활동이 일단락되면 제대로 보충하도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/feeling2.ogg"},"호감":{"voiceline":"제 연주가 마음에 드십니까? 지휘관님께서도 이정도는 하실 수 있을 겁니다——매일 연습하는 것을 잊지 않는다면 말이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/feeling3.ogg"},"기쁨":{"voiceline":"메이드 일 이외의 것도 감당할 수 있다, 라고 생각한 적이 있습니다. 하지만 실제로 해보니 생각만큼 쉽지만은 않군요…… 이 이야기를 다른 사람에게 하신다면 주인님을 입막음하는 수밖에…… 장난입니다. 담아두지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/feeling4.ogg"},"사랑":{"voiceline":"주인님이 좋아하시는 것은 메이드 셰필드도, 스테이지에서 빛나는 셰필드도 아닌 ‘저’ 입니까…… 고백치고는 꽤나 진부하군요. 하지만, 감사합니다. 잊지 않겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"(흥얼거림) 아, 주인님. 돌아오셨군요. 방금 무슨 이상한 소리라도 들으셨습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/home.ogg"},"hp 경고":{"voiceline":"응급조치를 시작합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/hp_warning.ogg"},"로그인":{"voiceline":"합주 전에 사무실 청소를 마쳤습니다. 부디 어지럽히지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/login.ogg"},"실패":{"voiceline":"저 때문에 실패했습니다. 죄송합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/lose.ogg"},"우편":{"voiceline":"새로운 우편입니다. 팬레터라면 열심히 답장해 드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/mail.ogg"},"임무":{"voiceline":"새로운 라이브입니까? 확실히 준비하도록 하지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/mission.ogg"},"임무완료":{"voiceline":"라이브의 보상입니다. 다른 멤버들이 보면 기뻐하겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/mission_complete.ogg"},"서약":{"voiceline":"어떤 셰필드라도 항상 주인님을 존경하고 사랑하겠습니다. 네, 이것은 굉장히 감정적으로 한 말입니다. 정말이요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/propose.ogg"},"스킬":{"voiceline":"이 노래로 잠들어라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/skill.ogg"},"터치1":{"voiceline":"총은 가지고 있지 않지만, 주인님께서 자신의 행동을 주의하시길 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/touch.ogg"},"터치2":{"voiceline":"‘아이돌'을 상대로 이런 짓이라니, 제대로 ‘마음의 준비’는 되어 있으시겠지요. 주인님? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/touch2.ogg"},"입수시":{"voiceline":"로열 메이드대의 셰필드입니다. 믿기지 않으시다는 표정을 보니 아무래도 제대로 설명을 하려면 꽤나 힘들 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/unlock.ogg"},"강화성공":{"voiceline":"어떤 일이든 전력을 다하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/upgrade.ogg"},"vote":null,"승리":{"voiceline":"라이브는 순조로웠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['가스코뉴(μ장비)', '클리블랜드(μ장비)', '아드미랄 히퍼(μ장비)', '아카기(μ장비)'] : 주인님의 얼굴을 봐서 너희들에게 맞춰주도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202250/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":