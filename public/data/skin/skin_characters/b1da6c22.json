[{"클뜯 id":705060,"클뜯 함순이 id":70506,"함순이 이름":"아르한겔스크","한글 함순이 + 스킨 이름":"아르한겔스크","영문 함순이 + 스킨 이름":"Arkhangelsk","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705060/shipyard.png","설명":"R급 전함—아르한겔스크","자기소개":{"voiceline":"노스 유니온 소속 전함 아르한겔스크야. 함력 상으로 예전에는 로열에 소속해 사르데냐와의 대치와 선단 호위 등에서 활약했어. 그래서 전력적으로 평가 받지 못한 시절도 있지만 이곳에서는 주력함답게 전과를 쟁취하겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/profile.ogg"},"메인1":{"voiceline":"워스파이트 공, 여전히 활약하고 있는 것 같아서 보기 좋네. 기사대의 면모를 보여주는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/main1.ogg"},"메인2":{"voiceline":"분명 이 모항에도 노스 유니온 소속 전함은 몇 명 더 있지만 누구에게도 지지 않을 자신은… 자신만 있는 게 아니라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/main2.ogg"},"메인3":{"voiceline":"업무는 다 끝났어? 다음 업무 준비는? …훌륭한 마음가짐이네. 그 상태로 계속 다음, 그 다음의 다음도 진행하라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/main3.ogg"},"전투개시":{"voiceline":"전장을 다스리는 건 바로 나야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/battle.ogg"},"상세확인":{"voiceline":"함대의 전체 지휘는 당신이 맡고 현장 지휘는 내가 맡을게. 서로 도우면 전쟁에서 승리할 수 있어. 뭐, 가끔은 내가 모항의 진로를 대신 정해줄 수도 있지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/detail.ogg"},"드랍 설명":{"voiceline":"R급 전함—아르한겔스크","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 귀환 확인! 그럼 이번엔 홍차가 아니라 몸을 따뜻하게 해줄 보드카가 등장할 차례네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/expedition.ogg"},"실망":{"voiceline":"지휘관 실격이야! 다시 단련하고 와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/feeling1.ogg"},"낯섦":{"voiceline":"예의를 갖추고 대해주는 건 고맙지만, 지금 당신 앞에 있는 나는 레이디가 아니라 군인이라구! 지휘관답게 행동하도록!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/feeling2.ogg"},"호감":{"voiceline":"으음… 왠지 피곤하네……. 어머, 지휘관. 당신도 요새 업무 때문에 많이 시달렸지? 너무 무리하지 말라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/feeling3.ogg"},"기쁨":{"voiceline":"(작은 목소리로) 후후후, 집중력이 대단한데. 역시 내가 인정한 지휘관, 그렇게 야무져야 내 미래를 맡길 수……. 아, 호, 혹시 지금 한 말, 들렸어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/feeling4.ogg"},"사랑":{"voiceline":"들었다면 어쩔 수 없지! 지휘관, 나는 내 미래를 당신에게 맡길 생각이야. 그러기 위해서는 우선 내게 주의 받지 말고, 내게 명령하는 것부터 익숙해지도록 해! 알았지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔네. 자, 전투 회고, 전과 확인, 각 함선의 컨디션 확인… 전에 우선 홍차를 한 잔… 식기 전에 마시자구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/home.ogg"},"hp 경고":{"voiceline":"정비 불량?! 말도 안 돼……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/hp_warning.ogg"},"로그인":{"voiceline":"그럼, 착석! 업무 시작! 척척 처리하자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/login.ogg"},"실패":{"voiceline":"각 함선은 철수하라! …아직 끝나지 않았어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/lose.ogg"},"우편":{"voiceline":"편지 확인! 당신 앞으로 온 거네. 확인해둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/mail.ogg"},"임무":{"voiceline":"임무 통보 확인! 어서 확인해, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/mission.ogg"},"임무완료":{"voiceline":"임무 완료 확인! СПАСИБО! 내가 하기 전에 다 처리해줬구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/mission_complete.ogg"},"서약":{"voiceline":"흐흥, 솜씨가 괜찮은데? 지금은 군인이 아니라, 레이디답게 그 요청에… 아니, 지휘관의 호의에 응해야겠지. 기꺼이♪ 내 미래 꼭 책임지라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/propose.ogg"},"스킬":{"voiceline":"혁명적인 칼 솜씨라는 거지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/skill.ogg"},"터치1":{"voiceline":"매너가 과하면 오히려 무례한 법이지. 언제든 필요하면 편하게 말해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/touch.ogg"},"터치2":{"voiceline":"무, 무슨 짓을?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/touch2.ogg"},"입수시":{"voiceline":"전함 아르한겔스크 등장. 후훗, 정정당당하게 내게 말을 걸다니, 내 취향인데? 당신, 미래가 꽤 밝아 보이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/unlock.ogg"},"강화성공":{"voiceline":"이번에는 제대로 된 근대화 개수…려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"내 승리야. 흐흥, 처음부터 이미 정해진 결과지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"현장 지휘를 맡을 수 있는 당신과, 함대 전체의 방향을 제시하는 나, 이 모항의 미래는 빛으로 가득하다고, 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705060/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"내가 군인으로서가 아닌 레이디의 방식으로 당신과 교류하길 바란다면, 미리 말해줘. 이렇게 갑자기 태도를 바꾸는 건 습관이 안돼서, 곤란한 일이 있을 수 있으니까… 그래서, 이제 데이트 가는 거야?… 하하하, 당신이 아직 적응하지 못한 틈을 타서, 내가 먼저 주도권을 잡아야지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/A