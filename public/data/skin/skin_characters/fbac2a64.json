[{"클뜯 id":101060,"클뜯 함순이 id":10106,"함순이 이름":"크레이븐","한글 함순이 + 스킨 이름":"크레이븐","영문 함순이 + 스킨 이름":"Craven","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101060/shipyard.png","설명":"그리들리급 구축함·크레이븐 (DD-382)","자기소개":{"voiceline":"전 그리들리급 2번함, 크레이븐이라고 해요. 고속 어뢰 구축함으로서 여동생들과 같이 태평양 전장의 최전선을 누비고 다녔어요. 주된 임무는 야전 지원이었죠. 잘 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/profile.ogg"},"메인1":{"voiceline":"휴식시간에도 파이팅 댄스를 게을리해선 안 된다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/main1.ogg"},"메인2":{"voiceline":"노샘프턴, 이 바보! 그렇게 되고서도 맞설 줄이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/main2.ogg"},"메인3":{"voiceline":"파이팅~ 컴온~ 화이트·이글~☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/main3.ogg"},"전투개시":{"voiceline":"모두~ 오늘도 힘차게~ 파이팅이야~☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/battle.ogg"},"상세확인":{"voiceline":"아아앗~ 지휘관님! 다, 다가오시는 게 너무 갑작스럽다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/detail.ogg"},"드랍 설명":{"voiceline":"그리들리급 구축함·크레이븐 (DD-382)","voicelink":null},"의뢰 완료":{"voiceline":"같이 가지는 못했지만, 제 응원은 언제나 여러분에게 닿고 있어요. 자, 마중 나가도록 해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/expedition.ogg"},"실망":{"voiceline":"다른 사람을 응원할 예정이라 오늘은 온종일 외출이랍니다☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/feeling1.ogg"},"낯섦":{"voiceline":"업무 외적으로 하는 응원이요? 무슨 의미일까나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 또 기운이 없으신 모양이네요. 크레이븐이 쓰담쓰담 해드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 원하신다면, 어, 언제든 응원해드릴 수 있다구요… (중얼중얼)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/feeling4.ogg"},"사랑":{"voiceline":"플레이─! 플레이─! 지·휘·관! L·O·V·E! 지·휘·관! 어때요? 크레이븐의 사랑이 담긴 응원, 전해졌나요?~☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"퍼펙트~! 오늘도 완벽하게 시합 종료야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님. 오늘의 하프타임 응원은 맡겨달라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/login.ogg"},"실패":{"voiceline":"흐에에~~ 제 응원, 전해지지 않았나 봐요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/lose.ogg"},"우편":{"voiceline":"새로운 편지예요~ 뭔가 좋은 소식이 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/mail.ogg"},"임무":{"voiceline":"완료하지 않은 미션이 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/mission.ogg"},"임무완료":{"voiceline":"보너스가 도착했어요~ 분명 기뻐할 만한 게 있을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/mission_complete.ogg"},"서약":{"voiceline":"지휘관님 전용 응원 팀을 만들어야겠네…… 네? 물론 치어리더는 크레이븐이 담당할 거라구요? 당신을 향한 마음은 누구한테도 지지 않는걸요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101060/propose.ogg"},"스킬":{"voiceline":