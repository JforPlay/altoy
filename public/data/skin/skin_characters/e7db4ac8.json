[{"클뜯 id":305130,"클뜯 함순이 id":30513,"함순이 이름":"오와리","한글 함순이 + 스킨 이름":"오와리","영문 함순이 + 스킨 이름":"Owari","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305130/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305130/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305130/shipyard.png","설명":"키이급 전함 - 오와리","자기소개":{"voiceline":"키이급 전함 2번함인 오와리야! 건조 계획은 있었지만 이러저러한 사정이니 뭐니로 취소됐는데, 난 그런 거 신경 안 써! 지휘관. 네 밑에서 열심히 할 테니까, 앞으로 잘 부탁해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/profile.ogg"},"메인1":{"voiceline":"엥?! 진짜로 실패한 거…? 으아~ 개짜증나… 아니, 지휘관?! 언제부터 거기에… 보, 보지 마~!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/main1.ogg"},"메인2":{"voiceline":"작전? 난 잘 모르겠지만, 지휘관이 열심히 만든 거지? 좋았어! 그럼, 스루가한테 알려주고 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/main2.ogg"},"메인3":{"voiceline":"다음에 내가 만든 요리 먹으러 오기로 약속했지?! 딱 기대해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/main3.ogg"},"전투개시":{"voiceline":"다 덤벼! 아하핫♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/battle.ogg"},"상세확인":{"voiceline":"다른 동료는 두뇌 담당이니까 나는 힘 쓰는 일 담당인 건가? 복잡한 건 잘 몰라서… 아하핫♪ 바보인 편이 여러모로 편하거든~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/detail.ogg"},"드랍 설명":{"voiceline":"키이급 전함 - 오와리","voicelink":null},"의뢰 완료":{"voiceline":"아, 그래그래. 의뢰하러 나간 애들이 돌아왔다고? 오케이~ 지휘관한테 전해줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/expedition.ogg"},"실망":{"voiceline":"지금 넌… 좀 미묘하달까…? 너무 실망시키지 않았으면 하는 바람인데 말이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/feeling1.ogg"},"낯섦":{"voiceline":"무리한 요구일지도 모르지만, 웬만하면 키이네는 건드리지 마. 문제가 있으면 처음부터 바로 날 찾아와! 난 딱히 귀찮게 생각하지 않으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/feeling2.ogg"},"호감":{"voiceline":"지휘관은 지금 일 안 했으면, 어떤 일 했을 거 같아? 나는 가게 같은 것도 재밌을 것 같아. 제철 과일 같은 걸 파는… 관심 있으면 같이 할래? 내가 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/feeling3.ogg"},"기쁨":{"voiceline":"어떤 일이든 처음부터 잘 풀리는 건 없어. 전투도 그렇고 연애도 곁에 오래 있어야 자연스럽게… 무슨 얘기냐고? 저, 정말! 지휘관이라는 양반이 눈치가 너무 없는 거 아니야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/feeling4.ogg"},"사랑":{"voiceline":"으… 어쩌지… 지휘관이 신경 쓰여서 일이 손에 안 잡혀… 큰일이야…… 이렇게 된 이상, 각오하고 정면으로 부딪치는 수밖에! 지휘관, 좋아…… 으윽//// 여, 역시 조금 더 마음의 준비가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/feeling5.ogg"},"터치3":{"voiceline":"응? 왜 그래? 내 머리 쓰다듬어봤자 아무것도 안 나오거든? 뭐, 그래도 그거… 꽤 기분 좋네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/headtouch.ogg"},"모항귀환":{"voiceline":"아, 지휘관! 왜 그래? 피곤한 것 같은데… 그렇게나 기 빨리는 전장이었어? 그럼, 힐링하러 찻집이나 갈까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/home.ogg"},"hp 경고":{"voiceline":"이 정도로 약한 소리를 하면, 키이급의 이름에 먹칠을 하는 꼴이야….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/hp_warning.ogg"},"로그인":{"voiceline":"오~ 지휘관, 마침 잘 왔어. 오늘 쩌는 채소가 들어왔는데, 같이 맛보지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/login.ogg"},"실패":{"voiceline":"으엑~ 완전 개짜증나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/lose.ogg"},"우편":{"voiceline":"지휘관, 네 앞으로 우편이 왔네. 빨리 확인하는 편이 좋을걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/mail.ogg"},"임무":{"voiceline":"엥? 아직 임무 안 끝난 거야? 무슨 일 있어? 음~ 바빠서 그런 거면 내가 도와줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/mission.ogg"},"임무완료":{"voiceline":"어라? 여기 임무는 끝났네… 설마 모르고 있었던 건… 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/mission_complete.ogg"},"서약":{"voiceline":"정말! 언제 어디서든 계속 신경이 쓰인다고 할까, 지휘관의 존재 자체가 신경 쓰인다고 할까… 어쨌든 지휘관한테 완전 푹 빠졌다고! 이렇게 되면… 어쩔 도리가… 없잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/propose.ogg"},"스킬":{"voiceline":"이거 지금 유행하는 거거든~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/skill.ogg"},"터치1":{"voiceline":"뭐야~ 나랑 팔짱이라도 끼고 싶은 거야? 좋아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/touch.ogg"},"터치2":{"voiceline":"나 같은 거 만지면 재밌어? 그렇구나♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/touch2.ogg"},"입수시":{"voiceline":"난 오와리야! 네가 이 함대의 대장…이 아니라, 지휘관인 거지? 아하하핫, 앞으로 잘 부탁해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/unlock.ogg"},"강화성공":{"voiceline":"우와~ 대박… 이거 진짜 개쩌는데?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우리의 끈끈한 인연을 얕보지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/win_mvp.ogg"},"전투개시_ex":{"voiceline":"내 멋진 모습, 완전 기대하고 있으라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/battle_ex.ogg"},"상세확인_ex":{"voiceline":"난 머리는 그렇게 좋지 않지만, 뭐… 지휘관한테는 안 질걸? ……사랑에 빠지면 바보가 된다는 말도 있잖아? 나는 바뀐 게 없으니까, 지휘관만 바보가 됐을 수도…… 아하핫♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관 옆에 서면 안절부절하고… 평소의 내가 아니게 된다고 할까… 무서워! 어쩌다 이렇게 된 거지… 지휘관은 알겠어? 흐음… '상사병'이라고 한다고…? 그게 뭔데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 오늘은 같이 있을 수 있는 거지? 완전 기대하고 있었으니까, 어떤 걸 당할지 각오하고 있으라고♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"이거 실화야?! 지휘관이 임무를 남기다니?! 혹시 어디 아파? 아니면 천재지변의 전조…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/mission_ex.ogg"},"임무완료_ex":{"voiceline":"아, 여기 임무도 끝났네… 우와~ 역시 지휘관, 유능캐야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"음… 주변에 누가 있는 건… 휴~ 큰일 날뻔했네. 아무리 나라도 이런 걸 다른 사람이 보면 큰일이라고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"어때? 내가 일잘러인 거, 이제야 알겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['키이'] : 키이, 끝나면 놀러 갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/couple_encourage1.ogg"},{"voiceline":"['스루가'] : 으으, 난 스루가처럼 똑똑하지 않다고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/couple_encourage2.ogg"}],"메인4":{"voiceline":"으… 망했어…! 나는 이런 퍼즐 같은 거 무리라구~ …키이~ 도와주라~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305130/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관 앞에 서면 진