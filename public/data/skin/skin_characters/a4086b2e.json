[{"클뜯 id":304060,"클뜯 함순이 id":30406,"함순이 이름":"꼬마 히에이","한글 함순이 + 스킨 이름":"꼬마 히에이","영문 함순이 + 스킨 이름":"Hiei-chan","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304060/shipyard.png","설명":"콩고형 고속전함 2번함 - 히에이 ","자기소개":{"voiceline":"콩고급 히에이에요. 후훗, 콩고 언니가 돌아오면, 우리 콩고급이 분명 세계를 깜짝 놀라게 할 테니까, 그때까지 히에이도 한사람 몫을 해야지! ……하지만 예의라든가, 예법이라든가, 히에이에게는 조금 어려운걸…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/profile.ogg"},"메인1":{"voiceline":"연회? 응, 좋아요! 어디에서……. 앗, 이런 걸 생각할 때가 아니에요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/main1.ogg"},"메인2":{"voiceline":"히에이의 언니는 로열에서 유, 유학을 한 적이 있어요! 흥, 유학이 뭔지 모르시죠?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/main2.ogg"},"메인3":{"voiceline":"멍하니 있으면 이걸로 때릴 거에요! 엄청 아프다고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/main3.ogg"},"전투개시":{"voiceline":"흥, 히에이는 지지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/battle.ogg"},"상세확인":{"voiceline":"어째서 히에이를 뚫어져라 쳐다보는 거죠……? 검이 너무 무겁지 않냐고요? 히에이는 혼자서도 괜찮아요! 걱정할 필요 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/detail.ogg"},"드랍 설명":{"voiceline":"콩고형 고속전함 2번함 - 히에이","voicelink":null},"의뢰 완료":{"voiceline":"의뢰을 완료했습니다. 히에이가 여러분을 맞이하고 올게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/expedition.ogg"},"실망":{"voiceline":"콩고 언니! 이제 이 지휘관님과는 만나고 싶지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/feeling1.ogg"},"낯섦":{"voiceline":"히에이는 혼자서도 괜찮아요. 지휘관님은 다른 일을 해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/feeling2.ogg"},"호감":{"voiceline":"저, 저기……. 으으……. 그게, 지휘관님, 여기를 모르겠는데……. 히에이에게 가르쳐 주시겠어요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/feeling3.ogg"},"기쁨":{"voiceline":"다음 연회의 준비는 히에이에게 맡긴다고요? 정말인가요?! 히에이, 실망시키지 않을게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 히에이의 연회는 어땠나요? 만족하셨어요? 에헤헤, 다음에는 더 열심히 할 테니까, 꼭 와 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격 고생하셨어요. ……그보다, 지휘관님을 마중하는 히에이의 지금 모습은 괜찮은가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/home.ogg"},"hp 경고":{"voiceline":"히에이는 어중간한 일은 하지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/hp_warning.ogg"},"로그인":{"voiceline":"평안하신……, 아윽?! 손잡이에 부딪혔어요……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/login.ogg"},"실패":{"voiceline":"……으으, 겨, 겨우 이 정도의 실패, 히에이는 딱히…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/lose.ogg"},"우편":{"voiceline":"새로운 메일……. 혹시 소집?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/mail.ogg"},"임무":{"voiceline":"임무 완수는 자랑스러운 일이라고 생각해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/mission.ogg"},"임무완료":{"voiceline":"보상을 받을 때는 당당하게 가슴을 펴야죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/mission_complete.ogg"},"서약":{"voiceline":"후후후, 놀라셨어요? 실은 이 연회는 모두 지휘관님을 위해서 준비한 거예요. 히에이에게 있어서 오늘은 중요한 날이니까요. 게다가, 그……. 지, 지휘관님도 히에이에게 소중한 분이니까! ……허억, 허억, 제대로 말했어요……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/propose.ogg"},"스킬":{"voiceline":"거, 거친 파도와 함께 사라지세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/skill.ogg"},"터치1":{"voiceline":"무슨 일이 생기면 히에이에게 맡겨 주세요. 이것도 수행의 일환이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/touch.ogg"},"터치2":{"voiceline":"이, 이이, 이 파렴치한!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/touch2.ogg"},"입수시":{"voiceline":"지휘관님? 히에이는 더 높으신 분을 모시는 것을 목표로 하고 있어요! 음, 뭐, 지휘관님을 수행 상대로 삼아도 나쁘지 않겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/unlock.ogg"},"강화성공":{"voiceline":"히에이는 실망시키지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 정도의 승리, 히에이에게는 아무 것도 아니에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['히에이'] : 왠지 마음이 따뜻해져요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/couple_encourage1.ogg"},{"voiceline":"['콘고'] : 콩고 언니! 잘 부탁해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304060/couple_encourage2.ogg"},{"voiceline":"['미카사'] : 미, 미카사 님! 오늘의 메뉴는 뭘로 할까요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/