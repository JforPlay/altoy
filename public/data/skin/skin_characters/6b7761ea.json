[{"클뜯 id":301250,"클뜯 함순이 id":30125,"함순이 이름":"아리아케","한글 함순이 + 스킨 이름":"아리아케","영문 함순이 + 스킨 이름":"Ariake","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301250/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301250/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301250/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301250/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301250/shipyard.png","설명":"하츠하루급 구축함 5번함·아리아케","자기소개":{"voiceline":"유구레, 시라츠유, 시구레랑 같이 제27 구축대 소속이었어~ 내가 제일 빨리 기공되었으니 뭐 언니 역할이었지. 모두 다 함께 싸웠으니 사이도 좋아. 마지막엔 시구레만 남게 되었지만, 뭐 전쟁이니 별수 없지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/profile.ogg"},"메인1":{"voiceline":"지휘관 그거 알아? 아리아케급으로 따지고 보면, 시라츠유도 시구레도 내 동생이라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/main1.ogg"},"메인2":{"voiceline":"지휘관, 평소에 생활습관을 제대로 하지 않으면 나중에 고생한다니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/main2.ogg"},"메인3":{"voiceline":"지휘관? 도시락 먹을래? 유구레 몫을 만들 때 같이 만들어줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/main3.ogg"},"전투개시":{"voiceline":"눈을 크게 뜨고, 공습에 주의하라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/battle.ogg"},"상세확인":{"voiceline":"유구레 처럼 자립하고 싶어~ 아냐…그것도 나름대로 좀 외로울지도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/detail.ogg"},"드랍 설명":{"voiceline":"하츠하루급 구축함 5번함·아리아케","voicelink":null},"의뢰 완료":{"voiceline":"지휘관이 멍하니 있을 때, 의뢰는 벌써 완료되었는걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/expedition.ogg"},"실망":{"voiceline":"지휘관한테도 사춘기라는 게 있었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/feeling1.ogg"},"낯섦":{"voiceline":"아리아케급? 아! 있었어 그런거! 근데 원래대로 돌아오지 않았었나? 난 딱히 괜찮은데? 유구레는, 뭐……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/feeling2.ogg"},"호감":{"voiceline":"유구레는 가끔 너무 들러붙을 때가 있지만, 뭐 동생 귀엽다는 게 다 그런거지. 지휘관도 누가 들러붙고 그러면 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/feeling3.ogg"},"기쁨":{"voiceline":"유구레랑 시라츠유, 그리고 시구레를 돌봐주었으니 말야……이제부터 들러붙어 줘~ 라고 해도 좀 어려울지도…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/feeling4.ogg"},"사랑":{"voiceline":"응응, 곰곰이 생각해봤는데 지휘관의 여동생이 되는 것도 괜찮을지도? 지휘관은 어떻게 생각해? 나, 집안일 능력이 뛰어난 재주있는 여동생이 될 수 있다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/home.ogg"},"hp 경고":{"voiceline":"좀…좋지 않은데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 수고했어~ 오늘은 조금 바빠질지도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/login.ogg"},"실패":{"voiceline":"수리하는 게 아니었으면 도크에 틀어박혀 있는 것도 싫진 않은데 말이지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/lose.ogg"},"우편":{"voiceline":"지휘관, 우편은 눈에 띄는 곳에 놔뒀으니까, 나중에 읽어줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/mail.ogg"},"임무":{"voiceline":"새로운 임무네. 수송 임무 같은 거 없어? 나, 꽤 잘하니까 말야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/mission.ogg"},"임무완료":{"voiceline":"그러고 보니, 유구레는 임무를 마쳤을 때 항상 보고하러 와줬던가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/mission_complete.ogg"},"서약":{"voiceline":"집안일 능력이 뛰어난 재주있는 여동생은 역시 수요가 있네…그치만 좀 부끄러울지도♪…후후, 앞으론 더욱 내게 기대도 좋다구. 여동생이고 아니고를 떠나서, 집안일 능력은 꽤 자신 있으니까 말야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/propose.ogg"},"스킬":{"voiceline":"지금이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/skill.ogg"},"터치1":{"voiceline":"유구레도 참… 옷 좀 잡아당기지 마, 지금 갈테니까……어라라? 지휘관을 유구레랑 착각했네?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/touch.ogg"},"터치2":{"voiceline":"정말이지, 지휘관은 애가 아니니까, 좀 조심하는 게 좋다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/touch2.ogg"},"입수시":{"voiceline":"하츠하루급의 아리아케야. 지휘관 좋은 아침~ 아, 맞다! 유구레는 여기 있으려나? 있으면……괜히 폐 끼치지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/unlock.ogg"},"강화성공":{"voiceline":"대공은 중요해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/upgrade.ogg"},"vote":null,"승리":{"voiceline":"MVP인가……도움만 될 수 있으면 만만세! 라고 생각했었는데 말이지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['유구레'] : 좋아좋아, 유구레, 전투개시야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/couple_encourage1.ogg"},{"voiceline":"['시구레'] : 시구레, 또 장난칠 생각하고 있었지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301250/couple_encourage2.ogg"},{"voiceline":"['시라츠유'] : 시라츠유, 따라와","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLa