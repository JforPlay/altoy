[{"클뜯 id":101110,"클뜯 함순이 id":10111,"함순이 이름":"찰스 오스본","한글 함순이 + 스킨 이름":"찰스 오스본","영문 함순이 + 스킨 이름":"Charles Ausburne","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101110/shipyard.png","설명":"플레처급 구축함·찰스 오스본 (DD-570)","자기소개":{"voiceline":"플레처급 찰스 오스본이야. 그 유명한 리틀·비버즈의 대장으로서, 세인트·조지 곶 해역에서 활약했어. 흐흥, 지휘관도 정의의 편이 되어보지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/profile.ogg"},"메인1":{"voiceline":"나와 함께, 정의의 편이 되어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/main1.ogg"},"메인2":{"voiceline":"정의는… 정의야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/main2.ogg"},"메인3":{"voiceline":"음… 레이더에 따르면, 지휘관, 지금 두근거리고 있지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/main3.ogg"},"전투개시":{"voiceline":"자, 비버즈, 31노트 고속 출격이야! 이번엔 측면을 적 신사분들께 보여주지 않도록! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/battle.ogg"},"상세확인":{"voiceline":"무기를 장착하는 이유는, 정의의 철퇴를 내리기 위해서야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함·찰스 오스본 (DD-570)","voicelink":null},"의뢰 완료":{"voiceline":"정의의 군사의뢰, 지금 막 완료했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/expedition.ogg"},"실망":{"voiceline":"지휘관, 이 악의 화신 같으니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 세상엔 정의롭지 못한 것이 아직 많이 있으니까, 멈춰 서있을 수는 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/feeling2.ogg"},"호감":{"voiceline":"정의의 편으로 있는다는 건 꽤나 어려운 일이야. 하지만 지휘관은 이 오스본이 옆에 있으니까, 분명 괜찮을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/feeling3.ogg"},"기쁨":{"voiceline":"정의의 길은 고독의 길이야. 동반자가 있다는 것 자체가 드문 일이니까, 그러니까… 그… 저… 지, 지휘관이… 정의에 관한 이야기라도 읽어보라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/feeling4.ogg"},"사랑":{"voiceline":"이야기 속 정의의 히어로는 동료들과 함께 악을 물리치고 나서, 일상 생활로 돌아가는 길을 선택해. 지금까지 싸워왔던 동료로서의 길을 계속 걷는 경우는 극히 드물어. 이런 얘기는 언제 들어도, 조금 슬프단 말이지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격대의 모두들, 고생 많았어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/home.ogg"},"hp 경고":{"voiceline":"정의는 불멸이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/hp_warning.ogg"},"로그인":{"voiceline":"안녕, 지휘관. 리틀·비버즈의 대장, 오스본이 왔어. 오늘은 대체 어떤 짓궂은 아이가 내 심판을 기다리고 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/login.ogg"},"실패":{"voiceline":"…다시 돌아올 거야! 정의는 반드시 이기니까! 으윽…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/lose.ogg"},"우편":{"voiceline":"편지인가. 서로의 버팀목이 되는 것이야말로 정의인 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/mail.ogg"},"임무":{"voiceline":"지휘관, 단숨에 해치워버리자! 이건 정의를 실천할 수 있는 좋은 기회야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/mission.ogg"},"임무완료":{"voiceline":"보너스가 내려왔어. 열심히 한 대가를 받는다는 건 정말 기쁜 일이야, 그렇게 생각하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/mission_complete.ogg"},"서약":{"voiceline":"…정말 내게 줘도 괜찮은 거야? …그래. 지휘관, 날 선택해준 거구나… 응! 마지막까지 함께 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/propose.ogg"},"스킬":{"voiceline":"정의의 심판을 받아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/skill.ogg"},"터치1":{"voiceline":"음… 정의의 힘이 전해져오는 것이 느껴져!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/touch.ogg"},"터치2":{"voiceline":"!!… 우와, 이… 사악한 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/touch2.ogg"},"입수시":{"voiceline":"만나서 반가워, 지휘관.  리틀·비버즈의 대장, 오스본이야. 짓궂은 아이는 어디 있어? 얌전히 나의 심판을 받는 게 좋을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/unlock.ogg"},"강화성공":{"voiceline":"이것이… 정의의 힘이야─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"잘 알았겠지! 이것이 리틀·비버즈의 실력이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"\"악을 무찌른 후에도 정의의 동료들은 산산이 흩어지지 않았다. 그들은 함께 싸운 유대로 끈끈하게 맺어져, 행복하게 살았다.\" 좋아! 이건 내가 생각한 결말이야! 대단하지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"출격 나간 모두들 수고 많았어! 정의를 집행하는 것도 좋지만, 지휘관도 휴식하는 걸 잊지 말도록!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"리틀 비버스의 대장 오스본 등장이야! 같은 정의의 동료로서, 오늘도 힘내자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"오오! 따뜻한 정의의 파워가 전해져 오고 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/touch_ex.ogg"},"터치2_ex":{"voiceline":"이, 이런 건 정의의 범위에는 안 들어갈 거 같은데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"윈! 오브! 저스티스! 헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['대처', '얼릭', '푸트', '스펜스'] : 비버즈, 31노트 전속 전진!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/couple_encourage1.ogg"},{"voiceline":"['대처', '심즈'] : 짓궂은 아이는 누구지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"정의는 악을 해치우기 위해서만 있는게 아니라, 소중한 지금을 지키기 위해서도 존재해! 우리 함께 이 아름다운 바다를 지키자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/main5_ex.ogg"},"메인6_ex":{"voiceline":"레이더에 따르면 지휘관은 지금 두근두근하고 있다고 해…어, 어라? 왜 나까지 두근두근하는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"정의의 동료랑 둘이서 같이 모험을 하면, 유대가 돈독해진다고 들은 적이 있어. …데이트? 무슨 말이야…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101110/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":1},{"클뜯 id":101119,"클뜯 함순이 id":10111,"함순이 이름":"찰스 오스본","한글 함순이 + 스킨 이름":"찰스 오스본•改","영문 함순이 + 스킨 이름":"Charles Ausburne (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101119/painting.png","확대 일러":"https:/