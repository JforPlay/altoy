[{"클뜯 id":206020,"클뜯 함순이 id":20602,"함순이 이름":"아거스","한글 함순이 + 스킨 이름":"아거스","영문 함순이 + 스킨 이름":"Argus","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206020/shipyard.png","설명":"경항공모함 - 아거스","자기소개":{"voiceline":"\"세계에서 가장 오래된 항공모함 중 하나, 내 이름은 아거스. 로열 네이비의 영광, 전통과 함께 귀공 곁에 머물며, 차세대 영웅들을 이끌겠노라――\" ……뭐, 그리 대단할 건 없지만요. 잘 부탁…드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/profile.ogg"},"메인1":{"voiceline":"\"내 가장 영광스럽고 가장 오래된 힘 앞에서――\" ……저, 저기, 사무 업무는 그... 좀 쉬운 걸로 부탁드릴 수 있을까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/main1.ogg"},"메인2":{"voiceline":"호쇼 씨? 아, 간식 감사합니다! '사쿠라 엠파이어의 다과'라면 다과회에서 내오는 과자랑 같은 건가요? 아니라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/main2.ogg"},"메인3":{"voiceline":"외출하시는 건가요? 네, 집 보는 건 아거스에게 맡겨주세… 아, 너무 늦게 돌아오시면 통금 시간에….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/main3.ogg"},"전투개시":{"voiceline":"훈련함… 아니, 경항공모함 아거스, 진격합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/battle.ogg"},"상세확인":{"voiceline":"\"들어 오거라. 아거스의 영광스러운 역사, 그리고 전통을 그 눈으로――\" ……누, 눈으로 ……봐 주시면 감사하겠습니다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/detail.ogg"},"드랍 설명":{"voiceline":"경항공모함 - 아거스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔습니다. 함재기들과 마찬가지로, 한번 떠나보낸 아이들이라면 마중도 제대로 해줘야겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/expedition.ogg"},"실망":{"voiceline":"…! 볼일 없으시면, 이만 실례하겠습니다! 휴우…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/feeling1.ogg"},"낯섦":{"voiceline":"\"무수히 많은 병아리를 떠나 보낸 로열 네이비의 옛 지혜로 지휘관을 이끌리…\" ……아거스라도 괜찮으시면, 지휘관님을 지도해드려도 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/feeling2.ogg"},"호감":{"voiceline":"휴일에 에스코트를 해주신다구요? 네, 지휘관님께 폐가 되지 않는다면, 말씀에 따르도록 하겠습니다. …아, 통금 시간 전까지는 숙소로 꼭 데려다주셨으면 하는데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/feeling3.ogg"},"기쁨":{"voiceline":"오늘 하루도 감사했습니다, 지휘관님. 아, 벌써 시간이… 슬슬 숙소로 돌아가야 하지만, 마, 마지막으로 잠깐만 산책을 했으면 하는데요! …죄송해요. 제 어리광, 받아주시겠어요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/feeling4.ogg"},"사랑":{"voiceline":"휴우… 에헤헷. 통금 시간을 훌쩍 넘기고 말았네요♪ 저기, 지휘관님? 조금만 더 단둘이서 느긋하게, 함께 밤하늘을 바라보지 않으실래요? 이제 와서 로열 네이비 숙소로 돌아간들 아무 소용 없으니까요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/feeling5.ogg"},"터치3":{"voiceline":"새 모자를 만들어 주시려구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/headtouch.ogg"},"모항귀환":{"voiceline":"휴우.. 어서 오세요, 지휘관님. 저도.. 하아, 하아… 겨우 통금시간에 맞춰서 돌아왔어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/home.ogg"},"hp 경고":{"voiceline":"로, 로열 네이비의 전통과 영광이…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 업무를 시작하죠. 슬슬 시간이 되었으니, 여기서 더 쉬는 건 좀 곤란하다고 해야 할까요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/login.ogg"},"실패":{"voiceline":"윽… 이건 제게 내리는 징벌인가요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/lose.ogg"},"우편":{"voiceline":"우편이 있네요. 봉투는… 음, 가위로 잘라서 여는 편이 좋겠죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/mail.ogg"},"임무":{"voiceline":"임무 연락이 왔습니다. 확인 안 해도 괜찮을까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐습니다. 휴우… 다행이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/mission_complete.ogg"},"서약":{"voiceline":"로열 네이비의 전통과 영광에 걸고 맹세합니다. 항공모함 아거스는 앞으로 두 사람의 행복을 위해 온 힘을 다하겠다고…… 지휘관님, 아거스의 손… 잡아주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/propose.ogg"},"스킬":{"voiceline":"무사히 돌아오세요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/skill.ogg"},"터치1":{"voiceline":"가르침을… 주시려는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/touch.ogg"},"터치2":{"voiceline":"사, 살살 부탁 드립니다…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/touch2.ogg"},"입수시":{"voiceline":"\"모든 것을 꿰뚫고 있는 백 개의 눈의 가장 오래된 표준 항공모함이자 최초의 전통식 항공모함, 로열의 아거스\"——이, 이제 됐나요…? 죄송합니다, 자기소개에는 소질이 없어서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/unlock.ogg"},"강화성공":{"voiceline":"\"골백번 강해진 내 의장이 이걸로――\" ……이걸로 제대로 싸울 수 있게 된다면 좋겠네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"제가 MVP? 거짓말 아니죠…? 믿어지지 않아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/win_mvp.ogg"},"전투개시_ex":{"voiceline":"저도 싸울 수 있다는 걸 증명하겠어요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/battle_ex.ogg"},"상세확인_ex":{"voiceline":"얼마 전에 외출할 때 입었던 옷은 여기 있어요. 다림질을 미리 해둬서 주름 하나 없답니다~ 후후후, 이건… 다음에 외출할 때 입을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔어요. 저희에게 돌아갈 집은 지휘관님 곁인걸요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"어서 오세요, 지휘관님. 약속대로 이기고 돌아오셨네요. 참 잘했어요~ 쓰담쓰담~ 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"쿨쿨… 아! 벌써 업무 시간인가요? 늦잠자서 죄송합니다…. 아아.. 비서함 담당이 된 게 너무 기뻐서 밤을 꼴딱 새웠어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"…앗. 임무 연락이 왔었나요? 그, 그렇군요… 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"에스코트를 부탁드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/touch_ex.ogg"},"터치2_ex":{"voiceline":"귀여워해주세요. 응응.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"\"너희의 패배는 이미 백 개의 눈이 꿰뚫어 보았나니\"――지휘관님도 꿰뚫어 보셨다구요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['허미즈', '호쇼', '랭글리'] :  가장 오래된 항공모함의 힘을 보여주죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"후드 님, 오늘은 평소보다 더 아름다우시네요. 지휘관님도 평소보다 더 멋져 보이… 아니, 평소보다 멋지세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/main5_ex.ogg"},"메인6_ex":{"voiceline":"외출하시는 거면 아거스도 함께 할 수 있게 해주세요. 이유는… 음, 데이트하고 싶은 기분이라서요! 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"아… 여기 숫자에는 확실히 문제 없을까요…. 랭글리네한테 도와달라고 하면 비서함으로서 실격이겠죠…. 아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206020/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":1},{"클뜯 id":206021,"클뜯 함순이 id":20602,"함순이 이름":"아거스","한글 함순이 + 스킨 이름":"날 밝은 줄 모르는 숙면","영문 함순이 + 스킨 이름":"A Hundred Sleepless Eyes","스킨 타입":"School Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206021/shipyard.png","설명":"하암… 아… 제가 또 잠들었나요…? 음… 학원 행사를 준비하느라 바빠서 매번 일하는데 너무 급급하네요… 1분만 더 자게 해주세요…","자기소개":null,"메인1":{"voiceline":"에취! …감사합니다. 하긴 여기서 계속 자면 감기에 걸리고 말겠죠. 정신 차려야지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206021/main1.ogg"},"메인2":{"voiceline":"유령의 집에서 괴이한 사건이…? 지, 지휘관님. 죄송하지만 같이 조사하러 가주시겠어요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206021/main2.ogg"},"메인3":{"voiceline":"임플래커블 씨! 그 게임은 혼자서 즐기시는 건 괜찮지만, 학교 축제에는 제출하시면 안 돼요! 왜냐니요? 너, 너무 상스럽잖아요! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206021/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"학교 행사 주최… 정말 힘드네요. 게다가 어쩌다 보니 