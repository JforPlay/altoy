인":{"voiceline":"\"자, 보아라. 파티에 임하는 아거스의 장엄하고 우아한 모습을――\" ……파티장에서 사람들을 대하는 연습도 지휘관님이 상대라면 안심이 되네요, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/detail.ogg"},"드랍 설명":{"voiceline":"\"영광스러운 로열 네이비의 예복, 그 빛나는 위용을 감탄하며, 숭상하라. 그리고…\" 음… 드레스를 입은 아거스의 손… 잡아 주시겠어요…?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 애들이 돌아왔네요. 파티에 부르는 게 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"직접 골라주신 드레스니까 잘 소화해야 할 텐데… 지휘관님? 어서 오세요. 작전은 순조로우셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"이러면 될까요? 역시 한번 휙 돌아보는 편이…… 꺅?! 지, 지휘관님, 죄송해요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무 연락이요…? 네, 넵! 어디 뒀더라…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"잘 어울리는 것 같아요…? 지휘관님, 신경 쓰이는 부분은 없으세요? 마, 만져보셔도… 괜찮아요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/touch.ogg"},"터치2":{"voiceline":"사, 상냥하게 해주세요……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/touch2.ogg"},"입수시":{"voiceline":"\"영광스러운 로열 네이비의 예복, 그 빛나는 위용을 감탄하며, 숭상하라. 그리고…\" 음… 드레스를 입은 아거스의 손… 잡아 주시겠어요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"\"이 복장이야말로 우리의 개선 퍼레이드에 적합하리라.\"―― 휴우……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206022/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실