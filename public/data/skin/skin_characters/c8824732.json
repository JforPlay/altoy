[{"클뜯 id":102320,"클뜯 함순이 id":10232,"함순이 이름":"보이시(μ장비)","한글 함순이 + 스킨 이름":"보이시(μ장비)","영문 함순이 + 스킨 이름":"Boise μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102320/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102320/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102320/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102320/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102320/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102320/shipyard.png","설명":"\"Cyanidin\" 소속 경순양함 보이시… 후~ 하~ 후~ 하~ 음… 이 모습이면 지휘관의 관심을 더 잘 끌 수… 있으려나? …그럼 다행이네. ///","자기소개":{"voiceline":"보이시, 아이돌 활동을 시작한 게… 마치 꿈을 꾸는 것 같아… 후~ 하~ 후~ 하~ 열심히 해서 지휘관에게도 꿈 같은 무대를 보여줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/profile.ogg"},"메인1":{"voiceline":"후~ 하~ 후~ 하~ …무대 의상에 더 잘 어울리는 마스크로 바꿨는데… 이쪽이 더 자연스러운 것… 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/main1.ogg"},"메인2":{"voiceline":"아, 아이돌이니까 계속 마스크를 착용하고 있어도 되지 않을까…? 무대에서 벗는 건 아직 익숙하지 않아서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/main2.ogg"},"메인3":{"voiceline":"안무 스텝이 좀 어려워…… 그, 그래도 열심히 연습할 거야. 지휘관이 기대하고 있으니까…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/main3.ogg"},"전투개시":{"voiceline":"후~ 진지하게 해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/battle.ogg"},"상세확인":{"voiceline":"후… 아이돌 활동은 매일 레슨을 잔뜩 받아야 해서 힘들어…… \"Cyanidin\" 멤버들은 다 잘하니까… 내가 발목을 잡지 않도록 노력해야 해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/detail.ogg"},"드랍 설명":{"voiceline":"\"Cyanidin\" 소속 경순양함 보이시… 후~ 하~ 후~ 하~ 음… 이 모습이면 지휘관의 관심을 더 잘 끌 수… 있으려나? …그럼 다행이네. ///","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰팀이 돌아왔어. 보이시, 아이돌 활동을 하고는 있지만… 그래도 사람이 붐비면 불편해…… 가, 같이 마중하러 나가자……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/expedition.ogg"},"실망":{"voiceline":"지휘관…… 자꾸 이러면 내 무대는 보여줄 수 없어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/feeling1.ogg"},"낯섦":{"voiceline":"처음 무대를 서려니 긴장되네…… 그렇지만 우리… 지금까지 열심히 레슨 해왔으니… 반드시 라이브를 성공시킬 거야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/feeling2.ogg"},"호감":{"voiceline":"보이시는 아이돌로서도 잘하고 있다고? 지휘관이 그렇게 말해주니까… 나, 더 열심히 할게…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/feeling3.ogg"},"기쁨":{"voiceline":"지휘관을 위해 준비한 1등석은 여기야. 조금 있으면 라이브가 시작되는데…… 응. 지휘관을 위한 라이브니까 놓치지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/feeling4.ogg"},"사랑":{"voiceline":"왜 이렇게 열심히 연습하냐고? 그건… 내 빛나는 무대에서… 지휘관에게 최고의 라이브를 보여주고… 싶으니까///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/feeling5.ogg"},"터치3":{"voiceline":"이 머리 장식… 잘 어울려?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와, 지휘관. 지, 지금은 새로운 안무를 연습하는 중인데… 혹시 괜찮으면 지휘관도 볼래…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/home.ogg"},"hp 경고":{"voiceline":"무대에서 넘어지면 역시 아파…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/hp_warning.ogg"},"로그인":{"voiceline":"후~ 하~ …자연의 냄새, 그리고 살짝… 아주 살짝… 아, 평소 지휘관 냄새였네. 지휘관, 좋은 아침이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/login.ogg"},"실패":{"voiceline":"졌어… 레슨이 부족했던 걸까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 우편이 왔어. 방금 안무 연습을 연습하다가, 우편을 지나가던 토끼에게 뺏길 뻔했어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/mail.ogg"},"임무":{"voiceline":"지휘관, 매일 임무를 처리하는 건 중요해. 무대에 서기 전 레슨처럼 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/mission.ogg"},"임무완료":{"voiceline":"임무를 완료했어. 지휘관도 이미 알고 있지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/mission_complete.ogg"},"서약":{"voiceline":"이런… 꿈같은 상황에서 이걸 주면… 가슴이 너무 두근거리잖아… 후~ 하~ 후~ 하~ 아, 아직 미숙하지만… 지휘관을 위해 더 열심히 노력할게///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/propose.ogg"},"스킬":{"voiceline":"이 리듬으로…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/skill.ogg"},"터치1":{"voiceline":"이번 의상 테마는 동화야. 지휘관은… 마음에 들어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/touch.ogg"},"터치2":{"voiceline":"후~ …지, 지휘관. 꼭 지금 이래야… 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/touch2.ogg"},"입수시":{"voiceline":"\"Cyanidin\" 소속 경순양함 보이시… 후~ 하~ 후~ 하~ 음… 이 모습이면 지휘관의 관심을 더 잘 끌 수… 있으려나? …그럼 다행이네. ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/unlock.ogg"},"강화성공":{"voiceline":"호흡도 안정된 느낌이야. 더 열심히 해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/upgrade.ogg"},"vote":null,"승리":{"voiceline":"베스트 퍼포먼스… 우리의 승리야. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102320/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":