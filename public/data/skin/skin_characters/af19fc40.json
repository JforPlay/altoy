[{"클뜯 id":602020,"클뜯 함순이 id":60202,"함순이 이름":"주세페 가리발디","한글 함순이 + 스킨 이름":"주세페 가리발디","영문 함순이 + 스킨 이름":"Giuseppe Garibaldi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/602020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/602020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/602020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/602020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/602020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/602020/shipyard.png","설명":"두카 델리 아브루치급 경순양함 - 주세페 가리발디","자기소개":{"voiceline":"조약형 순양함의 최종 발전형…이었나? 그랬긴 한데, 여러모로 그 대전에서 활약보단, 그 후에 더 빛을 발하긴 했어. 흐음, 그렇게 내가 궁금해? 내 전적? 아니면 탑재 중인 병장 같은 거?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/profile.ogg"},"메인1":{"voiceline":"헤에, 귀족의 책무? 멍멍이나 주라 그래~ 아브루치 언니랑 다르단 말이야, 난.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/main1.ogg"},"메인2":{"voiceline":"별로 중요해보이지 않는 건 대충 해버려. 뭐 틀려도 누가 수정해주겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/main2.ogg"},"메인3":{"voiceline":"다과회라…. 평소에 잘 맞을 것 같은 사람 쪽에 가고는 해~ 지휘관, 궁금해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/main3.ogg"},"전투개시":{"voiceline":"착착 해치우자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/battle.ogg"},"상세확인":{"voiceline":"거기 멀뚱히 서서 뭐해? 편하게 있어. 내가 지휘관을 잡아 먹을 것도 아니고…. 아니면 지휘관도 귀족 매너 같은 걸 신경 쓰는 타입이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/detail.ogg"},"드랍 설명":{"voiceline":"두카 델리 아브루치급 경순양함 - 주세페 가리발디","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐잖아. 나는 까먹어도 지휘관이 까먹으면 안 되지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/expedition.ogg"},"실망":{"voiceline":"지휘관이라고 해도, 결국은 이정도 밖엔 안 된다는 건가. 흥.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/feeling1.ogg"},"낯섦":{"voiceline":"나, 지휘관의 명령대로 움직이긴 할 건데, 그 외에는 딱히 바라지 않는 편이 좋지 않아? 그 편이 서로 편하기도 하고, 무엇보다 아브루치 언니처럼 너무 답답하게 구는 건 지휘관도 싫잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/feeling2.ogg"},"호감":{"voiceline":"고귀한 자의 책무 어쩌고를 딱히 못한다는 건 아니야…. 그러면 내가 무슨 바보 같잖아. 지휘관은 편하게 살고 싶지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/feeling3.ogg"},"기쁨":{"voiceline":"까다로운 매너나 예의범절보단, 동료를 이끌고, 동료들을 지키는 게 더 중요하지…. 그런 거야 처음부터 알고 있었어. 이렇게 지휘관을 지키고 있잖아. 뭐, 내 나름의 방식대로긴 하지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/feeling4.ogg"},"사랑":{"voiceline":"오늘 하루 정도는 나처럼 편하게 지내보는 건 어때? 봐, 지휘관에게 힘을 보태 주는 아이들이 이렇게나 많으니, 가끔은 어리광을 부려도 괜찮지 않을까? 내 입장도 생각해봐. 지휘관이 계속 일만 하면, 내가 '고귀한 자로서 당신을 지키는 책무'를 다할 수가 없잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔어? 거기 아무데나 대충 앉아. 뭘 할 거냐니… 그야 당연히 전투 회고지. 뭘 기대한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/home.ogg"},"hp 경고":{"voiceline":"끈질기네…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/hp_warning.ogg"},"로그인":{"voiceline":"안녕, 지휘관. 휴우…. 오늘도 사르데냐 엠파이어의 위광이 눈부시네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/login.ogg"},"실패":{"voiceline":"흐음, 한 방 먹었는걸? 기억해두겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/lose.ogg"},"우편":{"voiceline":"우편인가…. 확인해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/mail.ogg"},"임무":{"voiceline":"새 임무야. 자, 맡은 바 책무를 다하라는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/mission.ogg"},"임무완료":{"voiceline":"임무, 완료…. 고귀하신 분의 책무를 잘 수행했다는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/mission_complete.ogg"},"서약":{"voiceline":"계속 내가 돌봐줬으면 한다는 의미인 거지? 좋아. 지휘관을 돌봐주는 것 정도는 고귀한 아브루치의 여동생으로서 완전 쉬운 일이거든?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/propose.ogg"},"스킬":{"voiceline":"내 진짜 실력을 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/skill.ogg"},"터치1":{"voiceline":"Obbedisco! '나는 순종한다'라는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/touch.ogg"},"터치2":{"voiceline":"헤에, 꽤 하잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/touch2.ogg"},"입수시":{"voiceline":"기분 좋아? 그럼 모항 소속 사르데냐의 경순양함, 주세페 가리발디랑 하이파이브! 아, 지휘관? 잠깐만, 업데이트 좀 하고……됐다. 나? 방금 가리발디라고 얘기했는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/unlock.ogg"},"강화성공":{"voiceline":"괜찮은데? 줄기는 커녕 늘어나 있고 말이야. 주로 화력같은 거.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼어. 내 이름은 경순양함 주세페 가리발디야. 기억하기 쉽지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/win_mvp.ogg"},"전투개시_ex":{"voiceline":"여기선 내가 지켜줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/battle_ex.ogg"},"상세확인_ex":{"voiceline":"아, 딱히 뭐라고 나무랄 생각은 없는데, 계속 그렇게 서있기만 할 거야? 어휴, 이상한 거 신경쓰지 말고 그냥 좀 앉지 그래? 난 지휘관한테라면 잡아 먹혀도 괜찮으니까~ 막 이래♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/602020/detail_ex.ogg"