[{"클뜯 id":102160,"클뜯 함순이 id":10216,"함순이 이름":"멤피스","한글 함순이 + 스킨 이름":"멤피스","영문 함순이 + 스킨 이름":"Memphis","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102160/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102160/shipyard.png","설명":"오마하급 경순양함—멤피스, 현호 CL-13 ","자기소개":{"voiceline":"나는 오마하급 경순양함 멤피스. 일생 동안 중요한 손님들을 맞이 했었고, 기함으로 기용되기도 했었다. 더 말해 뭐하겠어, 나에 대해 더욱 더 알고 싶다면 잘 따라와. 나의 멋진 활약을 잘 보라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/profile.ogg"},"메인1":{"voiceline":"검열 받을 때는 최고의 일면을 모두에게 보여줘야하지. 이게 나의 규칙이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/main1.ogg"},"메인2":{"voiceline":"여태껏 빈번하게 4대 해역을 순찰했어, 항구에 더 머무르는 것은 과욕이야...하지만 괜찮아, 나는 바쁜게 좋거든~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/main2.ogg"},"메인3":{"voiceline":"항구로 돌아올 때 선물을 가져다달라고? 지휘관이 우선 항구에서 실력을 보여줘야지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/main3.ogg"},"전투개시":{"voiceline":"가자! 모두들 최고 수준의 실력을 발휘해야해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/battle.ogg"},"상세확인":{"voiceline":"계속 나와 함께하고 싶다면, 나의 모든 것을 잘 주시해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/detail.ogg"},"드랍 설명":{"voiceline":"오마하급 경순양함—멤피스, 현호 CL-13","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어. 시간 내서 그들의 업무 실적을 좀 살펴봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/expedition.ogg"},"실망":{"voiceline":"흥, 나에게 무시 당하는건 네 자업자득이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/feeling1.ogg"},"낯섦":{"voiceline":"이어서 문서들 좀 처리하고 훈련 계획들을 검토할게. 지휘관은 그중에 세세한 부분을 봐주면 좋고, 내 발목은 잡지마~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/feeling2.ogg"},"호감":{"voiceline":"나에게 반해버렸다면 어쩔 수 없는 일이지. 좋아, 좀 더 멍 때리고 있게 허락해줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/feeling3.ogg"},"기쁨":{"voiceline":"이렇게 가까이 붙다니, 내 머리카락 향기를 느끼고 싶은거야? 히히, 어때, 바닷바람의 향기가 나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/feeling4.ogg"},"사랑":{"voiceline":"내가 없으면 항상 어딘가 편치 않다고? 걱정마, 내가 최선을 다해 호위할거야. 그러니까 넌 최선을 다해 내 곁에 있으면 돼~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"히히, 역시 괜찮게 하는걸~ 너무 자만하지마, 앞으로 더 많은 시험이 있을거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/home.ogg"},"hp 경고":{"voiceline":"다시는 소홀히 여겨선 안돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 드디어 왔구나. 그럼 출발하자~ 어서 날 따라와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/login.ogg"},"실패":{"voiceline":"실패하다니....낭패로군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/lose.ogg"},"우편":{"voiceline":"우편 수령해~ 분명 좋은 일이 있을거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/mail.ogg"},"임무":{"voiceline":"임무가 있으면 재빨리 처리해. 방치해 두고 나몰라라 하지 말고. 너말야, 지휘관~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/mission.ogg"},"임무완료":{"voiceline":"시간 나면 가서 봐봐. 응당 받아야 하는 보상이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/mission_complete.ogg"},"서약":{"voiceline":"영광을 느껴봐. 넌 이미 나 멤피스의 허가를 얻었으니까~ 난 지금 너에 대해 완전히 기대하고 있어. 날 실망시키지 말라구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/propose.ogg"},"스킬":{"voiceline":"호위는 역시 나지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/skill.ogg"},"터치1":{"voiceline":"어? 그렇게 급하게 나의 훈련을 보고 싶어? 그럼 한 번 제대로 보여줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/touch.ogg"},"터치2":{"voiceline":"놓지 않으면, 어떻게 되는지 알지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/touch2.ogg"},"입수시":{"voiceline":"어? 네가 여기 지휘관이야? 안심해, 내가 호위할테니. 하지만, 우선 내 기준에 부합해야만해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/unlock.ogg"},"강화성공":{"voiceline":"이번에 훨씬 잘 호위할 수 있겠어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥~ 봤지! 이건 내게만 있는 영광의 순간이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['오마하', '롤리', '리치몬드'] : 겨우 같이 출격했네. 나와 전진하자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102160/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex