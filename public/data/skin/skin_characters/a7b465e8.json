[{"클뜯 id":207090,"클뜯 함순이 id":20709,"함순이 이름":"꼬마 일러스트리어스","한글 함순이 + 스킨 이름":"꼬마 일러스트리어스","영문 함순이 + 스킨 이름":"Little Illustrious","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207090/shipyard.png","설명":"일러스트리어스급 항공모함—일러스트리어스, 현호 87 ","자기소개":{"voiceline":"저는 세계 최초의 장갑 항공모함이에요! 헤헤, 언젠가는 저도 로열 네이비를 빛낼 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/profile.ogg"},"메인1":{"voiceline":"일러스트리어스의 함재기요? 여기에 있어요. 헤헤, 모두 대단한 친구들이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/main1.ogg"},"메인2":{"voiceline":"지휘관님, 외로우시다면 일러스트리어스가 말동무를 해드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/main2.ogg"},"메인3":{"voiceline":"모두가 서로를 더 잘 이해한다면 이 세계는 더 아름다워질 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/main3.ogg"},"전투개시":{"voiceline":"평화를 해치는 사람들은 반드시 벌을 받을 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/battle.ogg"},"상세확인":{"voiceline":"일러스트리어스는 아주 똑바로 서 있어요. 절대 넘어지지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/detail.ogg"},"드랍 설명":{"voiceline":"일러스트리어스급 항공모함—일러스트리어스, 현호 87","voicelink":null},"의뢰 완료":{"voiceline":"아, 의뢰조의 동료들이 돌아왔어요! 얼른 차를 준비해야겠네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/expedition.ogg"},"실망":{"voiceline":"사랑과 평화의 소망을 가장 가까운 지휘관님에게도 느낄 수 없는 건가요. 우으……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 사랑과 평화를 위해서는 다른 사람과 함부로 싸우면 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/feeling2.ogg"},"호감":{"voiceline":"아, 지휘관님. 움직이지 마세요! (만지작) 일러스트리어스의 손수건으로…… 이렇게…… 헤헤, 지휘관님! 입가에 묻은 케이크를 닦아드렸어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/feeling3.ogg"},"기쁨":{"voiceline":"골치 아픈 일을 이야기 하는 것만으로도 한결 가슴이 편해질 거에요. 일러스트리어스가 함께 있으니까요! 그러니까 지휘관님, 골치 아픈 일이 있다면 저에게 이야기해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 정신이 없어보여요… —일이 너무 바빠서인가요? 우으… 잠깐 허리 좀 숙여주세요! 쓰담쓰담~ 착하다~ 이러면 피곤이 날아간대요~ 헤헤, 효과가 있었나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 수고하셨어요! 피곤하세요? 헤헤, 일러스트리어스가 어깨 주물러 드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/home.ogg"},"hp 경고":{"voiceline":"사랑과 평화를 위해서라면 무섭지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 평안하신지요! 원래 있던 대로 정리를 해봤어요. 어떻게 생각하세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/login.ogg"},"실패":{"voiceline":"으… 사랑과 평화를 위해서 다, 다음 번에는 절대 용서하지 않겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/lose.ogg"},"우편":{"voiceline":"지휘관님, 편지에요! 가방에 넣어뒀는데, 어디—— 아, 찾았다. 여기 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/mail.ogg"},"임무":{"voiceline":"지휘관님, 끝내지 못한 임무 때문에 골치가 아프신가요? 으음, 일러스트리어스가 도와드릴 수 있는게 없을까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 지휘관님의 노력 덕분에 더 많은 사람들이 사랑과 평화를 누릴 수 있게 됐어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/mission_complete.ogg"},"서약":{"voiceline":"이, 이건 서약… 이렇게 귀한 것 일러스트리어스에게 주시다니… 에헤헤, 정말 기뻐요. 아직 미숙하지만 지휘관님이 바라는 모습이 되기 위해서 열심히 노력할게요! 네, 반드시요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/propose.ogg"},"스킬":{"voiceline":"빛이여, 사랑과 평화의 적을 없애주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/skill.ogg"},"터치1":{"voiceline":"지휘관님의 손은 정말 크네요. 일러스트리어스보다 훨씬 커요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/touch.ogg"},"터치2":{"voiceline":"이건 새로운 게임인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 평안하신지요! 저는 로열 네이비 일러스트리어스급 항공모함, 일러스트리어스입니다! 저와 함께 사랑과 평화의 빛을 이 세상에 퍼뜨려 보아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/unlock.ogg"},"강화성공":{"voiceline":"이러면 사랑과 평화를 더 많이 퍼뜨릴 수 있을 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"사랑과 평화에 한 걸음 더 가까워진 것 같아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['빅토리어스'] : 사랑과 평화를 위해서 적을 따끔하게 혼내줘요! 알겠어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207090/couple_encourage1.ogg"},{"voiceline":"['포미더블'] : 지루하다면 같이 게임이라도…?","voicelink":"https://raw.githubusercontent.com/Fernando26