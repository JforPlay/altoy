[{"클뜯 id":301590,"클뜯 함순이 id":30159,"함순이 이름":"우라카제","한글 함순이 + 스킨 이름":"우라카제","영문 함순이 + 스킨 이름":"Urakaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301590/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301590/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301590/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301590/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301590/shipyard.png","설명":"카게로급 구축함 11번함 - 우라카제 ","자기소개":{"voiceline":"우리 제17 구축함대는 그 대전에선 거의 계속 함께했었어. 수많은 작전임무에서 활약하고, 거의 처음부터 마지막까지 끝까지 싸웠지. 나와 콘고 언니만 함께 가라앉게 되었지만……아냐, 사생유명. 이까짓 거, 전혀 신경 안 쓴다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/profile.ogg"},"메인1":{"voiceline":"하마카제…그 계집애. 자기도 여동생인데 나보다 어른 행세나 하고…바보! 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/main1.ogg"},"메인2":{"voiceline":"그때 시라이온을 발견할 수 있었다면, 콘고 언니는…흥, 뭐 어때! 중요한 건 지금이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/main2.ogg"},"메인3":{"voiceline":"공문? 나한테 보여줘……흠흠, 그렇군 그렇군~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/main3.ogg"},"전투개시":{"voiceline":"크흠! 전함……출진!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/battle.ogg"},"상세확인":{"voiceline":"이 문장? 내가 고안해낸 거야. 이 겉옷도 말야. 귀엽다는 말 외에 다른 감상은 받지 않겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/detail.ogg"},"드랍 설명":{"voiceline":"카게로급 구축함 11번함 - 우라카제","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었어. 안 잊어버렸지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/expedition.ogg"},"실망":{"voiceline":"가까이 오지 마, 멍청함이 옮으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/feeling1.ogg"},"낯섦":{"voiceline":"부채? 아냐. 이건 군배라고 하는, 무장들이 지휘를 할 때 쓰는 군용 부채야. 너무 내 지식을 얕보지 말라고……아, 아무것도 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/feeling2.ogg"},"호감":{"voiceline":"하마카제랑 타니카제, 맨날 주뼛주뼛해가지곤, 조금도 무인답지 못하다니깐! 언니인 내가 나서 줘야…정말이지, 속 썩이는 아이들이라니깐…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/feeling3.ogg"},"기쁨":{"voiceline":"따, 딱히 신경 안 쓰이고 답 같은 건 처음부터 알고 있지만, 일단 한 번 물어볼게. 내가 제 몫을 다 한다고 생각해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/feeling4.ogg"},"사랑":{"voiceline":"뭐야, 적당히 시험해 본 건데……뭐, 너라면 이야기 정도는 들어주지. 흥! 언젠가 반드시 날 다시 보게 해줄 테니까, 두고 보라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"흐, 흥! 수고했어, 들어가 쉬도록!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/home.ogg"},"hp 경고":{"voiceline":"책략을 잘못 썼나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/hp_warning.ogg"},"로그인":{"voiceline":"늦어! 네가 무슨 논두렁의 거북이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/login.ogg"},"실패":{"voiceline":"크윽, 이……스, 승리는 병가지상사…라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/lose.ogg"},"우편":{"voiceline":"네 앞으로 온 우편이야……응? 왜 안 읽는 거지? 나? 딱히 편지에 뭐가 쓰여 있는지 신경 쓰이지 않는다면, 가만 놔둬도 되잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/mail.ogg"},"임무":{"voiceline":"임무의 자료는 정리해뒀어……에, 나도 참가한다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/mission.ogg"},"임무완료":{"voiceline":"보수 확인이 끝났어. 옮기는 건 네게 맡기지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/mission_complete.ogg"},"서약":{"voiceline":"드디어 내 굉장함을 깨달은 건가. 이 솔직하지 못한 녀석 같으니라고……그러니까 귀 안 쫑긋거렸고 기쁘지도 않다니까! 아아 그만해! 겨, 결혼식 도중이라고오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/propose.ogg"},"스킬":{"voiceline":"지금이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/skill.ogg"},"터치1":{"voiceline":"그렇게 찌르지 말라고! 네가 무슨 원숭이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/touch.ogg"},"터치2":{"voiceline":"이런 짓을 당하고도 참고만 있을 수는 없지……죽어버려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/touch2.ogg"},"입수시":{"voiceline":"네가 우리 제17 구축함대를 지휘하는 대장? 느낌이 팍 오는 풍채는 아니네. 난 카게로 가문의 우라카제야. 그 실력, 내게 보여주실까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/unlock.ogg"},"강화성공":{"voiceline":"고맙……지금 귀가 쫑긋거렸다고? 그럴 리 없잖아! 딱히 기쁘지는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼네……당연하잖아. 딱히 기쁘고 그런 건…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['하마카제', '타니카제'] : 제17 구축함대, 전투준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301590/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X"