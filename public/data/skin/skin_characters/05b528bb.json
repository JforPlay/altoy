[{"클뜯 id":105010,"클뜯 함순이 id":10501,"함순이 이름":"네바다","한글 함순이 + 스킨 이름":"네바다","영문 함순이 + 스킨 이름":"Nevada","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105010/shipyard.png","설명":"네바다급 전함 - 네바다 (BB-36)","자기소개":{"voiceline":"욧! 나는 네바다급 1번함 네바다다. 대서양 함대와 태평양 함대 양쪽 모두에 참가했지. 근대화 개수를 받고 대통령의 호위도 해냈고, 전후에는 2번의 핵폭탄 실험에서 살아남아 평생 전장을 뛰어다녔다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/profile.ogg"},"메인1":{"voiceline":"내기 말인가? 별 흥미는 없지만 함께 해줘도 좋다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/main1.ogg"},"메인2":{"voiceline":"지휘관이여, 젊을 때는 두려워하지 말고 계속 나아가는 편이 좋다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/main2.ogg"},"메인3":{"voiceline":"「반트리 베이 중대」? 나는 출격할 찬스가 없었었지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/main3.ogg"},"전투개시":{"voiceline":"떠들썩하잖아! 내가 좀 더 북돋워 주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/battle.ogg"},"상세확인":{"voiceline":"이럴 때에 한해서, 너의 배려는 부러운걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/detail.ogg"},"드랍 설명":{"voiceline":"네바다급 전함 - 네바다 (BB-36)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰가 무사히 완료됐다고. 그 아이들을 제대로 칭찬하도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/expedition.ogg"},"실망":{"voiceline":"조금 실망이구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/feeling1.ogg"},"낯섦":{"voiceline":"나는 운에 자신이 있지. 시험해 보겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/feeling2.ogg"},"호감":{"voiceline":"지휘관, 오클라호마 녀석이 전에 좋은 가게를 가르쳐줬거든. 잠깐 보러 가겠어? …이봐, 서 있지 말고 빨리 가자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/feeling3.ogg"},"기쁨":{"voiceline":"좋으면 좋다고 제대로 말하라고. 숨겨서 어쩌게… 정말이지 지휘관답지 않군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/feeling4.ogg"},"사랑":{"voiceline":"중점 방어 컨셉? 저건 소중한 곳을 보다 철저히 방어하려는 거다. ……뭐? 얼마나 소중한지 알고 싶다고? ……뭐, 뭐어, 너라면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지쳤다면 내 어깨라도 기대고 있어. 뭐, 부끄러워하지 말고, 됐으니까 이리로 와.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"이봐, 확실하게 해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/login.ogg"},"실패":{"voiceline":"칫, 두고 보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/lose.ogg"},"우편":{"voiceline":"여! 지휘관, 네 앞으로 온 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/mail.ogg"},"임무":{"voiceline":"군인으로서 임무를 완수하는 것은 당연하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/mission.ogg"},"임무완료":{"voiceline":"미션 보너스, 도착했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/mission_complete.ogg"},"서약":{"voiceline":"너 말야…… 이럴 때 덤벙거려서 어쩌려고? 이런 중요한 일은 시간과 장소를 생각하지 않나? ……풋. 그래 그래, 필요 없단 말은 안 했으니까 반듯하게 해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/propose.ogg"},"스킬":{"voiceline":"너희들, 아직 멀었군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/skill.ogg"},"터치1":{"voiceline":"너, 의외로 사람에게 달라붙는구만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/touch.ogg"},"터치2":{"voiceline":"나의 「중점 방어」, 그렇게 신경 쓰이는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/touch2.ogg"},"입수시":{"voiceline":"소년, 네가 나의 지휘관인가? 나는 네바다, 지금부터 신세를 지지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/unlock.ogg"},"강화성공":{"voiceline":"응, 좋은 느낌!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"핫, 그런 화력과 장갑으로 내 상대가 될 거라 생각했어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"N","ex_chat_status":0},{"클뜯 id":105011,"클뜯 함순이 id":10501,"함순이 이름":"네바다","한글 함순이 + 스킨 이름":"화려한 연회","영문 함순이 + 스킨 이름":"A Magnificent Banquet","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105011/shipyard.png","설명":"여어, 소년. 여기저기 인사 다니느라 안 피곤한가? 자, 여기 앉거라. 괜찮은 거라도 먹으면서 잠깐 쉬자고.","자기소개":null,"메인1":{"voiceline":"오클라호마가 동료들과 화기애애하게 이야기하는 모습을 보면, 왠지 가슴이 저며 오는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/main1.ogg"},"메인2":{"voiceline":"업무로 늘 바쁜 건 안다만, 체력 보충도 소홀히하면 안 된다고. 오늘도 인사하러 다니느라 아무것도 못 먹었지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/main2.ogg"},"메인3":{"voiceline":"내기? 이런 모습으로는 걸 수 있는게 아무것도… 아! 지는 쪽이 한 잔 더 하기로! 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/main3.ogg"},"전투개시":{"voiceline":"한바탕 해치워주고 와야겠군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/battle.ogg"},"상세확인":{"voiceline":"옷을 만드는 아이가 드레스에 바라는 건 없냐고 물어보길래, 나도 모르게 '방어에 중점을 맞춰달라'고 했더니 이렇게 만들어주더군. …뭐, 움직이기 편해서 난 맘에 든다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/detail.ogg"},"드랍 설명":{"voiceline":"여어, 소년. 여기저기 인사 다니느라 안 피곤한가? 자, 여기 앉거라. 괜찮은 거라도 먹으면서 잠깐 쉬자고.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"피로가 쌓인 모양이군…. 하하하, 이럴 때는 내가 발벗고 나서서 소년에게 무릎 베게라도 해서 달래줘야겠지? 사양할 거 없다, 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"벌써 온 건가? 그럼, 오늘도 차근차근 일 처리를 해보자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/login.ogg"},"실패":null,"우편":{"voiceline":"네 앞으로 온 우편이다. 뭐라고 쓰여있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/mail.ogg"},"임무":{"voiceline":"새로운 미션이군. 식후 운동에는 딱이겠는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/mission.ogg"},"임무완료":{"voiceline":"미션 보너스다. 오클라호마 녀석, 타이밍 잘 맞춰서 연락했네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"기분 전환? 아아, 잠깐 바람이라도 쐬고 와. 여긴 내게 맡기고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/touch.ogg"},"터치2":{"voiceline":"엉뚱한 방향으로 자란 것 같은걸….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/touch2.ogg"},"입수시":{"voiceline":"여어, 소년. 여기저기 인사 다니느라 안 피곤한가? 자, 여기 앉거라. 괜찮은 거라도 먹으면서 잠깐 쉬자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":0,"상점 카테고리 id":7,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"N","ex_chat_status":0},{"클뜯 id":105019,"클뜯 함순이 id":10501,"함순이 이름":"네바다","한글 함순이 + 스킨 이름":"네바다·改","영문 함순이 + 스킨 이름":"Nevada (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105019/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105019/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105019/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105019/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/ma