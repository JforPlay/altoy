[{"클뜯 id":101430,"클뜯 함순이 id":10143,"함순이 이름":"할시 파웰","한글 함순이 + 스킨 이름":"할시 파웰","영문 함순이 + 스킨 이름":"Halsey Powell","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101430/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101430/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101430/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101430/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101430/shipyard.png","설명":"지휘관 발견! 에헤헤~ 응? 내가 누군지 몰라?! 아아, 정말이지! 나는 할시 파웰. 제대로 기억해 두라고!","자기소개":{"voiceline":"나는 할시 파웰! 수많은 플레처급의 일원으로 많은 언니들을 지원해왔지! 전투기라던가 잠수함은 내 상대가 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/profile.ogg"},"메인1":{"voiceline":"장난꾸러기 잠수함들이 어디에 있으려나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/main1.ogg"},"메인2":{"voiceline":"비버즈가 정말 부럽다니까. 나에게도 저런 멋진 스토리가 있으면 좋을텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/main2.ogg"},"메인3":{"voiceline":"지휘관, 이렇게 귀엽고 강한 구축함을 곁에 있는데도 일이 손에 잡히는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/main3.ogg"},"전투개시":{"voiceline":"이 할시 파웰이 함대를 승리로 이끌겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/battle.ogg"},"상세확인":{"voiceline":"에에, 지휘관도 역시 날 신경쓰고 있었구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함 할시 파웰(DD-686)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔구나? 내가 가볼게! 모두의 앞에 자주 모습을 드러내야 이름을 알릴 수 있으니까…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/expedition.ogg"},"실망":{"voiceline":"흥, 내가 모항의 스타가 되면 후회하게 될걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/feeling1.ogg"},"낯섦":{"voiceline":"좋아. 오늘도 모두에게 내 멋진 모습을 보여주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/feeling2.ogg"},"호감":{"voiceline":"이렇게 많은 자매들 사이에서 두각을 나타내는 건 쉽지 않네…… 지휘관! 분명 방법을 알고 있겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/feeling3.ogg"},"기쁨":{"voiceline":"모든 사람의 이목을 끄는게 어렵지 않냐고? 으음…… 그렇다면 먼저 지휘관의 시선을 사로잡는 것을 목표로 노력해야겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/feeling4.ogg"},"사랑":{"voiceline":"지휘관이 나를 볼 때마다 기뻐…… 안돼. 이러면 지휘관만으로 만족하는 단순한 아이가 돼버리잖아! 하지만 이런 느낌도 나쁘지는 않네. 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"아, 지휘관! 내가 없는 사이에 혼자 몰래 놀러갔었지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/home.ogg"},"hp 경고":{"voiceline":"설마 정말 위험해지는 건 아니겠지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/hp_warning.ogg"},"로그인":{"voiceline":"으응—— 오늘의 지휘관도 언제나와 같네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/login.ogg"},"실패":{"voiceline":"우우. 여기 보지 마……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/lose.ogg"},"우편":{"voiceline":"이번 우편도 내가 제일 먼저 지휘관에게 가져다 줬지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/mail.ogg"},"임무":{"voiceline":"아무래도 지휘관의 임무를 도와줄 사람이 필요한 모양인데…… 역시 이럴 때는 내 힘이 필요한 거지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/mission.ogg"},"임무완료":{"voiceline":"지휘관, 내가 도와줬다는 걸 잊지 마! 에헤헤. 딸기 아이스크림아, 기다려라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/mission_complete.ogg"},"서약":{"voiceline":"이 반지를 끼면 더 빛날 수 있겠지? 에헤헤. 내 소원이 이루어졌어! …… 지휘관의 앞에서만 빛났으면 좋겠다고? 으음, 왜 때문일까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/propose.ogg"},"스킬":{"voiceline":"잘 보라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/skill.ogg"},"터치1":{"voiceline":"지휘관의 대위기? 내 도움이 필요한 거야? 우후후. 말만 하라고! 하지만 이렇게 귀여운 내가 도와주는 거니까… 맛있는 걸 사줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/touch.ogg"},"터치2":{"voiceline":"이, 이런 건 안돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/touch2.ogg"},"입수시":{"voiceline":"지휘관 발견! 에헤헤~ 응? 내가 누군지 몰라?! 아아, 정말이지! 나는 할시 파웰. 제대로 기억해 두라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/unlock.ogg"},"강화성공":{"voiceline":"좀 더 강해져야 더 많은 사람들의 이목을 끌 수 있다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우후후. MVP의 멋있는 모습을 마음껏 봐도 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101430/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":101431,"클뜯 함순이 id":10143,"함순이 이름":"할시 파웰","한글 함순이 + 스킨 이름":"새해의 럭키스타!","영문 함순이 + 스킨 이름":"Spring's Lucky Star","스킨 타입":"Empery'S Fineries","