[{"클뜯 id":902010,"클뜯 함순이 id":90201,"함순이 이름":"라 갈리소니에르","한글 함순이 + 스킨 이름":"라 갈리소니에르","영문 함순이 + 스킨 이름":"La Galissonnière","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902010/shipyard.png","설명":"비시아 성좌 라 갈리소니에르급 경순양함—라 갈리소니에르 ","자기소개":{"voiceline":"전쟁이 일어난 뒤에 나는 '공해 함대'의 일원이 되었어. 뭐, 연료가 없어서 공해에 간 적은 없지만. 하하! 그 이후의 일은 말 할 것도 없지. 됭케르크에게 물어보는 게 나을지도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/profile.ogg"},"메인1":{"voiceline":"오, 이런. 지휘실에 바쁜 지휘관과 따분해 죽어가는 한 사람만이 남았네. 하아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/main1.ogg"},"메인2":{"voiceline":"적을 처치할 수 있다면 함포나 도끼나 상관 없겠지, 지휘관? 형식에 구애받는 건 좋지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/main2.ogg"},"메인3":{"voiceline":"계획 같은 건 좋아하지 않아. 지구도 이렇게 빨리 도는데, 계획이 그 속도를 따라갈 수 있을 것 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/main3.ogg"},"전투개시":{"voiceline":"신나게 놀아보자고…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/battle.ogg"},"상세확인":{"voiceline":"응? 내가 들고 있는 거에 관심이 있는 걸까, 아니면… 나에게 관심이 있는 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/detail.ogg"},"드랍 설명":{"voiceline":"비시아 성좌 라 갈리소니에르급 경순양함—라 갈리소니에르","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔네? 마침 무료한 참인데 잘 됐다. 맞이하러 가볼까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/expedition.ogg"},"실망":{"voiceline":"지휘관이 하기 싫다면 잘 어울리는 곳을 추천해줄 수 있는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/feeling1.ogg"},"낯섦":{"voiceline":"아, 오늘도 무료한 하루인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/feeling2.ogg"},"호감":{"voiceline":"됭케르크가 무스 케이크를 만들어서 좀 가져왔어—— 뭐야, 왜 그렇게 봐? 감사의 인사는 만든 사람에게 하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/feeling3.ogg"},"기쁨":{"voiceline":"어뢰 함포 뿐 아니라 일반 무기나 다른 것에 관한 이야기도 재미있잖아? 지휘관도 그렇게 따분한 사람은 아닌 것 같네. 다음 번에도 이야기하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/feeling4.ogg"},"사랑":{"voiceline":"단도직입적으로 말 할게, 지휘관. 좋아해. 나랑 한바탕 놀아보지 않을래? …장난이야. 매일 이렇게 있는 것만으로도 이미 즐거운걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"흥~ 지휘관 말고는 아무도 못 들어와—— 아, 지휘관이구나. 그럼 괜찮지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/home.ogg"},"hp 경고":{"voiceline":"그래! 이래야지! 좀 더 즐겁게 해달라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/hp_warning.ogg"},"로그인":{"voiceline":"드디어 왔구나? 없는 동안 따분해 죽는 줄 알았다고. 저기, 나한테 시킬 일 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/login.ogg"},"실패":{"voiceline":"아, 져버렸네…… 됐어, 힘내서 다시 한 번 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/lose.ogg"},"우편":{"voiceline":"이봐, 우편이야! 안 가져갔다 바람에 날아가기라도 하면 내 책임 아니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/mail.ogg"},"임무":{"voiceline":"임무가 어렵다고? 잘 생각해봐. 내가 임무서에 체크 표시를 해줄 수는 없잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/mission.ogg"},"임무완료":{"voiceline":"임무 완료인가? 생각한 것보다 금방인데…… 어쩌면 나를 얕본 걸지도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/mission_complete.ogg"},"서약":{"voiceline":"하하하~ 역시 지휘관처럼 직설적인 사람이 좋아! 앞으로 누가 지휘관을 괴롭히면 내가 해결해 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/propose.ogg"},"스킬":{"voiceline":"사라져라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/skill.ogg"},"터치1":{"voiceline":"만져보고 싶어? 날에 베였다고 해서 날 원망하면 안 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/touch.ogg"},"터치2":{"voiceline":"나는 교황청의 기사가 아니야. 지휘관, 내가 하는 진짜 일이 뭔지 알고싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/touch2.ogg"},"입수시":{"voiceline":"비시아, 샤르데냐, 메탈 블러드...... 그 다음은 여긴가? 됐어, 상관없어, 나를 즐겁게 해줄 수만 있다면, 어디든 똑같아. 비시아 소속 라 갈리소니에르, 잘 부탁할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/unlock.ogg"},"강화성공":{"voiceline":"브레스트에 있던 때가 조금은 그립네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아하하! 재밌게 놀았다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"“본업”이 뭐냐고...? 그건 말이지... “inquisition”라고 해야하나~... 내포된 뜻...? 역시 너한테는 말 안할래~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"항구엔 역시 “본업” 방면의 일은 별로 없네... 음, 어차피 아이리스 리브레 동료들도 여기서 즐거워하니까 나도 즐겨야겠어, 헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘 뭐 할거야? 몸이 녹슬어 버리기 전에 일 좀 시켜줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/ma