[{"클뜯 id":202190,"클뜯 함순이 id":20219,"함순이 이름":"뉴캐슬","한글 함순이 + 스킨 이름":"뉴캐슬","영문 함순이 + 스킨 이름":"Newcastle","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202190/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202190/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202190/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202190/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202190/shipyard.png","설명":"사우스햄튼급 경순양함 - 뉴캐슬, 현호C76 ","자기소개":{"voiceline":"타운급 경순양함의 서브클래스, 사우스햄튼급의 뉴캐슬이라고 합니다. 함력은 제일 길지만, 왜인지 한가했던 시기도 제일 길다는 것 같습니다……이번에도 정년까지 별일 없었으면 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/profile.ogg"},"메인1":{"voiceline":"동생들처럼 멋진 함력을 갖고 있진 않지만, 하루하루를 즐겁게 보내는 건 누구에게도 지지 않을 자신이 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/main1.ogg"},"메인2":{"voiceline":"쫓기고 도망치고 하는 건 특기가 아니라서요. 하아…어떻게 좀, 서로 차분히 담소를 나눌 순 없을까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/main2.ogg"},"메인3":{"voiceline":"누구나 기대를 품으며 태어나지만……그 기대에 어울릴 만큼의 모험과 놀라움이 때때로 존재하지 않는 것도 인생이란 거겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/main3.ogg"},"전투개시":{"voiceline":"좋은 날씨네요. 쓸모없는 싸움은 빨리 끝내도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/battle.ogg"},"상세확인":{"voiceline":"같이 우산을 쓰고 싶으시다면, 좀 더 가까이 붙는 편이 좋을 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/detail.ogg"},"드랍 설명":{"voiceline":"사우스햄튼급 경순양함 - 뉴캐슬, 현호C76 ","voicelink":null},"의뢰 완료":{"voiceline":"바닷바람에 실려오는 그리운 향기……그 아이들이 돌아왔네요. 같이 마중 나가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/expedition.ogg"},"실망":{"voiceline":"타인과 거리감을 두는 게 미숙한 관계로, 혹시 오해를 살 만한 일이 있었다면 사죄드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/feeling1.ogg"},"낯섦":{"voiceline":"안심하십시오. 메이드의 직무는 제대로 해내겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/feeling2.ogg"},"호감":{"voiceline":"일기예보에 따르면 비가 올 예정이라 합니다. 외출하시게 된다면, 이 우산을 챙겨주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/feeling3.ogg"},"기쁨":{"voiceline":"당신의 미소는 고향의 바람을 떠올리게 해주네요……따뜻한 서풍입니다. 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/feeling4.ogg"},"사랑":{"voiceline":"절 똑바로 봐주지 않으면, 이 우산을 쓰고…어느샌가 바람과 함께 사라질지도 모른답니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 오십시오. 상의는 맡아 드리겠습니다……다치신 데가 없어 기쁘기 그지없습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/home.ogg"},"hp 경고":{"voiceline":"후우……보험을 들어두길 잘했네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/hp_warning.ogg"},"로그인":{"voiceline":"하루 업무를 시작하기 전에…커피, 진하게 우려낸 홍차, 페일에일, 어떤 게 좋으십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/login.ogg"},"실패":{"voiceline":"또 폐를 끼쳐드렸습니다……그저 부끄러울 따름입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/lose.ogg"},"우편":{"voiceline":"당신에게 온 편지입니다. ……제가 썼을 가능성도 없진 않답니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/mail.ogg"},"임무":{"voiceline":"해야만 하는 일이라도, 당신의 페이스로 해 나아가자고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/mission.ogg"},"임무완료":{"voiceline":"노력은 반드시 그 결과를 맺으리란 법은 없지만…아무래도 이번엔 운이 좋았던 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/mission_complete.ogg"},"서약":{"voiceline":"…이 평범한 날들을, 당신은 잊을 수 없는 날들로 바꿔주었습니다……아아…이런 마음에 넘처 흐르는 행복함을 한 번 맛보게 되었으니, 이젠 어떻게 해야 예전처럼 당신을 대할 수 있을까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/propose.ogg"},"스킬":{"voiceline":"평범한 일상을 구가하자고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/skill.ogg"},"터치1":{"voiceline":"이건……마치 작은 동물들이 서로 장난치며 노는 것 같네요. 후훗","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/touch.ogg"},"터치2":{"voiceline":"……부드러운 게 그렇게 좋으신 겁니까? 그렇다면 부드러움을 마음껏 느끼실 수 있도록, 대신 제가 안아 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/touch2.ogg"},"입수시":{"voiceline":"길을 잃었다 생각했습니다만, 당신과 만날 수 있게 되어 다행입니다. 타운급 순양함인 뉴캐슬이라고 합니다. 동생들이 늘 신세를 지고 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/unlock.ogg"},"강화성공":{"voiceline":"음……따뜻한 느낌이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 승리의 미주는 제겐 조금 센 것 같으니……넘겨 드리겠습니다, 당신에게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['셰필드', '에든버러', '벨파스트', '피지', '자메이카'] : 그렇게 서두를 거 없는데……저, 따라가다 놓쳐버린다고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202190/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,