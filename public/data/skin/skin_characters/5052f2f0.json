[{"클뜯 id":301600,"클뜯 함순이 id":30160,"함순이 이름":"이소카제","한글 함순이 + 스킨 이름":"이소카제","영문 함순이 + 스킨 이름":"Isokaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301600/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301600/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301600/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301600/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301600/shipyard.png","설명":"카게로급 구축함 12번함 - 이소카제 ","자기소개":{"voiceline":"제17 구축함대의 이소카제다! 예전엔… 에 그러니까, 하마카제, 우라카제님, 타니카제…앗, 유키카제랑도 함께 있었다! 함력이라면 누구에게도 지지 않는다고! 그러니까 임무는 이소카제에게 맡기면 되는 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/profile.ogg"},"메인1":{"voiceline":"대장! 이소카제랑 전국시대 놀이 하자아~! 대장은……이에야스! 이소카제는 미츠나리!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/main1.ogg"},"메인2":{"voiceline":"하마카제! 타니카제! 출발이야! 목표는……상경이다아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/main2.ogg"},"메인3":{"voiceline":"우라카제님, 이소카제의 겉옷이 또 찢어졌어요…꿰매줘요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/main3.ogg"},"전투개시":{"voiceline":"선봉은 나 이소카제가……우와아아! 기다려어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/battle.ogg"},"상세확인":{"voiceline":"천! 하! 포! 무!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/detail.ogg"},"드랍 설명":{"voiceline":"카게로급 구축함 12번함 - 이소카제","voicelink":null},"의뢰 완료":{"voiceline":"목표, 모항 부두! 의뢰에서 돌아온 동료들을 마중나가자! 대장호, 달려라~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/expedition.ogg"},"실망":{"voiceline":"흥! 이제 대장이랑은 안 놀 거야! 하마카제~ 하마카제 어디야~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/feeling1.ogg"},"낯섦":{"voiceline":"전국시대 말이야? 전부 우라카제님이 알려줬어! 우라카제님은 척척박사라구! 그치만 이소카제의 제일 친한 친구는 역시 하마카제야! 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/feeling2.ogg"},"호감":{"voiceline":"서군 돌격! 동군을 무찔러라~! 그 다음에는……우와앗! 히데아키가 배신했다! 대장 치사해! 이소카제는…우으으……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/feeling3.ogg"},"기쁨":{"voiceline":"대장, 이소카제랑 게임하자아~에엣! 바빠서 못 한다고! 정말? 일하는 거 도와줄게! 어깨 주물러줄게! ……얏호! 대장이 제일 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/feeling4.ogg"},"사랑":{"voiceline":"대장, 나 요즘 하마카제한테 차갑다고 우라카제님한테 혼나게 생겼어! 그치만 이소카제는 역시 대장이랑 놀고 싶은 걸……그니까 대장, 같이 하마카제랑 놀러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"대장, 수고했어! 저기, 있잖아! 이소카제가 보고해줄게! 그러니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/home.ogg"},"hp 경고":{"voiceline":"버텨야 할 때야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/hp_warning.ogg"},"로그인":{"voiceline":"대장! 출진 시간이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/login.ogg"},"실패":{"voiceline":"하마카제, 하마카제는 어디…이소카제를 구해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/lose.ogg"},"우편":{"voiceline":"대장, 편지를 가져왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/mail.ogg"},"임무":{"voiceline":"대장! 임무는 이소카제에게 맡기면 돼! 임무 따위, 개수일촉이라고! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/mission.ogg"},"임무완료":{"voiceline":"대장, 임무 보수가 왔어! 몇만 석이나 있나~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/mission_complete.ogg"},"서약":{"voiceline":"대장, 다음에 누가 괴롭히면 이소카제한테 알려줘, 이소카제가 하마카제를 데리고 복수해줄게. 대장이랑 이소카제랑 하마카제는 친구니까 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/propose.ogg"},"스킬":{"voiceline":"푸, 풍림화산!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/skill.ogg"},"터치1":{"voiceline":"대장, 이소카제를 업어줘~ 지금부터 적진에 돌격한다아~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/touch.ogg"},"터치2":{"voiceline":"하하하, 간지러워~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/touch2.ogg"},"입수시":{"voiceline":"전군돌격~!……어라라, 여, 여긴 어디야?! 앗! 너에 대해선 알고 있어! 음, 우라카제님께서 말했던…대장! 흥! 나는 이소카제, 장래 천하에 위세를 떨칠 대장이 될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/unlock.ogg"},"강화성공":{"voiceline":"내가 바로 제17 구축함대의 선봉, 이소카제로소이다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우라카제님, 이소카제의 활약, 보셨나요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['하마카제'] : 하마카제, 날 따라와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301600/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_c