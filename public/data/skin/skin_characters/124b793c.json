 모두에게 이해받는다면 그걸로 만족합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/main3.ogg"},"전투개시":{"voiceline":"준비는 되었나? 돌격하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/battle.ogg"},"상세확인":{"voiceline":"지휘관님? 뭔가 의논하고 싶으신 게 있으신 건 아닌지요? 아, 잡담이라도 괜찮답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님과는 이래저래 오래 알고 지내기도 했으니, 이번 기회에 개조로 조금 멋을 부려보았습니다. ……춤이요? 우후훗, 그렇게 간단히 보여 드릴 수 있는 게 아니라고요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"지휘관님, 잘 쉬셨는지요? 공무는 잠깐 제가 대신 봐 드려도 괜찮을지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"지휘관님, 보수가 도착했습니다. 기쁜 소식이라도 들으시고 느긋하게 계시는 건 어떨지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"저의 춤을 보고 싶으시다면, 보여 드려도 좋습니다. 하지만…그 전에 제대로 업무를 보셔야겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/touch.ogg"},"터치2":{"voiceline":"지휘관님, 신중함을 관대함으로 잘못 이해하신다면, 그건 큰 실수랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/touch2.ogg"},"입수시":{"voiceline":"지휘관님과는 이래저래 오래 알고 지내기도 했으니, 이번 기회에 개조로 조금 멋을 부려보았습니다. ……춤이요? 우후훗, 그렇게 간단히 보여 드릴 수 있는 게 아니라고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/unlock.ogg"},"강화성공":{"voiceline":"모두를 위해서라도, 더욱 힘내지 않으면 안 되겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302139/upgrade.ogg"},"vote":null,"승리":{"voiceline":"저는 아무것도 한 게 없답니다. 그저 돌격하라 명령했을 뿐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voicel