[{"클뜯 id":302130,"클뜯 함순이 id":30213,"함순이 이름":"진츠","한글 함순이 + 스킨 이름":"진츠","영문 함순이 + 스킨 이름":"Jintsuu","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302130/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302130/shipyard.png","설명":"센다이급 경순양함 2번함 – 진츠","자기소개":{"voiceline":"센다이급 2번함, 2수전 기함, 진츠라고 하옵니다. 한때는 연약하다 평가받았지만, 콜롬방가라 해전에서 자신을 증명해 보였습니다. 2수전의 빛, 여기서 한 번 더 보여 드리지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/profile.ogg"},"메인1":{"voiceline":"신중한 것을 연약하다 한다면, 용맹함은 무모하다 해야 하지 않을는지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/main1.ogg"},"메인2":{"voiceline":"진리 따윈 없습니다. 비교하고, 실천하고, 실패해야만 올바른 선택을 할 수 있지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/main2.ogg"},"메인3":{"voiceline":"타인에게 이해받지 않아도, 올바른 일을 해 나아갈 것입니다. 예, 설령 지휘관님께조차 이해받지 못한다 할지라도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/main3.ogg"},"전투개시":{"voiceline":"전 함, 돌격하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/battle.ogg"},"상세확인":{"voiceline":"다음 작전과 자원 배분……어머, 지휘관님 아니십니까. 편히 있다 가시지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/detail.ogg"},"드랍 설명":{"voiceline":"센다이급 경순양함 2번함 - 진츠","voicelink":null},"의뢰 완료":{"voiceline":"뭘 멍하니 계시는 겁니까? 의뢰가 완료되었습니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/expedition.ogg"},"실망":{"voiceline":"함대의 일은 이제 제게 맡겨 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/feeling1.ogg"},"낯섦":{"voiceline":"기함을 맡은 적이 있다 해도, 지금은 일개 병사에 불과합니다. 다른 아이들과 같이 대해주시면 되겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 저의 의사를 존중하여 주시는 건 좋지만, 아무쪼록 자신의 생각을 확실히 가져주시기 바랍니다. 애초에 지휘관님께 찬동하지 않는다면, 이렇게 곁에 있을 순 없었을 테니 말이죠, 우후훗","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/feeling3.ogg"},"기쁨":{"voiceline":"그 유능한 장군들은 왜 신하의 자리에 만족했었는지 알고 계시나요? 자신의 한계? 아니면 주군에의 경복? 저는…둘 다라고 생각합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/feeling4.ogg"},"사랑":{"voiceline":"사람의 평가에 좌우되는 일 없이, 자신을 꿰뚫어보는 건 지도하는 자가 가져야 할 기질입니다. 나아가는 길이 올바른지 아닌지…따라오는 자들을 보면 알 수 있지요. 예를 들면, 저라든지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"책에 모든 것이 적혀있지는 않지요. 실전으로만 얻을 수 있는 것도 있답니다. 지휘관님께선 어떠실는지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 밖에서 농땡이를 부리시는 건 괜찮습니다만, 집무실에선 집무에 집중하여 주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/login.ogg"},"실패":{"voiceline":"전 함 퇴각, 필요없는 희생은 하지 않습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/lose.ogg"},"우편":{"voiceline":"지휘관님, 정보의 즉시 대응은 중요하답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/mail.ogg"},"임무":{"voiceline":"새로운 임무의 중요사항을 정리하였습니다. 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/mission.ogg"},"임무완료":{"voiceline":"임무 보수가 도착했습니다……네? 아뇨, 어떻게 하면 최대한 이용할 수 있을까 생각하고 있을 뿐입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/mission_complete.ogg"},"서약":{"voiceline":"계략을 정해 병사를 움직이고, 최선의 때에 최고의 선택을 하는 게 저의 신조입니다. 예, 지금은 자신을 갖고 말씀드리지요. 최고의 지휘관님을, 제가 선택했다고 말이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/propose.ogg"},"스킬":{"voiceline":"이때를 기다렸습니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/skill.ogg"},"터치1":{"voiceline":"음? 무슨 일이신지? 지금, 함대 운영에 대해 생각하고 있던 참입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/touch.ogg"},"터치2":{"voiceline":"지휘관님은 생각보다 대담하신 거 같군요…마음의 준비도 되셨다는 거지요? 네?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/touch2.ogg"},"입수시":{"voiceline":"전장은 한순간에 바뀝니다. 냉정히 생각하고, 신중하게 움직여야만 지지 않는 싸움이 될 수 있겠지요. 지휘관님께선 어떠신지요? 2수전의 진츠, 인사 올리옵니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/unlock.ogg"},"강화성공":{"voiceline":"좀 더 깊은 해역으로의 진군도 검토 가능하실지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"그 정도 수준이로군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302130/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0},{"클뜯 id":302131,"클뜯 함순이 id":30213,"함순이 이름":"진츠","한글 함순이 + 스킨 이름":"책사님은 휴가 중","영문 함순이 + 스킨 이름":