voiceline/601050/expedition.ogg"},"실망":{"voiceline":"똑똑똑! 으으음! 지휘관의 잘못을 고칠 때까지 노크할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/feeling1.ogg"},"낯섦":{"voiceline":"마에스트라레 언니가 더 많은 친구를 사귀면 좋겠다... 지휘관, 무슨 방법 없을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/feeling2.ogg"},"호감":{"voiceline":"지휘관, 놀러왔어! 휴식 시간이지? 헤헤, 이건 마에스트라레 언니가 지휘관에게 만들어 준... 스케줄표? 역시 제대로 적혀있네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/feeling3.ogg"},"기쁨":{"voiceline":"에—— 지휘관, 나랑 좀 더 놀아줘! 뭘 해야 하냐니... 뭐든 상관 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/feeling4.ogg"},"사랑":{"voiceline":"지휘관! 또 왔어! 오늘 뭘 하던지 절대로 안 떨어질 거야! 흐~흥~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/feeling5.ogg"},"터치3":{"voiceline":"지휘관, 기다려! 일단 모자부터 벗고—— 좋아, 이제 만져도 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 내가 뭘 찾았는지 봐. 마에스트라레 언니가 항상 지휘관을 위해 준비하는 티백이야! 얼른 우려보자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/home.ogg"},"hp 경고":{"voiceline":"으악! 적의 습격이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/hp_warning.ogg"},"로그인":{"voiceline":"Ciao! 지휘관, 오늘도 힘내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/login.ogg"},"실패":{"voiceline":"구조 작전 개시! 지휘관, 제대로 지켜줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/lose.ogg"},"우편":{"voiceline":"우편, 우편! 헷!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/mail.ogg"},"임무":{"voiceline":"임무, 임무! 일단 체크만 하면 된거지 뭐! ...당연히 농담이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/mission.ogg"},"임무완료":{"voiceline":"임무 보상! ...마에스트라레 언니가 모를 때 슬쩍 해볼까, 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/mission_complete.ogg"},"서약":{"voiceline":"예쁜 반지다. 이걸 끼면 매일매일 지휘관 옆에 있어도 상관 없다는 거지? 그럼, 약속이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/propose.ogg"},"스킬":{"voiceline":"어쨌든 여길 공격하면 되잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/skill.ogg"},"터치1":{"voiceline":"뭐야, 뭐야? 이게 대체 뭐~야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/touch.ogg"},"터치2":{"voiceline":"납작하다고? 마에스트라레 언니랑 똑같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/touch2.ogg"},"입수시":{"voiceline":"Ciao! 지휘관! 리베치오가 왔어! 앞으로 우린 동료야. 잘 부탁할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/unlock.ogg"},"강화성공":{"voiceline":"강해졌다, 강해졌어! 마에스트라레 언니에게 보여줘야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"리베치오가 최고야! 지휘관, 보상은 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"나랑 마에스트라레 언니 모두 지휘관이 좋아! 헤헤~ 지휘관도 우리가 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관 어서와! 나 공부 가르쳐줘! 마에스트라레 언니가 지휘관을을 도와준다면, 많이 배워야한다고 했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"Ciao! 지휘관, 오늘도 기운 넘치게 힘내자고! 헷!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601050/login_ex.ogg"},"실패_ex":null,"우편_ex"