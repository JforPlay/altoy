[{"클뜯 id":401010,"클뜯 함순이 id":40101,"함순이 이름":"Z1","한글 함순이 + 스킨 이름":"Z1","영문 함순이 + 스킨 이름":"Leberecht Maass (Z1)","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401010/shipyard.png","설명":"1934년형 구축함·Z1 레베레히트·마스","자기소개":{"voiceline":"언니라 불리는 다른 녀석들과는 달리, 나 레베 님은 제3 제국 모든 구축함의 누님인 것이다. 짊어진 무게가 다르다고. 그러니 이제 지휘관은 걱정하지 않아도 괜찮아, 왜냐면 이 무적의 레베 님이 왔으니깐 말이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/profile.ogg"},"메인1":{"voiceline":"서류 작업 속도를 겨뤄볼까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/main1.ogg"},"메인2":{"voiceline":"풀네임은 레베레히트·마스지만, 레베라고 해도 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/main2.ogg"},"메인3":{"voiceline":"힘내 지휘관, 내가 항상 옆에 있으니깐 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/main3.ogg"},"전투개시":{"voiceline":"바람을 타고 파도를 가로지르는 거다! Feuer!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/battle.ogg"},"상세확인":{"voiceline":"빠르고 강하다! 그것이 바로 나, 레베 님이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/detail.ogg"},"드랍 설명":{"voiceline":"1934년형 구축함·Z1 레베레히트·마스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 끝났다. 자, 정신 차려. 긴 여행을 갔다 온 애들한테 최고의 미소를 보여줘야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/expedition.ogg"},"실망":{"voiceline":"안 되겠네, 지휘관. 전혀 즐기고 있지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/feeling1.ogg"},"낯섦":{"voiceline":"어때, 지휘관. 나와 지내는 일상은 즐거운가? 나는 매일매일 즐기고 있다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/feeling2.ogg"},"호감":{"voiceline":"인생은 짧은 것이다. 지휘관, 나는 전력으로 가고 싶으니까, 동료인 너도 늦지 말라고. 자, 웃어봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/feeling3.ogg"},"기쁨":{"voiceline":"세계의 끝이라도 두렵지는 않아. 거기다 지휘관도 있고 말야. 분명 이렇게 웃으며 지낼 수 있겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/feeling4.ogg"},"사랑":{"voiceline":"그러고 보니, 세계의 끝이라고 하니, 멋진 연애 이야기라던가, 세계의 끝에서 끌어안는 둘이라든가를 연상하게 되네. 지휘관, 나의 이브가 되지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"좋은 얼굴이다. 꽤나 멋진 전투였지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/home.ogg"},"hp 경고":{"voiceline":"뭘 겁먹고 있나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/hp_warning.ogg"},"로그인":{"voiceline":"좋아, 전쟁을 시작하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/login.ogg"},"실패":{"voiceline":"잘도 했겠다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/lose.ogg"},"우편":{"voiceline":"흥, 새로운 편지다. 제대로 받으라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/mail.ogg"},"임무":{"voiceline":"새로운 미션이다. 도전해보는 게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/mission.ogg"},"임무완료":{"voiceline":"우리들의 콤비네이션은 무적이다! 미션 보너스를 보자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/mission_complete.ogg"},"서약":{"voiceline":"다른 녀석이랑 사귀게 되면, 자기만 생각할 수는 없어지니깐 말이지. 울고 싶을 때 울고, 웃고 싶을 때 웃는 생활과는 작별이지만. …너와 사귀게 된 것, 후회하지 않아. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/propose.ogg"},"스킬":{"voiceline":"나를 따르라─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/skill.ogg"},"터치1":{"voiceline":"인사라면 이런 나약한 방법으론 안 된다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/touch.ogg"},"터치2":{"voiceline":"「귀여움」 받고 싶은 거냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/touch2.ogg"},"입수시":{"voiceline":"지휘관이여, 지금이야말로 갈채를 보내야 할 때! 이제부터는 이 레베 님에게 맡기면 문제없는 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/unlock.ogg"},"강화성공":{"voiceline":"하하하! 이 느낌이 좋다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"핫핫하! 레베 님은 무적이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['프린츠 오이겐'] : 억지 웃음이 지나치다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401010/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":401011,"클뜯 함순이 id":40101,"함순이 이름":"Z1","한글 함순이 + 스킨 이름":"반역의 우등생","영문 함순이 + 스킨 이름":"\"Rebellious\" Top Student","스킨 타입":"Sc