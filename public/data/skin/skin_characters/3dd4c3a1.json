l,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관 덕분에 살았어! 후후, 함께하면 어떤 어려움도 극복할 수 있을 거라 믿고 있었어! 음~ 그래도 그냥 넘어진 것뿐인데 어려움이라고 표현해도 되는 건가…? 지휘관? 왜 아까부터 그렇게 뚫어져라 쳐다봐…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/feeling5.ogg"},"터치3":{"voiceline":"응? 내 머리를 씻겨주려고? 오, 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/headtouch.ogg"},"모항귀환":{"voiceline":"아~ 지휘관. 들어올 때는 허둥대지 말고 천천히 와. 미끄러우니까 나처럼 넘어지면 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관이 와줘서 정말 다행이야…… 여기서 또 넘어지진 않겠지만. 응.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/login.ogg"},"실패":null,"우편":{"voiceline":"응? 여기에도 지휘관 앞으로 온 우편이…… 앗?! 물에 젖겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/mail.ogg"},"임무":{"voiceline":"임무 목록…… 아, 하마터면 까먹을 뻔했어. 응, 몸이 다 젖어서 못 읽은 거니까 어쩔 수 없잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/mission.ogg"},"임무완료":{"voiceline":"임무는 다 처리했으니까 걱정 말라고? …아, 그럼 보상 받으러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"등을 씻겨주려고? 괜찮아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/touch.ogg"},"터치2":{"voiceline":"지휘관은 이런 상황이 더 흥분돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/touch2.ogg"},"입수시":{"voiceline":"아, 마침 잘 왔어. 거기 샴푸 좀…… 으아아아아앗?! 으으, 아야야…… 저기, 지휘관. 잠깐 나 좀… 일으켜 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/unlock.ogg"},"강화성공":{"voiceline":"와아! 이젠 안 넘어지겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403102/upgrade.ogg"},"vot