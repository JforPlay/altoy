[{"클뜯 id":307130,"클뜯 함순이 id":30713,"함순이 이름":"꼬마 다이호","한글 함순이 + 스킨 이름":"꼬마 다이호","영문 함순이 + 스킨 이름":"Taihou-chan","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307130/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307130/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307130/shipyard.png","설명":"다이호급 항공모함 - 다이호","자기소개":{"voiceline":"다이호는 사쿠라 엠파이어의 최신형 장갑 항공모함이랍니다. 폭탄이든 어뢰든 뭐든, 제게 상처 하나 입힐 수 없어요. 지휘관님, 다이호가 지휘관님 주변의 적들을 모조리 처리해 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/profile.ogg"},"메인1":{"voiceline":"아카기…… 설마, 지휘관님을 자기 부하로? …후후훗, 다이호가 제대로 사과하게 만들어 드리죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/main1.ogg"},"메인2":{"voiceline":"지휘관님은 다른 아이에게 장난감을 받아보신 적 있나요? 아뇨, 별 의미는… 그냥 좀 여쭈어본 것뿐이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/main2.ogg"},"메인3":{"voiceline":"지휘관님, 쉬시고 싶을 때는 다이호에게 말씀해 주세요. 지금 다이호가 바로 바깥 문에 '휴식 중'이라는 간판을 달아둘게요. 아무도 방해할 수 없게 해드리죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/main3.ogg"},"전투개시":{"voiceline":"지휘관님과 단둘이 보내는 시간을 방해하다니…… 후후후…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/battle.ogg"},"상세확인":{"voiceline":"저 출렁출렁하는 언니들이…… 지휘관님의 주의를 산만하게 만드는 건가요? 에헤헷……. 다이호가 크면 지휘관님의 시선을 사로잡아서 다시는 다른 애들을 못 쳐다보게 만들 거예요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/detail.ogg"},"드랍 설명":{"voiceline":"다이호급 항공모함 - 다이호","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔나요? 지휘관님을 위해 고생한 거니 내친김에 그 아이들에게도 감사해 줄게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/expedition.ogg"},"실망":{"voiceline":"다이호의 사랑이 아직 부족했던 건가요? 괜찮아요. 다이호, 더욱더 많~은 사랑을 드릴 수 있으니까요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님을 위해서라면 다이호, 뭐든 할 수 있답니다~ 러브레터를 100통 더 늘려도 완전 괜찮아요♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/feeling2.ogg"},"호감":{"voiceline":"집무실 열쇠를 손에 넣으려면…… 아, 지휘관님~ 저도 참, 집무실에 뭘 놓고 왔지 뭐예요. 가지러 가게 잠깐 열쇠 좀 빌릴 수 있을까요? 바로 돌아올게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 다이호랑 같이 '데이트'하러 가지 않으실래요? 다이호는 아직 어리니까 언니들은 분명 '데이트'라고 생각 안 할 거예요~ 후후훗❤","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/feeling4.ogg"},"사랑":{"voiceline":"왜 그러세요? 지휘관으로서 성장 중인 다이호를 돌봐주는 건 당연한 거겠죠? 그러니까 지휘관님이랑 같은 방에서 지내는 게 이치에 맞고, 이상한 소리 들을 이유도 없죠~ 후후후, 지휘관님을 누구에게도 뺏기지 않을 거예요♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/feeling5.ogg"},"터치3":{"voiceline":"에헤헷~ 지휘관님~♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/headtouch.ogg"},"모항귀환":{"voiceline":"벌써 돌아오신 건가요? 다이호를 만나고 싶어지신 거려나? 에헤헤헷… 다이호는 다 알고 있답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/home.ogg"},"hp 경고":{"voiceline":"왜 이런 짜증 나는 녀석이 있는 거야?! 왜, 왜, 왜?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/hp_warning.ogg"},"로그인":{"voiceline":"에헤헷… 지휘관님. 다이호는 계속 기다리고 있었답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307130/login.ogg"},"실패":{"voiceline":"너희들 때문에 지휘관님 기분이 언짢게…… 이건 