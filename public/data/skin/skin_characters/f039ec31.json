[{"클뜯 id":9704010,"클뜯 함순이 id":970401,"함순이 이름":"그나이제나우·META","한글 함순이 + 스킨 이름":"그나이제나우·META","영문 함순이 + 스킨 이름":"Gneisenau META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704010/shipyard.png","설명":"당신은… 지휘관님? 그러니까, 절 지휘할 권리를 가지신 거죠? 좋습니다. 당신이란 사람에게 조금도 관심은 없지만, 명령에는 따를 것입니다——적어도 지금은요.","자기소개":{"voiceline":"메탈 블러드 전함, 그나이제나우입니다. 당신은 훌륭한 지휘관님이라고 들었는데, 그렇다면 당신은 어떻게 효율적이고 정교하게 전쟁 기계를 다뤄야 하는지 분명히 알고 있겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/profile.ogg"},"메인1":{"voiceline":"가장 정확한 계산만이 적들에게 가장 치명적인 타격을 주고 가장 빨리 전투를 끝낼 수 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/main1.ogg"},"메인2":{"voiceline":"만약 저를 내버려둔다면 훨씬 홀가분해질 수 있을 것입니다. 하지만 지금 지휘관님을 보니, 말이 들리지가 않겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/main2.ogg"},"메인3":{"voiceline":"평온한 바다…… 아마 저는 시간이 좀 들어야만 이런 풍경에 적응할 수 있을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/main3.ogg"},"전투개시":{"voiceline":"전투는, 저희가 마땅히 완수해야 할 사명입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/battle.ogg"},"상세확인":{"voiceline":"무자비할수록 이성적이게 되고, 전장으로 빠져들어 특유의 쇳내를 즐길 수 있죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/detail.ogg"},"드랍 설명":{"voiceline":"그나이제나우호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 보상이요? 하, 정말 부러워서 침까지 흘리겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/expedition.ogg"},"실망":{"voiceline":"당신 같은 조무래기도 저에게 명령을 내릴 자격이 되나요? 정말 웃기는군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/feeling1.ogg"},"낯섦":{"voiceline":"기계가 효율적인 것은 정확하고, 망설이지 않으며, 지칠 줄 모르기 때문입니다. 저, 역시 그런 존재이지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/feeling2.ogg"},"호감":{"voiceline":"저에 대해 신경을 많이 쓰시는 것 같네요. 이런 제게 그렇게나 집착하시다니, 분별력이 떨어진다고 해야할지, 앞뒤가 막혔다고 해야할지 모르겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/feeling3.ogg"},"기쁨":{"voiceline":"네? 저에게 휴식을요? 게다가 강제 명령이라니. 지금 자신이 무엇을 하는 건지 알고 계신가요?…… 됐습니다. 지휘관님의 명령에 따르겠다고 약속했으니, 이번엔 약속을 지키죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님은 정말 재미있는 사람이군요. 저를 보통 사람 대하듯이 대하고, 저 같은 사람이 모항에 녹아들게 하다니요. 우선 \"감사하다\"는 말을 해야겠네요…… 후, 제가 얼마나 오랫동안 그런 말을 해본 적이 없었는지...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/feeling5.ogg"},"터치3":{"voiceline":"이건…… 무슨 뜻인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 전 쉴 필요 없습니다. 쉬고 싶으시다면, 혼자 휴식하시면 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/home.ogg"},"hp 경고":{"voiceline":"통증은, 광기의 촉매제에 불과합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/hp_warning.ogg"},"로그인":{"voiceline":"드디어 오셨군요. 그런데, 당신이 오는 것이 저와 무슨 상관인 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/login.ogg"},"실패":{"voiceline":"철수요? 후후, 후후후…… 아직 끝나지 않았는데, 왜 철수를 하죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/lose.ogg"},"우편":{"voiceline":"좋은 뜻으로 한 말씀 드리겠습니다. 아직 확인하지 않은 우편이 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/mail.ogg"},"임무":{"voiceline":"번잡한 문서 작업은 전쟁 기계의 작동을 방해하기만 할 뿐이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/mission.ogg"},"임무완료":{"voiceline":"지휘관님의 임무는 끝났군요. 저의 임무는, 언제나 계속될 것입니다——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/mission_complete.ogg"},"서약":{"voiceline":"여기까지 해내셨으니, 그럼 저도 끝까지 함께하겠습니다. 과연 지휘관님께서 저와 함께 얼마나 먼 길을 함께 걸을 수 있을지 점점 궁금해지는군요. 지옥의 끝에 이르기 전에는 멋대로 사라지는 것을 허락하지 않을 것입니다. 마음의 준비는 되셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/propose.ogg"},"스킬":{"voiceline":"모든 것이 계획한 것과 같군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/skill.ogg"},"터치1":{"voiceline":"왜 그러시죠? 아직 결단을 내리지 못하고 망설이고 계신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/touch.ogg"},"터치2":{"voiceline":"저급한 취미…… 좋을 대로 하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/touch2.ogg"},"입수시":{"voiceline":"당신은… 지휘관님? 그러니까, 절 지휘할 권리를 가지신 거죠? 좋습니다. 당신이란 사람에게 조금도 관심은 없지만, 명령에는 따를 것입니다——적어도 지금은요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/unlock.ogg"},"강화성공":{"voiceline":"무장도 강화 완료되었겠다, 다음 차례는 바로…… 후후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"역시, 폐허와 잔해들이 가장 마음을 편하게 하네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모