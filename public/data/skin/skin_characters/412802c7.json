[{"클뜯 id":301560,"클뜯 함순이 id":30156,"함순이 이름":"니이즈키","한글 함순이 + 스킨 이름":"니이즈키","영문 함순이 + 스킨 이름":"Niizuki","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301560/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301560/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301560/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301560/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301560/shipyard.png","설명":"아키즈키급 구축함 5번함·니이즈키","자기소개":{"voiceline":"아키즈키급 구축함 5번함, 마루 4계획 신조함인 니이즈키라고 합니다. 하지만…… 니이즈키는 어쩌면 가장 도움이 안 된 함선이었을지도 몰라요… 우으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/profile.ogg"},"메인1":{"voiceline":"지휘관님의 도움이 되고 싶지만, 폐를 끼치면… 어떡하지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/main1.ogg"},"메인2":{"voiceline":"니이즈키가 혹시 폐를 끼치면, 귀라도 꼬리라도 만지게 해드릴 테니까, 그러니까… 화내지 마세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/main2.ogg"},"메인3":{"voiceline":"여기엔 이거, 그리고 여기엔… 이거… 맞죠? 괘, 괜찮을까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/main3.ogg"},"전투개시":{"voiceline":"실전…… 열심히 할게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/battle.ogg"},"상세확인":{"voiceline":"지, 지휘관님, 니이즈키는 저기… 실망시키거나… 하진 않았죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/detail.ogg"},"드랍 설명":{"voiceline":"아키즈키급 구축함 5번함·니이즈키","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰가 완료되었어요…… 니이즈키, 시간을 잘못 안 건… 아니죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/expedition.ogg"},"실망":{"voiceline":"역시 니이즈키가 도움이 안 된 걸까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 니이즈키에게 뭔가 용무가 있으신가요? 호, 혹시 니이즈키가 또 모르고 폐를 끼쳐버린 건가요??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/feeling2.ogg"},"호감":{"voiceline":"니이즈키, 모두에게 폐를 끼치지 않도록 노력해왔지만, 어떻게 해야 할지 몰라서…… 반대로 실수를 잔뜩 해 버렸어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 있는 곳에 오고 나서부터 실수가 많이 줄어들었어요…… 왜냐면 실수해도 지휘관님이 화를 안 내니까, 니이즈키도 조금씩 더 노력할 수 있게 되었어요… 그리고, 니이즈키를 격려해줄 때 귀를 어루만져주는 지휘관님의 손, 따뜻해서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/feeling4.ogg"},"사랑":{"voiceline":"니이즈키는 마음이 약해서 자주 실수를 하니까, 앞으로도 지휘관님의 대단한 도움이 되진 못하겠지만…… 그래도 괜찮아요. 왜냐면 중요한 건……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님…… 다치진 않았죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 니이즈키, 서류를 정리했습니다…… 쓸데없는 일은 하지 않은… 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/login.ogg"},"실패":{"voiceline":"또 실패 해 버렸어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 온 우편이에요…… 여기…… 앗, 아니다, 여기?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/mail.ogg"},"임무":{"voiceline":"지휘관님, 새로운 임무입니다. 진짜 새로운 임무라구요. 니이즈키, 확인했어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 임무 보수를 가져왔어요. 니이즈키, 안 틀렸죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/mission_complete.ogg"},"서약":{"voiceline":"겁쟁이에 자주 실수도 하지만, 중요한 건 마음으로 상대를 사랑스럽게 생각하고, 그걸 또 전해주는 것이겠죠…… 이것 만은, 니이즈키가 태어나 처음으로 잘할 수 있다고 확신했어요…… 네, 니이즈키, 앞으로도 계속, 지휘관님의 곁에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/propose.ogg"},"스킬":{"voiceline":"트, 틀린 거 아니죠?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/skill.ogg"},"터치1":{"voiceline":"지휘관? 니이즈키, 오늘은 뭔가 실수하지 않았을까 하고…… 아, 아마 괜찮겠죠…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/touch.ogg"},"터치2":{"voiceline":"아읏?! 지, 지휘관님… 니이즈키, 진짜 울어 버릴 거에요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/touch2.ogg"},"입수시":{"voiceline":"아키즈키급 5번함, 니이즈키라고 합니다. 아, 아무쪼록 잘 부탁드닙니…… 우으으, 또 실패해 버렸어… 그렇게 연습했는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/unlock.ogg"},"강화성공":{"voiceline":"니이즈키, 지휘관님의 기대를 저버리는 걸 생각하면… 울어버릴 것만 같아요… 우으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/upgrade.ogg"},"vote":null,"승리":{"voiceline":"니이즈키, 모두에게 폐를 끼치는 건 아니죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301560/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0}]