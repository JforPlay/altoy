[{"클뜯 id":601120,"클뜯 함순이 id":60112,"함순이 이름":"우골리노 비발디","한글 함순이 + 스킨 이름":"우골리노 비발디","영문 함순이 + 스킨 이름":"Ugolino Vivaldi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601120/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601120/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601120/shipyard.png","설명":"나비가토리급 구축함 - 우골리노 비발디","자기소개":{"voiceline":"사르데냐 엠파이어의 구축함, 우골리노 비발디예요. 저기… 지휘관님의 서류가 「아픈」 것 같네요…… 제가 고쳐 드릴 테니 안심하세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/profile.ogg"},"메인1":{"voiceline":"주사 맞을 때는 주사기를 빤히 보시면 안 돼요. 너무 아플 땐 저를 봐 주세요. 그러면 아픈 게 다 날아갈 거예요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/main1.ogg"},"메인2":{"voiceline":"……계속 책장에만 꽂아두면 책도 「감기」에 걸리는데, 그건 지휘관님도 마찬가지예요. 자, 어서 밖으로 나가서 같이 잠깐만 햇볕을 쫴요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/main2.ogg"},"메인3":{"voiceline":"반창고, 소독약, 붕대…… 그리고 전에 지휘관님이 주신 사탕까지♪ 이상으로 우골리노의 소지품이었습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/main3.ogg"},"전투개시":{"voiceline":"여, 여러분의 건강은 제가 잘 돌볼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/battle.ogg"},"상세확인":{"voiceline":"네? 제 건강 상태요…? 으음, 걱정 끼쳐서 죄송해요… 그냥 긁힌 정도고 제대로 치료도 하고 있으니까… 정말 괜찮아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/detail.ogg"},"드랍 설명":{"voiceline":"나비가토리급 구축함 - 우골리노 비발디","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아온 모양이네요. 도움이 필요한지 물어보고 올게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/expedition.ogg"},"실망":{"voiceline":"몸이 건강하지 않으면 마음에도 악영향을 끼쳐요…… 지휘관님, 제가 보살펴 드려도 될까요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/feeling1.ogg"},"낯섦":{"voiceline":"으아, 왜 이렇게 자주 넘어지는 걸까요…? 설마 신발이 「아픈」 건가……? 네? 손을 잡고 천천히 걷자…고요? 감사합니다… 너무 든든해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 채소를 많이 먹고 푹 자면 건강해질 수 있어요! 만약 밤중에 몰래 이불 속에서 일하는 모습이 보이면…… 제가 계속 곁에서 지켜볼 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 정말 아프면 어떻게 하지 생각만 하면, 마음이 너무 괴롭고 아파요…… 설마, 이상한 병에 걸린 건 저일까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 몸이 안 좋을 때는 꼭 알려주셔야 해요! 지휘관님께 도움이 되고 싶어요! 아주 조금만이라도…… 저는 정말 행복하니까… 그, 그러니까 더 의지해 주세요…… 아셨죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/feeling5.ogg"},"터치3":{"voiceline":"저와 지휘관님은 서로를 걱정하고 힘이 되어 주니…… 마치 가족 같아요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 고생 많으셨어요. 잠깐 상태 좀 볼게요. ……음, 제복은 「건강」하고, 모자도 「건강」해요. 소중하게 쓰고 계시네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/home.ogg"},"hp 경고":{"voiceline":"……다친 사람을 못 본 척할 수는 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 진찰 좀 할게요! …좋아요! 아주 「건강」하고 착한 아이네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/login.ogg"},"실패":{"voiceline":"괜찮아요. 다음에 같이 힘내면 되잖아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/lose.ogg"},"우편":{"voiceline":"우편이 왔네요…… 음, 좋아. 굉장히 「건강」해 보이네요. 지휘관님, 안심하고 열어보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/mail.ogg"},"임무":{"voiceline":"아직 임무가 남아 있긴 하지만… 지휘관님, 슬슬 몸 상태도 신경 쓰셔야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/mission.ogg"},"임무완료":{"voiceline":"임무 완료예요. 보상 확인하고 올게요. 아, 지휘관님은 푹 쉬고 계세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/mission_complete.ogg"},"서약":{"voiceline":"이, 이렇게 소중한 걸 정말 제가 받아도 되는 건가요……? 알겠어요. 지휘관님만큼이나 이 반지도 소중히, 건강하게 돌볼게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/propose.ogg"},"스킬":{"voiceline":"다들 다치지 않도록……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/skill.ogg"},"터치1":{"voiceline":"튼튼하고 착용감도 좋아서 정말 마음에 들어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/touch.ogg"},"터치2":{"voiceline":"……꺅?! 거, 걱정해 주셔서 감사합니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/touch2.ogg"},"입수시":{"voiceline":"처, 처음 뵙겠습니다… 사르데냐 엠파이어의 우골리노 비발디라고 해요. 다들 「간호사 우골리노」라고…… 저를 곁에 두고 지휘관님을 보살필 수 있게 해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/unlock.ogg"},"강화성공":{"voiceline":"지금 우골리노는… 「아주 건강」하네요! 다행이다~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"다, 다친 분은 없으시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님이 원한다면 뭐든지 들어주고 싶어요…… 앗…… 이건… 「사랑」의 증상…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/6