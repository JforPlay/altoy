[{"클뜯 id":306040,"클뜯 함순이 id":30604,"함순이 이름":"즈이호","한글 함순이 + 스킨 이름":"즈이호","영문 함순이 + 스킨 이름":"Zuihou","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/306040/shipyard.png","설명":"즈이호급 항공모함 - 즈이호","자기소개":{"voiceline":"모항은 정말 크네! 어디에서든 친구를 만들 수 있고, 재밌는 이야기도 많이 들을 수 있지만, 정신을 차리면 모르는 곳에 와 있고는 해… 더 자세히 들려달라고? 에헤헤, 좋아♪ 그럼, 일단 즈이호 옆에 앉아! 이거라도 먹으면서 천천히 들어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/profile.ogg"},"메인1":{"voiceline":"얼마 전에 예쁜 꽃을 보러 갔는데, 안개 때문에 길을 잃었어… 그렇지만 운 좋게 산책하러 온 운젠 님의 도움을 받았지! 고마워, 현자님~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/main1.ogg"},"메인2":{"voiceline":"위험할 때는 물속으로 잠수하면 돼! 즈이호는 꾹 참을 수 있거든! 몰래 헤엄쳐서 도망치면 되지 않냐고? 으음… 사실 즈이호는… 수영을 못 해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/main2.ogg"},"메인3":{"voiceline":"지휘관, 어제 표주박이 나오는 꿈을 꿨어! 그 안에서 쌀이 계속 나와서, 아무리 먹어도 다 못 먹을 정도라 너무 행복했어! 표주박은 또 얼마나 큰지, 즈이호가 들어가도 아무렇지도 않을 정도였어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/main3.ogg"},"전투개시":{"voiceline":"좋아, 준비는 완벽해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/battle.ogg"},"상세확인":{"voiceline":"지휘관, 방금 뭐 찾았어? 즈이호한테도 보여줘! 으음……! 으… 잘 안 보여… 팔짝팔짝 뛰면 보이려나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/detail.ogg"},"드랍 설명":{"voiceline":"즈이호급 항공모함 – 즈이호","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들, 다들 오래 원정 다녀오느라 수고했어! 굉장히 먼 곳까지 다녀왔는데, 기념품으로 뭘 가지고 왔을까? 분명 금은보화로 가득하겠지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/expedition.ogg"},"실망":{"voiceline":"지휘관, 혹시 안 좋은 일 있으면 알려줘. 즈이호가 좋은 방법 없나 열심히 생각해볼게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/feeling1.ogg"},"낯섦":{"voiceline":"지휘관이 하고 싶은 거, 즈이호가 대신 해줄게! 그러니까 뭐든 다~ 즈이호한테 알려줘야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/feeling2.ogg"},"호감":{"voiceline":"오늘은 좋은 일이 있을 것 같아~ 그렇게 생각하니까 지휘관이 딱 나타났네! 짹짹♪ 너무 좋아~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 게임 하자! 눈을 감고 입을 벌려봐… 짹짹♪ 지금 즈이호가 뭘 먹였게~? 응? 양이 너무 적어서 잘 모르겠다고? 즈이호가 쓰는 숟가락이 너무 작아서 그런가……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/feeling4.ogg"},"사랑":{"voiceline":"에헤헤… 즈이호한테는 지휘관이랑 같이 있는 게 제일 큰 행운이야. 그러니까 지휘관한테도 이 행운을 나눠줄게! 보물을 원하면 손에 들어오고, 꿈이 있으면 다 이뤄질 거야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/feeling5.ogg"},"터치3":{"voiceline":"짹짹! 역시 지휘관이 제일 믿음직스럽다니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관! 어서 와! 오늘은 어디 갔다왔어? 재밌는 일은 없었어? 짹짹! 빨리 즈이호한테도 알려줘~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/home.ogg"},"hp 경고":{"voiceline":"아, 아프다… 이제 더는… 못 움직일 것 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이야, 지휘관! 밥 안 먹었어? 배 많이 고파? 내가 두부탕이랑 센베이를 가지고 왔어! 혼자 먹기에는 양이 많으니까, 마음껏 먹어도 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/login.ogg"},"실패":{"voiceline":"졌어…… 역시 방심하면 안 된다니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/lose.ogg"},"우편":{"voiceline":"우편이 왔어! 분명 좋은 소식일 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/mail.ogg"},"임무":{"voiceline":"새로운 임무가 왔어! 이번에는 어디가서 뭐할 거야? 어쨌든 즈이호랑 같이 바로 나가보자! 응, 지금! 바로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 오늘도 운이 좋았네! 보상에 뭐가 있는지 즈이호한테도 보여줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/mission_complete.ogg"},"서약":{"voiceline":"이건…? 즈이호한테 주는 거야? 반짝반짝 빛나서 예쁘다~ 응? 끼우라고? 왜 끼우는 거야? …뭐?! 이걸 끼면 절대 미아가 안 된다고?! 어딜 가도 무사히 지휘관이 있는 곳으로 돌아올 수 있다니, 너무 좋네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/propose.ogg"},"스킬":{"voiceline":"불빛이 있는 곳으로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/skill.ogg"},"터치1":{"voiceline":"짹짹♪ 기분 좋다… 으음… 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/touch.ogg"},"터치2":{"voiceline":"여기는 안 돼… 즈이호, 화낼 거야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/touch2.ogg"},"입수시":{"voiceline":"짹짹! 항공모함 즈이호 등장! 즈이호는 항공모항이지만, 급유함이나 잠수함이 된 적도 있으니까, 지휘관한테 분명 도움이 될 거야! …아, 그렇지! 이거, 지휘관한테 줄게! 행운을 불러오는 과자야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/unlock.ogg"},"강화성공":{"voiceline":"또 운이 좋았네♪ 덕분에 잘 먹었어! 답례로 다음에는 즈이호가 직접 만든 요리를 먹여줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다! 오늘도 운이 너무너무 좋네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306040/win_mvp.ogg"},"전투개시_ex":{"voiceline":"중요한 