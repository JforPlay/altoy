hipyard.png","설명":"지휘관~! 여기야, 여기! 즈이호는 여기 있어! …짹짹! 지휘관, 즈이호랑 풍선 나눠주자! 행운을 나르는 풍선이야! 우선은 지휘관한테… 자, 받아!","자기소개":null,"메인1":{"voiceline":"어…? 으아아아! 푸, 풍선 때문에 날아가겠어!! 후, 후우… 지휘관, 고마워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/main1.ogg"},"메인2":{"voiceline":"해님의 빛 덕분에 풍선도 매끈매끈 반짝반짝하네! 즈이호는 밝은 게 좋아! 짹짹♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/main2.ogg"},"메인3":{"voiceline":"오늘은 좋은 일이 일어날 거야! 왜냐하면 그런 느낌이 들거든! 짹짹♪ 즈이호는 지금 행운의 풍선을 들고 지휘관이랑 있잖아? 이것도 좋은 일이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"행운의 풍선을모두에게 나눠주면 다들 운이 좋아지겠지? 에헤헤, 그걸 떠올리기만 해도 행복해져서 전혀 피곤하지 않아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/detail.ogg"},"드랍 설명":{"voiceline":"지휘관~! 여기야, 여기! 즈이호는 여기 있어! …짹짹! 지휘관, 즈이호랑 풍선 나눠주자! 행운을 나르는 풍선이야! 우선은 지휘관한테… 자, 받아!","voicelink":null},"의뢰 완료":{"voiceline":"지휘관~! 다들 돌아왔어! 보상도 행운의 풍선 덕분에 늘어나지는 않을까? 짹짹♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"즈이호의 행운, 지휘관에게도 잘 전해졌어? 에헤헤, 왠지 지휘관이랑 같이 있으면 계속, 계~속 행복할 것 같아! 이런 게 바로 가장 큰 행복이겠지? 짹짹♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/feeling5.ogg"},"터치3":{"voiceline":"지휘관~ 지휘관~ 에헤헤♪ 짹짹♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 계속 기다렸어! 짹…? 기, 길을 잃어버릴까봐 무서워서 계속 여기 있었던 건 아니야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관!자, 행운의 풍선이야! 지휘관한테는 가장 큰 걸 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/306041/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료