[{"클뜯 id":801010,"클뜯 함순이 id":80101,"함순이 이름":"르 트리옹팡","한글 함순이 + 스킨 이름":"르 트리옹팡","영문 함순이 + 스킨 이름":"Le Triomphant","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801010/shipyard.png","설명":"르 팡타스크급 구축함 르 트리옹팡 ","자기소개":{"voiceline":"자유 아이리스 교국, 르 팡타스크급 구축함 르 트리옹팡, 인사드릴게요. 이전에는 브레스트의 제8함대에 소속해서 언니들과 함께 스카게라크 해협에 돌입했습니다. 그 뒤, 언니들과는 다른 길을……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/profile.ogg"},"메인1":{"voiceline":"이 장비? 익숙해지면 무겁게 느껴지지 않는답니다. 이래 뵈도 완력은 강한 편이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/main1.ogg"},"메인2":{"voiceline":"만약 그때, 언니들과 같이 있었다면, 어쩌면 다른 결말을 맞이했을지도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/main2.ogg"},"메인3":{"voiceline":"아군과 적이란, 때에 따라 바뀌는 거에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/main3.ogg"},"전투개시":{"voiceline":"아이리스의 이름에 맹세하건대, 적을 반드시 분쇄하겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/battle.ogg"},"상세확인":{"voiceline":"질문이라면 뭐~든 환영이랍니다. 전~부 대답해 드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/detail.ogg"},"드랍 설명":{"voiceline":"르 팡타스크급 구축함 르 트리옹팡","voicelink":null},"의뢰 완료":{"voiceline":"다음은 제게 맡겨보지 않을래요? 신속하게 완료해 드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/expedition.ogg"},"실망":{"voiceline":"지휘관님은 뭐…… 이런 분이시군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/feeling1.ogg"},"낯섦":{"voiceline":"노블레스 오블리주… 참으로 엘레강트한 말이라고 생각하지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/feeling2.ogg"},"호감":{"voiceline":"\"이상\"이라는 대의를 위해서라면 친족이라도 연을 끊어내고, 적으로서 마주하는 것도 불사한다…… 참으로 한탄스러운 일이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/feeling3.ogg"},"기쁨":{"voiceline":"함께 역경을 극복한 상대여야 내 등을 맡길 수 있다…… 저는 그렇게 생각한답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님과 함께라면, 어떤 고난도 간단히 극복할 수 있을 것 같은… 그런 느낌이 들어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 근무 수고하셨어요. 다음 업무는 홍차라도 한 잔 드시고 계속하는 게 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/home.ogg"},"hp 경고":{"voiceline":"승부는… 이제부터랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/hp_warning.ogg"},"로그인":{"voiceline":"어머, 평안하신가요? 오늘의 명령은 무엇인가요? 출격도 의뢰도, 이 제게 맡기셔도 좋답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/login.ogg"},"실패":{"voiceline":"가끔은 이런 일도 일어나는군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/lose.ogg"},"우편":{"voiceline":"미지의 상대가 건네는 인사는 기쁘답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/mission.ogg"},"임무완료":{"voiceline":"고생하신 지휘관님을 위한 포상이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/mission_complete.ogg"},"서약":{"voiceline":"드디어… 드디어 이날이… 역시 지휘관님이야말로 제 운명의 파트너였군요! 르 트리옹팡, 이 검, 이 방패, 그리고 이 몸을 기꺼이 바치겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/propose.ogg"},"스킬":{"voiceline":"Pour la liberté(포 라 리베르테)!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/skill.ogg"},"터치1":{"voiceline":"지휘관님, 우리를 평범한 구축함 정도로 생각하고 계신다면 큰 코 다칠걸요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/touch.ogg"},"터치2":{"voiceline":"꺅! 르 팡타스크급의 속력조차 뛰어넘다니… 지휘관님… 얕볼 수 없군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/touch2.ogg"},"입수시":{"voiceline":"어머, 지휘관님, 평안하신가요. 자유 아이리스 교국, '엘레강트'한 구축함, 르 트리옹팡이 착임했답니다. 환상마저 초월한 공상(팡타스크)급의 힘, 똑똑히 보세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/unlock.ogg"},"강화성공":{"voiceline":"장비에서 강력한 힘의 파동이 느껴져요… 지휘관님, 감사해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"르 팡타스크급의 속도, 따라오기 쉽지는 않을 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['빅토리어스'] : 승리를 지휘관님께, 랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801010/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"FFNF","레어도":"SSR","ex_ch