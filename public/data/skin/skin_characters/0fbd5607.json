[{"클뜯 id":303200,"클뜯 함순이 id":30320,"함순이 이름":"아사마","한글 함순이 + 스킨 이름":"아사마","영문 함순이 + 스킨 이름":"Asama","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303200/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303200/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303200/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303200/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303200/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303200/shipyard.png","설명":"개조 스즈야급 중순양함 - 아사마","자기소개":{"voiceline":"개조 스즈야급 중순양함, 아사마… 이 세상에 태어나지 못한 허상의 존재지요. 그럼에도… 이 덧없고도 아름다운 세상에서 당신과 함께 마지막까지 함께하고자 합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/profile.ogg"},"메인1":{"voiceline":"제 곁에 있으니 저절로 마음이 놓인다…고요? 아마 이 약의 향기가 지휘관님의 마음을 편안하게 해드린 거겠죠…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/main1.ogg"},"메인2":{"voiceline":"지휘관님… 조금 상태가 안 좋으신 것 같네요. 아뇨, 그대로 둘 수는 없어요… 바로 건강식을 준비할 테니 조금만 기다리세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/main2.ogg"},"메인3":{"voiceline":"보답이 있든 없든, 주저하지 않고 앞으로 나아가는 당신의 모습…… 참으로 강하고… 아름답습니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/main3.ogg"},"전투개시":{"voiceline":"적에게 종말을 가져다 주지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/battle.ogg"},"상세확인":{"voiceline":"흐르는 강물이 늘 변하듯, 사람도 그 거처도 늘 변하죠…… 지휘관님도 그렇게 생각하시지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/detail.ogg"},"드랍 설명":{"voiceline":"개조 스즈야급 중순양함 - 아사마","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 처리하러 떠난 동료들을 맞이하러 가신다고요? 그럼 저도 함께하지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/expedition.ogg"},"실망":{"voiceline":"찬란히 피었다가 지는 꽃처럼, 변치 않는 것은 없다는 게 바로 이 세상의 이치……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/feeling1.ogg"},"낯섦":{"voiceline":"이 세상은 어차피 원래 그런 곳이라 여겼습니다. 당신을 만나기 전까지는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/feeling2.ogg"},"호감":{"voiceline":"정말 신기해요. 시련을 마주해도 당신께서는 늘 웃으며 받아들이시죠…… 부디 제게도 그 얼굴을 더 보여주시겠어요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/feeling3.ogg"},"기쁨":{"voiceline":"눈앞에서 흐르는 세월을 소중히 여기고, 작은 행복도 마음에 새기는 것…… 당신께서 알려주신 이치는 그 어떤 보물보다… 훨씬 값진 것이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/feeling4.ogg"},"사랑":{"voiceline":"벚꽃이 흩날리듯 모든 것은 언젠가 사라질 운명… 그렇지만…… 아무리 시간이 흘러도 당신과의 추억만은… 영원히 마음 속에 간직하며 살게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/feeling5.ogg"},"터치3":{"voiceline":"…? 제 머리를 묶어주시려는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요. 혹시 어디 불편한 데라도 있으신가요? 걱정하지 마세요. 이미 건강식을 만들어 두었으니까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/home.ogg"},"hp 경고":{"voiceline":"쿨럭, 쿨럭… 역시… 좀 무리를 한 모양이에요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/hp_warning.ogg"},"로그인":{"voiceline":"…? 지휘관님이셨군요…… 아무것도 아닙니다. 그저 평온하게 지낼 수 있다는 것만으로도 충분해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/login.ogg"},"실패":{"voiceline":"쿨럭, 쿨럭…… 패배했군요…… 이것 또한…… 숙명이겠죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/lose.ogg"},"우편":{"voiceline":"유용한 정보는 놓쳐선 안 돼요. 특히 편지는 더욱 조심해야 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/mail.ogg"},"임무":{"voiceline":"새로운 임무가 왔군요. 서두르지 말고 차근차근 하시면 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/mission.ogg"},"임무완료":{"voiceline":"이제 일도 일단락되었군요. …기분 전환 삼아 온천에 들러보시는 건 어떤가요? 저와 당신, 단둘이서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/mission_complete.ogg"},"서약":{"voiceline":"결정을 내리셨군요…… 그렇다면 이 아사마도 영원히 당신의 손을 놓지 않겠어요. 당신의 따스한 손길을 느낄 때마다 전…… 늘 곁에 머무르며 함께 흐르는 계절을 바라보고 싶어져요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/propose.ogg"},"스킬":{"voiceline":"경탄하라, 그리고 재가 되어 사라져라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/skill.ogg"},"터치1":{"voiceline":"……약이 된다면, 독으로도 쓸 수 있는 법이지요. 지휘관님, 모쪼록 조심하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/touch.ogg"},"터치2":{"voiceline":"으음…… 당신과 나눈 환희, 애정이…… 한동안 제 몸에 남아 있으리라 생각하니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/touch2.ogg"},"입수시":{"voiceline":"지휘관님이시군요…… 아사마, 기다리고 있었습니다. 하아… 편안한 시간이 물거품처럼 덧없어도…… 당신과 함께라면 꿈속까지도 함께하고 싶어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/unlock.ogg"},"강화성공":{"voiceline":"당신께서 제게 주신 힘… 행여나 그걸 잃을까 두렵습니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/upgrade.ogg"},"vote":null,"승리":{"voiceline":"여흥치고는 제법 볼만한 광경이었죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"아아… 당신과 함께 하는 시간은 참으로 짧지만…… 단 한순간이라도 곁에 있을 수 있다면… 서로를 끌어안고 느낀 그 따스함은 영원히 제 마음속에 남을 거예요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"후후… 지휘관님의 손바닥에서도… 이제 제 약의 향기가 느껴지네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어서 오세요. 부디 조금만 더…… 당신과 함께하는 이 시간에 더 푹 빠질 수 있게 해주세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 오세요. …기분이 좋아 보인다…고요? 후후, 당신과 함께 있는 것만으로도 저는 만족하니까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"또 새로운 일이 생긴 건가요? 당신과 함께 하는 시간이 줄어들기 전에, 빨리 끝내버리도록 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/mission_ex.ogg"},"임무완료_ex":{"voiceline":"업무가 끝났네요……그럼, 가시죠. 목욕 준비는 이미 마쳐두었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"여기… 말씀인가요? 후후…… 이것도 당신께서 남겨주신 자국이랍니다…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/touch_ex.ogg"},"터치2_ex":{"voiceline":"지휘관님께서 남겨주신 자국이 마치 꽃처럼 피어나…… 더욱더 아름답게……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"함께…… 목욕이라도 어떠신가요? 네, 지난번에…… 당신을 「활기차게」 만들어 드린 그거 말이죠…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님… 제 손을 잡아주지 않으시겠어요? …네, 그래요. 당신께서 계시는 한, 이 세상은 결코 스러지지 않아요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303200/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":303201,"클뜯 함순이 id":30320,"함순이 이름":"아사마","한글 함순이 + 스킨 이름":"요괴의 밤에 피어나","영문 함순이 + 스킨 이름":"Blooming Upon a Bewitching Night","스킨 타입":"Ninja Castle","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303201/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303201/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303201/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303201/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303201/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303201/shipyard.png","설명":"지휘관님…? 그 모습… 모두가 들려준 괴담만으로는 부족하셨던 모양이네요… 부끄럽지만 전 아직도 너무 무서운데… 곁에 있어 주실 수 있나요…? 당신께만 전하고 싶은 말도 있어서요……","자기소개":null,"메인1":{"voiceline":"네? 무언가 불길한 걸 보셨다고요? 우후후, 분명 잘못 보신 거겠죠. 이 방에는 저와 당신… 둘뿐이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/main1.ogg"},"메인2":{"voiceline":"……공이 움직였다고요? 우후후, 착각하신 거겠죠. 정 신경 쓰이시면… 아사마의 품에서 잠깐 쉬시는 게 어때요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/main2.ogg"},"메인3":{"voiceline":"그림자는 마음을 비추는 거울이라고도 하죠. 그렇다면 지휘관님을 향한 제 이 마음은 어떤 모습으로 드러날까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"나그네를 유인해 기회를 틈타 그 고기를 탐한다는 여자 거미 요괴 이야기…… 저도 들어본 적 있어요. 그렇지만 걱정하지 마세요. 제가 있는 한, 당신께 그런 일은 절대…… 우후후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님…? 그 모습… 모두가 들려준 괴담만으로는 부족하셨던 모양이네요… 부끄럽지만 전 아직도 너무 무서운데… 곁에 있어 주실 수 있나요…? 당신께만 전하고 싶은 말도 있어서요……","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"요괴야 피하면 될 일이지만, 세상일은 그리 호락호락하지 않답니다. 정신을 차렸을 때는 이미 아사마의 손바닥 위…일지도 몰라요…… 우후후, 저와 함께하는 이 좋은 밤을 부디…… 부드럽게 맞이하시길……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/feeling5.ogg"},"터치3":{"voiceline":"어떠세요? 지휘관님께서 착각하신 거죠? 우후후…… 제 머리에 뿔 같은 건 없잖아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/headtouch.ogg"},"모항귀환":{"voiceline":"정말 훌륭한 전과였어요. 이걸로 작은 게임을 하나 해볼까요? 만약 지휘관님께서 지면… 제가 살짝 들러붙는 걸로……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요, 지휘관님… 목이 마르시다면, 차 한 잔 어떠신가요? 후후, 저도 함께할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새로운 임무가 왔군요. 지휘관님, 밤길을 걷다 거미줄에 걸리지 않도록 조심하세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/mission.ogg"},"임무완료":{"voiceline":"임무가 끝났나요? 그럼, 둘만의 유희를 다시 즐겨볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"어머… 제게 남기신 자국을… 다시 보고 싶으신 건가요? 아니면…… 오늘 밤은 더 많은 것을… 남겨 주시려고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/touch.ogg"},"터치2":{"voiceline":"우후후… 지휘관님, 이젠 도망칠 수 없어요…… 아앙… 으음……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/touch2.ogg"},"입수시":{"voiceline":"지휘관님…? 그 모습… 모두가 들려준 괴담만으로는 부족하셨던 모양이네요… 부끄럽지만 전 아직도 너무 무서운데… 곁에 있어 주실 수 있나요…? 당신께만 전하고 싶은 말도 있어서요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303201/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임