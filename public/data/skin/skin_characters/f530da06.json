[{"클뜯 id":108080,"클뜯 함순이 id":10808,"함순이 이름":"플래셔","한글 함순이 + 스킨 이름":"플래셔","영문 함순이 + 스킨 이름":"Flasher","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108080/shipyard.png","설명":"가토급 잠수함—플래셔, 현호 SS-249","자기소개":{"voiceline":"가토급 잠수함인 플래셔야. 눈물이 많다던가… 흑… 절대 그런 건…… 흐흑…… 딱히 마음이 약한 건 아니야. 싸우게 되면 나한테 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/profile.ogg"},"메인1":{"voiceline":"말다툼은 정말 싫어…… 왜냐면 나, 항상 무슨 말을 하기 전에 울어버리는걸… 받아칠 말은 떠오르는데도…… 흑흑……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/main1.ogg"},"메인2":{"voiceline":"다들 정말 좋은 사람들이야… 나랑 무슨 일이 생겨도 늘 평화롭게 끝내고…… 내가 잘못한 거라도 항상 먼저 사과해 줘…… 흑… 왜 그러지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/main2.ogg"},"메인3":{"voiceline":"싸, 싸우지 않을 때는 다른 사람들이 입을 코스튬을 만들고 있어…… 지휘관, 음… 혹시 코스프레하고 싶은 캐릭터 있어? 내가… 흑… 옷 만들어 줄게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/main3.ogg"},"전투개시":{"voiceline":"도망칠 수 있을 거라 생각하지 마……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/battle.ogg"},"상세확인":{"voiceline":"옷에 프릴이나 아플리케 자수는 다 내가 넣은 거야… 개복치 인형도! 항상 가지고 다니면 다칠 일도 없고, 갑자기 소리에 놀라서 어딘가로 도망칠 일도 없어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/detail.ogg"},"드랍 설명":{"voiceline":"가토급 잠수함 - 플래셔 SS-249","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 돌아왔어~ 짐을 잔~뜩 가지고 온 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/expedition.ogg"},"실망":{"voiceline":"목표 출현! 음…… 저기…… 지휘관, 시, 실례할게…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/feeling1.ogg"},"낯섦":{"voiceline":"와아…! 지휘관한테 칭찬받았어……! 에헤헤, 할 일을 한 것뿐인데… 에헤헤… 좀 부끄럽네… 흑…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/feeling2.ogg"},"호감":{"voiceline":"심심할 때는 수족관에 자주 가… 물속인데 바닷속이랑은 다르게 조용하고 평화로워~ 물고기들이 사방에서 뻐끔뻐끔하고 있는 걸 보면 마음이 굉장히 차분해져~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 위에서 두 번째 단추가 좀 느슨해진 것 같은데…? 플래셔한테 잠깐 줘볼래? 음… 지금은 바느질 도구가 없는데… 따로 꿍꿍이가 있어서 지휘관의 두 번째 단추를 노리는 건 아니고… 흑흑…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/feeling4.ogg"},"사랑":{"voiceline":"에헤헤~ 지휘관, 지금은 인형을 만들고 있어. 봐! 얘는 바다표범이고, 얘는…… 앗?! 이 단추… 어디서 많이 본 것 같다고…? 흑… 그야 지, 지휘관이 준 단추니까… 지휘관 인형을 만들어서 계속 내 곁에 두려고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/feeling5.ogg"},"터치3":{"voiceline":"조금만 더 이렇게 쓰다듬어 줄래…? 응… 고마워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/headtouch.ogg"},"모항귀환":{"voiceline":"성가신 적은… 없었어…? 휴우…… 아, 안심했어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/home.ogg"},"hp 경고":{"voiceline":"이 정도 부상은… 흐, 흥…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이야, 지휘관. 오늘 하루는 좋은 날이네. 적 함선이나 사냥하러 갈까……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/login.ogg"},"실패":{"voiceline":"으아앙…… 졌어… 다음에는 꼭 이겨서… 승리를 되찾을 거야……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/lose.ogg"},"우편":{"voiceline":"실례할게… 지휘관, 새로운 우편이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/mail.ogg"},"임무":{"voiceline":"새로운 임무… 지휘관, 지금 처리할 거야…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/mission.ogg"},"임무완료":{"voiceline":"임무, 무사히 완료! 위문품도 도착했네~ 와아, 생각보다 많아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 이렇게 정중하게 건네줄 줄은……! 너, 너무 기쁘지만… 어떻게 해야 할지 모르겠어… 흑흑… 누, 눈물이… 갑자기 나와… 기, 기뻐서… 계속 지휘관 곁에 있을게……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/propose.ogg"},"스킬":{"voiceline":"놓치지 않겠어…!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/skill.ogg"},"터치1":{"voiceline":"지휘관이 쓰다듬어주면… 기뻐…… 아! 바늘을 들고 있는 걸 깜빡했어…… 으아아앙… 손가락이 찔렸어… 흑흑…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/touch.ogg"},"터치2":{"voiceline":"흑흑…… 저, 정말 이래도 괜찮겠어……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/touch2.ogg"},"입수시":{"voiceline":"만나서 반가워, 지휘관… 나는 가토급 잠수함인 플래셔, SS-249…… 흑… 우, 우는 건… 그, 그러니까 깜짝 놀라거나 몸이 안 좋아서 그런 게 아니라… 조금 감동해서… 흑, 눈물이 나온 것뿐이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/unlock.ogg"},"강화성공":{"voiceline":"걱정을 끼쳤네… 고마워……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"완벽히, 격침…… 흑… 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관, 개복치 인형 마음에… 들어? 똑같은 거 만들어줄게~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108080/detail_ex