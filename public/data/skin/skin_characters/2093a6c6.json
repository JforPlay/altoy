[{"클뜯 id":301170,"클뜯 함순이 id":30117,"함순이 이름":"카게로","한글 함순이 + 스킨 이름":"카게로","영문 함순이 + 스킨 이름":"Kagerou","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301170/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301170/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301170/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301170/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301170/shipyard.png","설명":"카게로형 구축함 1번함·카게로","자기소개":{"voiceline":"이이 몸은 사쿠라 엠파이어가 조약에서 탈퇴한 후 마루 3 계획에 의해 최초로 자체 설계, 건조된 신예 주력 구축함·카게로형의 1번함일세! 「네임쉽」은 장식으로 달고 있는 게 아니란 말일세! 제18 구축대의 영광은 이 몸이 지켜보이겠네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/profile.ogg"},"메인1":{"voiceline":"재미없는 것이야~ 잠시 여동생들과 외출하고 싶구나♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/main1.ogg"},"메인2":{"voiceline":"하하하~ 오늘 작전도 확실히 되돌아보는 것이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/main2.ogg"},"메인3":{"voiceline":"기운 차리게, 이 몸이 마지막까지 어울려주는 것이니까 말일세~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/main3.ogg"},"전투개시":{"voiceline":"이제야 이 몸이 나설 차례가 온 것이로구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/battle.ogg"},"상세확인":{"voiceline":"으으~ 그런 실례되는 눈으로 보지 말게나! 이 몸, 화낼 것이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/detail.ogg"},"드랍 설명":{"voiceline":"카게로형 구축함 1번함·카게로","voicelink":null},"의뢰 완료":{"voiceline":"확실히 하는 것이야! 모두가 이미 돌아와 있다네! 지휘관이란 자가 이 몸이 보고하고 나서야 행동하면 안 된다네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/expedition.ogg"},"실망":{"voiceline":"그대는 이제 이 몸의 동경의 대상이 아닐세! 저리 가시게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/feeling1.ogg"},"낯섦":{"voiceline":"빛의 굴절 현상인── 아지랑이는, 환상을 가리키는 말로도 많이 쓰이네만… 허나, 이 몸은 분명히 여기에 있다네! 환상 같은 게 아니라네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/feeling2.ogg"},"호감":{"voiceline":"이 몸의 성능에서 특출난 부분은 없네만, 다른 모두에게 지지 않을 자신은 있다네! 어째서냐고? 흐흥, 이 몸이야말로 카게로이기 때문일세!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/feeling3.ogg"},"기쁨":{"voiceline":"역시 이 몸의 눈은 틀리지 않았네, 지휘관은 항상 이 몸의 앞에 있다네… 음! 이 몸은 평생을 바쳐서라도 지휘관을 따라잡을 걸세!… 고, 고백으로 들렸다고!? 그, 그럼 그리 받아들여도 좋다네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/feeling4.ogg"},"사랑":{"voiceline":"지휘관과는 주먹을 맞대고서야 이해할 수 있는 관계가 될 거라 생각했네만, 설마 이렇게 손을 마주 잡고 이야기를 하는 관계가 될 줄이야… 음, 역시 인생이란 건 알 수 없는 것이구나. 뭐, 이건 이것대로 괜찮네만♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"당황하지 말고, 침착하게, 휴식── 쉬어야 하는 것이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어디부터, 어딜 봐도… 정말이지 어려운 문제로구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/login.ogg"},"실패":{"voiceline":"어찌 이런 굴욕을, 이 카게로, 잊지 않으마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/lose.ogg"},"우편":{"voiceline":"편지라는 것은 곧 유대일세. 유대는 인간에게 힘을 가져다준다네. 이걸 명심하고 답장하는 것이 좋을 걸세.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/mail.ogg"},"임무":{"voiceline":"임무라는 것은 성장의 지표일세. 어떤 점이 성장했는지 확실히 확인해보는 것이 좋다네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/mission.ogg"},"임무완료":{"voiceline":"보너스는 노력의 산물일세. 자, 이 몸이 가져와 준 것이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/mission_complete.ogg"},"서약":{"voiceline":"이 몸과 함께 걸어 나가겠다고?… 이제 와서 웬 호들갑인 겐가! 물어보지 않아도 알 수 있을 것이야! 이 몸의 대답은 물론, 「Yes」라네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/propose.ogg"},"스킬":{"voiceline":"이 몸 앞에서는 빛조차도 방향을 바꿔 가느니라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/skill.ogg"},"터치1":{"voiceline":"이 몸에게 용무가 있는 겐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/touch.ogg"},"터치2":{"voiceline":"이 몸에게까지 손을 댈 줄이야, 과연 지휘관…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/touch2.ogg"},"입수시":{"voiceline":"카게로형 1번함인 카게로라네! 으음, 그대는 유능해 보이는 지휘관이로구나! 이 몸과 함께 나아가세!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/unlock.ogg"},"강화성공":{"voiceline":"이 몸은 더욱더 강해지는 것이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후~ 이것이야말로 대승리! 이 몸의 전적을 장식하기에 딱이로구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301170/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_status":0},{"클뜯 id":301171,"클뜯 함순이 id":30117,"함순이 이름":"카게로","한글 함순이 + 스킨 이름":"핼러윈일세!","영문 함순이 + 스킨 이름":"Pumpkins and Festivit