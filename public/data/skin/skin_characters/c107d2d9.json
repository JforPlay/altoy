[{"클뜯 id":301650,"클뜯 함순이 id":30165,"함순이 이름":"미치시오","한글 함순이 + 스킨 이름":"미치시오","영문 함순이 + 스킨 이름":"Michishio","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301650/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301650/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301650/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301650/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301650/shipyard.png","설명":"벚꽃아, 벚꽃아. 랄라라라~ 아, 당신은… 안녕하세요, 지휘관님. 처음뵙겠습니다. 저는 미치시오, 앞으로도 잘 부탁드려요.","자기소개":{"voiceline":"저는 아사시오형의 3번함, 미치시오.처음에는 자매들과 함께 제 8구축대에 있었지만, 그 이후에는 제 24구축대를 거쳐 제 4구축대와 함께 레이테 만 해전에 참가했었죠…… 아하하, 운이 썩 좋은 편은 아니지만 이미 결정했어요. 여기서 잘 지내보기로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/profile.ogg"},"메인1":{"voiceline":"랄랄라~ 랄라라~ 오늘도 좋은 하루네요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/main1.ogg"},"메인2":{"voiceline":"오늘은 모두에게 뭘 해줘야 좋을까…… 지휘관님, 좋은 생각 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/main2.ogg"},"메인3":{"voiceline":"여기서 매일같이 모두의 미소를 보고 있으면 이곳이 정말 좋아져요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/main3.ogg"},"전투개시":{"voiceline":"친구를 잃고 싶지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 무슨 일이 있으면 얼마든지 불러주세요. 저는 부탁받는 걸 제일 좋아한답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/detail.ogg"},"드랍 설명":{"voiceline":"벚꽃아, 벚꽃아. 랄라라라~ 아, 당신은… 안녕하세요, 지휘관님. 처음뵙겠습니다. 저는 미치시오, 앞으로도 잘 부탁드려요.","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 같이 의뢰팀의 자매들을 맞이하러 가요. 거의 돌아올 시간이 되었거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/expedition.ogg"},"실망":{"voiceline":"저는 지휘관님과 친구가 될 수는 없겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 제가 필요하지는 않으신가요? 아무리 작은 일이라도 맡겨주세요. 저는 전혀 신경쓰지 않는답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/feeling2.ogg"},"호감":{"voiceline":"저는 예전에 많은 친구들을 잃었어요. 아사시오들, 스즈카제 , 우미카제 …… 그래서 저는 친구를 잃는게 두려워요. 친구를 위해서 더 많은 걸 해주고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/feeling3.ogg"},"기쁨":{"voiceline":"이미 습관이 되었다니까요. 하지만 정말 싫어하지 않아요. 누군가에게 베풀고 의지할 수 있다는 건 정말 행복한 일이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/feeling4.ogg"},"사랑":{"voiceline":"지휘관님은 정말 걱정이 많다니까요…… 그래도 꼭 보답해야 한다면, 음… 지휘관님, 영원히 사라지지 않겠다고 약속해줄 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"모두 돌아왔군요! 정말 잘 됐어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/home.ogg"},"hp 경고":{"voiceline":"모두……조금만 더 버티세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/hp_warning.ogg"},"로그인":{"voiceline":"아, 돌아오셨군요. 오늘 쓸 물건을 이미 준비해뒀답니다. 한번 보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/login.ogg"},"실패":{"voiceline":"여러분, 저를 버리지 말아주세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/lose.ogg"},"우편":{"voiceline":"지휘관님, 우편이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/mail.ogg"},"임무":{"voiceline":"지휘관님, 새로운 임무서 여기에 둘게요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 보세요. 임무 보상을 전부 가져왔어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/mission_complete.ogg"},"서약":{"voiceline":"정말 기뻐요. 태어나서 처음으로 이렇게 기뻐본 것 같아요… 하지만 앞으로도 훨씬 더 즐거운 일이 많겠죠, 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/propose.ogg"},"스킬":null,"터치1":{"voiceline":"왜 그래요, 지휘관님? 피곤한가요? 배고픈가요? 아니면 목마른가요? 전부 저에게 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/touch.ogg"},"터치2":{"voiceline":"아! 지휘관님…… 우으, 저질……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/touch2.ogg"},"입수시":{"voiceline":"벚꽃아, 벚꽃아. 랄라라라~ 아, 당신은… 안녕하세요, 지휘관님. 처음뵙겠습니다. 저는 미치시오, 앞으로도 잘 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/unlock.ogg"},"강화성공":{"voiceline":"이러면 저도 모두를 보호할 수 있겠지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이, 이건 모두의 공이에요. 저, 저는… 너무 부끄러워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301650/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_status":0},{"클뜯 id":301651,"클뜯 함순이 id":30165,"함순이 이름":"미치시오","한글 함순이 + 스킨 이름":"하늘하늘 리본","영문 함순이 + 스킨 이름":"Fluttering Fanfare","스킨 타입":"Party Dress","전체 일러":"https://raw.githubuserco