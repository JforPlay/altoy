[{"클뜯 id":201380,"클뜯 함순이 id":20138,"함순이 이름":"트라팔가","한글 함순이 + 스킨 이름":"트라팔가","영문 함순이 + 스킨 이름":"Trafalgar","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201380/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201380/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201380/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201380/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201380/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201380/shipyard.png","설명":"배틀급 구축함 - 트라팔가","자기소개":{"voiceline":"로열 네이비 소속 배틀급 구축함 트라팔가라고 합니다. 작전이나 사무 처리 같은 작업은 안심하고 맡겨주세요. ……자기소개는 이상입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/profile.ogg"},"메인1":{"voiceline":"집무실에서 파티를 여신다고요? 그럼, 저는 이만… (동료들과 친해질 기회…이기는 하지만, 사람이 이렇게나 많으면… 차라리 순찰을 도는 편이…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/main1.ogg"},"메인2":{"voiceline":"오늘 회의 말입니다만… (사실 다른 이야기를 하고 싶지만, 그래도 업무 얘기가 가장 무난하니까…) 네? 더 편한 화제로 이야기하자고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/main2.ogg"},"메인3":{"voiceline":"얼마 전 작전 보고입니다. 특별히 이상은 없었습니다. 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/main3.ogg"},"전투개시":{"voiceline":"로열 네이비의 영광을 위하여.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/battle.ogg"},"상세확인":{"voiceline":"다음 주 훈련 계획을 작성했습니다. 이쪽은 첫 번째 방안, 그리고 이쪽은 두 번째 방안, 악천후 대비 예비안은 여기 있습니다. 아… 이건…… 제 개인적인 메모입니다. 중요한 건 아닙니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/detail.ogg"},"드랍 설명":{"voiceline":"배틀급 구축함 - 트라팔가","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔습니다. 저도 함께 물자를 확인하러 가겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/expedition.ogg"},"실망":{"voiceline":"지휘관님, 전장에서도 그렇게 무모하게 행동하시는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/feeling1.ogg"},"낯섦":{"voiceline":"으흠, 지휘관님. 출격을 신청합니다. (후우… 요즘 들어 친목 모임이 너무 많은데, 이런 것도 다 사회생활이라 그냥 거절하기도 뭣하고… 전투에 나갔다고 핑계를 대면……)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/feeling2.ogg"},"호감":{"voiceline":"(지휘관님은 서류를 이렇게 처리하시는구나. 좋아, 기억해 둬야지……) ……아, 저 말씀인가요? 아뇨, 멍하니 있었던 게 아니라, 다음 작전 계획에 대해 생각하고 있었습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/feeling3.ogg"},"기쁨":{"voiceline":"지, 지휘관님. 서류를 착각했어요…… 보, 보지 마세요…… 그건 작전 계획이 아니라 제 개인적인 메모장이라…… (으아… 어쩌다가 지휘관님 연구 노트를 저기 둔 걸 잊어버린 거지…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/feeling4.ogg"},"사랑":{"voiceline":"사실 저… 시끌벅적한 자리가 불편해요… 동료들을 실망시키고 않으려고 생각을 많이 하다 보니, 말수도 줄어들고…… 후우… 이런 얘기를 하는 건 지휘관님이 처음이에요. 죄송해요… 이런 한심한 모습을…… 그래도 제가 아는 지휘관님이라면… 이런 말을 해도 놀리지 않으실 것 같아서요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/feeling5.ogg"},"터치3":{"voiceline":"아, 음…… (너무 차갑게 굴었나… 아, 지휘관님이 손을 떼셨어…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 커피를 준비했습니다. ……지휘관님도 괜찮으시면 한 잔 드시죠. (영화에서는 다들 자연스럽게 하던데, 왜 나는 이렇게나 어색한 걸까…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/home.ogg"},"hp 경고":{"voiceline":"상황이 바뀌었군요. 계획을 수정하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/hp_warning.ogg"},"로그인":{"voiceline":"오늘 일정입니다. 처리해야 하는 서류는 저쪽에 뒀습니다. 이상 없으면 집무를 시작하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/login.ogg"},"실패":{"voiceline":"지휘관님, 예비 작전에 대한 결단을 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/lose.ogg"},"우편":{"voiceline":"여기, 지휘관님 앞으로 온 우편입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/mail.ogg"},"임무":{"voiceline":"…앗. 지휘관님, 여기 새로운 임무 목록입니다. 확인하시기 바랍니다. (바, 방금 손가락이 닿은 것 같은데……)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/mission.ogg"},"임무완료":{"voiceline":"고생 많으셨습니다, 지휘관님. 여기 임무 보상입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/mission_complete.ogg"},"서약":{"voiceline":"후우…… 말보다 행동으로 증명하고 싶어요. 계속 당신 곁을 지키며, 이 검으로 늘 당신을 지키겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/propose.ogg"},"스킬":{"voiceline":"이 순간을 바다의 기억 속에 새기겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/skill.ogg"},"터치1":{"voiceline":"제 옷깃이…? 네, 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/touch.ogg"},"터치2":{"voiceline":"……?! 뭐, 뭘 하시는 거죠…? (이, 이럴 땐 어떻게 해야 하지…?!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 지휘관님. 로열 네이비 소속인 트라팔가입니다. 이렇게 뵙게 되어 영광입니다. (너무 차가웠나…… 그래도 말을 너무 많이 하면 무례해 보일 수 있으니……)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/unlock.ogg"},"강화성공":{"voiceline":"제가 성장하는 걸 지켜보세요, 지휘관님. (너무 건방지게 말했나…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/upgrade.ogg"},"vote":null,"승리":{"voiceline":"로열 네이비의 영광은 퇴색하지 않습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관님, 내일… 데이트 계획을 무사히 작성했습니다. 확인 부탁드립니다. 돌발 상황에 대비한 각종 응급 대처 방안도 같이 읽어주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"(지난번에 공부한 방법으로는 잘 안됐어…… 지휘관님이 이 세상에서 유일무이한 존재라서 그런 걸까?) ……아, 지휘관님. 멍하니 있었던 건 아니에요. 그저…… 잠깐 당신 생각을 하고 있었답니다… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"아, 으음… 아. 저 지금… 이상한 표정 짓고 있지는…않죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관님, 디저트를 만들었는데… 좀 드시겠어요? (지휘관님 연구 노트, 7페이지 5번째 줄… 지휘관님이 좋아하시는 맛으로 준비했어… 마음에 드실 거야…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 오늘 업무를 시작하기 전에…… 아, 음… 보고 싶었…어요. (드디어 말했어…… 지휘관님도 기뻐하시는 것 같고…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관님, 옷깃이…… 가만히 계세요. 제가 정리해 드릴게요..","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/touch_ex.ogg"},"터치2_ex":{"voiceline":"으음…… 네, 지휘관님은 이런 걸 좋아하시죠? 저도 잘 알아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['시애틀'] : 파티…? 거절해야 하나, 아니면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/couple_encourage1.ogg"},{"voiceline":"['퀸 엘리자베스'] : 로열 네이비의 영광을 위하여!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/couple_encourage2.ogg"}],"메인4":{"voiceline":"…네. 지휘관님의 집무 책상을 정리한 게 저이기는 하지만…… 고마워하실 필요 없습니다. 그렇게 대단한 일도 아니니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"다들 참석하는 파티를 여시는 거면, 아무래도 전 빠져 있는 편이…… 그대로 남아달라고요? 그렇지만 전 이런 사교 자리는…… 지휘관님 곁에만 있어도 되나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/main5_ex.ogg"},"메인6_ex":{"voiceline":"후우… 오늘은 날씨가 좋네요… 지, 지휘관님. 이런 화제는 어때요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/main6_ex.ogg"},"메인7_ex":{"voiceline":"지휘관님, 요청하신 자료를 모두 정리했습니다. …피곤하신 것 같네요. 잠깐 쉴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/main7_ex.ogg"},"메인8_ex":{"voiceline":"다음 작전 계획에 대해 이야기하고 싶으시다고요? 그럼 자료를 보여…… 거기 앉으라고요…? (지휘관님의 허벅지 위에…?)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201380/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"UR","ex_chat_status":1},{"클뜯 id":201381,"클뜯 함순이 id":20138,"함순이 이름":"트라팔가","한글 함순이 + 스킨 이름":"높은 봉우리와 바닷바람","영문 함순이 + 스킨 이름":"Sea Breeze, Moonlit Talks","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201381/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201381/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201381/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201381/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201381/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201381/shipyard.png","설명":"바람이 참 좋네요. 지휘관님, 괜찮으시면 저랑 한잔하시겠어요? (영화에서 본 대로 했으니까 괜찮겠지…? 표정이 너무 굳어 있었나…?","자기소개":null,"메인1":{"voiceline":"으음… 역시 바닷바람을 맞으니 기분이 좋네요… 그렇지 않나요?","voicelink":"https://ra