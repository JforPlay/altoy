ubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/feeling1.ogg"},"낯섦":{"voiceline":"알고 있어? 남자는 동정인 채 30살을 넘기면 마법사가 된대!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/feeling2.ogg"},"호감":{"voiceline":"리얼충 따위…… 아아아, 안되겠다 나~ (투덜대며 혼잣말)……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 있지…… 아킬레스와 시험해보지 않을래? 그…… 그거 말야! 함께 놀러 나가는 거! 도시락 만들어 줄게! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/feeling4.ogg"},"사랑":{"voiceline":"에헤헤, 좋아하는 사람한테 밥 만들어 주는 거 생각보다 즐거운데…… 앞으로도 아킬레스한테 맡기라구~☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 굿잡~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 지휘관. 정말 헷갈리지 말라구. 아킬레스라구? 기억했어? 기억했지? 아─킬─레─스, 라구☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/login.ogg"},"실패":{"voiceline":"우우…… 아직 재능이 피어나지 못했다는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/lose.ogg"},"우편":{"voiceline":"새로운 메일이야☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/mail.ogg"},"임무":{"voiceline":"괜찮아 괜찮아! 임무 따위 몇 개라도 덤벼 보라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/mission.ogg"},"임무완료":{"voiceline":"보너스도 잊지 마☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/mission_complete.ogg"},"서약":{"voiceline":"지휘관도 아킬레스가 없으면 안 된다는 걸 알았구나? 흐흥~ 걱정하지 마. 아킬레스는 지휘관한테서 떨어지지 않을 테니까~ 약속이야☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202020/propose.ogg"},"스킬":{"voiceline":"아킬레스, 간다앗!","voicelink"