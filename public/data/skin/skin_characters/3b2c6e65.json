[{"클뜯 id":404030,"클뜯 함순이 id":40403,"함순이 이름":"자이틀리츠","한글 함순이 + 스킨 이름":"자이틀리츠","영문 함순이 + 스킨 이름":"Seydlitz","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404030/shipyard.png","설명":"순양전함—자이틀리츠","자기소개":{"voiceline":"메탈 블러드 소속, 순양전함 자이틀리츠입니다! 불굴은 곧 나의 명예, 전과는 곧 나의 영광! 그리고 이 모항에서는 상관님의 칼날이 되어 활약하리라! 자, 상관님, 분부만 내려주십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/profile.ogg"},"메인1":{"voiceline":"뤼초! 그런 짓을 하면 상관님께서 난처하시잖아! …아니, 난처하게 만드는 게 뭐가 나쁘냐니…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/main1.ogg"},"메인2":{"voiceline":"영웅이 되겠다는 둥, 허황된 소원은 품지 않습니다. 저는 상관님 곁에서 충실히 사명을 다할 뿐입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/main2.ogg"},"메인3":{"voiceline":"동료를 의심하는 건 경멸받아 마땅한 행위입니다. 의심을 한다면, 자신부터 돌아보는 것이 우선이겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/main3.ogg"},"전투개시":{"voiceline":"Achtung! 적을 섬멸하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/battle.ogg"},"상세확인":{"voiceline":"상관님, 지금 저희는 이 모항에서 싸우고 있지만, 언젠가는 더 높이 도약해 인류의……. 아닙니다. 주제넘은 발언 죄송합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/detail.ogg"},"드랍 설명":{"voiceline":"순양전함—자이틀리츠","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔습니다! 상관님, 확인 부탁드립니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/expedition.ogg"},"실망":{"voiceline":"제가 부족한 탓에…. 상관님, 대단히 죄송합니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/feeling1.ogg"},"낯섦":{"voiceline":"염치 불고하고 주제넘은 청 하나 드리겠습니다. 상관님, 순양전함 자이틀리츠에게 아낌없는 명령을 부탁드립니다! 사양하실 필요는 없습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/feeling2.ogg"},"호감":{"voiceline":"상관님의 결정에는 의심의 여지가 없습니다. 다만… 제가 지금 하고 있는 것이 상관님께 바람직한 일인지 다소 염려가 되어……. 임무에 지장을 초래할 정도는 아니니, 안심하십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/feeling3.ogg"},"기쁨":{"voiceline":"자신의 바람대로 휴일을 보내는 것… 그것도 좋지만, 제가 이렇게 쉬는 게 상관님께 바람직한 일인지…. 그것이 상관님의 명령이라면 따르겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/feeling4.ogg"},"사랑":{"voiceline":"데, 데이트 말씀이십니까? 상관님께서 왜 이런 제게……. 아닙니다, 자이틀리츠와 데이트를 원하신다면, 따를 수밖에 없겠지요! 데이트뿐만 아니라, 데이트를 즐기는 것도 포함해서 다 완수해 보이겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/feeling5.ogg"},"터치3":{"voiceline":"아! 무슨 일이십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/headtouch.ogg"},"모항귀환":{"voiceline":"개선하시는 상관님께 경례! 휴우… 이걸로 또 하나 올바른 전투가 이뤄졌네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/home.ogg"},"hp 경고":{"voiceline":"아가씨들, 제 뒤에 숨어 계십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/hp_warning.ogg"},"로그인":{"voiceline":"경례! 상관님, 오늘부터 모쪼록 많은 지도 부탁드립니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/login.ogg"},"실패":{"voiceline":"명령을 엄수하지 못한 나의 패배인가……. 한심하기 짝이 없군…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/lose.ogg"},"우편":{"voiceline":"네! 여기 새로 도착한 우편입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/mail.ogg"},"임무":{"voiceline":"임무입니다! 일단은 새로운 것부터 시작하면 되겠지요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/mission.ogg"},"임무완료":{"voiceline":"임무 보상입니다! 휴우… 그럭저럭 무사히 완수한 모양입니다. 축하드립니다, 상관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/mission_complete.ogg"},"서약":{"voiceline":"결혼을 제의해주신 것은 기쁩니다만, 제 대답이 상관님께서 바라는 것일지는…. 아닙니다! 거절하다니 가당치도 않습니다! 다만, '기꺼이'가 좋을지, '사랑해요'가 좋을지… 표현 문제로……. 상관님께서 원하시는 바가 있다면 말씀해 주십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/propose.ogg"},"스킬":{"voiceline":"침몰하지 않을 겁니다……. 절대로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/skill.ogg"},"터치1":{"voiceline":"네! 명령에 따르겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/touch.ogg"},"터치2":{"voiceline":"사, 상관님?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드 전함 자이틀리츠, 상관님께 경례! 이 모습은 아직 익숙지 않습니다만, 오늘부터 모항에서 우리의 대의를 위해, 분골쇄신의 정신으로 힘쓰겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/unlock.ogg"},"강화성공":{"voiceline":"강화에 성공했습니다, 상관님! 정말 감사합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"앞선 작전에서 보여주신 현장 지휘, 무척이나 훌륭하셨습니다! 다만, 저 자신이 어디까지 실행해낼 수 있을지는, 솔직히 자신이 없어서…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"상관님, 저 때문에 고민하실 필요 없습니다. 자신답게 행동하는 것은 자신이 해야할 행동의 결과를 받아들이는 것과 같으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"상관님께 데이트를 신청했는데… 정말 이래도 괜찮은 걸까……. 설마……. 아, 아뇨! 아무것도 아닙니다! …그, 그렇게 즉답을 하셔도 제 마음의 준비가 아직……. 이러시면 곤란합니다, 상관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"상관님, 저를… 크흠, 저를 여자로 대하셔봤자 소용없다고 분명 말씀 드렸을 텐데요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"상관님께서 목이 마르실 것 같아, 차… 차를 준비했습니다! 드십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘 하루도 상관님께서 바라시는 대로 열심히 하겠습니다! …저, 저기… 혹시 결례가 되는 부분이 있다면 언제든 주의를… 읏….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/login_ex.ogg"},"실패_ex":{"voiceline":"상관님! 아가씨들! 뒤는 제게 맡기고 어서 탈출하십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/lose_ex.ogg"},"우편_ex":null,"임무_ex":{"voiceline":"상관님, 어느 임무부터 처리할지 지시해주시기 바랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"저라도 괜찮으시다면, 고민을 들어드리겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/touch_ex.ogg"},"터치2_ex":{"voiceline":"저, 전… 상관님만 괜찮으시다면……. 아, 아무것도 아닙니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"자이틀리츠, 무훈 1위를 획득했습니다! 이 승리를 동료들에게, 그리고 지휘관님께 바칩니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['KMS'] :  아가씨들, 여긴 제게 맡겨주십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"상관님께서 전사다운 모습이 아니라, 더 여성스러운 행동을 원하신다면…. 어떻습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/main5_ex.ogg"},"메인6_ex":{"voiceline":"제 의견에 늘 귀를 기울여주시는 상관님은 역시 상냥하신 분이십니다. 그에 비해 자기자신조차 믿어주지 않은 저는….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"여기서 상관님께 도움을 드릴 수 있는 방법은…. 버, 벌써 업무를 끝내신 겁니까? 그, 그렇군요….(풀이 죽음)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404030/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":404031,"클뜯 함순이 id":40403,"함순이 이름":"자이틀리츠","한글 함순이 + 스킨 이름":"암멸의 족보","영문 함순이 + 스킨 이름":"Heir of the Vampire Killer","스킨 타입":"Blood Moon","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404031/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404031/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404031/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404031/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404031/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404031/shipyard.png","설명":"이곳은 혼돈에서 탄생한 뱀파이어의 성…. 자이틀리츠의 명예를 걸고, 건곤의 혈족의 운명을 여기서 끊어내겠습니다!","자기소개":null,"메인1":{"voiceline":"드디어 만났군, 뤼초! 상관님의 업무를 방해하는 원수! 여기서 죗값을 치르게 해주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404031/main1.ogg"},"메인2":{"voiceline":"지금 자이틀리츠는 함선일 뿐만 아니라, 마를 멸하는 검…. 주어진 이 역할, 완수하고 말겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404031/ma