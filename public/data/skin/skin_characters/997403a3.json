[{"클뜯 id":402010,"클뜯 함순이 id":40201,"함순이 이름":"쾨니히스베르크","한글 함순이 + 스킨 이름":"쾨니히스베르크","영문 함순이 + 스킨 이름":"Königsberg","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402010/shipyard.png","설명":"쾨니히스베르크급 경순양함·쾨니히스베르크","자기소개":{"voiceline":"쾨니히스베르크급 경순양함 1번함, 쾨니히스베르크. 메탈 블러드에서 오랫동안 종사했었어요. 최전방보단 수송 임무… 특히 훈련 쪽에서 활약해왔으니, 쾨니히스베르크 선생님이라고 불러도 상관없다고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/profile.ogg"},"메인1":{"voiceline":"그런 얼굴을 하고선, 누나가 귀여워 해줬으면 하는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/main1.ogg"},"메인2":{"voiceline":"여성의 연령을 묻는 건 신사가 할 짓이 아니랍니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/main2.ogg"},"메인3":{"voiceline":"채찍은 익숙해지면 아프지 않아요, 지휘관, 시험해보시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/main3.ogg"},"전투개시":{"voiceline":"자아, 지금이 훈련의 성과를 보여줄 때! 적을 벌벌 떨게 만들어 주는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/battle.ogg"},"상세확인":{"voiceline":"알겠나요? 카탈로그의 수치만 주목하면, 실전에서 심한 꼴을 당할 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/detail.ogg"},"드랍 설명":{"voiceline":"쾨니히스베르크급 경순양함·쾨니히스베르크","voicelink":null},"의뢰 완료":{"voiceline":"원정 나갔던 애들이 돌아왔어요. 마중 나가는 것 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/expedition.ogg"},"실망":{"voiceline":"(찰싹!) 자, 다음은 체벌 시간이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/feeling1.ogg"},"낯섦":{"voiceline":"어머? 이거는 지휘관, 뭘 하려는 거죠? 누나한테 알려줘도 좋다고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/feeling2.ogg"},"호감":{"voiceline":"지휘관은 좀 더 멋진 아이라고 생각했지만, 이건 이거대로 나쁘지 않아요. ……조교라는 의미로, 우후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/feeling3.ogg"},"기쁨":{"voiceline":"음? 지휘관은 꽤나 마음에 들었답니다? 여러 가지 의미로…… 앞으로도 쾨니히스베르크 선생님이 하나하나 자상하게 가르쳐줄게요. 우후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/feeling4.ogg"},"사랑":{"voiceline":"조교란 것은, 교육하는 사람 본인도 애정을 담지 않으면 안 돼요. 그렇지 않으면…… 네, 사랑해요, 지휘관. (쪽) 그럼, 다음은 어떤 플레이를 시험해볼까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고했어요. 그럼 바로, 작전 반성회라도 열어볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"그럼, 오늘 훈련을 시작해보죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/login.ogg"},"실패":{"voiceline":"칫, 역시 방공이 부족하다니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/lose.ogg"},"우편":{"voiceline":"우편함 체크는 빠르게 할 것. 사람을 기다리게 하는 건 좋지 않답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/mail.ogg"},"임무":{"voiceline":"이번엔 어떤 임무가 왔는지 보죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/mission.ogg"},"임무완료":{"voiceline":"응? 임무가 완료된 것 같네요. 좋아 좋아, 보수 받는 것도 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/mission_complete.ogg"},"서약":{"voiceline":"지휘관은 정말 최고예요…… 뭐가, 인가요? 우후후, 뭐일까요. 펫, 동료, 혹은…… 연인으로서?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/propose.ogg"},"스킬":{"voiceline":"흐흥, 너희들도 교육 받고 싶니? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/skill.ogg"},"터치1":{"voiceline":"응? 지휘관, 아직 기운 넘치는구나… 코스를 늘려줘도 괜찮을 것 같네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/touch.ogg"},"터치2":{"voiceline":"어라? 이런 걸로는 안 돼요. 누나가 여자를 만지는 올바른 방법을 알려줄까? 우후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관? 귀여운 얼굴을 하고선, 우후후… 누나가 확실하게 「돌봐」줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/unlock.ogg"},"강화성공":{"voiceline":"조금 기분 좋아…… (찰싹!) 지휘관, 잠깐 어울려 줄 수 있으실까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥, 이 정도인가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"N","ex_chat_status":0}]