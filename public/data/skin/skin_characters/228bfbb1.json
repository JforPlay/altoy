[{"클뜯 id":301570,"클뜯 함순이 id":30157,"함순이 이름":"하루츠키","한글 함순이 + 스킨 이름":"하루츠키","영문 함순이 + 스킨 이름":"Harutsuki","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301570/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301570/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301570/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301570/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301570/shipyard.png","설명":"아키즈키급 구축함 9번함 - 하루츠키 ","자기소개":{"voiceline":"아키즈키급 구축함의 9번함, 하루츠키에요. 사정이 있어서 별로 도움은 되지 못했지만요… 그, 그래도 이번에는 노력할게요! 지휘관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/profile.ogg"},"메인1":{"voiceline":"신이시여, 모항의 여러분이 무사히 귀환할 수 있도록……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/main1.ogg"},"메인2":{"voiceline":"요이즈키는 차가워보여도, 사실은 모두를 생각하는 착한 아이라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/main2.ogg"},"메인3":{"voiceline":"니, 니이즈키 언니! 힘내요! 저, 저도 응원… 할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/main3.ogg"},"전투개시":{"voiceline":"치, 치마가~~!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/battle.ogg"},"상세확인":{"voiceline":"꺅!? 지, 지휘관님 언제부터 계셨어요!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/detail.ogg"},"드랍 설명":{"voiceline":"아키즈키급 구축함 9번함 - 하루츠키","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님! 다, 다들 무사히 돌아왔어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/expedition.ogg"},"실망":{"voiceline":"지휘관님, 저주를 받아버린 걸까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/feeling1.ogg"},"낯섦":{"voiceline":"그때는 여러 곳에 흩어졌던 동료들이…… 여기에 다시 모였습니다. 저, 정말 다행이에요오……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/feeling2.ogg"},"호감":{"voiceline":"아아, 머, 머리카락이…… 후소 씨도 없고, 어떡하지…… 앗! 정리해주시는 건가요? 지휘관님, 감사합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/feeling3.ogg"},"기쁨":{"voiceline":"하, 하루츠키의 무녀춤을 보고 싶다, 구요? 하, 하루츠키, 아직 연습 같은 거 전혀…… 이것도 연습이라고 후소 씨가…? 알겠습니다! 노, 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/feeling4.ogg"},"사랑":{"voiceline":"지, 지휘관님, 이걸 받아주세요! 이건 그러니까, 지휘관님의 운을 좋게 해 주는 부적이에요! ……'연애성사'가 무슨 의미냐구요…? 지휘관님, 짖궃어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 다치지 않았죠? 다행이다… 기도가, 통했네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/home.ogg"},"hp 경고":{"voiceline":"신이시여, 하루츠키, 어, 어떻게 해야……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 어, 어서 오세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/login.ogg"},"실패":{"voiceline":"신이시여, 모, 모두를 도와주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/lose.ogg"},"우편":{"voiceline":"지휘관님, 펴, 편지에요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/mail.ogg"},"임무":{"voiceline":"지, 지휘관님… 그… 아직 임무가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/mission.ogg"},"임무완료":{"voiceline":"지휘관님, '보너스', 받았어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/mission_complete.ogg"},"서약":{"voiceline":"신이시여, 감사합니다! 신님 덕분에 지휘관님과 만나서, 하루츠키, 정말 행복해요! ……지휘관님, 그… 모자란 몸입니다만, 아무쪼록 잘 부탁드립니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/propose.ogg"},"스킬":{"voiceline":"신이시여, 모두를 지켜주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/skill.ogg"},"터치1":{"voiceline":"지휘관님? 하루츠키가 만든 벚꽃떡 좀 드실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/touch.ogg"},"터치2":{"voiceline":"지, 지휘관님! 부탁이에요! 그만둬주세요! 우으……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/touch2.ogg"},"입수시":{"voiceline":"여기가 신님께서 말씀하신…… 아, 네! 하루츠키라고 합니다! 자, 잘 부탁드립니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/unlock.ogg"},"강화성공":{"voiceline":"이, 이걸로 강해질 수 있을까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/upgrade.ogg"},"vote":null,"승리":{"voiceline":"분명 신의 가호가 있었던 거네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301570/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0},{"클뜯 id":301571,"클뜯 함순이 id":30157,"함순이 이름":"하루츠키","한글 함순이 + 스킨 이름":"아름다운 영춘의 춤","영문 함순이 + 스킨 이름":"A Dance for the Coming Spring","스킨 타입":"New Year Kimono","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301571/painting.png","확대 일러":"https://raw.githubusercontent.com/