[{"클뜯 id":301260,"클뜯 함순이 id":30126,"함순이 이름":"유구레","한글 함순이 + 스킨 이름":"유구레","영문 함순이 + 스킨 이름":"Yuugure","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301260/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301260/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301260/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301260/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301260/shipyard.png","설명":"하츠하루급 구축함 6번함·유구레","자기소개":{"voiceline":"아리아케급 구축함 2번함, 유구레라고 합니다. 종종 언니와 함께 하츠하루급으로 착각하시는 일도 있지만, 그건 오해에요. 아리아케 언니와는 함께 태평양에서 다양한 전투에 참가하여 5항전과 4항전의 호위를 하였습니다. 그리고, 아카시 씨에게도 신세를 진 적도 있습니다. 이번엔 아리아케 언니 곁에서 쭉 함께하고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/profile.ogg"},"메인1":{"voiceline":"차를 우려내면 임무가 빨리 끝난다고 들었습니다만… 에? 술이라고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/main1.ogg"},"메인2":{"voiceline":"희망이 아무리 작다해도, 포기하지 않으면 언젠가 꼭 이뤄질 거에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/main2.ogg"},"메인3":{"voiceline":"히요 씨도 와 계신가요? 언니는 눈이 그렇게 좋은 편이 아니라… 사실 조금 걱정이에요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/main3.ogg"},"전투개시":{"voiceline":"작전대로, 각자 위치로 가주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/battle.ogg"},"상세확인":{"voiceline":"저기… 어떻게 하면 아리아케 언니를 다시 만날 수 있을까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/detail.ogg"},"드랍 설명":{"voiceline":"하츠하루급 구축함 6번함·유구레","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었습니다. 지휘관님, 한 번 건조를 해보시는 건 어떠세요? 혹시 어쩌면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/expedition.ogg"},"실망":{"voiceline":"지휘관님, 내일 예정의 확인 말입니다만, 될 수 있으면 한 번에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/feeling1.ogg"},"낯섦":{"voiceline":"하츠하루 언니는 상냥하고, 절 친동생처럼 대해줬습니다… 하지만 전, 역시…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/feeling2.ogg"},"호감":{"voiceline":"앗, 지휘관님! 연기… 말인가요? 잘 모르겠습니다만 저, 크레페를 만들고 있었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/feeling3.ogg"},"기쁨":{"voiceline":"아앗! …저기, 지휘관님? 엣? 일부러 눈을 피한 건 아닙니다만… 죄송해요, 잠시 멍하니 있었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/feeling4.ogg"},"사랑":{"voiceline":"기분 좋은 바람에 감싸주는 툇마루, 그리고 풍경 소리… 아리아케 언니와 함께했던 그 여름이 생각나네요…… 지금 제 곁에 있는 건, 지휘관님이지만요","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"…음, 왜 그러시죠? 아리아케 언니 말인가요? …앗, 죄송해요, 방금 언니의 꿈을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 수고하셨어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/login.ogg"},"실패":{"voiceline":"으으…… 아카시 언니에게 또 폐를 끼쳐버리네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/lose.ogg"},"우편":{"voiceline":"지휘관님, 과자와 새로 온 우편을 가져왔습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/mail.ogg"},"임무":{"voiceline":"임무를 마치기 전에, 한잔하시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/mission.ogg"},"임무완료":{"voiceline":"임무 보수의 확인도, 임무를 완료할 때처럼 빨리하는 게 좋다고 생각해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/mission_complete.ogg"},"서약":{"voiceline":"아리아케 언니가 여기 올 때까지, 지휘관님께 의지해도… 될까요? 네… 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/propose.ogg"},"스킬":{"voiceline":"언니와 다시 만나기 위해…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/skill.ogg"},"터치1":{"voiceline":"후우……하아……네, 듣고 있다고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/touch.ogg"},"터치2":{"voiceline":"지휘관님, 뭐 하시는 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/touch2.ogg"},"입수시":{"voiceline":"아리아케급 구축함 유구레라고 합니다. 잘 부탁드립니다, 지휘관님… 하츠하루급, 말입니까? 저는 아리아케급입니다! 이것 만큼은 양보할 수 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/unlock.ogg"},"강화성공":{"voiceline":"제가 좀 더 빨랐다면, 히에이 언니는…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/upgrade.ogg"},"vote":null,"승리":{"voiceline":"…이기셨나요? 아리아케 언니가 봤으면 좋았을텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301260/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_status":0},{"클뜯 id":301261,"클뜯 함순이 id":30126,"함순이 이름":"유구레","한글 함순이 + 스킨 이름":"견습은 메이드 씨!","영문 함순이 + 스킨 이름":"Maid-In-Training!","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301261/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.co