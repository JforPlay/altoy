urLane/main/audio/voiceline/301261/login.ogg"},"실패":null,"우편":{"voiceline":"제 사진을 찍어 아리아케 언니에게 보낸다고, 마야 씨가 사진을 찍어줬어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301261/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"후우……자료 정리, 완료했습니다… 다음에 할 일은……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301261/touch.ogg"},"터치2":{"voiceline":"……지휘관님도 이런 거 하지 말아주세욧!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301261/touch2.ogg"},"입수시":{"voiceline":"\"메이드 유구레, 이 몸, 지휘관과 아리아케 언니에게 바치겠습니다!\" …꺄악?! 스, 스커트가아~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301261/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":" \"스, 승리와 영광을 주, 주인님께~!\" ……우으… 역시 저, 이런 대사는 좀……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301261/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70063,"상점 카테고리 id":17,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"IJN","레어도":"R","ex_chat_status":0},{"클뜯 id":301262,"클뜯 함순이 id":30126,"함순이 이름":"유구레","한글 함순이 + 스킨 이름":"해질 무렵에 피는 봄꽃","영문 함순이 + 스킨 이름":"Twilight Blossom","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301262/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301262/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/