[{"클뜯 id":9707020,"클뜯 함순이 id":970702,"함순이 이름":"아크 로열·META","한글 함순이 + 스킨 이름":"아크 로열·META","영문 함순이 + 스킨 이름":"Ark Royal META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707020/shipyard.png","설명":"항공모함 아크 로열, 각하의 휘하에 합류한다. 각하가 큰 뜻을 품은 사람이라면, 난 전력으로 각하를 위해 싸울 것이다!","자기소개":{"voiceline":"각하와 나는 전사다. 어려움에 처할수록, 우리의 신분과 뒤에 있는 지켜야할 사람들을 잊어선 안돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/profile.ogg"},"메인1":{"voiceline":"동료를 지키는 것은 불변의 진리지. 그 대상이 구축함 동생들이라면 더욱 그렇고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/main1.ogg"},"메인2":{"voiceline":"내가 제일 잘하는 건 초원거리 사격이야. 물론, 근접 전투도 뒤쳐지진 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/main2.ogg"},"메인3":{"voiceline":"새로운 전술을 연구 중인가? 나도 뭔가 도와줘야 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/main3.ogg"},"전투개시":{"voiceline":"적에게 자비를 베풀 필요는 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/battle.ogg"},"상세확인":{"voiceline":"평화, 그 어떤 대가를 치르더라도 수호할 가치가 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/detail.ogg"},"드랍 설명":{"voiceline":"아크 로열호 항공모함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"위험을 무릅쓰고 물자를 가져온 동료들을 홀대하면 안 돼... 얼른 맞이해 주러 가자, 지휘관 각하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/expedition.ogg"},"실망":{"voiceline":"아직 충고가 먹힌다면, 돌아가길 바랄게. 각하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/feeling1.ogg"},"낯섦":{"voiceline":"호위 필요한 구축함 동생들 있어? 다른 임무도 괜찮아, 언제든 출격 가능해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/feeling2.ogg"},"호감":{"voiceline":"함선은 방향을 잃어버리면 결국 바다에서 침몰할 수 있어, 사람도 똑같아. 지휘관 각하, 마음 속에 정확하고 굳건한 나아갈 방향이 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/feeling3.ogg"},"기쁨":{"voiceline":"음, 각하의 태도와 업무 방식은 확실히 칭찬할 만해. 각하가 전방에서 이끈다면, 이 함대는 분명 더 머나먼 곳까지 나아갈 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/feeling4.ogg"},"사랑":{"voiceline":"안심해, 각하. 함대를 이끌어가는 방향이 어딜 향하던지, 난 각하를 위해 호위할 테니까. 앞에 거대한 파도가 있던, 빙산이 있던, 내가 전부 산산조각 내줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"내 상태는 걱정 마, 아크 로열은 언제나 각하의 지시를 기다리고 있으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/home.ogg"},"hp 경고":{"voiceline":"모든 걸 파괴하도록... 가만두지 않겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/hp_warning.ogg"},"로그인":{"voiceline":"에너지 넘치는 모습, 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/login.ogg"},"실패":{"voiceline":"이런 퇴로가 매번 전투마다 있을 수 있는 건 아냐...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/lose.ogg"},"우편":{"voiceline":"새로운 우편? 어서 봐봐. 최신 정보를 놓쳐선 안되지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/mail.ogg"},"임무":{"voiceline":"임무 완성은 각하의 중요한 소임 중 하나. 잊어선 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/mission.ogg"},"임무완료":{"voiceline":"임무 완료했구나, 잘했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/mission_complete.ogg"},"서약":{"voiceline":"이걸 나한테 준다고? 좋아, 알았어! 오늘부터, 각하와 함께 하겠어. 우리의 항로가 어디로 향할지 엄청 기대되는걸, 하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/propose.ogg"},"스킬":{"voiceline":"도망칠 수 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/skill.ogg"},"터치1":{"voiceline":"눈빛에 확신이 부족해! ...하하, 이제 좀 낫네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/touch.ogg"},"터치2":{"voiceline":"이 장갑이 별로 화려하지 않다는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/touch2.ogg"},"입수시":{"voiceline":"항공모함 아크 로열, 각하의 휘하에 합류한다. 각하가 큰 뜻을 품은 사람이라면, 난 전력으로 각하를 위해 싸울 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/unlock.ogg"},"강화성공":{"voiceline":"보호해야 할 것을 위하여 더욱더 강해져야만 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아무리 멀리 도망쳐도 내게서 벗어날 순 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['USS'] : 걱정마, 내가 보호해 줄테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/couple_encourage1.ogg"},{"voiceline":"['글로리어스'] : 함께 로열의 영광을 지키자—!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707020/couple_encourage2.ogg"},{"v