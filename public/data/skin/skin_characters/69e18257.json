[{"클뜯 id":403160,"클뜯 함순이 id":40316,"함순이 이름":"꼬마 에기르","한글 함순이 + 스킨 이름":"꼬마 에기르","영문 함순이 + 스킨 이름":"Little Ägir","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403160/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403160/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403160/shipyard.png","설명":"대형 중순양함 - 에기르","자기소개":{"voiceline":"옥좌에서 내려다보이는 영역은 전부 내 거야! 물론 지휘관도 내 거지! 얌전히 무릎 꿇고 복종해! 아하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/profile.ogg"},"메인1":{"voiceline":"이 주스, 엄청 달콤하네… 어른들이 마시는 것보다 훨~씬 맛있지? 후훗, 분명 그럴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/main1.ogg"},"메인2":{"voiceline":"지휘관, 잠깐 산책……이 아니라 영지 시찰에 동행하도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/main2.ogg"},"메인3":{"voiceline":"지휘관, 과자 공물이 아직 부족해. 뭐? 많이 먹으면 충치 생긴다고? 괘, 괜찮아!난 충치 같은 거 안 무서워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/main3.ogg"},"전투개시":{"voiceline":"심연의 나라를 지키기 위해, 출발!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/battle.ogg"},"상세확인":{"voiceline":"지휘관~ 내 왕국 어때? 아직 영토는 조금밖에 없지만, 지휘관이 도와주면 위대한 업적을 이뤄낼 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/detail.ogg"},"드랍 설명":{"voiceline":"대형 중순양함 - 에기르","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어? 재미있는 장난감도 가지고 왔으려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/expedition.ogg"},"실망":{"voiceline":"흥! 주스 한 잔도 같이 안 마셔주고, 정말 나쁜 지휘관이네. 장난감 감옥에 가둬서 반성하게 해줄 테다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/feeling1.ogg"},"낯섦":{"voiceline":"그렇게 나한테 인정받고 싶은 거야? 그럼 먼저 맛있는 간식이나 재미있는 장난감부터 바쳐봐~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/feeling2.ogg"},"호감":{"voiceline":"지휘관, 숨바꼭질하자! 이건 널 위해 준비한 특별한 시련이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/feeling3.ogg"},"기쁨":{"voiceline":"흑…… 지휘관, 어디 간 거야? 이 왕국에는 네가 없으면 안 된단 말이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 나 결정했어! 앞으로 쭉 놀아…… 아니, 하인으로서 날 영원히 섬기도록 해! 알겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/feeling5.ogg"},"터치3":{"voiceline":"흥… 겨우 이 정도에 심연의 신이 굴복할리가…… 으음…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/headtouch.ogg"},"모항귀환":{"voiceline":"후후후… 돌아왔군. 심연의 신께 바칠 공물은 잘 준비했겠지? …그거 말이야! 지금 손에 들고 있는 주스!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/home.ogg"},"hp 경고":{"voiceline":"이 정도쯤은 아무것도 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관이다! 내 장난감 왕국……이 아니라, 심연의 나라를 구경하러 올래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/login.ogg"},"실패":{"voiceline":"적이 너무 약아서 그래…! 저, 절대 내 다리가 짧아서 못 따라간 건…… 절대 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/lose.ogg"},"우편":{"voiceline":"에? 새 우편? 그럼, 지휘관이 읽어 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/mail.ogg"},"임무":{"voiceline":"지휘관, 아직 안 끝낸 일 있잖아? 게으름 피우는 건 용서 못 해! 빨리 끝내고 나랑 놀아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/mission.ogg"},"임무완료":{"voiceline":"역시 내가 선택한 지휘관다워. 빨리 보상 챙겨. 축하의 주스도 따르고 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/mission_complete.ogg"},"서약":{"voiceline":"오늘은 특별한 날이래! 나 결정했어! 이제는 하인뿐만 아니라 내 수호 기사도 맡아줘야 해! 주인인 나를 지키는 건 물론…… 계속 같이…… 놀아줘야 해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/propose.ogg"},"스킬":{"voiceline":"심연의 신의 힘을 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/skill.ogg"},"터치1":{"voiceline":"응? 심연의 주인에게 바칠 공물이라도 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/touch.ogg"},"터치2":{"voiceline":"으앗! 가, 감히 이런 무례한 짓을! 이 보검으로 벌을 내려주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/touch2.ogg"},"입수시":{"voiceline":"후훗~ 심연의 신의 위대함을 보여주마! ……어? 갑자기 왜 그렇게 웃는 거야?! 이, 이 녀석! 날 어린애 취급하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/unlock.ogg"},"강화성공":{"voiceline":"또 강해졌어! 자, 주스로 건배! ……쿨럭쿨럭! 너무 빨리 마셔서 사레 들렸어…… 쿨럭……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"으하핫! 이제 알겠지? 이게 바로 심연의 신의 실력이라고! ……응? 지휘관, 왜 웃는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"여긴 내 장난감 성……아니, 심연의 왕국 궁전이야! 하지만 지금은 네 집…그러니까, 기사의 주둔지이기도 해! ……웃지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"있지, 나 지휘관이랑 같이 놀…… 아니, 심연의 왕국을 다스리는 게 제일 좋아! …아, 아무튼 내가 무슨 말 하려는 건지는 잘 알지?! 이제 돌봐주는 것도, 지켜주는 것도 익숙해졌으니까…… 계속 내 곁에 있어줘야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"이러는 건…… 아무한테도 말하면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어서 와! 이번 주스는 어때? …음흠! 그냥 같이 마시고 싶었을 뿐이야! 같이… 편안하게 있고 싶어서 그런 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"아, 내 기사가 왔네. 같이 놀…… 아니, 왕국을 시찰하지 않을래? 왕좌에 같이 앉아도 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"너의 역할은 이런 걸 하는 게 아니라, 나를 지키는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/touch_ex.ogg"},"터치2_ex":{"voiceline":"가, 간지럽다니까~! 너무 무례하잖아! 벌을 내려주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"……왕좌 크기를 더 키울까 봐. 지휘관이랑 같이 앉을 공간도 필요하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/main5_ex.ogg"},"메인6_ex":{"voiceline":"어휴… 내가 지휘관을 특별 대우한다고 해도, 날 애 취급하는 건 용서 못 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"역시 지휘관이랑 노는 게 제일 재밌어…… 앗!? 드, 들은 건 아니겠지!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403160/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":1}]