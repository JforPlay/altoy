[{"클뜯 id":301110,"클뜯 함순이 id":30111,"함순이 이름":"이카즈치","한글 함순이 + 스킨 이름":"이카즈치","영문 함순이 + 스킨 이름":"Ikazuchi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301110/shipyard.png","설명":"특Ⅲ형 구축함 3번함·이카즈치","자기소개":{"voiceline":"아카츠키형 구축함의 이카즈치야. 이래 봬도 사쿠라 엠파이어의 함대원들 사이에서도 대선배라구. 그 야마토조차 나를… 음, 뭐라 불렀더라? 뭐 어쨌든 이런 느낌! 앞으로도 이카즈치의 활약을 기대해줘! 그리고 이「좋아요」버튼도 팍팍 눌러보라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/profile.ogg"},"메인1":{"voiceline":"시마카제처럼 빠르다고? 시마카제는 이카즈치랑 이나즈마 보다 빠르단 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/main1.ogg"},"메인2":{"voiceline":"그렇구나! 이나즈마가 그 대전의 '퍼스트 어택' 을 받은 거구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/main2.ogg"},"메인3":{"voiceline":"그렇구나! 이카즈치도 조선소에 계속 있으면 '불사조' 가 되는 거네! 응응…… '피닉스 썬더'…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/main3.ogg"},"전투개시":{"voiceline":"그렇구나! 일단은 좌측 상단의 '자율전투' 버튼을 누르면 된다는 거네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/battle.ogg"},"상세확인":{"voiceline":"이 이카즈치님에게 열심히 절하면, 웬만한 소원은 다 이뤄져! ……효과 없다고? 그건……아직 충분히 빌지 않아서야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/detail.ogg"},"드랍 설명":{"voiceline":"특Ⅲ형 구축함 3번함·이카즈치","voicelink":null},"의뢰 완료":{"voiceline":"완료한 의뢰를 가만히 놔두면, '이자' 같은 게 붙지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/expedition.ogg"},"실망":{"voiceline":"그렇구나! 이대로 바다에 떠내려가면 집에 돌아갈 수 있단 거네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 모르는 게 있으면 이카즈치에게 물어봐. 누가 뭐래도 이 이카즈치가 쓴 연료는 지휘관이 먹은 밥보다 훨씬 많으니까 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/feeling2.ogg"},"호감":{"voiceline":"내일은 이카즈치의 생일이야. '선물' 은 준비해뒀어? 응? 그런 거 들은 적 없다고? 그럼…… 저쪽의 펜던트 보이지! 저걸 사서 맘에 드는 애한테 주면 분명 기뻐할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/feeling3.ogg"},"기쁨":{"voiceline":"지휘관! 이카즈치, 뭔가 엄청난 돈벌이를 찾아냈어! 그러니까 이거, '자금 1만을 밑천 삼아 다단계 영업으로 두 명을 끌어들이면, 매달 30%씩 벌 수 있다' 나 뭐라나……  '다단계' 라는 건 대체 뭘까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/feeling4.ogg"},"사랑":{"voiceline":"그렇구나! 지금 두근두근 거리는 건 '사랑' 이라는 거네! 응, 알고 있다고. 이건……! 어, 어라? 머리가 조금 어질어질…… 왠지 세상이 빙빙 도는 거 같은… 이것도 '사랑' 이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"이럴 때일수록 '미주가효' ! 지친 마음에 상을 줘야겠지! 어라? 어디서 갖고 왔냐고? 숙사에 잔뜩 있잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"그렇구나! 이게 '로그인' 이지? 인간의 말은 심오하네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/login.ogg"},"실패":{"voiceline":"그렇구나…! 이럴 때야말로 '대리 플레이' 를 맡길 때네! '대리'! 기왕 이렇게 된 거 이카즈치에게 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/lose.ogg"},"우편":{"voiceline":"그렇구나! 이거…… 그거구나! 갖고 있으면 '놀이공원' 에 들어갈 수 있다는 그거지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/mail.ogg"},"임무":{"voiceline":"임무를 완료하지 않았어? ……일이 끝나지 않은 것만큼 큰일인 걸까","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/mission.ogg"},"임무완료":{"voiceline":"뭐야! '비서함' 인데 지휘관 대신 자원을 받을 수 없다니! 윗사람들은 대체 무슨 생각을 하고 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/mission_complete.ogg"},"서약":{"voiceline":"여기에 이름을 쓴다는 거네… 저기, 잘 모르겠는데… 이나즈마, 이건 뭐야? \"사인하면, 지휘관은 앞으로 쭉 이카즈치의 것이 된다\" 고? 응, 알았어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/propose.ogg"},"스킬":{"voiceline":"과연! 이게 자매의 힘이란 거네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/skill.ogg"},"터치1":{"voiceline":"그렇구나! 이게 평소의 '인사' 란 거지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/touch.ogg"},"터치2":{"voiceline":"에,. 그러니까…… 그건가? 지휘관이 한 행동의 의미, 이카즈치는 저, 전부 아니까! 그, 그런 거구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/touch2.ogg"},"입수시":{"voiceline":"나는 이카즈치. 아주 살짝 '분위기 파악을 못' 할지도 몰라. ……지휘관은 아마 앞으로 두 번째 이상의 나와도 만나려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/unlock.ogg"},"강화성공":{"voiceline":"「코멘트 수」라던지,「좋아요!」라던지,「갖고 싶어!」같은 걸 강화하고 싶어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"그렇구나! 이게 바로 이카즈치 님의 '신분에 걸맞는' 다는 거지! 가만, 그게 아니라 '가기이방' 인가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['이나즈마'] : 제6 구축대… 발진!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301110/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex