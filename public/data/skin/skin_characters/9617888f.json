[{"클뜯 id":301150,"클뜯 함순이 id":30115,"함순이 이름":"시구레","한글 함순이 + 스킨 이름":"시구레","영문 함순이 + 스킨 이름":"Shigure","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301150/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301150/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301150/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301150/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301150/shipyard.png","설명":"시라츠유급 구축함 2번함·시구레","자기소개":{"voiceline":"시라츠유형 구축함 2번함, 시구레라고 해. 처음엔 제1함대에 소속돼서, 뭐 열심히 했어. 그 후 제2함대에 된 다음 운명의 레이테만 해전에 참여했어… 혼자가 됐지만 그 전투에서 동료들의 용감한 모습은 잊을 수 없어… 야마시로 언니… 후소 언니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/profile.ogg"},"메인1":{"voiceline":"평화롭네…… 운을 시험하는 게임이라도 안 할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/main1.ogg"},"메인2":{"voiceline":"윗분들한테 엄청 귀여움받고 있어. 자, 빨리 꼬리 흔들며 애교떨어봐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/main2.ogg"},"메인3":{"voiceline":"기운 없네. 어뢰라도 한 발 먹어보는 게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/main3.ogg"},"전투개시":{"voiceline":"그쪽 바보들에게 병문안이나 가라~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/battle.ogg"},"상세확인":{"voiceline":"지휘관 이 바보! 이 이상 보면 깨물 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/detail.ogg"},"드랍 설명":{"voiceline":"시라츠유급 구축함 2번함·시구레","voicelink":null},"의뢰 완료":{"voiceline":"응? 벌써 시간이. 흐흥, 내가 가지 않아도 이 시구레 님이 있는 함대라면 풍작은 보증한다고♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/expedition.ogg"},"실망":{"voiceline":"악운에 저주받아라, 바보!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/feeling1.ogg"},"낯섦":{"voiceline":"행운? 그렇게 간단히 될 수 있는 게 아니라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/feeling2.ogg"},"호감":{"voiceline":"행운은 말야, 모르는 사이에 얻게 되는 거라고? 예를 들면, 헤이! (점프) ……지휘관, 방금 걸로 팬티 무슨 색인지 봤을까~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/feeling3.ogg"},"기쁨":{"voiceline":"이 시구레 님이 장난쳐주는 것만으로도 행운이라고? 이 고집쟁이 씨♪ 뭐, 그런 점이 좋은 거지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/feeling4.ogg"},"사랑":{"voiceline":"흐흥, 지휘관 이 멍청이는 시구레 님한테 마음껏 의지해도 된다구. 뭐~든지 해줄게. 그러니까 시구레 님을 이대로 좋아하라구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"흥흥흐─응~ 누가 돌아왔는지 맞춰보라구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/home.ogg"},"hp 경고":{"voiceline":"질 것 같아? 그럴 수가~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/hp_warning.ogg"},"로그인":{"voiceline":"지휘관! 늦잖아! 빨리 준비해줘~ 기다렸으니까","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/login.ogg"},"실패":{"voiceline":"제…… 제법인데…… 기억해 두라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/lose.ogg"},"우편":{"voiceline":"편지 가져와 줬다고~ 어느 손에 들고 있는지 맞춰봐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/mail.ogg"},"임무":{"voiceline":"어? 일이야? 정말, 맨날 일만 하고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/mission.ogg"},"임무완료":{"voiceline":"쳇, 보너스가 없으면 아무도 이런 일 안 한다고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301150/mission_complete.ogg"},"서약":{"voiceline":"지