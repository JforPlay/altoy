[{"클뜯 id":10300030,"클뜯 함순이 id":1030003,"함순이 이름":"루루티에","한글 함순이 + 스킨 이름":"루루티에","영문 함순이 + 스킨 이름":"루루티에","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/JforPlay/data_for_toy/main/missingno//10300030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/JforPlay/data_for_toy/main/missingno//10300030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/JforPlay/data_for_toy/main/missingno//10300030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/JforPlay/data_for_toy/main/missingno//10300030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/JforPlay/data_for_toy/main/missingno//10300030/shipyard.png","설명":"처음 뵙겠습니다…… 루루티에라고 합니다. 사정이 있어 이렇게 신세를 지게 되었습니다. 부, 부족한 몸이지만…… 아무쪼록 잘 부탁드립니다.","자기소개":{"voiceline":"쿠쥬우리를 다스리는 낙토의 오젠의 막내 공주, 루루티에라고 합니다. 취미는 요리와 독서로…… 네? 어떤 책을 읽느냐고요? 그, 그건 그러니까……(머뭇머뭇)","voicelink":null},"메인1":{"voiceline":"이 세계는 저희 세계에 없는 것으로 가득합니다. 식재료나 요리 등 흥미가 끊길 일이 없네요. 나중에 식당에 가봐도 괜찮을까요?","voicelink":null},"메인2":{"voiceline":"만쥬라고 부르나요, 이 동글동글한 새는? 귀엽네요. 저도 코코포라고 하는 호로론 새를 기르고 있답니다.","voicelink":null},"메인3":{"voiceline":"한가하시면 잠깐 나갔다 와도 될까요? 음 그러니까, 이쪽 세계의 서점에 가보고 싶어서……","voicelink":null},"전투개시":{"voiceline":"저도…… 싸울 수 있어요!","voicelink":null},"상세확인":{"voiceline":"저기…… 제게 용건이 있으신가요?","voicelink":null},"드랍 설명":{"voiceline":"처음 뵙겠습니다…… 루루티에라고 합니다. 사정이 있어 이렇게 신세를 지게 되었습니다. 부, 부족한 몸이지만…… 아무쪼록 잘 부탁드립니다.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 담당하신 분들이 돌아오신 것 같네요. 마중 다녀오겠습니다.","voicelink":null},"실망":{"voiceline":"죄송합니다…… 저로서는 지휘관님의 기대에 부응하지 못하겠네요……","voicelink":null},"낯섦":{"voiceline":"아, 지휘관님. 딱 좋은 타이밍에 오셨네요…… 여기 식재료로 요리를 만들어 봤습니다. 괜찮으시다면 간을 봐주실 수 있으실까요?","voicelink":null},"호감":{"voiceline":"지휘관님은 그…… 동성인 친구분이 계신가요? 그분과는 친밀하신가요? 뜨거운 우정으로 이어져 있으신가요? 그렇다면 좀 더 자세한 이야기를……!","voicelink":null},"기쁨":{"voiceline":"여기에 있다 보면, 백루각에 있었던 시절이 떠오릅니다. 그 사람을 중심으로 모두가 있고…… 지휘관님이 이따금 그 사람과 겹쳐 보이는 것 같은 기분이 든답니다.","voicelink":null},"사랑":{"voiceline":"지휘관님은 강하신 분이네요. 많은 사람을 통솔하며 큰일을 이루고자 하고 있어요……저도 함께 따라가고 싶어요.","voicelink":null},"터치3":{"voiceline":"저기, 이런 접촉은 좀 더 어린아이에게 해줘야 하는 건 아닌가요……?","voicelink":null},"모항귀환":{"voiceline":"수고하셨습니다, 지휘관님. 식사 준비가 되어 있답니다.","voicelink":null},"hp 경고":{"voiceline":"아직, 할 수 있어…… 아직, 싸울 수 있습니다!","voicelink":null},"로그인":{"voiceline":"안녕하세요, 지휘관님. 업무 준비, 다 되어 있습니다.","voicelink":null},"실패":{"voiceline":"죄, 죄송합니다. 제가 발목을 붙잡는 바람에……","voicelink":null},"우편":{"voiceline":"우편이 도착했습니다. 가져다 드릴까요?","voicelink":null},"임무":{"voiceline":"오늘의 임무, 확인하시겠어요?","voicelink":null},"임무완료":{"voiceline":"임무를 완료하셨습니다. 수고하셨어요.","voicelink":null},"서약":{"voiceline":"이것을……저에게? 하지만…… 아니, 아무것도 아니에요. 이 세계에서 지휘관님을 모실 것을 맹세하겠습니다. 그러니, 이것은……그 증거이군요.","voicelink":null},"스킬":{"voiceline":"더는…… 도망가지 않겠어요!","voicelink":null},"터치1":{"voiceline":"지휘관님, 배가 고프신가요? 남은 식재료로 만든 것이라도 괜찮으시다면, 바로 준비해 드릴까요?","voicelink":null},"터치2":{"voiceline":"후에!? ……이, 이런 건…… 안된다고 생각해요! 제대로 부부의 연을 맺은 다음이 아니면……","voicelink":null},"입수시":{"voiceline":"처음 뵙겠습니다…… 루루티에라고 합니다. 사정이 있어 이렇게 신세를 지게 되었습니다. 부, 부족한 몸이지만…… 아무쪼록 잘 부탁드립니다.","voicelink":null},"강화성공":{"voiceline":"배려, 감사드립니다.","voicelink":null},"vote":null,"승리":{"voiceline":"제가 일등? 그럴리가…… 어떡하지 코코포, 일등이래!","voicelink":null},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"UM (utawarerumono)","레어도":"SSR","ex_chat_status":0},{"클뜯 id":10300031,"클뜯 함순이 id":1030003,"함순이 이름":"루루티에","한글 함순이 + 스킨 이름":"루루티에 (칭송받는 자)","영문 함순이 + 스킨 이름":"루루티에 (칭송받는 자)","스킨 타입":"Others","전체 일러":"https://raw.githubusercontent.com/JforPlay/data_for_toy/main/missingno//10300031/painting.png","확대 일러":null,"sd 일러":"https://raw.g