[{"클뜯 id":9600150,"클뜯 함순이 id":960015,"함순이 이름":"로열 제임스","한글 함순이 + 스킨 이름":"로열 제임스","영문 함순이 + 스킨 이름":"Royal James","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600150/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600150/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600150/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600150/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600150/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600150/shipyard.png","설명":"범선 - 로열 제임스","자기소개":{"voiceline":"로열 제임스예요! 즐거운 곳엔 늘 로열 제임스가 있죠! 재밌는 일이 생기면 제일 먼저 알려주셔야 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/profile.ogg"},"메인1":{"voiceline":"지휘관님, 해변에서 가리비랑 불가사리가 싸우고 있대요! 누가 더 강할까요…? 어서 보러 가… 아니, 숙소 화장실이 폭발했다고요?! 그것도 재밌겠다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/main1.ogg"},"메인2":{"voiceline":"지휘관님, 이 계획…… 후후후, 참신함이 좀 부족한데요? 저도 하나 생각해 볼까요? 눈에 확 띌 정도로 새로운 거로요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/main2.ogg"},"메인3":{"voiceline":"코로 라면을 먹으면 무슨 맛일까요…? 궁금하다…! 좋아, 바로 실천…! 츄릅. 맛은 그대로인 것 같은데…? 묘하네요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/main3.ogg"},"전투개시":{"voiceline":"오오! 속전속결이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/battle.ogg"},"상세확인":{"voiceline":"재밌는 곳을 찾았다고요?! 그럼 빨리 가요! 아… 출항 신청서를 내는 게 우선이라고요……? 언제부터 그런 귀찮은 게 생긴 거예요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 로열 제임스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 돌아왔어요! 다음에는 또 어떤 재미난 곳에 갈까요……? 몰래 따라가 봐요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/expedition.ogg"},"실망":{"voiceline":"하아…… 너무 재미없어서 전혀 의욕이 안 생기잖아요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/feeling1.ogg"},"낯섦":{"voiceline":"이 세상에서 가장 어려운 선택은 꼭 하고 싶은 일이 두 가지 생겼을 때……! 어떻게 하면 좋죠? 지휘관님, 도와주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/feeling2.ogg"},"호감":{"voiceline":"지휘관님도 들으셨어요? 누가 엄청나게 큰 문어를 낚았대요! 이~렇게 크대요! …어서 보러 가요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님은 늘 야근이시네요. 제대로 안 쉬면 같이 놀 여유도 사라지고 말아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/feeling4.ogg"},"사랑":{"voiceline":"아하하하… 제가 항상 사고를 치기는 하지만… 그래도 지휘관님이랑 같이 무언가 저지르면 너무 즐거워요! 네? 사고를 친 건 로열 제임스뿐…이라고요? 지휘관님도 같이 있었잖아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/feeling5.ogg"},"터치3":{"voiceline":"으음~ 머리를 쓰다듬는 게 그렇게 재밌으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 돌아오셨네요! 분명 엄청난 걸 많이 보고 오셨겠죠? 다음에… 아니, 지금 바로 안내해 주셨으면 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/home.ogg"},"hp 경고":{"voiceline":"읏… 아야… 점점 재밌어지네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/hp_warning.ogg"},"로그인":{"voiceline":"이런 시간에 오시다니, 알람 시계를 뱃속에 넣어두는 걸 깜빡하셨나 봐요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/login.ogg"},"실패":{"voiceline":"한 번만 더해요, 지휘관님! 한 번만 더! 지금 당장!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/lose.ogg"},"우편":{"voiceline":"새로운 우편이 도착했어요! 자, 어서 열어봐요! 보물 지도가 들어있을지도 모르잖아요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/mail.ogg"},"임무":{"voiceline":"지휘관님, 지금 당장 임무를 완료해야 하는 이유가 뭔지 아세요? 그건…… 재밌는 건 기다려주지 않으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었어요. 지루해…! 이런 건 이제 질렸어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/mission_complete.ogg"},"서약":{"voiceline":"따개비들이 싸우는 걸 보러 가려던 거 아니었나요? 서, 서약이라니…… 그런 갑작스러운 말에 네~라고 대답하는 건 바보뿐이라고요! 그렇다고 「네」라고 안 하겠다는 건 아니에요…… 지휘관님과 맺어질 수 있다면…… 바보가 되어도 괜찮아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/propose.ogg"},"스킬":{"voiceline":"재미없어! 혼내줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/skill.ogg"},"터치1":{"voiceline":"타코야키 한 방! 얍! …이, 이상하다고요? 그럼 한 방 더! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/touch.ogg"},"터치2":{"voiceline":"아! 그럴 줄 알았어! 지금 이상한 생각 하고 있었죠~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/touch2.ogg"},"입수시":{"voiceline":"자자, 이쪽이에요! 로열 제임스가 이 땅에 내려왔습니다♪ 설명은 나중에 하고, 지휘관님! 어서 출발해요! …어디로 가냐고요? 음… 아직 생각 못 했는데…… 아무튼 즐거운 곳이 좋겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/unlock.ogg"},"강화성공":{"voiceline":"강해지는 게… 이렇게 쉬운 거였나요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/upgrade.ogg"},"vote":null,"승리":{"voiceline":"여유롭게 승리! 축하 샴페인을 먼저 따버렸어요! 아직 남았으니까 같이 마셔요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"어디를 가든, 무슨 일이 있든, 제가 아무리 즐겁고 재밌는 일에 푹 빠져 있더라도… 절대 지휘관님을 혼자 두지 않을 거예요! 어떤 방법을 동원해서라도 꼭 함께 있어드릴게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"지휘관님, 더더더 해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님~! 기다리고 있었어요! 이번에야말로 「우와아아아~!」 하고 깜짝 놀라게 해줄 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관님, 혹시 지금 심심하신가요? 사실 저도 그래요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/touch_ex.ogg"},"터치2_ex":{"voiceline":"이런 재밌는 거, 예전부터 꼭 해보고 싶었어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['퀸 앤즈 리벤지', '어드벤처'] : 보물 찾으러 출발!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관님, 지난번에 드린 보물찾기 계획서는 어땠어요? 음, 좀 더 세부적인 조정이 필요하다고요? 그런 건 나중에 해요! 지금 바로 지휘관님이랑 출발하고 싶어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관님, 일은 잠깐 내려놓고 슈퍼에 가지 않을래요? 거기서 아름답게 빛나는 형광 대걸레를 봤거든요～ 지휘관님도 「화려한 미드나이트 반짝반짝 대청소」! 보고 싶죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"아, 지휘관님! 별을 보고 있었어요! 새로운 별을 찾으면, 저랑 지휘관님 이름을 붙일 수 있을 것 같아서요! 그러면 너무 좋겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600150/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"MOT","레어도":"SR","ex_chat_status":1},{"클뜯 id":9600151,"클뜯 함순이 id":960015,"함순이 이름":"로열 제임스","한글 함순이 + 스킨 이름":"금기의 츄잉 본","영문 함순이 + 스킨 이름":"The Forbidden Slurp","스킨 타입":"Rpg Adventure","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600151/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600151/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600151/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600151/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600151/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600151/shipyard.png","설명":"여긴… 어디죠? 너, 너무 추워… 어쩌면 좋지… 음… 거기 당신, 따뜻해 보이네요… 조금만 온기를… 나눠주실래요?","자기소개":null,"메인1":{"voiceline":"배럴 안은 온통 영양액이랍니다. 몸을 담그면 기분이 좋고, 마시면 배도 든든해지죠…… 탐험가님도 한번 해보실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/main1.ogg"},"메인2":{"voiceline":"촉수가 신경 쓰이세요? 이유는 모르겠지만, 제 명령을 잘 따라준답니다…… 도망치려고 하면 이 촉수로 꽁꽁 묶어버릴 거예요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/main2.ogg"},"메인3":{"voiceline":"계속 역할놀이만 하니까 좀 질리네요…… 다른 재밌는 거 해볼까요? 예를 들면~ 영양액으로 드리프트 수영 대결! …같은 건 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"저는 비밀 결사의 사악한 실험으로 태어난…… 금기의 존재? 음… 이해가 잘 안 가네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/detail.ogg"},"드랍 설명":{"voiceline":"여긴… 어디죠? 너, 너무 추워… 어쩌면 좋지… 음… 거기 당신, 따뜻해 보이네요… 조금만 온기를… 나눠주실래요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"눈을 뜨고 난 후부터 뭔가 빠져나간 느낌이에요…… 혹시… 마음? ……탐험가님, 당신의 마음을 제게 주세요. 그게 어렵다면, 대신 당신의 모든 걸 주셔도 괜찮아요～♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/feeling5.ogg"},"터치3":{"voiceline":"크르릉~! 더 재밌는 얘기 안 해주면, 이 금기의 존재가 당신을 먹어 버릴 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/headtouch.ogg"},"모항귀환":{"voiceline":"당신의 냄새, 기억했어요~ 질릴 때까지 절대 안 놔줄 거예요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"당신은 탐험가고, 비밀 결사에 의해 만들어진 금기의 존재를 조사하려고 이 지하실에 왔다고요…? 흠… 엄청 재밌겠다… 그럼 저는요? 저는 어떤 존재죠? …제가 그 금기의 존재라고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"조사를 도와달라고요? 금기의 존재가 사람을 어떻게 도와야 하죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/touch.ogg"},"터치2":{"voiceline":"이건…… 조금…… 기분이 좋을지도……? 저기, 한 번만 더 해주세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/touch2.ogg"},"입수시":{"voiceline":"여긴… 어디죠? 너, 너무 추워… 어쩌면 좋지… 음… 거기 당신, 따뜻해 보이네요… 조금만 온기를… 나눠주실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600151/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이세계 모험","상점 id":71229,"상점 카테고리 id":24,"스킨 태그":"배경","입수 영상":"O","재화":780,"기간":"한정 (2025/11/19)","진영":"MOT","레어도":"SR","ex_chat_status":0}]