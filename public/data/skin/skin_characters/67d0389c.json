[{"클뜯 id":304050,"클뜯 함순이 id":30405,"함순이 이름":"아마기","한글 함순이 + 스킨 이름":"아마기","영문 함순이 + 스킨 이름":"Amagi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304050/shipyard.png","설명":"아마기급 순양전함 1번함 - 아마기 ","자기소개":{"voiceline":"아마기급 순양전함의 기함, 아마기입니다. 원래는 아카기와 함께 항공모함으로 개조될 예정이었습니다만… 그때의 천재지변으로 쓰러지고 말았습니다. 콜록콜록… 네, 보시는 대로 그다지 건강한 체질은 아닙니다만, 아무쪼록 걱정 마시길…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/profile.ogg"},"메인1":{"voiceline":"앞길이 험난하다곤 합니다만, 그렇기에 도전할 가치가 있다고 생각합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/main1.ogg"},"메인2":{"voiceline":"지휘관님, 실패를 두려워할 필요는 없습니다. 이 아마기가 있는 한, 실패도 좌절도 다음 승리의 거름으로 만들어 드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/main2.ogg"},"메인3":{"voiceline":"아아, 아카기…… 이상하게 자라버렸네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/main3.ogg"},"전투개시":{"voiceline":"그럼, 계획대로 가겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/battle.ogg"},"상세확인":{"voiceline":"아무도 상처 입히고 싶지 않다는 건가요……? 지휘관님께서는 무리한 주문을 하시는군요… 후후, 방법은 찾아보겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/detail.ogg"},"드랍 설명":{"voiceline":"아마기급 순양전함 1번함 - 아마기","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰를 완료했습니다. 다음 출격의 인선에 관해 외람되오나 제안 드릴 사항이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/expedition.ogg"},"실망":{"voiceline":"훌륭한 상사는 좀처럼 찾기가 어렵군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/feeling1.ogg"},"낯섦":{"voiceline":"계책을 마련하기 위해선 정보가 필요한 법… \"고명한 지혜로 간자를 부리는 자, 삼군이 믿고 따를지니\", 라고 할 수 있겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/feeling2.ogg"},"호감":{"voiceline":"기책에 기대 이길 수 있다 해도, 정석으로 대적하지 못한다면 전장은 제압할 수 없으니… 콜록콜록, 지휘관님, 스스로의 힘을 기르는 것이야말로 가장 중요하답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/feeling3.ogg"},"기쁨":{"voiceline":"콜록콜록… 지휘관님은 이 아마기도 인정하게 만든 분이시니까, 좀 더 자신을 가지시는 편이 좋을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/feeling4.ogg"},"사랑":{"voiceline":"콜록콜록… 아마기를 걱정하신다면, 온 힘을 다해 앞으로 나아가 주세요… 지휘관님의 승리, 그리고 미소야말로 저에게는 특효약이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 제 작전이 도움되었는지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/home.ogg"},"hp 경고":{"voiceline":"계책을 바꿀 필요가 있군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 오늘의 작전 요강을 책상에 올려놓았습니다. 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/login.ogg"},"실패":{"voiceline":"계산이… 틀린 걸까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/lose.ogg"},"우편":{"voiceline":"지휘관님, 편지가 왔습니다. 새로운 정보인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/mail.ogg"},"임무":{"voiceline":"다음 임무는………","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/mission.ogg"},"임무완료":{"voiceline":"임무 보수… 가장 유용한 곳에 사용해야겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/mission_complete.ogg"},"서약":{"voiceline":"지휘관님… 이 아마기를 선택해주셨군요? 후후, 원래부터 지휘관님을 위해 몸바칠 각오였습니다만… 선택해주신 이상, 저 자신의 건강도 조금은 신경 쓰는 편이 좋겠군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/propose.ogg"},"스킬":{"voiceline":"후후후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/skill.ogg"},"터치1":{"voiceline":"후후후후…… 지휘관님, 지금 간식을 뭘로 할지 고찰하던 참이었습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/touch.ogg"},"터치2":{"voiceline":"음…지휘관님…지금은 다른 사항에 대해 고찰 중이었습니다만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/touch2.ogg"},"입수시":{"voiceline":"콜록콜록… 순양전함 아마기, 도착했습니다. 여기라면 저도 힘을 발휘할 수 있을 것 같네요… 지휘관님, 먼저 적에 대한 설명을 부탁드려도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/unlock.ogg"},"강화성공":{"voiceline":"몸 상태가 많이 좋아졌습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"자, 그럼… 이 승리를 어떻게 활용할지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님의 얼굴을 보니 병도 많이 누그러지는 것 같습니다…하, 후... 지휘관님을 위해서라도 아마기 힘껏 살아가야겠네요","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":{"voiceline":"지휘관님은...아직 승리 소식을 기다리고 계십니다...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/hp_warning_ex.ogg"},"로그인_ex":{"voiceline":"지휘관님, 오늘의 작전 계획입니다. 한 번 살펴보세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304050/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임