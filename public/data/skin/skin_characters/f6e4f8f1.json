:null,"모항귀환":{"voiceline":"피쉬앤칩스네유! 하지만 치어리더는 식이 조절을 해야한다고 하던디…… 조금 먹는 건 괜찮겠쥬? 그, 그럼 먹겠슈! 지휘관님, 고마워유!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201105/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지를 로열의 치어리더 팀장에 추천한게 후드 언니라고 하더만유. 언니의 기대에 부응하기 위해 힘낼 거여유! 하지만 치어리딩은 생각했던 것보다 어려워서… 어떻게 해도 힘든 것이…정말 잘 할 수 있겠쥬?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201105/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"아! …… 위, 위험했슈. 지휘관님이 잡아주지 않았다면 분명히 넘어져서 얼굴을 땅에 박았을 거유……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201105/touch.ogg"},"터치2":{"voiceline":"뭔가 몸이 이상한 것 같아유. 분명 지가 피곤해서 그런 거겠쥬…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201105/touch2.ogg"},"입수시":{"voiceline":"지, 지휘관? 그…… 지가 이번에 로열의 치어리더 팀장이 되어가 운동회 응원을 하려고 연습을 하는디… 너무 그렇게 보지 말어유… 부끄러우니까유… 으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201105/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"스포츠","상점 id":70339,"상점 카테고리 id":13,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"HMS","레어도":"N","ex_chat_status":0},{"클뜯 id":201109,"클뜯 함순이 id":20110,"함순이 이름":"시그넷","한글 함순이 + 스킨 이름":"시그넷·改","영문 함순이 + 스킨 이름":"Cygnet (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201109/painting.png","확대 일러":null,"sd 일러":"https://raw.githubuserconte