[{"클뜯 id":903020,"클뜯 함순이 id":90302,"함순이 이름":"알제리","한글 함순이 + 스킨 이름":"알제리","영문 함순이 + 스킨 이름":"Algérie","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903020/shipyard.png","설명":"비시아 성좌 알제리급 중순양함—알제리 ","자기소개":{"voiceline":"나는 아이리스 교국 소속 지중해 제일 순양함대의 기함이었다 비시아 성좌의 기사로 남게 되었지. 그 뒤의 일은 모두 역사에 남아있어. 조약의 가장 우수한 중순양함에게 있어서 확실히 재미있는 경험이었어. 지휘관도 그렇게 생각하겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/profile.ogg"},"메인1":{"voiceline":"공이 없다면 훈장도 없는 법. 이 힘이야 말로 내가 여전히 강하다는 것에 대한 증명이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/main1.ogg"},"메인2":{"voiceline":"지휘관, 와인 한잔 어때? 아, 그러니까 업무가 끝난 이후를 말하는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/main2.ogg"},"메인3":{"voiceline":"황금? 지휘관도 황금에 관심이 있구나. 그렇다면 아이리스 교국 시절부터 이야기를 해야겠지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/main3.ogg"},"전투개시":{"voiceline":"기대를 저버리지 않는 싸움이 되길… 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/battle.ogg"},"상세확인":{"voiceline":"지휘관, 역사와 진실 사이의 괴리를 알고 싶다면 직접 답을 찾아야하지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/detail.ogg"},"드랍 설명":{"voiceline":"비시아 성좌 알제리급 중순양함—알제리","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰조가 돌아왔어. 후후, 어디 보자. 중요한 물자는 누가 가지고 있을까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/expedition.ogg"},"실망":{"voiceline":"지휘관의 퇴역에 필요한 자료를 찾고 있는데 설마 벌써 준비한 건 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/feeling1.ogg"},"낯섦":{"voiceline":"나를 무서워하는 것 같네? 긴장하지 마. 우리는 친구잖아? 해치지 않을게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/feeling2.ogg"},"호감":{"voiceline":"지휘관, 와인 한잔 어때? 술은 잘 못하나? 괜찮아. 급하게 마시지 말고 천천히, 천천히 음미해봐—— 그 열정과 청량감의 하모니는… 성숙의 맛이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/feeling3.ogg"},"기쁨":{"voiceline":"사실 나도 작고 귀여운 것들을 좋아해. 액세서리라던가, 동그랗고 보드라운 고양이들…… 성숙한 어른이라도 귀여운 취미를 가질 수 있는 거야. 디저트 같은 개념이랄까—— 괜찮지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 내 버팀목이 되고 싶은 걸까? 후후, 지휘관이라면 믿고 기댈 수 있겠네. 그리고 내 모든 것을 다 줄 수도 있을 것 같아… 지휘관이 어떻게 할지 기대가 되는걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/feeling5.ogg"},"터치3":{"voiceline":"이건... 체온 재는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/headtouch.ogg"},"모항귀환":{"voiceline":"작전 수고했어, 지휘관. 방금 내린 커피 한 잔 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/home.ogg"},"hp 경고":{"voiceline":"……조약의 제한은 정말 귀찮네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 우리는 친구이니 조금 더 기다리게 해도 상관 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/login.ogg"},"실패":{"voiceline":"패배인가… 괜찮아, 의기소침해 하지 마. 충분히 준비한 이후에 다시 제대로 상대하도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/lose.ogg"},"우편":{"voiceline":"세상 만사가 모두 이 우편에 담겨있지. 편지를 읽다 보면 가슴이 뛰곤 해. 지휘관, 새로운 우편이 있다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무가 도착했어. 응? 많이 바쁘다면 기한 연장을 대신 신청해 둘게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/mission.ogg"},"임무완료":{"voiceline":"임무 완료인가? 지휘관, 수고했어. 보고서 정리는 나에게 맡기고 가서 쉬도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/mission_complete.ogg"},"서약":{"voiceline":"고마워. 처음부터 나의 힘, 나의 마음, 나의 모든 것은 모두 지휘관의 것이었어. 후후후, 오늘부터 천천히, 천천히 달콤한 생활을 즐겨보도록 하자—— 나의 파트너, 나의 사랑.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/propose.ogg"},"스킬":{"voiceline":"이제 와서 도망가려고 해도 늦었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/skill.ogg"},"터치1":{"voiceline":"게으름을 피우고 싶구나? 괜찮아. 다른 사람에게는 알리지 않을게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/touch.ogg"},"터치2":{"voiceline":"지휘관, 전장에서 끝없는 욕망은 올바른 선택이야. 하지만 여자에게는 그렇지 않다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/touch2.ogg"},"입수시":{"voiceline":"Bonjour, 만나게 되어 영광이다. 나는 비시아 성좌 소속, 중순양함 알제리. 오늘부터 너의 항구에 배속되었다. 지휘관, 상관없다면, 우리 친구할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/unlock.ogg"},"강화성공":{"voiceline":"조약의 속박을 단숨에 파괴하는 것도 나쁘지 않네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"일찌감치 판세를 알았더라면 이렇게 되지 않았겠지. 이게 무슨 고생이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"응...? 난 지금 다음번에 됭케르크랑 쇼핑할 가게를 보고 있었어. 물론, 너도 함께 가도 상관없어. 하하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"오늘 데이트는 뭐할거야? 엇, 어디 갈지 이미 결정한거