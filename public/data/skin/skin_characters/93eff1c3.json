[{"클뜯 id":202320,"클뜯 함순이 id":20232,"함순이 이름":"엔터프라이즈(경순)","한글 함순이 + 스킨 이름":"엔터프라이즈(경순)","영문 함순이 + 스킨 이름":"Enterprise","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202320/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202320/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202320/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202320/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202320/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202320/shipyard.png","설명":"에메랄드급 경순양함 - 엔터프라이즈","자기소개":{"voiceline":"로열 네이비 소속, 에메랄드급 경순양함 엔터프라이즈입니다. 그 대전에서는 지원, 호위, 운송 임무를 수행하며, 때때로 전투에 참여한 적이 있습니다. 비스케이 만 전투에서는…… 크흠, 아무것도 아닙니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/profile.ogg"},"메인1":{"voiceline":"참고로 현재 주인님의 업무 처리 상태를 보면 오늘 중으로 이 업무를 끝내기에는 무리가 있을 듯 합니다. 에메랄드는 별 도움이 안 되고, 메이드대의 다른 사람에게 도움을 청할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/main1.ogg"},"메인2":{"voiceline":"글래스고, 얼마 전 그 만화, 무척 재밌던데요? 그 뒷이야기는… 주인님?! 아, 아무것도 아닙니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/main2.ogg"},"메인3":{"voiceline":"청소라면 제게 맡겨주세요. 주인님의 집무를 방해하지 않고 해낼 자신이 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/main3.ogg"},"전투개시":{"voiceline":"동료 뒷바라지보다는 쉬워요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/battle.ogg"},"상세확인":{"voiceline":"대충 업무를 처리하는 건 주인님이건 메이드건 용납할 수 없는 일입니다. 정신 차리세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/detail.ogg"},"드랍 설명":{"voiceline":"에메랄드급 경순양함 - 엔터프라이즈","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었습니다. 주인님, 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/expedition.ogg"},"실망":{"voiceline":"당신이 제 주인님이기에 이렇게 모시고 있을 뿐입니다. 쓸데없는 생각은 하지 말아 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/feeling1.ogg"},"낯섦":{"voiceline":"필요한 것이 있으시면 언제든 제게 말씀해주세요. 청소 및 전투, 메이드 일상 업무에 작전 참모까지, 무엇이든 괜찮습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/feeling2.ogg"},"호감":{"voiceline":"관심이 가는 아이가 있다구요? 네, 그 아이의 정보를 알아볼 생각이라면 그 이름을 알려주시기 바랍니다. 사실 배려심이 결여된 행위이지만, 주인님의 명령이라면……. 알려줄 수 없으시다구요? 알겠습니다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/feeling3.ogg"},"기쁨":{"voiceline":"관심 있는 사람에게 고백하는 방법… 그, 그런 걸 물어보셔도 제 전문 분야가 아니라구요…. 제게 연애 이야기라니, 말할 상대를 착각하신 건 아닌가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/feeling4.ogg"},"사랑":{"voiceline":"이건 무슨 농담 같은 거죠? 그냥 저를 놀리시는 건가요? ……그, 그럴 리가…. 주인님께서 관심을 가지고 계셨던 아이가 사실 저였다니……. 믿을 수 없어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/feeling5.ogg"},"터치3":{"voiceline":"뭐, 뭐죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/headtouch.ogg"},"모항귀환":{"voiceline":"수고 많으셨습니다, 주인님. 전투 회고를 시행해주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/home.ogg"},"hp 경고":{"voiceline":"침착하게 대처하면 괜찮아요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/hp_warning.ogg"},"로그인":{"voiceline":"주인님께서 도착하셨군요. 자, 오늘 스케줄은 여기 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/login.ogg"},"실패":{"voiceline":"패배했습니다. ……주인님의 지휘 때문이 아니라, 제가 제대로 움직이지 못한 탓이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/lose.ogg"},"우편":{"voiceline":"우편입니다, 주인님. 지금 가지고 왔습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/mail.ogg"},"임무":{"voiceline":"임무입니다. 둘이서 하면 금방 끝날 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/mission.ogg"},"임무완료":{"voiceline":"제가 할 수 있는 건 여기까지. 보상 확인은 주인님께 부탁드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/mission_complete.ogg"},"서약":{"voiceline":"식장 상태도, 축복해주는 동료들 모습에도 전혀 흠잡을 데가 없어요……. 나, 정말 주인님과 서약을 맺고 있구나……. 흐흑, 정말 믿어지지 않아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/propose.ogg"},"스킬":{"voiceline":"깨끗하게 정리할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/skill.ogg"},"터치1":{"voiceline":"제 조언이 필요하신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/touch.ogg"},"터치2":{"voiceline":"……화낼 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/touch2.ogg"},"입수시":{"voiceline":"로열 메이드, 엔터프라이즈입니다. 오늘부터 이 모항에서 근무하게 되었습니다. 메이드대에서 담당하는 건 청소, 취미는 독서 및 각종 잡학, 이상입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/unlock.ogg"},"강화성공":{"voiceline":"저를 강하게 만들어주셔서 주인님께 늘 감사하고 있습니다. 이 은혜는 전투에서 갚도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/upgrade.ogg"},"vote":null,"승리":{"voiceline":"전투 승리. 그다지 감명 깊은 부분은 없었네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/win_mvp.ogg"},"전투개시_ex":{"voiceline":"주인님을 돌보는 것…과 마찬가지로 중요합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/battle_ex.ogg"},"상세확인_ex":{"voiceline":"너무 꼼꼼하다고 하셔도… 워, 원래 그런 성격이라 어쩔 수 없는 걸요. …만약 마음에 안 드시면, 다른 아이에게 부탁할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"관심 있는 상대에게 데이트 신청을 하는 방법…이라니, 그런 거 몰라요. 서약을 나눈 상대에게 다른 아이에게 데이트 신청 하는 법을 물어 보시다니……. 네? 가, 갑자기 \"그럼, 데이트 할까\"라니, 처음부터 그 관심 있는 상대가 저라고 말씀해주시면 좋잖아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"수고 많으셨습니다. 그… 전투 회고를 하기 전에 잠깐 쉬시는 건…? 자, 많이 지치셨을 것 같으니….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"주인님, 오늘은 무엇부터 착수하실 건가요? 사무 작업은 제게 맡기시고, 먼저 연습을 하는 것이 어떠신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"자, 잡담이라면 나중으로 미뤄 주세요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/touch_ex.ogg"},"터치2_ex":{"voiceline":"어차피 다른 아이에게도 하고 계시죠? 그럼, 저도…… 읏?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"전투에서 승리했습니다. 주인님, 늘 훌륭하게 전투를 이끌어 주셔서 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['글래스고'] :  뚝딱 해치워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"만화책이나 일반 서적 모두 가리지 않고 좋아합니다. 그러고 보니, 주인님도 좋아하는 책이 있으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/main5_ex.ogg"},"메인6_ex":{"voiceline":"청소 말씀이신가요? 알겠습니다. 지금 바로 해 드리겠습니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"역시 업무 처리가 훌륭하시네요. …셰필드도 그렇게 말했다구요? 그, 그렇군요…. 딱히 질투하는 건 전혀….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202320/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":1}]