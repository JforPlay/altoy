com/Fernando2603/AzurLane/main/audio/voiceline/399031/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"이 아이도 기다리기 힘든 모양이군. 지휘관, 시간이 아까우니 슬슬 출발하자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399031/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"후훗, 게임으로 이 키타카제에게 도전하려는 건가? 덤벼라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399031/touch.ogg"},"터치2":null,"입수시":{"voiceline":"키타카제, 준비 끝! 지휘관, 나와 함께 축제 행사장을 제패하지 않겠나? …그 전에 우선 자, 잠깐만 배를 채우고 떠나는 건 어떠한가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399031/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"여름 축제","상점 id":70219,"상점 카테고리 id":10,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2025/04/02)","진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":399033,"클뜯 함순이 id":39903,"함순이 이름":"키타카제","한글 함순이 + 스킨 이름":"비둘기와 요술의 밤","영문 함순이 + 스킨 이름":"Night of Doves and Magic","스킨 타입":"Rhythm & Steps","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399033/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399033/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399033/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399033/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399033/qicon.png","깔