[{"클뜯 id":399030,"클뜯 함순이 id":39903,"함순이 이름":"키타카제","한글 함순이 + 스킨 이름":"키타카제","영문 함순이 + 스킨 이름":"Kitakaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399030/shipyard.png","설명":"구축함 - 키타카제 ","자기소개":{"voiceline":"초 아키즈키급 1번함… 그게 바로 이 키타카제다. 그 대전에선 전장에서 활약하지 못했지만, 아직 늦지 않았다. 키타카제의 무장과 속력, 다시 한 번 보여주도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/profile.ogg"},"메인1":{"voiceline":"아키즈키급 아이들이 신세를 지고 있군. 이 키타카제, 모두의 기대에 부응하도록 훌륭히 지켜내마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/main1.ogg"},"메인2":{"voiceline":"직접 싸우는 것보다, 지휘를 보좌하는 쪽이 기분이 낫군. …지, 직접 싸우더라도 키타카제는 다른 아이들보다 뒤처지진 않을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/main2.ogg"},"메인3":{"voiceline":"진정한 힘은 자신의 용기에서 나오는 법. 키타카제의 힘, 얕보지 말아라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/main3.ogg"},"전투개시":{"voiceline":"적의 움직임, 간파했다! 모두, 키타카제를 따르라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/battle.ogg"},"상세확인":{"voiceline":"전투를 지휘하는 자라면 항상 칼을 지참해야 한다고 했다… 음, 이 아이는 무겁지 않다. 안심하도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/detail.ogg"},"드랍 설명":{"voiceline":"구축함 - 키타카제","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 아이들이 좋은 걸 잔뜩 가져온 모양이군. 지휘관, 검품하러 가도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/expedition.ogg"},"실망":{"voiceline":"자신의 재능을 계속 헛되이 버린다면, 지휘관도, 언젠가는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/feeling1.ogg"},"낯섦":{"voiceline":"읏, 이 아이가 신경 쓰인다고…? 음, 언젠가 이 키타카제가 직접 화려하게 휘둘러 보이도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/feeling2.ogg"},"호감":{"voiceline":"아키즈키급 아이들이 곧잘 막과자를 주곤 한다. 지, 지휘관에게도 조금은 나눠줘도…… 으음……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/feeling3.ogg"},"기쁨":{"voiceline":"어두운 건, 싫어…… 키, 키타카제는 지휘관을 천천히 따라가겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/feeling4.ogg"},"사랑":{"voiceline":"후아암…… 키타카제, 졸음을 못 버티겠어… 지휘관은 못본체하지 않을 터…… 음, 지휘관, 키타카제를 침대까지 옮겨주는군… 키타카제의 직감이 또 맞았군… 훗훗훗…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고했다. 남은 업무는 이 키타카제에게 맡겨다오. 기대한 대로, 깔끔하게 처리하도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/home.ogg"},"hp 경고":{"voiceline":"격류를 거스르는 것은 볼썽사나운 법… 하지만, 지금은 도리가 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 잘 돌아왔다. 키타카제는 지금 이 아이와 수련 중이다. 음, 장군답게 똑바로 서 있어야겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/login.ogg"},"실패":{"voiceline":"이럴수가… 어, 어디가 잘못된 거지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/lose.ogg"},"우편":{"voiceline":"우편을 확인하자. 키타카제, 좋은 일이 일어날 것 같은 예감…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/mail.ogg"},"임무":{"voiceline":"지휘관, 정신 차려라. 임무를 방치해둬선 안 되니 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/mission.ogg"},"임무완료":{"voiceline":"노력은 보답 받는 법…… 지휘관이 들인 수고에 대한 보상은 어디 도망가거나 하진 않을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/mission_complete.ogg"},"서약":{"voiceline":"지휘관의 곁에 있으면, 키타카제의 마음도 평온해진다… 그러니 키타카제, 지휘관의 곁에 계속 있고 싶어… 괜찮아? 괜찮다면 소, 손가락 걸래? 아키즈키급의 모두가 알려줬다. 지휘관 같은 멋진 사람이 약속을 어길 리 없다고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/propose.ogg"},"스킬":{"voiceline":"회심의 일격, 받아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/skill.ogg"},"터치1":{"voiceline":"작은 몸이라서 좋은 점도 있지. …후훙, 이 '피구'에서 키타카제를 맞출 수 있을 거란 생각은 접어두도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/touch.ogg"},"터치2":{"voiceline":"음, 지휘관을 멈춰야 할지 심히 고민 중이다만…… 무례한 짓은 아, 안되느니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/touch2.ogg"},"입수시":{"voiceline":"음, 준비는 완벽해…… 이 키타카제가 작전 지휘 보좌에 합류한 이상, 지휘관도 다리를 쭉 뻗고 잘 수 있을 거다. 후훙!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/unlock.ogg"},"강화성공":{"voiceline":"힘을 얻더라도, 머리는 맑게 해두는 편이 바람직하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"한 번의 승리 따위로 우쭐할 거 없지. 다음 싸움의 준비도 제대로 해두자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨