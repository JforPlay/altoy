[{"클뜯 id":305060,"클뜯 함순이 id":30506,"함순이 이름":"무츠","한글 함순이 + 스킨 이름":"무츠","영문 함순이 + 스킨 이름":"Mutsu","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305060/shipyard.png","설명":"나가토급 전함 2번함 - 무츠 ","자기소개":{"voiceline":"나는 나가토급 2번함의 무츠! 그 대전까지는 나가토 언니랑 빙글빙글 교대로 연합함대의 기함을 맡았어! 그 뒤에는 야마토 씨에게 맡겼지만! 바깥 세계는 역시 여러 가지 새로운 게 많네~ 3번 포탑? 응… 이번엔 괜찮겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/profile.ogg"},"메인1":{"voiceline":"지휘관, 여기는 왜 이렇게 되는 거야? 이렇게 하면 안 되는 거야? 왜?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/main1.ogg"},"메인2":{"voiceline":"지휘관, 바깥은 뭔가 재밌어 보여! 보러 가도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/main2.ogg"},"메인3":{"voiceline":"개미 씨들은 어디로 가는 걸까… 알고 싶어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/main3.ogg"},"전투개시":{"voiceline":"연합함대! 어… 출격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/battle.ogg"},"상세확인":{"voiceline":"지휘관, 3번 포탑의 검사, 도와줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/detail.ogg"},"드랍 설명":{"voiceline":"나가토급 전함 2번함 - 무츠","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 누군가가 항구에 돌아왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/expedition.ogg"},"실망":{"voiceline":"지휘관… 어째서야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/feeling1.ogg"},"낯섦":{"voiceline":"옛날에 나가토 언니랑 같이 하시라지마에 있을 때부터 자주 생각했는데… 하늘은 왜 파란 거야? 새는 왜 날 수 있어? 다들 왜 전쟁하는 거야? …신기한 일이 잔뜩…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/feeling2.ogg"},"호감":{"voiceline":"모르는 게 행복한 것도 있는 건 알지만… 그래도 알고 싶어! 게다가, 아는 편이 행복한 것도 좀 더 있잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 나하고 놀자! 어, 일이 있으면 나중에 다시 올게! 물어보고 싶은 게 잔뜩 있지만, 지휘관에게 알려주고 싶은 것도 잔뜩, 자~아안뜩 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/feeling4.ogg"},"사랑":{"voiceline":"지휘관에게 물어볼 건… 그러니까… 나 좋아? 내가 여러 가지 물어봐서 귀찮아? 그리고… 응! 함대의 모두와 지휘관이 정말 좋다고 말하고 싶어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 움직이지 마, 액막이를 해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/home.ogg"},"hp 경고":{"voiceline":"모두를 지키고 싶어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관! 저기, 없는 동안에 모르는 게 있었어! 왜……(무츠가 질문 폭격을 해왔다.)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/login.ogg"},"실패":{"voiceline":"지휘관, 3번 포탑이 조금……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/lose.ogg"},"우편":{"voiceline":"이게 '우편'이구나… 지휘관에게 '우편'을 쓸 테니까, '답장' 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/mail.ogg"},"임무":{"voiceline":"지휘관, 이 임무는 뭐 하는 거야? …이건?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/mission.ogg"},"임무완료":{"voiceline":"지휘관? 보너스는 포탑에 실어서 옮겼어! 아! 고양이 씨를 깨우지 말아줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/mission_complete.ogg"},"서약":{"voiceline":"이걸로 나하고 지휘관이 이어져 있는 거네? 대단해! 반지를 보면, 정말로 지휘관하고 같이 있는 느낌이야! 어째서?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/propose.ogg"},"스킬":{"voiceline":"고양이 씨, 꼭 붙잡고 있어~ 진심으로 갈게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/skill.ogg"},"터치1":{"voiceline":"아하하하~ 지휘관 간지러워~ 아하하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/touch.ogg"},"터치2":{"voiceline":"지휘관, 왜 만지는 거야? 무슨 일이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/touch2.ogg"},"입수시":{"voiceline":"안녕하세요. 나는 무츠! 나가토 언니의 동생! 저기, 당신은 지휘관? 왜? 지휘관은 어떻게 되는 거야? 지휘관은 굉장한 거야? 가르쳐 줘, 가르쳐 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/unlock.ogg"},"강화성공":{"voiceline":"노력할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관, 이거 봐, 이거 봐! 엄청 예쁜 물고기가 있었어! 무슨 물고기야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['나가토'] : 나가토 언니~ 같이 힘내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305060/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0},{"클뜯 id":3