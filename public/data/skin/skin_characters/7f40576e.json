[{"클뜯 id":10800020,"클뜯 함순이 id":1080002,"함순이 이름":"신죠 아카네","한글 함순이 + 스킨 이름":"신죠 아카네","영문 함순이 + 스킨 이름":"Akane Shinjo","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800020/shipyard.png","설명":"안녕, 나는 신죠 아카네야. 이 함장은 기계적인 느낌이 있어, 아주 멋지지. 좀 더 괴수스러웠다면 완벽했을텐데……","자기소개":{"voiceline":"신죠 아카네라고 해. 여기서는 전함이라고 그랬나? 직접 싸워본 적은 없어서 바로 당할지도 몰라……. 거짓말이지롱~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/profile.ogg"},"메인1":{"voiceline":"여기 있는 다른 애들 의장도 보고 있는데, 다 멋있네. 저걸 걸치고 어떤 식으로 싸우는 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/main1.ogg"},"메인2":{"voiceline":"여기 매점은 토마토 주스 종류가 엄청 다양해서 말이야. 결국엔 다 맛있어 보여서 몽땅 사버렸어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/main2.ogg"},"메인3":{"voiceline":"그나저나 이 의장, 옛날에 알던 누군가랑 좀 닮았어. 뭐? 어떤 사람이었냐고? 음…….사람은 아니었던 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/main3.ogg"},"전투개시":{"voiceline":"오늘은 어떤 적이 상대해줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/battle.ogg"},"상세확인":{"voiceline":"역시 말이야, 괴수란 건 참 좋단 말이지. 기술도 그렇고, 겉모습도……. 개성이 있달까. 있잖아, 지휘관도 괴수 같은 거 좋아해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/detail.ogg"},"드랍 설명":{"voiceline":"안녕, 나는 신죠 아카네야. 이 함장은 기계적인 느낌이 있어, 아주 멋지지. 좀 더 괴수스러웠다면 완벽했을텐데……","voicelink":null},"의뢰 완료":{"voiceline":"다들 돌아온 것 같네. 마중은 네게 부탁할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/expedition.ogg"},"실망":{"voiceline":"아하하, 너 진짜 어이없다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/feeling1.ogg"},"낯섦":{"voiceline":"꺅! (머리를 부딪힘) 죄송합니다……. 아, 지휘관이었네. 에이, 뭘 그렇게 고개를 숙여~ 그래도 이렇게 사과도 잘 하고, 착하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/feeling2.ogg"},"호감":{"voiceline":"앗, 지휘관이다. 매점에 가던 중이었는데, 너도 같이 갈래? 피규어를 만들 도구를 좀 사고 싶어서~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 무사는 굶어도 크게 웃는 법이라고 했었나? 그렇지만 점심은 제대로 챙겨먹지 않으면 안 된다구. 자, 같이 식당 가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/feeling4.ogg"},"사랑":{"voiceline":"요즘은 이 세상에 와서 다행이라는 생각을 해. 새로운 친구도 생겼고 말이야. 그 중에서도 지휘관은 특별……. 에헤헤, 거짓말이지롱~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/feeling5.ogg"},"터치3":{"voiceline":"응? 무슨 일이야? 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/headtouch.ogg"},"모항귀환":{"voiceline":"오, 돌아왔네. 수고한 지휘관에게 선물이라도 줄까? ……거짓말이지롱.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/home.ogg"},"hp 경고":{"voiceline":"아직 더 할 수 있거든?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/hp_warning.ogg"},"로그인":{"voiceline":"아, 드디어 왔네. 늦다구, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/login.ogg"},"실패":{"voiceline":"헉?! 뭐 이런 일이 다 있지?! 진짜 말도 안 돼…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/lose.ogg"},"우편":{"voiceline":"편지가 온 것 같네. 안 볼 거면, 내가 열어 본다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/mail.ogg"},"임무":{"voiceline":"아직도 일 안 끝낸 거야? 그럼 못 쓰지, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/mission.ogg"},"임무완료":{"voiceline":"수고했어. 역시 대단해, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/mission_complete.ogg"},"서약":{"voiceline":"너나 여기 있는 모든 사람이 바로 날 받아들여줘서, 모두를 믿고 의지할 수 있었어. 그 덕에 조금은 시야가 넓어진 것 같아. 고마워, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/propose.ogg"},"스킬":{"voiceline":"확실히 겨눠서…… 빵!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/skill.ogg"},"터치1":{"voiceline":"여기 매점에서는 책도 팔아? 잠깐만 들르지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/touch.ogg"},"터치2":{"voiceline":"정말, 그러면 못 써.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/touch2.ogg"},"입수시":{"voiceline":"안녕, 나는 신죠 아카네야. 이 함장은 기계적인 느낌이 있어, 아주 멋지지. 좀 더 괴수스러웠다면 완벽했을텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/unlock.ogg"},"강화성공":{"voiceline":"헤에~ 꽤 괜찮네. 지휘관, 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아하하, 이 정돈 당연하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/win_mvp.ogg"},"전투개시_ex":{"voiceline":"모두와 함께인 것도 좀 즐겁네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/battle_ex.ogg"},"상세확인_ex":{"voiceline":"봐봐! 이거, 새로 만든 피규어야! 이 근처 조형에 좀 정성을 들여봤는데, 지휘관은 어떤거 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관은 내게 소중한 사람이야……. 앗, 설마 지금 부끄러워하는 거야?","voicelink":"https://