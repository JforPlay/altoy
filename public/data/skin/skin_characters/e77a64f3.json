[{"클뜯 id":202160,"클뜯 함순이 id":20216,"함순이 이름":"피지","한글 함순이 + 스킨 이름":"피지","영문 함순이 + 스킨 이름":"Fiji","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202160/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202160/shipyard.png","설명":"피지급 경순양함 - 피지 (HMS Fiji)","자기소개":{"voiceline":"나는 피지, 일단은 네임쉽이야. 좋아하는 건……엣? 그런 건 됐다고? 전투 경력이라 해봐야 나 크레타 섬에서의 전투뿐이고, 심지어 그렇게 좋은 경력은 없는데……아하하, 뭐 별수 없지, 앞으로 잘하면 되잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/profile.ogg"},"메인1":{"voiceline":"자메이카? 아~ 그 아이 꽤 이상한 구석이 있지~ 뭐 즐거우니까 딱히 괜찮잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/main1.ogg"},"메인2":{"voiceline":"왜 그래? 졸린 표정을 하고…내 무릎베개로 잠깐 쪽잠이라도 자둘래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/main2.ogg"},"메인3":{"voiceline":"지휘관, 봐봐 이거! 이 헤어스타일 어때? 그리고 이 네일아트는?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/main3.ogg"},"전투개시":{"voiceline":"전투야! 다들 정신 똑바로 차려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/battle.ogg"},"상세확인":{"voiceline":"지휘관 왜 그래? 내가 그리워졌어? 후훗, 뭐 앉아봐~ 차 가져올게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/detail.ogg"},"드랍 설명":{"voiceline":"피지급 경순양함 - 피지 (HMS Fiji)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰에 나간 애들이 돌아왔어. 마중 나가는 거 잊지 마! 안 나가면 다들 상처받을 거라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/expedition.ogg"},"실망":{"voiceline":"지휘관, 무슨 일이야? 나, 꽤 바쁜데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/feeling1.ogg"},"낯섦":{"voiceline":"전투도 화장도 전력투구! 이게 바로 나라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/feeling2.ogg"},"호감":{"voiceline":"그러고 보니, 이 함대에서 마음에 드는 아이는 있어? 내가 어시스트 해줄까? 자자, 부끄러워하지 않아도 돼~ 비밀은 지켜줄 테니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/feeling3.ogg"},"기쁨":{"voiceline":"앗, 지휘관? 마침 잠깐 나가려고 하는 참이었어. 지금 옷 갈아입는 중~ 아, 눈 안 가려도 되잖아? 나중에 나한테도 보여주면 되니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 아직 한참 둔하네~ 자 질문! 언제나 당신과 연애이야기하고, 눈앞에서 옷을 갈아입는 것도 안 부끄러워하는 아이가, 당신을 좋아하지 않는다니, 말이 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 뭘 멍하니 있는 거야? 내가 안아주길 바라는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/home.ogg"},"hp 경고":{"voiceline":"크레타 섬에서의 그 참극… 다시 되플이되게 놔둘까 보냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 밥은 벌써 먹었어? 아직 안 먹었으면 만들어줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/login.ogg"},"실패":{"voiceline":"지휘관, 모두를 데리고 퇴각해! 안 그러면……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이야. 여기 놔둘 테니까 나중에 확인해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/mail.ogg"},"임무":{"voiceline":"지휘관, 하다 만 임무를 남기는 건 좋지 않다구~ 빨리 끝내자, 나도 도와줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/mission.ogg"},"임무완료":{"voiceline":"임무 보수 왔다 왔어~! 지휘관, 잘했네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 이 화장…앗, 옷은 어때? 가장 예쁜 내가 되었을까? ……후우~ 이런 장면은 처음이니까, 역시 가장 예쁜 내 모습을 보여주고 싶잖아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/propose.ogg"},"스킬":{"voiceline":"느낌 왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/skill.ogg"},"터치1":{"voiceline":"지휘관, 외로워졌어? 난 늘 여기에 있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/touch.ogg"},"터치2":{"voiceline":"지휘관, 내 쓰리사이즈가 궁금하면 솔직하게 물어보면 되잖아? 물어보면 제대로 알려줄 테니까~ 하하하♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/touch2.ogg"},"입수시":{"voiceline":"하~이! 피지가 착임했어~ 당신이 지휘관? 흐~음……음……풉, 하하하 꽤 괜찮잖아? 앞으로 잘 부탁해♪ 지~휘~관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/unlock.ogg"},"강화성공":{"voiceline":"전투는 제대로 열심히 할 테니까…지휘관, 안심해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"전투는 전투답게 해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0},{"클뜯 id":202161,"클뜯 함순이 id":20216,"함순이 이름":"피지","한글 함순이 + 스킨 이름":"패션 스타일?","영문 함순이 + 스킨 이름":"