[{"클뜯 id":100010,"클뜯 함순이 id":10001,"함순이 이름":"시제형 부린 MKⅡ","한글 함순이 + 스킨 이름":"시제형 부린 MKⅡ","영문 함순이 + 스킨 이름":"Prototype Bulin MKII","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100010/shipyard.png","설명":"시제형 부린 MKⅡ. SS Rare 캐릭터의 한계 돌파에 사용 가능.","자기소개":{"voiceline":"핫하하하! 날 만나게 되다니, 당신은 행복한 사람이구나── 지금부터 함께 푸링·푸링 하는 거야! 어째서라니? 푸링하면 모두 강하게 만들 수 있다고 정해져 있으니까지── 푸링으로 어떻게라니? 이렇게 푸링! 푸링하게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/profile.ogg"},"메인1":{"voiceline":"푸링~ 여기 넓어! 뛰어다녀서 즐~거워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/main1.ogg"},"메인2":{"voiceline":"그러고 보니 내 역할은 뛰어다니는 것뿐만이 아니야, 푸링? 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/main2.ogg"},"메인3":{"voiceline":"푸링이 시끄럽다고?──모~른다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/main3.ogg"},"전투개시":{"voiceline":"푸링! 적이 울 때까지 때리는 것을 멈추지 않아 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/battle.ogg"},"상세확인":{"voiceline":"아무리 봐도 상급자로는 되지 않는다구~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/detail.ogg"},"드랍 설명":{"voiceline":"시제형 부린 MKⅡ. SS Rare 캐릭터의 한계 돌파에 사용 가능.","voicelink":null},"의뢰 완료":{"voiceline":"와──앗! 지휘관! 의뢰하러 갔던 애들이 돌아왔어! 뭔가를 파서 축하하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/expedition.ogg"},"실망":{"voiceline":"지휘관이 날 실망시켰다는 건, 어떤 의미로 칭찬해줘야 하는 거야! 하지만, 야단치지 않을 거야! 와하하! 이 허무함을 맛보는 게 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/feeling1.ogg"},"낯섦":{"voiceline":"여동생은 바보. 색깔이란 건 머리카락 색이 아니라구. 레어……레, 레 뭐였더라… 그, 그래! 렌탈 청소기야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/feeling2.ogg"},"호감":{"voiceline":"이 정도로 끈기가 있다면 한 가지 비밀을 가르쳐 줄게. 여동생은 언제나 나보다 머리가 좋다고 말하지만, 실은 나보다 머리가 나쁘다구? 와하핫! 비밀로 하는 건 장녀로서의 자비야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/feeling3.ogg"},"기쁨":{"voiceline":"와이! 날고 있어! 노~옾~아! 아아아 움직이지 말라구~ 떨어질 때는 나를 받아줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/feeling4.ogg"},"사랑":{"voiceline":"설마 나조차 공략하려고 하다니, 당신의 호기심은 평범하지 않은걸! 하지만 나는 수줍어하거나 그러지 않을 거~라구! 와하하하! 뭐 특별히 와앙~은 해줄게! 와앙~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"푸링이랑 달리기로 기분 전환하자! 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"왼쪽을 파고, 오른쪽도 파고 푸링, 푸링하게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/login.ogg"},"실패":{"voiceline":"근데 어째서 내가 전장에 있는 거야 푸링!? 푸링?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/lose.ogg"},"우편":{"voiceline":"푸링!──비기, 드릴 트랜스레이션!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/mail.ogg"},"임무":{"voiceline":"푸링!──다음 임무는 너로 정했다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/mission.ogg"},"임무완료":{"voiceline":"푸링, 보너스를 받으러 갈 뿐이야. 부수지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/mission_complete.ogg"},"서약":{"voiceline":"나로 말하자면 시제형 부린 MKⅡ. 함대를 강화하기 위해 태어난 자! 그걸 알면서 이것을 건네주다니…… 이상한 녀석! 하지만 마음에 들었어! 그래, 손을 높이 들고, 나랑 함께~ 푸링 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/propose.ogg"},"스킬":{"voiceline":"나의 드릴은 하늘을 뚫을 드릴인 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/skill.ogg"},"터치1":{"voiceline":"푸링~ 나는 잡히지 않는다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/touch.ogg"},"터치2":{"voiceline":"푸링──푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/touch2.ogg"},"입수시":{"voiceline":"푸링~! 함대의 구세주 등장이야! 두근두근했어? 콩닥콩닥했어? 자아, 손을 들고서~ 함께 푸링! 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"푸링! 나, 최강!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"UNIV (bulin)","레어도":"SSR","ex_chat_status":0},{"클뜯 id":100011,"클뜯 함순이 id":10001,"함순이 이름":"시제형 부린 MKⅡ","한글 함순이 + 스킨 이름":"시제형 첨단 장비(촬영용)","영문 함순이 + 스킨 이름":"Prototype Advanced Weaponry (Prop)","스킨 타입":"Others","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/100011/shipyard.png","설명":"푸링~! 함대의 구세주, 하늘을 꿰뚫는 드릴을 손에 쥐고 씩씩하게 출격이야, 푸링! 헤헷, 내 최신 작업 폼을 보니 두근거리지, 푸링?!","자기소개":null,"메인1":{"voiceline":"푸링! 모항은 역시 넓구나! 슈퍼 드릴 MKII 위에 서니까 잘 보이네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/main1.ogg"},"메인2":{"voiceline":"오늘이야말로 이 시제형 슈퍼 드릴 MKII를 모두에게 보여줄 거야, 푸링! 지휘관도 따라 올래, 푸링?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/main2.ogg"},"메인3":{"voiceline":"푸링! 지금부터 연설을 시작할게! ……내용? 물론 \"내 드릴은 하늘을 꿰뚫는다\"는 내용이지, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/main3.ogg"},"전투개시":{"voiceline":"푸링! 내 슈퍼 고성능 폼을 감상하라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/battle.ogg"},"상세확인":{"voiceline":"왜 고성능 폼이 이렇게 된 거지, 푸링? 나도 잘 몰라! 그냥 여동생이 멋있다고 해서 만들어 본 것뿐이야, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/detail.ogg"},"드랍 설명":{"voiceline":"푸링~! 함대의 구세주, 하늘을 꿰뚫는 드릴을 손에 쥐고 씩씩하게 출격이야, 푸링! 헤헷, 내 최신 작업 폼을 보니 두근거리지, 푸링?!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"시제형 슈퍼 드릴 MKII를 봐서 다시 반한 게 분명해, 푸링! 으하하핫! 그야 빠질 수밖에 없지, 푸링! 특별히 지휘관은 만질 수 있게 해줄게, 푸링! 자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 와! 내 슈퍼 드릴 MKII랑 같이 드라이브하러 가자, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/home.ogg"},"hp 경고":{"voiceline":"푸링?! 시제형이 폭주한다, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/hp_warning.ogg"},"로그인":{"voiceline":"슈퍼 드릴! 준비 완료야, 푸링! 자, 일할 시간이야, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/login.ogg"},"실패":{"voiceline":"푸링! 역시 이펙트가 강해도 안 되는 건 안 되나 봐, 푸링…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/lose.ogg"},"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"푸링! 같이 씩씩하게 출격할까, 푸링?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/touch.ogg"},"터치2":{"voiceline":"푸링? 푸, 푸링~~! 푸링… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/touch2.ogg"},"입수시":{"voiceline":"푸링~! 함대의 구세주, 하늘을 꿰뚫는 드릴을 손에 쥐고 씩씩하게 출격이야, 푸링! 헤헷, 내 최신 작업 폼을 보니 두근거리지, 푸링?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/unlock.ogg"},"강화성공":{"voiceline":"<푸링! 슈퍼 드릴은 강화할 수 없어, 푸링!>","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"푸링! 적들이 다 놀라서 도망갔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100011/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"기타","상점 id":0,"상점 카테고리 id":9999,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"UNIV (bulin)","레어도":"SSR","ex_chat_status":0}]