[{"클뜯 id":303130,"클뜯 함순이 id":30313,"함순이 이름":"마야","한글 함순이 + 스킨 이름":"마야","영문 함순이 + 스킨 이름":"Maya","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303130/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303130/shipyard.png","설명":"타카오형 중순양함 3번함·마야","자기소개":{"voiceline":"타카오형 중순양함 3번함, 마야. 동생과는 쌍둥이지만 언니들하곤 나이 차가 좀 있어서…… 하늘의 적도 바다의 적도 이 마야한테 맡겨도 상관없다만, 바닷속 적은 다른 방법을 찾아보는 편이 좋아. 그리고 나한테 쉽사리 다가오지 말아줬으면 하는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/profile.ogg"},"메인1":{"voiceline":"무기를 쥔 순간부터 선의 길에서 벗어나는 것이 결정됐다. 지휘관, 우리는…… 영웅이 될 수 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/main1.ogg"},"메인2":{"voiceline":"남방해역, 솔로몬, 레이테만… 이 바다도 하나도 변하지 않았어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/main2.ogg"},"메인3":{"voiceline":"야마토 언니 옆에 있으면 모든 것이 둘러싸인 듯한 편안함을 느낀다. 정말 동경하는… 아니, 그 이야기가 아니다! ──그렇지만… 아니… 그러니까 그 이야기가 아니라니까! ──뭐, 그렇게 말하면… 그럴지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/main3.ogg"},"전투개시":{"voiceline":"전부 베면 되는 거지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/battle.ogg"},"상세확인":{"voiceline":"그렇게 날 쳐다보지 말아 주겠어…? 무심코 베어버린다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/detail.ogg"},"드랍 설명":{"voiceline":"타카오형 중순양함 3번함·마야","voicelink":null},"의뢰 완료":{"voiceline":"의뢰… 끝났나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/expedition.ogg"},"실망":{"voiceline":"다가오면, Schneiden(벤다)!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/feeling1.ogg"},"낯섦":{"voiceline":"말했을 텐데. 일 없으면 나한테 다가오지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/feeling2.ogg"},"호감":{"voiceline":"그러니까 가까이 오지 말라니까── 날 알고 싶다고? ……하아아, 마음대로 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 별나군…. 이런 느낌은 처음이다. 하지만…… 그리 나쁘지 않아…… 이봐, 잠깐 잡담에 어울려주겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/feeling4.ogg"},"사랑":{"voiceline":"내 꿈은 언젠가 이 하늘, 그리고 이 세상의 모든 것에게 이기는 것이다… 지휘관, 그때는, 또 곁에 있어 주겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"작전종료… 오늘도 근성 있는 상대는 만나지 못한 모양이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/home.ogg"},"hp 경고":{"voiceline":"칫… 후퇴? 웃기지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/hp_warning.ogg"},"로그인":{"voiceline":"이런 날 오늘도 곁에 둘 셈인가? …정말이지, 이상한 녀석.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/login.ogg"},"실패":{"voiceline":"……큭! ……나, 난 괜찮다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/lose.ogg"},"우편":{"voiceline":"너에게 온 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/mail.ogg"},"임무":{"voiceline":"임무…… 또, 전쟁인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/mission.ogg"},"임무완료":{"voiceline":"임무 완료…… 이제 귀항해도 되나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/mission_complete.ogg"},"서약":{"voiceline":"난 감정표현이 서툴러서… 그런데도 지휘관은 날 버리지 않았다…… 응, 지휘관이 내 이름을 계속 불러주는 한, 난 계속 싸우겠다. 그러니까… 지휘관의 손은… 난 절대로 놓지 않아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/propose.ogg"},"스킬":{"voiceline":"내 검으로… 헛되이 죽어라…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/skill.ogg"},"터치1":{"voiceline":"지휘관, 너 좀 짜증 나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/touch.ogg"},"터치2":{"voiceline":"……그대로 움직이지 마. 갑자기 휘두르고 싶어져서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/touch2.ogg"},"입수시":{"voiceline":"내 이름은 마야. 하늘을 가르는 자. 네가 지휘관인가……. 그래, 그럼 가볍게 다가오지 말아줘. 다칠 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/unlock.ogg"},"강화성공":{"voiceline":"강함은 악을 낳는다. 허나 지금의 우리에겐 그것 말곤 선택지는 없어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"귀신을 만나면 귀신을 베고, 신을 만나면 신을 벤다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303130/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":0}]