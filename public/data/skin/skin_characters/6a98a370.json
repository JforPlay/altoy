[{"클뜯 id":10800050,"클뜯 함순이 id":1080005,"함순이 이름":"미나미 유메","한글 함순이 + 스킨 이름":"미나미 유메","영문 함순이 + 스킨 이름":"Yume Minami","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800050/shipyard.png","설명":"안녕하세요, 전 미나미 유메라고 합니다. 여러가지 상황 때문에 이 세계로 오게 되었어요…… 여기선 중순양함으로 제 몫을 다할 거예요. 잘 부탁드립니다.","자기소개":{"voiceline":"제 이름은 미나미 유메, 후지요키다이 고등학교 1학년이에요. 원래 살던 세상에서 괴수와 싸운 적은 있지만…… 이번에는 함선으로서 적과 싸우게 되다니……. 그래도 제가 할 수 있는 한 최선을 다하려고 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/profile.ogg"},"메인1":{"voiceline":"이곳에서는 세이렌이라는 적과 싸우는 거군요. 어느 세상이나 싸워야 할 적은 늘 있구나…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/main1.ogg"},"메인2":{"voiceline":"지휘관님, 그 거대 병아리는……. 아, \"만쥬\"라고 부른다구요? 확실히 그런 모습이긴 하네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/main2.ogg"},"메인3":{"voiceline":"음흠흠~♪ 아, 혹시 저, 방금 노래 불렀나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/main3.ogg"},"전투개시":{"voiceline":"액세스 모드……! 아, 이게 아니지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/battle.ogg"},"상세확인":{"voiceline":"저에 대해 알고 싶다구요? 뭐, 물어보시면 답은 해드릴 수 있는데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/detail.ogg"},"드랍 설명":{"voiceline":"안녕하세요, 전 미나미 유메라고 합니다. 여러가지 상황 때문에 이 세계로 오게 되었어요…… 여기선 중순양함으로 제 몫을 다할 거예요. 잘 부탁드립니다.","voicelink":null},"의뢰 완료":{"voiceline":"아, 의뢰로 나갔던 사람들이 돌아왔네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/expedition.ogg"},"실망":{"voiceline":"아 그게…… 죄송합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/feeling1.ogg"},"낯섦":{"voiceline":"적이 출현한 건가요, 지휘관님? 아…… 아니라구요? 그럼 왜 여기에…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/feeling2.ogg"},"호감":{"voiceline":"이번엔 무슨 일이시죠? 아, 그 인형, 제 거……. 감사합니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/feeling3.ogg"},"기쁨":{"voiceline":"어느 세상이나 여러가지 룰이나 규칙이 있지만, 그것만 너무 고집하다보면 정작 지키지 못하는 것도 생기죠……. 그렇게 생각하지 않으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/feeling4.ogg"},"사랑":{"voiceline":"이 세상에 아직은 조금 익숙하지 않지만, 조금이라도 제가 할 수 있는 걸 하고 싶어서……. 앞으로도 서툴지만 최선을 다 할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/feeling5.ogg"},"터치3":{"voiceline":"잠깐! ……에취!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 다음 전투에 대비해서 조금 휴식이라도 취하시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/home.ogg"},"hp 경고":{"voiceline":"난 괜찮아……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/hp_warning.ogg"},"로그인":{"voiceline":"아, 좋은 아침입니다. 오늘은 무슨 훈련부터 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/login.ogg"},"실패":{"voiceline":"이럴 수가, 위험해……. 다들, 일단 퇴각하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/lose.ogg"},"우편":{"voiceline":"편지가 왔었어요. 책상 위에 뒀으니, 빨리 읽어두세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/mail.ogg"},"임무":{"voiceline":"나머지 임무…… 빨리 끝내두는 편이 좋지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/mission.ogg"},"임무완료":{"voiceline":"임무가 다 끝났나 봐요. 그럼, 저도 오늘은 이만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/mission_complete.ogg"},"서약":{"voiceline":"앞으로도 당혹스러운 일이 많겠지만, 제가 할 수 있는 건 분명 더 있을 테니까……. 앞으로도 잘 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/propose.ogg"},"스킬":{"voiceline":"어쩌구 빔!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/skill.ogg"},"터치1":{"voiceline":"엑세스 모드, 다이나윙! ……안 되네. 역시 의장이 비슷할뿐. 아아, 이러다 집합 시간에 늦겠어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/touch.ogg"},"터치2":{"voiceline":"아……. (찌릿)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 전 미나미 유메라고 합니다. 여러가지 상황 때문에 이 세계로 오게 되었어요…… 여기선 중순양함으로 제 몫을 다할 거예요. 잘 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/unlock.ogg"},"강화성공":{"voiceline":"응, 나도 앞으로 나아갈 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"다행이다, 안 늦어서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/win_mvp.ogg"},"전투개시_ex":{"voiceline":"적 함대……. 자, 갑시다, 모두들!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/battle_ex.ogg"},"상세확인_ex":{"voiceline":"어서 와요, 지휘관님. 할 말이 있다고 하셨죠? 일단은 거기 아무데나 앉아주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"저기, 혹시 다음 휴일에 시간 괜찮으세요? 이곳에 대해 다시 제대로 알고 싶다는 마음이 들어서. 괜찮으시다면 지휘관님이 안내해주셨으면 하는데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님도 지각할 뻔 한 적 있기는 한가…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"임무가 아직 남아있었네요. 제가 도울 수 있는게 있다면 말해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 완료하셨네요. 참 잘했습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"잠깐, 뭘 하시는 거죠……? (난감)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"모두의 마음을 하나로 모을 수 있었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['아스카가와 치세'] :  치세, 여기야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/couple_encourage1.ogg"},{"voiceline":"['무지나'] :  무지나 씨……. 여기선 힘을 합쳐서 싸워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/couple_encourage2.ogg"},{"voiceline":"['나미코'] : 나미코 씨? 음, 잘 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/couple_encourage3.ogg"},{"voiceline":"['타카라다 릿카'] : 뒤를 부탁드려요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800050/couple_encourage4.ogg"},{"voiceline":"['신죠 아카네'] : 괴수……?! 아니, 지금은 아군……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voicel