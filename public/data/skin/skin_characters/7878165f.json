[{"클뜯 id":805020,"클뜯 함순이 id":80502,"함순이 이름":"리옹","한글 함순이 + 스킨 이름":"리옹","영문 함순이 + 스킨 이름":"Lyon","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805020/shipyard.png","설명":"리옹급 전함 - 리옹","자기소개":{"voiceline":"전함 리옹, 길잃은 어린 양들을 구원하고, 증오스러운 적들에게 멸망을 가져다 주기 위해, 아이리스의 인도에 따라 이곳에 왔습니다. 그 대전의 재앙이 다시는 되풀이되지 않도록 함께 싸웁시다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/profile.ogg"},"메인1":{"voiceline":"선행을 쌓고, 다른 사람에게 감사하며, 약자를 가엾이 여기는… 신앙에 의하지 않더라도 지휘관에게는 그 나름의 구원의 길이 있군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/main1.ogg"},"메인2":{"voiceline":"꽤 어려운 고민을 하고 계신듯 하군요. 그럼 지혜를 내려 달라고 의식을 올려 볼까요? 그것이 지휘관님께 도움이 된다면 좋겠지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/main2.ogg"},"메인3":{"voiceline":"성기사 생 루이… 그녀는 중재를 잘하지만, 중재 의식이라면 제가 한 수 위인 것 같군요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/main3.ogg"},"전투개시":{"voiceline":"Fête des Lumières, 빛의 축제를 거행하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/battle.ogg"},"상세확인":{"voiceline":"수요는 적을 것 같지만, 모항 동료 중에 혹시라도 참회… 아니, 상담이 필요한 분이 계시다면 언제든 말씀해 주세요. …네? 이미 비슷한 걸 하고 있는 사람이…? 그것 참 다행이군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/detail.ogg"},"드랍 설명":{"voiceline":"리옹급 전함 - 리옹","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 동료들이 귀환했군요. 지휘관께서는 보상을 확인하시길. 저 아이들의 노고를 달래주는 건 제가 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/expedition.ogg"},"실망":{"voiceline":"잘못된 길로 들어서지는 마시길. 만약 당신을 처단해야 한다면, 저는 자비를 베풀지 않을 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/feeling1.ogg"},"낯섦":{"voiceline":"성심성의를 다하면 언젠가 꼭 보답 받습니다. 기도는 물론 동료와의 일상적인 교류도 마찬가지죠. 서로를 소중히 여기는 마음은 복잡한 의식이 없더라도 전해지는 법입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/feeling2.ogg"},"호감":{"voiceline":"마음을 다하다 보니 의식이나 의례는 늘 복잡해지기 마련이죠. 그렇게까지 할 필요 없다고 마음속으로는 알고 있지만, 매번 체면을 차리고 마는… 사람이란 원래 그런 동물일지도 몰라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/feeling3.ogg"},"기쁨":{"voiceline":"저도 지휘관을 흠모하기에, 관심을 끌고자 노력하는 그 마음은 잘 압니다. 후후후, 지휘관. 복잡하게 생각할 필요 없어요. 좋아하는 감정은 그 형태가 어떻든 반드시 전해지니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 제 마음이 느껴지시나요? 후후후, 거짓말은 마세요. 만약 지휘관께서 체면을 차리실 생각이라면…… 제 쪽에서 이렇게 계속 지휘관께 찰싹 붙어있어 드릴 수밖에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"우리가 승리한 것은 모두 거룩한 인도가 있었기 때문입니다. 자, 회고 전에 먼저 감사 의식을 올리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/home.ogg"},"hp 경고":{"voiceline":"부디 제게 이 위기를 극복할 수 있는 힘을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/hp_warning.ogg"},"로그인":{"voiceline":"평안하신지요. 아이리스의 말씀을 들으러 오신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/login.ogg"},"실패":{"voiceline":"침착하게 철수하세요. 우리의 성스러운 책무는 아직 끝나지 않았습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/lose.ogg"},"우편":{"voiceline":"우편이 도착한 것 같군요. 부디 기쁜 소식이기를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/mail.ogg"},"임무":{"voiceline":"완료하지 않은 임무가 있군요. 어서 처리하는 편이 좋겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/mission.ogg"},"임무완료":{"voiceline":"보상이 도착했습니다. 수령할 때는 부디 감사하는 마음을 잊지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/mission_complete.ogg"},"서약":{"voiceline":"다음으로 축복받은 이 장소에서 영원한 서약을 나누고, 키스로 신성한 유대를 맺을 거예요…. 긴장하지 마세요. 평소와는 달리 제 자신의 중요한 의식을 거행하는 거라, 저도 가슴이 너무 두근거리네요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/propose.ogg"},"스킬":{"voiceline":"아이리스의 모든 적을 멸하기 위해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/skill.ogg"},"터치1":{"voiceline":"네. 리옹이 이야기를 들어 드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/touch.ogg"},"터치2":{"voiceline":"어떠한 연유로 이런 행동을 하시게 된 건지… 참으로 궁금하군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/touch2.ogg"},"입수시":{"voiceline":"함대에는 무구한 아이리스의 빛을, 죄를 지은 적에게는 장엄한 아이리스의 심판을…… 전함 리옹, 지휘관의 부름을 받아 이렇게 달려왔습니다. 속세의 힘을 다루는 당신께도 부디 아이리스의 가호가 있기를…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/unlock.ogg"},"강화성공":{"voiceline":"강화에 성공했습니다. 지휘관께 감사드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"자비로운 아이리스시여, 용서하십시오. 적을 무찌르기 위해서는 이 힘이 필요합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"고민거리든 고민거리가 아니든, 무엇이든 리옹에게 말씀해 주시길. …사실은 그저 지휘관과 대화를 나누고 싶을 뿐이랍니다. 후후후, 그럼 안 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"함께 성스러운 책무를 다하는 동료들, 그리고 이끌어 주신 사랑스러운 지휘관께 감사를. …후후후, 왜 그러시나요? 제가 이상한 말이라도 했나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"평안하신지요. 오늘도 아이리스의 말씀을… 후후후, 그럼 근무 시간 종료 후의 일정에 넣어 둘게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"혹시 괜찮으시면 제 이야기도 들어 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/touch_ex.ogg"},"터치2_ex":{"voiceline":"치유가 필요하신 건 잘 알겠어요. 리옹으로 괜찮으시면 언제든 말씀하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"정말, 지휘관. 승리한 건 좋지만, 너무 우쭐하시면 안 됩니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"좋아하는 동물이라… 저는 사자겠네요. 용맹스럽고 위엄도 있고… 마치 제가 사랑하는 지휘관처럼 말이죠. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/main5_ex.ogg"},"메인6_ex":{"voiceline":"피곤하시면 제가 대신 해드릴게요. 기도하는 것 말고도 조금은 당신께 힘이 되어 드리고 싶으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"리슐리외 님의 말씀을 들으실 건가요? 그럼 저도…… 글쎄요. 저도 질투 정도는 한다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805020/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"FFNF","레어도":"SR","ex_chat_status":1},{"클뜯 id":805021,"클뜯 함순이 id":80502,"함순이 이름":"리옹","한글 함순이 + 스킨 이름":"페어 엑서사이즈","영문 함순이 + 스킨 이름":"Paired Exercise","스킨 타입":"Sports Time","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805021/shipyard.png","설명":"음… 이 '필라테스'? 확실히 가볍게 할 수는 있겠지만, 제대로 익히기엔 꽤 심오해 보이는군요…. 지휘관은 아직 괜찮으신가요? 저요? 아, 아직은 할만합니다…","자기소개":null,"메인1":{"voiceline":"(목은 괜찮은데, 가슴 쪽이 좀 힘드네요… 설마 어딘가 자세가 잘못된 걸까요…?)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/main1.ogg"},"메인2":{"voiceline":"(이 자세, 잘 생각해 보면 굉장히 부끄럽네요… 지휘관께서 보고 계셔서 도중에 그만둘 수도 없고… 이대로 있어야 하는 걸까요…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/main2.ogg"},"메인3":{"voiceline":"(모처럼 지휘관께서도 함께 운동해 주고 계시니, 제가 먼저 죽는 소리를 내면 안 되겠죠… 그래요, 지휘관께서 쉬자고 먼저 말을 꺼내시기 전까지는 참는 거예요.)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"그러고 보니 이 운동은 '컨트롤로지'라고도 부른다고 해요. 이상적인 자세를 유지하면서 운동함으로써 근육과 정신을 제어하는 기술을 배우는… 심오하다는 말이 이해가 갑니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/detail.ogg"},"드랍 설명":{"voiceline":"음… 이 '필라테스'? 확실히 가볍게 할 수는 있겠지만, 제대로 익히기엔 꽤 심오해 보이는군요…. 지휘관은 아직 괜찮으신가요? 저요? 아, 아직은 할만합니다…","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 아이들이 슬슬 돌아오겠네요. 괜찮으시면 이 다음에 같이 마중하러 나가시겠어요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"(지휘관도 숨이 가쁘시네요. 전투로 인한 피로감 때문에 그러신 거겠지만, 그래도 같이 땀을 흘린 것 같아서 좋네요…… 아, 땀 냄새가 별로 신경 쓰이지 않으시면 좋을 텐데…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 아직 할만하신가요? 힘들면 언제든 말씀해 주시길……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무…인가요? 네, 끝나면 확인하러 가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/mission.ogg"},"임무완료":{"voiceline":"임무 보상? 노력한 보상치고는 너무 호화로운 거 아닌가요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"(으음… 언제쯤이면 이 동작을 능숙하게 해낼 수 있을까요…?)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/touch.ogg"},"터치2":{"voiceline":"앗?! …지휘관, 지금은 안 돼요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/touch2.ogg"},"입수시":{"voiceline":"음… 이 '필라테스'? 확실히 가볍게 할 수는 있겠지만, 제대로 익히기엔 꽤 심오해 보이는군요…. 지휘관은 아직 괜찮으신가요? 저요? 아, 아직은 할만합니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805021/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"스포츠","상점 id":70893,"상점 카테고리 id":13,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"FFNF","레어도":"SR","ex_chat_statu