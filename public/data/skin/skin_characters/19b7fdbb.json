[{"클뜯 id":401190,"클뜯 함순이 id":40119,"함순이 이름":"Z19","한글 함순이 + 스킨 이름":"Z19","영문 함순이 + 스킨 이름":"Hermann Künne (Z19)","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401190/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401190/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401190/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401190/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401190/shipyard.png","설명":"1936년형 구축함 -  Z19 헤르만 퀸느","자기소개":{"voiceline":"저는 메탈 블러드 해군 Z클라스 구축함, 1936년형 헤르만 퀸느라고 합니다! 나르비크 해전에서 최후를 맞이했지만, 이번엔 절대 지지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/profile.ogg"},"메인1":{"voiceline":"비서함은 더욱 자신에게 엄격해야죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/main1.ogg"},"메인2":{"voiceline":"지휘관님, 다, 다음에 시간 되시면…저, 저와 함께 놀러 가지 않으시겠어요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/main2.ogg"},"메인3":{"voiceline":"지휘관님, 수박을 잘랐어요! 입을 벌려주세요! 아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/main3.ogg"},"전투개시":{"voiceline":"전 함, 적 함대 조준, 포격 준비! Feuer!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/battle.ogg"},"상세확인":{"voiceline":"문제 있으신가요? 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/detail.ogg"},"드랍 설명":{"voiceline":"1936년형 구축함 -  Z19 헤르만 퀸느","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 끝나면, 저와 놀러갈 시간이죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/expedition.ogg"},"실망":{"voiceline":"지금의 지휘관님은 0점입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/feeling1.ogg"},"낯섦":{"voiceline":"어떤 능력이라 해도 분명 도움이 되는 때가 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 다음 전투에서 제일 큰 활약을 하게 되면, 비번인 날에 워터 파크에 데려가 주실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 옆에 있으면 아무것도 하지 않아도 왠지 안심이 됩니다. 이게 '의지가 된다' 고 하는 건가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/feeling4.ogg"},"사랑":{"voiceline":"후아암…앗! 지휘관님? 아직 방에 돌아가지 않으셨나요. 깨워서 미안하다고요? 저는 딱히 상관없지만, 지휘관님이 여기서 자고 싶다 하셔도 침대가 하나밖에 없어서…손가락 사이즈를 재고 싶으시다고요? 아, 지금 불을 켜겠습……에에에?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 저와 잠깐 놀아주시겠습니까? ……에엣, 피곤하신가요? 음…지휘관님껜 휴식도 중요하니까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 아침밥을 거르는 건 몸에 좋지 않다고요. 제가 귀리빵을 준비해두었으니 지휘관님, 괜찮으시다면 같이 드시지 않겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/login.ogg"},"실패":{"voiceline":"우으으…작전 실패입니다……지휘관님, 죄송합니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/lose.ogg"},"우편":{"voiceline":"새로운 우편입니다! 분명 지휘관님을 표창하는 내용일 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/mail.ogg"},"임무":{"voiceline":"아! 벌써 일할 시간이군요. 지휘관님, 임무를 클리어하러 가자고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 이번 임무도 훌륭히 마치셨네요! 100점입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/mission_complete.ogg"},"서약":{"voiceline":"정말 받아도 괜찮은 건가요…? 감사합니다…지휘관님께 부끄럽지 않도록 최선을 다하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/propose.ogg"},"스킬":{"voiceline":"노력의 성과입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/skill.ogg"},"터치1":{"voiceline":"뭔가 지시하실 일이라도 있으신가요? 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/touch.ogg"},"터치2":{"voiceline":"이제 비행기 태워주는 걸 좋아할 나인 아니라고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/touch2.ogg"},"입수시":{"voiceline":"헤르만 퀸느, 참전 보고 드립니다. 지휘관님, 이번에도 마지막까지 싸우겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/unlock.ogg"},"강화성공":{"voiceline":"어른에 한 걸음 더 가까워졌으려나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/upgrade.ogg"},"vote":null,"승리":{"voiceline":"Z23, 이번엔 제가 100점입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401190/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"R","ex_chat_status":0}]