[{"클뜯 id":201030,"클뜯 함순이 id":20103,"함순이 이름":"아덴트","한글 함순이 + 스킨 이름":"아덴트","영문 함순이 + 스킨 이름":"Ardent","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201030/shipyard.png","설명":"A급 실험 구축함 아덴트 (H41)","자기소개":{"voiceline":"나는 아덴트, A급 구축함 3번함, 음… 글로리어스 언니 이야기 외에는 특별히 할 말은 없어. 하지만 그때는 정말 노력했다니깐? 뭐 그러니까, 지휘관과 만나서 정말 다행이야! 앞으로 계속 사이좋게 지내자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/profile.ogg"},"메인1":{"voiceline":"지휘관 배고파? 같이 밥 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/main1.ogg"},"메인2":{"voiceline":"아, 있잖아, 지휘관, 남는 부품 있어? 잠깐 정기 검사를 하고 싶은데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/main2.ogg"},"메인3":{"voiceline":"저기, 듣고 있는 거야? 우우… 역시 지휘관은 내가 질린건가……농담이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/main3.ogg"},"전투개시":{"voiceline":"적이 왔어! 화재에는 조심해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/battle.ogg"},"상세확인":{"voiceline":"그… 여기 살 게 된지 벌써 좀 됐는데, 아직 남이 날 본다는 게 좀 어색하네… 내가 좀 특이한가? 아하하…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/detail.ogg"},"드랍 설명":{"voiceline":"A급 실험 구축함 아덴트 (H41)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 애들이 의뢰 완료하고 돌아오는 걸 봤어. 마중나가자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/expedition.ogg"},"실망":{"voiceline":"사이가 좋다고 생각했던 건 내 오해였구나… 미안…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 나랑 굉장히 마음이 잘 맞는다고 생각하지 않아? 응응♪ 나도 지휘관이 굉장히 친한 친구처럼 느껴져♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/feeling2.ogg"},"호감":{"voiceline":"지휘관, 뭔가 먹지 않을래? 내가 만들어 줄게♪ 괜찮아, 좋아하는 음식은 전부 기억하고 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/feeling3.ogg"},"기쁨":{"voiceline":"개인적으로, 가부장적인 것도 괜찮은 것 같아…하지만…이렇게 매일 담담하게 지내는 거, 지휘관은 정말 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/feeling4.ogg"},"사랑":{"voiceline":"일상이란 건 아마 이런 느낌일까… 큰 출렁임도 없이 그저 담담하게 지내는 거야. 그러니까 지휘관, 앞으로도 계속 이렇게 지내는 거다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"하아… 지휘관도 돌아왔구나","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 간식 먹을래? 조금 남겨 뒀어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/login.ogg"},"실패":{"voiceline":"앗! 빨리 퇴각하지 않으면 열사병에 걸릴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/lose.ogg"},"우편":{"voiceline":"아, 아까 자리에 없길래 내가 우편 받았어…자 여기.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/mail.ogg"},"임무":{"voiceline":"임무인데? 때마침 보고 있었으니까, 지금 알려준 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/mission.ogg"},"임무완료":{"voiceline":"보너스가 도착했는데? 가져가도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/mission_complete.ogg"},"서약":{"voiceline":"결혼해도 인생은 아직 길어… 그치만 아무 일도 없는 일상이라도, 지휘관만 있으면 지루하지 않은걸~ 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/propose.ogg"},"스킬":{"voiceline":"조금만 더 힘내자…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/skill.ogg"},"터치1":{"voiceline":"그… 그렇게 가까이 오면 다른 사람들이 오해한다구……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/touch.ogg"},"터치2":{"voiceline":"꺅! 이런 건… 집에 도착한 후에 하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/touch2.ogg"},"입수시":{"voiceline":"지휘관이 있는 데로 오늘 이사 왔어~ 잘 부탁해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/unlock.ogg"},"강화성공":{"voiceline":"지휘관이 소중하게 생각해줘서 정말 기뻐~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"가성비 좋은 전투네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아카스타'] : 아카스타, 힘내!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/couple_encourage1.ogg"},{"voiceline":"['글로리어스'] : 와앗, 글로리어스 씨, 적이 저쪽에 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201030/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0},{"클뜯 id":201031,"클뜯 함순이 id":20103,"함순이 이름":"아덴트","한글 함순이 + 스킨 이름":"밸런타인의 아덴트","영문 함순이 + 스킨 이