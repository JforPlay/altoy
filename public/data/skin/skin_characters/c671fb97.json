[{"클뜯 id":9712010,"클뜯 함순이 id":971201,"함순이 이름":"베스탈·META","한글 함순이 + 스킨 이름":"베스탈·META","영문 함순이 + 스킨 이름":"Vestal META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9712010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9712010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9712010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9712010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9712010/shipyard.png","설명":"지휘관님…이신 것 같네요. 보기에 질병 걱정은 없으니 안심하세요. 저는 베스탈, 아픈 아이가 있으면 치료든 수리든 도와드릴 수 있을 거예요…","자기소개":{"voiceline":"공작함 베스탈입니다. 함선들의 의사라고 생각하시면 될 거예요…. 물론, 지휘관님도 컨디션이 안 좋을 땐 제가 도와드릴 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/profile.ogg"},"메인1":{"voiceline":"의사로서 가장 성가신 건 병세를 숨기거나 강한 척 하는 환자죠. 오래 끌면 정말 큰일이 난다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/main1.ogg"},"메인2":{"voiceline":"네? …저 따위 신경쓰는 것보다 더 중요한 일에 집중하시는 편이 좋을 텐데요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/main2.ogg"},"메인3":{"voiceline":"생명을 구하는 건 의사로서 당연한 일입니다. 설령 구조 활동을 하다가 다치더라도 후회는 없어요…. 물론 제 자신도 소중히 여겨야 한다는 건 알고 있어요. 어느 정도 필요한 조치는 취하고 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/main3.ogg"},"전투개시":{"voiceline":"안전을 최우선으로 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/battle.ogg"},"상세확인":{"voiceline":"시든 꽃이 다시 피어나지 않듯, 잃어버린 생명은 다시 돌아오지 않아요…. 생명의 무게는 결코 저울로 가벼이 잴 수 있는 것이 아니에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/detail.ogg"},"드랍 설명":{"voiceline":"베스탈 호 공작함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>'","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 물자를 전해 줬어요. …보충된 의료용품입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/expedition.ogg"},"실망":{"voiceline":"지휘관님은 '병'에 걸리셨어요. 그것도 아주 심각한… 그렇지만 제 치료에 협력해 주시면 아직 손쓸 방법은 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/feeling1.ogg"},"낯섦":{"voiceline":"진료는 지휘관님의 영역은 아니지만…… 평소에 함대 아이들의 목소리에 귀를 기울이고, 여러모로 고생하시는 당신은 '의사'라고 불려도 이상하지 않다고 생각해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 잠깐이라도 시간을 내서 건강 검진을 다녀오는 건 어때요? 배나 인간이나 때로는 도크에 들어가 점검을 받아야 해요. '증상이 없으니까 괜찮아'라는 말은 마시구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/feeling3.ogg"},"기쁨":{"voiceline":"고민을 담아 두거나 생각을 너무 많이 하면 언젠간 폭발해 버려요. 지휘관님, 함대 아이들에게 고민 상담 요청을 받으면 이야기를 잘 들어 주세요. 그 대신이라고 하면 좀 그렇지만, 지휘관님의 고민은 제게 맡겨주시구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/feeling4.ogg"},"사랑":{"voiceline":"계속 보살펴달라니… 이상한 분이시네요. 온종일 의사의 보살핌을 받고 싶어 하는 특이한 사람은 없을 텐데요…. 좋아서 돌보는 건 제 쪽이기도 하고, 어쩔 수 없네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"방금 전투로 다친 애는 없나요? …아무래도 전원 검사를 실시하는 편이 좋을 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/home.ogg"},"hp 경고":{"voiceline":"문제없어요. 이 정도는 응급 처치만 하면 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/hp_warning.ogg"},"로그인":{"voiceline":"어서 오세요. 집무실 소독은 다 끝났지만, 아직 희미하게 냄새가… 신경 쓰이지 않으시면 다행이지만….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/login.ogg"},"실패":{"voiceline":"여기서 더 부상자가 늘어나면 곤란해지는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/lose.ogg"},"우편":{"voiceline":"멀리서 온 우편… 지휘관님, 어서 확인해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/mail.ogg"},"임무":{"voiceline":"임무는 아직 많이 남아 있지만, 모쪼록 부담이 되지 않도록 조심하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐습니다. 지휘관님, 조금은 숨돌릴 시간을 남겨두는 편이 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/mission_complete.ogg"},"서약":{"voiceline":"네라고 대답해 드릴 테니 지휘관님도 확실히 약속해 주세요. 이제부터는 자기 몸도 소중히 하겠다고. 함대 아이들뿐만 아니라 저도 당신을 필요로 한다는 거, 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/propose.ogg"},"스킬":{"voiceline":"의사 선생님 말은 들으셔야죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/skill.ogg"},"터치1":{"voiceline":"건강 검진… 해드리면 될까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/touch.ogg"},"터치2":{"voiceline":"다른 사람의 상냥함에 너무 응석을 부리는 것도 병입니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/touch2.ogg"},"입수시":{"voiceline":"지휘관님…이신 것 같네요. 보기에 질병 걱정은 없으니 안심하세요. 저는 베스탈, 아픈 아이가 있으면 치료든 수리든 도와드릴 수 있을 거예요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/unlock.ogg"},"강화성공":{"voiceline":"더 많은 사람에게 도움이 될 수 있기를….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"다친 아이는? …그럼 다행이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9712010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_