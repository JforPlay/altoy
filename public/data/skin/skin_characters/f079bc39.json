곁에서 봉사할 수 있는 직책에는 상당한 가치가 있다는 소리를 들었어. 아무래도 이거, 동료들의 부러움을 한몸에 받게 생겼는걸? 우후후후, 후후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/detail.ogg"},"드랍 설명":{"voiceline":"날 감히 메이드로 들이겠다고? 어머, 역시 내가 인정한 지휘관답게 야심이 무척이나 바람직해! ……아, 그냥 일시적인 거야?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔네. 마중은 어떻게 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"업무 대행을 하인…… 아니, 메이드에게 맡기지도 못하는 주인님이 대체 어딨어? 자, 내가 대신 업무 처리 해놨어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"♪~ 메이드에게 내릴 지시는 아직 없는 거야? 생각보다 주인님으로서의 자질이 없네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/login.ogg"},"실패":null,"우편":{"voiceline":"편지는 저기에 가져다 뒀어. 네 손이 가장 잘 닿는 위치에 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/mail.ogg"},"임무":{"voiceline":"새로운 임무네. 으흠, 이것도 메이드가 신경을 써야하는 부분이군…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"기거, 침식, 의례, 사무, 참모, 전투…… 다 맡겨만 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/touch.ogg"},"터치2":{"voiceline":"으앗?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/touch2.ogg"},"입수시":{"voiceline":"날 감히 메이드로 들이겠다고? 어머, 역시 내가 인정한 지휘관답게 야심이 무척이나 바람직해! ……아, 그냥 일시적인 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"오늘은 내가 지휘관 대신 축배사를 들도록 하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699011/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"