[{"클뜯 id":699010,"클뜯 함순이 id":69901,"함순이 이름":"마르코 폴로","한글 함순이 + 스킨 이름":"마르코 폴로","영문 함순이 + 스킨 이름":"Marco Polo","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/699010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/699010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/699010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/699010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/699010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/699010/shipyard.png","설명":"전함-—마르코 폴로","자기소개":{"voiceline":"난 사르데냐 엠파이어의 전함, 마르코 폴로다. 네가 날 베네토 그녀들과 비교하는 걸 개의치 않지만, 한 가지를 명심해라——만약 내가 그 위치에 있다면, 난 그녀들보다 더 우월했을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/profile.ogg"},"메인1":{"voiceline":"좋은 것들을 남들이 다 가져가도록 둘 바에야 우리가 받는 게 낫지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/main1.ogg"},"메인2":{"voiceline":"이스트 글림… 도처에 황금이 널린 좋은 땅이지! 기회가 생기면 얘기해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/main2.ogg"},"메인3":{"voiceline":"지도에서 보면, 이 모항은 역시 너무 작단 말이지… 너 말이야, 세력을 더 확장시키고 싶지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/main3.ogg"},"전투개시":{"voiceline":"출발하자, 전사들이여. 영광의 부흥을 위해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/battle.ogg"},"상세확인":{"voiceline":"난 네가 나의 루스티켈로가 되어도 상관 없어. 난 오히려 이렇게 다른 사람에 의해 기록되는 기분을 즐기거든. 아 참, 실패한 기록은 써넣을 필요 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/detail.ogg"},"드랍 설명":{"voiceline":"전함-—마르코 폴로","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 복귀했어. 지휘관, 넌 그녀들과 함께 동행해서 먼 곳의 그 경관들을 봤어야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/expedition.ogg"},"실망":{"voiceline":"네가 지휘관만 아니었다면, 딱히…… 아무것도 아니다. 흥.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/feeling1.ogg"},"낯섦":{"voiceline":"어머. 다가오는 건가? 두려워하지 않고 이 마르코 폴로에 대해 알고 싶다고……? 좋을 대로 해라. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/feeling2.ogg"},"호감":{"voiceline":"너의 식견과 안목은… 확실히 시시한 속물들과는 다르군. 하지만, \"야심\"이 좀 더 있었더라면 좋았을텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/feeling3.ogg"},"기쁨":{"voiceline":"이토록 실력이 막강한 함대를 거느리고 있는데, 사르데냐의… 아니, 너 자신의 위광을 알릴 생각이 없단 말이야? 정말 어이가 없네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/feeling4.ogg"},"사랑":{"voiceline":"너, 아무도 나 \"마르코 폴로\"의 위광을 빛나게 하라고 말해준 적 없어! 너... 너 이... 너무 욕심이 지나친 거 아니야!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"난 항상, 비서함이라면 마땅히 대신 일을 처리할 수 있는 권리를 부여받아야 한다고 생각했는데——아, 물론 네가 없을 때 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/home.ogg"},"hp 경고":{"voiceline":"위기 또한 기회다, 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/hp_warning.ogg"},"로그인":{"voiceline":"보아하니 사업을 위해 자신의 시간을 희생할 각오가 되어있는 것 같군, 좋다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/login.ogg"},"실패":{"voiceline":"젠장, 오늘 내가 당한 수치심을 훗날 반드시 백 배로 돌려받겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/lose.ogg"},"우편":{"voiceline":"우편? 화의를 청한다고? 그럼 조건은 우리가 정해야겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/mail.ogg"},"임무":{"voiceline":"임무? 이런 소소한 일은 미뤄두면 안 되지. 신속히 해결해버려.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/mission.ogg"},"임무완료":{"voiceline":"사소한 일을 처리 완료했다고? 좋아, 그럼 더 중요한 일에 집중하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/mission_complete.ogg"},"서약":{"voiceline":"이치대로라면, 큰 뜻을 품은 사람은 서약과 같은 것에 얽매여서는 안 되지, 하지만… 상대가 너니까 약간의 \"타협\"을 해보겠다. 우리가 함께 야망을 이루기 전에 제멋대로 사라지는 건 안 된다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/propose.ogg"},"스킬":{"voiceline":"고개 숙여 나에게 복종하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/skill.ogg"},"터치1":{"voiceline":"말해봐, 무슨 일로 날 방해한 건지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/touch.ogg"},"터치2":{"voiceline":"쯧, 천박한 속물 같은 유치한 취미……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/touch2.ogg"},"입수시":{"voiceline":"날 깨운 자여, 그에 걸맞는 대가를 치를 각오는 되었는가? 좋다. 너의 용기를 칭찬하마! 나는 마르코 폴로, 제국의 위용을 드높이기 위해 함께 분투하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/unlock.ogg"},"강화성공":{"voiceline":"멋진데! 너도 알다시피, 오직 더 강한 사람만이 더 많은 이익을 추구할 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"응? 겨우 이정도로 투항한 거야? 우리가 이겼어? 정말 골치아프네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['비토리오 베네토'] : 우유부단해서는 좋은 지도자가 될 수 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/699010/coup