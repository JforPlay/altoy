[{"클뜯 id":305070,"클뜯 함순이 id":30507,"함순이 이름":"카가(전함)","한글 함순이 + 스킨 이름":"카가(전함)","영문 함순이 + 스킨 이름":"Kaga(BB)","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305070/shipyard.png","설명":"카가급 전함 1번함 - 카가 ","자기소개":{"voiceline":"카가급 1번함인 카가다. 나가토급의 개수형이며, 그 '88함대' 계획에서 함대 결전용 주력함으로서 건조되었다. 아마기씨…… 그 사람과는 언젠가 한 번 겨뤄보고 싶군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/profile.ogg"},"메인1":{"voiceline":"항공모함의 조그마한 함재기가 강하다고? 난 그렇게 생각하지 않아. 그리고 말야, 자기 실력으로 싸움에 임할 수 없다니, 따분하다고 생각하지 않나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/main1.ogg"},"메인2":{"voiceline":"비서함에 임명된 이상, 아무것도 못 한다는 건 심기에 거슬리는군. 지휘관, 내가 할 수 있는 건 없나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/main2.ogg"},"메인3":{"voiceline":"아마기 씨는 내 호적수이자, 가장 존경하는 사람이다. 그 사람을 보좌하라고 해도 불복하진 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/main3.ogg"},"전투개시":{"voiceline":"강적인가… 즐겨주도록 하지! 실망시키지는 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/battle.ogg"},"상세확인":{"voiceline":"보는 것만으론 강해지지 않아. 지휘관, 빨리 날 출격시켜라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/detail.ogg"},"드랍 설명":{"voiceline":"카가급 전함 1번함 - 카가","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료된 모양이다. 그러고 보니, 의뢰란 건 재밌나? 내게도 한 번 맡겨달라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/expedition.ogg"},"실망":{"voiceline":"너는 내가 추구하는 강자는 아니었군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/feeling1.ogg"},"낯섦":{"voiceline":"자신의 나약함과 마주하는 것은 부끄러운 일이 아니다. 나약함을 인정하고, 그 뒤 강해지면 된다. 그뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/feeling2.ogg"},"호감":{"voiceline":"강함을 추구하는 이유? 이유 같은 건 없어……굳이 말하자면……아마기 씨에게 이기기 위해서다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 더 강해지려면 어떻게 해야 하지? 이대로 계속 앞으로 나아가면 될 거라고 생각했지만, 아마기씨, 그리고 너를 보고 있으면, 아무래도 그것만으론 부족할 것 같다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/feeling4.ogg"},"사랑":{"voiceline":"나는 지휘관에게 쓰일 때 비로소 강해지는 모양이군. …후후후, 이런 것도… 나쁘진 않지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"강적을 이기는 것만큼 즐거운 일은 없지. 안 그런가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/home.ogg"},"hp 경고":{"voiceline":"좋아! 내가 전력을 다할 가치가 있군!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 집무 시작 전에 어깨라도 좀 풀어둬라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/login.ogg"},"실패":{"voiceline":"큭! 그 얼굴, 기억해두겠다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/lose.ogg"},"우편":{"voiceline":"우편이다. 받아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/mail.ogg"},"임무":{"voiceline":"임무? 전투와 상관없는 일을 나한테 일일이 묻지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/mission.ogg"},"임무완료":{"voiceline":"임무…보수인가. 내가 받아오지. 마침 몸을 움직이고 싶었던 참이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/mission_complete.ogg"},"서약":{"voiceline":"모든 것을 맡길 수 있는 상대에게 등 뒤를 맡긴 채, 후회 없이 싸운다… 이거야말로 내가 꿈꿔왔던 것, 나의 소원이다. 그 상대가 너라면…… 흠, 바랄 나위가 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/propose.ogg"},"스킬":{"voiceline":"전장에 설 자격이 있는 건 강자뿐이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/skill.ogg"},"터치1":{"voiceline":"지휘관, 집무실에 틀어박히는 건……따분하다고 생각하지 않나? 기분 전환할 겸 나와 같이 가볍게 산책이라도 하는 게 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/touch.ogg"},"터치2":{"voiceline":"……일단 한 대 맞아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/touch2.ogg"},"입수시":{"voiceline":"훔, 여기가 내 실력을 발휘할 곳인가. 나쁘진 않겠군. 나는 카가……전함 카가다. 착각하지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/unlock.ogg"},"강화성공":{"voiceline":"후후후, 실망시키진 않으마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"무르군! 더 강해져서 돌아와라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아마기'] : 아마기씨, 또 혼자서 없어지거나 하진 말아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305070/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X",