[{"클뜯 id":701030,"클뜯 함순이 id":70103,"함순이 이름":"민스크","한글 함순이 + 스킨 이름":"민스크","영문 함순이 + 스킨 이름":"Minsk","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701030/shipyard.png","설명":"레닌그라드급 구축함—민스크 ","자기소개":{"voiceline":"38형 구축함 민스크, 겨울 전쟁에 참전해 자매들과 함께 조국을 위해 싸웠지. 지휘관 동지, 기대해도 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/profile.ogg"},"메인1":{"voiceline":"강구트… 아니, 강구트 동지? 물론 알고 있지. 어떻게 말해야 할까, 조금 무서워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/main1.ogg"},"메인2":{"voiceline":"나의 번뜩이는 영감처럼 나의 투지도 쉽게 꺾이지 않아——물론, 몇번이고 오뚝이처럼 일어날 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/main2.ogg"},"메인3":{"voiceline":"망쳐버리면 어떡하냐고? 물론 최선을 다해서 사과해야지! 그러면 분명 용서해줄 거야! 아마도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/main3.ogg"},"전투개시":{"voiceline":"따라와보시지. Ура!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/battle.ogg"},"상세확인":{"voiceline":"흐응? 새롭게 떠오른 영감 실험을 도와주려는 걸까? 지휘관 동지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/detail.ogg"},"드랍 설명":{"voiceline":"레닌그라드급 구축함—민스크","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료! 헤헤, 모두를 맞이하러 갈게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/expedition.ogg"},"실망":{"voiceline":"에, 지휘관 동지는 정말 재미 없는 사람이네. 이러면 좋아해줄 사람이 없을걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/feeling1.ogg"},"낯섦":{"voiceline":"여자아이의 사랑을 받으려면 조금 더 재미있어져야 해! 그러니까, 항상 번뜩이는 아이디어를 가지고 있어야 한다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/feeling2.ogg"},"호감":{"voiceline":"아하하하… 지휘관 동지, 우리는 좋은 친구지? 그러니까 모두에게 계산을 해줄 때 내 것도… 에? 왜 지휘관 동지가 먼저 도망가는 건데!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/feeling3.ogg"},"기쁨":{"voiceline":"아이고. 지휘관 동지는 재미없는 사람이라고 생각했는데, 사귀어보니 재미있는 점이 있더라고! 재미있는 생각이 또… 더 중요한 것은! 내가 뭔가를 망쳐도 혼내지 않을 거잖아! 하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/feeling4.ogg"},"사랑":{"voiceline":"좋아. 이제 알겠어. ‘요즈음 항상 지휘관 동지를 생각했던 것’에 대해 확실히 알았어. 자, 그러면 내 답을 알려줄게. 후~하~ 지휘관 동지, 아무래도 동지를 좋아하는 것 같아! 후후, 그렇지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"나의 번뜩이는 영감을 주체할 수가 없어! 그러니까, 지휘관 동지가 막 돌아오긴 했지만… 헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/home.ogg"},"hp 경고":{"voiceline":"아이고, 진지하게 해야겠는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 동지, 마침 잘 왔어. 내가 또 번뜩이는 새로운 전술을 생각해냈다고! 한번 시험해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/login.ogg"},"실패":{"voiceline":"잠시만! 잠시만! 아직 준비 안 됐어. 와아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/lose.ogg"},"우편":{"voiceline":"윽, 잠깐만. 1분 안에 꽉 찬 우편함에 대해서 설명해주지 않겠어…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/mail.ogg"},"임무":{"voiceline":"자자자, 지휘관 동지! 번뜩이는 새로운 계획을 알려줄게. 이봐, 도망가지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/mission.ogg"},"임무완료":{"voiceline":"아이고~ 결과가 좋으면 다행이지. 그러니까 이번에는 보상이 얼마나 나왔더라?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/mission_complete.ogg"},"서약":{"voiceline":"이걸 받으면 종신 계약을 하는 것이나 마찬가지인 거지? 에헤헤, 앞으로도 지휘관 동지에게 내 새로운 아이디어를 시험해 볼 수 있다는 거구나! 걱정 마. 소·중·하·게 대해줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/propose.ogg"},"스킬":{"voiceline":"내 차례구나! 발사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/skill.ogg"},"터치1":{"voiceline":"어라? 지휘관 동지도 뭔가 번뜩이는 아이디어가 있는 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/touch.ogg"},"터치2":{"voiceline":"?! … 설마 이전에 했던 것에 대한 복수는 아니겠지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/touch2.ogg"},"입수시":{"voiceline":"Ура! 어때, 어때? 깜짝 놀랐어? 에? 새로운 동지를 맞이할 때는 서프라이즈가 있어야 한다고 했는데. 응? 내가 그 주인공이라고? 아무래도 잘못 안 모양이네. 에헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/unlock.ogg"},"강화성공":{"voiceline":"오오오! 새로운 영감이 솟아오른다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어때! 나의 이 엄청난 동력! 에헤헤. 부럽지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아브로라'] : 아브로라 동지, 오늘도 반짝이는구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701030/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,