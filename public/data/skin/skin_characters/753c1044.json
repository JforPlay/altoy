rnando2603/AzurLane/main/audio/voiceline/301850/mission.ogg"},"임무완료":{"voiceline":"임무 완료했어, 잊지 말고 보상 수령하러 가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/mission_complete.ogg"},"서약":{"voiceline":"난 서약의 의식도 모르고, 이럴 때 뭘 해야하는지도 몰라... 네, 네가 얘기 꺼냈으니까, 다 너한테 맡길게... 나, 나까지 포함해서. 응, 얘, 얘기 끝났어...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/propose.ogg"},"스킬":{"voiceline":"내가 해결할 거야...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/skill.ogg"},"터치1":{"voiceline":"!? 간지러워, 그만해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/touch.ogg"},"터치2":{"voiceline":"으야앗!!? 너너너너너너 뭐해!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/touch2.ogg"},"입수시":{"voiceline":"나는 카미카제급 구축함 오이테, 오늘 모항에 합류했어. 맡은 일은 알아서 잘 할거야. 다른 일들은 상황 보고 도울게. 음, 얘기 끝났어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/unlock.ogg"},"강화성공":{"voiceline":"… 어쨌든 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/upgrade.ogg"},"vote":null,"승리":{"voiceline":"말했었지, 맡은 일은 잘 할 거라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아가노'] : 내가 엄호해 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301850/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":