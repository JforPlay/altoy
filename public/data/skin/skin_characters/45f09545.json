[{"클뜯 id":905010,"클뜯 함순이 id":90501,"함순이 이름":"장 바르","한글 함순이 + 스킨 이름":"장 바르","영문 함순이 + 스킨 이름":"Jean Bart","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905010/shipyard.png","설명":"리슐리외급 전함 장 바르 ","자기소개":{"voiceline":"전함 장 바르다. 이 이름은 어느 '존경 받았던' 사략선 선장으로부터 유래되었다. ……뭐? 사략선이 뭐냐고? 대의명분을 내세워 합법적인 약탈을 하는 해적이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/profile.ogg"},"메인1":{"voiceline":"전함의 시대는 끝났다고? 훗, 그게 어쨌다는 거냐. 내 시대는 지금부터다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/main1.ogg"},"메인2":{"voiceline":"신앙도 신념도, 입으로만 떠들어 봐야 어차피 단순한 잠꼬대에 불과하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/main2.ogg"},"메인3":{"voiceline":"바보는 언제나 사라지질 않는군… 어째서 보답도 해주지 않는 허상에 기도 따위를 올리는 거냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/main3.ogg"},"전투개시":{"voiceline":"기사도 따위 쓸모없다! 한꺼번에 덤벼라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/battle.ogg"},"상세확인":{"voiceline":"멋대로 남의 속사정을 캐는 녀석은, 주포에 매달려도 불평할 수 없을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/detail.ogg"},"드랍 설명":{"voiceline":"리슐리외급 전함 장 바르","voicelink":null},"의뢰 완료":{"voiceline":"시끄러운 놈들이 돌아왔군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/expedition.ogg"},"실망":{"voiceline":"늑대를 개로 착각하고 있는 것 같군…… 흥, 나중에 물려도 울지 말라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/feeling1.ogg"},"낯섦":{"voiceline":"네 미소는 녀석을 떠올리게 해…… 미워하고 싶어도 미워할 수 없는 그 녀석을","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/feeling2.ogg"},"호감":{"voiceline":"그런 얼굴 하지 마. 네가 배신하지 않는 한, 나도 널 배신하지 않는다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/feeling3.ogg"},"기쁨":{"voiceline":"네가 다치면 다른 녀석들이 시끄러우니까 말이야. …나를 방패 대신 써도 상관없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/feeling4.ogg"},"사랑":{"voiceline":"네 곁에서는 긴장이 풀려버린다…… 여기서 조금, 선잠을 잘테니……………… 떨어지지 말아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"사냥은 끝났나? 내가 거기 있었다면 한순간에 정리했을텐데 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/home.ogg"},"hp 경고":{"voiceline":"겨우 이 정도냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/hp_warning.ogg"},"로그인":{"voiceline":"너…… 보기 보다 바쁜 모양이군. 내가 도울 수 있는 것이 있다면 말이라도 걸어라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/login.ogg"},"실패":{"voiceline":"이 설욕에 얼마만큼의 이자가 붙는지…… 곧 뼈저리게 알게 해주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/lose.ogg"},"우편":{"voiceline":"너에게 온 우편이다. 오는 김에 가져왔다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/mail.ogg"},"임무":{"voiceline":"일은 일이다. 불평해봐야 줄어드는 건 아니겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/mission.ogg"},"임무완료":{"voiceline":"……칫, 형편없는 보수로군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/mission_complete.ogg"},"서약":{"voiceline":"내가 가는 길은 결코 용서받지 못하고, 미래조차 보이지 않는 흙탕길. 그런데도 함께 와 주는 거냐? ……흥, 어처구니없는 바보다. 그 어리석음을 봐서…… 내 목숨으로 보답해 주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/propose.ogg"},"스킬":{"voiceline":"놀이는 여기까지다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/skill.ogg"},"터치1":{"voiceline":"나에게 어리광부리지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/touch.ogg"},"터치2":{"voiceline":"……나중에 후회하지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/touch2.ogg"},"입수시":{"voiceline":"최신예이자 최후의 전함, 장 바르다. 내 항로를 정하는 것은 너인가…… 흥, 역량이 어느 정도인지 지켜보도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/unlock.ogg"},"강화성공":{"voiceline":"괜찮은 것 같군. 시험해 보겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"너희들의 노력은 감동적이었다…… 그러나, 상대를 잘못 고른다면 거기까지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/win_mvp.ogg"},"전투개시_ex":{"voiceline":"비시아 성좌에 영광이 있으라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/battle_ex.ogg"},"상세확인_ex":{"voiceline":"됭케르크나 알제리를 데리고 쇼핑을 하는 취미는 없어. 너도 잘 알지? 반대로 말하면 너와는 함께 해줄 수도 있다는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"시끄러운 녀석들이 돌아왔군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/expedition_ex.ogg"},"사랑_ex":{"voiceline":"……아, 미안. 잠시 졸았네. 너도 잠시 잘래? 무릎을 빌려줄게. ……괜찮아. 항상 같이 있을게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"필요하다면 나도 출격하겠어. 하지만 너의 지휘를 받으면 그럴 기회가 없을 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"가져와라. 도와주도록 하지… 비서함이니 당연한 것 아닌가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"너에게나 나에게나 이정도 보상으로는 부족해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"…나에게 너무 의지해서는 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/touch_ex.ogg"},"터치2_ex":{"voiceline":"……여기가 그렇게 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['리슐리외'] : 기도 그만해——전투 시작했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/couple_encourage1.ogg"},{"voiceline":"['매사추세츠'] : 이번에는 결코 뒤지지 않을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"신형함에게는 지지 않아. 나는 비시아 성좌의 장 바르야. 신성한 아이리스 리브레의 이름을 자랑으로 삼아 절대 물러서지 않겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"리슐리외가 신경 쓰이면 같이 가줄까? 신념은 다르지만 그래도 자매니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/main2_ex.ogg"},"메인3_ex":{"voiceline":"기도는 의미가 없지만, 마음에서 우러나오는 소원은 괜찮아. 사랑하는 이의 평안함을 비는 것——이것이 바로 '인간'의 마음이겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905010/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"MNF","레어도":"SSR","ex_chat_status":1},{"클뜯 id":905011,"클뜯 함순이 id":90501,"함순이 이름":"장 바르","한글 함순이 + 스킨 이름":"자유의 BloodStone","영문 함순이 + 스킨 이름":"Uninhibited Bloodstone","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905011/shipyard.png","설명":"오늘의 주역이라면 이런 구석에서 술을 마시는 녀석을 찾아서는 안된다고——어차피 왔으니 한 잔 할건가?","자기소개":null,"메인1":{"voiceline":"만사 제치고 흥청망청 즐기는 게 소위 말하는 파티라는 거지. 공기가 너무 고귀해서 술도 맛 없어졌다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905011/main1.ogg"},"메인2":{"voiceline":"이 파티의 유일한 장점은 모든 웃음이 진짜라는 거다——칭찬하는 거다. 못 알아듣겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905011/main2.ogg"},"메인3":{"voiceline":"지휘관, 나는 입에 발린 말로 환심같은 건 못 산다…… 됐다. 우리가 하루 이틀 안 것도 아니고. 안 그런가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"다른 사람보다 나는 됭케르크의 이야기를 듣고 싶다. 됭케르크는 듣기도 잘 들어주지만, 자기 이야기도 잘 하거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905011/detail.ogg"},"드랍 설명":{"voiceline":"오늘의 주역이라면 이런 구석에서 술을 마시는 녀석을 찾아서는 안된다고——어차피 왔으니 한 잔 할건가?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료인가? 나도 같이 맞이하러 가지. 마침 바람이 쐬고 싶어졌어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905011/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"나는 번거로운 건 싫다. 그리고 꽃병처럼 서서 구경 당하는 건 더 싫다…… 이 모든 것은 전부 네 녀석 때문이다. 너를 위해서 하는 것은 당연하게 여기게 됐기 때문이야——너는 중죄를 저질렀어. Mon amour……",