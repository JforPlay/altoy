":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"스피드 스타, 전속력으로 폭주! 가자! … 후후, 배시는 전속력 대사를 이미 정해 뒀다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101351/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"아? 응~~? 지휘관, 힘이 없어 보이네? 배시가 두 바퀴 정도 드라이브 시켜줄까~? 히히.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101351/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"히히. 지휘관도 배시의 애마가 멋있다고 생각하지! 부럽지~? 흐흥. 그럼 특별히 구경할 수 있게 허락해줄게! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101351/touch.ogg"},"터치2":{"voiceline":"얻어타는 명목으로 배시한테 손을 대려고 하다니, 지휘관도 정말 최악이잖아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101351/touch2.ogg"},"입수시":{"voiceline":"흐흥, 지휘관 봤지! 이 듬직함, 그리고 이 화려하면서도 패셔너블한 컬러! 마지막으로 배시가 특별 준비한 장비! 후후후… 지금의 배시는 모항의 가장 화려한 스피드 스타라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101351/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"사복","상점 id":70246,"상점 카테고리 id":9,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":101352,"클뜯 함순이 id":10135,"함순이 이름":"배시","한글 함순이 + 스킨 이름":"눈부신 경기장의 별","영문 함순이 + 스킨 이름":"Showy Sports Star","스킨 타입":"Sports Time","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101352/painting.png","확대 일러":"https://raw.githu