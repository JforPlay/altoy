[{"클뜯 id":303190,"클뜯 함순이 id":30319,"함순이 이름":"운젠","한글 함순이 + 스킨 이름":"운젠","영문 함순이 + 스킨 이름":"Unzen","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303190/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303190/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303190/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303190/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303190/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303190/shipyard.png","설명":"중순양함 - 운젠","자기소개":{"voiceline":"제6차 조함 계획으로 태어난 중순양함 운젠이라고 합니다. 속세를 돌아다니는 것은 아직 익숙하지 않아 지휘관님께 여러모로 폐를 끼치게 되겠지만… 이렇게 받아주신 이상 열심히 일… 아니, 모시겠습니다. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/profile.ogg"},"메인1":{"voiceline":"목 마르세요? 차라도 괜찮으시면, 운젠이 바로 가지고…… 상태를 보니 영양 음료를 가져다드리는 편이 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main1.ogg"},"메인2":{"voiceline":"기분 전환 말씀이세요? 잠깐 산책하기엔… 음, 여기서 걸어서 3일 정도 거리에 영험한 봉우리가 하나 있는데…… 너무 멀다고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main2.ogg"},"메인3":{"voiceline":"봉인뿐만 아니라 풍수지리에 관해서도 다소 아는 바가 있습니다만… 뭐, 이 모항에는 운젠 말고도 박식한 사람이 있으니, 굳이 운젠의 지혜를 빌릴 필요는 없으시겠…죠. (힐끔)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main3.ogg"},"전투개시":{"voiceline":"악을 소탕하고, 푸른 바다에 청정을 가져다주리라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/battle.ogg"},"상세확인":{"voiceline":"아, 운젠의 건강 상태라면 괜찮답니다. 본래부터 방랑에 익숙한 몸, 며칠 정도는 마시지 않고 먹지 않아도…… 그러면 동료들이 걱정한다고요? 그렇군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 - 운젠","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔군요. 어떤 이야기를 가지고 왔을지 기대되네요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/expedition.ogg"},"실망":{"voiceline":"이렇게나 의롭지 못한 자는 본래 사살하는 것도 고려함직한데… 농담입니다. 정신 차리시길, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/feeling1.ogg"},"낯섦":{"voiceline":"늘 지휘관님께 신세만 지고 있으니, 전투나 잡무, 신변에 관한 일은 뭐든…… 운젠에게 해 주었으면 하는 것이 있다면 무엇이든 말씀해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/feeling2.ogg"},"호감":{"voiceline":"운젠이 무얼 원하는지 알고 싶다…고요? 그건…… 음…… 딱히 생각나는 건 없는데, 그렇다고 아무런 욕심 없는 사람으로 여겨지는 건 싫고… 어쩌지… 이거 고민되네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님. 얼마 전에 물어보신, 제가 원하는 게 뭔지 생각났어요. 생각해 보니 운젠, 누군가에게 속박된 적이 한 번도 없었답니다. 그래서 말인데…… 어머, 지휘관님? 왜 그러시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/feeling4.ogg"},"사랑":{"voiceline":"지휘관님을 당혹스럽게 만든 모양이군요. 그렇지만 그 상대가 지휘관님이라면 운젠은 별로 상관없습니다만…… 아, 혹시 지휘관님은 그게 아니라, 다른 취미라도 가지고 계신 건가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/feeling5.ogg"},"터치3":{"voiceline":"어머, 이건…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 일단 따뜻한 물로 목욕을 하시는 건 어떤지요? 전장의 냄새를 몸에 두른 채로 동료들을 만나기는 꺼려지실 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/home.ogg"},"hp 경고":{"voiceline":"지휘관님께 폐를 끼칠 수는 없어요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님? 저보다 먼저 도착하셨군요. …명색이 비서함이라는 자가 이렇게 늦다니, 면목 없습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/login.ogg"},"실패":{"voiceline":"이건… 제 수행이 부족한 탓이군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/lose.ogg"},"우편":{"voiceline":"우편이 도착한 듯하네요. 지휘관님, 적어도 한번은 읽고 나서 우편함에 다시 넣는 편이 좋을 것 같습니다만?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/mail.ogg"},"임무":{"voiceline":"임무가 밀린 것 같네요. 후후후, 마감 직전까지 손을 대지 않는 것… 사람이라면 누구나 그럴 수 있지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/mission.ogg"},"임무완료":{"voiceline":"확인하지 않은 임무 보상이 있는 모양이네요. 후후후, 좋아요. 굳이 받지 않고 바라보기만 해도 좋은 안줏거리가 되겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/mission_complete.ogg"},"서약":{"voiceline":"혼약을 제의해 주셔서 진심으로 영광스럽게 생각합니다. 부족한 몸이지만 모쪼록 잘 부탁드립니다. ……후후후, 이거 신부 수업도 해야겠네요. 그렇죠? 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/propose.ogg"},"스킬":{"voiceline":"이 천지가 스러질 때까지, 영원토록 모든 죄악과 더러움을 물리치리라……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/skill.ogg"},"터치1":{"voiceline":"운젠이라도 괜찮으시면, 뭐든 말씀해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/touch.ogg"},"터치2":{"voiceline":"이런 부류의 수행도 분명… 지휘관님, 운젠을 상대로 시도해 보시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/touch2.ogg"},"입수시":{"voiceline":"사소한 인연이 이렇게 결실을 맺는군요. …중순양함 운젠, 지휘관님 곁에서 잠시 신세를 지게 되었습니다. 아, 장차 지휘관님 곁을 떠나겠다는 뜻이 아니라, 때때로 사적인 용무로 휴가를 얻을 수도 있다는 의미랍니다. 후후후, 저는 구름처럼 떠도는 것을 좋아하는지라…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/unlock.ogg"},"강화성공":{"voiceline":"강해졌네요, 후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/upgrade.ogg"},"vote":null,"승리":{"voiceline":"\"육갑현성, 신기개문\". 구름을 뚫고 솟은 산과 같은 승리를…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관님, 운젠이 적을 토벌해 드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/battle_ex.ogg"},"상세확인_ex":{"voiceline":"냠냠… 지휘관님, 왜 그러시나요? 운젠은 의외로 잘 먹는다…구요? 구름이든 오곡이든 낭비하지 않는 것이 제 원칙이라서요. 지휘관님을 위해 만든 것이니 더더욱 그렇고요. 우후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님, 이 다음 예정은… 아, 몇 주씩이나 끌고 다닐 생각은 없어요. 하루 이틀… 아니! 단 몇 시간이라도 괜찮으시면 '데이트' 신청을 해도… 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"휴우…… 마치 극락에 있는 것 같은 기분이네요. 아, 지휘관님. 출격하느라 수고 많으셨습니다. 이거, 큰 실례를 범했네요. 운젠도 지금 막 들어온 참이니, 혹시 괜찮으시다면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어머, 지휘관님? 운젠과 동시에 집무실에 도착하다니 이런 우연이 다 있네요. 후후후, 농담이에요. 방에서 나온 순간부터 함께인 걸요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관님께 도움이 되는 운젠은 착한 아이죠? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/touch_ex.ogg"},"터치2_ex":{"voiceline":"원하신다면 어쩔 수 없지요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"만만치 않은 적이었다…고 하면 거짓말이겠죠. 지휘관님 덕분에 쉽게 이길 수 있었답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":{"voiceline":"여동생 쪽 여우님의 질문 공세 말씀인가요? ...대처법을 모르면 확실히 성가실 수 있죠. 지휘관님, 그럴 때는 대답하지 않는 것도 하나의 선택지랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"하아… 오늘은 좀처럼 진척이 안 되네요… 나중에 정력을 불어넣어 줄 수 있는 식사를 준비하는 편이 좋겠어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main6_ex.ogg"},"메인7_ex":{"voiceline":"기분 전환을 하고 싶으시다구요? 네, 그럼… 지휘관님, 운젠과 단둘이서 있을 수 있는, 그리 멀지 않은 곳. 그런 곳으로 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main7_ex.ogg"},"메인8_ex":{"voiceline":"잠시 떨어져도 다시 재회하고, 예기치 않게도 굳게 맺어져 가는… 운젠과 지휘관님의 인연은 그런 것이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"가끔은 일이나 인간관계에서 벗어나는 것도 하나의 선택이 될 수 있어요. 세속을 등지라는 말은 아니지만, 조금은 신선의 마음가짐을 배워 보시는 건 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"얼마 전 만든 과자를 용신님께 공양하니 마음에 차지 않으셨던 모양이에요… 하아… 아무 맛이 안 난다고 하셔도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main9_ex.ogg"},"메인10_ex":{"voiceline":"운젠뿐만 아니라 다른 아이들과도 관계를…… 후후후, 괜찮아요. 지휘관님은 그런 존재인걸요. 안 그래요?♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303190/main10_ex.ogg"},"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"UR","ex_chat_status":1},{"클뜯 id":303191,"클뜯 함순이 id":30319,"함순이 이름":"운젠","한글 함순이 + 스킨 이름":"푸른 바다의 물놀이","영문 함순이 + 스킨 이름":"Sojourn Through Clear Seas","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303191/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303191/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303191/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303191/icon.png","쥬스타 아