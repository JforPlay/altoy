[{"클뜯 id":9600140,"클뜯 함순이 id":960014,"함순이 이름":"펄","한글 함순이 + 스킨 이름":"펄","영문 함순이 + 스킨 이름":"Pearl","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600140/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600140/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600140/shipyard.png","설명":"범선 - 펄","자기소개":{"voiceline":"처음 뵙겠습니다. 펄이라고 해요. 이 만남이 지휘관님의 고통을 씻어주길 바라요. 지휘관님, 지금부터는 저와 함께 걸어가요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/profile.ogg"},"메인1":{"voiceline":"지휘관님, 제 컬렉션 진열장 보셨나요? 가운데 있는 콩크 진주 예쁘죠? 네, 힘들게 손에 넣은 희귀품이랍니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/main1.ogg"},"메인2":{"voiceline":"……「천사」요? 확실히 그렇게 불리고는 해요… 하지만 지휘관님께서 그렇게 부르시니… 뭔가 묘한 느낌이네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/main2.ogg"},"메인3":{"voiceline":"진주 목걸이, 그리고 이 보석 세공은 모두 직접 만든 거랍니다. 어쩌면… 지휘관님 마음에 드는 게 있을지도 몰라요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/main3.ogg"},"전투개시":{"voiceline":"항복하세요. 여신님께서 당신들을 용서해 주실 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/battle.ogg"},"상세확인":{"voiceline":"선과 악, 진실과 거짓… 우리는 혼돈으로 가득한 세상에 살고 있죠. 자기 자신도 잘 모르는데, 어떻게 타인에게 무언가를 요구할 수 있을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 펄","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 함대가 큰 수확을 거두고 돌아왔어요. 다들 무사했으면 좋겠네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/expedition.ogg"},"실망":{"voiceline":"……아아, 지휘관님의 그런 모습을 보니, 눈물이 저절로 흘러내려요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/feeling1.ogg"},"낯섦":{"voiceline":"승리는 상대를 상처 입혀서 얻는 게 아니에요. 지혜와 배려로 서로의 긍지를 지킬 수 있는 길을 택하면… 다정함으로 감싸인 승리에 도달할 수 있을지도 몰라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 이 진주들… 꼭 자그마한 달님 같지 않은가요? 모두 당신께 드릴게요~♪ 달빛 대신 지휘관님의 평온한 밤을 지켜주길 바라며……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 저…… 당신의 세상에 발을 들여보고 싶어요. 사람 사이에는 벽이 없다고 전 믿어요. 당신만 받아들여 주신다면, 저는…… 당신과 함께…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/feeling4.ogg"},"사랑":{"voiceline":"사랑이란 사심을 버리고 모두를 평등하고 다정하게 대하는 거라고 생각했어요. 하지만…… 누군가 한 사람에게만 마음을 뺏겨버리는 일도 있죠. 그렇지 않나요~? 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/feeling5.ogg"},"터치3":{"voiceline":"이건…… 지휘관님의 자상함이로군요. 우후후, 즐기고 있답니다~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/headtouch.ogg"},"모항귀환":{"voiceline":"무사히 돌아오셨군요. 자, 손을 내밀어 주세요…… 펄이 이렇게 지휘관님을 지탱하고 있다는 거, 잊지 마세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/home.ogg"},"hp 경고":{"voiceline":"무기를 버리세요. 마지막 경고입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/hp_warning.ogg"},"로그인":{"voiceline":"달빛과 진주의 축복이 있기를. 이 고요함이 당신의 불안감을 말끔히 지워주길 바랄게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/login.ogg"},"실패":{"voiceline":"저는 계속 싸울 거예요. 모든 동료가 무사히 퇴각할 때까지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/lose.ogg"},"우편":{"voiceline":"지휘관님, 새로운 우편이 도착했어요. 확인하러 가시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/mail.ogg"},"임무":{"voiceline":"지휘관님, 임무가 많아서 힘드실 것 같아요. 제가 도와드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/mission.ogg"},"임무완료":{"voiceline":"임무 보상으로 뭐가 왔을까요……? 진귀한 보석 같은 것도 있을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/mission_complete.ogg"},"서약":{"voiceline":"이건…… 사랑을 구현한 것…인가요? 이걸 보니 제 주변 모든 것이 빛이 바랜 것처럼 보여요. 소중히 간직하고 지키며, 늘 빛나도록 계속 사랑할게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/propose.ogg"},"스킬":{"voiceline":"부디 다정한 빛이 세상의 고통을 치유하길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/skill.ogg"},"터치1":{"voiceline":"지휘관님의 손바닥… 정말 따뜻해요. 닿을 때마다 제 날개에 특별한 힘이 깃드는 것 같아요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/touch.ogg"},"터치2":{"voiceline":"이건…… 지휘관님 나름의 감정 표현 방식인가요? 이런 방식으로도 전할 수 있다니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/touch2.ogg"},"입수시":{"voiceline":"이 진주의 바다에서 만나다니, 우리는 꽤 인연이 깊은 모양이에요. 저는 펄이라고 해요. 당신께 희망과 순결이 늘 함께하길……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/unlock.ogg"},"강화성공":{"voiceline":"다정함과 강인함… 이는 모순일까요? 아니면 떼려야 뗄 수 없는 관계일까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이것도 구원이라 할 수 있을까요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"음…… 지금 영감이 잘 안 떠올라서 그런데… 지휘관님, 같이 바닷가에 가서 기분 전환이라도 할까요? 파도와 함께 살랑살랑하고 마음을 흔들어 보는 거예요～","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"진주는 바다의 눈물이자, 다정함의 결정이죠. 어떤 어려움이 닥쳐도… 제가 지휘관님을 다정하게 지켜드릴게요. 언제까지나… 영원히～","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"지휘관님, 제 귀에 달린 날개… 마음에 드시나요? 이것도 제 손으로 만든 거예요～♪ 푹신푹신해서, 추울 땐 귀를 덮으면 따뜻해져요～","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어서 오세요, 그리고 수고 많으셨어요～ 자, 제 곁으로 오세요♪ 네, 제 허벅지에 기대서 쉬셔도 좋아요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"업무가 끝나면… 같이 「수공예」라도 해볼까요? 네… 지휘관님께 딱 어울리는 진주를 찾아서, 반지를 두 개 만들어볼까 해서요…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"후후, 간지러워요～♪ 지휘관님, 오늘따라 좀 들떠 있으시네요… 제 날개에 꼭 안기고 싶으신가요～?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/touch_ex.ogg"},"터치2_ex":{"voiceline":"으, 으으…… 그 진주 끈은 지휘관님의 장난감이 아니예요…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관님께만 살짝 알려드릴게요… 사실 제가 흘린 눈물은 진주가 된답니다. 여신님의 축복이라던데… 조금 부끄러워요…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/main5_ex.ogg"},"메인6_ex":{"voiceline":"옳은 일을 하려면 정말 큰 용기가 필요해요…… 언제쯤이면 지휘관님처럼 강하고 다정해질 수 있을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600140/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님, 무슨 생각 중이세요? 어떤 고민이든 제가 다 들어드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/Azu