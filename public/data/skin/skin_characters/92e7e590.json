[{"클뜯 id":501060,"클뜯 함순이 id":50106,"함순이 이름":"후번","한글 함순이 + 스킨 이름":"후번","영문 함순이 + 스킨 이름":"Hu Pen","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501060/shipyard.png","설명":"불칸 슈테틴 1000톤급 뇌장 구축함—후번","자기소개":{"voiceline":"나는 후번! 이스트 글림에 소속된 롱우급 구축함이야! 아무리 사소한 일이라도 뭐든 이 호랑이에게 맡겨줘! ……에헤헤~ 어때? 호랑이다운 기세가 느껴졌어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/profile.ogg"},"메인1":{"voiceline":"어흥! 호랑이가 울면 온 산림이 진동하지! ……응? 호랑이스럽지도 않고, 여긴 대나무숲이라고? 괜찮아! 그런 분위기만 낼 수 있으면 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/main1.ogg"},"메인2":{"voiceline":"롱우 언니는 너무 요리에만 푹 빠져있다니깐~ 후번도 주방에 도와주러… 가만히 있는 게 도와주는 거라고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/main2.ogg"},"메인3":{"voiceline":"아무튼! 롱우 언니를 도와서 오늘 일을 빨리 마무리하고 같이 놀러 나갈 거야! 지휘관도 도와줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/main3.ogg"},"전투개시":{"voiceline":"후번이 앞에서 길을 뚫을게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/battle.ogg"},"상세확인":{"voiceline":"슈퍼 냥냥펀치, 준비 완료! 뭐? 그건 누가 이미 쓰고 있는 거라고? 이 호랑이랑 센스가 비슷한 사람이 있다니…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/detail.ogg"},"드랍 설명":{"voiceline":"불칸 슈테틴 1000톤급 뇌장 구축함—후번","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 돌아왔어! 주방에 알려주고 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/expedition.ogg"},"실망":{"voiceline":"흥! 딱히 기분 상한 거 아니거든? 진짜 아니야! …응? 호랑이 인형을 준다고? 신난다! 고마워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 들었어? 집무실 열쇠의 주형이 공공연하게 유통되고 있대! 사실은 최근에 나도 모르게 그걸…… 읍읍…! 낮말은 새가 듣고, 밤말은 쥐가 듣는다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/feeling2.ogg"},"호감":{"voiceline":"후후후, 호랑이는 소문이라면 꽤 알고 있다구~ 뭐 궁금한 소문 있어? 후번이 주방을 엉망으로 만든 사건부터? 알았어! ……응? 으아아아앗?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/feeling3.ogg"},"기쁨":{"voiceline":"모항에는 똑똑한 애들이 많이 있으니까 배우라고? 그래도 상관없지만, 호랑이는 호랑이인 채로 있고 싶은걸… 헤헷, 지휘관은 응원해 줄 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/feeling4.ogg"},"사랑":{"voiceline":"모항의 똑똑한 아이들…… 호랑이도 거기 포함되는 거 맞지? 지휘관, 항상 응원해 줘서 고마워! 후번, 앞으로도 열심히 할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/feeling5.ogg"},"터치3":{"voiceline":"호랑이의 머리를 쓰다듬으면 복이 온대! 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와! 오로지 지휘관을 위해서 후번이 직접 만든 요리… 어서 먹어봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/home.ogg"},"hp 경고":{"voiceline":"이, 이건 사고야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/hp_warning.ogg"},"로그인":{"voiceline":"살금살금살금…… 으아앗?! 지, 지휘관… 좋은 아침이야! 미리 말해두지만 호랑이는 늦잠 잔 거 아니라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/login.ogg"},"실패":{"voiceline":"미안… 실수했어…… 데헷☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/lose.ogg"},"우편":{"voiceline":"지휘관한테 우편이 왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/mail.ogg"},"임무":{"voiceline":"뭐든 느릿느릿 하는 건 호랑이답지 않아! 그러니까 임무 할 때도 그러면 안 돼! 제때 완수할 수 있도록 주의해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 왔어! 어서 확인하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/mission_complete.ogg"},"서약":{"voiceline":"에헤헤, 호랑이도 지휘관이 늘 도와주는 거 알아! 차분히 여러 번 가르쳐주는 것도 지휘관뿐이고… 호랑이도 지휘관을 둘도 없이 소중한 사람으로 여기고 있다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/propose.ogg"},"스킬":{"voiceline":"호랑이 펀치!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/skill.ogg"},"터치1":{"voiceline":"저, 저기… 깜빡 졸은 건 롱우 언니한테는 비밀로 해줘! 말 안한다고? 다행이다! 지휘관이 최고야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/touch.ogg"},"터치2":{"voiceline":"으아! …으아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/touch2.ogg"},"입수시":{"voiceline":"좋은 아침이야~ 지휘관~! 이스트 글림 소속인 후번이야! 아야얏…! 발끝을 어디 부딪쳤나 봐……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/unlock.ogg"},"강화성공":{"voiceline":"위풍범범이닷! 어흥~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"호랑이는 강해! 응!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"슈퍼 냥냥펀치 1호, 준비 완료! 뭐? 2호는 어딨냐고? 에헤헤, 호랑이는 그런 거 몰라~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501060/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"모항의 똑똑한 애들…… 호랑이도 그 중 하나지! ……그래도 여러 가지를 배웠으면 한다고? 에헤헤, 그럼 지휘관. 앞으로 계속 계~속 잘 부탁해!","voicelink":"https://raw.gith