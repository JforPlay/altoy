[{"클뜯 id":107080,"클뜯 함순이 id":10708,"함순이 이름":"와스프","한글 함순이 + 스킨 이름":"와스프","영문 함순이 + 스킨 이름":"Wasp","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107080/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107080/shipyard.png","설명":"와스프급 항공 모함 와스프 (CV-7)","자기소개":{"voiceline":"와스프급 항공모함의 외동딸, 와스프다! 그래, 대서양에서 임무를 수행한 뒤, 로열 네이비의 지원 임무도 참여했었지. 태평양 쪽의 전황이 긴박해져서 요크타운 쪽으로 지원도 갔었지만, 뭐 그다지 도움이 되진 않았어. 어뢰에는 꽤 애를 먹어서 말이야, 하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/profile.ogg"},"메인1":{"voiceline":"지휘관, 어디 보고 있는 거야. 위라고. …읏차, 실내 클라이밍도 꽤 재미있네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/main1.ogg"},"메인2":{"voiceline":"사쿠라 엠파이어의 '궁도'라는 녀석은 우리 쪽의 양궁과 전혀 다르다고 들었어. 기회가 있으면 한번 보고 싶네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/main2.ogg"},"메인3":{"voiceline":"지휘관, 도울 일 없으면 나 나갈 거다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/main3.ogg"},"전투개시":{"voiceline":"와스프류의 전투를 보여 주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/battle.ogg"},"상세확인":{"voiceline":"림… 캠… 스트링……응? 무슨 일이야? 지금 이 녀석의 손질을 하고 있거든, 적당히 있다 가라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/detail.ogg"},"드랍 설명":{"voiceline":"와스프급 항공 모함 와스프 (CV-7)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔구나. 좋겠다~ 나도 바다로 나가고 싶어~ 있잖아~ 지~휘~관~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/expedition.ogg"},"실망":{"voiceline":"화살에 맞고 싶지 않다면 접근하지 않는 편이 좋을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/feeling1.ogg"},"낯섦":{"voiceline":"태어났을 당시에는 컴파운드 보우가 없었다? 정말이지…지휘관, 생각이 구식이네! 이런 건 흐름을 파악하지 않으면 안 된다고. 원래 컴파운드 보우의 프로토타입은 그 대전 이전부터 있었는걸? 알겠어? 옛날에는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/feeling2.ogg"},"호감":{"voiceline":"이 야심한 밤, 옥상에 있는 것은 누구냐고? 아아, 그건 내가 트레이닝을 하고 있던 거야. …뭐 밤은 괜찮아, 방해할 사람도 없고 밤하늘도 예쁘지. 지휘관도 한 번 오면 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 양궁 가르쳐 줄까? 밤에 함께 트레이닝하다가 피곤해지면 별도 보고 말이야. 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/feeling4.ogg"},"사랑":{"voiceline":"활 기술과 전투, 그리고 함께 별을 바라본 밤하늘… 나에게는 이게 전부야. 지휘관, 내 전부를 받아 주겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 어때? 역시 바깥이 상쾌하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 다음에 들어올 땐 노크 좀 하라고. 오발사격하지 않는다는 보장은 못 하니까 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/login.ogg"},"실패":{"voiceline":"큭……오늘 별로 몸 상태가 좋지 않네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/lose.ogg"},"우편":{"voiceline":"지휘관, 우편을 화살에 매달아서 그쪽으로 쐈는데…봤어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무야. 출격이든 심부름이든 맡겨만 줘!……사무 업무는 좀 봐달라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/mission.ogg"},"임무완료":{"voiceline":"지휘관, 보너스 가져가. 이 정도 중량이면 화살에 매달 수 없다고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/mission_complete.ogg"},"서약":{"voiceline":"이게 지휘관의 대답이야? …헤헤, 기뻐! 그럼… \"내 모든 것을 그대에게 바칩니다. 지휘관님\" …앗차 부끄러워… 그, 그런데 지금 거 이상하진 않았지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/propose.ogg"},"스킬":{"voiceline":"말벌은 침을 한 번밖에 쏘지 못한다 하지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/skill.ogg"},"터치1":{"voiceline":"지퍼? 아아, 신경 쓰지 마, 이렇게 해놓는 것이 움직이기 쉬우니까 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/touch.ogg"},"터치2":{"voiceline":"지휘관, 어딜 맞기 싫은지 말해줄래? 거기는 피해서 쏴줄 테니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/touch2.ogg"},"입수시":{"voiceline":"응? 네가 그 지휘관인가 뭔가인가? 흠… 뭐 그쪽 함대에서 내가 활약할 수 있을 것 같다면, 참가해줄 수도 있지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/unlock.ogg"},"강화성공":{"voiceline":"그래, 몸은 강해졌지만, 이 녀석도 조정하지 않으면 안 되겠네","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후훗, 우리 애들이 좀 쎄지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0}]