io/voiceline/718012/main1.ogg"},"메인2":{"voiceline":"왜 하필이면 이런 동물인지…… 그나저나 지휘관 동지는 아침에 갓 짠 우유를 마시는 타입이야? …아니, 아무것도 아니야///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718012/main2.ogg"},"메인3":{"voiceline":"이 복장을 다른 동료에게도 권하는 게 어떠냐고? 확실히… 다들 이런 옷을 입고 있으면 상대적으로 나한테도 위장 효과가 있을 것 같…… 뭐라고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718012/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"음… 슬슬 동료들과 정기 연락을 할 시간인 것 같네. 오늘의 연락 사항과 의제는… 음… 「모항 행사 준비」와… 「의상 확인」?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718012/detail.ogg"},"드랍 설명":{"voiceline":"특별한 동물 옷이라길래… 그냥 인형 옷 같은 건 줄 알았는데, 설마 이런 차림일 줄은……! 거, 걱정 마! 지휘관 동지! 노스 유니온의 요원에게 이 정도쯤은 아무것도 아니니까…!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관 동지를 믿지만, 이런 상황에서는 도무지 마음이 놓이질 않네. 뭐라도 주의를 분산시킬 게 있으면… 아, 그렇지! 어차피 이렇게 꾸민 김에 아예 캐릭터에 몰입해 버리면…… 지휘관 동지, 자, 잠깐만 협조해 줄 수 있을까?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718012/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"꺅?! 뒤, 뒤에서 인사하면 위험하지 않냐고…? 그, 그게…… 이번엔 상황이 좀 다르니까……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지, 지휘관 동지, 기다리고 있었어. 아니… 이건 그… 지휘관 동지를 어떻게 하기 위한 장비가 아니라…… 아무튼 그래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718012/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관 동지, 뭐, 뭘 하려는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718012/touch.ogg"},"터치2":{"voiceline":"뭔가 찌릿찌릿하면서도… 안달이 나는 듯한……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718012/touch2.ogg"},"입수시":{"voiceline":"특별한 동물 옷이라길래… 그냥 인형 옷 같은 건 줄 알았는데, 설마 이런 차림일 줄은……! 거, 걱정 마! 지휘관 동지! 노스 유니온의 요원에게 이 정도쯤은 아무것도 