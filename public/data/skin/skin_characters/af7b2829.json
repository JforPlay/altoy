[{"클뜯 id":718010,"클뜯 함순이 id":71801,"함순이 이름":"크론시타트","한글 함순이 + 스킨 이름":"크론시타트","영문 함순이 + 스킨 이름":"Kronshtadt","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718010/shipyard.png","설명":"69형 순양함—크론시타트","자기소개":{"voiceline":"69계획 순양함인 크론시타트야. 전투에서 승리하려면 그저 무작정 싸우기만 할 게 아니라, 착실하게 정보를 모아 물밑 작업을 펼쳐야 해. 흐음, 내 힘을, 그리고 내 동지들의 힘을 얕잡아 보면 곤란해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/profile.ogg"},"메인1":{"voiceline":"지휘관 동지, 오늘 업무는 편지지에 적어서 책상 위에 올려 뒀어. 뭐? 뭐라고 써 있는지 못 읽겠다고? 그, 그럼 설명해줄게……. 음, 이건…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/main1.ogg"},"메인2":{"voiceline":"항상 어떤 동료랑 연락하는지 궁금하다고? 흐음, 초조해 하지 마. 곧 알게 될 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/main2.ogg"},"메인3":{"voiceline":"한 번에 설명 가능하다면 두 번은 말 안 해. 반복 설명은 정보 유출로 이어질 우려가…… 뭐? 방금 한 말을 이해 못 했다고? 자, 우선은…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/main3.ogg"},"전투개시":{"voiceline":"동지들이여, 승리를 위해 소리 높여 진격하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/battle.ogg"},"상세확인":{"voiceline":"시간이 됐나? 슬슬 동지에게 정시 연락이 올 때니까 주파수를……. 응? 안 움직여……. 지휘관 동지, 들어오기 전에는 문을 노크하는게 예의 아닐까? 노크했었다고? 아, 그, 그래……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/detail.ogg"},"드랍 설명":{"voiceline":"69형 순양함—크론시타트","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 귀환한 건가. 내가 얻은 정보랑 일치하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/expedition.ogg"},"실망":{"voiceline":"지휘관 동지, 내 신뢰를 얻기엔 노력이 아직 좀 부족한 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/feeling1.ogg"},"낯섦":{"voiceline":"사실은 모항에 부임하자마자, 지휘관 동지의 신원을 조사해봤어. ……흐음, 뭐, 당신과 이렇게 이야기를 나누고 있고, 게다가 \"동지\"라고까지 부르고 있으니, 결과가 어땠는지는 굳이 말하지 않아도 알겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/feeling2.ogg"},"호감":{"voiceline":"혼자서 할 수 있는 일에는 한계가 있지. 흐음, 내가 이렇게까지 할 수 있는 건 다 \"동료\" 덕분……. 지휘관 동지도 혼자 해내기 어려우면 언제든 \"동료\"인 날 의지해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 동지처럼 신뢰할 가치가 있는 상대에게는 정보 이외에도 줄 수 있는 게 있어. …흐음, 일단 받으면 동지의 신변에 위험을 끼칠 수도 있는 물건이긴 한데, 받을 각오는 되어 있으려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/feeling4.ogg"},"사랑":{"voiceline":"흐음, 지휘관 동지도 알다시피 우리 관계는 이미 \"신뢰\"에만 머물러 있지는 않아. 그러니까 이걸 줄게…. 크흠, 신뢰보다도 뜨겁고, 고귀하고, 넘쳐흐르는, 의심할 여지 없는 내 \"사랑\"을! ……우, 웃을 타이밍이 아닌데?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/feeling5.ogg"},"터치3":{"voiceline":"지휘관 동지, 무슨 짓을……. 위로의 스킨십? 흐, 흠… 상당히 심플한 방법이네. 다음부터는 나도 그렇게 할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/headtouch.ogg"},"모항귀환":{"voiceline":"…! 지휘관 동지였구나. 흐음, 내 뒤에서 갑자기 다가오는 건 위험하니 적어도 미리 말이라도 하는 게 신상에 이로울 텐데……. 따, 딱히 놀란 건 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/home.ogg"},"hp 경고":{"voiceline":"당황하지 마! 지금은 냉정하게, 냉정하게……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이야, 지휘관 동지. 시간을 지키는 사람이라면 늘 환영이야. 윽, 아직 근무 시간이 아니라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/login.ogg"},"실패":{"voiceline":"나 때문에 모두가 위기에……! 으윽, 깊이 반성하고 있다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/lose.ogg"},"우편":{"voiceline":"새로운 메시지가 왔네……. 기밀 정보라면 확인한 후의 처분은 내게 맡겨줘. 흐음, 아무런 흔적도 남지 않도록 해줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/mail.ogg"},"임무":{"voiceline":"임무 리스트 다 만들었어. 자, 지휘관 동지. 임무가 완료되면 이 앞에 표시하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/mission.ogg"},"임무완료":{"voiceline":"임무 수행 중인 지휘관 동지, 꽤 능숙해 보이는걸. …이, 임무는 아까 이미 완료했다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/mission_complete.ogg"},"서약":{"voiceline":"맹세? 의식? 흐음, 긴 시간을 낭비할 필요는 없어. 반지도 끼었으니 할 일은 단 하나뿐. 자, 지휘관 동지, 눈을 감아. 그리고 지금부터 일어나는 일을 가슴에 새겨두도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/propose.ogg"},"스킬":{"voiceline":"여기가 약점이군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/skill.ogg"},"터치1":{"voiceline":"지휘관 동지, 도와줄 일 있으면 뭐든 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/touch.ogg"},"터치2":{"voiceline":"흐음, 지휘관 동지라고 봐줄 수는… 당장 그만둬!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/touch2.ogg"},"입수시":{"voiceline":"노스 유니온 소속 대형순양함인 크론시타트야. 흐음, 내 진가는 화력뿐만이 아니야……. 함께 싸우다 보면 몸소 깨닫게 되겠지, 지휘관 동지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/unlock.ogg"},"강화성공":{"voiceline":"흐음, 더 강한 화력을 마다할 자는 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흐음, 승리는 단 한 번의 우연이 아니라 축적한 경험에 따른 필연적인 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"정기 연락 종료, 흠, 오늘도 많은 정보를 수집했어. 안심해, 지휘관 동지가 필요로 하는 건 내가 직접 가져다 줄거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관 동지, 이 통신기 네게 줄게. 내가 오직 우리 둘만 아는 절대 안전한 비밀 채널을 설정해뒀어. 내가 없을 때, 도움을 원하든, 데이트든, 아니면 단순히 내가 보고 싶을 때도 이걸로 연락하면 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관 동지? 아, 미리 말해주려 했다고… 괜찮아, 이미 너의 기운에 익숙해졌으니까. 그럴게 걱정할 필요 없어. 아마도. 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"드디어 왔군, 지휘관 동지. 오래 기다렸어… 왜, 왜 여기서 기다리냐고…? 왜냐면 여기는 아무도 보지 못하니까, 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/login_ex.ogg"},"실패_ex":{"voiceline":"음, 기척을 너무 심하게 냈나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/lose_ex.ogg"},"우편_ex":null,"임무_ex":{"voiceline":"임무 정보 수집 완료했어. 한바탕 해보자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 종료야. 수고했어~ 지휘관 동지가 일할 때의 모습을 보는 건 정말 즐겁다니까~ 하하","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"너, 너 뻔뻔하기가 나보다 더 심하잖아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"흠, 이번 승리는 절대 우연이 아니야. 지휘관 동지가 가져온 필연이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['됭케르크', '콘고', '히에이', '하루나', '키리시마', '샤른호르스트', '그나이제나우'] : 내 화력은 누구에게도 지지 않아! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/couple_encourage1.ogg"},{"voiceline":"['키로프'] : 비밀공작이라면 내게 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/couple_encourage2.ogg"}],"메인4":{"voiceline":"통신기가 이상해… 이대로는 동지들과 연락할 수가… 쳇, 역시 무력행사 말곤 답이 없나……. 여, 연기가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"내 글씨를 알아보기 어렵다고?… 흠, 지휘관도 못 알아본다면, 보안성이 강하다는 뜻이겠지, 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/main6_ex.ogg"},"메인7_ex":{"voiceline":"고마워, 러시아. 이 나사만 돌리면…… 그 나사 어디서 난 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/main7_ex.ogg"},"메인8_ex":{"voiceline":"동행? 음, 인정하고 싶지는 않다만, 이 모항에 나보다 잠입 임무에 더 능한 친구들이 몇 있는 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"잠입 임무에 중요한 건 흔적을 남기지 않는 것. 즉, 요란하게 주포를 날리기 전에 더 요란한 소동을 일으켜서……. 아니라고? 뭐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/718010/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"UR","ex_chat_status":1},{"클뜯 id":718011,"클뜯 함순이 id":71801,"함순이 이름":"크론시타트","한글 함순이 + 스킨 이름":"돌입 개시!","영문 함순이 + 스킨 이름":"Begin the Rush!","스킨 타입":"Special Exercise","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/718011/chibi.png","아이콘 일러