main/audio/voiceline/11100010/main5_ex.ogg"},"메인6_ex":{"voiceline":"좋아! 오늘은 여길 청소해 줄게~! 페케, 앞치마로 갈아입을 거야! 아니, 그렇다고 앞치마로만 변하면 어떻게 해~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100010/main6_ex.ogg"},"메인7_ex":{"voiceline":"뭐?! 새러토가는 마법소녀라고?! 그런데 드라마에 출연한 적이 없다니 너무 아깝잖아~! 나랑 지휘관이 새러토가를 드라마의 여주인공으로 만들어주자~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100010/main7_ex.ogg"},"메인8_ex":{"voiceline":"다음에 같이 모항에서 여기저기 놀러 가자!! 이것저것 많이 구경하고 싶어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100010/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":111,"레어도":"SSR","ex_chat_status":1},{"클뜯 id":11100011,"클뜯 함순이 id":1110001,"함순이 이름":"라라 사타린 데빌룩","한글 함순이 + 스킨 이름":"사로잡힌 공주님","영문 함순이 + 스킨 이름":"A Princess Imprisoned","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100011/shipyard.png","설명":"「고고 바큠 군」이 좀 고장 났어. 에헤헤~ 금방 고칠 수 있으니까 걱정하지 마!","자기소개":null,"메인1":{"voiceline":"꼬, 꼬리는 안 돼… 힘이 안 들어가… 으아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/main1.ogg"},"메인2":{"voiceline":"페케가 충전 중일 때는 평범한 옷도 입지만, 그래도 페케를 입는 쪽이 더 편해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/main2.ogg"},"메인3":{"voiceline":"음~ 이대로 있으면 안 되겠지? 아드미랄 나히모프랑 잉그레이엄한테 부탁해 봐야겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"여기는 모항에서 내가 머무르는 방이야~! 조금 지저분하지만… 이건 수리 중인 거고, 저건 개발 중인 거야. 지휘관도 놀러 와도 돼~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/detail.ogg"},"드랍 설명":{"voiceline":"「고고 바큠 군」이 좀 고장 났어. 에헤헤~ 금방 고칠 수 있으니까 걱정하지 마!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"후우~ 겨우 해결했네~! 고고 바큠 군이 지휘관을 공격하지는 않아서 정말 다행이야! 다치면 큰일이잖아!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/feeling5.ogg"},"터치3":{"voiceline":"난 괜찮아!! 어떻게든 될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 어서 와~! 고고 바큠 군을 수리하려면 시간이 더 걸릴 것 같아…… 그나저나 위력이 상승했네~! 으으…… 지휘관! 살려줘~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"으음… 고고 바큠 군을 어떻게 멈추더라… 만든 지 오래돼서 까먹었어~ 아, 지휘관! 조심해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/login.ogg"},"실패":{"voiceline":"고고 바큠 군, 아직 안 고쳐졌나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/lose.ogg"},"우편":{"voiceline":"으아아!! 고고 바큠 군이 지휘관의 우편을 빨아들이고 있어!! 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/mail.ogg"},"임무":{"voiceline":"지휘관은 임무를 우선시하도록 해! 이것만 해결하면 나도 바로 갈게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100011/mission.ogg"},"임무완료":{"voiceline":"후우… 고 고 바큠 군… 드디어 고쳐진 것 같아~ 지휘관도 임무가 끝났구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voicel