[{"클뜯 id":10400030,"클뜯 함순이 id":1040003,"함순이 이름":"키즈나 아이·Anniversary","한글 함순이 + 스킨 이름":"키즈나 아이·Anniversary","영문 함순이 + 스킨 이름":"Anniversary Kizuna AI","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400030/shipyard.png","설명":"키즈나 아이, 드레스를 차려입고 등장! 라이브도 배틀도 힘낼게! ","자기소개":{"voiceline":"라이브에 나갈 때는 이 의상을 입기도 해! 이 모항에서 언젠가 라이브 할 수 있으면 좋겠다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/profile.ogg"},"메인1":{"voiceline":"퓐쨩 수고했어! 앗, 지휘관! 지금 마침 퓐쨩의 노래 연습을 봐주고 있었어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/main1.ogg"},"메인2":{"voiceline":"자자, 이거, 팔랑팔랑하지! 점프? 이거, 스커트가 아닌데","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/main2.ogg"},"메인3":{"voiceline":"뭐? 귀여워? 그치! 알고 있어~ 고마워~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/main3.ogg"},"전투개시":{"voiceline":"배틀도 텐션 올려서 간다~~~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/battle.ogg"},"상세확인":{"voiceline":"지휘관은 어떤 음악 들어? 지금 되게 추천하는 아티스트가 있어! Kizuna AI라고 하는데…… 아, 나였다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/detail.ogg"},"드랍 설명":{"voiceline":"키즈나 아이, 드레스를 차려입고 등장! 라이브도 배틀도 힘낼게!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰에 갔던 아이들이 돌아왔어! 환영 노래로 맞이해주자! 자, 지휘관도 같이♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/expedition.ogg"},"실망":{"voiceline":"안심해 주세요, 지휘관님은 라이브에 부르지 않을 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/feeling1.ogg"},"낯섦":{"voiceline":"나, 이 모항에서도 라이브를 해보고 싶어! 지휘관도 협력해 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/feeling2.ogg"},"호감":{"voiceline":"라이브를 하기 위해선 노래와 댄스의 연습, 그리고 토크 공부도 해야겠지! 그리고 무대 확보 같은 것도 하고…… 아아~ 해야 할 일이 많아~~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/feeling3.ogg"},"기쁨":{"voiceline":"앗, 지휘관~ 왜 그래? 뭐? 벌써 무대 확보나 다른 일들 전부 끝났어!? 대단해! 이제 연습에 전념하라고? ……지, 지휘관이 엄청나게 유능한 사람처럼 보여……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/feeling4.ogg"},"사랑":{"voiceline":"라이브 대성공이었네! 지휘관이 있어줘서 정말 다행이야. 아, 그래! 특별히 지휘관만을 위해 노래할게. 그럼 들어주세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어, 지휘관! 이제부터 시그넷쨩 일행하고 같이 댄스 레슨 할 거야. 다음 출격까지 시간도 있고, 어울려 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/home.ogg"},"hp 경고":{"voiceline":"반드시 끝까지 해낼 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 어서 와! 다음 라이브를 대비해서 새러토가 선생님에게 노래 레슨을 받고 있어. 조금 들어 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/login.ogg"},"실패":{"voiceline":"……무조건 다음 라이브에 살린다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/lose.ogg"},"우편":{"voiceline":"오? 우편이야! 팬레터 와 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/mail.ogg"},"임무":{"voiceline":"어디 보자, 새로운 임무가 내려온 것 같은데. 어서 완료시켜버리자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/mission.ogg"},"임무완료":{"voiceline":"임무 보수를 받으러 가자! 뭔가 좋은 게 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/mission_complete.ogg"},"서약":{"voiceline":"모두 같이 손을 들고, 노래하며 춤추면 행복해질 수 있어! 그게 바로 라이브. 그 광경, 확실하게 볼 수 있었어……! 지휘관, 정말 고마워!! 하지만 당연하게도! 이걸로 끝이 아니야. 자, 가자. 지휘관과 함께라면 갈 수 있어! 더 앞으로! 앞으로도 잘 부탁해!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/propose.ogg"},"스킬":{"voiceline":"내 노래를 들어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/skill.ogg"},"터치1":{"voiceline":"오, 리퀘스트인가? 좋아, 뭐가 듣고 싶어? 노래 부를게~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/touch.ogg"},"터치2":{"voiceline":"하이파이브하고 싶어? 간다! 예~~~이♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/touch2.ogg"},"입수시":{"voiceline":"키즈나 아이, 드레스를 차려입고 등장! 라이브도 배틀도 힘낼게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/unlock.ogg"},"강화성공":{"voiceline":"강화 완료♪ 라이브도 배틀도 체력 승부니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"완・전・승・리~! 역시 나! 천재네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['포춘'] : 춘춘, 내가 지켜 줄게~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400030/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_