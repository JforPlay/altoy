[{"클뜯 id":705040,"클뜯 함순이 id":70504,"함순이 이름":"소비에츠카야 벨로루시아","한글 함순이 + 스킨 이름":"소비에츠카야 벨로루시아","영문 함순이 + 스킨 이름":"Sovetskaya Belorussiya","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705040/shipyard.png","설명":"소비에츠키 소유즈급 전함—소비에츠카야 벨로루시아","자기소개":{"voiceline":"대전에서 23형 전함 디자인은 최종적으로 이뤄지지 않았고 당연히 나도 출전 기회가 없었다. 흥, 나도 그런 불완전한 몸으로 전쟁터에 나갈 생각은 하지 않거든. 이제, 네가 있는 여기서, 내 맘대로 실력 발휘를 할 수 있다면 그것으로 충분하지 않을까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/profile.ogg"},"메인1":{"voiceline":"상대를 단숨에 무찌르는 것보다, 한 걸음 한 걸음 올가미에 넣는 것이 훨씬 재미있지, 안 그런가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/main1.ogg"},"메인2":{"voiceline":"평온한 바람과 파도... 아, 가슴을 뛰게 만들어 줄 소식은 없는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/main2.ogg"},"메인3":{"voiceline":"최소한의 대가로 최대의 적을 격파하면 최고의 쾌감을 느낄 수 있지, 안 그런가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/main3.ogg"},"전투개시":{"voiceline":"적을 파멸하자, 몸부터 마음 속 의지까지, 철저히——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/battle.ogg"},"상세확인":{"voiceline":"소비에츠키 소유즈급 중 가장 뛰어난 것을 고르라면 당연히 나고, 내가 될 수밖에 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/detail.ogg"},"드랍 설명":{"voiceline":"소비에츠키 소유즈급 전함—소비에츠카야 벨로루시아","voicelink":null},"의뢰 완료":{"voiceline":"내기 하나 하지, 지휘관 동지. 의뢰조가 물자를 얼마나 가져왔을지 말이야... 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/expedition.ogg"},"실망":{"voiceline":"됐어, 나는 너의 일에는 일절 관심이 없으니, 나를 건드리지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/feeling1.ogg"},"낯섦":{"voiceline":"지휘관 동지, 내기 하나 할까? 나의 협조가 있어야 업무를 무사히 마칠 수 있다고, 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/feeling2.ogg"},"호감":{"voiceline":"오? 내기의 승패는 신경 쓰지 않고, 나에게 도움을 요청한 건가? 하하, 어차피 잠시 흥을 돋울 내기였으니, 승패는 따지지 않겠다! 말해봐, 지휘관 동지, 내가 무엇을 도와주길 바라나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/feeling3.ogg"},"기쁨":{"voiceline":"함대를 지휘하고, 작전 출격에 싫증이 나면 내게 모든 걸 맡겨라. 네가 매일 좋은 소식을 들으면서 잠들 수 있다고 보장하지. 근데, 지휘관 동지에게 이런 날은 없겠지, 하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/feeling4.ogg"},"사랑":{"voiceline":"이처럼 견고한 정면 공세는 오히려 사람들에게 상쾌하기 그지없는 느낌을 준다, 지휘관 동지. 그런 너와 함께 정상에 서서 세상을 내려다볼 수 있다면, 그것도 정말 괜찮을 것 같군, 하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/feeling5.ogg"},"터치3":{"voiceline":"이런 허튼 수작은 아무 쓸모도 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/headtouch.ogg"},"모항귀환":{"voiceline":"적을 대하는 게 너무 자비롭잖아, 지휘관 동지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/home.ogg"},"hp 경고":{"voiceline":"전황 아직 파악 중!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/hp_warning.ogg"},"로그인":{"voiceline":"이것 봐, 내가 너 이때 쯤 올 거라고 했지. 러시아와 그녀들은 안 믿더군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/login.ogg"},"실패":{"voiceline":"완벽하게 보이는 대상도 빈틈이 있다는... 것인가...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/lose.ogg"},"우편":{"voiceline":"우편? 좀 재밌는 내용이면 좋겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/mail.ogg"},"임무":{"voiceline":"지휘관 동지, 함대가 사소한 임무 때문에 발이 묶이게 할 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/mission.ogg"},"임무완료":{"voiceline":"좋아, 이제 방해할 임무들이 없어졌으니, 마침내 우리의 계획을 계속할 수 있게 됐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/mission_complete.ogg"},"서약":{"voiceline":"호오? 이 반지와 계약서 하나로 나를 영원히 네 곁에 묶어둘 생각인가? 잠시 널 믿어보겠다. 널 믿는다면, 최종적으로 함께 정상에 설 수 있다고. 날 실망시키지 말아줘. 지휘관 동지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/propose.ogg"},"스킬":{"voiceline":"괜한 발악은 그만둬라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/skill.ogg"},"터치1":{"voiceline":"내 생각에... 너는 나에게 무얼 바라는게 아니라 단순히 내 반응을 보고싶어 하는 것 같은데, 그렇지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/touch.ogg"},"터치2":{"voiceline":"너는 가장 형편없는 방식을 택해서 자신의 용감함을 증명했구나, 지휘관 동지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/touch2.ogg"},"입수시":{"voiceline":"지휘관 동지, 정말로 날 휘하로 끌어들일 셈인가? 흐흥, 좋다! 그럼 손잡고 함대의 앞을 가로막는 모든 장애물들을 치워버리자고——다만, 나의 방식대로 해야 한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/unlock.ogg"},"강화성공":{"voiceline":"이제는 더 강한 화력으로 적을 더욱 도망칠 수 없게 할 수 있겠군. 하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"놀랄 것 없어. 난 단지 자멸을 자초한 자가 원하는 대로 만들어줬을 뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":{"voiceline":"의뢰조가 물자를 가져왔다고? 내기는 이제 필요 없겠지.어차피 틀림없이 적지 않을 거란 걸 알고 있으니까, 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"그 적들이 다시 들들 볶아대더라도 상관없지만, 머릿속에서 이 일을 절대로 잊어서는 안 된다. 지휘관 동지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"왔는가, 지휘관. 오늘도 예상한 시간 안에 돌아왔구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"우편? 어서 확인해 봐—흥미로운 내용을 놓쳐 버리면 안되니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/mail_ex.ogg"},"임무_ex":null,"임무완료_ex":{"voiceline":"좋아, 임무를 모두 완수하고, 네가 스스로 정한 목표를 계속 추구해야 한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"어이, 여기서 들떠서 흥분하라고 한 적 없는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['소비에츠카야 러시아'] : 빠진 나사는 내게 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"모항이 평화롭구나... 좋다. 긴장하고 살벌한 분위기는 전장에 남아 있는 것만으로도 충분해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"체크메이트... 이건 안된다고? 내가 꼭 누굴 괴롭히고 있는 것 같네, 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705040/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":705041,"클뜯 함순이 id":7