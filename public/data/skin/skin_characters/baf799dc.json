m/Fernando2603/AzurLane/main/images/skin/705042/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705042/shipyard.png","설명":"하하, 이런 곳을 약속 장소로 정할 줄은 몰랐다고? 나도 가끔은 모래사장에서 여유를 즐기고 싶을 때가 있거든. 내 초대에 응했으니 같이 느긋하게 시간을 보내는 것쯤은 해줄 수 있겠지? 안 그런가, 지휘관 동지?","자기소개":null,"메인1":{"voiceline":"바닷바람이 참 상쾌하군. 그렇지, 내기 하나 할까? 지휘관 동지가 내 베일을 붙잡으면… 상을 주도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/main1.ogg"},"메인2":{"voiceline":"이렇게 같이 바다를 바라보고 있으니… 참 좋군. 나조차도 「계속 이곳에 머물고 싶다」는 생각이 드는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/main2.ogg"},"메인3":{"voiceline":"지휘관 동지, 내 모습 꽤 괜찮지 않나? …하하, 그런 말 몇 마디로 얼버무려질 것 같은가? 공들여 고른 수영복이니, 좀 더 찬찬히 감상해보라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"한가로운 시간을 보내고는 있지만, 가장 눈에 띄는 존재는 여전히 나지. 자, 이 모래사장을 우리의 새로운 무대로 삼아보자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/detail.ogg"},"드랍 설명":{"voiceline":"하하, 이런 곳을 약속 장소로 정할 줄은 몰랐다고? 나도 가끔은 모래사장에서 여유를 즐기고 싶을 때가 있거든. 내 초대에 응했으니 같이 느긋하게 시간을 보내는 것쯤은 해줄 수 있겠지? 안 그런가, 지휘관 동지?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔나? 이번 전리품은 네 예상보다 훨씬 대단할 것 같은 예감이 드는군. 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"내 평온한 마음은 바닷바람 때문이 아니라, 너에 대한 감정에서 비롯된 것이지. 지휘관 동지, 오늘 이 고백은 평생 잊지 못할 거라고 나는 확신해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/feeling5.ogg"},"터치3":{"voiceline":"지휘관 동지, 이 베일로 확 묶어줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔군. 휴식 시간까지 나와 함께하고 싶다는 건가? 하하하, 그렇다면 이 둘만의 시간을 소중히 보내야겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 동지, 예상했던 시간에 거의 늦지 않게 와줬군… 마침 지금 바닷바람이 아주 기분 좋으니 함께 즐기자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/login.ogg"},"실패":null,"우편":{"voiceline":"응? 우편인가? 이 시간을 방해하는 귀찮은 일이 아니었으면 좋겠다만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/mail.ogg"},"임무":{"voiceline":"날씨도 좋으니, 서둘러 임무를 끝내고 해변 산책이라도 하자고. 바닷바람을 맞는 게 기대되는군~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/mission.ogg"},"임무완료":{"voiceline":"어때? 내가 알려준 대로 하니까 임무도 그냥 소일거리에 불과하지? 자, 이제 보상을 즐길 시간이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"흠~? 내가 방심하고 있을 거라고 생각한 건가? 너무 쉽게 생각한 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/touch.ogg"},"터치2":{"voiceline":"지휘관 동지를 베일로 묶어 혼쭐을 내줘야겠는걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/touch2.ogg"},"입수시":{"voiceline":"하하, 이런 곳을 약속 장소로 정할 줄은 몰랐다고? 나도 가끔은 모래사장에서 여유를 즐기고 싶을 때가 있거든. 내 초대에 응했으니 같이 느긋하게 시간을 보내는 것쯤은 해줄 수 있겠지? 안 그런가, 지휘관 동지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705042/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"수영복","상점 id":71145,"상점 카테고리 id":6,"스킨 태그":"배경","입수 영상":"O","재화":880,"기간":"한정 (2