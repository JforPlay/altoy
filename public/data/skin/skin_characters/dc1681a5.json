[{"클뜯 id":501080,"클뜯 함순이 id":50108,"함순이 이름":"창펑","한글 함순이 + 스킨 이름":"창펑","영문 함순이 + 스킨 이름":"Chang Feng","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501080/shipyard.png","설명":"창펑급 구축함 - 창펑","자기소개":{"voiceline":"이스트 글림 소속, 창펑급 구축함 1번함 창펑입니다. 동생들이 지휘관님께 여러모로 폐를 끼치고 있다던데, 앞으로는 그런 일이 없도록 확실히 일러둘게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/profile.ogg"},"메인1":{"voiceline":"지휘관님, 차와 같이 드실 과자를 준비했는데… 롱우가 만든 것만큼 대단하지는 않으니 너무 기대하지 마세요. 그래도 열심히 배우고 있답니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/main1.ogg"},"메인2":{"voiceline":"페이윈이랑 푸보가 또 집무실에서 이상한 짓을 저지르고 있진 않죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/main2.ogg"},"메인3":{"voiceline":"으음… 지휘관님, 여기 사다리 있나요? 천장에 있는 거미줄을…… 네? 지휘관님께서 해주시겠다고요? 그럼, 여기 걸레랑 먼지떨이 받으세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/main3.ogg"},"전투개시":{"voiceline":"음… 준비 완료, 빈틈없음…이에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/battle.ogg"},"상세확인":{"voiceline":"아, 지휘관님… 평소 쥬스타그램에 가사 노동 팁을 알려주는 동영상을 올리고는 하는데, 의외로 반응이 꽤 괜찮아요… 모두에게 도움이 된 것 같아서 기뻐요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/detail.ogg"},"드랍 설명":{"voiceline":"창펑급 구축함 - 창펑","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네요. 밖에서 일하느라 힘들었을 테니, 제가 차랑 과자를 가지고 올게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/expedition.ogg"},"실망":{"voiceline":"집무실… 아무래도 청소 좀 해야겠는데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/feeling1.ogg"},"낯섦":{"voiceline":"페이윈이랑 푸보는 어디를 가든 말썽만 일으켜서, 그 뒤치다꺼리는 언제나 제 차지예요. 하지만… 둘 다 귀여운 동생이랍니다. 지휘관님 생각은 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 책상에 과자를 뒀어요. 드시기 전에는 꼭 손을 씻으세요~ 또 먹고 싶은 거 있으세요? 만들어 드릴게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/feeling3.ogg"},"기쁨":{"voiceline":"아, 조금만 기다리세요. 지금 지휘관님의 옷을 개는 중이라…… 앗…? 이, 이건 지휘관님의…… 아////","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 시트와 이불을 빨아서 말리고 왔어요. 지휘관님이 햇빛 냄새를 맡으며 푹 잘 수 있기를…… 이불에 담긴 창펑의 마음과 함께 잠들기를… 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/feeling5.ogg"},"터치3":{"voiceline":"후후… 고양이 귀처럼 접은 스카프, 귀엽죠~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 고생 많으셨어요. 깨끗한 옷을 준비했으니, 우선 갈아입고 편히 쉬세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/home.ogg"},"hp 경고":{"voiceline":"아… 아야… 치마가 더러워졌네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 조금만 더 기다려 주시겠어요? 아직 방 청소가…… 죄송해요. 청소를 끝내놓고도 아직 더러운 게 보여서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/login.ogg"},"실패":{"voiceline":"안개가 끼면 잘 안 보여요…… 죄송해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 우편이 왔네요~ 답장 하는 거 잊지 마세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/mail.ogg"},"임무":{"voiceline":"지휘관님, 아직 안 끝난 임무가 있네요. …자, 여기 정리해 뒀으니까, 어서 업무를 마무리해 주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었네요. 시트랑 이불도 다 빨아서 말려뒀으니, 이제 드디어 푹 쉴 수 있겠어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/mission_complete.ogg"},"서약":{"voiceline":"이제 지휘관님과 가장 가까운 가족이 되었네요…… 앞으로는 매일 집을 깨끗하게 하고, 지휘관님이 돌아오시기만을 기다릴게요♪ 후후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/propose.ogg"},"스킬":{"voiceline":"놓치지 않겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/skill.ogg"},"터치1":{"voiceline":"아직 청소 중이라 앞치마가 먼지투성이니까 만지지 않는 편이 좋을 거예요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/touch.ogg"},"터치2":{"voiceline":"앗?! 이, 이렇게 함부로…… 채, 책임 지세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 창펑급 구축함의 네임쉽인 창펑이 인사드려요. 서무 작업이든 가사 노동이든 다 제게 안심하고 맡겨주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/unlock.ogg"},"강화성공":{"voiceline":"이 힘으로 더 지휘관님께 도움을 드릴 수 있겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼습니다~ 다행이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"이렇게 하고, 이렇게 하면…… 옷을 빨리 갤 수 있어요. 제 가사 노동 시연 어때요♪ 편리하죠? 시간을 절약하면 그만큼 지휘관님과 함께 있을 수 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님, 침대를 정리했어요. …네? 왜 그러세요? 창펑도 같이 여기 있었으면 좋겠다고요…? 좋아요~ 그럼, 우선 목욕한 다음에 깨끗한 파자마로 갈아입고 올게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"응… 지휘관님이 쓰다듬어 주시면 의욕이 마구마구 솟아나요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관님, 임무 하느라 고생하셨어요. 목욕하면서 느긋하게 쉬는 건 어떠세요? 깨끗하게 청소해 뒀고, 원하시면 마사지도 해드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"서류 정리는 끝났고, 책상도 깨끗하게 닦았고, 차랑 과자도 완벽해요…… 이제 지휘관님도 기분 좋게 업무를 보실 수 있겠어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"응? 왜 그러세요? 기분이 안 좋으세요? 그럼, 제 쪽으로 오세요… 에구구, 많이 힘드셔써요~? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/touch_ex.ogg"},"터치2_ex":{"voiceline":"공공장소에서는 삼가세요, 지휘관님…… 적어도 둘만 있을 때…… 하읏… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['페이윈', '푸보'] : 어디가서 말썽 피우면 안 돼요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/couple_encourage1.ogg"},{"voiceline":"['셰필드'] : 네? 권총으로 청소를요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"여긴 왜 이렇게 엉망진창이 된 거죠…? 아, 페이윈이랑 푸보가 왔었다고요? 그럼, 일단 정리하고… 두 사람한테는 제가 단단히 일러두고 올게요, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관님, 잠깐 사다리를 빌릴 수 있을까요? 책장에 쌓인 먼지를…… 네? 지휘관님이 직접 들어 올려주시겠다고요? 아, 네… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"네? 롱우에게 받은, 지휘관님이 좋아하는 요리 레시피를 읽고 있어요. 다 배우면 밖에서 외식할 필요가 없어지겠네요~ 제가 집에서 만들어 드릴 거니까요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501080/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":1},{"클뜯 id":501081,"클뜯 함순이 id":50108,"함순이 이름":"창펑","한글 함순이 + 스킨 이름":"따뜻한 대청소","영문 함순이 + 스킨 이름":"Cozy Spring Cleaning","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501081/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501081/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501081/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501081/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501081/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501081/shipyard.png","설명":"에헤헤… 지휘관님이시군요. 지금은 페이윈이랑 푸보와 함께 대청소하는 중이랍니다. 조금 있으면 끝날 거예요~ ……지휘관님, 안에 들어가서 따뜻한 차라도 드시고 가시지 않을래요?","자기소개":null,"메인1":{"voiceline":"새해 저녁 준비가 거의 끝났네요. 제야가 되면… 지휘관님도 같이 드시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/main1.ogg"},"메인2":{"voiceline":"페이윈이랑 푸보요? 후후후, 괜찮을 거예요. 방금 꽃병을 넘어뜨렸을 때 확실히 설교해 뒀으니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/main2.ogg"},"메인3":{"voiceline":"등롱 위치를 조금 바꾸고 싶은데… 지휘관님, 도와주실 수 있으세요…? 정월에 이렇게 같이 등롱을 장식하다니, 정말 가족 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"창문 닦기에도 요령이 있거든요. 나중에 쥬스타그램에 올려봐야겠어요. 음… 그래도 지휘관님께서 창문을 닦아야 할 때는 그냥 제게 직접 말씀하세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/detail.ogg"},"드랍 설명":{"voiceline":"에헤헤… 지휘관님이시군요. 지금은 페이윈이랑 푸보와 함께 대청소하는 중이랍니다. 조금 있으면 끝날 거예요~ ……지휘관님, 안에 들어가서 따뜻한 차라도 드시고 가시지 않을래요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이 매실은 지휘관님께 드릴게요. 늘 평안하고, 행복하고, 즐겁고, 무슨 일이든 잘 되시기를…… 따뜻한 봄이 빨리 우리 곁으로 찾아와 주기를~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/feeling5.ogg"},"터치3":{"voiceline":"네, 대청소 열심히 할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/headtouch.ogg"},"모항귀환":{"voiceline":"하아… 그리고 이렇게 그리면…… 에헤헤, 지휘관님. 여기 이 작은 하트를 드릴게요~ 업무하느라 고생 많으셨어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 이제 곧 새해가 시작되네요. ……네? 아직 대청소를 시작하시지 않았다고요? 그럼 제가 가서 도와드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"추우세요? 난방을 켜뒀으니, 어서 안으로 들어오세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/touch.ogg"},"터치2":{"voiceline":"지휘관님, 안 돼요…… 아직 대청소 중이잖아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/touch2.ogg"},"입수시":{"voiceline":"에헤헤… 지휘관님이시군요. 지금은 페이윈이랑 푸보와 함께 대청소하는 중이랍니다. 조금 있으면 끝날 거예요~ ……지휘관님, 안에 들어가서 따뜻한 차라도 드시고 가시지 않을래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501081/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex"