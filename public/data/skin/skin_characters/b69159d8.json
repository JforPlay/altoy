[{"클뜯 id":499050,"클뜯 함순이 id":49905,"함순이 이름":"에기르","한글 함순이 + 스킨 이름":"에기르","영문 함순이 + 스킨 이름":"Ägir","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499050/shipyard.png","설명":"대형순양함-—에기르","자기소개":{"voiceline":"나의 이름은 깊은 바다의 신에서 유래한 것이다. 하지만, 바람과 비를 부르고 파도를 지배하는 그 해신에 비하면, 내 방식은 훨씬 부드럽지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/profile.ogg"},"메인1":{"voiceline":"의욕? 연회 자리에서 다들 마음껏 마시면 오르는 거 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/main1.ogg"},"메인2":{"voiceline":"그런가, 광폭한 바다의 모습을 보는 것을 좋아해? 후후후, 굉음이 울려야 폭풍이고, 거칠어야 바다인 것이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/main2.ogg"},"메인3":{"voiceline":"···응? 날 보느라 정신이 팔렸다, 라고 말할 셈이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/main3.ogg"},"전투개시":{"voiceline":"물어뜯어 주마! 하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/battle.ogg"},"상세확인":{"voiceline":"이 아이는 가끔씩 이상하게 활발해진다. 돌볼 때 조심하라고, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/detail.ogg"},"드랍 설명":{"voiceline":"대형순양함-—에기르","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 완료했다. 설마 동료들을 기다리게할 셈은 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/expedition.ogg"},"실망":{"voiceline":"나는 스스로 타락한 영혼을 동정하지 않는다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/feeling1.ogg"},"낯섦":{"voiceline":"내가 관심 있는 거? 후후후~ 강력한 적, 아름다운 술, 거센 폭풍의 바다, 그리고…… 그렇게 내 주의를 끌고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/feeling2.ogg"},"호감":{"voiceline":"지휘관, 이리 와봐. 왜 그러냐고? 당연히, 나랑 술 몇 잔 해달라고. 안심해. 네가 만약 취해서 헛소리를 한다고 해도 괘념치 않을테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/feeling3.ogg"},"기쁨":{"voiceline":"네가 내 흥미를 유발하고 싶어하는 건 알지만, 설마 계속 날 보고 있으려는 건 아니겠지? 후후, 너도 어느 정도 성장했군…… 잠깐, 너, 너 정말 진지한 거 아니지!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/feeling4.ogg"},"사랑":{"voiceline":"나에게 도전하고 싶다니, 심연의 신이라는 이름으로 널 삼켜버릴 수밖에 없겠구나——와라, 왜 가만히 있지? 이 나에게…… 앗!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/feeling5.ogg"},"터치3":{"voiceline":"……뭣!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/headtouch.ogg"},"모항귀환":{"voiceline":"그냥 이렇게 쉬도록 두고 싶지만 책상에 있는 서류 건수를 보면… 아무래도 안되겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/home.ogg"},"hp 경고":{"voiceline":"오? 잔꾀를 간파당한 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/hp_warning.ogg"},"로그인":{"voiceline":"누가 왔는지 볼까? 오, 너였군——그렇다면… 열심히 일하도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/login.ogg"},"실패":{"voiceline":"난 누구도 내 앞에서 승리의 열매를 빼앗아 가는 것을 용납하지 않는다…두고 보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/lose.ogg"},"우편":{"voiceline":"멀리서부터 온 편지… 우선 확인해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/mail.ogg"},"임무":{"voiceline":"아직 완료하지 않은 임무가 있다. 너도 무능한 지휘관이란 소리를 듣고 싶진 않겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/mission.ogg"},"임무완료":{"voiceline":"좋아, 이게 바로 자격 있는 지휘관이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/mission_complete.ogg"},"서약":{"voiceline":"서약의 증명? 넌 이런 형식적인 것을 좋아하는 거야? 그렇다면… 형식적인 것뿐만 아니라, 너에게 실질적인 속박을 더 많이 주겠다… 후후후, 차라리 지금 한 번 알려주도록 하지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/propose.ogg"},"스킬":{"voiceline":"하하하하! 황량한 바다의 신의 커다란 입에 삼켜져라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/skill.ogg"},"터치1":{"voiceline":"좀 더 가까운 편이 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/touch.ogg"},"터치2":{"voiceline":"저질러주는데​··· 뭣, 한 번 더!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/touch2.ogg"},"입수시":{"voiceline":"대형순양함 에기르다. 지휘관, 내가 널 위해 파도를 부리길 원하는가? 좋다. 그럼 먼저 너의 그릇을 보여봐라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/unlock.ogg"},"강화성공":{"voiceline":"경축하며 한 잔 마시자...... 후아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"나약한 물보라는 거대한 파도 앞에서 언급할 가치도 없지. 후후, 아하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"왜인지는 모르겠는데, 이 아이… 요즘 얌전하단 말이지. 너… 무슨 술수라도 부린 거야? …주인 성질이 많이 죽어서 그런 거…라고? 어, 어디 건방지게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 슬슬 이 에기르의 승리를 인정하는 게 어때? 이미 나한테 완전히 정복당했잖아? 그 눈빛, 그리고 빠른 고동은 거짓말을 하지 않지. 후후후…… 꺅?! 자, 잠깐! 너……! 너 따위에게 내가질 리가……?!///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"야! 아주 푹 빠져서 뭘 하는 거야?! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"늘 고생이 많으니까 오늘은 특별히 이 에기르가 대신 업무를 처리해 줄게. 거기서 얌전히 쉬고 있어. 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"드디어 왔네. 업무 일정은 이미 정리해 뒀으니까, 확인해 봐. …뭐야? 문제라도 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"응? 거친 파도에 휩쓸리지 않도록 조심하는 게 좋을걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/touch_ex.ogg"},"터치2_ex":{"voiceline":"……또야?! 거, 거긴……!////","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":{"voiceline":"자, 지휘관! 건배! ……크으!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/upgrade_ex.ogg"},"승리_ex":{"voiceline":"봤지?! 이게 바로 심연의 신만이 가질 수 있는 강력한 힘이라고! 으하하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['넵튠'] : 좀 진중할 필요가 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/couple_encourage1.ogg"},{"voiceline":"['아드미럴 히퍼', '탈린'] : 먼저 승리하고 나서 실컷 마셔라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"바다는 거칠게 날뛸 때도 있지만 잔잔할 때도 있는 법이지. 예를 들면 이렇게 아무것도 하지 않고 느긋하게 지내는 것도…… 너만 내 곁에 있다면…… 뭐, 나름 괜찮네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/main5_ex.ogg"},"메인6_ex":{"voiceline":"그렇게 자꾸 쳐다보면 아무리 이 에기르라도 정신 집중이 흐트러진다고…! 적어도 일이 끝난 후에…… 윽! 방금 서류에 잘못된 부분이 있어서 그런 거라고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"파티에서 동료들과 함께 왁자지껄 마시는 것도 즐겁지만… 네가 없으니까 역시 좀 부족하더라. 다음에는 꼭 참석해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499050/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"UR","ex_chat_status":1},{"클뜯 id":499051,"클뜯 함순이 id":49905,"함순이 이름":"에기르","한글 함순이 + 스킨 이름":"모항의 드래곤 메이드","영문 함순이 + 스킨 이름":"Iron Blood's Dragon Maid","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499051/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499051/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499051/shipyard.png","설명":"흥, 메이드 업무술이니 뭐니 호들갑이나 떨고, 이 정도 업무쯤 나한테 걸리면… 읏?! 너, 너… 보고 있었어?!","자기소개":null,"메인1":{"voiceline":"뭐야 이 쬐깐한 건… 방해된다고! 사라져! 나한테 눌려서 아무것도 못 한다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/main1.ogg"},"메인2":{"voiceline":"이 청소 작업이 연회 준비의 일환이라고? 어차피 어질러질 텐데 뭐 하러….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/main2.ogg"},"메인3":{"voiceline":"파르제팔, 뭘 즐거운 듯이… 내가 메이드라는 거 자체가 불만이라고! …내 말 들려?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"그 서류, 내게 맡길 생각이야? 대체 이 에기르를 뭐라고 생각하는 거야?! …게다가 애초에 맡아준다고 해도 내가 제대로 해낼 수 있을지 어떨지…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/detail.ogg"},"드랍 설명":{"voiceline":"흥, 메이드 업무술이니 뭐니 호들갑이나 떨고, 이 정도 업무쯤 나한테 걸리면… 읏?! 너, 너… 보고 있었어?!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료야. …설마 날 보내려고 한 건 아니겠지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"돌아오는 타이밍을 가늠해서 다과를… 좋았어, 이걸로 괜찮…겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"너였군. 크, 크흠… 좋은 아침입니다, 주인니… 역시 그만두자고, 그만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"임무 완료야. 보상이나 받으러 다녀와.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"…하읏?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/touch.ogg"},"터치2":{"voiceline":"…윽?! 메이드를 하겠다고 나서지 말 걸 그랬어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/touch2.ogg"},"입수시":{"voiceline":"흥, 메이드 업무술이니 뭐니 호들갑이나 떨고, 이 정도 업무쯤 나한테 걸리면… 읏?! 너, 너… 보고 있었어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499051/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":nu