[{"클뜯 id":302010,"클뜯 함순이 id":30201,"함순이 이름":"유바리","한글 함순이 + 스킨 이름":"유바리","영문 함순이 + 스킨 이름":"Yuubari","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302010/shipyard.png","설명":"경순양함·유바리","자기소개":{"voiceline":"사쿠라 엠파이어 유바리형 경순양함 유바리야. 설계는 해군조약으로 인한 제한이 있었던 반면, 수많은 새로운 기믹이 응용되었어. 태평양 해전에서는 수뢰 전대의 기함으로서 활약했어. 으으으, 산소 어뢰, 연구용으로 몇 개 정도 갖고 싶은데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/profile.ogg"},"메인1":{"voiceline":"후… (낮잠 중)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/main1.ogg"},"메인2":{"voiceline":"멜론? 엄청 먹어보고 싶어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/main2.ogg"},"메인3":{"voiceline":"가토, 무서워… 그런 무서운 거에 고양이 이름 같은 건 아니지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/main3.ogg"},"전투개시":{"voiceline":"신형 병기 실전 테스트── 시작!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/battle.ogg"},"상세확인":{"voiceline":"기관이든 병기든 유바리 게 가장 최신식이라구. (으쓱)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/detail.ogg"},"드랍 설명":{"voiceline":"경순양함·유바리","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료야! 으으으, 선물 있으려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/expedition.ogg"},"실망":{"voiceline":"주인님, 유바리에겐 다가오지 말아 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/feeling1.ogg"},"낯섦":{"voiceline":"주인님, 유바리를 지그시 바라보면서 뭘 생각하는 거야? 후훗, 유바리는 이런 것에 감이 좋다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/feeling2.ogg"},"호감":{"voiceline":"유바리, 출격보다 역시 모항에 있는 편이 좋아. 여기야말로 유바리의 집. 푸른 바다에, 눈부시고 따스한 햇살… 으으… 후으음… Zzzzz…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/feeling3.ogg"},"기쁨":{"voiceline":"주인님은 어떤 처자가 타입이려나? 유바리일까? 유바리는, 주인님 같은 사람을 좋아해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/feeling4.ogg"},"사랑":{"voiceline":"주인님도 낮잠? 자, 이건 유바리가 가장 마음에 들어 하는 베개야. 그런데 이 베개, 어쩌면 꿈속에서 유바리와 만날 수 있는 베개일지도 몰라? 만약 그렇다면… 헤헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/feeling5.ogg"},"터치3":{"voiceline":"주인님도 약간은 아이 같네. 후훗. 그래도 유바리는 그런 주인님도 싫진 않아.","voicelink":null},"모항귀환":{"voiceline":"데이터 수집 완료. 다음은 장비 개선이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/home.ogg"},"hp 경고":{"voiceline":"우으…… 장비가 멀쩡해야 할 텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/hp_warning.ogg"},"로그인":{"voiceline":"주인님만 있다면, 유바리는 더 이상 아무것도 두렵지 않아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/login.ogg"},"실패":{"voiceline":"으아앗! …새로운 장비가 생기면 두 번은 당하지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/lose.ogg"},"우편":{"voiceline":"으으으, 수상한 편지… 주인님~ 열어봐봐~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/mail.ogg"},"임무":{"voiceline":"끝내지 않은 임무… 으으으, 아쉽지만 유바리의 연구 성과는 도움이 되지 않은 모양이야… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/mission.ogg"},"임무완료":{"voiceline":"주인님. 임무를 완료하면, 슬슬 낮잠 잘 시간이려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/mission_complete.ogg"},"서약":{"voiceline":"기뻐♪ 앞으로는 주인님이 매일 아침 잠에서 깨면, 가장 먼저 눈에 들어오는 게 유바리가 되는 거라구! 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/propose.ogg"},"스킬":{"voiceline":"신무기의 힘을 맛봐라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/skill.ogg"},"터치1":{"voiceline":"주인님의 손, 따뜻해서 기분 좋아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/touch.ogg"},"터치2":{"voiceline":"응… 읏… 아으~~~ 정말이지, 물어버릴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/touch2.ogg"},"입수시":{"voiceline":"나는 경순양함·「유바리」. 주인님은 날 어디선가 만난 적이 있다고? 으으으… 이, 있을 수 없어… 내게 자매 같은 건 없을 터…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/unlock.ogg"},"강화성공":{"voiceline":"으으으, 너무 많이 집어넣었을지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이걸로 주인님도 장비 갱신의 소중함을 조금은 알았으려나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0},{"클뜯 id":302019,"클뜯 함순이 id":30201,"함순이 이름":"유바리","한글 함순이 + 스킨 이름":"유바리·改","영문 함순이 + 스킨 이름":"Yuubari (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubuse