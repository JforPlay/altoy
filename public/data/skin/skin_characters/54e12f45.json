[{"클뜯 id":10400040,"클뜯 함순이 id":1040004,"함순이 이름":"키즈나 아이·SuperGamer","한글 함순이 + 스킨 이름":"키즈나 아이·SuperGamer","영문 함순이 + 스킨 이름":"Super Gamer Kizuna AI","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400040/shipyard.png","설명":"안녕하세요~! 버츄얼 게이머 키즈나 아이입니다! 지휘관님, 안심해주세요! 벽람은 제가 좀 했었거든요! ……어, 나, 함선이 된 거야!? ","자기소개":{"voiceline":"머리 잘랐냐구요? 흐흐~응, 저, 머리카락 길이도 마음대로 바꿀 수 있어요! 버츄얼이니까요! 이거야말로, 쿨하게 하이스코어를 때려 박는 키즈나 아이의 슈퍼 게이머 버전! 으쓱!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/profile.ogg"},"메인1":{"voiceline":"여기서도 키즈나 아이배 대회를 개최해보고 싶어~ 아야나미쨩하고 롱 아일랜드쨩은 참가한다고 해줬는데, 지휘관님도 참가하실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/main1.ogg"},"메인2":{"voiceline":"사실은 천재인데 허접 연기하는 거 힘들다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/main2.ogg"},"메인3":{"voiceline":"슉, 어때요 이 자메이카쨩에게 배운 포즈! 멋있지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/main3.ogg"},"전투개시":{"voiceline":"간다아아아아! 이야아아아아압!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/battle.ogg"},"상세확인":{"voiceline":"지휘관님도 게임하러 오셨나요? 마침 방송하려고 했던 게임이 있어요! 지휘관님도 같이 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/detail.ogg"},"드랍 설명":{"voiceline":"안녕하세요~! 버츄얼 게이머 키즈나 아이입니다! 지휘관님, 안심해주세요! 벽람은 제가 좀 했었거든요! ……어, 나, 함선이 된 거야!?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어요. 빨리 다음 의뢰에 보내지 않으면! 아까워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/expedition.ogg"},"실망":{"voiceline":"아아아 아 아아아 아아 아아아아아 아아아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/feeling1.ogg"},"낯섦":{"voiceline":"게임 방송도 꽤 어려워요. 열심히 하고 있는데도 허접 소리나 듣고…… 어떻게 해야 게임을 잘할 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/feeling2.ogg"},"호감":{"voiceline":"네? 호러 게임 방송? 싫어요, 안 합니다…… 싫어싫어싫어싫어싫어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/feeling3.ogg"},"기쁨":{"voiceline":"아~ 정말! 왜 호러 게임이 더 인기가 많은 거냐구요~! 그야, 제안해 준 지휘관님 덕분이기도 하지만요…… 다음엔 덜 무서운 걸로 부탁할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/feeling4.ogg"},"사랑":{"voiceline":"지휘관님은 게임을 잘 가르쳐주시네요! 여러 타이틀을 알고 있고, 지휘관님이 있으면 이제 허접 AI 같은 말은 안 듣겠어요! ……믿고 있어요, 지휘관님♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님 수고하셨어요~♪ 뭐? 무릎베개? …네네, 이나즈마쨩에게 어리광부려서 부디 잉여 지휘관이나 되시길~. 이나즈마쨩 뒤를 부탁할게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/home.ogg"},"hp 경고":{"voiceline":"아, 망삘…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 로그인 보너스는 잊지 말고 받으세요. 게임의 기본이야~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/login.ogg"},"실패":{"voiceline":"정말~, 완전 화남! 절대 용서하지 않을 거야!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/lose.ogg"},"우편":{"voiceline":"앗, 우편이 도착했어! 'GM'씨가 보낸 선물일지도!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/mail.ogg"},"임무":{"voiceline":"미션 발견! 잔뜩 완수해서 자금을 왕창 벌어버리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/mission.ogg"},"임무완료":{"voiceline":"미션 완료! 보수는 뭘까~? 응, 왜 그래 이카즈치쨩? 뭐? '비서함'은 보수를 받을 수 없어!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/mission_complete.ogg"},"서약":{"voiceline":"저를 위해 반지를 준비해 주셨군요! 기뻐요! 아, 진짜진짜! 정말로 감사하고 있다니까요! ……앞으로도 잔뜩 게임 가르쳐 줘요, 지휘관님! 언제나 고마워요……♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/propose.ogg"},"스킬":{"voiceline":"간다~, 콰앙~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/skill.ogg"},"터치1":{"voiceline":"저하고 게임으로 승부하고 싶어요? 좋습니다. 받아 드리죠! 제 실력을 보여 드리겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/touch.ogg"},"터치2":{"voiceline":"지휘관님, 헤드샷이라고 알고 있나요? 잠깐 해봐도 되나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/touch2.ogg"},"입수시":{"voiceline":"안녕하세요~! 버츄얼 게이머 키즈나 아이입니다! 지휘관님, 안심해주세요! 벽람은 제가 좀 했었거든요! ……어, 나, 함선이 된 거야!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/unlock.ogg"},"강화성공":{"voiceline":"이걸로 주포의 에임도 완벽하네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"WINNER~! MVP 땄다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['프린츠 오이겐'] : 프린쨩, 엄호는 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400040/couple_encour