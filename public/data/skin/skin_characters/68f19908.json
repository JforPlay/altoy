[{"클뜯 id":10800010,"클뜯 함순이 id":1080001,"함순이 이름":"타카라다 릿카","한글 함순이 + 스킨 이름":"타카라다 릿카","영문 함순이 + 스킨 이름":"Rikka Takarada","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800010/shipyard.png","설명":"음, 저는 타카라다 릿카입니다. 아직 무슨 상황인 건지 혼란스럽지만… 아무튼, 남은 시간 동안 잘 부탁드립니다.","자기소개":{"voiceline":"제 이름은 타카라다 릿카, 집은 카페가 딸린 리사이클 숍이라, 가끔은 저도 일손을 돕고는 했어요. 일단은 커피도 제대로 내릴 수 있다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/profile.ogg"},"메인1":{"voiceline":"아아, 여기에도 학교가 있구나……. 배우는 건 다른 것 같지만, 다른 세상인데도 똑같은 게 있다니 재밌네요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/main1.ogg"},"메인2":{"voiceline":"응? 나미코랑 핫스는 어디로 간 거지? 정말…… 이 주변 산책하자고 자기들이 불렀으면서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/main2.ogg"},"메인3":{"voiceline":"아, 지휘관님. 혹시 아카네 못 보셨어요? 겨우 이렇게 만났으니, 같이 어디라도 가볼까 했는데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/main3.ogg"},"전투개시":{"voiceline":"나라도 가야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 무슨 일이세요? 아, 커피가 드시고 싶으시다니, 갑자기 왜……. 어쨌든 안으로 들어오세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/detail.ogg"},"드랍 설명":{"voiceline":"음, 저는 타카라다 릿카입니다. 아직 무슨 상황인 건지 혼란스럽지만… 아무튼, 남은 시간 동안 잘 부탁드립니다.","voicelink":null},"의뢰 완료":{"voiceline":"어, 다들 돌아왔네. 잠깐 마중 갔다 올게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/expedition.ogg"},"실망":{"voiceline":"아, 그게……. (이 사람하고 말할 게 있었던가)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/feeling1.ogg"},"낯섦":{"voiceline":"으아, 탄산으로 잘못샀어……. 아, 지휘관님. 혹시 괜찮으시면 이거 드실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/feeling2.ogg"},"호감":{"voiceline":"음흠흠~♪ 아, 안녕하세요, 지휘관님. 후훗, 사실은 좀 좋은 일이 있어서…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/feeling3.ogg"},"기쁨":{"voiceline":"아아, 지휘관님. 겨우 찾았네……. 어디 가셨나 했어요. 자 여기, 아까 집무실 앞에서 떨어트린 펜이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/feeling4.ogg"},"사랑":{"voiceline":"여기서 싸우는 거, 처음에는 주저하기도 했지만, 지금은 그래도 꽤 잘하고 있는 것 같아요. 이것도 다 지휘관님과 동료들 덕분이겠죠…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/feeling5.ogg"},"터치3":{"voiceline":"음…… 부르셨어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/headtouch.ogg"},"모항귀환":{"voiceline":"출격 고생 많으셨어요. 쉬시면서 드실 수 있게 카페라떼라도 만들어 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/home.ogg"},"hp 경고":{"voiceline":"실수는 했지만…… 그래도 아직 만회할 수 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/hp_warning.ogg"},"로그인":{"voiceline":"아, 좋은 아침이에요. 의외로 빨리 일어나시는 편이시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/login.ogg"},"실패":{"voiceline":"거짓말…… 실수했나?! 다들 어서 도망쳐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/lose.ogg"},"우편":{"voiceline":"응? 웬 봉투가……. 지휘관님 앞으로…… 요즘 시대에 편지라니, 신기하네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/mail.ogg"},"임무":{"voiceline":"아직도 안 끝난 건가요? 어쩔 수 없네…… 제가 도울 수 있는 게 있으면 말씀해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/mission.ogg"},"임무완료":{"voiceline":"수고하셨습니다. 아, 보상도 도착한 것 같으니, 확실히 받아두세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/mission_complete.ogg"},"서약":{"voiceline":"이 세상에 막 와서 혼란에 빠져 있던 때, 지휘관님과 여기에 있는 모두가 다들 친절하게 대해줬어요. 그런 소중한 동료들을 위해서라도 앞으로 열심히 할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/propose.ogg"},"스킬":{"voiceline":"저도 제가 할 수 있는 걸……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/skill.ogg"},"터치1":{"voiceline":"네? 일 좀 도와달라구요? 매점 가는 중이었는데……. 뭐, 괜찮아요. 뭘 도와드리면 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/touch.ogg"},"터치2":{"voiceline":"그런 걸 성추행이라고 한다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/touch2.ogg"},"입수시":{"voiceline":"음, 저는 타카라다 릿카입니다. 아직 무슨 상황인 건지 혼란스럽지만… 아무튼, 남은 시간 동안 잘 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/unlock.ogg"},"강화성공":{"voiceline":"흐음, 이런 것도 있구나……. 감사합니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"휴우…… 어떻게든 되긴 했네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/win_mvp.ogg"},"전투개시_ex":{"voiceline":"이번에는 제가 싸울 차례죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/battle_ex.ogg"},"상세확인_ex":{"voiceline":"자, 지휘관님. 커피 오래 기다리셨습니다~ 맛은 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"그 땐 직접 적과 싸울 수 없었지만, 지금의 저에게는 누군가를 도와줄 수 있는 힘이 있어요……. 그러니까 이번에는 제가 모두와 지휘관님을 위해 싸울 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"아침인데 학교에 안 가는 것도 뭔가 이상한 느낌이네요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"일, 조금만 더 하면 끝나네요. 제가 마실 걸 좀 내려올테니, 마지막까지 파이팅이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/mission_ex.ogg"},"임무완료_ex":{"voiceline":"업무 고생 많으셨습니다. 애썼으니 조금은 쉬어도 괜찮겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"앗!? 뭐 하는 거예요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"다행이에요……. 다들 무사해서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['신죠 아카네'] : 아카네랑 함께라면 더 힘낼 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/couple_encourage1.ogg"},{"voiceline":"['핫스'] : 핫스, 내게 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/couple_encourage2.ogg"},{"voiceline":"['나미코'] : 아, 정말……. 간다, 나미코!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"여기 매점은 진짜 뭐든 다 있네요. 우리가 살던 세상에도 이런 가게가 있으면 좋을텐데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800010/main5_ex.ogg"},"메인6_ex":{"voi