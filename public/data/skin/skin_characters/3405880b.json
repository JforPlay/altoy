[{"클뜯 id":103030,"클뜯 함순이 id":10303,"함순이 이름":"노샘프턴","한글 함순이 + 스킨 이름":"노샘프턴","영문 함순이 + 스킨 이름":"Northampton","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103030/shipyard.png","설명":"노샘프턴급 중순양함·노샘프턴 (CA-26)","자기소개":{"voiceline":"워싱턴 조약형 순양전함 노샘프턴이다. 둘리틀 공습과 미드웨이 해전에 참여했고, 배틀 스타를 6개 받았다고. 다만, 호넷을 무사히 데려올 수 없었던 것은 유감이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/profile.ogg"},"메인1":{"voiceline":"바다의 소리를 들으니 진정되네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/main1.ogg"},"메인2":{"voiceline":"휴스턴, 시끄러워! 조용히 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/main2.ogg"},"메인3":{"voiceline":"잠깐 기다려, 생각할 게 있거든…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/main3.ogg"},"전투개시":{"voiceline":"전투의 시작을 알리는 나팔 소리가 울려 퍼지고 있어! 자아, 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/battle.ogg"},"상세확인":{"voiceline":"장갑은 두꺼워졌지만, 노출이 증가했다는 느낌이 드는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/detail.ogg"},"드랍 설명":{"voiceline":"노샘프턴급 중순양함·노샘프턴 (CA-26)","voicelink":null},"의뢰 완료":{"voiceline":"완료한 의뢰가 있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/expedition.ogg"},"실망":{"voiceline":"정신없으니까 조금 조용히 해주지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/feeling1.ogg"},"낯섦":{"voiceline":"난 말이 많은 타입이 아니지만, 그럼에도 친구가 되어 준다면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/feeling2.ogg"},"호감":{"voiceline":"조금 시끄러운 파트너와 활발한 여동생들이 있으니까, 오히려 지휘관 같은 조용한 친구가 드물단 생각이 드는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/feeling3.ogg"},"기쁨":{"voiceline":"미소, 말인가? 확실히 자주 웃진 않지만…… 뭐 나는 성격도 딱딱하고, 친구도 적지…… 그래…… 지휘관이 웃는 애가 좋다고 한다면 조금 노력해볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/feeling4.ogg"},"사랑":{"voiceline":"……좋아하는 사람, 말하는 건가? 뭐, 있다고 하면 있지만, 지금 그 사람의 이름을 말하는 건 조금 어렵다고 해야 할까…… 있잖아, 지휘관. 너, 나와 닮지 않았어? 호넷에게 언제나 융통성 없다고 듣고 있지만, 너도 상당한걸……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"빠진 녀석은 없지? 함대, 무사히 귀환했다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 제대로 훈련하면 여러 가지로 마음이 맞을 거라고 생각해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/login.ogg"},"실패":{"voiceline":"간단하게는 이길 수 없다고, 알게 됐어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/lose.ogg"},"우편":{"voiceline":"지휘관, 네게 온 편지는 책상 위에 올려뒀다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/mail.ogg"},"임무":{"voiceline":"그 미션, 아직 완료되지 않았네. 내게 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/mission.ogg"},"임무완료":{"voiceline":"보너스가 도착했다. 확인해보는 게 좋을걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/mission_complete.ogg"},"서약":{"voiceline":"겨우 눈치챘어? 이 둔감한… 뭐 내가 할 말은 아니지만… 어, 어쨌든 지금부터는 둔감 동맹으로서 함께 노력해볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/propose.ogg"},"스킬":{"voiceline":"여기라면……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/skill.ogg"},"터치1":{"voiceline":"어, 그건… 조금 간지럽잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/touch.ogg"},"터치2":{"voiceline":"……! !……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/touch2.ogg"},"입수시":{"voiceline":"응? 여어 지휘관. 내가 나타날 지점을 정확히 예측해내다니, 우리, 마음이 맞을 것 같네. …호넷도 이러면 좋겠지만… 하아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/unlock.ogg"},"강화성공":{"voiceline":"고마워. 나중에 확실히 돌려주도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이런 일, 못 할 거라 생각했다고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0}]