iceline/901042/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"고되기는 하지만 이렇게 동물을 돌보는 것도 성스러운 책무의 일부… 지휘관님께 도움이 된다면 저 케르생은 언제든… 기, 기꺼이 지휘관님을 위해 온몸을 바칠 거예요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 지, 지금은 아직 무사하지만, 다음에 또 날뛰면… 그때는 또 지휘관님께 도움을 요청드려도 될까요…? 흑…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 피하세요… 꺅?! 지휘관님을 보자마자 얌전해졌네요…? 가, 감사합니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/login.ogg"},"실패":{"voiceline":"하아, 하아…… 드디어 진정됐네요… 으… 이렇게 되다니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/lose.ogg"},"우편":null,"임무":{"voiceline":"목초 교체와 청소, 그리고 오늘 우유 짜기도… 네! 모두 처리해야 하는 책무랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/mission.ogg"},"임무완료":{"voiceline":"후우… 너무도 힘든 책무였어요… 지휘관님도 고생 많으셨습니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"고해성사를 하시려고요? 조, 좋아요! 이런 모습이라도 괜찮으시다면…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/touch.ogg"},"터치2":{"voiceline":"이, 이제 더는 못 움직여요…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/touch2.ogg"},"입수시":{"voiceline":"지, 지휘관님! 어, 어서 이 아이 좀 멈춰주세요! 이대로는…! 지휘관님을…! 다치게…! 할 거… 으아아아! 크, 큰일 날 뻔했다… 아아, 아이리스께 감사를…… 흑……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"으, 으아… 어떻게 이기긴 했는데… 머리가 어질어질… 정신을 잃을 것 같아요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901042/win_mvp.ogg"},"전투개시_e