[{"클뜯 id":901040,"클뜯 함순이 id":90104,"함순이 이름":"케르생","한글 함순이 + 스킨 이름":"케르생","영문 함순이 + 스킨 이름":"Kersaint","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901040/shipyard.png","설명":"보클랭급 구축함 - 케르생","자기소개":{"voiceline":"비시아 성좌 소속 보클랭급 대형 구축함 케르생입니다. 그 대전에서는 타르투 일행과 함께 툴롱에서… 아… 역시 기도가 모자랐던 거겠죠….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/profile.ogg"},"메인1":{"voiceline":"자료는 음… 여기 놓으면 되는 건가요? 영차… 부디 지휘관님의 업무가 수월히 진행되기를……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/main1.ogg"},"메인2":{"voiceline":"혹시 케르생이 방해된다면 언제든 말씀해 주세요. 그, 그러니까 눈을 어디에 둘지 몰라서 곤란하시다면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/main2.ogg"},"메인3":{"voiceline":"지휘관님께서 쳐다보시면 저도 모르게 쭈뼛쭈뼛해요… 죄송해요, 다 제가 익숙하지 않은 탓에……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/main3.ogg"},"전투개시":{"voiceline":"아이리스의 인도가 있기를…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/battle.ogg"},"상세확인":{"voiceline":"기도는 음… 동트기 전, 일출 때, 아침부터 낮까지 몇 시간마다, 저녁에 잠들기 전…… 총 8번 정도려나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/detail.ogg"},"드랍 설명":{"voiceline":"보클랭급 구축함 - 케르생","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 동료들이 돌아왔습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/expedition.ogg"},"실망":{"voiceline":"케르생 때문에 지휘관님이 이렇게 난폭하게… 흑… 제 기도가 부족한 탓이겠죠….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/feeling1.ogg"},"낯섦":{"voiceline":"동료들과 비교하면, 저는 지휘관님께 큰 도움이 되지는 못할 것 같아요… 만약 기도로 축복을 받을 수만 있다면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/feeling2.ogg"},"호감":{"voiceline":"타르투에게 가끔 어떻게 해야 매력적이고 어른스러운 여자가 될 수 있냐는 질문을 받아요. 지휘관님, 조언을 부탁드려도 될까요? 저는 잘 모르겠어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님께서 보셨을 때 저는 충분히 매력적인가요…? 그렇다면 기쁘겠지만, 만약 지휘관님 업무에 방해가 된다면… 그런 건… 괘, 괜찮으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/feeling4.ogg"},"사랑":{"voiceline":"제 매력으로 지휘관님의 일이 더 잘 진행될 수도 있겠네요… 아, 알겠습니다. 지휘관님만 괜찮으시다면 원할 때 언제든 불러주세요. 지휘관님을 위해서라면 기도든 심부름이든 뭐든 할 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님을 무사히 모항으로 인도해 주신 아이리스께 기도와 감사를 드리옵나이다. ……지휘관님도 같이… 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/home.ogg"},"hp 경고":{"voiceline":"계속 기도하면…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/hp_warning.ogg"},"로그인":{"voiceline":"맑고 고귀한 아이리스께 기도 드립나이다. 부디 저희에게 평온한 하루를 주시옵소서. 그리고 지휘관님께 신성한 가호가 깃들기를……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/login.ogg"},"실패":{"voiceline":"여, 역시 이런 몸으로는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/lose.ogg"},"우편":{"voiceline":"우편이 도착한 것 같아요. 지휘관님, 확인을 좀 부탁드려도 될까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/mail.ogg"},"임무":{"voiceline":"임무 목록은 여기…… 죄, 죄송합니다. 일부러 손을 만지려고 한 건 아니에요…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/mission.ogg"},"임무완료":{"voiceline":"성스러운 책무를 완수하신 것을 축하드립니다. …보상은 어떻게 할까요? 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/mission_complete.ogg"},"서약":{"voiceline":"영광스러운 아이리스께 기도 드립나이다. 부디 케르생과 지휘관님께 영원한 행복을 내려 주시옵소서. 사랑스러운 지휘관님, 모쪼록 앞으로도 케르생을 잘 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/propose.ogg"},"스킬":{"voiceline":"성스러운 빛이 여기에…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/skill.ogg"},"터치1":{"voiceline":"저, 저라도 괜찮으시면 지휘관님의 고민을 들려주실 수 있으실까요…? 해결할 수 있을지 어떨지는 보장할 수 없지만, 기도 정도라면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/touch.ogg"},"터치2":{"voiceline":"여, 역시 이 몸이 지휘관님의 마음을 어지럽히고 만 건가요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/touch2.ogg"},"입수시":{"voiceline":"보클랭급 대형 구축함 케르생이에요. 지휘관님께 아이리스의 가호가 깃들기를…… 모자라지만 모쪼록 잘 부탁드립니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/unlock.ogg"},"강화성공":{"voiceline":"지휘관님께 감사 드립니다. …아이리스의 가호가 깃들기를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아이리스께서 우리를 승리로 이끌어 주셨어요. 삼가 깊은 감사의 말씀을 올립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"같이 기도해 주시는 건 기쁘지만, 무, 무리는 마세요… 저 때문에 지휘관님이 곤란해지시는 건 주객전도니… 아아, 부디 용서를...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901040/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"케르생과 함께 기도하신다구요? 아, 네! 그럼… 항행 중에 폭풍우로부터 지켜주신 것, 무사히 모항까지 인도해 주신 것, 그리고 케르생의 소원을 들어주셔서 지휘관님께 믿음