[{"클뜯 id":406010,"클뜯 함순이 id":40601,"함순이 이름":"베저","한글 함순이 + 스킨 이름":"베저","영문 함순이 + 스킨 이름":"Weser","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406010/shipyard.png","설명":"베저호 항공모함","자기소개":{"voiceline":"아드미럴 히퍼급 4번함 자이틀리츠나, 호위항공모함 베저나 모두 전황 때문에 최종적으로 완성되지 못했어. 하지만, 지금 여기서는 내가 하고 싶은 일들을 할 수 있는 시간이 충분하니까, 그때의 한을 푼 셈이겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/profile.ogg"},"메인1":{"voiceline":"메탈 블러드의 항공모함은 다른 진영들에 비하면 아주 적어서, 연습할 때마다 손해보는 듯한 느낌이야...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/main1.ogg"},"메인2":{"voiceline":"\"불침 전함\"? ...아, 네가 말하는 게 누군지 알아. 나중에 그 존경할 만한 \"자이틀리츠\" 선배를 볼 기회가 있을지 모르겠네?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/main2.ogg"},"메인3":{"voiceline":"히퍼, 오이겐... 그녀들이랑 같이 전투할 수 있을 줄은 정말 생각도 못했어. 모두 지휘관 덕분이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/main3.ogg"},"전투개시":{"voiceline":"냉정과 인내심을 유지한다면 승리는 자연히 우리 몫이 될 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/battle.ogg"},"상세확인":{"voiceline":"지휘관, 설마 한가한 거야? 그럼 나 함재기 특훈하는 것 좀 도와줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 자이틀리츠——아니, 호위항공모함 베저, 착임 보고. 왜 이름이 두 개인지 궁금해? 침착해, 앞으로 천천히 알려줄게.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조 돌아왔어? 신경 안 쓰는 건 좀 아니지... 내가 먼저 가볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/expedition.ogg"},"실망":{"voiceline":"충고 하나 할게, 지휘관. 상태 안 좋으면, 휴가 내고 잠 좀자. 그 안 좋은 상태를 모든 이들에게 내비치지 말고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/feeling1.ogg"},"낯섦":{"voiceline":"전장은 언제나 예상하기 어려운 변수로 가득하지. 정해진 지령을 묵묵히 고수하는 것만으로는 승리를 잡을 수 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/feeling2.ogg"},"호감":{"voiceline":"페터는 훌륭하지만, 너무 빡빡해. 가끔은 \"시간\", \"계획\" 같은 귀찮은 단어들은 버리고 자신을 놓을 줄도 알아야 하는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/feeling3.ogg"},"기쁨":{"voiceline":"난 언제나 생각해. 우리가 어떻게 살지를 선택해야지, 생활이 우리를 결정하게 하면 안된다고. 그러니까, 난 계속 내 리듬에 맞춰서 살 거야. 지휘관은, 현재 자신의 생활을 좋아해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/feeling4.ogg"},"사랑":{"voiceline":"보아하니까, 이제 내 스텝을 따라올 수 있게된 것 같네. 아니면, 내가 점점 지휘관의 스텝에 적응이 된 건가? 하하, 아무튼, 네가 옆에 있으면... 확실히 마음이 놓여.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 정말 바쁘게 일하는구나... 한숨 돌리고 좀 쉬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/home.ogg"},"hp 경고":{"voiceline":"아직 초조해할 때가 아닌데…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/hp_warning.ogg"},"로그인":{"voiceline":"급급하게 일에 뛰어들기 전에, 앉아서 커피 한 모금을 즐겨보는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/login.ogg"},"실패":{"voiceline":"음, 함재기 운용은 역시 아직은 덜 익숙해...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/lose.ogg"},"우편":{"voiceline":"네 편지야. 긴급한 내용이 아니면, 나중에 봐도 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있어? 괜찮아, 우선 당장하고 있는 일부터 끝내고 확인해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/mission.ogg"},"임무완료":{"voiceline":"임무 완료했어. 안심해, 보상은 도망가지 않으니까, 이따가 수령하면 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/mission_complete.ogg"},"서약":{"voiceline":"서약의 의식? 급할 거 없어. 까먹지도 않았고, 갑자기 사라지지도 않으니까. 그게 아니면... 내가 지휘관한테 그정도로 신뢰가 없나? 하하, 농담이야. 기나긴 앞으로의 시간 동안에도 잘 부탁해, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/propose.ogg"},"스킬":{"voiceline":"때가 왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/skill.ogg"},"터치1":{"voiceline":"힘들면 얼마든지 쉬어. 누가 오면, 내가 깨워줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/touch.ogg"},"터치2":{"voiceline":"너의 용기는... 아마 표현 방식을 바꿔보는 게 더 낫겠는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/touch2.ogg"},"입수시":{"voiceline":"중순양함 자이틀리츠——아니, 호위항공모함 베저, 착임 보고. 왜 이름이 두 개인지 궁금해? 침착해, 앞으로 천천히 알려줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/unlock.ogg"},"강화성공":{"voiceline":"더 강한 장비를 다룰 수 있을 것 같아, 고마워, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"예상대로 승리한 건가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['프리드리히 데어 그로세'] : 네 계획은 뭐야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406010/couple_encourage1.ogg"}