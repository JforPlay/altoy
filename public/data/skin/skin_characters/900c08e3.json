[{"클뜯 id":201090,"클뜯 함순이 id":20109,"함순이 이름":"크레센트","한글 함순이 + 스킨 이름":"크레센트","영문 함순이 + 스킨 이름":"Crescent","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201090/shipyard.png","설명":"C급 구축함·크레센트 (H48)","자기소개":{"voiceline":"C클래스 구축함인 크레센트야. 자매함들과 함께 본국함대 소속이었지만 홍해와 인도양에도 갔어. 어린애라고 생각하고 물로 보면 큰코다칠 거라고. 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/profile.ogg"},"메인1":{"voiceline":"무슨 일 있으면 나한테 맡기라고! 에에…… 아, 아무 것도 아니라고? ──아하하…… 하하……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/main1.ogg"},"메인2":{"voiceline":"난 엄~청 강하니까 저런 송사리들은 날 보기만 해도 달아난다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/main2.ogg"},"메인3":{"voiceline":"나처럼 귀여운 애한텐 잘 대해주라고! 그야, 귀귀, 귀여우니까…… 알았지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/main3.ogg"},"전투개시":{"voiceline":"「햇병아리들, 쉽게 죽도록 두진 않겠어!」 ……차, 창피해─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/battle.ogg"},"상세확인":{"voiceline":"이런 눈으로 타인을 보다니, 분명 이런 짓이나 저런 짓 상상하고 있는 거지! 앗…… 그건…… 파렴치한… 우와아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/detail.ogg"},"드랍 설명":{"voiceline":"C급 구축함·크레센트 (H48)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관. 의뢰팀 언니들이 돌아왔어. 나도 어른이고, 이번엔 나도 의뢰 임무 보내줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/expedition.ogg"},"실망":{"voiceline":"지휘관보다 내가 더 어른이잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/feeling1.ogg"},"낯섦":{"voiceline":"지휘관 같은 사람에게 친구 따위 있을 리 없잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/feeling2.ogg"},"호감":{"voiceline":"지휘관…… 저기…… 전에 심하게 말해서…… 그게…… 그, 그래! 가 아니라…… 우우── 정말, 아무것도 아니야! 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 왜 나 같은 애한테 다정하게 대해 주는 거야… 나, 긴장할 때 항상 차갑게 대하기만 하고…… 그래서 항상 미안하다고 생각해서…… 가슴이 찢어질 것 같아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/feeling4.ogg"},"사랑":{"voiceline":"지휘관. 다음에 내가 심한 말 하면 혼내도 된다구? 지휘관을 화나게 할 바에야 나…… 어… 내가 소중하니까, 그 정도로 화내지 않아? ………우우…… 정말, 바보……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"아군한테 부딪히지 않았지?! 지휘관??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 뭔 일 없슈?… 앗… 아냐(크흠) ──아무 말 안 했다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/login.ogg"},"실패":{"voiceline":"우리 팀은 제대로 하라고! 앗, 죄, 죄송해요! 속상했어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/lose.ogg"},"우편":{"voiceline":"자, 편지야. 핫, 너 같은 사람한테 러브레터를 보낼 리…… (곁눈질로 엿본다)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/mail.ogg"},"임무":{"voiceline":"미션! 미션이라고! 정말이지, 맨날 내가 말해야 아냐고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/mission.ogg"},"임무완료":{"voiceline":"이런 보너스론, 전혀 성에 안 차── 에에에!? 가져가지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/mission_complete.ogg"},"서약":{"voiceline":"나같은 애랑 정말 괜찮겠어? 정말로? 진짜 후회 안 해? 후, 후회해도 이제 늦었다? ……흐, 흥! 날 선택해준 걸 봐서, 기꺼이 평생 어울려줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/propose.ogg"},"스킬":{"voiceline":"난 이제 어른이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/skill.ogg"},"터치1":{"voiceline":"이런 건 애들 장난이야. 어…… 이제 안 만져? ……그, 그렇지. 난 어른이니까…… 아하하……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/touch.ogg"},"터치2":{"voiceline":"아아, 읏…… 거긴……!! 어른이니까 괜찮다고!? 바, 바보 취급 하지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관? 전쟁에 전혀 익숙해 보이지 않는데. 난 C클래스의 크레센트, 어린애 아니야! 나 이래 봬도 경험 풍부하거든. 아무것도 무섭지 않아. 아·무·것·도 무섭지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/unlock.ogg"},"강화성공":{"voiceline":"이걸로 더 어른에……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 녀석들의 방해만 없었다면 더 빨리 이겼는데! 어…… 그, 그런 표정 짓지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"N","ex_chat_status":0},{"클뜯 id":201099,"클뜯 함순이 id":20109,"함순이 이름":"크레센트","한글 함순이 + 스킨 이름":"크레센트·改","영문 함순이 + 스킨 이름":"Crescent (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https