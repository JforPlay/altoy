[{"클뜯 id":107020,"클뜯 함순이 id":10702,"함순이 이름":"렉싱턴","한글 함순이 + 스킨 이름":"렉싱턴","영문 함순이 + 스킨 이름":"Lexington","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107020/shipyard.png","설명":"렉싱턴급 항공모함·렉싱턴 (CV-2)","자기소개":{"voiceline":"어머, 난 항공모함·렉싱턴이야.\n 다정하다고? 모두의 언니니까~ 내 입장에선 지휘관도 귀여운 후배인걸. 새러토가가 노력하고 있는 모습을 보면 언니도 안심돼. 그 애도 잘 봐줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/profile.ogg"},"메인1":{"voiceline":"동생들만큼 활약하진 않았지만, 언니로서의 매력에는 자신 있어. 그렇지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/main1.ogg"},"메인2":{"voiceline":"어머머, 새러토가도 참 어디에 숨은 거람? 손이 가는 애라니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/main2.ogg"},"메인3":{"voiceline":"눈이 요염해? 아이돌은 눈도 요염해야지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/main3.ogg"},"전투개시":{"voiceline":"모두, 지휘관을 위해 승리를 되찾자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/battle.ogg"},"상세확인":{"voiceline":"어머나, 눈살 찌푸리고, 지휘관도 큰일이네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/detail.ogg"},"드랍 설명":{"voiceline":"렉싱턴급 항공모함·렉싱턴 (CV-2)","voicelink":null},"의뢰 완료":{"voiceline":"어머 어머, 의뢰조 애들이 돌아왔나 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/expedition.ogg"},"실망":{"voiceline":"어머, 누나가 뭐든 받아준다고 생각하면 큰 착각인걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/feeling1.ogg"},"낯섦":{"voiceline":"아이돌은 모두에게 미소를 가져다주는 직업이야. 물론 지휘관한테도, 우후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/feeling2.ogg"},"호감":{"voiceline":"최근 산호해 꿈을 꿀 때 항상 지휘관이 있어서 어쩐지 안심돼. 왜일까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 내 매니저 해보지 않을래? 유능하고 날 잘 알고, 믿음직스러운 건 지휘관 정도 밖에 생각 안 난다니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/feeling4.ogg"},"사랑":{"voiceline":"솔로 라이브? 어머, 아직 그런 계획 없어. 하지만 누구 씨가 선물로 반지를 주면, 어쩌면 매일 개최될지도? 게다가 관객도 한 명뿐이고, 응~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어머, 얼굴에 뭐가 묻어있어. 닦아줄 테니까 가만히 있어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/home.ogg"},"hp 경고":{"voiceline":"내 노래로 모두를 응원할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/hp_warning.ogg"},"로그인":{"voiceline":"어머~지휘관? 오늘은 어디로 갈 거야? 괜찮아. 내가 있으면 하늘을 나는 크레인이라도 놓치지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/login.ogg"},"실패":{"voiceline":"어머나, 저쪽 페이스에 따라갈 수 없게 돼버렸네. 우선 퇴각하자?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/lose.ogg"},"우편":{"voiceline":"새로운 편지가 왔어. 바쁘면 내가 대신 답장할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/mail.ogg"},"임무":{"voiceline":"어머, 지휘관. 아직 완료하지 않은 임무가 있는걸~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/mission.ogg"},"임무완료":{"voiceline":"함재기들아, 미션 보너스를 지휘관에게 가져다줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/mission_complete.ogg"},"서약":{"voiceline":"어머, 어머어머어머~ 지휘관은 언제나 누나를 기다리게 한다고 생각했는데~ 우후훗, 관객이 한 명뿐인 라이브 티켓은 곧 발매야~ 개최 기간은── 영원히야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/propose.ogg"},"스킬":{"voiceline":"함재기들아, 가렴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/skill.ogg"},"터치1":{"voiceline":"지휘관, 왠지 못된 남동생 같은데♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/touch.ogg"},"터치2":{"voiceline":"어머머, 지휘관은 남동생으론 불만이야?~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/touch2.ogg"},"입수시":{"voiceline":"평안하신가요~ 지휘관 씨♪ 나는 렉싱턴이야. 이름은 예전 독립전쟁에서의 첫 전장에서 유래했다고 들었지. 아이돌로서 마음이 넓어야 한다고 생각하는데, 당신도 그렇게 생각하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/unlock.ogg"},"강화성공":{"voiceline":"흐흥, 갑자기 노래하고 싶은 기분이야. 들어줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우후훗, 레이디 렉스는 폼이 아니라구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['새러토가'] : 새러토가, 장난도 적당히 하렴","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/couple_encourage1.ogg"},{"voiceline":"['요크타운'] : 끝나면 같이 차라도 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107020/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null