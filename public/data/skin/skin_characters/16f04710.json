[{"클뜯 id":10500030,"클뜯 함순이 id":1050003,"함순이 이름":"미나토 아쿠아","한글 함순이 + 스킨 이름":"미나토 아쿠아","영문 함순이 + 스킨 이름":"Minato Aqua","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500030/shipyard.png","설명":"아, 안녕이쿠아~! 나는 hololive 소속 게임 메이드, 미나토 아쿠아. 우, 우우…… 이런 모습으로 인사해야 한다는건 듣지 못했다구~!","자기소개":{"voiceline":"나는 hololive 소속 버츄얼 메이드! 엉뚱하고 덜렁댄다는 이야기를 듣긴 하지만… 그렇지 않거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/profile.ogg"},"메인1":{"voiceline":"평소에 메이드 복장을 하고 있지만, 이러면 쉽게 진정되지가 않아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/main1.ogg"},"메인2":{"voiceline":"계속 쳐다보지 말란 말이야! 부끄럽다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/main2.ogg"},"메인3":{"voiceline":"계속 보면 나한테 크게 한턱 쏴야할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/main3.ogg"},"전투개시":{"voiceline":"아쿠아호, 전탄 발사! … 에? 이 버튼이 아니야?!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/battle.ogg"},"상세확인":{"voiceline":"이 장비 위에 올라서면 지휘관보다 훨씬 커! … 아마도.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/detail.ogg"},"드랍 설명":{"voiceline":"아, 안녕이쿠아~! 나는 hololive 소속 게임 메이드, 미나토 아쿠아. 우, 우우…… 이런 모습으로 인사해야 한다는건 듣지 못했다구~!","voicelink":null},"의뢰 완료":{"voiceline":"지휘관! 의뢰조가 몇 억조의 물자를 가지고 돌아왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/expedition.ogg"},"실망":{"voiceline":"비록 짧은 시간이었지만 저, 미나토 아쿠아는 곧 졸업합니다. 지금까지 보내주신 응원 감사드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, A·M·T라고 알아? 천사같은 아쿠아의 줄인 말이라구~ 하하하, 마음껏 숭배하도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/feeling2.ogg"},"호감":{"voiceline":"정신없는 메이드? 쓸모없는 천사?!! 너무하잖아, 지휘관! 물 끓이는 정도는 전혀 문제 없다구!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/feeling3.ogg"},"기쁨":{"voiceline":"이, 것, 은 아쿠아가 로열 메이드에게서 받은 특훈의 결과물! 정통 로열 홍차! 역시 나야. 이렇게 짧은 시간 내에 이만큼 배워오다니! …… 맛이 이상해? 그럴 리가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/feeling4.ogg"},"사랑":{"voiceline":"지휘관과 주인님 중에 지휘관은 어떤 호칭이 더 마음에 들어? 에? 직접 정하라구? 그렇다면 일 할 때는 지휘관, 쉴 때는 주인님. 이렇게 정했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/feeling5.ogg"},"터치3":{"voiceline":"헤헤헤헤, 간지러워, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/headtouch.ogg"},"모항귀환":{"voiceline":"‘돌아오셨군요, 주인님.’ 헤헤, 방금 그 대사, 굉장히 메이드 같은 느낌이지 않았어?! ~지휘실의 청소와 오늘 저녁밥은 지휘관에게 부탁할게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/home.ogg"},"hp 경고":{"voiceline":"안돼~~~! 지휘관, 철수하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/hp_warning.ogg"},"로그인":{"voiceline":"안녕이쿠아~ 나는 게임을 좀 더 할테니까 지휘관은 일 힘내!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/login.ogg"},"실패":{"voiceline":"망했다——! 죄송합니다, 죄송합니다, 죄송합니다. 정말 죄송합니다!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/lose.ogg"},"우편":{"voiceline":"지휘관의 우편, 하나만 훔쳐보면… 으악! 왜 이렇게 읽기가 어려운 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/mail.ogg"},"임무":{"voiceline":"지휘관이 임무를 완료하기 전까지 계속 곁에 있어 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/mission.ogg"},"임무완료":{"voiceline":"임무 완료~! 계속 열심히 일하는 지휘관을 보고 있으니 나도 굉장히 힘든 느낌이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/mission_complete.ogg"},"서약":{"voiceline":"이건… 서약의 반지?! 지휘관! 잠, 잠, 잠깐… 지금은 주인님이라고 불러야 맞는 건데, 아니, 그것도 아닌데… 만약 이걸 받으면 더 이상 주인님이 아닌데, 그렇다면… 달링… 인가? 엄청 부끄러운 느낌이야… 이 반지, 미나토 아쿠아가 받아도 돼? 에헤헤, 고마워, 달링~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/propose.ogg"},"스킬":{"voiceline":"충분, 충분.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/skill.ogg"},"터치1":{"voiceline":"왜 그래? 최강 메이드인 나에게 부탁할 것이라도 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/touch.ogg"},"터치2":{"voiceline":"안, 돼!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/touch2.ogg"},"입수시":{"voiceline":"아, 안녕이쿠아~! 나는 hololive 소속 게임 메이드, 미나토 아쿠아. 우, 우우…… 이런 모습으로 인사해야 한다는건 듣지 못했다구~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/unlock.ogg"},"강화성공":{"voiceline":"이러면 강해진 거야? 그렇구나, 이해 이해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후훗! 너는, 약하고, 나는, 강해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_e