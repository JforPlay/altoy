ane/main/audio/voiceline/10500031/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 안녕이쿠아~! 반가워. 나는 hololive 소속 게임 메이드, 미나토 아쿠아! 최강 메이드의 실력을 보여주겠어!!!!!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관도 라이브에 흥미가 있어? 잘 됐다! 그렇다면 초보자 버전으로 24시간 연속 방송, 아니면 극한의 테트리스. 어떤 게 좋아? 골라봐~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500031/feeling5.ogg"},"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"후~ 오늘은 늦잠을 자지 않아서 다행이야. 그렇다면 지휘관, 이제 뭘 해야 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500031/login.ogg"},"실패":{"voiceline":"스-------- 에? 방금 한순간의 기억이 사라진 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500031/lose.ogg"},"우편":null,"임무":{"voiceline":"…임무? 지휘관, 사실 방금 밖으로 나가면 죽는 병에 걸렸어. 임무는 맡겨둘게!!!!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500031/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"게임 할 거야? 나는 엄청 강하다구. 마음의 준비를 하는 게 좋을걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500031/touch.ogg"},"터치2":null,"입수시":{"voiceline":"아, 아. 모두들! 안녕이쿠아~ 그래서 오늘은 벽람항로의 라이브를 진행할 거라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500031/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"홈웨어","상점 id":70269,"상점 카테고리 id":20,"스킨 태그":"배경, 브금","입수 영상":"X","재화":900,"기간":"한정 (2019/12/25)","진영":"HOL