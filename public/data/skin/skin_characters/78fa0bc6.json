[{"클뜯 id":301290,"클뜯 함순이 id":30129,"함순이 이름":"시마카제","한글 함순이 + 스킨 이름":"시마카제","영문 함순이 + 스킨 이름":"Shimakaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301290/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301290/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301290/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301290/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301290/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301290/shipyard.png","설명":"시마카제형 구축함・시마카제","자기소개":{"voiceline":"시마카제급 구축함 시마카제는 최고봉의 속력과 뇌장 화력을 자랑하며, 수뢰전대의 핵심인 함대형 구축함 중에서도 톱입니다! 훗흥, 어떤 전투라도 이 시마카제에게 맡겨주시길!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/profile.ogg"},"메인1":{"voiceline":"의장 상태가 좋군요... 오늘은 언제든지 만반의 상태로 출격할 수 있습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/main1.ogg"},"메인2":{"voiceline":"이 슈즈말인가요? 사실, 이걸 장비하고 있는 덕분에 남들보다 더 빨리 달릴 수 있답니다! 흐흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/main2.ogg"},"메인3":{"voiceline":"사쿠라 엠파이어에서 도를 가진 분들은 많습니다…… 기회가 된다면 꼭 빌려서 써보고 싶네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/main3.ogg"},"전투개시":{"voiceline":"이 시마카제가 지휘를? 괜찮습니다! 맡겨주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/battle.ogg"},"상세확인":{"voiceline":"호쇼 선배가 만든 당근 케익, 또 먹고 싶네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/detail.ogg"},"드랍 설명":{"voiceline":"시마카제형 구축함・시마카제","voicelink":null},"의뢰 완료":{"voiceline":"으음… 의뢰 나갈 땐 습격당하거나 하진 않겠죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/expedition.ogg"},"실망":{"voiceline":"잘못을 뉘우치시겠다면, 용서해드리지 못할 것도 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/feeling1.ogg"},"낯섦":{"voiceline":"시마카제는 구축함 중에서 최강! 이라고 믿고 싶습니다만, 역시 진정한 최강이 되려면 훈련도 출격도 최선을 다해 임해야겠죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/feeling2.ogg"},"호감":{"voiceline":"종종 성급하단 소릴 듣습니다만, 감투 정신이 있다는 건 좋은 점이라고 생각하지 않으세요? 또, 전력을 다하지 않으면 나중에 후회할 수도 있다고 생각하지 않으세요? 헤헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/feeling3.ogg"},"기쁨":{"voiceline":"지휘관공은 지금까지 무엇을 위해 싸워오셨나요? 조금 신경 쓰여서… 아, 하지만 무엇을 위해서든, 이 시마카제, 온 힘을 다해 도와드리겠습니다! ……이번엔 혼자 너무 앞서가지 않는다니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/feeling4.ogg"},"사랑":{"voiceline":"오늘 집무 끝나면 같이 어디 가시지 않겠어요? ……그, 그야, 업무 중엔 지휘관공과 둘만 있는 시간이 별로 없으니까… 아아, 정말, 지휘관공과 둘만의 시간을 갖고 싶다구요! 괜찮……나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/feeling5.ogg"},"터치3":{"voiceline":"후먀아아아아아…… 귀, 귀는 만지시면……! 힘이 안 들어가…… 아아아아아아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/headtouch.ogg"},"모항귀환":{"voiceline":"어, 어서 오세요, 지휘관공! ……아무것도 아닙니다! 조금 걱정됐을 뿐이라……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/home.ogg"},"hp 경고":{"voiceline":"기관부, 조금만 더 버텨줘…… 부탁이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/hp_warning.ogg"},"로그인":{"voiceline":"지휘관공도 질질 끄는 걸 좋아하지 않는 모양이군요. 오늘도 함께 화이팅 해봐요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/login.ogg"},"실패":{"voiceline":"바, 반성하겠습니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/lose.ogg"},"우편":{"voiceline":"지휘관공, 새로 온 우편은 어서 확인하는 게 좋다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/mail.ogg"},"임무":{"voiceline":"오오, 아직 완료되지 않은 임무가 있군요! 보상을 위해 전력을 다해 임하도록 하죠! 어서요, 지휘관공!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/mission.ogg"},"임무완료":{"voiceline":"임무 완료군요! 자, 자, 어서 보상에 뭐가 들었는지 보도록 하죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/mission_complete.ogg"},"서약":{"voiceline":"……에에엑! 긴급 임무 때문에 집합하는 거 아니었나요! 아니 그보다, 이 반지는…… 속았다~! 직접 말씀하셔도 거절하지 않을 텐데, 어째서 이런 짓을 하시는 건가요, 정말!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/propose.ogg"},"스킬":{"voiceline":"어떤 필살기라고 말하면 좋을까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/skill.ogg"},"터치1":{"voiceline":"엇, 저 뭔가 실수라도 했나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/touch.ogg"},"터치2":{"voiceline":"꺅! 뭐 하시는 거예요! 정말이지…… 뭐, 이번만은 용서해드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/touch2.ogg"},"입수시":{"voiceline":"전세계에 유일한 시마카제급 구축함——시마카제 착임 보고! 당신이 바로 지휘관공이죠~? 앞으로 동료로서 목표를 향해 함께 전진해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/unlock.ogg"},"강화성공":{"voiceline":"좀 더 빠르게… 강해지겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아, 이번에도 1위를 차지했습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/win_mvp.ogg"},"전투개시_ex":{"voiceline":"졌다고 해서 화내진 말아주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/battle_ex.ogg"},"상세확인_ex":{"voiceline":"무언가를 지키기 위해 중요한 건 무기가 아니라, 지키고자 하는 마음이에요. 지휘관공도 그렇게 생각하지 않으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"시마카제, 의뢰팀의 무사를 확인했습니다! 평화로운 게 제일이죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/expedition_ex.ogg"},"사랑_ex":{"voiceline":"집무가 끝나면 같이 밥 먹고, 쇼핑하고…… 서방님과의 둘만의 시간은 아무리 있어도 모자라요. 에헤헤, 시마카제를 앞으로도 잘 부탁드려요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"하냐아아아………","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어, 어서 오세요, 지휘관공! 걱정했다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"안녕하세요! 서방님~♡ 에헤헤, 우선 뽀뽀부터… 아, 지금은 업무중이니까, 지휘관공, 이네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"임무 완료입니다! 시마카제, 미리 보상을 가져왔어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관공, 시마카제가 도와드릴 일이 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/touch_ex.ogg"},"터치2_ex":{"voiceline":"귀까지 만졌으면 더 위험했어요… 우으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"불가능도 가능으로 만드는, 시마카제 함대에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['르 트리옹팡', '르 말랭'] : 나보다 빠르다고요? 정말로!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301290/couple_encourage1.ogg"},{"voiceline":"['후부키', '시라유키', '아야나미', '아카츠키', '히비키', '이카즈치', '이나즈마', '시라츠유', '유다치', '시구레', '유키카제', 31017, '