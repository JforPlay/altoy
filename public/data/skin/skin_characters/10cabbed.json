[{"클뜯 id":401020,"클뜯 함순이 id":40102,"함순이 이름":"Z2","한글 함순이 + 스킨 이름":"Z2","영문 함순이 + 스킨 이름":"Z2","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401020/shipyard.png","설명":"1934년형 구축함 - Z2 게오르크 틸레 ","자기소개":{"voiceline":"게오르크 틸레, 또 다른 이름은 Z2, 실험적으로 건조된 1934년형 구축함입니다. 뛰어난 기동력으로 상대를 농락할 예정이었습니다만…… 아무것도 아닙니다. 지금 건 못 들은 걸로 해 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/profile.ogg"},"메인1":{"voiceline":"지휘관님, 되도록 레베 군처럼 날뛰거나 하진 말아 주십시오. 기절시키는 건 귀찮고, 상사에게 손을 대고 싶지도 않습니다. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/main1.ogg"},"메인2":{"voiceline":"한가하시다면, 네, 서류를 전부 가져다 드릴 테니 각오해 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/main2.ogg"},"메인3":{"voiceline":"이 아이의 이름은 레베 군입니다. 네, 잘못 들으신 게 아닙니다, 레베 군입니다. 귀엽네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/main3.ogg"},"전투개시":{"voiceline":"매복에 주의. 너무 앞으로 나가지 않도록……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 모두에게 여러 가지 옷을 갈아입히는 취미를 가지고 계십니까? 라고 질문 드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/detail.ogg"},"드랍 설명":{"voiceline":"1934년형 구축함 - Z2 게오르크 틸레","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 귀환했습니다. 마중을 나가서, 그녀들을 치하하는 것이 도리겠죠. …필요하다면 저도 동행하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/expedition.ogg"},"실망":{"voiceline":"저는 괜찮습니다만, 레베 군에게서 떨어져 주셨으면 합니다. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 레베 군에 관해 알고 싶으신 게 있으십니까? …저에 관해 알고 싶으신, 겁니까? 별난 일도 다 있군요. 네, 생각 좀 해보겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/feeling2.ogg"},"호감":{"voiceline":"또 잡담이십니까? 저를 알고 있으면, 맞장구 이상의 대답이 돌아오지 않는다는 것이 자명한 이치임에도. 아니면 이 무미건조한 대사를 즐기고 계신 겁니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/feeling3.ogg"},"기쁨":{"voiceline":"별난 생각을 잔뜩 가진 지휘관님입니다만, 레베 군에게 휘둘려 왔던 저에게는 지휘관님과 같은 타입이 딱 알맞은 걸지도 모르겠습니다. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 저와의 관계를 더욱 진전시키고 싶으시다면, 평소처럼…… 그대로 말씀하시고 싶으신 걸 말씀 하시고, 하시고 싶은 걸 해 주십시오. 그걸로 충분합니다. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"분부 하신 대로 전과 보고를 정리했습니다. 확인 부탁 드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/home.ogg"},"hp 경고":{"voiceline":"포탑 침수…… 난감합니다. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 어째서 항상 저보다 늦게 오시는 겁니까? 라고 질문 드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/login.ogg"},"실패":{"voiceline":"퇴각 엄호, 하겠습니다. 레베 군 덕분에 익숙합니다, 이런 건. 안심하십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/lose.ogg"},"우편":{"voiceline":"우편입니다. 네, 당장에라도 개봉해서 확인하는 것을 추천 드립니다. 그러지 않으면, 누가 지휘관님 아니랄까 봐 금방 잊어버리시니까요. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/mail.ogg"},"임무":{"voiceline":"새로운 임무입니다. 알기 쉽게 정리했습니다. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/mission.ogg"},"임무완료":{"voiceline":"임무 보수를 받는 건 상관없습니다만, 지휘관님에 대한 제 평가는 내려갑니다. 괜찮으십니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/mission_complete.ogg"},"서약":{"voiceline":"이것이 결혼이군요. 확고한 유대를 가지게 된 이 기분…… 제 얼굴이 빨개졌다, 라고 하셨습니까? ……죄송합니다, 지금 제 얼굴, 찍어주시지 않으시겠습니까? 빨갛게 된 제 얼굴, 본 적이 없으니까요. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/propose.ogg"},"스킬":{"voiceline":"빨라질 수 있어. 조금만 더.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/skill.ogg"},"터치1":{"voiceline":"네, 물론, 말씀하신 그대로입니다. 그 밖에 용건은…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/touch.ogg"},"터치2":{"voiceline":"용기 있는 행동 중에서도 최악인 부류라고 생각합니다. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/touch2.ogg"},"입수시":{"voiceline":"Z2 (게오르크 틸레) 라고 합니다. 명령을 내려주십시오. 하지만 명령에 부실한 점이 있다면, 생각 좀 해보겠습니다. 모쪼록 잘 부탁 드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/unlock.ogg"},"강화성공":{"voiceline":"이 이상 강화되면, 결함이 생기는 건 아닐까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리에 취해 져 버리는 사례는 셀 수 없이 많습니다. 경계를 게을리하지 않도록, 부디 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['Z1'] : 레베 군, 조심하세요, 뒤처리는 귀찮으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/ma