[{"클뜯 id":702040,"클뜯 함순이 id":70204,"함순이 이름":"키로프","한글 함순이 + 스킨 이름":"키로프","영문 함순이 + 스킨 이름":"Kirov","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702040/shipyard.png","설명":"키로프급 경순양함—키로프","자기소개":{"voiceline":"Здравствуй(안녕), Товарищ Офицер(지휘관 동지), 난 한 명의 전사, 키로프야. 이런 사소한 일은 중요하든 아니든 고민할 필요 없어, 우리의 사업 앞에서는 모두 언급할 필요도 없다고. 우리 함께 붉은 내일을 위해 분투하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/profile.ogg"},"메인1":{"voiceline":"약자만이 줄곧 고수하고, 강자는 영원히 진격의 길로 나아간다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/main1.ogg"},"메인2":{"voiceline":"영광은 우리로 하여금 굳건한 의지를 더욱 강하게 하고, 시간의 시련을 이겨 내게 할 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/main2.ogg"},"메인3":{"voiceline":"난 모두를 지켜주고, 모두가 웃는 내일이 보고 싶어. 그래서 끊임없이 전진할 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/main3.ogg"},"전투개시":{"voiceline":"Давай, пойдём на войну(가자, 크게 한 탕 벌여보자)!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/battle.ogg"},"상세확인":{"voiceline":"어둠이든, 운명이든, 우리의 사업을 막을 순 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/detail.ogg"},"드랍 설명":{"voiceline":"키로프급 경순양함—키로프","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완성됐어. 같이 가서 맞이해 주자. 고생한 동지들을 푸대접해서는 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/expedition.ogg"},"실망":{"voiceline":"미안한데, 넌 이미 \"동지\"라고 불릴 자격이 없다고 생각한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/feeling1.ogg"},"낯섦":{"voiceline":"\"만약\"이라는 말에 속지 마, 지휘관 동지. 네가 선택한 것이 바로 너의 진실이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/feeling2.ogg"},"호감":{"voiceline":"그래, 잘했어, Товарищ Офицер(지휘관 동지), 자신이 선택한 길은 관철해 나가야 해. 자, 우리가 얼마나 더 나아갈 수 있는지 보자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/feeling3.ogg"},"기쁨":{"voiceline":"난 항상 너와 함께할 거야. 네가 길을 잃고 헤매면, 나는 조금도 거리낌 없이 너에게 주먹을 한 방 먹일 거니까, 앞으로 얼마든 나아가. 지휘관 동지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/feeling4.ogg"},"사랑":{"voiceline":"조국을 위해서 만이 아니라, 어떤 특별한 사람을 위해 싸운다, 이게 바로 연애... 그랬군, \"연애\"가 이토록 피를 끓게 하는 것이었다니! 네가 옆에 있으면, 뭐든지 해낼 수 있을 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"Хороший бой, Товарищ Офицер!(멋진 전투였어, 지휘관 동지)! 너의 분투하는 모습이 모항의 신문에 장식될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/home.ogg"},"hp 경고":{"voiceline":"아직이야, 아직 안 끝났어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/hp_warning.ogg"},"로그인":{"voiceline":"Товарищ Офицер(지휘관 동지), 마침 잘 왔다. 오늘도 적들에게 \"Сплоченность и дружба(단합된 우애)\"가 무엇인지 한 수 가르쳐 주자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/login.ogg"},"실패":{"voiceline":"큭...... 우리의 사업이 완성되기 전에는 쉽게 쓰러지지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/lose.ogg"},"우편":{"voiceline":"편지가 있어. 어서 확인해봐, 동지는 당연히 많을수록 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/mail.ogg"},"임무":{"voiceline":"서둘러, Товарищ Офицер(지휘관 동지), 임무에 도전하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/mission.ogg"},"임무완료":{"voiceline":"네가 분명히 해낼 거라고 믿고 있었어, Товарищ Офицер(지휘관 동지), 이건 보상이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/mission_complete.ogg"},"서약":{"voiceline":"세상과 사랑하는 사람 중 뭘 보호할 거냐고? лупый вопрос(멍청한 질문이네), 당연히 둘 다지. 난 이렇게 결심할 거고, 해낼 수 있는 능력도 있어. Товарищ Офицер(지휘관 동지), 함께 손잡고 나아가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/propose.ogg"},"스킬":{"voiceline":"Докладывает Киров!!(키로프 보고!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/skill.ogg"},"터치1":{"voiceline":"손잡고 나아가자, Товарищ Офицер(지휘관 동지)!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/touch.ogg"},"터치2":{"voiceline":"지금은 결코 이런 일을 할 시간이 없다고, Товарищ Офицер(지휘관 동지).","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/touch2.ogg"},"입수시":{"voiceline":"유례없는 나라와 자유의 후손, 바로 나 키로프다! 가자, Товарищ Офицер(지휘관 동지), 함께 우리의 위대한 업적을 완성하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/unlock.ogg"},"강화성공":{"voiceline":"이 힘만 있다면 반드시......!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우리의 발걸음은 영원히 쉬지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"개인의 리더십보다는 동료와 어깨를 나란히 하겠다는 의지를 보여주는 게 중요해. 물론 너는 이 방면에서 아주 뛰어나다는 것에 의문의 여지가 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702040/home_ex.ogg"