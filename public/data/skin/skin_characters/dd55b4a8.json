[{"클뜯 id":899010,"클뜯 함순이 id":89901,"함순이 이름":"생 루이","한글 함순이 + 스킨 이름":"생 루이","영문 함순이 + 스킨 이름":"Saint Louis","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899010/shipyard.png","설명":"중순양함 - 생 루이","자기소개":{"voiceline":"고향이 전화에 전란에 휩싸이는 바람에 한 번 건조 자체가 수포로 돌아간 나는, 바야흐로 환상의 구현에 불과하다…허나, 지휘관, 당신이 이끌어주는 한, 당신이 가는 길을 방해하는 건 이 내가 떨쳐내주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/profile.ogg"},"메인1":{"voiceline":"지휘관, 당신의 시간은 잡무에 허비되어선 안 된다. 여기는 내가 맡도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/main1.ogg"},"메인2":{"voiceline":"전우들 사이에 다툼이 있다면, 그 중재는 내게 맡겨주길 바란다. 여하튼 내 특기니까 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/main2.ogg"},"메인3":{"voiceline":"나는 싸움에서 이기면 그걸로 그만이지만…지휘관, 당신은 더욱 멀리 내다볼 줄 알아야 한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/main3.ogg"},"전투개시":{"voiceline":"동등하게 파멸을 안겨주마…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/battle.ogg"},"상세확인":{"voiceline":"지휘관, 당신도 신에게 기도를 올리는 것인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 - 생 루이","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰에 나갔던 전우들이 돌아오는 게 보였다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/expedition.ogg"},"실망":{"voiceline":"이곳에 있는 전우들은 하나 같이 의인이다…당신만 빼고 말이야. 죄인이여, 담담히 신의 심판을 기다리는 게 좋을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/feeling1.ogg"},"낯섦":{"voiceline":"여기는 내가 미래를 보내게 될 장소……그렇다면 이곳은, 과연 소돔일 것인가, 아니면 가나안인가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/feeling2.ogg"},"호감":{"voiceline":"전우들의 얼굴은 마치 근심이 하나도 없는 듯 눈부시다. 여기는 그녀들의 가나안인가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/feeling3.ogg"},"기쁨":{"voiceline":"이 함대에 받아들여진 듯한 기분이 든다. 하지만, 여기가 내게 있어 약속의 땅이라면……아니, 모두를 의심하는 건 아니지만, 더 깊은 뜻이 있을 거라 무심코 억측해버려서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/feeling4.ogg"},"사랑":{"voiceline":"그렇군, 지휘관, 그런 거였나. 지금의 나는 전우들과 같은 정도로……아니, 그 이상으로 충실감을 느끼고 있다. 이 함대…흐흠, 당신의 곁이야말로 내게는 가나안이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수난이야말로 전사의 상징. 모두, 잘 견뎌주었구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/home.ogg"},"hp 경고":{"voiceline":"이것도…신께서 내려주신 시련……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/hp_warning.ogg"},"로그인":{"voiceline":"봉 주르, 지휘관. 알려줘, 다음엔 뭘 하면 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/login.ogg"},"실패":{"voiceline":"신이시여, 어찌 나를 버리시나이까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/lose.ogg"},"우편":{"voiceline":"지휘관, 이 편지를 열어 보지 않아도 좋은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/mail.ogg"},"임무":{"voiceline":"지휘관, 신의 뜻은 아니지만…해군부로부터 새로운 임무가 하달되었다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/mission.ogg"},"임무완료":{"voiceline":"보수인가……좋은 것들이겠지만, 흥미는 없군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/mission_complete.ogg"},"서약":{"voiceline":"그러면 맹세하지. 당신의 기쁨은 나의 의지, 당신의 승리는 나의 영광, 당신의 곁은 내가 돌아가야 할 장소……당신의 곁에 나를 보낸 신께 감사를 드린다…나의 지휘관, 나의 사랑, 그리고…나의 빛.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/propose.ogg"},"스킬":{"voiceline":"우리의 신이시여, 한결같은 애증을 내려주시옵소서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/skill.ogg"},"터치1":{"voiceline":"싸움으로 평화를 가져온다. 이것이야말로 내가 할 수 있는 단 하나의 역할이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/touch.ogg"},"터치2":{"voiceline":"지휘관, 자중하도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/touch2.ogg"},"입수시":{"voiceline":"만나서 영광이다, 인도자여. 나는 생 루이, 신의 뜻에 따라 당신을 곁에서 섬기는자. 당신이 세상의 도리를 저버리지 않는 한, 이 창은 당신을 위해 휘두르리라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/unlock.ogg"},"강화성공":{"voiceline":"우리의 사명을 위해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"티끌은 티끌로, 흙은 흙으로……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"FFNF","레어도":"SSR","ex_chat_status":0},{"클뜯 id":899011,"클뜯 함순이 id":89901,"함순이 이름":"생 루이","한글 함순이 + 스킨 이름":"화려한 성기사","영문 함순이 + 스킨 이름":"Holy Knight's Resplendence","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899011/shipyard.png","설명":"외람되지만, 지휘관, 화려한 복장과 왕좌는 나와 결코 어울리지 않는다. 생 루이의 이름을 계승하긴 했지만, 난 단지 한 명의 성기사일 뿐이다——좋다, 너는 무척 맘에들어 하는 것 같군, 하명하는 대로 따르겠다.","자기소개":null,"메인1":{"voiceline":"지휘관, 현재의 내가 그렇게 사람들의 주목을 끌만한가? 너의 시선을 느낄 수 있다——아니, 결코 반감은 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/main1.ogg"},"메인2":{"voiceline":"이곳에 앉아 동료들 간의 분쟁을 중재하라고? 그렇다면... 실례하지, 먼저 나에게 그들의 말과 기분을 잘 들을 수 있게 해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/main2.ogg"},"메인3":{"voiceline":"지휘관, 넌 이곳의 총수다. 이 왕좌는 네가 앉는 것이 맞다고 생각한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"난 결코 이런 일을 하는 것에 반감을 갖지 않는다. 다만 이렇게 하는 것에 대한 의미를 이해할 수 없는 것이다. 설마 내가 이곳에 단지 앉아만 있는 것이 너에게 즐거움을 가져다주는 것인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/detail.ogg"},"드랍 설명":{"voiceline":"외람되지만, 지휘관, 화려한 복장과 왕좌는 나와 결코 어울리지 않는다. 생 루이의 이름을 계승하긴 했지만, 난 단지 한 명의 성기사일 뿐이다——좋다, 너는 무척 맘에들어 하는 것 같군, 하명하는 대로 따르겠다.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"외적인 수식은 전사에게 아무런 의미가 없다——원래는 이랬었지. 하지만 신 역시 사랑을 인정하고 장려한다. 난 너의 전사이자, 사랑하는 사람이다. 널 기쁘게 할 수 있다면, 난 무엇이든 하길 원한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"조각상처럼 이곳에 앉아있는 것 보다, 너와 함께 전장에 발을 디디고 싶다, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 나에게 혼자 이곳에 앉아있는 것은 일종의 시련이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"무기는 바로 내 옆에 있다. 전장에 나가야한다면, 난 언제든 준비되어 있다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/touch.ogg"},"터치2":null,"입수시":{"voiceline":"외람되지만, 지휘관, 화려한 복장과 왕좌는 나와 결코 어울리지 않는다. 생 루이의 이름을 계승하긴 했지만, 난 단지 한 명의 성기사일 뿐이다——좋다, 너는 무척 맘에들어 하는 것 같군, 하명하는 대로 따르겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/899011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70417,"상점 카테고리 id":7,"스킨 태그":"L2D, 특수배경 (움짤)","입수 영상":"X","재화":1200,"기간":"상시","진영":"FFNF","레어도":"SSR","ex_chat_status":0},{"클뜯 id":899012,"클뜯 함순이 id":89901,"함순이 이름":"생 루이","한글 함순이 + 스킨 이름":"귀려한 집행자","영문 함순이 + 스킨 이름":"Alluring Administrator","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899012/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899012/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/899012/chibi.png","아이콘 일러":"https://raw.githubu