[{"클뜯 id":105040,"클뜯 함순이 id":10504,"함순이 이름":"애리조나","한글 함순이 + 스킨 이름":"애리조나","영문 함순이 + 스킨 이름":"Arizona","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105040/shipyard.png","설명":"펜실베이니아급 전함·애리조나 (BB-39)","자기소개":{"voiceline":"여름에 태어난, 펜실베이니아급 전함의 2번함 애리조나에요. \n네…… 그 「애리조나의 눈물」이란 것은 저를 말하는 겁니다만, 눈물이라고 하니 조금 울적… 하네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/profile.ogg"},"메인1":{"voiceline":"지휘관님의 기억에 남기만 한다면, 저는 더 이상 외롭지 않아요","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/main1.ogg"},"메인2":{"voiceline":"잊지 않기 위해서…… 그들은 언제나 저와 함께 있는 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/main2.ogg"},"메인3":{"voiceline":"지휘관님, 방금 표정…… 폐를 끼쳐버린 건가요? 죄송해요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/main3.ogg"},"전투개시":{"voiceline":"이번에야말로 지키고 싶은 것들을 지켜 보이겠어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/battle.ogg"},"상세확인":{"voiceline":"이런 저라도…… 감사합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/detail.ogg"},"드랍 설명":{"voiceline":"펜실베이니아급 전함·애리조나 (BB-39)","voicelink":null},"의뢰 완료":{"voiceline":"바람…… 그 아이들이 돌아왔다는 징조네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/expedition.ogg"},"실망":{"voiceline":"제가 있을 곳은 어디인 걸까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/feeling1.ogg"},"낯섦":{"voiceline":"아아…… 죄송해요, 또 슬픈 일이 생각나서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/feeling2.ogg"},"호감":{"voiceline":"……언제나 저의 긴 이야기를 들어주셔서 감사합니다…… 이제 어느 정도 괜찮아졌어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님의 품을 빌리면, 무척 안심돼요…… 그때의 일이 생각나더라도 더는 무섭지 않은 듯한 느낌이 들어서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/feeling4.ogg"},"사랑":{"voiceline":"죄송해요……! 아, 아뇨, 그냥 조금 무서워서…… 지휘관님이 없어진다면…… 생각하는 것만으로도 눈물이 멈추질 않아요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"무사히 돌아올 수 있어서 다행이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/home.ogg"},"hp 경고":{"voiceline":"울지… 않아요…! 눈물은 기뻐할 순간을 위해서…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 동료들을 지키고 싶다는 제 마음, 이해하시겠나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/login.ogg"},"실패":{"voiceline":"더는 안 돼…… 부탁이야, 한 번만 내 억지를 들어줘…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/lose.ogg"},"우편":{"voiceline":"지휘관님, 편지예요. 인간관계도 소중한 거랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/mail.ogg"},"임무":{"voiceline":"지휘관님… 저기, 임무… 아직 안 끝났어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/mission.ogg"},"임무완료":{"voiceline":"리스트는 여기 있어요. 그렇지만, 물질적인 보수란 게 그렇게 중요한 건가요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/mission_complete.ogg"},"서약":{"voiceline":"──그 날의 일을 다시 되풀이하지 않겠어, 인가요? ……감사합니다. 지금까지 중 가장 마음속을 울리는 한마디였어요… 당신을 믿겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/propose.ogg"},"스킬":{"voiceline":"저, 이번에야말로 반드시 지켜야만 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/skill.ogg"},"터치1":{"voiceline":"조금 진정됐어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/touch.ogg"},"터치2":{"voiceline":"우… 방금 건, 없던 일로 해주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/touch2.ogg"},"입수시":{"voiceline":"펜실베이니아급 2번함, 애리조나예요. 여름에 태어났답니다. 이번엔 절대로 비극을 되풀이하지 않겠어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/unlock.ogg"},"강화성공":{"voiceline":"모두를 지키겠어요……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아주 멋진 기분이에요… 이대로 그 날의 악몽이 지워져 버렸으면 좋겠지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['펜실베이니아'] : 언니, 저 힘낼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/couple_encourage1.ogg"},{"voiceline":"['오클라호마', '테네시', '캘리포니아'] : 이번엔 제가 모두를 지킬게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105040/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0},{"클뜯 id":105041,"클뜯 함순이 id":10504,"함순이 이름":"애리조나","한글 함순이 + 스킨 이름":"서방의 무희","영문 함순이 + 스킨 이름":"Enchantress from Afar","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105041/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105041/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105041/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105041/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105041/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105041/shipyard.png","설명":"이스트 글림과 연관이 있는 의상이라고 들었지만 이건……. 아니, 싫은 건 아니지만, 지휘관님께 이런 모습을 보이는 게 조금 부끄러워서……. 앗, 울 것 같다던가 그런 건 아니에요.","자기소개":null,"메인1":{"voiceline":"저의 이런 모습이 모두에게 힘을 줄 수 있다면 전 상관 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/main1.ogg"},"메인2":{"voiceline":"무희답게 본격적으로 춤을 배우는게 좋을 것 같네요. 캘리포니아랑 상담을 좀…… 해봐도 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/main2.ogg"},"메인3":{"voiceline":"앗…… 지휘관님. 얼굴에 먼지가 붙어 있어요. 지금 닦아 드릴게요……. 네, 이젠 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/main3.ogg"},"전투개시":{"voiceline":"제가 할 수 있는 최대한……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/battle.ogg"},"상세확인":{"voiceline":"예전이나 지금이나, 전투 뿐만이 아니라 다양한 방법으로 동료의 힘이 될 수 있다는 건 기쁘네요. 제가 있는 것만으로 지휘관님께서 기뻐해 주시는 것도 포함해서……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/detail.ogg"},"드랍 설명":{"voiceline":"이스트 글림과 연관이 있는 의상이라고 들었지만 이건……. 아니, 싫은 건 아니지만, 지휘관님께 이런 모습을 보이는 게 조금 부끄러워서……. 앗, 울 것 같다던가 그런 건 아니에요.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠났던 모두가 돌아왔어요. 바람에 실려온 좋은 소식이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"눈물을 닦을 손수건은 두고 왔어요. ……네, 이런 모습이라 넣어둘 만한 주머니도 없고, 게다가 지금은 그리 쉽게 울 것 같진 않아서요. 그러니까 지휘관님, 안심하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/feeling5.ogg"},"터치3":{"voiceline":"언니? 아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/headtouch.ogg"},"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"동료에게 힘을 주고 싶다는 제 바람, 이뤄주신 거군요. 후훗, 열심히 할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/login.ogg"},"실패":{"voiceline":"철수하는 거군요……. 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/lose.ogg"},"우편":null,"임무":null,"임무완료":{"voiceline":"임무 보상이네요. 물자에 여유가 생기면 안심이 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"조금 진정이 되질 않네요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/touch.ogg"},"터치2":{"voiceline":"언니에게는 비밀로 부탁드려요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/touch2.ogg"},"입수시":{"voiceline":"이스트 글림과 연관이 있는 의상이라고 들었지만 이건……. 아니, 싫은 건 아니지만, 지휘관님께 이런 모습을 보이는 게 조금 부끄러워서……. 앗, 울 것 같다던가 그런 건 아니에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"춤은 자신 없지만, 전투라면 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105041/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬