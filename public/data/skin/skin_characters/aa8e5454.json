[{"클뜯 id":11100060,"클뜯 함순이 id":1110006,"함순이 이름":"코테가와 유이","한글 함순이 + 스킨 이름":"코테가와 유이","영문 함순이 + 스킨 이름":"Yui Kotegawa","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100060/shipyard.png","설명":"네가 지휘관이야? 만나서 반가워. 코테가와 유이라고 해. 작은 사고로 여기 오게 됐어…… 신세를 지게 됐으니, 모항의 풍기는 내가 확실히 지킬게!","자기소개":{"voiceline":"사이난 고등학교의 선도부원인 코테가와 유이야. 사고로 이 세상에 오게 됐는데, 여기 풍기도 꽤 문란한 것 같아. 그렇다면 할 일은 하나뿐이지! 나한테 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/profile.ogg"},"메인1":{"voiceline":"지휘관, 일할 때는 제대로 집중해야지! 한눈 팔면서 쓸데없는 짓을 하면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/main1.ogg"},"메인2":{"voiceline":"모항의 지휘냥들은 평범한 고양이들이랑 겉모습은 조금 다르지만… 이건 또 이거 나름대로 동글동글해서 귀엽네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/main2.ogg"},"메인3":{"voiceline":"「의장」라고 부르는 이거… 다 생긴 게 화려하네… 그나저나 잎사귀를 입에 머금는 이유는 뭐야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/main3.ogg"},"전투개시":{"voiceline":"풍기 위반은 단 한 번이라도 절대 놓치지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/battle.ogg"},"상세확인":{"voiceline":"으음…… 여긴 규칙을 위반하는 애들이 너무 많아서, 혼자선 다 주의를 줄 수가 없네. 저기, 지휘관. 풍기가 문란한 애가 없는지 둘러보려고 하는데, 좀 도와줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/detail.ogg"},"드랍 설명":{"voiceline":"네가 지휘관이야? 만나서 반가워. 코테가와 유이라고 해. 작은 사고로 여기 오게 됐어…… 신세를 지게 됐으니, 모항의 풍기는 내가 확실히 지킬게!","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰 임무가 완료됐어. 물자는 잊지 말고 꼭 받도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/expedition.ogg"},"실망":{"voiceline":"지휘관… 이렇게 몰상식할 수가. 용서 못 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/feeling1.ogg"},"낯섦":{"voiceline":"여기서 일어나는 이상한 사건의 대부분은 지휘관이 원인이라… 정말, 선도부원으로서 마음을 놓을 틈이 없네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/feeling2.ogg"},"호감":{"voiceline":"얼마 전에 모항에서 고양이 귀를 가진 애를 봤어. …머리띠인가 했는데, 설마 진짜 귀일 줄이야. 라라 씨의 꼬리도 처음 봤을 때는 놀랐지만, 고양이 귀도 깜짝 놀랐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/feeling3.ogg"},"기쁨":{"voiceline":"모항 학교는 내가 다니던 학교랑 비슷하네. 하지만 칠판의 화학 반응식이 잘못됐던데… 누가 쓴 거지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/feeling4.ogg"},"사랑":{"voiceline":"나도 모르는 사이에 여기 생활에 완전히 익숙해졌어. 앞으로도 지휘관이랑 모두를 위해, 전투도 풍기를 지키는 것도 열심히 할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/feeling5.ogg"},"터치3":{"voiceline":"뭐, 뭐야? 무슨 일 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 고생 많았어. 휴식은 중요하니까… 시원한 음료수를 준비했는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/home.ogg"},"hp 경고":{"voiceline":"아직 더 분발할 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 옷이 흐트러지면 마음도 흐트러진다고 하잖아? 그러니까 단정히 하고 다녀야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/login.ogg"},"실패":{"voiceline":"이… 이럴 순 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 우편이 왔어. 우편함에 안 읽은 메시지가 잔뜩 쌓이지 않도록 주의해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무 기일이야. 꼭 지켜야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/mission.ogg"},"임무완료":{"voiceline":"임무 완료야. 후우… 이제 조금은 쉴 수 있겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/mission_complete.ogg"},"서약":{"voiceline":"지휘관이랑 모항 사람들이 나를 필요로 한다면, 조금 더 여기 머물러도 괜찮을 것 같아. 물론 앞으로도 계속해서 파렴치한 행위는 금지야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/propose.ogg"},"스킬":{"voiceline":"파렴치한 행위는 금지야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/skill.ogg"},"터치1":{"voiceline":"무슨 일이야? 내가 도와줬으면 하는 거라도 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/touch.ogg"},"터치2":{"voiceline":"이… 이렇게… 파렴치한 짓을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관이야? 만나서 반가워. 코테가와 유이라고 해. 작은 사고로 여기 오게 됐어…… 신세를 지게 됐으니, 모항의 풍기는 내가 확실히 지킬게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/unlock.ogg"},"강화성공":{"voiceline":"뭐… 뭐야, 이거……! 설마 나… 강해진 건가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후우… 드디어 끝났네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 모항의 고양이 카페에 같이 가줘서 고마워. 푹신푹신하고 사람도 잘 따르고… 특히 지휘냥이라고 불리는 아이들… 정말 귀여워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"자, 잠깐. 볼일이 있으면 말을 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"모항의 지휘관으로 지내는 것도 정말 힘들겠어. 다음 업무에 착수하기 전에 느긋하게 쉬는 편이 좋을 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 좋은 아침이야. 모항에는 정말 다양한 사람들이 있구나. 라라 씨도 특이하지만, 여기 사람들도 만만치 않은 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"또 새로운 임무…? 고생이네… 혹시 괜찮으면 나도 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/mission_ex.ogg"},"임무완료_ex":{"voiceline":"그렇게 많던 임무를 다 처리했다고? 역시 지휘관은 대단해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"지휘관! 너 진짜……! 거기 무릎 꿇고 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['라라 사타린 데빌룩'] : 맨날 이상한 것 좀 꺼내지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"다들 주의를 주면 신경 써주기는 하지만…… 아직 그냥 넘기기 어려운 부분이 많아. 더 열심히 해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/main5_ex.ogg"},"메인6_ex":{"voiceline":"선도위원으로서 풍기 문란을 막는 건 당연한 거야. 지휘관도 도와줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"고양이들이 지휘관을 잘 따르네… 부, 부러워. 혹시 팁 같은 거 있으면 알려 줄래…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100060/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":