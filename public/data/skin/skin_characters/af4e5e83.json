[{"클뜯 id":101460,"클뜯 함순이 id":10146,"함순이 이름":"스테판 포터","한글 함순이 + 스킨 이름":"스테판 포터","영문 함순이 + 스킨 이름":"Stephen Potter","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101460/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101460/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101460/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101460/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101460/shipyard.png","설명":"플레처급 구축함—스테판 포터, 현호 DD-538","자기소개":{"voiceline":"나같은 구축함은 호위하고, 공습 대비하고, 가끔 잠수함 잡고, 지원 임무에 참여하면 OK야. 구축함의 임무는 대부분 감당할 수 있어. 물론 나더러 영웅처럼 위험한 일에 용감히 나서라고 한다면 사양할게……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/profile.ogg"},"메인1":{"voiceline":"아, 농땡이 피우는 거 지휘관한테 들켰네…… 잠깐, 모르는 것 같은데? 됐다, 계속 멍 때려야지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/main1.ogg"},"메인2":{"voiceline":"재즈 들을래? 에이, 잠깐 음악 듣는 거뿐인데, 나태한 건 아니지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/main2.ogg"},"메인3":{"voiceline":"지휘관, 외투 잠깐 입을 일 없지? 빌려줘——음, 괜찮은 이불이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/main3.ogg"},"전투개시":{"voiceline":"아, 기함이면 농땡이 못 피우잖아… 됐어, 모두 같이 공격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/battle.ogg"},"상세확인":{"voiceline":"지휘관도 여기서 몰래 쉬고 싶어하는 것 같네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함—스테판 포터, 현호 DD-538","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료됐어. 네가 까먹을 것 같아서, 미리 알려주는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/expedition.ogg"},"실망":{"voiceline":"의미도 없다…… 난 이만 갈게. 무슨 일 있으면 불러.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/feeling1.ogg"},"낯섦":{"voiceline":"나에게 부탁할 일이 있다고? 음, 플레처급 자매들이 그렇게 많은데, 다른 사람 찾아도 되잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/feeling2.ogg"},"호감":{"voiceline":"왜 옆에서 보고만 있냐고?…… 너도 도와달라고 말 안 했잖아? 부탁할 게 있으면, 얘기하면 돼. 눈빛으로 말해봤자 난 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/feeling3.ogg"},"기쁨":{"voiceline":"안심할 수가 없어…… 아니, 네가 과로하거나 게으름 피우는 걸 걱정하는 게 아니라, 그냥 단순히 네가 걱정되는 그런…… 됐어, 그냥 지켜보고 있어야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/feeling4.ogg"},"사랑":{"voiceline":"나도 좀 생각해 봤었어, 사랑한다, 좋아한다, 이런게 대체 뭘 의미하는 건지…… 그래서? 결과는, 너무 복잡해서 생각하기 귀찮아졌어. 어쨌든, 네 옆에만 있으면, 자연스럽게 천천히 알게되겠지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/feeling5.ogg"},"터치3":{"voiceline":"음…… 왜 어떤 사람들은 머리 쓰다듬는 걸 좋아하는지 대충 이해했어.……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/headtouch.ogg"},"모항귀환":{"voiceline":"흐흐흠♪~ 어? 왔어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/home.ogg"},"hp 경고":{"voiceline":"전력을 다 해야겠는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/hp_warning.ogg"},"로그인":{"voiceline":"\"업무\"라는 이름의 지옥에 돌아온 걸 환영해. 아, 걱정마, 정말로 너무 바쁘면 내가 도와줄 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/login.ogg"},"실패":{"voiceline":"에구, 너무 쉽게봤네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/lose.ogg"},"우편":{"voiceline":"테이블 위에 있는 우편이 누구껀지 아무도 관심이 없네——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/mail.ogg"},"임무":{"voiceline":"새로운 임무야! 아, 이런, 내가 말해버려서 지휘관이 몰래 휴식하고 있는 핑계거리가 없어졌네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/mission.ogg"},"임무완료":{"voiceline":"임무 완료했어? 그럼 난 가서 쉴게……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/mission_complete.ogg"},"서약":{"voiceline":"서약하면, 책임도 따라서 더 많아져, 뭔가 더 피곤해질 것 같아…… 아아, 그냥 아무렇게나 내뱉은 말이야. 자신이 좋아하는 사람을 위해서라면 좀 더 피곤해지는 게 뭐 어떻다고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/propose.ogg"},"스킬":{"voiceline":"빨리 해결해버리자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/skill.ogg"},"터치1":{"voiceline":"껌 줘? 민트맛 아니면 레몬맛?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/touch.ogg"},"터치2":{"voiceline":"꺅! 너, 너 엄청 직접적이구나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/touch2.ogg"},"입수시":{"voiceline":"나는 플레처급 스테판 포터야. 플레처급은 이미 익히 봐왔을 테니까, 길게 설명은 안 할게, 그럼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/unlock.ogg"},"강화성공":{"voiceline":"농땡이 필 기회가 적어졌어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/upgrade.ogg"},"vote":null,"승리":{"voiceline":"그냥 뭐... 사실 이렇게 활약할 생각은 없었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"내가 해야할 일이 있어? 좋아, 말만 해. 어차피 졸립던 참이라, 지휘관 도와주면 나야 좋지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"\"업무\"라는 이름의 천국에 돌아온 걸 환영해. 헤헷, 내가 있으니까 당연히 천국이지, 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"새로운 임무가 있어! 어차피 안 하면 안 되는데, 어서 얌전히 완성해 버리자고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"그냥 뭐... 지휘관의 기대를 저버릴 수는 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['플레처', '윌리엄 D 포터', '찰스 오스본', '대처', '얼릭', '푸트', '스펜스', '래드포드', '젠킨스', '니콜라스', '부시', '헤이즐우드', '배시', '킴벌리', '멀라니', '스탠리', '스몰리', '할시 파웰'] : 조금은 몰래 놀아도…… 괜찮겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/couple_encourage1.ogg"},{"voiceline":"['컬럼비아'] : 이 껌 새로 나온 맛인데, 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관의 외투... 킁킁... 역시 나야, 깨끗하게 세탁됐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"음악을 틀면 효율이 올라가. 아, 내가 말한 건 게임할 때고, 일할 때는 안 그래도 졸린데 음악까지 있으면 최면에 걸리지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101460/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":1},{"클뜯 id":101461,"클뜯 함순이 id":10146,"함순이 이름":"스테판 포터","한글 함순이 + 스킨 이름":"느긋한 핑크 바니","영문 함순이 + 스킨 이름":"Chillaxation Station","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101461/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101461/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101461/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101461/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101461/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101461/shipyard.png","설명":"내 \"아지트\"에 온 걸 환영해, 여기서는 맘껏 게을러 퍼져도 돼… 농담이고, 오늘은 휴일이니까, 지휘관도 편하게 놀아.","자기소개":null,"메인1":{"voiceline":"바니걸 지휘냥 인형, 토끼 만쥬 인형... 나도 모르게 이상한 걸 많이 모아놨네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/main1.ogg"},"메인2":{"voiceline":"라피도 게으름을 피우는 걸 좋아한다고 생각해서 초대했는데, 알고 보니까 자는 걸 좋아하는 것뿐이었어... 니콜라스처럼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/main2.ogg"},"메인3":{"voiceline":"책상이 어수선하다고? 이미 익숙해졌어. 그리고 정리하는 것도 귀찮아... 이대로가 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"토끼 후드 아래는 바니걸이야. 안도 밖도 다 토끼... 라는 느낌이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/detail.ogg"},"드랍 설명":{"voiceline":"내 \"아지트\"에 온 걸 환영해, 여기서는 맘껏 게을러 퍼져도 돼… 농담이고, 오늘은 휴일이니까, 지휘관도 편하게 놀아.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"뭔가 달린 모자를 보면 다들 만져보고 싶은 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/headtouch.ogg"},"모항귀환":{"voiceline":"새로운 물건이 왔네. 이 특전의 스티커는... 적당한 곳에 붙여 둬야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"다녀왔구나. 게임 할래? 모바일? 콘솔? 아니면 보드게임?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/login.ogg"},"실패":null,"우편":{"voiceline":"아, 새로운 소식이다. 일단 답장할게. 응? 내가 아니야... 지휘관에게 온 소식이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"껌 먹을래? 여러가지 맛이 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/touch.ogg"},"터치2":{"voiceline":"내 옷이 너무 위험하다고? 이상하네...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/touch2.ogg"},"입수시":{"voiceline":"내 \"아지트\"에 온 걸 환영해, 여기서는 맘껏 게을러 퍼져도 돼… 농담이고, 오늘은 휴일이니까, 지휘관도 편하게 놀아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101461/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"카니발","상점 id":70548,"상점 카테고리 id":16,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"USS","레어도":"SR","ex_chat_status":0}]