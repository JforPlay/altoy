[{"클뜯 id":301790,"클뜯 함순이 id":30179,"함순이 이름":"하타카제","한글 함순이 + 스킨 이름":"하타카제","영문 함순이 + 스킨 이름":"Hatakaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301790/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301790/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301790/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301790/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301790/shipyard.png","설명":"카미카제형 구축함 5번함 ─ 하타카제","자기소개":{"voiceline":"카미카제급 구축함 하타카제라 하네. 참고로 함종으로 치자면 선배지만, 주로 호위 임무에 종사해서 화려한 전과가 없던 탓에, 카미카제처럼 마지막 순간까지 싸워보지는 못한 함력이지. 흠, 나로서는 조금 아쉽긴 하구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/profile.ogg"},"메인1":{"voiceline":"마츠카제는 아무래도 자매함인 날 챙겨주지 않으면 마음이 놓이지 않는 모양이다만, 어떻게 응하면 좋을지 종종 고민이 된다네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/main1.ogg"},"메인2":{"voiceline":"요령 피울 셈이라면 포기하게나. 참고로, 업무는 아직 꽤 남아있으니 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/main2.ogg"},"메인3":{"voiceline":"카미카제, 지휘관을 놀리는 건 적당히 하게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/main3.ogg"},"전투개시":{"voiceline":"이제와서 숙고할 필요는 없네. 각자 맡은 바를 다 하면 싸움에서 이기는 법이지, 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/battle.ogg"},"상세확인":{"voiceline":"참고로, 내 초기 명칭은 '제9호 구축함'이었네. ……뭐, 이름 짓는 방식은 그대로 답습되지 않아서 다행이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/detail.ogg"},"드랍 설명":{"voiceline":"카미카제형 구축함 5번함 ─ 하타카제","voicelink":null},"의뢰 완료":{"voiceline":"보수를 받기 전에, 수고한 동료들을 치하하는 걸 잊지 말게나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/expedition.ogg"},"실망":{"voiceline":"다른 아이들의 평가까지 떨어지기 전에, 빨리 자신의 잘못을 인식하거라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/feeling1.ogg"},"낯섦":{"voiceline":"지휘관이 그럴 마음만 있다면, 선배로서 인간관계에 대해 충고해줄 의향도 있다만?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/feeling2.ogg"},"호감":{"voiceline":"성격이 서로 다른 동료에겐 각기 다른 접근 방식을 가지는 거야. 태도를 손바닥 뒤집듯이 하란 게 아니야. 인간관계를 원활히 하도록 처세술을 익히란 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/feeling3.ogg"},"기쁨":{"voiceline":"그래, 이 부적을 가져가도록, 인간관계도 잘 풀릴 걸세. 하지만 주의하게, 상대를 상처입히는 짓을 하면 벌이 내려질 것이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/feeling4.ogg"},"사랑":{"voiceline":"고민이라면 말해보게. 이래 봬도 연장자의 경험으로 해결한 적이 많으니. 애당초, 그대와 나 사이에 숨길 건 아무것도 없지 않나. 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격 수고했네. 차라도 한 잔 마시고, 전술 단계의 브리핑을 하도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/home.ogg"},"hp 경고":{"voiceline":"큭, 손상은 무시할 수 없는 수준인가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/hp_warning.ogg"},"로그인":{"voiceline":"시간 엄수, 지휘관에게 있어 기본 중의 기본이지…… 참고로 그대가 지금까지 노력한 것에 비추어봐서… 조금은 칭찬 못해줄 것도 없겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/login.ogg"},"실패":{"voiceline":"시대에는 따라가지 못하는 것 같구나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/lose.ogg"},"우편":{"voiceline":"새로운 우편은 제때 확인하도록…… 참고로, 여기도 한 통 있으니까 말이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/mail.ogg"},"임무":{"voiceline":"재능있는 자는 늘 바쁜 법. 미완료 임무를 방치하지 말도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/mission.ogg"},"임무완료":{"voiceline":"호오……임무 보수라, 예상보다 많군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/mission_complete.ogg"},"서약":{"voiceline":"이런 나로 만족하는가? 별로 사람을 끄는 매력도 없고, 참견하고 설교나 하기 좋아하고… 농담이 아니라고? 그, 그렇다면… 어흠, 그럼 바다가 말라 없어질 때까지, 내가 옆에 있어 주도록 하지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/propose.ogg"},"스킬":{"voiceline":"내 차례군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/skill.ogg"},"터치1":{"voiceline":"대공 능력은 중요하지. 참고로, 방심의 대가는 그대의 예상보다 훨씬 클 걸세.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/touch.ogg"},"터치2":{"voiceline":"……지금의 그 근성을 다른 곳에 쓴다면, 재평가할 여지라도 있었을 텐데 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/touch2.ogg"},"입수시":{"voiceline":"그대가 지휘관인가. 흠흠…… 어허, 한심한 표정 짓지 말도록. 나는 제5구축대의 하타카제. 참고로, 앞으론 선배로서 잘 지도해 줄 터이니 각오해주시게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/unlock.ogg"},"강화성공":{"voiceline":"나같은 걸 위해 그렇게까지 할 필요는…… 아니, 감사한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리는 승리일 뿐. 허례허식도 찬사도 필요 없네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['하타카제', '카미카제', '마츠카제'] : 전장에서 쌓은 연륜을 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301790/couple_encourage1.ogg"},{"voiceline":"['시구레'] : 시구레, 방심하지 마라.","