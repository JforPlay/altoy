[{"클뜯 id":501050,"클뜯 함순이 id":50105,"함순이 이름":"롱우","한글 함순이 + 스킨 이름":"롱우","영문 함순이 + 스킨 이름":"Lung Wu","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501050/shipyard.png","설명":"불칸 슈테틴 1000톤급 뇌장 구축함—롱우","자기소개":{"voiceline":"이스트 글림의 구축함…… 롱우는 전투나 일하는 데에는 별 흥미가 없어요…… 그렇지만 요리에 관한 거라면 뭐든 알려주셨으면 해요! 어떻게 조리한 요리를 좋아하세요? 굽든 삶든 튀기든 볶든 불맛을 내든 찌든 조리든… 뭐든 만들 수 있어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/profile.ogg"},"메인1":{"voiceline":"……휴일에 외출이요? 음… 저… 거절해도 되나요…? 솔직히 별 관심이… 네? 그럼, 관심 있는 건 뭐냐구요? 물론 레시피 연구죠! 요즘 홍샤오로우를 더 맛있게 만들 수 있는 방법을 찾았는데, 지휘관님도 드셔 보실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/main1.ogg"},"메인2":{"voiceline":"초콜릿으로 속을 채운 샤오롱바오? 딸기잼으로 버무린 마파두부?! ……으아, 이제 그만! 이제 주방은 관계자 말고는 출입 금지예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/main2.ogg"},"메인3":{"voiceline":"롱우가 주방에서 요리하는 걸 보고 싶다구요? 안 되는 건 아니지만, 푸슌처럼 이상한 행동을 하면… 너무 빡빡하게 군다구요? 지휘관님이 너무 무른 거예요! 주방은 전쟁터나 마찬가지라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/main3.ogg"},"전투개시":{"voiceline":"전투…… 볶음 요리를 하듯이 화력을 높여서!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/battle.ogg"},"상세확인":{"voiceline":"볶음 요리를 하는 팁? …센 불에 기름을 끼얹는 거죠! 불을 붙여서 볶아야 향을 제대로 낼 수 있어요!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/detail.ogg"},"드랍 설명":{"voiceline":"불칸 슈테틴 1000톤급 뇌장 구축함—롱우","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 돌아온 것 같네요. 노고에 대한 보상으로 연회를 준비했어요. 다들 배불리 먹을 수 있을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/expedition.ogg"},"실망":{"voiceline":"지휘관님은…… 롱우의 요리를 알아주지 않는구나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/feeling1.ogg"},"낯섦":{"voiceline":"……배고프세요? 계화떡에 오리 통구이, 가재 요리에 샤오롱바오… 그리고……. 이 많은 요리는 어디서 난 거냐구요? 음…… 그냥 꺼내 드린 것뿐인데요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/feeling2.ogg"},"호감":{"voiceline":"……요리를 잘한다구요? 가, 감사합니다… 그럼…… 더 드셔보실래요? 불도장에 개수백채, 그리고…… 너무 손이 많이 간다구요? 지휘관님을 대접하는 건데 이 정도는 되어야 하지 않을까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/feeling3.ogg"},"기쁨":{"voiceline":"어떤 맛이든 좋아하는 요리가 있다면 뭐든 만들어 드릴게요! 요리는 사람을 행복하게 한다고들 하고, 저도 열심히 노력해서 지휘관님을 행복하게 만들어 드리고 싶어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/feeling4.ogg"},"사랑":{"voiceline":"여기 도시락 드세요. 에헤헷, 여기엔 제 새로운 요리가 들어가 있어요. 지휘관님이 좋아하는 맛과 재료를 바탕으로 특별히 창작한…… 너무 맛있다구요? 다행이다…! 에헤헷, 그럼… 매일 만들어 드려도 될까요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/feeling5.ogg"},"터치3":{"voiceline":"레, 레시피를 못 읽겠어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 어서 오세요…… 배고프세요? …배는 고픈데 뭘 먹어야 할지 모르겠다구요? 그럼, 8대 요리별로 하나씩 어떠세요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/home.ogg"},"hp 경고":{"voiceline":"으아아아! 이러다 타겠어!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/hp_warning.ogg"},"로그인":{"voiceline":"……어서 오세요. 오늘 메뉴…? 네! 드시고 싶은 게 있으면 뭐든 말씀하세요! 추천 메뉴? 자신 있는 메뉴가 많아서 조금 생각할 시간이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/login.ogg"},"실패":{"voiceline":"앗…… 지고 말았어요…… 불 조절이 서툴렀던 것 같네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 우편이 왔어요. 읽는 거 잊지 마세요. 레시피가 적힌 우편은 없나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있어요. 그대로 방치해도 괜찮은 건가요? 어서 정리하고 오세요. 제가 만든 딤섬은 그 후에 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 도착했어요. 수령하는 걸 잊지 마세요. 내용물은…… 고급 식재료를 잔뜩 살 수 있을 것 같네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/mission_complete.ogg"},"서약":{"voiceline":"이, 이건……?! 자, 잠깐만 마음 정리할 시간을…… 요리 말고는 저… 정말 아무것도…… 후우… 하아… 지, 지휘관님만 괜찮으시다면…… 앞으로도 지휘관님이 드실 모든 요리를 맛있고 건강하게 만들어 드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/propose.ogg"},"스킬":{"voiceline":"팔진옥식! 맛은 무궁무진한 것~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/skill.ogg"},"터치1":{"voiceline":"배고프세요? 여기 춘권 드릴게요. 이걸로 출출함을 달래세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/touch.ogg"},"터치2":{"voiceline":"쪄드릴지 볶아드릴지, 아니면 튀겨드릴지 압력솥에 넣을지… 직접 고르세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/touch2.ogg"},"입수시":{"voiceline":"이스트 글림의 구축함…… 롱우예요. 저기… 그… 혹시 후번 못 보셨나요? 그리고… 주방으로 가려면 어떻게 해야 하죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/unlock.ogg"},"강화성공":{"voiceline":"강화 성공……? 음…… 아! 불 조절을 더 능숙하게 할 수 있게 됐다는 거네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이긴 건가요……? 휴우…… 이제 드디어 레시피 연구를 할 수 있겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"……네? 얼마간은 도시락을 준비해주지 않아도 된다…구요? 왜, 왜죠?! 설마 지휘관님… 롱우가 만든 요리에 질려서…… 네? 최근에 살이 너무 쪄서 그렇다구요? 다행이다… 깜짝 놀랐어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"지휘관님, 롱우는 어린애가 아니라구요…… 그렇게 쓰다듬는 게 좋으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관님, 어서 오세요! …많이 고생하셨으니 위로 연회를 준비했어요! 겸사겸사 지휘관님을 위해 연구한 새로운 요리도 맛봐주셨으면 해요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"드디어 오셨군요! 이건 모두 지휘관님을 위해 만든…… 너무 많다구요? 남기면 너무 아깝지 않냐구요? 괜찮아요! 롱우에게 다 생각이 있으니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"지휘관님, 새로운 우편이에요. 음… 슬쩍 봐도 글자가 굉장히 많던데… 음, 딤섬이라도 만들어 올게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/mail_ex.ogg"},"임무_ex":{"voiceline":"새로운 임무예요. 마치면 상으로 달콤한 걸 만들어 드릴게요. 어떤 거냐니… 탕웬같은 것도 괜찮으시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무를 다 마치셨다구요? 역시 지휘관님이세요~ 약속대로 탕웬을 드릴게요. 아, 아직 뜨겁네… 후~ 조금 식힌 다음에 드릴게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"……롱우의 꼬리가 마음에 드세요? 귀엽다구요? 그래요…? (휙휙)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/touch_ex.ogg"},"터치2_ex":{"voiceline":"이건…… 좀 위험할 것 같은데요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['후번'] :  그만 좀 끌고 다녀…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"으… 밥이 모잘라… 지휘관님이 만든 요리, 완전 밥도둑이네… 벌써 8그릇이나…… 앗?! 지휘관님?! 방금 거 다 들으셨어요…? 로, 롱우는 음식을 낭비하고 싶지 않은 것뿐이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/main5_ex.ogg"},"메인6_ex":{"voiceline":"만드는 음식이 너무 한쪽에만 편향되어 있다구요? 확실히 사천 요리는 평소에 자주 안 만들기는 해요… 그래도 수주육편은 맛있었다구요? 어라? 최근에 만들어 드린 적이 있던가……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"……취했냐구요? 롱우가 취하는 거 봤어요…? 음… 술게장을 먹다 보니… 아, 그나저나 지휘관님, 배 안 고파요? 롱우가~ 마파두부… 수주육편에 라즈지까지 만들었어요… 전골도 있구요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501050/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":1},{"클뜯 id":501051,"클뜯 함순이 id":50105,"함순이 이름":"롱우","한글 함순이 + 스킨 이름":"승천하는 용의 새해 연회","영문 함순이 + 스킨 이름":"Ascendant Dragon's Spring Feast","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501051/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501051/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501051/shipyard.png","설명":"지