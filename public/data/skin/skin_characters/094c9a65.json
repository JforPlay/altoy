[{"클뜯 id":707010,"클뜯 함순이 id":70701,"함순이 이름":"볼가","한글 함순이 + 스킨 이름":"볼가","영문 함순이 + 스킨 이름":"Volga","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707010/shipyard.png","설명":"72형 항공모함—볼가","자기소개":{"voiceline":"네네, 자기소개 말이죠? 노스 유니온 소속 항공모함 볼가랍니다. 저희 나라의 어머니와도 같은 강의 이름을 빌려서 동료들을 하늘, 그리고 바다에서 열심히 응원할 거예요! 앞으로 잘 부탁드려요, 지휘관님♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/profile.ogg"},"메인1":{"voiceline":"아르한겔스크, 이번 다과회에 보드카 가져가도 돼? 아, 안돼? 너무해…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/main1.ogg"},"메인2":{"voiceline":"♪~ 집무실을 청소하면서 오늘 저녁은 뭘 먹을지 생각하는 건 즐겁네요~ 맞다, 지휘관님, 추천하는 레시피 있으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/main2.ogg"},"메인3":{"voiceline":"후훗, 이래봬도 전쟁터에서는 꽤 믿음직스럽다는 평가를 받고 있어요. …\"이래봬도\"는 좀 괜한 말인 것 같죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/main3.ogg"},"전투개시":{"voiceline":"항공 지원, 열심히 할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/battle.ogg"},"상세확인":{"voiceline":"유사시에는… 아니, 유사시가 아닐 때에도 볼가를 의지해 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/detail.ogg"},"드랍 설명":{"voiceline":"72형 항공모함—볼가","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어요! 볼가, 도시락 가지고 올게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/expedition.ogg"},"실망":{"voiceline":"착한 아이라면 동료를 곤란하게 하지 않겠죠? 그쵸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/feeling1.ogg"},"낯섦":{"voiceline":"건강은 잘 챙겨야 해요. 바쁘신 건 알지만 소중한 몸은 하나 뿐이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/feeling2.ogg"},"호감":{"voiceline":"지휘관님~ 보드카라도… 앗, 지금은 업무 중이시라 못 마시겠네요. 그럼, 업무 후에 다시 말씀 드릴게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/feeling3.ogg"},"기쁨":{"voiceline":"네네, 오늘은 조금만~ 휴우, 항상 고생하시는 지휘관님을 위해 볼가가 상을 하나 준다고 하면… 지휘관님은 뭐가 좋으세요? 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/feeling4.ogg"},"사랑":{"voiceline":"오구오구 쓰담쓰담 해주는 상 말씀이시죠~ 알겠습니다! 자, 오구오구~ 착하다~ 에헤헷, 이거 뭔가 중독될 거 같네요♪ 자아, 그럼 누우세요~ 이대로 주무셔도 괜찮아요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/feeling5.ogg"},"터치3":{"voiceline":"으윽, 볼가가 연상…이지 않아요? 부, 분명 그럴 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 고생 많으셨어요~ 전투 회고요? 그건 나중에 해도 되니까 일단 다 같이 밥이라도 먹는 게 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/home.ogg"},"hp 경고":{"voiceline":"마지막에 이기는 건… 우리라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/hp_warning.ogg"},"로그인":{"voiceline":"볼가는 오늘도 열심히 할 거예요~ 후후후, 지휘관님도 오늘 하루 동료들하고 사이좋게, 열심히 하세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/login.ogg"},"실패":{"voiceline":"패배…했지만, 마지막에는 반드시 이길 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/lose.ogg"},"우편":{"voiceline":"우편이에요~ 동료들에게 온 초대라면 기쁠 것 같아요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/mail.ogg"},"임무":{"voiceline":"새로운 임무네요. 적당히 좀 부탁드려요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/mission.ogg"},"임무완료":{"voiceline":"아야야……. 임무 보상을 옮기다가 좀 넘어져서……. 지휘관님도 같이 옮겨 주신다구요? 에헤헷, 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/mission_complete.ogg"},"서약":{"voiceline":"네네, 지휘관님, 무슨 일이세요? …엣, 아… 이건 서약 반지? 저한테요? 정말? 다, 다른 아이들이 질투하지 않으면 좋겠는데… 에헤헷, 기뻐… 너무 기뻐요……. 흐흑…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/propose.ogg"},"스킬":{"voiceline":"지금이 바로 분발할 때죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/skill.ogg"},"터치1":{"voiceline":"네, 볼가 부르신 거 맞죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/touch.ogg"},"터치2":{"voiceline":"볼가로 정말 괜찮아요? …네? 그냥 사고였다구요??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/touch2.ogg"},"입수시":{"voiceline":"피곤해 보여요……. 밥은 잘 드시고 계신 거죠? 잠도? 으음, 어쩌면 심적 스트레스일지도…. 아님, 인간관계? …아, 제 이름은 볼가, 노스 유니온의 볼가예요~ 어머? 저 지금까지 자기 소개도 안 한 건가요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/unlock.ogg"},"강화성공":{"voiceline":"볼가도 틀림없는 항공모함이라구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우리의 승리는 확실해요! 참고 참고 또 참아내 마지막에 승리하는 건 반드시 우리일 테니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"제가 이렇게 활약할 수 있었던 건, 작전 경험이나 성능에 의존한 게 아니라, 용기와, 동료들 그리고 지휘관님의 사랑 덕분이에요! 후후후~ 되게 멋있게 들리죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님, 오늘의 메뉴는——버, 벌써 다 만들었나요?? 이럴 수가… 그럼 볼가가 열심히 생각해낸 메뉴는…… (냠냠) 맛있어요! 그 저기, 지, 지휘관님, 저… 좀 더 주실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"작전의 총결산 말이죠… 으음, 그래서 오늘의 MVP는 누구죠)?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"후아… 지휘관님 잘 주무셨나요? 볼가도 지금 잘 자고 있어요…Zzzz……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"으음, 임무 수고하셨어요~ 보수는 제가 창고로 옮겨 둘게요…… \"혼자서는 위험하니, 같이 옮기는 게 낫겠다\"구요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"왔습니다, 지휘관님, 무슨 일이시죠~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/touch_ex.ogg"},"터치2_ex":{"voiceline":"후후, 정말 어쩔 수 없군요. 지휘관님의 분부라면야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['SN'] : 다들 사이좋게 힘내자구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/couple_encourage1.ogg"},{"voiceline":"['에식스', '인트레피드', '타이콘데로가', '벙커힐', '샹그릴라'] : 저도 제대로된 항공모함… 일지도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"적시에 스트레스를 풀어주는 게 오래 가는 비법이랍니다. 하하, 취미든, 일이든, 인생이든 다 똑같아요… 물론 \"인생\"이라기 보다는 \"장수하고 싶다면\"요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/main5_ex.ogg"},"메인6_ex":{"voiceline":"외출하실 거면 볼가를 불러 주세요. 후후, 그래도 저는 믿음직스럽기로 유명하거든요~ 맞죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"키예프가 제가 만든 도시락은 미묘하데요… 그럴 수가 있나요… 음… 지휘관님도 그렇게 생각하세요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707010/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":707011,"클뜯 함순이 id":70701,"함순이 이름":"볼가","한글 함순이 + 스킨 이름":"맛있는 AR 탐정 체험","영문 함순이 + 스킨 이름":"An Irresistible AR Adventure","스킨 타입":"Special Exercise","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/707011/shipyard.png","설명":"여긴 볼가, 지금 중요한 증인을 추적하고 있습니다… 배, 배가 너무 고파서 그… 이 AR 체험 게임, 체력 소모가 너무 심한데요? 앗, 추적하던 증인을 놓쳐버렸어요…….","자기소개":null,"메인1":{"voiceline":"저번에 벨로루시아가 저 바의 술이 맛있다고 하던데… 아, 집중 집중! 집중해야 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707011/main1.ogg"},"메인2":{"voiceline":"여기부터 달려서 다음 엄폐물까지… 지휘관, 절 잡으세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707011/main2.ogg"},"메인3":{"voiceline":"키로프는 분명 저 건너에서 매복하고 있겠지……. 좋아, 드디어 볼가가 대활약할 순간이 왔어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/707011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"좋아, 이번에는 반드시 증거를 잡고 말겠어요. 지휘관님은 저쪽으로 우회해서 몰아주세요. 그리고… 자, 이거 출출할 때 드세요.","voicelink":"https://raw.githu