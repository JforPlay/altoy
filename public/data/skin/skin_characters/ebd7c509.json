[{"클뜯 id":107060,"클뜯 함순이 id":10706,"함순이 이름":"엔터프라이즈","한글 함순이 + 스킨 이름":"엔터프라이즈","영문 함순이 + 스킨 이름":"Enterprise","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107060/shipyard.png","설명":"요크타운급 항공모함·엔터프라이즈 (CV-6)","자기소개":{"voiceline":"나는 요크타운급 항공모함인 엔터프라이즈. 그레이 고스트는 내가 가진 수많은 이명 중 하나다.\n초연과 선혈의 전력이야말로 내 사명의 증거. 앞으로도 싸움의 끝까지 계속 이겨 보이겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/profile.ogg"},"메인1":{"voiceline":"지휘관인가?…… 최근, 내가 대잠전도 할 수 있는 게 아닐까 의문이 들기 시작했다만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/main1.ogg"},"메인2":{"voiceline":"운도 실력 중 하나? 할 수 있다면 언니에게도 조금 나눠주고 싶군","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/main2.ogg"},"메인3":{"voiceline":"살아 있는 한, 뜻대로 되지 않는 일 따위 얼마든지 있다. 죽는다면 후회를 남기고 싶지 않을 뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/main3.ogg"},"전투개시":{"voiceline":"힘차게 나아가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/battle.ogg"},"상세확인":{"voiceline":"내 훈장 컬렉션이라도 보겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/detail.ogg"},"드랍 설명":{"voiceline":"요크타운급 항공모함·엔터프라이즈 (CV-6)","voicelink":null},"의뢰 완료":{"voiceline":"계속 전장에 있었기 때문에 보급의 중요함을 알 터. 지휘관이여, 뒤에서 노력하는 소녀들을 맞이해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/expedition.ogg"},"실망":{"voiceline":"…지휘관에게는 용기가 충분하지 않은 듯하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/feeling1.ogg"},"낯섦":{"voiceline":"솔직하고 성실하게 살아가는 것이 소원이다. 그러니 의견이 있다면 이쪽에서 사양 말고 말하도록 하지. 그쪽도 떠오른 게 있다면 뭐든 사양 말고 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/feeling2.ogg"},"호감":{"voiceline":"하늘의 빛은 모든 게 별, 바다의 빛은 모든 게 적…… 지휘관, 싸움이 없는 날이 오기는 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/feeling3.ogg"},"기쁨":{"voiceline":"무적 그 자체에는 의미가 없어. 지휘관, 당신이 있으면, 이 몸에 있는 힘을 최대한으로 발휘할 수 있다고 믿는다. 함께 이 전쟁을 끝내도록 하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/feeling4.ogg"},"사랑":{"voiceline":"전쟁이 끝나면 뭘 하고 싶어?──나? 아마 당신을 따라가겠지. 전장이 아니면 당신의 곁이 제일 안심이 되지. 나를 데려가……줄 수 있겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"전투의 다음은 또 전투, 인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/home.ogg"},"hp 경고":{"voiceline":"재미있군…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/hp_warning.ogg"},"로그인":{"voiceline":"왔나. 전투 준비라면, 언제든 되어 있다고","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/login.ogg"},"실패":{"voiceline":"전력을 다해서 진 것이다. 후회는 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 편지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/mail.ogg"},"임무":{"voiceline":"지휘관. 미션이 아직 끝나지 않았다. 서둘러 출발하는 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/mission.ogg"},"임무완료":{"voiceline":"지휘관, 보너스가 도착했다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/mission_complete.ogg"},"서약":{"voiceline":"무수한 전장을 달리고 무수한 이별을 체험해 온 내가 지고 있는 것은 못 셀 만큼의 희망과 의지다. 지휘관도 모든 것을 짊어질 각오가 되어 있는가?——그런가…그럼 생명의 끝까지 함께 나아가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/propose.ogg"},"스킬":{"voiceline":"끝이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/skill.ogg"},"터치1":{"voiceline":"뭐야, 출격인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/touch.ogg"},"터치2":{"voiceline":"뭣……!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/touch2.ogg"},"입수시":{"voiceline":"요크타운급 2번함 엔터프라이즈, 착임했다. 적에게 동정도 손대중도 없이 언제나 전력으로 공격할 생각이다. 이것이야말로 나의 방식이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/unlock.ogg"},"강화성공":{"voiceline":"힘의 끝에 뭐가 있는지…. 보도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관, 가르쳐 줘. 나는 앞으로 몇 척을 가라앉히면 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아카기', '카가', '히류'] : 옛 라이벌과 손을 잡는 느낌도 나쁘지 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/couple_encourage1.ogg"},{"voiceline":"['요크타운', '호넷'] : 진짜 무적이라는 것이 뭔지 알려주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107060/couple_encourage2.ogg"},{"voiceline":"['새러토가'] : 정말 노는 것밖에 모르는 녀석들이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/v