…… 생각했던 것보다 착용감이 좋군. 특제 의장궁도 있는 건가? 재밌군, 어디까지 꿰뚫을 수 있나 시험해 볼까!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관, 다음 싸움까지 조금 휴식해도 괜찮겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107062/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"등롱은 이렇게 장식하면 되는 건가? …지휘관, 마침 잘 와줬다. 이스트 글림의 새해엔 '등롱'이란 랜턴을 장식한다고 들어서, 시험 삼아 장식해봤다만… 어때, 명절 분위기가 나는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107062/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 이 코트는 두 명까지 들어갈 수 있을 것 같다. 어떤가? 안에 들어와서 기능성을 시험해보지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107062/touch.ogg"},"터치2":null,"입수시":{"voiceline":"이것이 이스트 글림의 옷…… 생각했던 것보다 착용감이 좋군. 특제 의장궁도 있는 건가? 재밌군, 어디까지 꿰뚫을 수 있나 시험해 볼까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107062/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70149,"상점 카테고리 id":3,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":107063,"클뜯 함순이 id":10706,"함순이 이름":"엔터프라이즈","한글 함순이 + 스킨 이름":"Anniversary Drive!","영문 함순이 + 스킨 이름":"Anniversary Ride","스킨 타입":"Casual","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107063/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/