:"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/battle.ogg"},"상세확인":{"voiceline":"지금은 당신 마음대로 해도 좋아. 당신이 이 찰나의 굴복에 만족하는 만큼, 이 순간이 끝났을 때에 더 크게 느낄 유감, 후회, 안타까움이…… 나를 가득 채워주겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/detail.ogg"},"드랍 설명":{"voiceline":"머리를 좀 더 이렇게… 후, 됐군. 네가 수고롭게 도울 필요 없어, 지금은 네가 주인이니까. 난 단지 \"널 모시는 존재\"일 뿐. 이 잠깐의 아름다운 꿈을 잘 만끽하라고, 후후.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"……읏, 네……. 무엇이……든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/headtouch.ogg"},"모항귀환":{"voiceline":"어서오세요, \"주인님\". 이 아우구스트에게 무엇이든…… 읏…… 무엇이든 명령해주세요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"왔네, 나의 사역마이자 \"주인님\"인 자. 오늘은 어떤 소망을, 바람을, 소원을 내게 바랄지……. 후후후, 이 꿈이 깨기 전까지는 이루어 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/login.ogg"},"실패":{"voiceline":"……읏, 분수 넘게 굴어서, 정말…… 미안하다…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/lose.ogg"},"우편":{"voiceline":"우편…… 확인을…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"네, \"주인님\"…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/touch.ogg"},"터치2":{"voiceline":"그래, 마음껏 메이드에게 응석을 부리라고, \"주인님\".","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/touch2.ogg"},"입수시":{"voiceline":"머리를 좀 더 이렇게… 후, 됐군. 네가 수고롭게 도울 필요 없어, 지금은 네가 주인이니까. 난 단지 \"널 모시는 존재\"일 뿐. 이 잠깐의 아름다운 꿈을 잘 만끽하라고, 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499061/unlock.ogg"},"강화성공":{"voiceline":"이 힘만이 현실이야.",