io/voiceline/202290/expedition.ogg"},"실망":{"voiceline":"지휘관님 왠지... 좀 이상하지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/feeling1.ogg"},"낯섦":{"voiceline":"내일은 저도 분부대로 지휘관실에서 대기하고 있겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/feeling2.ogg"},"호감":{"voiceline":"지금 해도 안 되는 일을 미뤄두면, 더 이상 할 필요가 없어질지도 모르죠. 음.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/feeling3.ogg"},"기쁨":{"voiceline":"장미꽃잎차 끓이는 법을 배웠는데, 지휘관님도 드셔 보실래요?...... 시큼해요? 음... 설마 저 병에 들어 있던 게 과일식초...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/feeling4.ogg"},"사랑":{"voiceline":"어디서 얼마나 계시던 전 계속 기다리겠어요. 음, 무슨 일이 생겨도 전 여기서 기다릴 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/feeling5.ogg"},"터치3":{"voiceline":"음... 지휘관님이 보기에 제가 아이 같아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님이 안전하게 돌아오는 것만큼 중요한 것 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/home.ogg"},"hp 경고":{"voiceline":"저는... 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/hp_warning.ogg"},"로그인":{"voiceline":"출격하시는 건가요. 돌아오시길 기다리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/login.ogg"},"실패":{"voiceline":"지고 말았어요. 죄송해요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/lose.ogg"},"우편":{"voiceline":"아, 뭔가 잊어버린 거 같은데... 우편? 아, 맞아요. 우편. 지휘관님 새로운 우편이 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/mail.ogg"},"임무":{"voiceline":"지휘관님, 제 생각에 지금쯤 알려드려야 할 거 같은데... 아직 완료하지 않은 임무가 있어요... 구체적인 내용이요? 음...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 임무 완료하셨어요... 이번에도 알려 드려야 할 게 있는데, 그건, 보상이 뭐냐고요? 음...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/mission_complete.ogg"},"서약":{"voiceline":"서약의 반지... 이건... 영원히 함께하자는 뜻인가요? 음... 사실, 항상 제 곁에 계시지 않아도, 저를 기억해 주고, 바라봐 주고, 말을 걸어 주시기만 하면, 그걸로 만족해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/propose.ogg"},"스킬":{"voiceline":"이렇게 하면... 되나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/skill.ogg"},"터치1":{"voiceline":"...어? 무슨 일 있어요? 시킨 일을 어서 다 끝내야 하는데...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/touch.ogg"},"터치2":{"voiceline":"...음? 지휘관님 뭐하고 계세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/touch2.ogg"},"입수시":{"voiceline":"아레투사급 경순양함 페넬로피. 음... 이게 바로 내 이름이에요. 오늘부터 당신의 부하가 되었습니다. 부디... 제 이름을 기억해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/unlock.ogg"},"강화성공":{"voiceline":"전보다 더 강해졌죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관님의 분부대로 승리하였어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"출격하시는 건가요? 저요...? 음, 계속 이곳에서 기다릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관님에 분부대로 하겠습니다. 무슨 일이든 말씀만 하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202290/touch_ex.