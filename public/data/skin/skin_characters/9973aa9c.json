":{"voiceline":"당신이 그렇게 안타까운 사람이었을 줄은…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/feeling1.ogg"},"낯섦":{"voiceline":"오늘도 좋은 날씨네. 이 세계의 추천 명소는 어디야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/feeling2.ogg"},"호감":{"voiceline":"어머, 지휘관이잖아. 때 맞춰 잘 왔네. 클리어가 안되는 스테이지가 있는데, 도와주지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 최근 당신과 게임을 하면 왠지 집중이 안돼. 이건 혹시…… 확인을 위해 좀 더 함께 게임을 하겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/feeling4.ogg"},"사랑":{"voiceline":"이 세계도 익숙해져가네. 이것도 지휘관 덕분이야. 자, 날 잡아봐! 잠깐 동안 데이트하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"좋은 운동이 되었어. 조금 쉬어도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/home.ogg"},"hp 경고":{"voiceline":"퍼플 하트는 겉멋이 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/hp_warning.ogg"},"로그인":{"voiceline":"어서 와. 출격 할래? 연습전 할래? 아니면 푸·디·잉?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/login.ogg"},"실패":{"voiceline":"내게 힘이 없어서 다른 아이들에게 까지 괴로운 경험을 시켜 버렸네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 우편이 왔어. 안 까먹었을 때 읽어두는 편이 좋다고 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/mail.ogg"},"임무":{"voiceline":"임무네… 지휘관도 여신도 하는 건 별반 다르지 않은 모양이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100050/mission.ogg"},"임무완료":{"voiceline":"임무 완료야. 어떤 보수가 있을까 기대되네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/au