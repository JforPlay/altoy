[{"클뜯 id":401990,"클뜯 함순이 id":40199,"함순이 이름":"오토 폰 알벤슬레벤","한글 함순이 + 스킨 이름":"오토 폰 알벤슬레벤","영문 함순이 + 스킨 이름":"Otto von Alvensleben","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401990/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401990/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401990/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401990/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401990/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401990/shipyard.png","설명":"1937J급 구축함-오토 폰 알벤슬레벤","자기소개":{"voiceline":"잘 봐. 눈 앞에 있는 1937년 J형 구축함인 오토 폰 알벤슬레벤의 모습을! ……소감이 어때? 왜 아무 말도 안하는 거야? 이럴 땐 일단 상대방을 칭찬하는 게 기본이잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/profile.ogg"},"메인1":{"voiceline":"이것도 아니야… 이것도. 대체 어디가…… 으앗?! 서류가 다 엉망이 됐잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/main1.ogg"},"메인2":{"voiceline":"지휘관은 똑같은 옷을 많이 가지고 있지? 안 그러면 출격할 때 파도라도 맞으면…… 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/main2.ogg"},"메인3":{"voiceline":"유능한 지휘관이 뭘 그렇게 눈살까지 찌푸려가면서 고민하는 거야? 뭐가 문제인지 나한테도 보여…… 뭐, 뭐가 뭔지 모르겠어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/main3.ogg"},"전투개시":{"voiceline":"잔챙이 상대로 시간 낭비할 생각은 없거든?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/battle.ogg"},"상세확인":{"voiceline":"왜 아까부터 계속…… 아하! 후훗~ 나한테 푹빠져서 눈도 못 떼는 거지? 정말, 솔직하지 못하긴~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/detail.ogg"},"드랍 설명":{"voiceline":"1937J급 구축함-오토 폰 알벤슬레벤","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 동료들이 돌아왔어. 가지고 온 물자 확인하러 안 가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/expedition.ogg"},"실망":{"voiceline":"하아… 지휘관도 겨우 이 정도인가. 소문만큼은 아니네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/feeling1.ogg"},"낯섦":{"voiceline":"지휘관은 좋겠네. 이렇게 유능하고 귀여운 애가 함대에 들어와줘서. 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/feeling2.ogg"},"호감":{"voiceline":"함선 모두 잠수함처럼 바닷속에서 움직일 수 있으면 좋을 텐데. 발을 거의 땅에만 붙이고 있는 지휘관은 이 자유롭게 움직일 수 있는 느낌이 어떤 건지 잘 모르지? 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/feeling3.ogg"},"기쁨":{"voiceline":"으아?! 대체 누가 이 통로에 물건을 놓아둔 거야?! 하마터면 넘어질 뻔…… 안 잡아줘도 괜찮아! 난 걸어 다닐 때마다 넘어지는 바보가 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 오늘은 데이트하러 안 갈래? …어때? 갑자기 데이트 신청해서 놀랐어? 후훗, 지휘관은 이렇다니까……. 자, 잠깐! 뭐야, 그 리스트는?! 설마 벌써 준비해 둔 건…?! 윽… 내가 졌어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/feeling5.ogg"},"터치3":{"voiceline":"대체 무슨 생각인 건지…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/headtouch.ogg"},"모항귀환":{"voiceline":"출격은 어땠어? 바닷바람 때문에 머리가 어지럽진 않아? …그럼 다행이고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/home.ogg"},"hp 경고":{"voiceline":"저, 저렇게 강한 적이 있다는 말은 못 들었다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘도 힘내. 비서함 앞에서 팍팍 어필하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/login.ogg"},"실패":{"voiceline":"내가 이런 실수를…… 무, 무언가 잘못된 게 분명해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/lose.ogg"},"우편":{"voiceline":"겨우 우편을 받는 것까지 비서함을 시키는 지휘관도 참……. 자, 잠깐. 방금 받은 건 이게 아니었던 것 같은데?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/mail.ogg"},"임무":{"voiceline":"이렇게 간단한 임무는 지휘관에겐 식은 죽 먹기지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/mission.ogg"},"임무완료":{"voiceline":"임무 보상을 아직까지 방치해뒀네…. 이제 하루가 다 되어 간다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/mission_complete.ogg"},"서약":{"voiceline":"자, 자, 잠깐! 너무 전개가 빠르지 않아?! 시, 싫은 건 아니지만……. 그럼 괜찮지 않냐고?! 그럴 리 없잖아! ……으으, 대체 뭐야, 놀림 받았는데 화가 안 나는 이 느낌은…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/propose.ogg"},"스킬":{"voiceline":"날 따라올 수 있겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/skill.ogg"},"터치1":{"voiceline":"응? 설마, 지휘관… 나한테 '그렇고 그런 짓'을 하려는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/touch.ogg"},"터치2":{"voiceline":"자, 잠깐! 설마 진심으로 그러는 건 아니지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/touch2.ogg"},"입수시":{"voiceline":"어라? 소문이 무성한 지휘관이라 기대했는데, 좀 여리여리한 느낌이네? 하긴 무대 뒤에서 업무를 보는 거니까 두뇌파일 것 같기는 했어. 난 메탈 블러드 구축함인 오토 폰 알벤슬레벤이야. 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/unlock.ogg"},"강화성공":{"voiceline":"그렇게 빨리 날 강하게 만들고 싶은 거야? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 정도야 식은 죽 먹기지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401990/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"흐음~ 이거 누군가 했더니 지휘관이었네. 오늘도 내 앞에서 착착 일하려구?","voicelink":"https://raw.githubusercontent.com/Fernando26