[{"클뜯 id":101380,"클뜯 함순이 id":10138,"함순이 이름":"킴벌리","한글 함순이 + 스킨 이름":"킴벌리","영문 함순이 + 스킨 이름":"Kimberly","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101380/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101380/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101380/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101380/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101380/shipyard.png","설명":"플레처급 구축함 - 킴벌리 (DD-521) ","자기소개":{"voiceline":"플레처급의 킴벌리입니다. 선단 호위와 대잠작전을 주로 담당했습니다. 저의 힘이 필요하다면 사용해 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/profile.ogg"},"메인1":{"voiceline":"피곤하신 것 같으면 쉬어주십시오. 지휘관님이 쓰러지면 함대 지휘에 큰일이 생기니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/main1.ogg"},"메인2":{"voiceline":"어디에 있든, 어떤 이름으로 불리든, 살아있는 한 저는 싸웁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/main2.ogg"},"메인3":{"voiceline":"전쟁을 위해 태어나 평화를 위해 가라앉는다…… 제가 생각하고 있는 것은 그뿐입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/main3.ogg"},"전투개시":{"voiceline":"요격, 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/battle.ogg"},"상세확인":{"voiceline":"뭘 보고 있는 겁니까? 자리로 돌아가 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함 - 킴벌리 (DD-521)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었습니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/expedition.ogg"},"실망":{"voiceline":"무능한 자는 시대에 뒤쳐집니다. 당신 또한… 마찬가지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/feeling1.ogg"},"낯섦":{"voiceline":"계속 이겨나가면 전쟁이 끝날까… 이 문제의 답을 찾는 것보다, 눈앞의 싸움에 이기는 데 집중하는 편이 합리적입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/feeling2.ogg"},"호감":{"voiceline":"전쟁이 끝나면 무엇이 하고 싶은가…… 생각한 적도 없고, 생각하고 싶지도 않습니다. 하지만 갑자기 왜 이걸…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/feeling3.ogg"},"기쁨":{"voiceline":"이상한… 꿈을 꿨습니다. 더는 싸우지 않게 된 제가, 잘 아는 사람과 손을 잡은 채로 모항에서 산책하고…… 뭐, 뭔가 이상합니까!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/feeling4.ogg"},"사랑":{"voiceline":"모두에게 상담받다 드디어 알았습니다. 전쟁이 정말로 끝난다면, 무엇하나 할 수 없게 된 저는…… 그때는 곁에서 제게 이것저것 가르쳐 주시는 겁니까? 그렇군요, 확실히 그거라면…… 에에에!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/feeling5.ogg"},"터치3":{"voiceline":"이건…… 무슨 의미입니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/headtouch.ogg"},"모항귀환":{"voiceline":"시간 맞춰 귀환하셨군요. 하지만 아직 안심할 수 있는 시간은 아니에요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/home.ogg"},"hp 경고":{"voiceline":"손상 확인, 전투 속행…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/hp_warning.ogg"},"로그인":{"voiceline":"시간 준수는 좋은 습관입니다. 앞으로도 잘 부탁합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/login.ogg"},"실패":{"voiceline":"전략적 퇴각……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/lose.ogg"},"우편":{"voiceline":"우편입니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/mail.ogg"},"임무":{"voiceline":"지휘관으로서 이 임무들도 해내야 합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었습니다. ……지휘관님의 책무는 이것뿐만이 아닙니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/mission_complete.ogg"},"서약":{"voiceline":"이, 이것은 서약의 반지…… 이런 때가 오다니 꿈에도 생각 못했습니다… 하, 하지만 지금은 아주, 아주 기쁘고, 행복해서…… 이것이 모두가 말했던 '사랑'…… 우, 웃지 마십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/propose.ogg"},"스킬":{"voiceline":"쓸데없는 싸움은 그만두십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/skill.ogg"},"터치1":{"voiceline":"지시하실 일은 있습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/touch.ogg"},"터치2":{"voiceline":"군사 법정에 출정하고 싶으신 겁니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/touch2.ogg"},"입수시":{"voiceline":"플레처급의 킴벌리입니다. 오늘부로 여기 배속되었습니다. 잘 부탁합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/unlock.ogg"},"강화성공":{"voiceline":"전력의 강화도 중요합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋은 콤비네이션이었습니다. 다음에도 잘 부탁합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101380/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":101382,"클뜯 함순이 id":10138,"함순이 이름":"킴벌리","한글 함순이 + 스킨 이름":"안양의 이문화 공부","영문 함순이 + 스킨 이름":"Style of the East","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101382/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101382/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101382/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101382/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101382/shipyard.png","설명":"이스트 글림의 의상을 입고 있으면 그 시절의 일이 떠오르네요… 지휘관님, 이글 유니온의 의상과 이스트 글림의 의상, 어떤 게 좋으신가요? ","자기소개":null,"메인1":{"voiceline":"이스트 글림의 동료들이 재밌는 옛날이야기를 잔뜩 들려줬답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/main1.ogg"},"메인2":{"voiceline":"요새는 피리를 배우고 있어요. 지휘관님, 들어보실래요? ……우, 웃으면 안돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/main2.ogg"},"메인3":{"voiceline":"음…… 붓으로 글자를 쓰는 건 어렵네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이스트 글림과 유니온은 역시 다른 점이 많네요. 하지만, 어느 소속이건 미래를 지키겠다는 기분은 다들 같습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/detail.ogg"},"드랍 설명":{"voiceline":"이스트 글림의 옷을 입고 있으면 그 시절이 떠올라요… 지휘관님, 유니온의 옷과 이스트 글림의 옷, 어느 쪽이 더 좋으세요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님 곁에서 일하고 있으면, 왠지 의욕도 샘솟고 업무 효율도 오르네요. 이건… 지휘관님의 매력 덕분일까요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/feeling5.ogg"},"터치3":{"voiceline":"지, 지휘관님…… 만두 머리가 흐트러져버려요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/headtouch.ogg"},"모항귀환":{"voiceline":"모항에 돌아올 때마다 마음이 차분해지네요. 이게 바로 '우리 집'이란 걸까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"이스트 글림에는 '하루의 계획은 아침에 달려 있다'란 속담이 있어요. 하지만, 굳이 아침이 아니더라도, 뭐든 항상 시작은 좋았으면 해요. 지휘관님도 그렇게 생각하시지 않으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"내일이 지나면 또 내일, 내일만 기다리는 인생은 만사에 차질이 있을 터' …오늘 임무는 내일로 미루지 않도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었습니다. 지휘관님, 잠깐 휴식하시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"업무가 아직 꽤 남아있네요…… 하지만 괜찮아요, 지휘관님, 같이 힘내죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/touch.ogg"},"터치2":{"voiceline":"지휘관님… 이런 짓을 하면 잡혀가 버린다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/touch2.ogg"},"입수시":{"voiceline":"이스트 글림의 옷을 입고 있으면 그 시절이 떠올라요… 지휘관님, 유니온의 옷과 이스트 글림의 옷, 어느 쪽이 더 좋으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101382/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70155,"상점 카테고리 id":3,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0}]