[{"클뜯 id":108010,"클뜯 함순이 id":10801,"함순이 이름":"데이스","한글 함순이 + 스킨 이름":"데이스","영문 함순이 + 스킨 이름":"Dace","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108010/shipyard.png","설명":"가토급 잠수함 데이스 (SS-247)","자기소개":{"voiceline":"내 이름은 데이스! 좋아하는 건 토르피유(어뢰), 토르페도(어뢰), 그리고 어뢰야! 가토급? 아, 그래 그래! 그러고 보니 나 가토급이지! 전투 성적은…그게…그 대전에선 마야를 격침시킨 적이 있어! 혹시 여기 있어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/profile.ogg"},"메인1":{"voiceline":"'데이스의 어뢰 서커스', 언젠가 해보는 게 꿈이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/main1.ogg"},"메인2":{"voiceline":"지휘관, 어뢰의 기본을 알려줄게! 엄청 재밌어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/main2.ogg"},"메인3":{"voiceline":"지휘관, 어뢰 초콜렛이라든지 어뢰 빵이라든지 한 번 먹어볼래? 내가 만들었어! 자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/main3.ogg"},"전투개시":{"voiceline":"어뢰 준비 완료~ 간다아~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/battle.ogg"},"상세확인":{"voiceline":"만지면 시원시원, 볼 때는 반짝반짝, 쏘면 퍼엉~하고 폭발하고 쏴아~하고 물보라가 일어나……지휘관, 어뢰는 역시 최고라고 생각하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/detail.ogg"},"드랍 설명":{"voiceline":"가토급 잠수함 데이스 (SS-247)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰에 나갔던 모두가 돌아왔어! 좋네~ 나도 어뢰를……앗, 잘못 말했다, 의뢰야 의뢰! 지휘관? 어~이, 지휘관~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/expedition.ogg"},"실망":{"voiceline":"어뢰 애호가 실격! 무르기 없기야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/feeling1.ogg"},"낯섦":{"voiceline":"오늘도 어뢰를 쏘기 딱 좋은 날이네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/feeling2.ogg"},"호감":{"voiceline":"마야 말야, 사실은 강하지…? 역시 그때는 방심하고 있었을 뿐이었던 걸까. 뭐, 그렇게 허를 찌르는 게 잠수함의 강점이지만 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 다음에 내 어뢰 쇼를 보지 않을래? 지휘관이 없으면 뭔가 제 실력이 안 나온단 말이지……그러니까 반드시 보러 와줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/feeling4.ogg"},"사랑":{"voiceline":"지휘관과 어뢰, 어느 쪽이 더 소중할까……윽, 어뢰는 잔뜩 있지만 지휘관은 한 사람밖에 없으니까, 지휘관이 더 중요하지! 응, 분명 그럴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 수고했어! 자, 어뢰 줄게! 무슨 일이냐고? 피곤하면 어뢰를 안고 자는 게 제~일 기분 좋은 거라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/home.ogg"},"hp 경고":{"voiceline":"엥, 내가 있는 장소를 들킨 거야……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/hp_warning.ogg"},"로그인":{"voiceline":"아~ 지휘관, 딱 좋을 때 와줬네! 발밑에 어뢰 줍는 것 좀 도와줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/login.ogg"},"실패":{"voiceline":"어, 어뢰라도 좀 더 쏘게 해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/lose.ogg"},"우편":{"voiceline":"지휘관! 우편이야! 어뢰 같은 게 있으려나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/mail.ogg"},"임무":{"voiceline":"지휘관~ 저기, 그러니까, 그런 거 있잖아, 어뢰 마음껏 쏘기 임무 같은 거, 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/mission.ogg"},"임무완료":{"voiceline":"어뢰 with 임무 보수, 발사~! 지휘관, 못 받아도 모른다고~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/mission_complete.ogg"},"서약":{"voiceline":"이걸 나에게? 진짜? 에헤헤~ 굿잡! 지휘관, 약속할게. 다음에 '여기에 어뢰를 쏴줘' 라고 지시해주면, 절대 엉뚱한데 쏘는 일은 없을 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/propose.ogg"},"스킬":{"voiceline":"어뢰 일제 발사! 가라~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/skill.ogg"},"터치1":{"voiceline":"지휘관, 몇 십 개나 되는 어뢰가 일제히 폭발하면…엄청 멋진 광경이 될 거 같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/touch.ogg"},"터치2":{"voiceline":"어뢰 일제 발사! 지휘관을 노려라~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/touch2.ogg"},"입수시":{"voiceline":"Hi~ 당신이 지휘관? 이글 유니온 잠수함 데이스, 착임~ 그럼 인사치레로 어뢰, 몇 발 쏴도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 뇌격 강화를 우선시하는 거, 잊고 있지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흐흥~ 이게 어뢰의 위력이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0}]