[{"클뜯 id":10900040,"클뜯 함순이 id":1090004,"함순이 이름":"릴라 디자이어스","한글 함순이 + 스킨 이름":"릴라 디자이어스","영문 함순이 + 스킨 이름":"Lila Decyrus","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900040/shipyard.png","설명":"오렌족의 전사 릴라 디자이어스다. 지금은 중순양함이 되었지만 상관없어. 전투에 영향은 없으니까. 여기서 신세를 지는 이상 나도 전사로서 역할을 다하도록 하겠다.","자기소개":{"voiceline":"오렌족, 백아씨족인 릴라 디자이어스다. 일족으로서 맺은 맹세를 다하기 위해, 각지를 여행하고 있지. 설령 끝이 없는 여행이라 할지라도… 나는 절대 포기하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/profile.ogg"},"메인1":{"voiceline":"여기 적은 세이렌이라고 부르는군. 필후사와는 또 다른 건가….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main1.ogg"},"메인2":{"voiceline":"지휘관, 마침 잘 왔다. 좀 훈련에 어울려주지 않겠나? 너무 평화로워서 몸이 녹슬어버릴 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main2.ogg"},"메인3":{"voiceline":"이곳엔 다양한 자들이 있군. 특히 '사쿠라 엠파이어'라는 자들…. 그 자들과 이야기를 하고 있으면, 나도 모를 친근감이 느껴져….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main3.ogg"},"전투개시":{"voiceline":"적이다! 내가 앞장서지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/battle.ogg"},"상세확인":{"voiceline":"가구는 받았지만, 살 수 있는 방으로 만들려면 조금 정리가 필요하다. 그렇지만… 이런 작업은 귀찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/detail.ogg"},"드랍 설명":{"voiceline":"오렌족의 전사 릴라 디자이어스다. 지금은 중순양함이 되었지만 상관없어. 전투에 영향은 없으니까. 여기서 신세를 지는 이상 나도 전사로서 역할을 다하도록 하겠다.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 동료들이 돌아온 모양이군. 그럼 어떤 성과를 남기고 왔을지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/expedition.ogg"},"실망":{"voiceline":"슬슬 돌아갈 방법을 찾아야….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/feeling1.ogg"},"낯섦":{"voiceline":"무슨 일이지, 지휘관? 볼일이 있으면 빨리 끝내라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/feeling2.ogg"},"호감":{"voiceline":"내겐 해내야 할 일이 있어. 끝이 찾아오는 그 순간까지 멈춰 있을 시간은 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/feeling3.ogg"},"기쁨":{"voiceline":"맹세를 이루기 위해 여행을 하는 나와 평화를 지키기 위해 계속 싸우는 너…. 서로 사명을 짊어지고 있다는 점에서 우리는 비슷할지도 모르겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/feeling4.ogg"},"사랑":{"voiceline":"지휘관으로서의 네 각오, 확실히 보았다. 그걸 인정하는 의미로, 이 세계에 있는 동안에는 너를 위해 힘을 쓰겠다고 약속하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/feeling5.ogg"},"터치3":{"voiceline":"도움이 필요하다고? 전투라면야…. 뭐? 사무 작업이라고? …왜 내가 해야 하지? 네가 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔군. 연전도 좋지만, 적당히 휴식을 취하는 것도 중요하다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/home.ogg"},"hp 경고":{"voiceline":"긁혔을 뿐이다. 아직 더 싸울 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/hp_warning.ogg"},"로그인":{"voiceline":"뭔가? 아직도 잠이 덜 깬 건가? 지휘관이라는 자가 정신 바짝 안 차리면 곤란하다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/login.ogg"},"실패":{"voiceline":"다들 서둘러서 퇴각하라! 뒤는 내게 맡기고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/lose.ogg"},"우편":{"voiceline":"지휘관, 무언가 온 모양이다. 누가 보낸 건지는 알 수 없다만… 이상한 건 아닐듯하군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/mail.ogg"},"임무":{"voiceline":"지휘관, 해야 할 일은 먼저 해치우는 편이 좋다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/mission.ogg"},"임무완료":{"voiceline":"네가 처리한 일에 대한 보상이 도착했군. 확실히 받아 두라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/mission_complete.ogg"},"서약":{"voiceline":"넌 내 목적을 이해하고, 날 동료로 받아들여 줬지. 그 은혜에 보답하기 위해서… 조금만 더 네 힘이 되려고 한다. 다시 잘 부탁한다, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/propose.ogg"},"스킬":{"voiceline":"일기당천이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/skill.ogg"},"터치1":{"voiceline":"강해지고 싶다고? 뭐, 너에게라면 전사의 마음가짐을 알려줄 수 있겠군. 그 대신… 모항 안내라도 좀 받도록 할까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/touch.ogg"},"터치2":{"voiceline":"제거될 각오는 된 모양이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/touch2.ogg"},"입수시":{"voiceline":"오렌족의 전사 릴라 디자이어스다. 지금은 중순양함이 되었지만 상관없어. 전투에 영향은 없으니까. 여기서 신세를 지는 이상 나도 전사로서 역할을 다하도록 하겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/unlock.ogg"},"강화성공":{"voiceline":"목적을 달성할 때까지, 나는 절대 멈추지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"나는 멈춰설 수 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/win_mvp.ogg"},"전투개시_ex":{"voiceline":"적인가. 다들, 방심하지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/battle_ex.ogg"},"상세확인_ex":{"voiceline":"몇 살이냐고? 지휘관, 그런 게 뭐가 중요하다고 그러나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"무슨 일인가? 고민이라도 있는 건가? 말하고 싶은 게 있다면 푸념이든 뭐든 털어놔라. 평소라면 이런 건 잘 들어주지 않지만, 오늘은 특별히 어울려주도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"그래, 건강해 보여서 다행… 응? 이거 또 잠이 덜 깬 모양이로군. 정말, 넌 여전하다고 해야 할지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"업무가 아직 남아있는 모양이군. 도움이 필요하면 내게 맡겨라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/mission_ex.ogg"},"임무완료_ex":{"voiceline":"끝난 건가. 잘 했다. 고생 많았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"…거기 앉아라. 그 근성을 싹 뜯어 고쳐주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"네 지시 덕분에 잘 싸울 수 있었다. 감사하마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['라이잘린 스타우트'] : , 내게 맡겨라, 라이자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/couple_encourage1.ogg"},{"voiceline":"['파트리샤 아벨하임'] :  소질이 있군, 파트리샤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/couple_encourage2.ogg"},{"voiceline":"['세리 글로스'] :  서로 사명을 다하도록 하자고, 세리.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/couple_encourage3.ogg"}],"메인4":{"voiceline":"엔터프라이즈라고 하던가. 나와는 조금 다르지만, 그 녀석 또한 전투에 죽고 사는 훌륭한 전사 중 하나겠지. 많은 훈장을 손에 넣은 그 힘… 언젠가는 겨뤄보고 싶군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"같이 쇼핑하러 가줬으면 한다고? 그래, 호위가 필요한 거로군. 내게 맡겨라. 그런 거엔 익숙… 응? 그런 게 아니라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main6_ex.ogg"},"메인7_ex":{"voiceline":"지휘관, 졸리면 책상 말고 침대에서 쉬어라. 그러는 편이 피로도 풀릴 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main7_ex.ogg"},"메인8_ex":{"voiceline":"내 훈련에 어울려준 덕분인지, 너도 움직임이 가벼워진 것 같군. 다음에는 실력 테스트라도 해볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"호오, 나와 한판 겨루고 싶은 건가? 좋아, 받아주마. …아니, 갑자기 덤벼들다니, 꽤나 행동이 빠른 녀석이로군….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"비스마르크라… 얼마 전, 메탈 블러드의 모의 전투를 봤는데, 그 녀석이 싸우는 모습은 압권이더군. 많은 전사들을 지휘하면서 자신 또한 사력을 다해 아군을 승리로 이끄는 모습…. 저런 전사의 모습은 이곳에서만 볼 수 있는 것이겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main9_ex.ogg"},"메인10_ex":{"voiceline":"절대 명중, 불침함, 올드 레이디…. 자세히는 모르겠다만, 네가 역전의 전사라는 것만은 잘 알겠군. 그렇지만 왜 그렇게 불만스러운 얼굴을 하고 있는 거지…. 응? 몸매가 어떻다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900040/main10_ex.ogg"},"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"RYZA","레어도":"SR","ex_chat_status":1},{"클뜯 id":10900041,"클뜯 함순이 id":1090004,"함순이 이름":"릴라 디자이어스","한글 함순이 + 스킨 이름":"월하의 만남","영문 함순이 + 스킨 이름":"Moonlit Encounter","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900041/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1090