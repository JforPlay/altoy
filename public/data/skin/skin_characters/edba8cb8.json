[{"클뜯 id":404020,"클뜯 함순이 id":40402,"함순이 이름":"그나이제나우","한글 함순이 + 스킨 이름":"그나이제나우","영문 함순이 + 스킨 이름":"Gneisenau","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404020/shipyard.png","설명":"샤른호르스트급 전함 - 그나이제나우","자기소개":{"voiceline":"그나이제나우 입니다. 언니만큼 호전적이진 않지만, 전투력에는 자신 있습니다……메탈 블러드에서 가장 우수한 함대의 일원으로서, 언니와 유일하게 전함으로 항모를 격침시킨 성과를 달성했습니다. 부디 저희를, 더 믿어주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/profile.ogg"},"메인1":{"voiceline":"오늘 하지 않는 건, 내일 해낼 수 있을리 없습니다. 그 점 주의해 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/main1.ogg"},"메인2":{"voiceline":"후방에 오래 있으면 전선의 잔혹함을 잊어버리게 됩니다. 그 반대도 마찬가지죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/main2.ogg"},"메인3":{"voiceline":"지금 생각해보면, 그 자존심 강한 아가씨를 융통성이라곤 찾아볼 수 없는 기사로 잘못 봤다는 게 도무지 이해가 가지 않네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/main3.ogg"},"전투개시":{"voiceline":"대포의 사정범위 안에만, 진리가 있는 거야","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/battle.ogg"},"상세확인":{"voiceline":"제 사명은 언제나 물불 안 가리고 뛰어드는 언니를 서포트 하는 것…하지만…가끔은 좀 귀찮다고 생각하곤 합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/detail.ogg"},"드랍 설명":{"voiceline":"샤른호르스트급 전함 - 그나이제나우","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰가 완료되었습니다. 성과를 확인하시겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/expedition.ogg"},"실망":{"voiceline":"좀 더 현명한 지휘관이라 생각했었습니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/feeling1.ogg"},"낯섦":{"voiceline":"무슨 일이십니까? 교류는 간단하고 효율이 높은 편이 바람직합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/feeling2.ogg"},"호감":{"voiceline":" '추악한 자매들' ……저희의 전투 성과에 대한 찬사입니다만, 역시 좀 상처받는 말이네요. 지휘관님, 저 추하게 생겼나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/feeling3.ogg"},"기쁨":{"voiceline":"언니의 서포트 외에도, 지휘관님을 보좌하는 것도 습관이 되었네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/feeling4.ogg"},"사랑":{"voiceline":" '지금' 이 시간이 빠르게 지나가도, '미래' 는 언제나 늦게 오게 되죠. ……저와 지휘관님이 이뤄나갈 미래, 하루빨리 확인하고 싶네요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 오십시오. 이제 편히 쉬시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/home.ogg"},"hp 경고":{"voiceline":"전 함, 방어에 주의해주십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/hp_warning.ogg"},"로그인":{"voiceline":"어서 오십시오. 업무를 시작하시겠습니까? 지휘관님께 필요한 것들을 준비했습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/login.ogg"},"실패":{"voiceline":"방심했나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 우편이 도착했습니다, 여기.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/mail.ogg"},"임무":{"voiceline":"임무입니까……제가 계획을 세워보죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/mission.ogg"},"임무완료":{"voiceline":"보수가 도착했습니다. 확인하여 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/mission_complete.ogg"},"서약":{"voiceline":"서약……입니까. 감정으로 사람을 엮는 것은 제 스타일이 아닙니다만, 지금은 약간…좋다고 생각합니다. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/propose.ogg"},"스킬":{"voiceline":"…사정범위에 들어왔구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/skill.ogg"},"터치1":{"voiceline":"같은 사람과 같은 화제를 논하는데 다른 결론이 나온다는 거, 재미있다 생각하지 않으십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/touch.ogg"},"터치2":{"voiceline":"지휘관님, 안톤이 당신을 노리고 있답니다. 이제 도망칠 수 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 지휘관님. 저는 그나이제나우. 언니는 늘 무턱대고 들이대는 편이지만, 저희가 함께하면 무적이랍니다. 그러니 언니와 함께 행동하게 할 수 있도록 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/unlock.ogg"},"강화성공":{"voiceline":"힘에 빠져 판단력을 잃지 않으면 좋겠습니다만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"미안하군, 이건 전쟁이야. 적당히 봐줄 여유 따윈 없거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":404021,"클뜯 함순이 id":40402,"함순이 이름":"그나이제나우","한글 함순이 + 스킨 이름":"서큐버스 나이트메어","영문 함순이 + 스킨 이름":"Nigh