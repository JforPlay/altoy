dtouch.ogg"},"모항귀환":{"voiceline":"\"아, 여러분 안녕~! 나는 하얀 세상에서 온 버츄얼 아이돌 새러쨩!\" 어때? 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107033/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"다녀왔어, 지휘관! 아이쨩이 다음 콘서트를 위해 만든 노래 연습 하는 걸 보러갈 참이었어. 흔치 않은 기회라구! 같이 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107033/login.ogg"},"실패":{"voiceline":"미안해, 지휘관…… 져버렸어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107033/lose.ogg"},"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"모처럼 버츄얼 아이돌이 됐는데, 새러쨩도 신곡을 좀 만들어볼까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107033/touch.ogg"},"터치2":{"voiceline":"……으아! 지휘관, 어딜 만지는거야? 으, 여기를 만지면 본인인지 아닌지 알 수 있다고…? 이런거 안 가져와~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107033/touch2.ogg"},"입수시":{"voiceline":"안녕 여러분~ 나는 버츄얼 아이돌 새러토가! 지휘관, 어때? 아이쨩에게 특별히 부탁해서 만든 새러토가 전용 키즈나 아이 코스튬이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107033/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"WINNER~! 역시 아이쨩이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107033/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"기타","상점 id":70179,"상점 카테고리 id":9999,"스킨 태그":"배경","입수 영상":"X","재화":700,"기간":"한정 (2020/04/15)","진영":"USS","레어도":"SR","ex_chat_status":0},{"클뜯 id":107034,"클뜯 함순이 id":10703,"함순이 이름":"새러토가","한글