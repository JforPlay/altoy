031/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/137031/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/137031/shipyard.png","설명":"짜잔~♪ 청순 모드에 드레스까지 차려입고 새러토가 등장! 후후훗, 지휘관이 이렇게 빨리 암호로 숨겨둔 장소를 찾아낼 줄은 몰랐어! 보상으로 사랑스러운 새러토가와의 달콤한 시간을 선물할게!","자기소개":null,"메인1":{"voiceline":"지휘관, 어때? 새러토가가 지휘관이랑 같이 쉬려고 고른 곳, 꽤 근사하지? 후후, 아침 해가 뜨면 반짝반짝해서 마음이 깨끗해지는 느낌이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/main1.ogg"},"메인2":{"voiceline":"지휘관, 새러토가의 드레스 모습은 어때? 에헤헤, 역시 검은 색이 가장 잘 어울리지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/main2.ogg"},"메인3":{"voiceline":"새러토가의 장난? 후후후, 장난을 칠 거라고 조바심 내게 만들고, 일부러 아무것도 안 하는 것도 장난이야☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"검은 드레스에 하얀 스타킹. 에헤헤, 오늘은 새러토가… 나름 힘 좀 줬거든! 지휘관, 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/detail.ogg"},"드랍 설명":{"voiceline":"짜잔~♪ 청순 모드에 드레스까지 차려입고 새러토가 등장! 후후훗, 지휘관이 이렇게 빨리 암호로 숨겨둔 장소를 찾아낼 줄은 몰랐어! 보상으로 사랑스러운 새러토가와의 달콤한 시간을 선물할게!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관, 얼굴을 더 가까… 꺅?! …가, 갑자기 장난치고 너무해! 이렇게 나오면! 지휘관, 눈 감아! 지금부터는 새러토가가 반격할 차례야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어~ 여기로 빠져나오는 동안 누가 보진 않았지? 뭐, 봤다고 해도 딱히 켕길 건 없지만~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 어디 보는 거야. 이쪽이야~ 에헤헤, 새러토가… 계속 기다렸다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"으아, 지휘관. 설마 임무를 방치하면서까지 새러토가를 몰래 만나러 온 거야? 흐음… 이러면 새러토가, 난감하다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/mission.ogg"},"임무완료":{"voiceline":"정말, 임무를 다 처리하자마자 새러토가를 만나러 온 거야? 깜짝 놀랐네! 그럼 보상에 덤으로 지휘관을 위한 키스도 붙여줄게! 쪽♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 여기서 새러토가랑 한 곡 추지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/touch.ogg"},"터치2":{"voiceline":"헤헷~ 아무도 없으니까 새러토가도 반격할 거야☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/touch2.ogg"},"입수시":{"voiceline":"짜잔~♪ 청순 모드에 드레스까지 차려입고 새러토가 등장! 후후훗, 지휘관이 이렇게 빨리 암호로 숨겨둔 장소를 찾아낼 줄은 몰랐어! 보상으로 사랑스러운 새러토가와의 달콤한 시간을 선물할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"지휘관의 오늘 밤 댄스 파트너는 이 새러토가야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/137031/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":71015,"상점 카테고리 id":7,"스킨 태그":"X","입수 영상":"X","재화":700,"기간":"한정 (2025/06/25)","진영":"USS","레어도":"SR","ex_chat_status":0}]