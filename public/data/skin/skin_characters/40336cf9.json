[{"클뜯 id":9704030,"클뜯 함순이 id":970403,"함순이 이름":"리펄스·META","한글 함순이 + 스킨 이름":"리펄스·META","영문 함순이 + 스킨 이름":"Repulse META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704030/shipyard.png","설명":"리나운급 순양전함인 리펄스야. 여러 일을 겪었지만… 뭐, 지금은 이 모항의 일원이니까 도움이 필요한 부분이 있다면 뭐든 맡겨줘.","자기소개":{"voiceline":"리나운급 순양전함인 리펄스야. 언니랑 함께 여러 가지 일을 겪었어…. 뭐, 자세한 건 다음에 말해줄게. 음… 이 모항은 조용하고 평화로워서 자유를 만끽하기에 딱 좋네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/profile.ogg"},"메인1":{"voiceline":"후우……. 아, 무슨 일이야? 창문으로 밖을 내다보다가 넋을 잃었나봐. 미안해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/main1.ogg"},"메인2":{"voiceline":"인생은 짧으니까 만난 동료들을 소중히 하고, 매 순간을 소중히 여기며 살자구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/main2.ogg"},"메인3":{"voiceline":"'로열 나이트'? 분명 로열 네이비에는 '나이트'의 미담이 있긴 한데…. 그것보다 업무 중에는 딴청 피우면 안 되지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/main3.ogg"},"전투개시":{"voiceline":"기왕 출격하는 거니까, 기합 넣고 가보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/battle.ogg"},"상세확인":{"voiceline":"역전의 영웅이 싸움에 지쳐 마음속 평안을 구하게 된다면… 세상은 받아들여 줄까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/detail.ogg"},"드랍 설명":{"voiceline":"리펄스호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 동료들이 돌아왔어. 지휘관, 고생한 그녀들을 치하해주는 걸 잊지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/expedition.ogg"},"실망":{"voiceline":"자포자기하면 안 돼. 지금은 잠깐 방향을 잃었을 뿐, 동료라는 사실은 변하지 않아. 그러니까 내가 올바른 방향으로 돌아갈 수 있도록 이끌어 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/feeling1.ogg"},"낯섦":{"voiceline":"동료와 이야기하거나, 모항을 산책하거나, 피곤하면 벤치에서 잠깐 눈을 붙이거나…. 귀중하고 느긋한 모항 생활… 영원히 끝나지 않았으면 좋겠어….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/feeling2.ogg"},"호감":{"voiceline":"쉴 수 있을 때는 무리하지 말고 쉬는 편이 좋아. 쉴 수 없는 날이 언제 찾아올지, 아무도 모르니까 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/feeling3.ogg"},"기쁨":{"voiceline":"오늘 지휘관, 무리하는 거 아니지? …그럼 다행이고. 그렇지만 임무가 계속 이렇게 꼬리에 꼬리를 물어서… 어깨 위의 무거운 짐을 내려놓을 날은 아직 먼 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 내 제일가는 동료이자 신뢰할 수 있는 사람이니까, 바쁜 업무에 몸을 갉아 먹히는 모습만은 보고 싶지 않아…. 만약 한계에 달했다고 느낄 땐, 모든 걸 내던져도 괜찮아. 내가 전력을 다해서 힘이 되어줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"휴우… 무사히 돌아와서 다행이야…. 지휘관은 이게 당연한 거라 생각할지도 모르지만, 내겐 이런 걸 상상도 못했던 시절이 있었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/home.ogg"},"hp 경고":{"voiceline":"아직… 지금부터야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/hp_warning.ogg"},"로그인":{"voiceline":"응, 지휘관은 여전히 업무에 열심이구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/login.ogg"},"실패":{"voiceline":"…제때 철수해서 반격의 불씨는 남길 수 있었…지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/lose.ogg"},"우편":{"voiceline":"우편이야. 신경 써 주는 사람이 있다는 건 행복한 일이겠지? 답장하는 거 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/mail.ogg"},"임무":{"voiceline":"새로운 임무? 어디 보자… 지금까지 겪은 경험으로 뭔가 도움이 될 부분은 없으려나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/mission.ogg"},"임무완료":{"voiceline":"임무를 무사히 완료했어! 이걸로 동료들과 함께 보내는 시간을 만들 수 있겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/mission_complete.ogg"},"서약":{"voiceline":"나 자신의 매력에 대해서는 별 자신감도 없고, 이런 나라도 괜찮은 걸까 하고 지금까지 계속 망설이고 있었어…지휘관이 그렇게 말해줬으니 나도 용기를 내서 대답할게…후훗, 당연히 YES지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/propose.ogg"},"스킬":{"voiceline":"모두를… 지킬 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/skill.ogg"},"터치1":{"voiceline":"걱정해주는 거야? 응, 지금은 컨디션 좋아. 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/touch.ogg"},"터치2":{"voiceline":"이상한 짓은 하지 않는 편이 신상에 좋을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/touch2.ogg"},"입수시":{"voiceline":"리나운급 순양전함인 리펄스야. 여러 일을 겪었지만… 뭐, 지금은 이 모항의 일원이니까 도움이 필요한 부분이 있다면 뭐든 맡겨줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/unlock.ogg"},"강화성공":{"voiceline":"언젠가 이 의장을 쓰지 않아도 되는 날이 오면 좋겠네….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아, 이겼어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특