[{"클뜯 id":11100030,"클뜯 함순이 id":1110003,"함순이 이름":"모모 베리아 데빌룩","한글 함순이 + 스킨 이름":"모모 베리아 데빌룩","영문 함순이 + 스킨 이름":"Momo Belia Deviluke","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100030/shipyard.png","설명":"안녕하세요. 당신이 여기 지휘관님이시죠? 저는 모모 베리아 데빌룩이라고 해요. 모모라고 불러주세요. 앞으로 잘 부탁드려요. 친해지면 좋겠네요♪","자기소개":{"voiceline":"데빌룩 성(星)에서 온 모모 베리아 데빌룩이라고 해요. 라라 언니의 여동생이랍니다. 아, 식물들이 말하는 소리를 들을 수 있어요. 여기 머무르는 동안 지휘관님과 친해지면 좋겠네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/profile.ogg"},"메인1":{"voiceline":"지휘관님은 이렇게 매일 귀여운 여자아이들에게 둘러싸여 있으면서, 어떻게 늘 침착함을 유지하시는 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/main1.ogg"},"메인2":{"voiceline":"모항 카페는 아주 멋지네요. 게임기도 많이 있고… 또… 식물원이 있으면 더 근사하겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/main2.ogg"},"메인3":{"voiceline":"네? 식물으로 누굴 감시할 수도 있냐고요? 아하하~ 지휘관님도 참, 농담도 잘하시네요. 그런 게 가능할 리가 없죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/main3.ogg"},"전투개시":{"voiceline":"지휘관님께 실망을 안겨드리지 않도록 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/battle.ogg"},"상세확인":{"voiceline":"저는 식물과 대화할 수 있어요. 집무실에 있는 식물들이 지휘관님께 늘 돌봐줘서 고맙다고 하네요. 식물들에게도 상냥하게 대해주시는 걸 보니 지휘관님이 얼마나 상냥한 분인지 알겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/detail.ogg"},"드랍 설명":{"voiceline":"안녕하세요. 당신이 여기 지휘관님이시죠? 저는 모모 베리아 데빌룩이라고 해요. 모모라고 불러주세요. 앞으로 잘 부탁드려요. 친해지면 좋겠네요♪","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 업무로 나간 아이들이 돌아온 모양이네요. 저도 도와드리러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/expedition.ogg"},"실망":{"voiceline":"모항을 이끄는 지휘관님이 이런 분이시라니…… 안타깝네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님은 평소에 모항 여자아이들이랑 어떻게 지내세요? 조금 들려주실 수 있으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/feeling2.ogg"},"호감":{"voiceline":"모항 여자아이들은 다들 사이가 좋네요. 지휘관님은 정말 대단해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/feeling3.ogg"},"기쁨":{"voiceline":"사실… 「계획」을 하나 세우고 있거든요. 분명 지휘관님께 도움이 될 거예요. 하지만 아직은 비밀이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/feeling4.ogg"},"사랑":{"voiceline":"지휘관님과 함께 지내면서 여기 여자아이들이 지휘관님을 좋아하는 이유를 조금은 알겠어요. 이건 「계획」 실행을 위해 필수 불가결인 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/feeling5.ogg"},"터치3":{"voiceline":"무슨 일이세요? 도와드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/headtouch.ogg"},"모항귀환":{"voiceline":"아, 어서 오세요! 집무실을 조금 청소해 봤어요. 괜한 짓을 한 게 아니라면 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/home.ogg"},"hp 경고":{"voiceline":"상황이 조금 난감해졌네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님께 드리려고 과자를 만들었는데, 괜찮으시면 드셔보시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/login.ogg"},"실패":{"voiceline":"지휘관님, 죄송해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/lose.ogg"},"우편":{"voiceline":"새로운 우편을 정리해 뒀어요. 시간 날 때 확인해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/mail.ogg"},"임무":{"voiceline":"아직 임무가 남아있는 모양이네요. 조금 더 분발해야겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/mission.ogg"},"임무완료":{"voiceline":"임무 보상인가요? 이걸 받고 나서 느긋하게 차 한잔해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/mission_complete.ogg"},"서약":{"voiceline":"지휘관님과 더 관계를 돈독히 하려면…… 음, 「계획」 실행에도 도움이 될 테고요! 네? 어떤 계획인지 궁금하신가요? 「모항의 여자아이들이 다들 지휘관님께 더욱 푹 빠진다」는 근사한 계획이랍니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/propose.ogg"},"스킬":{"voiceline":"이 아이들을 얕보면 곤란해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/skill.ogg"},"터치1":{"voiceline":"꼬리가 신기하신가 봐요? 어쩔 수 없네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/touch.ogg"},"터치2":{"voiceline":"어머나… 그러시면 안 돼요. 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/touch2.ogg"},"입수시":{"voiceline":"안녕하세요. 당신이 여기 지휘관님이시죠? 저는 모모 베리아 데빌룩이라고 해요. 모모라고 불러주세요. 앞으로 잘 부탁드려요. 친해지면 좋겠네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/unlock.ogg"},"강화성공":{"voiceline":"어머… 저, 조금 변했나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"음… 더 열심히 해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"네… 모항에서 지내면서 지휘관님의 특별함을 깨닫게 되었어요. 자상할 뿐만 아니라, 모두를 하나로 아우르는 카리스마도 겸비하고 계시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"모항 사람들의 사랑을 받아주려면 지휘관님도 좀 더 육식남으로 거듭나야 해요. 어떻게 해야 하면 좋을지 제가 많이 알려드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"후후… 지휘관님은 정말 자상하세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관님, 어서 오세요. 모두와 사이가 더욱 돈독해진 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 오늘도 열심히 「계획」을 진행해 봐요! ……아직 할 일이 남으셨네요. 늘 고생이 많으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"꺅! 저를 이용해서 「계획」을 예행 연습하시려고……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/touch_ex.ogg"},"터치2_ex":{"voiceline":"읏… 대담해지셨네요, 지휘관님……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['라라 사타린 데빌룩', '나나 아스타 데빌룩'] : 언니, 나나! 열심히 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/couple_encourage1.ogg"},{"voiceline":"['금빛 어둠'] : 역시 어둠 씨는 대단해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/couple_encourage2.ogg"},{"voiceline":"['코테가와 유이'] : 코테가와 씨, 믿음직스러워요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/couple_encourage3.ogg"}],"메인4":{"voiceline":"노스 유니온의 키예프 씨는 선인장을 좋아하신다고 해요. 그래서 얼마 전에 「선인장을 키우는 팁」을 알려드렸어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"이 꽃을 사용하면 지휘관님이 굉장히 적극적으로 변하실 텐데… 으음… 아무래도 너무 위험하니까 이건 그만두죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/main5_ex.ogg"},"메인6_ex":{"voiceline":"어머… 제 제안을 쉽게 받아주지 않으시네요. 역시 성실한 지휘관님다워요. 그렇지만 가끔은 괜찮잖아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/main6_ex.ogg"},"메인7_ex":{"voiceline":"1, 2, 3, 4, 5, 6… 무슨 숫자인지 궁금하세요? 사실 지휘관님을 좋아하는 여자아이가 어느 진영에 많은지 세고 있었어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/main7_ex.ogg"},"메인8_ex":{"voiceline":"사쿠라 엠파이어의 다이호 씨, 아이리스의 모가도르 씨… 음~ 이 두 사람은 「계획」에 큰 도움이 되겠어요. 어떤 「계획」인지는 아직 비밀이랍니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100030/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":111,"레어도":"SSR","ex_chat_status":1},{"클뜯 id":11100031,"클뜯 함순이 id":1110003,"함순이 이름":"모모 베리아 데빌룩","한글 함순이 + 스킨 이름":"깨어나는 「꿈」","영문 함순이 + 스킨 이름":"A Waking Dream","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100031/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100031/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100031/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100031/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100031/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100031/shipyard.png","설명":"어머, 지휘관님. 일어나셨나요? 방금까지 자면서 계속 뒤척이시던데… 악몽이라도 꾸신 건가요? 후후, 이제 괜찮아요~","자기소개":null,"메인1":{"voiceline":"악몽은 평소에 일을 너무 열심히 해서 꾸신 걸 수도 있어요.그래서 다들 좋아하는 것 같아요. 그러니까 휴식도 취하셔야 해요. 지휘관님이 쓰러지면 슬퍼할 애들이 많다고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/main1.ogg"},"메인2":{"voiceline":"지휘관님, 이건 수면의 질 향상과 스트레스 해소에 도움이 되는 식물 씨앗이에요. 방에 심어보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/main2.ogg"},"메인3":{"voiceline":"벨파스트 씨 쪽에 연락해서 데리러 와달라고 하는 편이 좋을지도 모르겠네요. 지휘관님, 아직 상태가 안 좋은 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"방금 지나가다가 지휘관님께서 악몽에 시달리는 게 보여서, 급히 도와드리려는 마음에 조금 강제적인 느낌이 되어버렸네요. 괜찮으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/detail.ogg"},"드랍 설명":{"voiceline":"어머, 지휘관님. 일어나셨나요? 방금까지 자면서 계속 뒤척이시던데… 악몽이라도 꾸신 건가요? 후후, 이제 괜찮아요~","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"꼭 안아드릴까요…? 지휘관님께서는 모항 여자아이들을 위해 늘 노력하고 계시니, 저도 감사의 뜻을 표하고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/feeling5.ogg"},"터치3":{"voiceline":"감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 건강하신 것 같아서 다행이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어머… 괜찮으세요? 물이라도 마시는 편이 좋겠네요. 지금 가지고 올게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/login.ogg"},"실패":null,"우편":{"voiceline":"새로운 우편이 왔어요. 하지만 일단 잔 다음에 확인하는 편이 좋을 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/mail.ogg"},"임무":null,"임무완료":{"voiceline":"임무 완료 보상인가요? 제가 대신 받으러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100031/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"도와드릴까요?",