[{"클뜯 id":204010,"클뜯 함순이 id":20401,"함순이 이름":"리나운","한글 함순이 + 스킨 이름":"리나운","영문 함순이 + 스킨 이름":"Renown","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204010/shipyard.png","설명":"리나운급 순양전함·리나운 (HMS Renown)","자기소개":{"voiceline":"로열 네이비 리나운급 순양전함 리나운입니다. 두 번의 대전을 겪어, 전과에는 자신 있습니다. 어떤 명령이라도 전력을 다해 완수하여 보이겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/profile.ogg"},"메인1":{"voiceline":"명령은 없는 건가요? 「적의 동향을 살펴보는 것」……이라는 의미인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/main1.ogg"},"메인2":{"voiceline":"스크류 말인가요? 전에 후드 씨가 저랑 부딪히고선, 정신을 차려보니 사죄의 의미로 이걸 보내줬습니다만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/main2.ogg"},"메인3":{"voiceline":"뭔가요? 성실한 리나운 귀여워… 라고요? 네, 그 리나운 씨를 대신해서 지휘관님께 감사드립니다── 엣?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/main3.ogg"},"전투개시":{"voiceline":"적 함 발견! 전 함, 사격 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/battle.ogg"},"상세확인":{"voiceline":"리나운, 모든 기능 정상! 걱정 마십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/detail.ogg"},"드랍 설명":{"voiceline":"리나운급 순양전함·리나운 (HMS Renown)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 마친 아이가 왔습니다. 다음번에는 부디 저도 참가시켜 주세요. 맞이하는 쪽에 있는 건 익숙지 않아서요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/expedition.ogg"},"실망":{"voiceline":"지휘관님, 이대로는 안 됩니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/feeling1.ogg"},"낯섦":{"voiceline":"「러브레터」? 그건 무슨 악기, 같은 건가요? 여러 가지를 시도해볼 수 있을 듯한, 재밌는 느낌이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 언제나 산책에 불러주시고 계십니다만, 뭔가 고민거리라도 있으신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/feeling3.ogg"},"기쁨":{"voiceline":"…지휘관님이 이전, 바닷가에서 양초를 하트 모양으로 놓고 계시던데, 어째서인가요? 그리고 제가 「바람에 꺼질 것 같다」라고 했을 때, 어째서 우셨던 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/feeling4.ogg"},"사랑":{"voiceline":"걱정 마세요. 저도 그렇게 둔감하지는 않답니다. 다음에는 커버를 갖고 가서 양초가 꺼지지 않게 할 테니, 그때 하고 싶으셨던 얘길 마저 해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"이번 작전의 소모는 추후, 가능한 한 빨리 보고드리도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/home.ogg"},"hp 경고":{"voiceline":"스피드야말로 최고의 방어에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 명령을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/login.ogg"},"실패":{"voiceline":"……지휘관님, 죄송합니다…… 신뢰에 답하지 못하였습니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/lose.ogg"},"우편":{"voiceline":"틈이 나시면, 우편 체크 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/mail.ogg"},"임무":{"voiceline":"지휘관님, 아직 해야 할 미션이 남아있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/mission.ogg"},"임무완료":{"voiceline":"미션 보너스를 받아주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/mission_complete.ogg"},"서약":{"voiceline":"조금만 기다려주세요, 지휘관님…… 저, 저어, 양초를 더 갖고 오든지, 커버를 더 갖고 와서 양초가 꺼지지 않도록 할 테니까, 그, 그리고…… 보지 말아주세요! 지금 제 표정 엄청 이상할 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/propose.ogg"},"스킬":{"voiceline":"리나운, 양현 전속!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/skill.ogg"},"터치1":{"voiceline":"……조금 이상한 기분이에요── 이런 말을 듣는 건 지휘관이 처음이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/touch.ogg"},"터치2":{"voiceline":"……!! 지휘관님, 반항할 생각은 없습니다만…… 그치만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/touch2.ogg"},"입수시":{"voiceline":"로열 네이비 리나운급 순양전함·리나운입니다. 명령을! 지휘관님의 검이 가리키는 곳이 제 주포가 향하는 곳입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/unlock.ogg"},"강화성공":{"voiceline":"그 바람이, 힘의 근원이 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"적 함대전멸 확인. 임무 완료.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['후드'] : 같이 싸울 수 있어 영광입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/couple_encourage1.ogg"},{"voiceline":"['넬슨'] : 항속 29노트, 리나운, 출격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/couple_encourage2.ogg"},{"voiceline":"['워스파이트'] : 리나운, Search and Destroy!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204010/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":204011,"클뜯 함순이 id":20401,"함순이 이름":"리나운","한글 함순이 + 스킨 이름":"우아한 로열 프라이드","영문 함순이 + 스킨 이름":"Graceful Royal Pride","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204011/shipyard.png","설명":"우아하고 멋진 이스트 글림 드레스인 건 맞는데, 트임이 좀…… 지휘관님? 갑자기 죄송합니다만… 이 드레스, 어떤 것 같나요?","자기소개":null,"메인1":{"voiceline":"갈아입고 여기 앉아있으면 되는 건가요? 자세도 의상처럼 우아하게…… 후후, 지휘관님은 정말 이 드레스 차림이 마음에 드신 모양이군요.","voicelink":null},"메인2":{"voiceline":"조금 앞으로 숙여서 카메라를 바라보고… 그 상태에서 장갑을 끼면 완벽하다구요? 음… 이렇게… 말인가요? 지휘관님, 왜 숙녀용 레이스 장갑을 가지고 계신 거죠?","voicelink":null},"메인3":{"voiceline":"동료들이 이스트 글림에 어울리도록 화장을 해줬습니다. 확실히 \"맑고 품위있는\" 느낌으로…… 리나운과 잘 어울린다…구요? 다행입니다. 그럼 리나운 씨께 그렇다고 전해드릴…… 어라?","voicelink":null},"전투개시":{"voiceline":"로열 나이트, 적진으로 돌격하겠습니다!","voicelink":null},"상세확인":{"voiceline":"리나운, 각 기능 정상, 전투 능력 지장 없…… 네, 이 드레스가 그렇다는 겁니다. 움직이기도 편하고 기능면에서도 빠지는 부분이 없으니, 평소 복장으로 삼을까 하는데…… 안 될까요?","voicelink":null},"드랍 설명":{"voiceline":"우아하고 멋진 이스트 글림 드레스인 건 맞는데, 트임이 좀…… 지휘관님? 갑자기 죄송합니다만… 이 드레스, 어떤 것 같나요?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 완료하고 온 아이들은 제게 맡겨주세요. 후후, 그녀들이 들인 노력을 생각하면 이 드레스를 입고 맞이하는 것이 맞을 것 같은데… 그렇지 않을까요?","voicelink":null},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이스트 글림 드레스는 지휘관님께서 주신 선물…… 그리고 드레스 차림을 한 리나운의 모습이 마음에 든다…구요? 그, 그렇군요… 지휘관님이 마음에 드신다면 저…… 지, 지금은 얼굴이 너무 빨간 것 같으니, 아읏, 잠시만 뒤를 바라봐줄 수 있으실까요…?!","voicelink":null},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 바로 작전 보고서를 제출하겠습니다. 의상에 손상된 부분은 없으니 안심하시길.","voicelink":null},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 귀환하느라 고생 많으셨습니다. 리나운은 집무 준비를 하고 있었습니다. 언제든 명령하시길.","voicelink":null},"실패":null,"우편":{"voiceline":"새 우편이 있습니다. 나중에 책상에 두도록 하지요.","voicelink":null},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"……네, 리나운에게 맡기실 임무는 있으신가요?","voicelink":null},"터치2":{"voiceline":"!! 지휘관님, 여기선…… 적절한 행동은 아니…라고 해야할지……","voicelink":null},"입수시":{"voiceline":"우아하고 멋진 이스트 글림 드레스인 건 맞는데, 트임이 좀…… 지휘관님? 갑자기 죄송합니다만… 이 드레스, 어떤 것 같나요?","voicelink":null},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70974,"상점 카테고리 id":3,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"한정 (2025/02/12)","진영":"HMS","레어도":"SR","ex_chat_status":0}]