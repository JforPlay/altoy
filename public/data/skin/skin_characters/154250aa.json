://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/feeling1.ogg"},"낯섦":{"voiceline":"살금살금…살금살금……와앗! 걸렸다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/feeling2.ogg"},"호감":{"voiceline":"동형함의 모두는 바보라서 장난치기 쉬워, 다음에 지휘관에게 보여줄게♪ 그래도 다른 사람이 괴롭히면 아무리 나라고 해도 화낼 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/feeling3.ogg"},"기쁨":{"voiceline":"나도 바보가 아니니까, 장난칠 땐 안 화내는 사람한테 하는걸! 동형함 자매들이나, 또는 지휘관에게 말야~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 내가 이다음에 크면, 분명……더욱 더욱 지휘관에게 장난칠 거야! 에헤헤~ 다른 거 상상했지? 그치 그치~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 과자 먹어버렸어~ 거짓말이야! 아야얏! 머리 잡고 돌리지 말라니까아~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 못 봤구나~? 아까 다른 애한테 장난치고 있었는데~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/login.ogg"},"실패":{"voiceline":"우으……아파아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/lose.ogg"},"우편":{"voiceline":"지휘관, 러브레터~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/mail.ogg"},"임무":{"voiceline":"지휘관, 어떤 게 새로운 임무일까요~ 맞춰볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/mission.ogg"},"임무완료":{"voiceline":"지휘관, 복권의 '1등 상' 에 당첨됐대! 농~담이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/mission_complete.ogg"},"서약":{"voiceline":"지휘관은 알고 있어? 장난은 화내지 않는 사람이랑, 좋아하는 사람한테 하는 거야! 그리고…장난을 치면 부끄러운 얘기도 더욱 더 할 수 있게 돼! 에헤헤, 나 지금 무슨 얘길 하는 걸까~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/propose.ogg"},"스킬":{"voiceline":"봐봐! '연료' 가 날고 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/skill.ogg"},"터치1":{"voiceline":"장난이 들통 났어? 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/touch.ogg"},"터치2":{"voiceline":"지휘관, 손가락으로 찌른 데는~여기 숨겨져 있던 '철판' 이지롱~♪ 있잖아, 어떤 느낌이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/touch2.ogg"},"입수시":{"voiceline":"지히가읏, 냐앙…… 혀 깨물었어~ 나는 미나즈키! 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/unlock.ogg"},"강화성공":{"voiceline":"우으……빤짝거렸어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관, 벌칙 게임! 벌칙 게~임!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301370/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"N","ex_chat_status":0}]