[{"클뜯 id":105190,"클뜯 함순이 id":10519,"함순이 이름":"매사추세츠","한글 함순이 + 스킨 이름":"매사추세츠","영문 함순이 + 스킨 이름":"Massachusetts","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105190/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105190/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105190/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105190/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105190/shipyard.png","설명":"사우스다코타급 전함 매사추세츠(BB-59) ","자기소개":{"voiceline":"나는 동형함 중에서는 평범, 한 편이려나. 훈장은 11개고, 사우스다코타보다 적어. 내가 별로 다친 적이 없다고? 제대로 된 상대, 이제까지 없었으니까…… 그때의 언니처럼 전력으로 싸워보고 싶네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/profile.ogg"},"메인1":{"voiceline":"……사실 이 머리 색깔, 마음에 들어. 흰머리수리와 비슷한 것 같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/main1.ogg"},"메인2":{"voiceline":"이 옷, 이상해? 그래도 항해할 때, 바닷바람이 직접 피부에 닿아서…… 기분 좋아","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/main2.ogg"},"메인3":{"voiceline":"인상 깊었던 상대? 음…… 카사블랑카 때, 주포가 한 문밖에 없는데도 꽤 버티던 전함…… 그 아이가 만전을 기한 상태에서 다시 한번 싸워보고 싶네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/main3.ogg"},"전투개시":{"voiceline":"꽤 튼튼하지? 맞아도 안 울거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/battle.ogg"},"상세확인":{"voiceline":"다 봤으면, 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/detail.ogg"},"드랍 설명":{"voiceline":"사우스다코타급 전함 매사추세츠(BB-59)","voicelink":null},"의뢰 완료":{"voiceline":"……오. 잔뜩 들고 왔어. 도와주고 올게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/expedition.ogg"},"실망":{"voiceline":"지휘관의 몸, 조금 약해. 밥 제대로 먹고 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/feeling1.ogg"},"낯섦":{"voiceline":"강해지는 방법? 음, 팔굽혀펴기…… 안돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/feeling2.ogg"},"호감":{"voiceline":"불가능한 일에 계속 도전하는 지휘관…… 재밌어 보여. 나도 내 한계를 시험해보고 싶어지네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/feeling3.ogg"},"기쁨":{"voiceline":"지휘관이 필사적으로 노력하는 모습, 멋있지만…… 너무 무리하는 건 좋지 않아. 억지로라도 쉬게 할 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/feeling4.ogg"},"사랑":{"voiceline":"나에게 소망 같은 건 없어. 하지만 소망을 이룰 힘이라면 있어. 지휘관, 언젠가 내가 이뤄줬으면 하는 소망, 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔네. ……상처는 없어? 누가 괴롭히면, 나한테 말해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/home.ogg"},"hp 경고":{"voiceline":"……진심으로 상대해주길 원하나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/hp_warning.ogg"},"로그인":{"voiceline":"점심은…… 아, 지휘관, 이제부터 산책?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/login.ogg"},"실패":{"voiceline":"미안, 한 눈 팔았어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/lose.ogg"},"우편":{"voiceline":"편지, 여기에 놔뒀어. 나중에 읽어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/mail.ogg"},"임무":{"voiceline":"임무, 많네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/mission.ogg"},"임무완료":{"voiceline":"아, 보수가 왔다…… 저녁에 고기 먹을 수 있을 것 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/mission_complete.ogg"},"서약":{"voiceline":"저기, 응…… 지휘관이 하고 싶은 말, 하고 싶은 것, 알고 있어. ……나도, 지휘관을 좋아하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/propose.ogg"},"스킬":{"voiceline":"이 한 발은 무거워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/skill.ogg"},"터치1":{"voiceline":"지휘관, 어리광 부리고 싶어? ……나한테?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/touch.ogg"},"터치2":{"voiceline":"……몸을 움직이면, 이상한 생각도 적어질 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/touch2.ogg"},"입수시":{"voiceline":"응? 아…… 내 차례네. 나는 매사추세츠, 언제 어디서나 볼 수 있는 평범한 사우스다코타급…… 저기, 응, 어쨌든 사이좋게… 지내자구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/unlock.ogg"},"강화성공":{"voiceline":"조금, 바뀌었어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/upgrade.ogg"},"vote":null,"승리":{"voiceline":"벌써, 끝? 이제 막 달아올랐는데…… 다른 적, 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['장 바르'] : 지금의 당신은…… 좋아. 이걸로 됐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/couple_encourage1.ogg"},{"voiceline":"['사우스다코타'] : 언니의 방어력, 부러워……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105190/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X"