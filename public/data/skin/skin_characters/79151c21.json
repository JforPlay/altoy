[{"클뜯 id":202090,"클뜯 함순이 id":20209,"함순이 이름":"맨체스터","한글 함순이 + 스킨 이름":"맨체스터","영문 함순이 + 스킨 이름":"Manchester","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202090/shipyard.png","설명":"글로스터급 경순양함 - 맨체스터","자기소개":{"voiceline":"로열 네이비 소속, 타운급 경순양함 맨체스터야! 그 대전에서는 주로 함단 호위나 수송같은 임무에 참여했지만, 다른 작전도 열심히 했어! 좀 섣불리 경솔하게 구는 면이 있어서, 마지막이 좀 안타까웠던 것 같은… 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/profile.ogg"},"메인1":{"voiceline":"업무가 진척이 안 되면 청소라도 해보는 건 어때? 집무실이 깨끗하면 기분도 좋아질 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/main1.ogg"},"메인2":{"voiceline":"사실은 요리나 이것저것 배우고 싶었는데, 글로스터가 안 된다고 반대해. 딱히 곤란한 건 아니지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/main2.ogg"},"메인3":{"voiceline":"메이드 일을 하면서도 싸울 수 있어! 그렇지만 싸우면서 메이드 일을 하는 건… 음, 그럴 일이 있으려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/main3.ogg"},"전투개시":{"voiceline":"좋아, 싸우자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/battle.ogg"},"상세확인":{"voiceline":"여러모로 날 의지하라구, 주인님! 주인님은 못 하지만 나는 할 수 있는 게 분명 무언가 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/detail.ogg"},"드랍 설명":{"voiceline":"글로스터급 경순양함 - 맨체스터","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료된 것 같아, 주인님! 마중하러 나가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/expedition.ogg"},"실망":{"voiceline":"그럼 못써, 주인님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/feeling1.ogg"},"낯섦":{"voiceline":"메이드대 소속 경순양함 맨체스터가 주인님을 돌봐줄게. 필요한 게 있으면 사양 말고 언제든 말해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/feeling2.ogg"},"호감":{"voiceline":"그렇구나, 솔선수범해서 주인님을 돌보는 게 좋은 메이드구나… 고마워, 글로스터! 일단은 주인님 방부터 청소하고 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/feeling3.ogg"},"기쁨":{"voiceline":"어머, 나도 참… 당연히 주인님 방에는 열쇠 없인 못 들어가지… 앗, 주인님 수고했어. 지금 방 청소라도 해주려고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/feeling4.ogg"},"사랑":{"voiceline":"마, 막상 주인님 방에 들어오니까 긴장되네… 으, 응! 당연히 열심히 청소해야지! 그리고 또… 처, 청소할 때 말고도… 보러 와도… 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/feeling5.ogg"},"터치3":{"voiceline":"주인님, 좀 부끄러워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 주인님! 뭐라도 마실래? 메이드대 동료들한테 말해주고 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/home.ogg"},"hp 경고":{"voiceline":"괜찮아, 아직 계속할 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이야, 주인님! 집무실 청소는 다 끝내뒀어! 자, 어서 앉으라구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/login.ogg"},"실패":{"voiceline":"지고 말았네, 주인님…. 걱정하지 마, 괜찮아. 맨체스터는 무사하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/lose.ogg"},"우편":{"voiceline":"우편이 온 것 같아. 음… 개봉은… 내가 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/mail.ogg"},"임무":{"voiceline":"임무라… 맞아! 나는 주인님이 처리할 수 있는 걸 찾아봐야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/mission.ogg"},"임무완료":{"voiceline":"저, 전부 다 끝냈다고? 역시 주인님다워! 대단해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/mission_complete.ogg"},"서약":{"voiceline":"주인님한테 서약 반지를 받다니… 그, 그럼 주인님, 앞으로는 내킬 때마다 방에… 따, 딱히 침대 밑을 들여다 보거나 하진 않을 테니까 안심해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/propose.ogg"},"스킬":{"voiceline":"청소해버릴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/skill.ogg"},"터치1":{"voiceline":"응! 무슨 일이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/touch.ogg"},"터치2":{"voiceline":"아, 주인님. 그런 짓을 하면 글로스터가 화낼걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/touch2.ogg"},"입수시":{"voiceline":"반가워, 로열 소속 경순양함 맨체스터라고 해. 앞으로 잘 부탁할게, 모항의 지휘관이자 나의 주인님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/unlock.ogg"},"강화성공":{"voiceline":"컨디션 좋네! 고마워, 주인님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우아하게 이기게 해줘서… 주인님! 고마워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"오, 오늘 도시락…? 응, 열심히… 열심히 해볼게! 따, 딱히 무리하는 거 전혀 아니거든! 정말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"어서 오세…… 와아… 맨체스터한테 주는 선물이라구…? 다, 답례로 뭐라도 해줬으면 하는 거 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"아, 주인님! 그렇게 빨리 오면 집무실 청소를 못 하는데… 어쩔 수 없겠네! 비서함 업무 보면서 겸사겸사 해줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"주인님! 여긴 맨체스터에게 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/touch_ex.ogg"},"터치2_ex":{"voiceline":"혼이 나도 이렇게 하고 싶은 거구나… 아하하… 어쩔 수 없는 주인님이라니까~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"안 돼, 주인님. 샴페인은 내가 열어야… 좋았어! 에헤헤, 자, 승리를 축하하자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"사우스햄튼! 혹시 운항 중이야? 나도 도와줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/main5_ex.ogg"},"메인6_ex":{"voiceline":"글로스터라면 더 여러모로 주인님께 해줄 수 있는 게 많을 텐데…라는 생각은 들지만, 글로스터는 못하지만 나는 할 수 있는 것도 분명 있을테니까 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"♪~ 무슨 일이야, 주인님? 후후, 찾고 있는 펜은 책상 오른쪽 서랍에 있어. 방금 청소했을 때 찾았거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202090/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":1},{"클뜯 id":202091,"클뜯 함순이 id":20209,"함순이 이름":"맨체스터","한글 함순이 + 스킨 이름":"스케어리 나이트 케어","영문 함순이 + 스킨 이름":"Midnight Devil in White","스킨 타입":"Halloween","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202091/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/20