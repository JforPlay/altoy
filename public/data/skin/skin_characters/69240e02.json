[{"클뜯 id":603060,"클뜯 함순이 id":60306,"함순이 이름":"고리치아","한글 함순이 + 스킨 이름":"고리치아","영문 함순이 + 스킨 이름":"Gorizia","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603060/shipyard.png","설명":"차라급 중순양함—고리치아","자기소개":{"voiceline":"차라급 중순양함 고리치아야. 그 대전에서는 꽤 분발했지만, 전과라고 할 만한 두드러지는 활약은 그다지 보이지 못했어. 항구에 계속 있었는데도 적의 공격을 받지 않아서 운이 좋았다고도 하지만, 이걸 고맙게 여겨야 하나…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/profile.ogg"},"메인1":{"voiceline":"잘 안 다치는 건 좋지만, 이런 체질이라 때로는 모두에게 거리감을 느끼게 해…. 고리치아만 뭔가 다르다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/main1.ogg"},"메인2":{"voiceline":"이런 상황에선 보통 이런저런 이야기를 나눠서 서로 가까워지지 않아? 왜 지휘관님은 관심을 안 주는 거지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/main2.ogg"},"메인3":{"voiceline":"(다음 휴일에는… 볼차노랑 연극 보러 가기로 약속했었지…. 그래! 어떻게 하면 지휘관님의 관심을 끌 수 있을지 여러 가질 배워 와야겠어.)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/main3.ogg"},"전투개시":{"voiceline":"내가 전투에 내몰릴 줄이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/battle.ogg"},"상세확인":{"voiceline":"흠…… (슬슬 이야기를 꺼내볼까? 그, 그렇지만 가끔은 지휘관 쪽에서 먼저 이야기를 꺼내게 하는 편이 좋지 않을까? 그래! 계속 기다려 보자!) …흠~~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/detail.ogg"},"드랍 설명":{"voiceline":"차라급 중순양함 - 고리치아","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료된 것 같은데? 동료들을 치하하러 가야지? ……호, 혼자 가려구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/expedition.ogg"},"실망":{"voiceline":"이게 지휘관님… 이게 고리치아가 관심을 받으려고 애쓰는 사람이라니… 흑……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/feeling1.ogg"},"낯섦":{"voiceline":"흠… (지휘관님 쪽에서는 딱히 가까워지려는 기색이 없네… 왜지? 신사로서 먼저 숙녀를 식사에라도 초대해야 하는 거 아니야?)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/feeling2.ogg"},"호감":{"voiceline":"서, 설마 고리치아를 쉽게 생각하는 거야? 착각하지 마! 난 딱히 지휘관님이 조금만 관심을 주는 정도로는… 그러니까 더 많이 여러모로 신경 써주지 않으면 솔직해질 수 없다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/feeling3.ogg"},"기쁨":{"voiceline":"오늘도 지휘관님, 데이트 이야기는 꺼내지도 않네… 보통 이 정도면 좋아한다는 거 알 텐데 왜… 설마 내 쪽에서 솔직하게 다가가는 편이 더 낫나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/feeling4.ogg"},"사랑":{"voiceline":"지, 지휘관님! 이다음에 한가하면 잠깐 기분 전환하러…… 모항 안이라도 전혀 상관없어!! 뒷산처럼 경치 좋은 곳도 알고 있고, 폴라가 데이트 장소도 많이 알려 줬으니까…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"아, 수고했어. 무사히 돌아와서 다행이야…. 내가 모처럼 마중 나와줬는데 반응이 너무 미지근한 거 아니야…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/home.ogg"},"hp 경고":{"voiceline":"이렇게나 많이 맞히다니…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/hp_warning.ogg"},"로그인":{"voiceline":"아아, 지휘관님… 오늘도 이렇게나 지쳐서…… 부디 이 고리치아도 당신의 고통을 분담할 수 있게 해줘…… '그럼 업무도 잘 부탁한다'고…? 에, 에엥…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/login.ogg"},"실패":{"voiceline":"졌어… 이 정돈 아무렇지도 않아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/lose.ogg"},"우편":{"voiceline":"(지휘관님 책상 위에 몰래 둔 러브레터가… 어, 어라? 새로 온 우편이랑 섞여 있어?!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/mail.ogg"},"임무":{"voiceline":"임무가 왔어. 아, 지휘관님. 어떤 것부터 처리할지 내가 골라줘도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/mission.ogg"},"임무완료":{"voiceline":"(보상에만 눈이 가 있으면 모처럼 내가 도와준 보람이……) 응? 따, 딱히 뭐 대단한 걸 해준 기억은 없는데? 그렇게 칭찬해 줄 것까지야….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/mission_complete.ogg"},"서약":{"voiceline":"드디어 지휘관님이 내게 관심을…! 기뻐… 너무 행복해…! 나, 이제는 지휘관님이랑 맨날 꽁냥꽁냥…… 미, 미, 미안! 대답하는 걸 깜빡했어…! 응! 기꺼이!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/propose.ogg"},"스킬":{"voiceline":"이젠 내가 맞혀줄 차례야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/skill.ogg"},"터치1":{"voiceline":"무슨 일이야? 아… 고리치아랑 이야기하고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/touch.ogg"},"터치2":{"voiceline":"?! 가, 갑자기 무슨 짓이야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/touch2.ogg"},"입수시":{"voiceline":"아아, 지휘관님… 드디어 만났네. 그래, 내가 바로 사르데냐 엠파이어 소속 중순양함인 고리치아. 당신의…… 자, 잠깐! 이럴 땐 '고리치아, 계속 널 기다리고 있었어'라고 말해줘야 하는 거 아니야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/unlock.ogg"},"강화성공":{"voiceline":"강하게 만들어준 건 고맙지만, 조금만 더… 부드럽게는 안 될까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"그럭저럭 열심히 해봤어. 흐음….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관님, 지켜봐 줄 거지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603060/battle_ex.ogg"},"상세확인_ex":{"voiceline":"흠…… 응? 지휘관님? 오늘은 날씨가 좋으니까 둘이서 어디 