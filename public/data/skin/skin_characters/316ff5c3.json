[{"클뜯 id":307090,"클뜯 함순이 id":30709,"함순이 이름":"꼬마 아카기","한글 함순이 + 스킨 이름":"꼬마 아카기","영문 함순이 + 스킨 이름":"Akagi-chan","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307090/shipyard.png","설명":"아카기급 항공모함 - 아카기 ","자기소개":{"voiceline":"순양전……. 어라? 순양전함이 아니네. 뭐, 괜찮아. 나는 아카기야. 후후후, 내 부하가 될 수 있다니, 당신, 복에 겨운 거 알고는 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/profile.ogg"},"메인1":{"voiceline":"나, 그리고 아마기 언니만 있다면 어떤 일이든 쉽게 할 수 있어. 부하인 당신도 자랑스럽게 생각하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/main1.ogg"},"메인2":{"voiceline":"진지하게 일을 하니 나름 봐줄만 한데? 역시 나의 부하야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/main2.ogg"},"메인3":{"voiceline":"부하의 부하와 노는 것도 좋지만, 누가 주인인지는 잊지 말라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/main3.ogg"},"전투개시":{"voiceline":"부하를 괴롭힐 수 있는 것은 나뿐이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/battle.ogg"},"상세확인":{"voiceline":"부하에게 보호받는 기분은 나쁘지 않아. 우후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/detail.ogg"},"드랍 설명":{"voiceline":"아카기급 항공모함 - 아카기","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 완료한 것 같네……. 함께 마중 나가려구? 흥, 어쩔 수 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/expedition.ogg"},"실망":{"voiceline":"너무 봐준 것 같네……. 후후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/feeling1.ogg"},"낯섦":{"voiceline":"우후후, 자랑스럽게 생각하도록 해. 나, 한눈에 당신이 부하가 될 거라는 걸 알았거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/feeling2.ogg"},"호감":{"voiceline":"부하 주제에 사랑받고 있구나……. 으윽……. 뭐지, 이 가슴 떨림은…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/feeling3.ogg"},"기쁨":{"voiceline":"크으윽……. 내 부하 주제에, 저 아이들에게 언제나 언제나 둘러싸여서……. 내 부하야……. 내 부하인데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/feeling4.ogg"},"사랑":{"voiceline":"당신, 뭐든지 나한테 맡겨야 해. 내가 뭐든 다 해줄 테니까, 그러니까 이제 다시는 다른 애들한테 부탁하거나, 다른 애들이랑 말하면 안 돼. 당신은 내 부하니까. 알았어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오늘도 부하로서 열심히 하고 있구나. 착해, 착해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/home.ogg"},"hp 경고":{"voiceline":"후후후, 점점 타오른다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/hp_warning.ogg"},"로그인":{"voiceline":"내 허락 없이 멀어지면, 이곳을 불바다로 만들 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/login.ogg"},"실패":{"voiceline":"쳇……. 오해하지 마. 일부러 져준 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/lose.ogg"},"우편":{"voiceline":"편지라……. 나, 나한테 온 건 아니라고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/mail.ogg"},"임무":{"voiceline":"만물에 깃든 신들을 위해, 더 임무에 정진하렴.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/mission.ogg"},"임무완료":{"voiceline":"으음, 이 정도의 보수라니……. 역시 나의 부하답네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/mission_complete.ogg"},"서약":{"voiceline":"이건 즉……. 당신이 모든 것을 아카기에게 맡기고, 아카기도 모든 것을 당신에게 맡겼다는, 거지? 후후, 후후후후후후후후……. 부하를 손에 넣는 일이 이렇게 즐거운 일이었다니 몰랐어……. 후하하하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/propose.ogg"},"스킬":{"voiceline":"부하가 다치게 두지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/skill.ogg"},"터치1":{"voiceline":"손이 많이 가는 부하네. 좋아, 잠깐 놀아줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/touch.ogg"},"터치2":{"voiceline":"우후후후, 쇠사슬로 묶어주겠어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/touch2.ogg"},"입수시":{"voiceline":"당신이 이 함대에서 가장 높은 아이야? 후후후, 아마기 언니의 꿈을 이루는 것은 먼저 당신을 끌어들인 다음에 하겠어~. 오늘부터 당신이 아카기의 부하 1호야. 감사하게 생각하도록 해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/unlock.ogg"},"강화성공":{"voiceline":"눈치가 빠른 부하네♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후후, 내 부하를 괴롭히다니 백년은 일러.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0}]