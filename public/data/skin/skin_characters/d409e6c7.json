[{"클뜯 id":9702050,"클뜯 함순이 id":970205,"함순이 이름":"진츠·META","한글 함순이 + 스킨 이름":"진츠·META","영문 함순이 + 스킨 이름":"Jintsuu META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702050/shipyard.png","설명":"경순양함 진츠라고 합니다. 저를 부른 건 조력이 필요해선가요? …알겠습니다. 제 계책이 함대에 도움이 된다면 미력하나마 힘을 보태어 드리죠.","자기소개":{"voiceline":"윽… 죄송합니다. 옛날 일은 별로 떠올리고 싶지 않아요. 그런 건 두통거리밖에 되지 않아서… 진츠는 그저 보잘것없는 한 사람의 책사… 그것만 기억해 주시면 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/profile.ogg"},"메인1":{"voiceline":"승패는 계략도 실력도 상관없이, 처음부터 아무도 모르게 정해져 있었다고… 지휘관님은 그런 생각 해보신 적 없으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/main1.ogg"},"메인2":{"voiceline":"아픔을 경험한 사람이야말로 지금이라는 순간을 소중하게 여기는 법이죠. 때로는 집념에 빠지는 경우도 있지만… 비극을 되풀이하고 싶은 사람은 아무도 없으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/main2.ogg"},"메인3":{"voiceline":"으… 죄송해요. 갑자기 몸에 힘이 안 들어가서… 금방 가라앉을 테니 잠시만 이대로 있게 해주세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/main3.ogg"},"전투개시":{"voiceline":"계획대로 일을 진행할 뿐… 전진하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/battle.ogg"},"상세확인":{"voiceline":"좋은 계책은 우세를 점하게 할 뿐만 아니라 열세마저 극복하게 만들죠. 그렇지만 제아무리 뛰어난 책사라도 너무도 큰 전력차 앞에서는 무릎을 꿇을 수밖에 없답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/detail.ogg"},"드랍 설명":{"voiceline":"센다이급 경순양함·진츠 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"어머, 보급 물자가 벌써 도착한 모양이군요. 이 양… 부럽네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/expedition.ogg"},"실망":{"voiceline":"현명한 지도자가 없는 모항은 구심점을 잃고, 쇠락의 길을 걷고 말지요…. 지휘관님, 정신 차리세요. 지금이라면 아직 늦지 않았어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/feeling1.ogg"},"낯섦":{"voiceline":"안심하세요. 함대의 전력, 동료들의 전의, 그리고 제 계략만 있으면 승리를 거두기는 쉬울 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/feeling2.ogg"},"호감":{"voiceline":"뭐라도 도움이 될 것 같아 어제 전투에 관해 회고 자료를 작성해 보았습니다. 그리고 최근 의뢰도 정리해서… 윽, 갑자기 현기증이… 아뇨, 별 건 아니지만, 조금 몸에… 힘이…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/feeling3.ogg"},"기쁨":{"voiceline":"(크흠흠) …얼마 전에는 꼴사나운 모습을 보여드려 죄송합니다. 지금은 많이 진정된 상황입니다… 네, 앞으로는 '쓰러지면 본전도 못 찾는다'는 지휘관님의 조언대로 건강에 더욱 주의할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/feeling4.ogg"},"사랑":{"voiceline":"지휘관님을 모시는 건 지금까지 내린 올바른 결단 중 하나에 불과하다고 생각했어요. 그런데 이렇게나 많은 대가를 받을 줄이야… 네, 앞으로도 전력을 다해 도와드릴게요. 설령 운명을 거스르게 되더라도… 안심하세요. 제 몸도 소중히 할 테니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 오세… 윽… 죄송합니다. 갑자기 현기증이 나서… 이젠 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/home.ogg"},"hp 경고":{"voiceline":"이렇게 되면 모 아니면 도다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 준비가 끝나셨으면 오늘 업무에 착수하시죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/login.ogg"},"실패":{"voiceline":"운명을 뒤집으려고 시도해도, 결국은 헛된 일에 지나지 않는군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/lose.ogg"},"우편":{"voiceline":"지휘관님, 우편은 되도록 빨리 확인해 주세요. 소중한 정보를 놓치지 않기 위해 할애하는 시간은 아끼시면 안 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/mail.ogg"},"임무":{"voiceline":"새로운 임무? 그럼, 어서 정리하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐나요? 좋아요, 이제 각자 시간을 보낼 수 있겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/mission_complete.ogg"},"서약":{"voiceline":"분명 이건 숙고하신 끝에 내놓은 답이겠죠. 그렇다면 저도 그에 상응하는 마음으로 보답해야…… 지휘관님, 진츠가 앞으로 무엇을 하면 좋을지, 당신의 소원을 들려주세요. 그 소원을 위해서라면 제 모든 것을 바치겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/propose.ogg"},"스킬":{"voiceline":"이 계책이 잘 통하길……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/skill.ogg"},"터치1":{"voiceline":"지휘관님은 함대의 버팀목입니다. 모항 운영에 좀 더 신경 써 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/touch.ogg"},"터치2":{"voiceline":"이러고 있을 때가 아니에요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/touch2.ogg"},"입수시":{"voiceline":"경순양함 진츠라고 합니다. 저를 부른 건 조력이 필요해선가요? …알겠습니다. 제 계책이 함대에 도움이 된다면 미력하나마 힘을 보태어 드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/unlock.ogg"},"강화성공":{"voiceline":"혼자 힘만으로는 역시 부족하겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리는 이미 우리 손아귀에 있습니다. 이걸 어떻게 살릴지는 지휘관님 나름이겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":n