[{"클뜯 id":499030,"클뜯 함순이 id":49903,"함순이 이름":"마인츠","한글 함순이 + 스킨 이름":"마인츠","영문 함순이 + 스킨 이름":"Mainz","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499030/shipyard.png","설명":"경순양함——마인츠 ","자기소개":{"voiceline":"순양함 마인츠라네. 어드미럴 히퍼급의 후속 전함으로 태어났어야 하지만, 여러가지 이유로 결국 없던 일이 되었지. 이렇게 말하면 무슨 뜻인지 알겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/profile.ogg"},"메인1":{"voiceline":"뭐, 뭐하는 겐가? 우유는 커피에 대한 모독이라네! 설탕도 마찬가지고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/main1.ogg"},"메인2":{"voiceline":"믿을 수 없군…… 이렇게 큰 사무실에 커피 메이커가 없다니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/main2.ogg"},"메인3":{"voiceline":"대전 중에 탄생했다면 나는 무슨 일을 할 수 있었을까…… 됐다. 이미 지나간 일이니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/main3.ogg"},"전투개시":{"voiceline":"내 발목을 붙잡지는 말게나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/battle.ogg"},"상세확인":{"voiceline":"전적은…… 오늘부터 세도 괜찮겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/detail.ogg"},"드랍 설명":{"voiceline":"경순양함——마인츠","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조를 맞이하러 가겠네. 실례하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/expedition.ogg"},"실망":{"voiceline":"첫 지휘관이 이런 꼴이라니…… 나도 불쌍하군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/feeling1.ogg"},"낯섦":{"voiceline":"태어난 이상 무언가를 이뤄야 한다네. 그렇지 않다면 내 설계와 건조에 힘써준 이들에게 들 낯이 없으니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/feeling2.ogg"},"호감":{"voiceline":"실전 경험이 부족하면 실전에서 쌓을 수밖에. 지휘관, 신경쓰지 말고 작전에 투입시켜주시게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/feeling3.ogg"},"기쁨":{"voiceline":"이전까지는 나를 증명하기 위해서 싸웠다면, 지금은 너를 위해서 싸우고 있다네. 지휘관, 네가 믿을만한 사람이라는 것을 모두에게 증명하고 싶군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/feeling4.ogg"},"사랑":{"voiceline":"너는 내 처음이자 마지막 지휘관이라네. 그뿐 아니라 너는 내가 조금 더 가까워지고 싶다고 생각한 유일한 사람이지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"장비를 점검해 봐야겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/home.ogg"},"hp 경고":{"voiceline":"장비가 말을 듣지 않는 것 같은데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/hp_warning.ogg"},"로그인":{"voiceline":"나의 이 기다림을 유의미한 것으로 바꾸어 주게, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/login.ogg"},"실패":{"voiceline":"흥, 실전 경험을 쌓았다고 생각해두도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/lose.ogg"},"우편":{"voiceline":"새로운 우편이라네. 잊은 것은 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/mail.ogg"},"임무":{"voiceline":"설마 임무를 이렇게 계속 방치해둘 생각인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/mission.ogg"},"임무완료":{"voiceline":"임무의 보상……언제까지 그냥 둘 생각이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/mission_complete.ogg"},"서약":{"voiceline":"내 존재 의미는 싸움만이 아니라네. 나의 존재, 나의 운명은 이미 너와 단단히 묶여버렸지. 내 마음은 영원히 너의 것이라네, 나의 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/propose.ogg"},"스킬":{"voiceline":"바로 지금이다, 주포 발사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/skill.ogg"},"터치1":{"voiceline":"왜 그러지? 설마 위로가 필요한가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/touch.ogg"},"터치2":{"voiceline":"좋아, 너로 주포를 시험해보겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/touch2.ogg"},"입수시":{"voiceline":"순양함 마인츠라네. 아무래도 네가 내 첫 지휘관인 모양이군. 날 실망시키지 말게나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/unlock.ogg"},"강화성공":{"voiceline":"흥, 실전에서 한번 써보고 싶은걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"내가 있으니 당연한 결과 아닌가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관을 위하여!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관이 내 공적을 보고 기뻐할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 커피다. 네가 좋아하는 맛이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"지휘관, 새로운 우편을 가져왔다. 이런 일은 나에게 맡겨줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/mail_ex.ogg"},"임무_ex":{"voiceline":"지휘관, 휴식 이후에 임무를 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499030/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무의 보상…… 내가