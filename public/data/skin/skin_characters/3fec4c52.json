[{"클뜯 id":401260,"클뜯 함순이 id":40126,"함순이 이름":"Z26","한글 함순이 + 스킨 이름":"Z26","영문 함순이 + 스킨 이름":"Z26","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401260/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401260/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401260/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401260/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401260/shipyard.png","설명":"1936 A “나르비크”형 구축함—Z26 ","자기소개":{"voiceline":"저의 내력을 소개해 보라고요? 알았어요! 저는 메탈 블러드의 1936 A형 구축함·Z26입니다! 슈피와 쉐어를 호위했었고, Z24, Z25와 함께 PQ-13 함대를 막는 작전에도 참여했었어요. 하지만, 그 작전에서는 최후의 결말을 맞이하기도 했었죠...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/profile.ogg"},"메인1":{"voiceline":"지휘관, 게으름 피우는 건 안돼요! ...... 이미 많은 임무를 완료했다고요? 그럼, 지휘관, 일하느라 수고했어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/main1.ogg"},"메인2":{"voiceline":"Z23은 독서를 좋아하고, Z1은 운동을 좋아해요. 그럼, 그녀들을 뛰어넘고 싶다면... 독서하면서 운동을 해야 하나요? 정말 할 수 있을 거 같은데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/main2.ogg"},"메인3":{"voiceline":"Z25의 장난감 인형은, 사실 살아있어요. ...... 왜냐하면, Z25가 그 아이와 이야기하는 걸 자주 봤거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/main3.ogg"},"전투개시":{"voiceline":"모두들, 함께 선봉을 따라가요! ... 제가 선봉? 그럼, 모두 저를 따라 오세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/battle.ogg"},"상세확인":{"voiceline":"저는 눈보라가 싫어요. 동료들을 떨어뜨리게 하고, 적을 회피하지도 못하게 하니까요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/detail.ogg"},"드랍 설명":{"voiceline":"1936 A \"나르비크\"형 구축함—Z26","voicelink":null},"의뢰 완료":{"voiceline":"외뢰조가 돌아왔어요, 활약이 괜찮네요! ...... 아니, 수고가 많았네요가 맞겠죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/expedition.ogg"},"실망":{"voiceline":"지휘관, 불합격이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/feeling1.ogg"},"낯섦":{"voiceline":"적의 타겟이 되면 어떻게 하냐고요? 으음...... 그들이 사람을 잘못 봤기를 기도해야죠! 아니면, 그들이 어뢰를 잘못 쏴서 서로 맞히길 기다리던지요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/feeling2.ogg"},"호감":{"voiceline":"네, 오늘 잘 했어요, 지휘관. 앞으로 더 분발하세요! ...... 이러면 지휘관이 저의 칭찬하고 싶다는 뜻을 이해할 수 있겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/feeling3.ogg"},"기쁨":{"voiceline":"일은 노동과 휴식이 결합되어야 해요. 지휘관, 내일은 휴일이에요. 제가 감시할 겁니다. 일 못하게. 그러면, 지휘관은 반드시 충분히 휴식할 수 있을 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/feeling4.ogg"},"사랑":{"voiceline":"짧은 기간 관찰을 통해서 한 가지 결론을 도출했어요. 지휘관은 저의 감시가 없어도 잘 해낸다는 거에요. 네, 지휘관은 아주 훌륭한 사람이에요! 저는 저에게 이런 지휘관이 있다는 게 자랑스러워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 커피 드세요! ...... 설탕 추가요? 그럼, 각설탕 10개 넣으면 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/home.ogg"},"hp 경고":{"voiceline":"Z25들은 어디 간 거지...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/hp_warning.ogg"},"로그인":{"voiceline":"죄송합니다. 여긴 지휘관이 업무를 보는 곳이라 관계자 외 출입을 금합니다...... 아, 지휘관은 관계자 외가 아니죠, 그럼... 환영합니다, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/login.ogg"},"실패":{"voiceline":"졌어요... 모두들, 정말 죄송해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/lose.ogg"},"우편":{"voiceline":"최신 정보에요! 지휘관, 확인해 보세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/mail.ogg"},"임무":{"voiceline":"임무가 있어요! 음, 이 때 적절한 말은... 지휘관 서둘러 임무를 완성해 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/mission.ogg"},"임무완료":{"voiceline":"임무를 완성했어요! 이 때 적절한 말은... 함대에 대한 지휘관의 공헌에 감사드려요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/mission_complete.ogg"},"서약":{"voiceline":"「환경이 좋든 나쁘든, 부유하든 가난하든, 건강하든 병에 걸리든, 즐겁든 우울하든, 저는 영원히 당신을 사랑하고, 아낄 것이며, 당신에게 충성할 것입니다. 영원토록」...... 후, 좋았어, 한 글자도 틀림없이 외웠어요! ... 아, 참! 지휘관, 이어서 지휘관이 말할 차례죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/propose.ogg"},"스킬":{"voiceline":"전 준비 됐어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/skill.ogg"},"터치1":{"voiceline":"제가 해야할 일이 있나요? 어서 말해요! ...... 아니, 말씀해 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/touch.ogg"},"터치2":{"voiceline":"불순한 접촉은, 안됩니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드 구축함·Z26, 착임 보고합니다! 앞으로 잘 부탁드릴게요, 지휘관! ...... 좋아! 이러면 문제없을 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/unlock.ogg"},"강화성공":{"voiceline":"느낌이 좋아요! ...... 아니, 감사합니다 지휘관이 맞겠죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/upgrade.ogg"},"vote":null,"승리":{"voiceline":"모두 더 노력해야 해요! ...... 아니, 모두 수고 많았어요가 맞겠죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['Z25'] : 다시는 절 잃어버리지 말아요!...... 아니, 다시는 여러분과 떨어지지 않을게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401260/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":401261,"클뜯 함순이 id":40126,"함순이 이름":"Z26","한글 함순이 + 스킨 이름":"우정 쉐어 타임","영문 함순이 + 스킨 이름":"Sharing is Caring","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401261/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401261/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401261/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401261/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401261/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401261/shipyard.png","설명":"지휘관, 니무의 방에 온 걸 환영해요! 아, 잠시만요, 먹을 거랑 마실 거, 놀 거까지 전부 꺼내드릴게요! ","자기소개":null,"메인1":{"voiceline":"또 U-96한테 졌어요! 아무래도 류조와 연습을 더 하고 다시 도전해야겠어요! ... 아, 지휘관, U-96들이랑 같이 하는 대전 게임 얘기에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401261/main1.ogg"},"메인2":{"voiceline":"피곤하면, 상어 안고 쉬셔도 돼요! ... 아, 제가 말한 건 침대에 \"상어\" 베게에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401261/main2.ogg"},"메인3":{"voiceline":"언니들은 항상 게임에 너무 빠지면 안된다고 말해요. 하지만 쉬는 날이라면 얼마나 즐기든 상관 없겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401261/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"슈피 언니는 이 바삭바삭한 꼬깔 모양 과자를 좋아해요, 지휘관도요? 그럼... 입 벌리세요, 들어갑니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401261/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 니무의 방에 온 걸 환영해요! 아, 잠시만요, 먹을 거랑 마실 거, 놀 거까지 전부 꺼내드릴게요!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관 목 마른가요? 음료는 콜라, 우유 그리고 히퍼 언니와 오이겐 언니가 놀러올 때 마시는 맥주가 있어요. 모두 저쪽의 냉장고 안에 있어요. 알아서 꺼내 마셔요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401261/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오래 기다렸어요! 이것들이 저의 살림살이 전부에요! ......아 아니, 제 모든 간식과 게임기에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401261/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이 버튼을 누르면 게임이 시작돼요! ...... 에, 시작 버튼이 어떤 건지 물어본 거 아니에요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401261/touch.ogg"},"터치2":null,"입수시":{"voiceline":"지휘관, 니무의 방에 온 걸 환영해요! 아, 잠시만요, 먹을 거랑 마실 거, 놀 거까지 전부 꺼내드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401261/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"홈웨어","상점 id":70405,"상점 카테고리 id":20,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"KMS","레어도":"SR","ex_chat_status":0}]