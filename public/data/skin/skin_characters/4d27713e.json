[{"클뜯 id":301140,"클뜯 함순이 id":30114,"함순이 이름":"유다치","한글 함순이 + 스킨 이름":"유다치","영문 함순이 + 스킨 이름":"Yuudachi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301140/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301140/shipyard.png","설명":"시라츠유급 구축함 4번함·유다치","자기소개":{"voiceline":"유다치다! 「솔로몬의 광견」이라고 불린다고! 흐흥, 강한 것처럼 들려? 난투라면 지지 않는다고! ……\n응? 간식 시간이야? 지휘관, 과자 어딨어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/profile.ogg"},"메인1":{"voiceline":"지휘관, 원반 던지는 거 진짜 하지 말라고, 개 아니라니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/main1.ogg"},"메인2":{"voiceline":"(킁킁) 고기 냄새다! 어디야!? 빨리 알려줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/main2.ogg"},"메인3":{"voiceline":"싸움이 없어서 지루하다…… 지휘관~ 하자? 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/main3.ogg"},"전투개시":{"voiceline":"오오오! 싸움이라면 봐주지 않겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/battle.ogg"},"상세확인":{"voiceline":"아우? ……뭐야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/detail.ogg"},"드랍 설명":{"voiceline":"시라츠유급 구축함 4번함·유다치","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰가 완료됐다…… 칭찬하는 거면 되니까 머리 쓰다듬지 마라! ……(헝클헝클)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/expedition.ogg"},"실망":{"voiceline":"흥! (유다치는 당신을 무시했다)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/feeling1.ogg"},"낯섦":{"voiceline":"밥인가!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/feeling2.ogg"},"호감":{"voiceline":"오오우~ 오늘은 누구를 깨물어볼까! 어때, 엄청 거칠지 않아? ……좋아, 이거라면 여동생들이 전투 때 빼곤 개 같다고 말 못 할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 때문에 또 동생들이 비웃었어! 어떻게 할 거야! 머리 쓰다듬는 정도론── 에헤헤……(문질문질) 용서해…… 에헤헤…… 안 해줄 거다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 배 만져줘…… 흐음? 사과할 때에는 배꼽을 내민다고…… 다음에 실수하면 배 만지게 해줄 테니까 화내지 말라고── 가, 간지러. 아하하하","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 지휘관, 같이 먹겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/home.ogg"},"hp 경고":{"voiceline":"솔로몬의 악몽, 보여주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/hp_warning.ogg"},"로그인":{"voiceline":"아우, 지휘관……「손」이라니!? 얕보는 거냐!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/login.ogg"},"실패":{"voiceline":"젠장, 설마…… 지다니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/lose.ogg"},"우편":{"voiceline":"어이, 편지가 왔어. 도전장이야? 지지 않을 거라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/mail.ogg"},"임무":{"voiceline":"또 새로운 일이야? 어른들, 귀찮구만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/mission.ogg"},"임무완료":{"voiceline":"지휘관 지휘관, 보너스에 과자 없는지 빨리 확인해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301140/mission_complete.ogg"},"서약":{"voiceline":"서…약? 뭔데 그게? ……그럼 앞으로 항상 지휘관이 항상 머리 쓰담쓰담 해주고, 실수해도 안 혼내고, 맛있는 거 