eline":"이 일, 그냥 포즈만 취해주는 거였어…? 직접 레이싱 카를 몰 수 있을 줄 알았는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307062/main2.ogg"},"메인3":{"voiceline":"후… 아! 방심하면 안 되지, 안 돼… 언제든지 카메라 앞에서는 최고의 상태를 유지해야해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307062/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"아, 그러고 보니까 쇼카쿠 언니도 이 일, 오케이 했지? 스타일은 나랑 비슷하지만 쇼카쿠 언니가 입으면 조금 느낌이 다르네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307062/detail.ogg"},"드랍 설명":{"voiceline":"내가 자원해서 받은 업무에, 지휘관 일을 돕는 것도 기쁘기는 하지만, 이 옷은… 노, 노출이 이렇게 심하단 얘긴 듣지 못했다고…?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"하아… 이 자세를 오래 유지하고 있으니까 어깨가 뻐근한 것 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307062/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"헤헤, 걱정하지 마. 지휘관. 나에게는 그냥 사소한 것일 뿐이니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307062/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"계속 이 자세를 취해야 해…? 에휴, 왜 좀 더 멋있는 포즈를 취하면 안 되는 건지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307062/touch.ogg"},"터치2":{"voiceline":"지휘관, 다른 동료들에게도 이런 짓을 한 건 아니지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307062/touch2.ogg"},"입수시":{"voiceline":"내가 자원해서 받은 업무에, 지휘관 일을 돕는 것도 기쁘기는 하지만, 이 옷은… 노, 노출이 이렇게 심하단 얘긴 듣지 못했다고…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307062/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사