[{"클뜯 id":307060,"클뜯 함순이 id":30706,"함순이 이름":"즈이카쿠","한글 함순이 + 스킨 이름":"즈이카쿠","영문 함순이 + 스킨 이름":"Zuikaku","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307060/shipyard.png","설명":"쇼카쿠형 항공모함·즈이카쿠","자기소개":{"voiceline":"나는 5항전 즈이카쿠야! 언니와 함께 선배들이 가라앉은 후 사쿠라 엠파이어 최후의 정예 항공모함으로서 활약했고, 렉싱턴 씨와 호넷, 엔터프라이즈── 그래, 나보다 더 강한 행운을 가진 그 '그레이 고스트' 과도 싸웠어! 결국엔 가라앉아버렸지만, 최선을 다했으니까 후회는 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/profile.ogg"},"메인1":{"voiceline":"토라진 쇼카쿠 언니도 귀여워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/main1.ogg"},"메인2":{"voiceline":"최후의 최후까지 싸우는… 그것이야말로 '정예' 인 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/main2.ogg"},"메인3":{"voiceline":"기다려! '그레이 고스트'! 이기고서 도망가는 건 용서하지 않아! 다, 다시 한 번! 딱 한 번만 승부하자! 이번에야말로 반드시 이겨주겠어!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/main3.ogg"},"전투개시":{"voiceline":"끝도 없이 몰려오는 적들… 이런 건 이미 겪을 만큼 많이 겪었으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/battle.ogg"},"상세확인":{"voiceline":"1대1로 진검승부를 해보고 싶어… '그레이 고스트'!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/detail.ogg"},"드랍 설명":{"voiceline":"쇼카쿠형 항공모함·즈이카쿠","voicelink":null},"의뢰 완료":{"voiceline":"함재기가 더 있다면……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/expedition.ogg"},"실망":{"voiceline":"지휘관은 말야, 마리아나 해전에서의 내 심정을 체험해보고 싶은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/feeling1.ogg"},"낯섦":{"voiceline":"아차… 선배도 후배도 좀 귀찮단 말이지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/feeling2.ogg"},"호감":{"voiceline":"그러고 보니 나 말야, 예전엔 렉싱턴 씨랑 항상 엮였단 말이지…… 아! 지금 한 말 새러토가 씨한텐 하지마! 나, 그 아이만큼은 진짜 대하기 어렵거든……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/feeling3.ogg"},"기쁨":{"voiceline":"짜증 날 때나 뭘 해야 할지 모를 때는 언제나 훈련을 간다고! 그래! 나, 언젠간 강해져서, 반드시 그 '그레이 고스트' 을 앞질러 줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 말야, 쇼카쿠 언니와 좀 닮았단 말이지… 어, 어라? 아냐! 지휘관을 언니로 취급하지 않았대도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"꼼꼼히 정비할 수 있도록 부탁할게…… 앗, 하지만 싸울 기회를 놓쳐선 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/home.ogg"},"hp 경고":{"voiceline":"언니…… 쇼카쿠 언니는 괜찮아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/hp_warning.ogg"},"로그인":{"voiceline":"오늘은 어느 쪽이야? 진주만? 아니면 산호해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/login.ogg"},"실패":{"voiceline":"또… 가라앉는다는 거네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/lose.ogg"},"우편":{"voiceline":"그래서, 좋은 소식이야? 나쁜 소식이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/mail.ogg"},"임무":{"voiceline":"이제 쉬는 거야? 아, 쇼카쿠 언니가 손수 만든 요리, 지휘관도 한 번 먹어봐! 자! (우물우물)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/mission.ogg"},"임무완료":{"voiceline":"이걸로 전황도 조금은 나아지…겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/mission_complete.ogg"},"서약":{"voiceline":"에, 에에에?! 이, 이거…… 착각한 거 아니지?! 그, 그게…… 앞으로도 잘 부탁… 해? 여, 여여, 여보…… 와아아악! 쇼카쿠 언니가 부르고 있어!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/propose.ogg"},"스킬":{"voiceline":"언니만 있다면!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/skill.ogg"},"터치1":{"voiceline":"싫어하는 음식? 칠면조지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/touch.ogg"},"터치2":{"voiceline":"지휘관? 쇼카쿠 언니 게 더 크고 부드럽다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/touch2.ogg"},"입수시":{"voiceline":"사쿠라 엠파이어 항공전대 소속, 과거 대전쟁의 마지막 정예 항공모함인── 즈이카쿠야! 뭐, 쇼카쿠 언니가 있어 줘야 내 힘을 최대로 발휘할 수 있지만 말야. 어쨌든, 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/unlock.ogg"},"강화성공":{"voiceline":"완성형 항공모함으로서, 선배들에게도 '그레이 고스트' 에게도 절대 지지 않을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"행운함 즈이카쿠니까 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['쇼카쿠'] : 쇼카쿠 언니만 있어준다면 더 이상 아무것도 두렵지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/couple_encourage1.ogg"},{"voiceline":"['피닉스'] : 이유는 모르겠지만, 너 왠지 마음에 안 들어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307060/couple_encourage2.ogg"},{"voiceline":"['렉싱턴'] : 아직 비긴 거니까! 다음에 승부를 내주지!","voicelin