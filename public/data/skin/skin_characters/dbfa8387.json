/main/audio/voiceline/307061/main2.ogg"},"메인3":{"voiceline":"지휘관, 뭐라도 좀 먹을래? 많이 먹어야 얼른 자란다구~ 하하하. 장난이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/main3.ogg"},"전투개시":{"voiceline":"즈이카쿠, 등장!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/battle.ogg"},"상세확인":{"voiceline":"평소랑 다른 느낌이라고? 히히. 칭찬으로 받아들여도 되지? 사실 나도 가끔은 새롭게 갈아입고 싶다고. 기분전환 삼아서 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/detail.ogg"},"드랍 설명":{"voiceline":"새로운 정예 항공모함, 즈이카쿠 참전! ——계속 이런 멋있는 공연을 언제 한번 해보고 싶다고 생각했다구! 쇼카쿠 언니 앞에서 말 하면 분명히 비웃음 당할테니, 오늘 축제 분위기를 빌려 한번 도전 해볼까…… 지휘관, 어때?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지키고 싶은 사람이 있다면 어떤 강한 적을 만나도 전진할 수 있어. 실패 몇 번으로 낙담하지 않아. 몇 번이고 넘어져도 강한 마음만 있다면 다시 일어설 수 있어. …어떤 일이 일어나도 나는 쇼카쿠 언니같이 지휘관을 지킬거야! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"후… 구경은 재밌지만 조금 힘드네… 지휘관, 간식 좀 가지고 와도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 오늘의 일은 어디서부터 시작해? 응원은 나에게 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"미카사 선배의 특훈보다 훨씬 쉽네! 이 정도라면 얼마든지 할 수 있지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"응? 왜 그래, 지휘관? 가고싶은 곳이라도 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/touch.ogg"},"터치2":{"voiceline":"윽… 역시 쇼카쿠 언니의 것과 비교해야 하나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307061/touch2.ogg"},"입수시":{"voiceline":"새로운 정예 항공모함, 즈이카쿠 참전! ——계속 이런 멋있는 공연을 언제 한번 해보