[{"클뜯 id":605030,"클뜯 함순이 id":60503,"함순이 이름":"로마","한글 함순이 + 스킨 이름":"로마","영문 함순이 + 스킨 이름":"Roma","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605030/shipyard.png","설명":"비토리오 베네토급 전함 - 로마","자기소개":{"voiceline":"전함 로마라고 합니다. 그 대전에서 우리의 위광을 세상에 떨칠 기회를 가지지 못했습니다. 그래서 한 번 더 기회를 준 지휘관에게는 빚이 생긴 셈이죠. 제 빚은 곧 로마의 빚… 로마 또한 그 은혜에는 반드시 보답할 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/profile.ogg"},"메인1":{"voiceline":"모항의 가장 높은 곳에서 아래를 내려다본 적 있으신가요? 없다면 다음에 한 번 해보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/main1.ogg"},"메인2":{"voiceline":"적과의 교섭? 그런 시간 낭비는 별로 좋아하지 않지만… 선전 포고서라면 기꺼이 해 드리지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/main2.ogg"},"메인3":{"voiceline":"로마는 위험이 두렵지 않아요. 왜냐면 로마는 위험보다도 두려운 존재니까요. 훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/main3.ogg"},"전투개시":{"voiceline":"로마의 위광 앞에 산산이 부서져라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/battle.ogg"},"상세확인":{"voiceline":"베네토 언니의 '목욕탕 대화 모임'은 실로 훌륭한 발상이에요. 알몸이 되면 자연스레 마음의 경계도 느슨해져서, 비밀을 털어 놓고 말죠…. 목욕하면 기분이 좋아지니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/detail.ogg"},"드랍 설명":{"voiceline":"비토리오 베네토급 전함 - 로마","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 물자가 도착했어요. 좋아요, 마침 다음 행동에 필요했던 참이었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/expedition.ogg"},"실망":{"voiceline":"무능', '혐오스러운 자', '야만인'… 지금 지휘관에게는 어느 것이 가장 잘 어울린다고 생각해요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/feeling1.ogg"},"낯섦":{"voiceline":"로마를 경계하시는 건가요? 흠, 저도 무방비한 상태로 타인에게 친한 척 구는 분은 별로 좋아하진 않아서요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/feeling2.ogg"},"호감":{"voiceline":"적진을 통치하는 것, 그 백성을 복종시키는 것… 지휘관은 어느 쪽에서 더 만족감을 느끼시나요? ……둘 다 비슷하다구요? 욕심이 많은 사람이시군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/feeling3.ogg"},"기쁨":{"voiceline":"방금 가게에서 물건을 가지고 나오려고 할 때, 왜 막으신 건가요? ……가게의 규칙 때문이라구요? 흐음, 그 규칙이라는 것도 결국은 힘 그 자체에서 만들어지는 것 아닌지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/feeling4.ogg"},"사랑":{"voiceline":"세상을 손에 넣어도, 함께할 아군이 없다면 그 또한 쓸쓸하겠지요. ……제 불행에 대한 대비책으로, 로물루스의 위광은 지휘관 당신에게도 이어 드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/feeling5.ogg"},"터치3":{"voiceline":"로마의 축복이 필요하신가요, 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/headtouch.ogg"},"모항귀환":{"voiceline":"다음에 어디로 향할지 검토할 시간입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/home.ogg"},"hp 경고":{"voiceline":"제 군단병은…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/hp_warning.ogg"},"로그인":{"voiceline":"시간을 헛되이 낭비하고 계시는군요, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/login.ogg"},"실패":{"voiceline":"……더 많은 군단병을 넘겨주세요, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/lose.ogg"},"우편":{"voiceline":"새로운 우편인가요? 멀리서 보내온 항복 선언서려나요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/mail.ogg"},"임무":{"voiceline":"임무 지시인가요? 명령을 받는 건 별로 좋아하지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었나요? '직무에 충실한 자'라고 지휘관 직함에 하나 추가하는 것도 좋을 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/mission_complete.ogg"},"서약":{"voiceline":"지금부터 지휘관과 로마는 일심동체… 영원토록 헤어지지 않을 거예요. 지휘관의 뜻을 거스르는 것은 곧 저에 대한 반역으로 간주합니다. …? 다른 사람 신경도 좀 쓰라구요? 지휘관이 원한다면… 그래요…. 더 다른 사람도… 신경 써볼게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/propose.ogg"},"스킬":{"voiceline":"전투에서 해방시켜드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/skill.ogg"},"터치1":{"voiceline":"로마에게 바라는 게 있으신가요? 공물을 바치면 좋을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/touch.ogg"},"터치2":{"voiceline":"지휘관도 로마의 매력에 정복당하고 만 건지…. 부끄러워할 필요 없어요. 다 이해해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/touch2.ogg"},"입수시":{"voiceline":"저는 로마. 로물루스의 의지의 정통 계승자입니다. 지휘관, 바다의 수호자, 모항의 인도자, 모두의 리더——어떻게 불러드려야 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/unlock.ogg"},"강화성공":{"voiceline":"강한 적을 쓰러트리기에 필요한 것은 오로지 더 강한 무력뿐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"당연한 일입니다. 로마의 앞을 막아서는 자는 로마가 달성할 위업의 초석이 될 뿐이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"저도 피곤하니, 용건에 대해서는 목욕을 하면서 이야기를 나누도록 하죠. 네? 왜 그러시죠? 당연히 지휘관도 같이 들어가자는 건데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔네요. 어머, 저도 같이 마중 나가는 건가요? 설마 농땡이 피우는 아이에 대한 징계를… 아, 그냥 마중만 나가면 되는 거군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"승리하고 돌아오신 것을 축하드려요. 지휘관, 다음 목적지에 대해서도 검토를 끝내뒀답니다. 그대로 계속 진행하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"그럼 오셨으니, 오늘 작업을 시작하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"로마에게 뭘 원하는지 말해보세요. 이번에는 공물이 없어도 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/touch_ex.ogg"},"터치2_ex":{"voiceline":"이 정도일 줄은……. 지휘관도 점점 로물루스다운 품격을 갖추기 시작했네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['폼페오 마뇨'] :  캡틴 폼페이의 이름에 걸맞은 전투를!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/couple_encourage1.ogg"},{"voiceline":"['임페로'] :  임페로는 위대하도다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"언젠가 제가 위업을 달성한 그 순간에는 지휘관의 이름을 월계관에 새길 거예요. 그때는 꼭 제 곁에서 지켜봐주셨으면 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"바람 좀 쐬고 싶다구요? 도와드리죠. 이 유리창은 맨손으로도 부숴질 것…… 그냥 열면 된다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605030/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"RN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":605031,"클뜯 함순이 id":60503,"함순이 이름":"로마","한글 함순이 + 스킨 이름":"한밤중의 백조","영문 함순이 + 스킨 이름":"White Heron of Darkest Night","스킨 타입":"Rhythm & Steps","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605031/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605031/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605031/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605031/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605031/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605031/shipyard.png","설명":"제가 여기 있는 건 이미 알고 계셨던 모양이네요. 그럼 여기에 머물면서, 저와 함께 밤을 보내요. 당신과 저, 단 둘이서….","자기소개":null,"메인1":{"voiceline":"저도 무대에 서줬으면 한다구요? 물론 로물루스의 위광을 널리 알리기 위해서라면 상관없지만…. 제가 납득할만큼 '완벽'하게 완성되기 전까지, 지금은 기다려주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605031/main1.ogg"},"메인2":{"voiceline":"저주 받은 공주님은 한밤중에만 백조에서 사람이 될 수 있지만, 저는 춤추고 싶을 때 언제든 춤출 수 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605031/main2.ogg"},"메인3":{"voiceline":"어머, 평소엔 늘 게으른 가리발디도 오늘은 흑조 역할을 괜찮게 해내고 있네요. 그 역량, 인정해주도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605031/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"연습으로 쌓인 피로를 달래는 방법이라면 목욕을 빼놓을 수 없겠죠. 저 혼자만이 아니라, '우리'에게 그렇다는 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605031/detail.ogg"},"드랍 설명":{"voiceline":"제가 여기 있는 건 이미 알고 계셨던 모양이네요. 그럼 여기에 머물면서, 저와 함께 밤을 보내요. 당신과 저, 단 둘이서….","voicelink":null},"의뢰 완료":{"voiceline":"지금 받았어요. 새로운 의뢰 보상이랍니다.","voicelink":"https://raw.githubusercontent.com/Fern