[{"클뜯 id":408060,"클뜯 함순이 id":40806,"함순이 이름":"U-101","한글 함순이 + 스킨 이름":"U-101","영문 함순이 + 스킨 이름":"U-101","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408060/shipyard.png","설명":"메탈 블러드 VIIB형 잠수정U-101 ","자기소개":{"voiceline":"저는 U101으로 메탈 블러드 제 7 U함정 소대에 소속되어 있습니다. 울프팩에 4회 참가했으며, 파교가 주특기입니다! 그리고 저는 기사 철십자 훈장도 받았답니다! 하는 김에 말하자면 저는 커다란 물고기와 바람 쐬는걸 좋아한답니다. 지휘관님도 함께 하실래요? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/profile.ogg"},"메인1":{"voiceline":"아, 지휘관, 우선은 일 해. 난 옆에서 대어를 좀 조정할게, 있다가 같이 나가자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/main1.ogg"},"메인2":{"voiceline":"대어는 육상에서도 쓸 수 있어! 좀 느리긴 하지만 말이야...아하하, 나도 어떤 원리인지는 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/main2.ogg"},"메인3":{"voiceline":"운전할 때 들을 새로운 노래를 찾고싶어. 지휘관, 추천할 거 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/main3.ogg"},"전투개시":{"voiceline":"어뢰 장착, 준비 완료~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/battle.ogg"},"상세확인":{"voiceline":"유니온에 \"해상의 기사\"라고 불리는 사람이 있다던데? 이 별명 정말 멋지지 않아? 지휘관, 내 별명은 \"해저의 기사\" 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/detail.ogg"},"드랍 설명":{"voiceline":"메탈 블러드 VIIB형 잠수정U-101","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 완료했다고? 내가 마중 나갈래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/expedition.ogg"},"실망":{"voiceline":"난 드라이브 갈래, 바이바이~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/feeling1.ogg"},"낯섦":{"voiceline":"인이어를 착용하고 엔진을 가동시키고 모든 고민거리는 뒤로 미뤄두면 정말 편안하다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/feeling2.ogg"},"호감":{"voiceline":"다른 진영의 잠수정들이랑 가슴뛰는 레이스를 하고 싶어. 분명 엄청 자극적일텐데, 지휘관, 나 좀 도와줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 시간이 없으니 얼른 타! 오늘 엄청 아름다운 물고기 떼가 이 주변 해역을 지나갈거야. 놓치면 엄청 오래 기다려야 한다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 또 왔네! 헤헷, 내 뒤에 타는 거에 재미들렸지? 자, 타. 이번에는 더 재미있는 곳으로 데려다 줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 숙소로 바래다 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/home.ogg"},"hp 경고":{"voiceline":"좀 더 속도를 내야겠는걸...! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 말이라면 내가 다음에 데리러 와줄 수도 있는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/login.ogg"},"실패":{"voiceline":"못 피하다니...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/lose.ogg"},"우편":{"voiceline":"안녕하세요, 저는 집배원 U101입니다. 여기 편지요~헤헤","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/mail.ogg"},"임무":{"voiceline":"새로운 임무? 목적지까지 태워드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408060/mission.ogg"},"임무완료":{"voiceline":"지휘관, 임무 보상을 가지고 왔어.","voicelink":"https://raw.githubusercontent.com/Fernan