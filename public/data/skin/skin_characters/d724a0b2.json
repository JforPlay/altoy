[{"클뜯 id":9704040,"클뜯 함순이 id":970404,"함순이 이름":"리나운·META","한글 함순이 + 스킨 이름":"리나운·META","영문 함순이 + 스킨 이름":"Renown META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704040/shipyard.png","설명":"순양전함 리나운 인사드립니다, 지휘관님. 갈고 닦은 이 칼끝이 당신에게 힘이 될 수 있기를 바랍니다.","자기소개":{"voiceline":"순양전함 리나운입니다. 리펄스와 많은 작전과 임무를 함께 수행했죠… 지금 이 순간 이렇게 숨을 돌릴 수 있는 귀착점을 찾게 된 것은 저에게 행운입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/profile.ogg"},"메인1":{"voiceline":"……아, 죄송합니다. 창밖의 풍경을 보다가 잠시 멍하니 있었네요… 리펄스도 가끔 이런다고요? 그런가요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/main1.ogg"},"메인2":{"voiceline":"전 이 모항이 정말 좋아요. 이곳에 온 뒤의 기억을 조금씩 떠올릴 때마다 저도 모르게 안심이 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/main2.ogg"},"메인3":{"voiceline":"진지한 리나운 씨가 귀엽다고요……? 후훗, 그녀가 듣는다면 기뻐하겠죠. 제가 리나운 씨 대신 감사드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/main3.ogg"},"전투개시":{"voiceline":"대열을 갖추고, 적을 맞이합시다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/battle.ogg"},"상세확인":{"voiceline":"이미 지쳤다… 흠, 이런 말은, 쉽사리 말을 꺼낼 수 없죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/detail.ogg"},"드랍 설명":{"voiceline":"리나운호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰가 완료되었습니다. 먼저 동료들을 살펴보고 보상을 정리하시죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/expedition.ogg"},"실망":{"voiceline":"지휘관님은 사람들의 지도자이기에 이대로 자신을 내버려 두어서는 안 됩니다. 제가 당신을 인도할 책임을 질 것입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/feeling1.ogg"},"낯섦":{"voiceline":"상처도, 심지어 죽음의 위협도 저를 흔들 수 없습니다. 다만 전쟁의 참화가 가져온 마음의 상처는 죽음보다 훨씬 두렵습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/feeling2.ogg"},"호감":{"voiceline":"저는 동료들과 끝까지 싸울 수 있다면 힘들다는 것을 모를줄 알았는데… 그런 제가 언제부터 평온한 삶을 동경하게 되었을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/feeling3.ogg"},"기쁨":{"voiceline":"지금 이런 질문은 적절하지 않을 수도 있지만…… 지휘관님은 퇴임한 이후의 삶을 생각해본 적이 있으신가요? 지휘관님의 상상 속에 그 삶은 어떤 모습이죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/feeling4.ogg"},"사랑":{"voiceline":"저의 기억에 소중한 한 획을 더 해주셔서 감사합니다. 저는 지휘관님을 만나 함께 했던 이 경험을 꼭 가슴에 새길 거예요…… 아, 지휘관님을 떠날 거라는 의미는 아닙니다. 오해하게 해드려 죄송해요…… 전 항상 당신의 곁에서 함께할 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"모두가 무사히 돌아오는 모습은, 언제든 감정이 벅차오르게 하네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/home.ogg"},"hp 경고":{"voiceline":"여명이… 바로 앞에 있습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님의 성실함은 반드시 대등한 보답을 가져다 줄 것입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/login.ogg"},"실패":{"voiceline":"죄송합니다. 사명을 저버렸습니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/lose.ogg"},"우편":{"voiceline":"새로운 우편이 있습니다, 지휘관님. 조급해말고 휴식하면서 보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/mail.ogg"},"임무":{"voiceline":"새로운 임무요? 제가 도와드릴 수 있을지 모르겠습니다만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/mission.ogg"},"임무완료":{"voiceline":"임무도 완료되었으니, 조금은 긴장을 늦추는 것도 문제 없을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/mission_complete.ogg"},"서약":{"voiceline":"양초로 하트 모양을 만들어 놓으셨을 줄이야…… 지휘관님, 전 이미 당신의 마음을 잘 알고 있어요. 굳이 이렇게 해주지 않아도 반드시 승낙할 거예요. 참, 저, 제 표정 지금 좀 이상하지 않나요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/propose.ogg"},"스킬":{"voiceline":"방심하지 마시죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/skill.ogg"},"터치1":{"voiceline":"저를 걱정하는 것보다 더 가치 있는 일들이 더 많답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/touch.ogg"},"터치2":{"voiceline":"이런 행동은 지휘관님의 신분에 맞지 않습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/touch2.ogg"},"입수시":{"voiceline":"순양전함 리나운 인사드립니다, 지휘관님. 갈고 닦은 이 칼끝이 당신에게 힘이 될 수 있기를 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/unlock.ogg"},"강화성공":{"voiceline":"힘을 유지하는데 필요한 것...입니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"격전을 치르더라도 제 의지는 제가 여기서 쓰러지는 것을 허락하지 않을 것입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex"