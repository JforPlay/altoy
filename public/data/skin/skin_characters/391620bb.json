[{"클뜯 id":101270,"클뜯 함순이 id":10127,"함순이 이름":"베일리","한글 함순이 + 스킨 이름":"베일리","영문 함순이 + 스킨 이름":"Bailey","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101270/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101270/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101270/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101270/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101270/shipyard.png","설명":"벤슨급 구축함·베일리 (DD-492)","자기소개":{"voiceline":"베일리는, 토끼토끼별에서 온 베일리야! 언니들처럼 토끼토끼야! 화력 지원이 제일가는 특기로, 그걸로 칭찬받은 적도 있어! 에헤헤, 베일리는 엄청 강하다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/profile.ogg"},"메인1":{"voiceline":"가장 맛있는 당근은, 다음 당근이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/main1.ogg"},"메인2":{"voiceline":"삐삐삐… 토끼토끼별에서 메시지… 「베일리는 지휘관한테 전력으로 협력할 것」 지휘관도 사양 안 해도 되니깐, 전부 베일리한테 맡겨~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/main2.ogg"},"메인3":{"voiceline":"베일리의 꿈은 아이돌! 엄청, 어~엄청나게 인기 있는 아이돌이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/main3.ogg"},"전투개시":{"voiceline":"베일리는 너희들이 무섭지 않은걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/battle.ogg"},"상세확인":{"voiceline":"뀨─…… 큐─…… 아우…… 부, 부─…? 우우… 토끼토끼의 울음소리, 어려워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/detail.ogg"},"드랍 설명":{"voiceline":"벤슨급 구축함·베일리 (DD-492)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰 나갔던 애들이 돌아왔어! 마중 나가자~ 계속 가만히 있으면 녹슬어 버린다구~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/expedition.ogg"},"실망":{"voiceline":"지휘관은 토끼토끼의 적이다 뿅!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/feeling1.ogg"},"낯섦":{"voiceline":"베일리는 토끼토끼지만, 열심히 해볼게~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/feeling2.ogg"},"호감":{"voiceline":"벤슨 언니는 베일리가 토끼토끼별에서 왔다고 하지만, 베일리는 이제 어린애가 아니라서 그다지…… 그치만 그치만, 산타 씨는 분명 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/feeling3.ogg"},"기쁨":{"voiceline":"지휘관~ 토끼토끼랑 놀아줘~ 일? 후후후, 다시 한 번 봐볼래? 베일리한테 고마워하지 않아도 괜찮다구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/feeling4.ogg"},"사랑":{"voiceline":"언니가 토끼토끼는 외로우면 죽는다고 해서, 지휘관을 만나러 왔어~ 지휘관은…… 베일리한테 오고 싶지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했쪄! 베일리가 특제 쿠키로 지휘관의 마음을 치료해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/home.ogg"},"hp 경고":{"voiceline":"토끼토끼도… 화나면 사람을 문다뿅!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 몸은 어때~? 베일리가 토끼토끼 파워를 주입해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/login.ogg"},"실패":{"voiceline":"우우…… 토끼토끼별이 용서하지 않을 테니깐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/lose.ogg"},"우편":{"voiceline":"지휘관, 편지야! 토끼토끼별에서 온 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/mail.ogg"},"임무":{"voiceline":"지휘관, 당근을 모아두는 건 좋지만, 임무를 모아놓는다고 해도 아무것도 안 나온다구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/mission.ogg"},"임무완료":{"voiceline":"지휘관, 자, 베일리가 보수를 가져왔어! 대단하지─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/mission_complete.ogg"},"서약":{"voiceline":"서약……? 잘 모르겠지만, 지휘관도 토끼토끼별의 사람이 됐다는 거지? ……잘됐다! 이걸로 지휘관이랑 평생 함께야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/propose.ogg"},"스킬":{"voiceline":"간다앗─ 토끼토끼 암흑무한파!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/skill.ogg"},"터치1":{"voiceline":"지휘관의 손, 따뜻하네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/touch.ogg"},"터치2":{"voiceline":"이상한 느낌……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/touch2.ogg"},"입수시":{"voiceline":"베일리는 벤슨… 이 아니라 토끼토끼별에서 왔어! 지휘관, 언니들 봤어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/unlock.ogg"},"강화성공":{"voiceline":"토끼토끼 파워, 한층 더 레벨업! 예이!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흐흥, 토끼토끼는 엄청 강하다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101270/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":101271,"클뜯 함순이 id":10127,"함순이 이름":"베일리","한글 함순이 + 스킨 이름":"장난스러운 베일리","영문 함순이 + 스킨 이름":"Trickster Black Rabbit","스킨 타입":"Halloween","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101271/painting.png","확대 일러":null,"sd 일러":"htt