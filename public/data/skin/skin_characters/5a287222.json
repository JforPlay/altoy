[{"클뜯 id":402080,"클뜯 함순이 id":40208,"함순이 이름":"엘빙","한글 함순이 + 스킨 이름":"엘빙","영문 함순이 + 스킨 이름":"Elbing","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402080/shipyard.png","설명":"필라우급 경순양함—엘빙","자기소개":{"voiceline":"메탈 블러드 소속, 필라우급 순양함인 엘빙이야…. 소형 순양함으로 분류되는 순양함이고, 사실 함력상으로는 전혀 활약한 바가 없어…. 보다시피 장갑도 얇고, 화력도 약해서… 내세울 만한 건, 빠른 이동 속도와 항해 시간뿐….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/profile.ogg"},"메인1":{"voiceline":"오늘도 비가 내릴지 모르겠네……. 엘빙이 비가 온다고 하면, 분명 맑을 테니까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/main1.ogg"},"메인2":{"voiceline":"으아… 의장이 무서워…. 이렇게나 약한 나한테 강해 보이는 의장을 줘봤자…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/main2.ogg"},"메인3":{"voiceline":"엘빙이 분발해도 업무가 전혀 줄지를 않네…. 그렇지만 엘빙이 분발하지 않으면, 지휘관의 업무가 더 늘어날 거야…. 흑….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/main3.ogg"},"전투개시":{"voiceline":"난전이 되지 않도록 주의해야 해…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/battle.ogg"},"상세확인":{"voiceline":"지휘관? 괜찮아? 다치진 않았어? 나, 나… 방금 지휘관이 돌아오고 있을 때, 괜찮을까 하고 나도 모르게 걱정해버려서…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/detail.ogg"},"드랍 설명":{"voiceline":"필라우급 경순양함—엘빙","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어. 보상은… 내가 받으러 가면 분명히 줄어들겠지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/expedition.ogg"},"실망":{"voiceline":"더 좋은 지휘관일 거라고 기대한 내 잘못이겠지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/feeling1.ogg"},"낯섦":{"voiceline":"나, 약하기만 한 덜렁이에, 운도 지지리도 없고… 지휘관에게 도움이 될 만한 구석도 거의 없을 텐데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/feeling2.ogg"},"호감":{"voiceline":"어차피 내 공격은 적에게 맞지도 않고, 그렇다고 두 배… 세 배로 쏘면… 분명 맞지도 않고 탄약만 낭비하는 꼴이겠지…. 아아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/feeling3.ogg"},"기쁨":{"voiceline":"지휘관이 내게 잘 대해주는 건, 내가 잘해서 그런 게 아니라, 나를 불쌍하다고 생각해서 그런 거지…? 나 따윈… 지휘관에게 아무것도 해줄 수 없는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/feeling4.ogg"},"사랑":{"voiceline":"내가 바라는 건 하나도 이뤄지지 않아…. 그러니까 내게 잘해 주는 지휘관은… 꼭 불행해지라고 빌 거야! 지휘관과 엘빙이… 같이 불행해질 수 있도록…. 그럼, 지휘관은 분명 행복해질 수 있을 테니까…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/feeling5.ogg"},"터치3":{"voiceline":"앗…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와…. 내가 지휘관이 만신창이가 되라고 바란 덕분에, 지휘관이 이렇게 무사히 돌아왔구나…. 그래, 내 바람 같은 건 절대 이루어지지 않으니까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/home.ogg"},"hp 경고":{"voiceline":"부, 부딪힌다…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/hp_warning.ogg"},"로그인":{"voiceline":"오늘 비 안 와? 아아… 역시 내가 비 안 맞으려고 우산을 들고 와서…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/login.ogg"},"실패":{"voiceline":"그럼 그렇지, 내가 참전하는 전투니까 지는 게 당연하지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/lose.ogg"},"우편":{"voiceline":"엘빙에게는 나쁜 소식… 지휘관에게는 좋은 소식이 될 수 있도록….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/mail.ogg"},"임무":{"voiceline":"지휘관, 여기 임무 목록이야. 휴우….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 도착했어. 나보다 지휘관이 먼저 확인하는 편이….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/mission_complete.ogg"},"서약":{"voiceline":"서약 반지?! 그, 그럴 수가… 나, 지휘관이랑 행복해지는 건…. 아아, 분명 이건 엘빙의 행복이 아니라, 지휘관이 바란 행복이라서 이뤄진 걸 거야…. 다행이다…. 흐흑… 정말 다행이야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/propose.ogg"},"스킬":{"voiceline":"맞추지 못한다고 해도…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/skill.ogg"},"터치1":{"voiceline":"내가 할 수 있는 건… 아, 아무것도 없을 거야. 분명….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/touch.ogg"},"터치2":{"voiceline":"나, 나 같은 건…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드 소속 순양함인 엘빙이야…. 어차피 나 같은 건 별 전력도 안 되니까, 분명 무시나 당하겠지…. 그럴 리 없다고? 그래… 내겐 혹사당하는 정도의 가치밖에 없으니까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/unlock.ogg"},"강화성공":{"voiceline":"강화해봤자….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"내, 내가 1등…? 다들 그렇게까지 날 배려할 필요는 없는데… 난 1등이 될 만한 실력 따위 없다구….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"꺅?! 미안해! 나야말로 갑자기 밀어붙여서…. 지휘관은 분명 여기 없을 거야, 하고 바라면서, 나도 모르게 문 뒤편에서 기다리고 있었어….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀 보상… 정말 괜찮아? 엘빙에게 맡기면, 이 리스트랑 내용이 달라질 수도 있는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/expedition_ex.ogg"},"사랑_ex":{"voiceline":"오늘 난 분명히 불행할 거야. 비도 잔뜩 맞고, 예약한 레스토랑은 폐점하고, 예매한 영화관은 폐관이 되고, 갑자기 일이 들어와서 지휘관이랑 같이 밤을 즐길 수 없게 되고…. 이, 이제 됐다. 지휘관을 너무 오래 기다리게 하면 안 되겠지…. 응!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관이 걱정되긴 했지만, 딱히 아무 생각도 안 했어…. 내가 무사하길 바라면, 지휘관은 분명 위기에 빠질 테니까, 아무것도 생각하지 않아야 지휘관도 내 영향을 받지 않을 것 같아서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘 비 올 것 같다구? 그래… 우산만 가지고 오면 혹시 맑아질까 하고 생각한 내가…. 마, 맑았으면 좋겠다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"임무 보상……! 뭐, 뭐가 들어 있으려나…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"응, 내가 할 수 있는 거라면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/touch_ex.ogg"},"터치2_ex":{"voiceline":"…하아…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"지휘관, 무리해서 굳이 나한테 이런 거 안 해줘도 돼…. 내가 1등을 하는 전투 같은 건, 어차피….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"구축함 의장은 귀엽네…. 엘빙도 어쩌면 이쪽 의장을 받는 편이 더 나을지도 모르겠어. 후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402080/main5_ex.ogg"},"메인6_ex":{"voiceline":"내가 도와줄 수 있는 거 있을까? 내게 맡겨도 괜찮을 만한, 지휘관에게 피해를 주지 않을 수 있는 일이 있다면, 그….","voicelink":"https://