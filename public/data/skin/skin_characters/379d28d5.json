[{"클뜯 id":299020,"클뜯 함순이 id":29902,"함순이 이름":"모나크","한글 함순이 + 스킨 이름":"모나크","영문 함순이 + 스킨 이름":"Monarch","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299020/shipyard.png","설명":"전함 - 모나크","자기소개":{"voiceline":"로열 네이비의 전함 킹 조지 5세급의 폐기된 방안 중 하나, 이름은 모나크라고 한다. 흠, 비록 낙오되었다곤 하나, 만들어진 이상 이렇게 있을 수밖에 없지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/profile.ogg"},"메인1":{"voiceline":"웨일즈와 요크……내 존재를 뺏은 그녀들이 싫지만, 나의 존재를 이은 그녀들을 원망하진 못하겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/main1.ogg"},"메인2":{"voiceline":"동생? 그런 존재가 있다고 한다면, 이름은…… '프린스 오브 웨일즈'…지금 생각해보니 나쁘지 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/main2.ogg"},"메인3":{"voiceline":"나를 선택하지 않은 게 얼마나 어리석은 일이었는지…이 세계에 똑똑히 알려주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/main3.ogg"},"전투개시":{"voiceline":"나를 믿어라! 이 함대의 어느 누구도 빼놓지 않고 함께 귀환하여 보이겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/battle.ogg"},"상세확인":{"voiceline":"내게 있어 너는 이 세계의 유일한 특이점…너와 만나기 전까지, 나에게 기대를 걸었던 인간은 단 한 명도 없었다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/detail.ogg"},"드랍 설명":{"voiceline":"전함 - 모나크 ","voicelink":null},"의뢰 완료":{"voiceline":"구현화 되기까지 얼마만큼의 노력이 있었던가……흥, 얼마만큼이 되었던 배로 갚아줄 뿐이다. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/expedition.ogg"},"실망":{"voiceline":"이 내가 그 녀석들보다 못하다는 것이냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/feeling1.ogg"},"낯섦":{"voiceline":"그 세계에서 버려진 나는, 나야말로 유일한 '최우수' 함선이라 믿고, 지금까지 버텨왔지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/feeling2.ogg"},"호감":{"voiceline":"사랑은 보답을 바라지 않는 것. 나에 대한 왕가의 처사가 그러할지라도, 내 왕가에 대한 충성심은 흔들리지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/feeling3.ogg"},"기쁨":{"voiceline":"그 녀석들은 웃을 수 있었던 건가…나는 버려지긴 했지만 가치 없진 않았구나…처음으로 그런 느낌이 드는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 너는 내게 있어…무엇보다도 특별하고, 무엇보다도 소중한 존재다. 처음부터, 계속……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"성대한 환영이더군. 흠, 혹시 나 혼자라면, 마중 나오는 이가 과연 있을까……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/home.ogg"},"hp 경고":{"voiceline":"웨일즈라면 벌써 가라앉았겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/hp_warning.ogg"},"로그인":{"voiceline":"잘 돌아왔다. 이 모나크는, 웨일즈나 요크보다도 우수하다…지휘관도 그렇게 생각하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/login.ogg"},"실패":{"voiceline":"다시……버려지는 건가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/lose.ogg"},"우편":{"voiceline":"전황에 관한 우편이다. 지휘관, 확인하도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/mail.ogg"},"임무":{"voiceline":"이 임무는 내게 맡겨주었으면 좋겠군. 내가 가장 우수하다는 걸 증명해 보이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/mission.ogg"},"임무완료":{"voiceline":"존재하는 것만으론 끝나지 않아. 가장 우수하기 때문에 존재해야 하는 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/mission_complete.ogg"},"서약":{"voiceline":"설령 이 세계가 날 필요로 하지 않게 된다 해도, 넌 날 필요로 해주겠지. 내겐 그것만으로 충분하다……후훗, 혹시 모르지, 난 너와 만나기 위해 이 세계에 구현화 된 걸지도. 만약 그렇다면…그것만으로 난 행복하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/propose.ogg"},"스킬":{"voiceline":"여왕의 호령이라도, 이 환상의 제왕을 따르게 할 순 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/skill.ogg"},"터치1":{"voiceline":"지휘관, 나란 존재가 필요한가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/touch.ogg"},"터치2":{"voiceline":"그 녀석들의 악습에 물들지 않도록 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/touch2.ogg"},"입수시":{"voiceline":"처음 만나는군. 나는 전함 모나크다. 흠, 이 한 번 버려진 몸에게 까지 도움을 구할 줄이야…로열 네이비는 벌써 이 정도로 몰락하였단 말인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/unlock.ogg"},"강화성공":{"voiceline":"흠… 역시, 나야말로 킹 조지 5세급의 '최강' 에 어울리는 자…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"자! 나를 믿어라! 내가 계속하여 승리해주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관, 지켜보고 있거라. 이 모나크가 가져오는 승리를!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"전혀 상상조차 하지 못했다… 누구에게도 기대받지 못하고, 고독한 길을 가고 있던 내게… 너와 함께하는 미래에 기대감을 품는 날이 오다니… 날 받아주고, 내게 사는 의미를 줘서 고맙다. 지휘관은 이 모나크에게 가장 소중한 존재다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관, 무사히 잘 돌아왔다. 내가 홀로 전장에서 돌아올 때도 네가 이렇게 마중 나와서 같은 말을 건네겠지. 이 느낌... 정말 기분이 좋군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"잘 돌아왔다, 지휘관. 이제부터는 집무에 전념할 텐가? 아니면 잠시 쉬겠는가? 어느 쪽이든 함께하마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관… 네 도움이 될 수 있어 기쁘군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/touch_ex.ogg"},"터치2_ex":{"voiceline":"…읏. 조금만 더 시간을 주겠나? 조금… 익숙해질 시간을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"어떤가? 너만은 절대 실망시키지 않으마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['프린스 오브 웨일즈'] : 나는 조지, 엘리자베스, 에드워드…하지만 결코 '웨일즈' 는 아니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/couple_encourage1.ogg"},{"voiceline":"['듀크 오브 요크'] : 다른 세계였다면, 너의 진짜 언니가 되었을지도 모르지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"이런 관계는 아직 익숙하지 않지만, 네 곁에 있으면 다시는 헤매지 않을 거라 믿고 있다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/main5_ex.ogg"},"메인6_ex":{"voiceline":"걱정했던 대로군. 이제 더는 고독을 견딜 수 없을 것 같다. 이건 네 탓이다… 네가… 나를 바꿔준 덕분이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"너는 내게 존재의 의미를 찾아주었지. 그러니 나는 네게 영원한 승리를 가져다… 바치마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299020/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":299021,"클뜯 함순이 id":29902,"함순이 이름":"모나크","한글 함순이 + 스킨 이름":"화이트 워릭","영문 함순이 + 스킨 이름":"White Warrick","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299021/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299021/shipyard.png","설명":"흥, 옷 따위는 결국 장식에 불과해. 진정한 고귀함이란 자신의 본질에 따라 정해지는 것이다…지휘관, 너도 그렇게 생각하지 않나?","자기소개":null,"메인1":{"voiceline":"nil","voicelink":null},"메인2":{"voiceline":"로열의 궁정 무용을 어떻게 추는지 가르쳐 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299021/main2.ogg"},"메인3":{"voiceline":"화려한 복장은 기념일에 속하지, 하지만 나에게는, 이곳에 존재하는 매일이 경사스러운 기념일이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299021/main3.ogg"},"전투개시":{"voiceline":"너희들에게 제대로 보여주지. 무엇이 로열식 품위인지를 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299021/battle.ogg"},"상세확인":{"voiceline":"고개들고 어깨 펴, 지휘관. 넌 내가 인정한 유일한 존재니까—눈을 어디둬야 할지 모르겠다고?? 그렇다면 내 눈을 바라봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299021/detail.ogg"},"드랍 설명":{"voiceline":"흥, 옷은 받쳐입는 것에 불과하지, 진정한 고귀함은 자기 자신에 의해 정해지는 것이다. 그렇게 생각하지 않아, 지휘관?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"뭘 멍하니 있어, 지휘관? 오늘 해야할 많은 일들이 널 기다리고 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299021/login.ogg"},"실패":null,"우편":null,"임무":null