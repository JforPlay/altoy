[{"클뜯 id":501070,"클뜯 함순이 id":50107,"함순이 이름":"페이윈","한글 함순이 + 스킨 이름":"페이윈","영문 함순이 + 스킨 이름":"Fei Yuen","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501070/shipyard.png","설명":"창펑급 구축함—페이윈","자기소개":{"voiceline":"나는 창펑급 구축함 페이윈이야. 이래 봬도 \"모험\"에는 자신 있다구! 혹시 관심 있으면 나한테 물어보러 와! 후훗, 절대 아무한테도 말하지 않을게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/profile.ogg"},"메인1":{"voiceline":"지휘관~ 이거 봐! 하이티엔 스승님한테 배워서 그린 그림이야! 요괴를 참 잘 그린다고…? 페, 페이윈이 그린 건 지휘관인데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/main1.ogg"},"메인2":{"voiceline":"지휘관, 같이 모험하러 가자! 무슨 모험이냐고? 음… 주방에서 설탕이랑 소금을 바꿔치기 하는…? 자, 장난치는 거 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/main2.ogg"},"메인3":{"voiceline":"지금 페이윈 님이 정리한 서류를 책장 위에…… 꺅! 아야야… 다 흩어졌네…… 미안해… 페이윈은 도와주고 싶어서 그런 건데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/main3.ogg"},"전투개시":{"voiceline":"위대한 모험을 시작하는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/battle.ogg"},"상세확인":{"voiceline":"음냐음냐… 쿨쿨…… 아! 따, 딱히 페이윈 님은 잠든 거 아니거든! 진짜야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/detail.ogg"},"드랍 설명":{"voiceline":"창펑급 구축함—페이윈","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아왔어! 에헤헷~ 페이윈 님에게 줄 선물로 뭘 가지고 왔으려나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/expedition.ogg"},"실망":{"voiceline":"지휘관, 이대로면… 페이윈 님은 지휘관을 모험에 안 데려가게 될 거야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/feeling1.ogg"},"낯섦":{"voiceline":"아, 지휘관. 푸슌이랑 같이 모험하려고… 응? 장난은 적당히 치라고? 자, 장난치는 거 아니거든! 무슨 말 하는 건지 모르겠네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/feeling2.ogg"},"호감":{"voiceline":"지휘관~ 페이윈 님이랑 놀아줘! 일해야 돼서 안 된다고? 놀아줘! 놀아달라구! 페이윈 님은 지휘관을 위해 오늘 모험 가는 것도 포기했다구! …그러니까 일은 제쳐두고 페이윈 님이랑 놀·아·줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/feeling3.ogg"},"기쁨":{"voiceline":"지휘관! 페이윈이 책장을 정리했어! ……응? 일부러 참고하려고 꺼내둔 거였다고? 미, 미안해! 일부러 그런 건…… 지, 지휘관을 도와주고 싶었던 것뿐이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/feeling4.ogg"},"사랑":{"voiceline":"지휘관~! 페이윈이랑 같이 모험하러 안 갈래? …응? 업무가 아직 남았다고? 그럼…… 얌전히 여기서 기다려줄게! …얌전히 있으면 상을 주겠다고? 에헤헤~ 지휘관이 최고야~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/feeling5.ogg"},"터치3":{"voiceline":"페이윈 님의 머리를 마음대로 쓰다듬다니…… 기분 좋아…… 그, 그럼… 조금만 더 쓰다듬게 해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/headtouch.ogg"},"모항귀환":{"voiceline":"응? 돌아왔네. 페이윈 님께 바칠 선물은?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/home.ogg"},"hp 경고":{"voiceline":"페이윈 님의 모험은… 멈추지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/hp_warning.ogg"},"로그인":{"voiceline":"랄랄라~♪ 돌아왔네? 오늘 업무를 시작하려고? 페이윈 님은 이미 준비 끝났거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/login.ogg"},"실패":{"voiceline":"고, 고작 한 번 진 거잖아… 페이윈 님은 안 운다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/lose.ogg"},"우편":{"voiceline":"이게 전부 지휘관 앞으로 온 우편이야! 읽는 거 까먹지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/mail.ogg"},"임무":{"voiceline":"으, 으아아아… 임무 목록이 엄청 길어졌잖아! 지휘관, 페이윈 님도 도와줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/mission.ogg"},"임무완료":{"voiceline":"지휘관! 항구에 물자가 가득 쌓여있어! 빨리 보상을 수령해서 페이윈 님에게 바칠 선물을 사는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/mission_complete.ogg"},"서약":{"voiceline":"이걸 페이윈한테? 에헤헤~ 신난다! 이게 뭔지는 잘 모르겠지만, 손가락에 끼면 지휘관이랑 계속 같이 놀 수 있는 거지? 자, 꼈어! 지휘관, 이제부터는 계속 페이윈이랑 같이 있는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/propose.ogg"},"스킬":{"voiceline":"페이윈 님의 힘을 보여줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/skill.ogg"},"터치1":{"voiceline":"응? 왜 그래? 드디어 페이윈 님이랑 같이 모험할 결심이 선 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/touch.ogg"},"터치2":{"voiceline":"지휘관이…… 망가진 건가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/touch2.ogg"},"입수시":{"voiceline":"이스트 글림의 창펑급 구축함 페이윈이야! 당신이 내 지휘관이야? 후훗, 앞으로는 날 페이윈 님이라고 부르도록 해♪ 그러면 지켜주고 모험에도 데려가 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/unlock.ogg"},"강화성공":{"voiceline":"오오오! 힘이 솟구쳐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후훗~ 페이윈 님을 깔보면 이런 꼴을 당하는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"쿨…… 흐아암…… 지휘관 옆에 있으면 자꾸 잠이 와…… 아! 알겠다! 분명 지휘관 냄새에 페이윈을 그렇게 만드는 효과가…… 쿨쿨……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"조, 조금만 더 만져줘…… 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어서와~! 어디 아프면 페이윈이 호~ 해줄게! 아픈 곳은 없다구? 그럼 더 좋고♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관~ 드디어 돌아온 모양이네! 페이윈, 계속 기다리고 있었다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"페이윈 볼이 그렇게 말랑말랑해? 에헤헤, 지휘관 볼도 말랑말랑해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/touch_ex.ogg"},"터치2_ex":{"voiceline":"음… 지휘관은 그러면 즐거워? ……그, 그러면 페이윈도 즐거워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"도와주는 건 곁에 있어주는 걸로 충분하다고? …그럼, 이렇게 껴안고 있어도? 엄청 도움이 된다고? 에헤헤~ 다행이다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/main5_ex.ogg"},"메인6_ex":{"voiceline":"최근 모험 횟수가 줄어든 것 같다고? 모험이 즐겁긴 하지만, 지휘관 곁에 있는 게 더 재밌거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관…… 페이윈, 꽃병이랑 데스크 조명을 떨어트렸어… 청소하는 걸 도와주려고 한 것뿐인데… 일부러 그런 거 아니야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501070/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":1},{"클뜯 id":501071,"클뜯 함순이 id":50107,"함순이 이름":"페이윈","한글 함순이 + 스킨 이름":"하늘에 뜬 구름","영문 함순이 + 스킨 이름":"Flying Clouds, Flailing Pranks","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501071/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501071/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501071/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501071/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501071/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501071/shipyard.png","설명":"새해 복 많이 받아…… 흑… 저, 저기… 일단 페이윈 좀 내려줄래? 다시는 주방에 모험하러 안 갈게…","자기소개":null,"메인1":{"voiceline":"줄에는 왜 매달려 있는 거냐고? 음…… 사, 사실… 주방에서 모험하다가 잡혔어… 잘못했어… 다음? 다음부터는 안 할게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/main1.ogg"},"메인2":{"voiceline":"아, 불꽃놀이! 이러고 있으면 불꽃놀이 하는 걸 못 보잖아! 적어도 볼 수는 있게 줄 방향만 좀 바꿔줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/main2.ogg"},"메인3":{"voiceline":"귀엽고 비싸 보이는… 옷이라구? 에헤헤, 동료들이 새해 선물로 준 거야. 약간 \"혼천릉\"? 그런 느낌이라던데… 혹시 그게 뭔지 알아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"새해 복 많이 받아…… 흑… 저, 저기… 일단 페이윈 좀 내려줄래? 다시는 주방에 모험하러 안 갈게…","voicelink":null},"의뢰 완료":{"voiceline":"응? 지휘관, 의뢰팀 애들이 돌아온 것 같은데? 응, 저기.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"에헤헤, 머리 쓰담쓰담…… 아, 아니지! 페이윈 좀 내려달라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/headtouch.ogg"},"모항귀환":{"voiceline":"어, 어서 와. 지휘관! 사과라도 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"흑…… 지휘관, 드디어 돌아왔네… 빨리 페이윈 좀 내려줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/login.ogg"},"실패":null,"우편":{"voiceline":"지휘관~ 새로운 우편이 온 게 보여~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/mail.ogg"},"임무":null,"임무완료":{"voiceline":"항구에 여러 가지 물건이 쌓여 있는 것 같아. 혹시 우리한테 줄 새해 선물인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"아하하하하…… 배 좀 그만 찔러! 간지럽다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/touch.ogg"},"터치2":{"voiceline":"어쨌든 일단…… 우선 페이윈 좀 내려줘! 내려주기만 하면 뭐든 다 할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/touch2.ogg"},"입수시":{"voiceline":"새해 복 많이 받아…… 흑… 저, 저기… 일단 페이윈 좀 내려줄래? 다시는 주방에 모험하러 안 갈게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"만쥬들이 세우고 있는 저 간판은 대체 뭐야! 페이윈은 따, 딱히 뭘 훔쳐먹지는 않았다구……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501071/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70968,"상점 카테고리 id":3,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":800,"기간":"한정 (2025/02/12)","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":501072,"클뜯 함순이 id":50107,"함순이 이름":"페이윈","한글 함순이 + 스킨 이름":null,"영문 함순이 + 스킨