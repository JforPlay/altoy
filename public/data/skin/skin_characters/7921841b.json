[{"클뜯 id":801090,"클뜯 함순이 id":80109,"함순이 이름":"르 테메레르(μ장비)","한글 함순이 + 스킨 이름":"르 테메레르(μ장비)","영문 함순이 + 스킨 이름":"Le Téméraire μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801090/shipyard.png","설명":"랑트레피드급 르 테메레르…가 아니지! 지금은 \"Cyanidin\" 소속 아이돌인 르쨩! 르 테메레르야! 지휘관, 내 데뷔 라이브 기대해 줘☆","자기소개":{"voiceline":"랑트레피드급 르 테메레르야! \"Cyanidin\"의 최고로 엘레건트하고 멋진 라이브를 보여줄 테니까, 지휘관! 기대하고 있어☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/profile.ogg"},"메인1":{"voiceline":"지휘관~! 에헤헤, 르쨩이 주는 비밀 선물… 활기찬 포옹~♪ 에헤헤, 의욕 충전됐어?♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/main1.ogg"},"메인2":{"voiceline":"아야… 발 삐었나 봐… 으으, 역시 이 안무는 어려워… 으아! 지휘관, 여긴 무슨 일이야? 발을 마사지해 주겠다고? 으음~ 에헤헤, 왠지 좀 괜찮아진 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/main2.ogg"},"메인3":{"voiceline":"문 뒤에 뭐가 있는지 궁금하다고? 아하하! 저 안에는 거대한 버섯이 자라 있어. 굉장하지? 뭐, 다 세트이기는 하지만♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/main3.ogg"},"전투개시":{"voiceline":"라이브 시작!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/battle.ogg"},"상세확인":{"voiceline":"새로운 안무를 하루 종일 연습했어… 안 피곤하냐고? 에헤헤, 지휘관을 위한 특별 라이브라고 생각하면 아무렇지도 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/detail.ogg"},"드랍 설명":{"voiceline":"랑트레피드급 르 테메레르…가 아니지! 지금은 \"Cyanidin\" 소속 아이돌인 르쨩! 르 테메레르야! 지휘관, 내 데뷔 라이브 기대해 줘★","voicelink":null},"의뢰 완료":{"voiceline":"멋진 라이브로 의뢰팀 사람들을 맞이해 주자! 어때, 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/expedition.ogg"},"실망":{"voiceline":"지휘관…… 혹시 요새 스트레스 많이 받아…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 조금 있다가 르쨩의 라이브가 시작돼! 최고로 엘레건트하고 멋진 모습 보여줄 테니까 기대하고 있어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/feeling2.ogg"},"호감":{"voiceline":"지휘관~! 후… 방금은 어땠어? 저번보다 잘하는 것 같아? 엘레건트해? …에헤헤♪ 요즘 계속 열심히 연습하고 있거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 나중에 시간 있어? 딱히 뭘 부탁하려고 하는 건 아니고, 그냥 최근에 비밀리에 한 특훈 성과를 지휘관에게 보여줘서 깜짝 놀라게 해주려고…… 으아! 다 말해버렸네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/feeling4.ogg"},"사랑":{"voiceline":"르쨩이 무대 위에서 굉장히 빛났다고? 에헤헤, 그렇지만 내겐 지휘관이 가장 특별하고, 가장 빛나는 존재야! …아! 말하고 보니, 나보다 지휘관이 아이돌이 되는 편이 좋을지도…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 어서 와! 이제 좀 쉬어… 에헤헤,틈틈이휴식을 취해야 최고로 엘레건트한 공연을 보여줄 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/home.ogg"},"hp 경고":{"voiceline":"으아! 방금 음정이 나간 건가…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/hp_warning.ogg"},"로그인":{"voiceline":"르쨩, 아이돌로서 보내는 일상도… 전력을 다할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/login.ogg"},"실패":{"voiceline":"으으… 역시 레슨을 더 많이 받아야겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 우편이 왔어! …뭐, 나중에 확인하면 되겠지? 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무가 있어! 르쨩도 도와줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어! 지휘관! 보상도 받았으니 같이 놀러가자♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/mission_complete.ogg"},"서약":{"voiceline":"에헤헤, 사실은 나 아이돌이 된 날부터 이렇게 되면 좋겠다고 기대했었어~ 지휘관이 아이돌 르쨩에게 반지를 주는 걸 만 번은 꿈꿨는데… 막상 정말 이렇게 되니까 긴장이 되네… 지휘관, 앞으로도 계속 손을 잡고 있어도… 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/propose.ogg"},"스킬":{"voiceline":"큰 목소리로 노래하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/skill.ogg"},"터치1":{"voiceline":"지휘관도 공연에 참가하고 싶다고? 신난다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/touch.ogg"},"터치2":{"voiceline":"꺅?! 지휘관, 라이브가 슬슬 시작할 거야. 이럴 때가 아니라구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/touch2.ogg"},"입수시":{"voiceline":"랑트레피드급 르 테메레르…가 아니지! 지금은 \"Cyanidin\" 소속 아이돌인 르쨩! 르 테메레르야! 지휘관, 내 데뷔 라이브 기대해 줘☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/unlock.ogg"},"강화성공":{"voiceline":"이건 연습한 성과야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"아이돌의 매력, 확실히 전해졌으려나~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceli