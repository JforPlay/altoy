[{"클뜯 id":305120,"클뜯 함순이 id":30512,"함순이 이름":"키이","한글 함순이 + 스킨 이름":"키이","영문 함순이 + 스킨 이름":"Kii","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305120/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305120/shipyard.png","설명":"키이급 전함—키이","자기소개":{"voiceline":"나는 키이급 전함의 1번함, 키이야. 여러가지 이유 때문에 세계대전에서는 내 실력을 발휘할 수 없었지만…… 드디어 보여줄 기회가 생겼어! 지휘관, 원하는 대로 마음껏 나에게 명령을 내려줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/profile.ogg"},"메인1":{"voiceline":"누가 괴롭히면 나에게 말 해. 내가 날려버릴게! …응? 진짜야. 농담 아닌데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/main1.ogg"},"메인2":{"voiceline":"으~ 계속 이러고 있으니까 몸이 굳는 것 같아… 왜 그렇게 쭈뼛거려? 응? 옷이 흐트러졌다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/main2.ogg"},"메인3":{"voiceline":"스루가 ~ 오늘 일 끝나면 이세 일행이랑 같이 한잔 하자! 에이, 그렇게 매정하게 굴지 말고… 그럼 가는 거다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/main3.ogg"},"전투개시":{"voiceline":"정정당당하게 승부다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/battle.ogg"},"상세확인":{"voiceline":"검이든 대포든 무기는 커야 좋아. 기세에서부터 이겼다! 하는 느낌이거든. 어떻게 생각해, 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/detail.ogg"},"드랍 설명":{"voiceline":"키이급 전함—키이","voicelink":null},"의뢰 완료":{"voiceline":"의뢰와 같은 단순한 일에는 관심 없지만 돌아온 동료들을 못본 척 할 수는 없지. 마중하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/expedition.ogg"},"실망":{"voiceline":"쯧, 네 부하 짓도 재미 없어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/feeling1.ogg"},"낯섦":{"voiceline":"저기, 조금만 움직여도 그렇게 헉헉대? 조금 운동 부족 아니야? 마치 스루가  같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/feeling2.ogg"},"호감":{"voiceline":"음…… 좋아! 이 키이가 함께 운동을 해주지! 실내에만 있지 말고 나와서 운동 하자. 목검을 휘두른다던가, 뭐든 상관 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/feeling3.ogg"},"기쁨":{"voiceline":"전장에서 빛나는 것도 그걸 봐줄 동료들이 있어야 재미있지~ 좋아! 일이 끝나면 휴가와 대련을 하고, 그 다음에 같이 이세를 찾아가서 마시자고! 물론 너와 스루가 도 함께야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/feeling4.ogg"},"사랑":{"voiceline":"지키고 싶은 것이 생기면 자연스럽게 강해지게 돼. 지금 나에게는 모항의 동료들과 네가 있으니 자연스럽게 강해질 수 있지. 하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"모항에 주둔하는 것보다 전장에서 화려하게 싸우는 게 훨씬 이목이 집중되지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/home.ogg"},"hp 경고":{"voiceline":"하, 잔재주를 부리다니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/hp_warning.ogg"},"로그인":{"voiceline":"드디어 왔구나? 내 대포가 쓸쓸해서 죽는 줄 알았다고. 워밍 업을 시켜줄 때야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/login.ogg"},"실패":{"voiceline":"윽… 화력 부족인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/lose.ogg"},"우편":{"voiceline":"우편이다… 누가 도전장이라도 보낸 걸까? 좋아, 받아주지! ……에이, 아니었잖아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/mail.ogg"},"임무":{"voiceline":"새로운 임무? 해역에 나타난 적들을 해치워야 하는 거라면 나에게 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/mission.ogg"},"임무완료":{"voiceline":"깔끔하게 임무 완료군. 좋았어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/mission_complete.ogg"},"서약":{"voiceline":"동료 사이에는 원래 격의 없이 지낸다… 라고 했잖아. 그러니까 이런 건 필요 없는데…… 그게 아니야? 내가 이런 말을 잘 못하는 건 너도 알거야… 그래. 모처럼의 마음이니 받아줄게! 걱정 마. 과거에도, 지금도, 그리고 미래에도 너를 지켜주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/propose.ogg"},"스킬":{"voiceline":"자! 신나게 놀아보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/skill.ogg"},"터치1":{"voiceline":"뭔가 곤란한 일이라도 있어? 사양하지 말고 말 해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/touch.ogg"},"터치2":{"voiceline":"서로의 감정을 발전시키기 위한 밀접 접촉인가… 괜찮네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/touch2.ogg"},"입수시":{"voiceline":"전함 키이 등장! 여기서는 아무렇지 않게 권법을 사용해도 된다며? 흐흥, 좋았어! 앞으로의 날들이 기대되는걸. 너도 내 활약을 맘껏 기대하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/unlock.ogg"},"강화성공":{"voiceline":"좋아. 실전에서 바로 강화의 결과를 확인해 보자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아! 화끈한 전투였어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/win_mvp.ogg"},"전투개시_ex":{"voiceline":"좋아, 진지하게 승부해볼까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"일찍 왔구나. 오늘은 어디로 출격할지 정했어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305120/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"좋아, 거기까지! 몸이 닿는 것은 상관 없지만 너무 노골적이잖아.","voicelink":"https://raw.githubusercontent.com/