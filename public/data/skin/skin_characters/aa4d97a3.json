[{"클뜯 id":403140,"클뜯 함순이 id":40314,"함순이 이름":"프리드리히 카를","한글 함순이 + 스킨 이름":"프리드리히 카를","영문 함순이 + 스킨 이름":"Friedrich Carl","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403140/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403140/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403140/shipyard.png","설명":"P급 장갑함 - 프리드리히 카를","자기소개":{"voiceline":"메탈 블러드의 프리드리히 카를이란다. 그것 말고는…… 어머머, 그런 거 하나하나 신경 쓰지 않는 편이 좋을걸~ 우리 지휘관한테는 세상을 \"사랑\"으로 채운다는 위대한 임무가 기다리고 있잖니~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/profile.ogg"},"메인1":{"voiceline":"어제는 잘 잤니? 후후, 푹 잔 것 같네~ 그럼, 나랑 같이 동료들에게 \"사랑\"을 전파하러 나갈까~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/main1.ogg"},"메인2":{"voiceline":"아아~ \"사랑\"과 음악은 정말 너무 멋져~ 자애, 우애, 인애, 총애를 음악에 실어 온 세상에 퍼뜨리고 싶어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/main2.ogg"},"메인3":{"voiceline":"내게 큰 감동을 준… 그 가슴속에서부터 전해오는 눈부신 \"사랑\"… 나도 모르게 우리 지휘관이랑 정열적인 사랑의 노래를 작곡하고 싶어졌지 뭐야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/main3.ogg"},"전투개시":{"voiceline":"\"사랑\"의 징벌을 내릴 시간이야~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/battle.ogg"},"상세확인":{"voiceline":"나와 지휘관을 만나게 해준 것도 \"사랑\"이고, 나와 지휘관을 뗄레야 뗄 수 없는 운명으로 이어주고 있는 것도 \"사랑\"이란다~ 후후후♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/detail.ogg"},"드랍 설명":{"voiceline":"P급 장갑함 - 프리드리히 카를","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀? \"사랑\"으로 가득한 항로에서 돌아온 모양이구나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/expedition.ogg"},"실망":{"voiceline":"어머머, 말 안 듣는 나쁜 애였구나, 우리 지휘관~? ……뭐, 이렇게 되는 것도 어쩔 수 없지 뭐~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/feeling1.ogg"},"낯섦":{"voiceline":"후후후, 방금 얼굴… 굉장히 응석 부리고 싶은 느낌이던데~ 안 그러니, 우리 지휘관? 괜찮아, 그대로 내 가슴으로 뛰어들렴. 항상 내 \"사랑\"이 받아줄 거란다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/feeling2.ogg"},"호감":{"voiceline":"같이 있으면 나도 가끔 \"사랑\"을 요구하게 되네~ 후후후… 우리 지휘관~ 이런 날 도와줄 수 있니?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/feeling3.ogg"},"기쁨":{"voiceline":"우리 지휘관의 사랑은 잘 받았어~ 그렇지만 날 사랑하다가 자기 자신을 사랑하는 걸 잊어버리지 않도록 조심하렴~ 뭐, 잊어버려도 괜찮아. 그때는 내가 더 사랑해 줄 거니까♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/feeling4.ogg"},"사랑":{"voiceline":"우리 지휘관~ 내 몸에 넘치는 \"사랑\"을 더는 억누를 수 없을 것 같아~ 후후, 더 많이 \"사랑\"을 만들어 가자구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/feeling5.ogg"},"터치3":{"voiceline":"후후후, 우리 지휘관도 참~ 이런 건 내가 해줘야 하는 거잖니?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와, 우리 지휘관~ 후후, \"사랑\"을 퍼뜨리려고 힘쓰는 모습을 보니 나… 너무 기뻐서 온몸이 떨려~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/home.ogg"},"hp 경고":{"voiceline":"화가 나는구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/hp_warning.ogg"},"로그인":{"voiceline":"준비는 다 됐니, 우리 지휘관~? 뭐냐니… 후후후, 내 \"사랑\"의 목소리에 귀를 기울이는 거지, 뭐겠니?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403140/login.ogg"},"실패":{"voiceline":"어머머…… 조금 머리를 식히는 편이 좋으려나~","voicelink":"http