[{"클뜯 id":9701050,"클뜯 함순이 id":970105,"함순이 이름":"뱀파이어·META","한글 함순이 + 스킨 이름":"뱀파이어·META","영문 함순이 + 스킨 이름":"Vampire META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701050/shipyard.png","설명":"어두운 밤의 사자, 귀여운 뱀파이어가 그대를 찾아왔어. 에헤헤, 향긋한 냄새♪ 역시 뱀파이어의 꿈에 나온 사람 다워♡","자기소개":{"voiceline":"그래서 내 어떤 게 궁금해? 내 과거? 미래 계획? 후후후, 다 알려주는 것도 좋지만, 그 전에 각오는 해둬♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/profile.ogg"},"메인1":{"voiceline":"그대, 너무 열심히 하는 거 아니야? 세상 일은 대부분 어찌할 수 없는 게 많아. 뭐, 그 노력을 봐서 조금은 도와줄까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/main1.ogg"},"메인2":{"voiceline":"잔잔한 바다~ 여기서는 내 예상을 뒤엎는 풍경이 보여. 이렇게 오랫동안 독차지하다니, 어떻게 보상해 줄 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/main2.ogg"},"메인3":{"voiceline":"그러고 보니 내 \"색깔\"에 관심이 있는 이유는 뭐야? ……지금 입고 있어서? 뭐야~ 나도 부끄럼 정도는 탄다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/main3.ogg"},"전투개시":{"voiceline":"오호호호! 뱀파이어 앞에 나타나다니, 배짱이 두둑한걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/battle.ogg"},"상세확인":{"voiceline":"이거… 날 러브레터를 주면 얼굴을 붉히면서 두근거리는 애라고 생각한 거지? …후후, 정답! 뱀파이어는 딱 그런 타입이야! 러브레터, 잘 받았어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/detail.ogg"},"드랍 설명":{"voiceline":"V급 구축함 선도형 뱀파이어<color=#92fc63>(1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"그대가 보낸 의뢰팀이 돌아왔어. 어서 마중 갔다 와~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/expedition.ogg"},"실망":{"voiceline":"진짜 바보야…… 정말 이대로도 괜찮을 것 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/feeling1.ogg"},"낯섦":{"voiceline":"그만 좀 물어봐! 검은색이라고…… 뭐가 검은색이냐고? 그, 그건…… 그렇게 기대하는 얼굴로 보지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/feeling2.ogg"},"호감":{"voiceline":"책장…… 베개 밑… 침대 아래…… 응? 아무것도 없어……? 그대, 혹시 너무 외로워서 이상해진 건…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/feeling3.ogg"},"기쁨":{"voiceline":"내가 오랫동안 숙성시킨 와인이야. 이렇게 아름다운 달이 뜬 밤이라면 열어도 괜찮겠지. 자~ 딱딱하게 굴지 말고 어서 앉아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/feeling4.ogg"},"사랑":{"voiceline":"아름다운 달밤에 그대와 와인을 음미하고 있자니, 그만…… 크흠! 하마터면 말실수를 할뻔했어! 나 취했으니까 어서 숙소까지 데려다줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/feeling5.ogg"},"터치3":{"voiceline":"응응, 애 취급받는 것도 나쁘지 않네~ 아하하, 나도 모르게 입 밖으로 말해버렸어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/headtouch.ogg"},"모항귀환":{"voiceline":"후후후, 역시 득의양양한 모습이네. 흐음, 이번에는 또 어떤 \"역사적인 승리\"를 거두고 온 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/home.ogg"},"hp 경고":{"voiceline":"윽, 난감한데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침~ 응? 뱀파이어도 일찍 일어나냐고? 후후후, 그건 그대가 보고 싶어서♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/login.ogg"},"실패":{"voiceline":"다들 무사한 것 같네. …이런 상황에서 자존심은 그렇게 중요한 게 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/lose.ogg"},"우편":{"voiceline":"그대 앞으로 온 우편이야! 참고로 뱀파이어의 러브레터도 섞여 있어. 이 중에 어떤 건지 맞춰봐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/mail.ogg"},"임무":{"voiceline":"임무~? 후훗, 알고 있어. 어서 다녀와♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/mission.ogg"},"임무완료":{"voiceline":"임무 완료? 이젠 뭐 할 거야? 내가 같이 있어줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/mission_complete.ogg"},"서약":{"voiceline":"으음…… 흐암… 이런 상황에서 영원히 함께하자는 약속을 하다니, 그대도 참 엉성한 사람이네…… 그럼, 뱀파이어의 이름으로 영원한 축복을 내려줄게…… 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/propose.ogg"},"스킬":{"voiceline":"내 실력에… 굴복해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/skill.ogg"},"터치1":{"voiceline":"후후후, 하고 싶은 거… 더 있잖아? 그대가 무슨 생각을 하는지는 훤히 다 보여.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/touch.ogg"},"터치2":{"voiceline":"꺅! 변태! 색골! 로리콘! ――후후, 이런 말을 듣고 싶었던 거 맞지~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/touch2.ogg"},"입수시":{"voiceline":"어두운 밤의 사자, 귀여운 뱀파이어가 그대를 찾아왔어. 에헤헤, 향긋한 냄새♪ 역시 뱀파이어의 꿈에 나온 사람 다워♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/unlock.ogg"},"강화성공":{"voiceline":"……하나도 안 커진 것 같다고? 이럴 땐 \"장래가 촉망된다\"고 하는 거야! 이 바보!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"내게 도전하려면 천년은 더 단련하고 와♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"h