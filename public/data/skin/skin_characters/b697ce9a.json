[{"클뜯 id":307140,"클뜯 함순이 id":30714,"함순이 이름":"꼬마 시나노","한글 함순이 + 스킨 이름":"꼬마 시나노","영문 함순이 + 스킨 이름":"Shinano-chan","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307140/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307140/shipyard.png","설명":"야마토급 3번함 - 시나노","자기소개":{"voiceline":"……음, 나는 \"시나노\"… 그것 외엔 마음에 둘 거 없다. 어차피 세상일은 변덕스러우니… 나중 일은 나중으로 미루고, 지금은 그저 느긋하게 꿈나라에 머물 수만 있다면 좋겠군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/profile.ogg"},"메인1":{"voiceline":"…최고의 잠자리는 역시 그대의 집무실이로군. 좋아, 얼마간은 이곳을 내 쉼터로 삼아야겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/main1.ogg"},"메인2":{"voiceline":"꿈나라를 같이 즐긴다고? 좋군…… 응? 그대, 어떻게 내 꿈에…… 설마……! 너, 너무도 부끄럽군…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/main2.ogg"},"메인3":{"voiceline":"잠을 이루기 어렵군…… 그대, 책무를 다하는 건 좋지만, 종이 넘기는 소리가 너무도 잦아…! 잠깐 함께 쉬는 게 어떤가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/main3.ogg"},"전투개시":{"voiceline":"전진하라. 그대들을 믿고 있다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/battle.ogg"},"상세확인":{"voiceline":"……? 내 베개에 관심이 있는 건가…? 좋아. 하지만 사실 이건 베개가 아니라 함장이다…… 왜 그렇게 놀란 표정을…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/detail.ogg"},"드랍 설명":{"voiceline":"야마토급 3번함 – 시나노","voicelink":null},"의뢰 완료":{"voiceline":"흐아암…… 의뢰팀 아이들이 벌써 돌아왔군…… 으음… 얼굴을 좀 씻고 오지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/expedition.ogg"},"실망":{"voiceline":"그대에게 제대로 교육을 할 필요가 있겠군……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/feeling1.ogg"},"낯섦":{"voiceline":"응? 그대도 여기…… 낮잠 자러? 고민거리를 생각할 장소를 찾던 것뿐이라고? 음…… 그럼 나는 먼저 좀 자도록 하지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/feeling2.ogg"},"호감":{"voiceline":"으… 신경 쓰여서 잠이 안 오는군…… 그대를 고민에 빠지게 한 건 무엇이지? 운명? 윽, 복잡한 주제로군… 어쨌든 나는 안 믿어…… 그래, 아마도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/feeling3.ogg"},"기쁨":{"voiceline":"저기, 그, 그대 곁에서 꿈나라로 떠나도 괜찮은가…? 요즘 들어 악몽을 자주 꿔서 말이지…… 우, 웃을 것까지는 없잖은가? 이게 다 그대가 운명이니 뭐니 한 탓이다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/feeling4.ogg"},"사랑":{"voiceline":"그대가 함께라면 마음이 놓이는군…… 악몽도 이제는 두렵지 않아… 좋아, 꿈을 계속 꿔야겠어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/feeling5.ogg"},"터치3":{"voiceline":"음~ 흠흠흠흠~ …귀, 귀는 가벼이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/headtouch.ogg"},"모항귀환":{"voiceline":"쿨쿨…… 후후후… 과일 사탕, 치즈, 참외…… 음? 아, 그대… 돌아왔군… 쿨쿨…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/home.ogg"},"hp 경고":{"voiceline":"으윽! ……나, 나는 지지 않는다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/hp_warning.ogg"},"로그인":{"voiceline":"흐암… 평안하신가…… 보다시피 나는 한낮 단잠에 걸맞은 최고의 침소를 찾고 있지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/login.ogg"},"실패":{"voiceline":"패, 패배한 건가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/lose.ogg"},"우편":{"voiceline":"그대 앞으로 온 우편이다. 먼 곳에서 온 글이니 분명 중요한 내용일 테지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/mail.ogg"},"임무":{"voiceline":"쿨쿨…… 꿈인데…… 왜 임무가…… 아! 새로운 임무…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/mission.ogg"},"임무완료":{"voiceline":"흐아아암…… 이, 임무를 완수했다……! 뒷정리 잘 부탁하마…… 쿨쿨…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/mission_complete.ogg"},"서약":{"voiceline":"이건… 나와 약속을 나눈 증명…… 그렇다면 나도 최선을 다해야겠지… 장차 꼭 이뤄지기를 소망하는 단꿈을… 함께 꾸자꾸나♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/propose.ogg"},"스킬":{"voiceline":"그대들을 기다리는 것은 오로지 악몽뿐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/skill.ogg"},"터치1":{"voiceline":"쿨쿨…… 후후… 가, 간지럽히지 마라…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/touch.ogg"},"터치2":{"voiceline":"서, 설교할 시간이군! 거기 앉아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/touch2.ogg"},"입수시":{"voiceline":"그대는… 내 꿈에 나오는 자로군. 음… 좋아… 안심이 되는 자라 마음이 놓여…… 하지만 그대… 내 인도가 필요한 것 같은데…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/unlock.ogg"},"강화성공":{"voiceline":"흠, 갑자기 의욕이 솟는군… 하지만 행여나 잠 못 이루는 밤이 될까 두려워… 골치가 아파…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"쉽군…… 흐아아암… 자러 가야겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"후후후, 지휘관… 그대도 같이 낮잠을 즐기는 건 어떤가…? 재미있는 꿈이 떠올라서 말이지… 꼭 그대도 봤으면 하는군♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"쿨쿨…… 아, 돌아왔군… 간식에 디저트, 차도 다 있으니… 느긋하게 쉬자꾸나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"흐암…… 평안하신가…… 그대의 집무실 소파, 또 빌리도록 하지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"……응? 같이 꿈나라로 떠나볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/touch_ex.ogg"},"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['꼬마 아마기'] :  수면은 충분히 취하는 것이 바람직하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"꿈을 만들 수 있다면…… 그대와 나만이 즐길 수 있는 유흥의 장을 만들면…… 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"그대, 가까이…… (꼬옥) 음, 그대 가슴속에 한번 누워보고 싶다고 생각하고 있었지. 그래, 따뜻한 포옹…… 내 잠자리로 제격이군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307140/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":1}]