[{"클뜯 id":11100020,"클뜯 함순이 id":1110002,"함순이 이름":"나나 아스타 데빌룩","한글 함순이 + 스킨 이름":"나나 아스타 데빌룩","영문 함순이 + 스킨 이름":"Nana Astar Deviluke","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100020/shipyard.png","설명":"흐음… 네가 지휘관이야? 나는 나나, 언니의 여동생이야. 이 모항이라는 곳… 꽤 번화한 것 같네… 앞으로 잘 부탁해.","자기소개":{"voiceline":"응? 아, 나는 모모처럼 라라 언니의 여동생이야. 데빌룩 성(星)에서 왔어. 동물이랑 대화도 할 수 있어! 그리고 이상한 짓 하면 가만히 안 둔다!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/profile.ogg"},"메인1":{"voiceline":"모항은 분위기가 뭔가 쓸쓸하네… 귀여운 동물이 많으면 더 즐거워질 텐데! 여기 동물들이랑도 만나보고 싶네~ 아, 지금 바로 동물원으로 데려다주라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/main1.ogg"},"메인2":{"voiceline":"야, 지휘관. 왜 그렇게 힐끔힐끔 봐…? 설마… 컸으면 좋겠다던가 그런 생각하는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/main2.ogg"},"메인3":{"voiceline":"지휘관은 내 앞에서 항상 얌전하더라. 뭔가 수상한데…? 역시 더 철저하게 지켜봐야겠어. 따, 딱히 관심이 있어서 그러는 건 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/main3.ogg"},"전투개시":{"voiceline":"내가 곁에 있으니까 안심하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/battle.ogg"},"상세확인":{"voiceline":"모항 사람들은 다들 널 좋아하던데, 그렇다고 잘난 척하지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/detail.ogg"},"드랍 설명":{"voiceline":"흐음… 네가 지휘관이야? 나는 나나, 언니의 여동생이야. 이 모항이라는 곳… 꽤 번화한 것 같네… 앞으로 잘 부탁해.","voicelink":null},"의뢰 완료":{"voiceline":"수고했어! 다음에는 내가 도와줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/expedition.ogg"},"실망":{"voiceline":"지휘관… 그런 녀석이었구나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/feeling1.ogg"},"낯섦":{"voiceline":"지휘관… 좀 미덥지 않은데… 역시 잘 지켜보고 있어야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/feeling2.ogg"},"호감":{"voiceline":"모항 테니스 코트도 꽤 괜찮네. 다음에 같이 테니스 칠까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/feeling3.ogg"},"기쁨":{"voiceline":"나, 납작해도 괜찮다니… 무슨 말이야! 물어본 것도 아닌데 뭘 혼자 멋대로 지껄여! 이 변태!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 동물원에 같이 와줘서 고마워… 귀여운 동물들이랑 같이 있으면 마음이 편안해져. 오늘은 정말 즐거웠어! 고마워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/feeling5.ogg"},"터치3":{"voiceline":"응? 무슨 일이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와. 그나저나 선물로 과자는 챙겨왔지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/home.ogg"},"hp 경고":{"voiceline":"화, 화낸다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/hp_warning.ogg"},"로그인":{"voiceline":"어서 와! 오늘은 산책이나 운동하러 가자. 몸을 움직이면 건강에 좋거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/login.ogg"},"실패":{"voiceline":"야! 이게 어떻게 된 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔어. 내가 대신 확인해 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/mail.ogg"},"임무":{"voiceline":"이렇게 농땡이 피워도 돼? 아직 임무가 남았잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/mission.ogg"},"임무완료":{"voiceline":"임무 보상은 뭐야? 왠지 게임인 것 같은데. 궁금해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/mission_complete.ogg"},"서약":{"voiceline":"지휘관은 믿음직스러운 사람이라고 인정해 줄게. 앞으로도 잘 부탁해! 뭐? 뭐? 조, 좋아한다고 말한 건 아니야! 착각하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/propose.ogg"},"스킬":{"voiceline":"먹어라!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/skill.ogg"},"터치1":{"voiceline":"흡…! 피했다…! 날 얕잡아보지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/touch.ogg"},"터치2":{"voiceline":"그만하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/touch2.ogg"},"입수시":{"voiceline":"흐음… 네가 지휘관이야? 나는 나나, 언니의 여동생이야. 이 모항이라는 곳… 꽤 번화한 것 같네… 앞으로 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/unlock.ogg"},"강화성공":{"voiceline":"대단하네!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"헤헤! 나한테 고마워하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"친해졌다고 모항에서 마음대로 굴 생각은 마! 미덥지 않은 건 여전하니까, 앞으로도 계속 지켜봐 주겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"「기동력이 뛰어난 체형」? 그게 뭐야? 설마 내 가슴 말하는 거야…?! 그걸 누가 칭찬으로 받아들여!! 그렇지만… 정말 칭찬해 주려던 거면, 다음부터는 좀 더 생각하고 말해줬으면 좋겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"누, 누가 애인줄 알아…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"항상 바쁜 것 같아서 오늘은 내가 대신 간식을 사가지고 왔어. 같이 먹자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 와! 오늘도 같이 열심히 해보자~♪ 윽… 역시 좀 부끄럽네… 평소대로 할게. 지휘관, 그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"아직 임무 덜 끝났어? 어쩔 수 없지. 내가 도와줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"가, 간지러워! 그만해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/touch_ex.ogg"},"터치2_ex":{"voiceline":"이, 이 짐승!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['라라 사타린 데빌룩', '모모 베리아 데빌룩'] : 응, 다들 함께면 쉽게 이길 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/couple_encourage1.ogg"},{"voiceline":"['금빛 어둠'] : 내 실력을 보여주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/couple_encourage2.ogg"},{"voiceline":"['코테가와 유이'] : 같이 열심히 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/couple_encourage3.ogg"}],"메인4":{"voiceline":"모항에도 헤엄을 잘 치는 애들이 많네… 특히 이25라는 애는 귀가 동물 같아서 귀여워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"오, 지휘관. 왔구나. 응? 나나의 애완동물이 계속 쫓아온다고…? 그, 그건 네가 이상한 짓을 하지는 않나 감시하기 위한 거지, 딱히 네게 관심이 있어서 붙여둔 건 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관, 착해 보인다고 모모가 말하는 대로 하면 큰일 나. 번거로운 일은 굳이 만들지 않았으면 해서 일러두는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/main6_ex.ogg"},"메인7_ex":{"voiceline":"아아… 지휘관이랑 같이 과자 먹고 싶네~ 뭐?! 사준다고?! 신난다~~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/main7_ex.ogg"},"메인8_ex":{"voiceline":"지휘관! 벨파스트가 다과회에 초대해 줬어~ 로열 네이비의 다과회는 엄청 호화롭다던데... 에헤헤, 언니랑 모모도 불러서 다 같이 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100020/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":111,"레어도":"SSR","ex_chat_status":1},{"클뜯 id":11100021,"클뜯 함순이 id":1110002,"함순이 이름":"나나 아스타 데빌룩","한글 함순이 + 스킨 이름":"게임 타임!","영문 함순이 + 스킨 이름":"High Roller","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100021/shipyard.png","설명":"지휘관, 왔네. 마침 다 같이 게임하려던 참이었는데, 오늘은 운이 좋네! 너도 같이할래?","자기소개":null,"메인1":{"voiceline":"뭐, 운도 실력이라고 하잖아? 나한테 이런 게임에서 이기는 것쯤은 식은 죽 먹기지. 지휘관, 슬슬 패배를 인정하는 게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100021/main1.ogg"},"메인2":{"voiceline":"에헤헤, 또 내가 이겼다! 지휘관, 약속한 대로 