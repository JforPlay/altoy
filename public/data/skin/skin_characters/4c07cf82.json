[{"클뜯 id":403110,"클뜯 함순이 id":40311,"함순이 이름":"요르크","한글 함순이 + 스킨 이름":"요르크","영문 함순이 + 스킨 이름":"Yorck","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403110/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403110/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403110/shipyard.png","설명":"론급 장갑순양함—요르크","자기소개":{"voiceline":"메탈 블러드 소속인 순양함 요르크야. 거의 아무것도 해본 게 없는 나지만, 당신에게 해줄 수 있는 거라면 얼마든지 있어. 내 힘을 기쁘게 받아들일지는 당신 손에 달렸어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/profile.ogg"},"메인1":{"voiceline":"슈피, 친구가 필요하다면 내가 친구 해줄게. 앞으로 사이좋게 지내자구, 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/main1.ogg"},"메인2":{"voiceline":"섬길 수만 있다면, 누구든 상관없어. 당신도 괜찮고, 엠덴도 괜찮고…. 하지만 나를 복종시킬 수 있는 존재는 그리 많지 않거든?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/main2.ogg"},"메인3":{"voiceline":"지휘관이 한가해 보이는 건 기쁜 일이지. 내가 해준 게 많으면 많을수록, 당신이 편해지는 거… 참 이상적인 관계인 것 같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/main3.ogg"},"전투개시":{"voiceline":"지휘봉을 잡을 시간이야, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/battle.ogg"},"상세확인":{"voiceline":"나를 부하로… 당신의 힘을 행사하는 도구로 다뤄도 상관없어. 후후후, 잘 부탁해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/detail.ogg"},"드랍 설명":{"voiceline":"론급 장갑순양함—요르크","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠났던 애들이 돌아온 것 같네. 괜찮은 지휘였어, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/expedition.ogg"},"실망":{"voiceline":"후후후, 설령 당신이 아무것도 못 하는 비참한 무능력자라고 해도, 내게는 다루기 편한 아이일 뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/feeling1.ogg"},"낯섦":{"voiceline":"해줬으면 하는 게 있으면, 뭐든 말해줄래? 나도 해줄 수 있는 거, 여러 가지 제안해 줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/feeling2.ogg"},"호감":{"voiceline":"당신만이 할 수 있는 것도 있으니까, 내게 너무 의지하는 건 바람직하지 않아. 하지만, 글쎄…. 내 꼭두각시 인형이 되더라도, 나는 딱히 난처하진 않을 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/feeling3.ogg"},"기쁨":{"voiceline":"역시 당신에게는 사람을 끄는 카리스마가 있는 것 같아. 이래야 당신에게 충성을 다하는 보람이… 아니, 사랑하는 보람이 있지. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/feeling4.ogg"},"사랑":{"voiceline":"당신, 슬슬 다음 목적지를 정할 때 아니야? 지휘관이라는 자가 함선 하나 리드 못해서야 쓰겠어? 아니면 평소처럼 내가 몇 가지 대신 골라주는 게 나아? …어, 어느 쪽이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어. 방금 그 작전, 다음에 나랑 같이 갈 때 다시 한번 보여줬으면 좋겠는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/home.ogg"},"hp 경고":{"voiceline":"뒤를 치는 건 내 특기일지도 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/hp_warning.ogg"},"로그인":{"voiceline":"먼저 와 있다니, 황송하네. 후후후, 오늘도 그런 수완을 보여준다면 참 기쁘겠는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/login.ogg"},"실패":{"voiceline":"어쩔 수 없어…. 용기가 부족했어….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/lose.ogg"},"우편":{"voiceline":"우편이 온 것 같네. 내가 할 수 있는 건 당신에게 이걸 건네는 것까지야. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/mail.ogg"},"임무":{"voiceline":"개인적으로 임무 중 일부는 방치해도 괜찮을 것 같지만, 지휘관은 어떻게 할 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/mission.ogg"},"임무완료":{"voiceline":"임무 보상은 모으고 모아서 한 번에 손에 넣는 편이 더 짜릿한 것 같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/mission_complete.ogg"},"서약":{"voiceline":"식 절차에 초대까지 내게 맡겼다는 건, 앞으로는 내 색깔로 물들 준비가 되었다는 거겠지? 자, 말해봐. '요르크와 영원한 맹세를 나누겠다'고. 당신의 의사와 결의, 어서 들려줘♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/propose.ogg"},"스킬":{"voiceline":"새겨 넣어 줄게, 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/skill.ogg"},"터치1":{"voiceline":"응? 고민 상담? 아니면 명령이려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/touch.ogg"},"터치2":{"voiceline":"아하…. 이런 것도 해줬으면 하는 거구나♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/touch2.ogg"},"입수시":{"voiceline":"순양함 요르크야. 오늘부터 신세 좀 질게. 당신의 지휘를 지켜보고, 당신이 해야 하는 모든 것에 내 의지와 욕망을 섞어 하나로 만드는 거… 근사하지 않아? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/unlock.ogg"},"강화성공":{"voiceline":"잘도… 이런 걸 해줬네. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"자, 다음은 어떡할래? 전진할래? 아니면 이대로 돌아갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"용건을 말하기 전에 하나 대답해줄래? 당신이 지금 찾는 건 부하인 요르크인지, 아니면 당신과 서약을 나눈 여자인지 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403110/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"끈질기게, 그리고 공세를 취할 때에는 늘 과감하게…. 그렇구나, 당신 작전은 언제나 배울 게 많아.","voicelink":"https://raw.githubusercontent.com/Fernando2603