[{"클뜯 id":202030,"클뜯 함순이 id":20203,"함순이 이름":"에이잭스","한글 함순이 + 스킨 이름":"에이잭스","영문 함순이 + 스킨 이름":"Ajax","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202030/shipyard.png","설명":"리엔더급 경순양함·에이잭스 (HMS Ajax)","자기소개":{"voiceline":"리엔더급 경순양함 에이잭스입니다. 지휘관, 라플라타강에 가보신 적 있으세요? 그곳엔 제 근사한 기억이 있어요. 후후훗……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/profile.ogg"},"메인1":{"voiceline":"식사 부터? 아니면 목욕? 아니면… 우후훗","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/main1.ogg"},"메인2":{"voiceline":"비밀을 알려드릴게요… 귀 좀 빌려줘요… 후우~! 간지럽다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/main2.ogg"},"메인3":{"voiceline":"지휘관이 멍청하게 있는 모습을 보고 있으면, 얼굴을 짓밟아버리고 싶어서 참을 수 없게 됐어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/main3.ogg"},"전투개시":{"voiceline":"어머머~ 어서 무릎꿇고 빌면 적당히 끝내주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/battle.ogg"},"상세확인":{"voiceline":"지휘관, 제 비밀을 더 알고 싶으세요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/detail.ogg"},"드랍 설명":{"voiceline":"리엔더급 경순양함·에이잭스 (HMS Ajax)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 5초를 셀테니 다 세기 전까지 의뢰팀 자매들을 마중나가지 않으면… 우후훗……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/expedition.ogg"},"실망":{"voiceline":"망가져 버렸나…… 됐어, 새로운 장난감이라도 찾아볼까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/feeling1.ogg"},"낯섦":{"voiceline":"좋은 눈매네…… 좋아, 그럼 당신, 제 새로운 아기돼지가 되세요. 거부권 같은 건 없다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/feeling2.ogg"},"호감":{"voiceline":"후후훗, 점점 좋아지기 시작했어. 어디까지 즐겁게 해주려나. 귀여운 아기돼지야~♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/feeling3.ogg"},"기쁨":{"voiceline":"걱정하지 마, 내가 이렇게까지 괴롭히고 싶은 건 당신뿐이에요. 그래요, 에이잭스의 운명의 상대 같아~ 기쁘죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/feeling4.ogg"},"사랑":{"voiceline":"전 나쁜 애가 아니라고요. 그저, 당신을 만나기 전까진 진심이었던 적이 없었을 뿐.  이제 이렇게까지 말해줬으니, 마지막까지 함께 해 주겠지? 아·기·돼·지·님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"후후, 운동을 끝낸 아기돼지들, 보기만 해도 맛있어 보이네요. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"후훗, 오늘도 잘 부탁할게요, 지─휘─관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/login.ogg"},"실패":{"voiceline":"칫…다음엔 따끔한 맛을 보여주지","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/lose.ogg"},"우편":{"voiceline":"우편. 내용? 알려주실 거죠? 지·휘·관","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/mail.ogg"},"임무":{"voiceline":"미션을 완료하면, 특별히 보너스를 드릴게요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/mission.ogg"},"임무완료":{"voiceline":"보너스라 하면 미션 보너스인 게 당연하잖아요? 어머, 그게 아니면, 특별한 뭔가를 기대한 거에요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/mission_complete.ogg"},"서약":{"voiceline":"이건…… 새로운 「메뉴」를 준비해야겠네. 기대하렴, 사랑스런 아·기·돼·지·야♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/propose.ogg"},"스킬":{"voiceline":"후후훗, 귀여운 아기돼지들……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/skill.ogg"},"터치1":{"voiceline":"좋아요, 절 기분 좋게 해준다면 '그걸' 시켜드릴 수도 있어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/touch.ogg"},"터치2":{"voiceline":"그런 곳을 만지는 변태는, 있는 힘껏 밟아드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/touch2.ogg"},"입수시":{"voiceline":"지휘관, 난 리엔더급 경순 3번함, 에이잭스. 이래뵈도 꽤 유명해요… 지휘관, 내 옷장을 보면 분명 놀랄걸? 봐 볼래요? 후훗…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/unlock.ogg"},"강화성공":{"voiceline":"후훗~ 이 다음에 감사해·줄·게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관, 수고하셨어요. 정말 수고하셨네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/win_mvp.ogg"},"전투개시_ex":{"voiceline":"후후훗, 제가 제대로 밟아드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/battle_ex.ogg"},"상세확인_ex":{"voiceline":"오늘 \"아기돼지에 대한 따뜻한 사랑\" 놀이를 해보는 건 어때요? 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰조 자매들을 맞이하러 갈건가요? 제가 같이 가죠. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"수고했어요. 수리와 보급 일정은 모두 정리해뒀어요. 아기돼지는 우선 좀 쉬세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"후후훗, 오늘도 잘 부탁해요, 사랑스러운 아기돼지♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/login_ex.ogg"},"실패_ex":{"voiceline":"이런... 아기돼지에게 이런 창피한 모습을 보이면 안되는데...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/lose_ex.ogg"},"우편_ex":{"voiceline":"편지에요. 내용은... 후훗, 전 아기돼지를 믿습니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/mail_ex.ogg"},"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"아기돼지에게 상을 줘야겠군요. 후후훗, 어떤 상을 원하시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['리엔더', '아킬레스'] : 적을 힘으로만 해결하려고 하지 말고 계략을 써보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/couple_encourage1.ogg"},{"voiceline":"['차파예프', '아카기'] : 아기돼지를 유괴하는 것은 저의 취미가 아니랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/couple_encourage2.ogg"},{"voiceline":"['아드미랄 그라프 슈피'] : 즐겁게 살아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/couple_encourage3.ogg"},{"voiceline":"['포미더블'] : 좋은 취미네요. 포미더블 씨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/couple_encourage4.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"아기돼지를 위해서 업무가 끝나기 전에는 \"바꾸지 않겠어요\". 하하하, 무슨 뜻인지 아시겠죠...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"이 멍청한 얼굴은 아무리 봐도 질리지가 않는군요. 후후훗, 귀여운 아기돼지♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/main2_ex.ogg"},"메인3_ex":{"voiceline":"설마 리엔더에게도 그런 쪽에 소질이 있었다니... 아니, 그 아이는 넵튠과 다른데. 소위 \"교육\"이라 불리는 것조차도 무슨 뜻인지 전혀 모를텐데...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202030/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null