[{"클뜯 id":401350,"클뜯 함순이 id":40135,"함순이 이름":"Z35","한글 함순이 + 스킨 이름":"Z35","영문 함순이 + 스킨 이름":"Z35","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401350/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401350/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401350/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401350/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401350/shipyard.png","설명":"1936년 B형 구축함 – Z35","자기소개":{"voiceline":"1936년 B형, Z35라 불리는 기함은 바로 나란 말씀. 뭐 동급함은 나도 포함해서 세 척 밖에 없지만 말야. …발트해에 배치된 뒤 포격임무와 기뢰부설임무를 맡았다가, 마지막엔 제크와 함께 아군 기뢰원에 접촉해서…그래 그래, 밑에 있는 이거 말야! …근데, 왜 여기 있는 거야……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/profile.ogg"},"메인1":{"voiceline":"지휘관, 봐봐~ 토깽이! 에헤헤, 귀엽지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/main1.ogg"},"메인2":{"voiceline":"저번에 렉싱턴 자매의 Konzert를 보러 갔는데, 역시 프로는 대단하더라~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/main2.ogg"},"메인3":{"voiceline":"지휘관은 어떤 라이브가 좋아? 알려주면 다음에 공부해둘게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/main3.ogg"},"전투개시":{"voiceline":"모두 힘내~! 우린 최고라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/battle.ogg"},"상세확인":{"voiceline":"어라, 지휘관, 왜 내 방에……? 에에?! 내가 방을 잘못 들어간 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/detail.ogg"},"드랍 설명":{"voiceline":"1936년 B형 구축함 - Z35","voicelink":null},"의뢰 완료":{"voiceline":"임시 뉴스를 전달해 드리겠습니다아……의뢰 끝났다구, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/expedition.ogg"},"실망":{"voiceline":"내가 기대한 지휘관과는 다르네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/feeling1.ogg"},"낯섦":{"voiceline":"메탈 블러드에서 멋있기로는 레베, 섹시하기론 오이겐, 그치만 아이돌스럽기론 춤추고 노래하는 이 퓐 님이 최고지~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/feeling2.ogg"},"호감":{"voiceline":"지휘관은 함대의 아이돌 처럼, 존재만으로 모두에게 희망을 줘! 나도 그런 아이돌이 되고 싶다아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, Produzent이 뭔지 알아? 그러니까, 여기 말로는 아이돌의 프로듀서를 말하는 거야! 지휘관만 괜찮다면, 퓐의 P가 되어줬으면 좋겠는데","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/feeling4.ogg"},"사랑":{"voiceline":"지휘관의 곁에 있는 퓐은, 자신의 재능을 최대한으로 발휘할 수 있고, 전투에서도 라이브에서도 최강인 퓐이라구! 그러니까 난 지휘관이 아니면 안 된다구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 피곤해? 좋~아, 퓐의 퍼포먼스를 보고 기운 내라고~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/home.ogg"},"hp 경고":{"voiceline":"모두, 조금만 더 힘내!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/hp_warning.ogg"},"로그인":{"voiceline":"Hallihallo~! 지휘관, 어제 꿈에 퓐이 나오지 않았어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/login.ogg"},"실패":{"voiceline":"단념하지 마! 기회는 아직 있으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/lose.ogg"},"우편":{"voiceline":"자, 지휘관! 우편!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/mail.ogg"},"임무":{"voiceline":"새로운 미션♪ 새로운 챌린지~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/mission.ogg"},"임무완료":{"voiceline":"역시 지휘관! 보수가 산더미야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/mission_complete.ogg"},"서약":{"voiceline":"그럼 약속해, 퓐이 진짜 아이돌이 되면, 지휘관이 P가 되어준다고. 그리고, 퓐이 누구보다 더 빛나는 스타가 될 때까지…으음, 그 뒤로도 언제나 언제나 퓐의 P로 있어줘♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/propose.ogg"},"스킬":{"voiceline":"그렇게는 안 되지~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/skill.ogg"},"터치1":{"voiceline":"지휘관, 왜? 에, 이 파일이 틀렸다고? …아, 진짜네! 데헷☆ 미안해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/touch.ogg"},"터치2":{"voiceline":"지휘관~ 나, 웃는 표정은 변하지 않았지만, 사실은 호감도가 떨어졌을지도 몰라~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/touch2.ogg"},"입수시":{"voiceline":"지휘관과 함대 여러분, 처음 뵙겠습니다~ 나는 노래하고 춤추는,「퓐」이라 불리는 Z35이야~! 잘 부탁해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 역시 센스 있다니깐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/upgrade.ogg"},"vote":null,"승리":{"voiceline":"Großartig! 좋았어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401350/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":401351,"클뜯 함순이 id":40135,"함순이 이름":"Z35","한글 함순이 + 스킨 이름":"projekt Kirschblüte","영문 함순이 + 스킨 이름":"Projekt Kirschblüte","스킨 타입":"New Yea