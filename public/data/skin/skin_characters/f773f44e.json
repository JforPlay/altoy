Lane/main/images/skin/401352/shipyard.png","설명":"\"어서 와! 사랑스러운 퓐의 주인님♡ 후후, 퓐은 주인님이 오는 걸 계속, 계~속 기다리고 있었어.\" ――에헤헷, 방금 거 잘 찍었어? 사랑스러운 주인님♪","자기소개":null,"메인1":{"voiceline":"퓐의 앨범 작업이 끝난 다음에는 제크의…… 앗, 셔터를 누른 순간 제크의 머릿속에 갑자기 존재하지 않던 기억이 흘러넘치는데…! 농담이야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401352/main1.ogg"},"메인2":{"voiceline":"제크랑 샌디에이고, 괌이랑 C클래스 동료들… 밤에는 아이돌들의 Konzert(콘서트)가 있어! 후후, 그때까지는 퓐이랑 같이 있는 거야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401352/main2.ogg"},"메인3":{"voiceline":"\"메이드인 내가 주인님과 정말 맺어질 수 있을까… 흑…\" ――자, 지휘관! 이 상황에서 주인님이 할만한 대사는 뭘 거 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401352/main3.ogg"},"전투개시":{"voiceline":"지휘관과의 추억을 위해! 에헷☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401352/battle.ogg"},"상세확인":{"voiceline":"퓐의 추억 앨범을 촬영하는 데 협력해줘서 고마워! 에헤헷, 정말 지휘관이랑 행복한 추억을 만들어버렸네… 지휘관도 좋은 추억, 잘 만들었으려나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401352/detail.ogg"},"드랍 설명":{"voiceline":"\"어서 와! 사랑스러운 퓐의 주인님♡ 후후, 퓐은 주인님이 오는 걸 계속, 계~속 기다리고 있었어.\" ――에헤헷, 방금 거 잘 찍었어? 사랑스러운 주인님♪","voicelink":null},"의뢰 완료":{"voiceline":"퓐의 리마인드 서비스! 딩동댕동♪ 의뢰팀 사람들이 돌아왔어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401352/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"오늘은 무대뿐만 아니라 가게에서 지휘관에게 특별 퍼포먼스 중인 퓐입니다~♪ 구체적으로는… 후후후, 우선은 주문부터 해줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401352/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관' 대신 가게에 있는 동안에는 계속 '주인님'이라고 불러도 돼? 콘셉트가 좀 다르다고? 음… 그야 그렇지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401352/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"\"지휘관, 방과 후에는 저기… 우리 집에서 숙제 좀 알려줬으면 하는데…\" ――그 대신 보