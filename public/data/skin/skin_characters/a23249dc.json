[{"클뜯 id":301830,"클뜯 함순이 id":30183,"함순이 이름":"나가나미","한글 함순이 + 스킨 이름":"나가나미","영문 함순이 + 스킨 이름":"Naganami","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301830/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301830/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301830/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301830/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301830/shipyard.png","설명":"유구모급 구축함 4번함—나가나미 ","자기소개":{"voiceline":"저는 유구모급 4번함 나가나미 . 주로 운송 임무를 맡았지만 큰 작전에도 참여해본 경험이 있어요. 기함으로도 활약했었답니다. 전장에서 어려움을 겪더라도 모두가 함께 힘을 모아 서로를 믿는다면 분명 좋은 결과가 있을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/profile.ogg"},"메인1":{"voiceline":"진츠 선배는 아는 것이 많아서 믿음직스러워요. 저도 그렇게 될 수 있으면 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/main1.ogg"},"메인2":{"voiceline":"지휘관님, 다음 작전에는 제가 기함을 맡아도 될까요? 지휘관님과 모두의 행복을 위해서 조금 더 노력하고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/main2.ogg"},"메인3":{"voiceline":"요즘 모두가 저에게 안기고 나면 목욕을 한 것처럼 피로가 사라진다는 말을 해요. 심지어 감기도 나았다니…?! 소문이 점점 이상해지네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/main3.ogg"},"전투개시":{"voiceline":"작전의 기함 말씀인가요? 저에게 맡겨주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/battle.ogg"},"상세확인":{"voiceline":"온 몸에서 포근한 기운을 내뿜는다고요? 에헤헤, 쑥쓰러운 평가네요. 에? 지휘관님도 그렇게 생각하신다니… 좋아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/detail.ogg"},"드랍 설명":{"voiceline":"유구모급 구축함 4번함—나가나미 ","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰를 나간 동료들이 돌아왔어요. 음… 고생한 모두를 위해 포옹을 준비해야겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/expedition.ogg"},"실망":{"voiceline":"지휘관님, 고민이 있다면 언제든 저에게 말씀하세요. 기다리고 있을게요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/feeling1.ogg"},"낯섦":{"voiceline":"무츠키급의 동료들은 모두 폭신폭신 귀여워요! 이런 모항에서 지낼 수 있다니 정말 행운이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/feeling2.ogg"},"호감":{"voiceline":"제 꼬리는 복실복실한 타입이고, 와카바의 것은 좀 더 매끄러운 느낌이죠… 그리고 하츠시모의 경우는 얇고, 시마카제의 것은 굉장히 작고요… 여러가지가 많아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/feeling3.ogg"},"기쁨":{"voiceline":"오야시오가 가르쳐준 마법이, 이렇게… 응! 이마에 원을 그리고 나면 지휘관님의 연애운도 대통, 계속 행복해진대요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/feeling4.ogg"},"사랑":{"voiceline":"아직도 덜 행복하세요? 그… 그러면 최후의 수단이 남았어요! 약간 모자란 운세는 직접 출격해서 메우는 거에요! 이렇게 행복을 직접 지휘관님께 드리는 것처럼요—— 쪽~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 수고하셨어요! 얼른 앉으세요. 어깨 주물러 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/home.ogg"},"hp 경고":{"voiceline":"……동료들이 싸우고 있는데 여기서 쓰러져선 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/hp_warning.ogg"},"로그인":{"voiceline":"다녀오셨어요, 지휘관님! 아무리 늦은 시간이라도 항상 여기서 기다릴게요. 왜냐하면… 지휘관님 곁에 있으면 행복한 기운이 느껴지거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/login.ogg"},"실패":{"voiceline":"훌륭한 기함이 되려면 갈 길이 먼 것 같네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/lose.ogg"},"우편":{"voiceline":"지휘관님, 새로운 우편이에요. 제가 가지고 올게요. 좋은 소식이 있을지도 모르잖아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/mail.ogg"},"임무":{"voiceline":"운송 임무는 도와드릴 수 있지만 다른 것은…… 매일 이렇게 많은 임무를 처리하다니, 지휘관님 정말 대단해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/mission.ogg"},"임무완료":{"voiceline":"임무 완료예요. 지휘관님, 수고하셨어요. 괜찮아요, 제 꼬리를 베개삼아서 잠시 쉬셔도 괜찮답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/mission_complete.ogg"},"서약":{"voiceline":"음… 지휘관님과 친밀해졌지만, 이런 때는 역시 조금 긴장되네요. 이제 어떻게 해야… 아! 지휘관님, 제 꼬리를 꼭 안아주세요! 이렇게 폭신폭신하면 분명 덜 긴장될 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/propose.ogg"},"스킬":{"voiceline":"먼저 어뢰 사격이 좋겠네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/skill.ogg"},"터치1":{"voiceline":"보송보송한 꼬리는 제 본체가 아니라구요? 제 본체는 바로 웃음과 모두에게 주는 온기랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/touch.ogg"},"터치2":{"voiceline":"지휘관님, 지금은 업무 시간인데요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/touch2.ogg"},"입수시":{"voiceline":"여기가 바로… 모항? (두리번) 아… 지휘관님! 유구모급 4번함 나가나미 , 드디어 만나게 되었네요/ 자기소개라면… 음, 지휘관님이 좋아요. 물론 다른 동료들도요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/unlock.ogg"},"강화성공":{"voiceline":"포근하고 안심되는 힘, 이게 바로 강화인가요… 고마워요, 지휘관님/","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에헤헤, MVP가 될 줄은 몰랐는데… 하지만 승리한 것은 모두의 덕분이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301830/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['카와카제', '카게로', '쿠로시오', '마키나미'] : 콤비네이션이라면 제2 수뢰전대는 지지 않아요!"