celink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301834/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이런 차림을 하고 있는 건, 음… 꼬리로 지휘관님을 감싸면 지휘관님을 나가나미의 것으로 만들 수 있으니까, 그 대신 나가나미도 지휘관님께 드릴까 하고, 저도 모르게… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301834/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님? 아까부터 통 드시질 않는데, 혹시 너무 써서 그런가요…? 아… 나가나미가 만든 초콜릿이 입에 안 맞으시면… 다, 다른 방법으로 지휘관님을 행복하게 해드릴게요…!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"초콜릿이든 꼬리든, 지휘관님을 위해서라면 나가나미는 뭐든 바칠 거예요! …아니, 그뿐만이 아니라… 예를 들면 나가나미 자체를 온전히 바쳐서 지휘관님이 행복해진다면…… 지휘관님… 사랑해요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301834/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 고생 많으셨어요! 초콜릿을 먹기 전에 나가나미를 받아주세요! 아… 우, 우선 나가나미를 꼭 안아줬으면 한다는 의미였어요… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301834/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"복슬복슬, 복슬복슬… 쓱쓱…… 어, 어떠세요? 좀 행복해지는 것… 같으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301834/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"마, 마음껏 쓰다듬어 주세요… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301834/touch.ogg"},"터치2":{"voiceline":"여기는 너무 부드럽고 끈적끈적해서 녹아버릴 것… 같다고요? ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301834/touch2.ogg"},"입수시":{"voiceline":"지휘관님? 아까부터 통 드시질 않는데, 혹시 너무 써서 그런가요…? 아… 나가나미가 만든 초콜릿이 입에 안 맞으시면… 다, 다른 방법으로 지휘관님을 행복하게 해드릴게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301834/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":