[{"클뜯 id":404010,"클뜯 함순이 id":40401,"함순이 이름":"샤른호르스트","한글 함순이 + 스킨 이름":"샤른호르스트","영문 함순이 + 스킨 이름":"Scharnhorst","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404010/shipyard.png","설명":"샤른호르스트급 전함·샤른호르스트","자기소개":{"voiceline":"나는 샤른호르스트, 어떤 전투에서도 마지막 순간까지 버텨낸다. 이것이 바로 나의 고집과 자존심이다. 전투에 관한 거라면 내게 맡겨라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/profile.ogg"},"메인1":{"voiceline":"항공모함같이 하늘하늘 거리는 녀석들이 나와 동급 이상의 전투력을 갖고 있다는 거, 난 인정할 수 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/main1.ogg"},"메인2":{"voiceline":"내 앞을 29노트로 항해하지 않도록, 동료들에게 전해줘. 나도 모르게 쏴버리니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/main2.ogg"},"메인3":{"voiceline":"'추악한 자매'? 흠, 좋은 이름이군, 전쟁 그 자체와 같아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/main3.ogg"},"전투개시":{"voiceline":"적의 잔해를 갈아버리자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/battle.ogg"},"상세확인":{"voiceline":"남의 상처를 비웃을 수 있는 건 상처 입은 적이 없는 인간뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/detail.ogg"},"드랍 설명":{"voiceline":"샤른호르스트급 전함 - 샤른호르스트","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰가 완료되었다! 정말이지, 이런 건 나와 동생에게 맡기면 될 것을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/expedition.ogg"},"실망":{"voiceline":"용기가 없는 인간에게 전장에 설 자격은 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/feeling1.ogg"},"낯섦":{"voiceline":"언제나 더욱더 강해져서, 적을 쳐부수는 것만 생각할 수 있다면 좋겠지만, 현실은 그렇게 호락호락하진 않지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/feeling2.ogg"},"호감":{"voiceline":"너의 함대는 좋은 곳이구나……여기라면, 힘낼 수 있을 것 같다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/feeling3.ogg"},"기쁨":{"voiceline":"어라? 지휘관! 모두와 연습을 하고 왔다만…흐흠, 모두 기운이 넘치더군. 지휘관이 믿음직스러우니까 그런 거다. 여기는 점점 더 마음에 드는군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/feeling4.ogg"},"사랑":{"voiceline":"물러서지 않는 건 아무 것도 두렵지 않아서가 아니라, 물러서지 않을 이유가 있어서다……과거엔 메탈 블러드를 위해, 그리고 지금은 지휘관……지휘관의 함대를 위해서다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"좋은 느낌이지 않은가. 너도 전투에 익숙해진 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/home.ogg"},"hp 경고":{"voiceline":"마지막 순간까지 끝까지 싸워주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/hp_warning.ogg"},"로그인":{"voiceline":"지금 돌아왔나? 마침 잘 됐군, 지금 시험 사격을 하려던 참이었다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/login.ogg"},"실패":{"voiceline":"다음엔 지지 않겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/lose.ogg"},"우편":{"voiceline":"네 앞으로 온 편지다. 인기 있구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/mail.ogg"},"임무":{"voiceline":"임무? 그따위 거 단번에 해치워버려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/mission.ogg"},"임무완료":{"voiceline":"보수? 흐흠, 이럴 때가 제일 기쁜 법이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/mission_complete.ogg"},"서약":{"voiceline":"안심해라, 함대와 지휘관을 위해, 이제 옛날처럼 물불 안 가리고 덤벼들진 않아. 물론, 전투는 전과 같이 나에게 맡겨주도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/propose.ogg"},"스킬":{"voiceline":"안톤, 브루노, 체잘, 전문 발사 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/skill.ogg"},"터치1":{"voiceline":"나는 물러서지 않는다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/touch.ogg"},"터치2":{"voiceline":"거기서 움직이지 마라 지휘관, 이 한 발을 버텨내면 용서해주지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/touch2.ogg"},"입수시":{"voiceline":"이 샤른호르스트의 사전에 도망이란 없다! 네가 지휘관인가? 그 힘, 한 번 보도록 하지! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/unlock.ogg"},"강화성공":{"voiceline":"다음 전투가 기대되는군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"신뢰할 수 있는 게 있다면, 그건 바로 내 포탑이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":404011,"클뜯 함순이 id":40401,"함순이 이름":"샤른호르스트","한글 함순이 + 스킨 이름":"설표와 매화","영문 함순이 + 스킨 이름":"Panther und Pflaume","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404011/shipyard.png","설명":"명절인가…… 싸우는 것보다는 재미 없어. 빈둥거리는 건 내 취향이 아니야. 지휘관, 이 ‘설날’이라는 것에 내 흥미를 끌만한 것은 없는 건가?","자기소개":null,"메인1":{"voiceline":"폭죽? 그런 장난감을 가지고 놀 바에는 차라리 함포를 발사하는 것이 어떤가? 그게 더 멋있을 것 같은데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/main1.ogg"},"메인2":{"voiceline":"이 아이의 강한 눈빛, 마음에 들어. 하하, 사실 아주 착한 아이란다. 건드리지만 않으면 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/main2.ogg"},"메인3":{"voiceline":"로열 메이드단도 설날 연회에 요리를 하는 건가. 흥, 메이드장님도 대단하군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/main3.ogg"},"전투개시":{"voiceline":"마침 지루하던 참이다. 나를 즐겁게 해봐라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/battle.ogg"},"상세확인":{"voiceline":"이 옷은 싸움 외의 것에도 좀 신경을 쓰라며 그나이제나우가 억지로 입힌 것이지. 별다른 거절의 이유를 찾지 못했기 때문에—— 이런 차림새가 된 참이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/detail.ogg"},"드랍 설명":{"voiceline":"명절인가…… 싸우는 것보다는 재미 없어. 빈둥거리는 건 내 취향이 아니야. 지휘관, 이 \"설날\"이라는 것에 내 흥미를 끌만한 것은 없는 건가?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"앞으로 나아가는 것 외에 내가 할 수 있는 것이 무엇이 있을까 생각할 때마다 마음이 복잡해지곤 했지만…… 네가 곁에 있다면 언젠가는 답을 찾을 수 있겠지. 그런 느낌이 든다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"명절이라도 지휘관은 바쁜 모양이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"하아—— 오래 앉아있으면 정말로 게을러지는구나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"눈싸움 따위라면 나를 부를 필요는 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/touch.ogg"},"터치2":{"voiceline":"호오? 지휘관, 이 아이와 친해지고 싶은 모양이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/touch2.ogg"},"입수시":{"voiceline":"명절인가…… 싸우는 것보다는 재미 없어. 빈둥거리는 건 내 취향이 아니야. 지휘관, 이 \"설날\"이라는 것에 내 흥미를 끌만한 것은 없는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70312,"상점 카테고리 id":3,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":800,"기간":"상시","진영":"KMS","레어도":"SR","ex_chat_status":0}]