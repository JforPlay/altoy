[{"클뜯 id":9704050,"클뜯 함순이 id":970405,"함순이 이름":"히에이·META","한글 함순이 + 스킨 이름":"히에이·META","영문 함순이 + 스킨 이름":"Hiei META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704050/shipyard.png","설명":"순양전함 히에이가 이렇게 달려왔습니다. 지휘관님, 다음은 어떻게 할까요? 순찰이든 전투든 모두 준비는 되어 있으니, 당장이라도 출격하죠♪","자기소개":{"voiceline":"고속전함 히에이… 「히에이·META」라고 부르셔도 되고요. …왠지 분위기가 META스럽지 않다고요? 글쎄요… META스러운 분위기란 건 대체 뭘까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/profile.ogg"},"메인1":{"voiceline":"전투에서 현명함은 중요한 덕목이지만, 때로는 만용도 필요한 법입니다. 왜냐하면 「기적」은 이 두 가지에서 태어나는 것이기 때문이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/main1.ogg"},"메인2":{"voiceline":"천 리 길도 한 걸음부터라고 하죠. 나쁜 결과부터 두려워하지 말고 우선은 한 발짝 내디뎌보는 게 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/main2.ogg"},"메인3":{"voiceline":"연회? …어디서 열리죠? 꼭 참여하고 싶은데…… 히에이가 준비하는 건가요? 그건 좀 귀찮으니, 거절해도 될까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/main3.ogg"},"전투개시":{"voiceline":"전투 시작―― 전력으로 상대해 드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 밖에 나가는 임무는 없나요? ……없으면 저랑 같이 산책이라도 나가는 건 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/detail.ogg"},"드랍 설명":{"voiceline":"히에이호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 귀환했군요. 지휘관님, 어서 보상을 확인하러 가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/expedition.ogg"},"실망":{"voiceline":"볼일이 있으면 빨리 말씀하시지 그러세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/feeling1.ogg"},"낯섦":{"voiceline":"약한 자를 만나면 도움을 주고, 같이 이 칼과 함께 세상을 떠도는―― 음… 뭔가 멋진 대사를 만들고 싶은데 쉽지 않네요… 후후, 박식하신 지휘관님께서는 뭐 좋은 생각 없나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/feeling2.ogg"},"호감":{"voiceline":"「칼로 하늘을 찢고, 인간 세상에 정의를 구현하리라」――지휘관님, 방금 건 어떤가요? 멋진 것 같아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/feeling3.ogg"},"기쁨":{"voiceline":"……연회 초청이요? 신난다! 흥겨운 연회, 요리에 음악, 동료들의 웃는 얼굴…… 한 벌씩 맞춘 예복도 여기 있으니 같이 가서 얼굴을 비추죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/feeling4.ogg"},"사랑":{"voiceline":"후우… 오늘은 상쾌해서 나들이하기 좋은 날씨네요… 어머? 같이 나가자고요? 당연히 좋죠. 유원지 말씀인가요? 후후후, 좋아요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/feeling5.ogg"},"터치3":{"voiceline":"이 뿔이 신경이 쓰이시나요? 후후후, 마음껏 만지셔도 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 고생 많으셨습니다. 괜찮으시면 저와 함께 훈련장에서 잠깐 쉬는 건 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/home.ogg"},"hp 경고":{"voiceline":"아직 끝나지 않았어요. 다시 되갚아 드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 오늘 계획은…… 집무실에 틀어박혀 계실 건가요? 네… 지금 당장 계획을 바꾸는 건 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/login.ogg"},"실패":{"voiceline":"방심하고 말았네요… 대실패…예요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/lose.ogg"},"우편":{"voiceline":"(작은 목소리로) 지휘관님, 우편이 도착했어요. 책상 위에 올려뒀습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/mail.ogg"},"임무":{"voiceline":"새로운 임무가 왔군요. 지휘관님, 어서 착수하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/mission.ogg"},"임무완료":{"voiceline":"임무가 무사히 완료되었습니다. 역시 지휘관님은 솜씨가 좋으시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/mission_complete.ogg"},"서약":{"voiceline":"계속 함께 하자는 이 맹세… 소중히, 소중히 간직할게요. 어떤 절망스러운 순간이 오더라도 지휘관님의 손은 제가 꼭 잡아드릴 테니까, 지휘관님도 히에이의 손을 꼭 잡아주세요. 네, 같이 모든 걸 극복하는 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/propose.ogg"},"스킬":{"voiceline":"운산무소! 흩어져라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/skill.ogg"},"터치1":{"voiceline":"후우… 바닷바람이 기분좋게 불어서 먼길을 떠나기 좋겠네요. 지휘관님, 같이 나가시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/touch.ogg"},"터치2":{"voiceline":"지휘관님… 정말로 제게 손을 대셨군요? 참으로 대단하신 분…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/touch2.ogg"},"입수시":{"voiceline":"순양전함 히에이가 이렇게 달려왔습니다. 지휘관님, 다음은 어떻게 할까요? 순찰이든 전투든 모두 준비는 되어 있으니, 당장이라도 출격하죠♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/unlock.ogg"},"강화성공":{"voiceline":"이 힘만 있다면 바람도 따라잡을 수 있겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어머, 겨우 이 정도밖에 안 되는군요. 다음에는 더 싸울 보람이 있는 적으로 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex"