feeling1.ogg"},"낯섦":{"voiceline":"지휘관의 사무실은 조용하네. 여기, 마음에 들었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/feeling2.ogg"},"호감":{"voiceline":"하지만 지휘관의 일은 도와줄 수 없는걸... 이렇게 여기에 계속 있어도......괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/feeling3.ogg"},"기쁨":{"voiceline":"여기, 아무때나 와도돼? 고마워......왠지는 모르겠지만 여기에 와있으면 오히려 마음이 편안해져......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/feeling4.ogg"},"사랑":{"voiceline":"어두운 해저에서 잠행하는 것이 익숙해진 줄 알았는데... 하지만 최근 출격할 때마다 나도 모르게 밝고 따뜻한 지휘관이 떠올라...아마도, 나는 이제 지휘관을 떠날 수 없게 된 거겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"사람이 많아졌어...시끄럽네...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/home.ogg"},"hp 경고":{"voiceline":"......장난치지마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/hp_warning.ogg"},"로그인":{"voiceline":"아...돌아왔구나...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/login.ogg"},"실패":{"voiceline":"여기서 끝인 건가...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/lose.ogg"},"우편":{"voiceline":"새로운 정보야......적에게 해독 당하진 않겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/mail.ogg"},"임무":{"voiceline":"임무가 또 있네...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/mission.ogg"},"임무완료":{"voiceline":"보상...확인하러 안가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408020/mission_complete.ogg"},"서약":{"voiceline":"이제 나의 존재 이유는 차가운 해저에만 있는 것이 아니라 물 밖과 지휘관의 곁에도 있어... 말 한마디 없이도 지휘관과 함께라면 가장 행복한 시간이 될거야.","voicelink":"https://raw.githubusercontent.com/Fernando2