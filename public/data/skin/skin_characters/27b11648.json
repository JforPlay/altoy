o2603/AzurLane/main/audio/voiceline/408024/detail.ogg"},"드랍 설명":{"voiceline":"인기척 없는 서재, 보드라운 소파… 쉬기에 딱 좋은 곳. 휴우… 지휘관. 책장에 있는 책은 마음 가는 대로 읽어도 괜찮으니까, 볼일 없으면 난 이만 잘게.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아왔어. 지휘관, 나 대신 안무 좀 전해줘…. 아, 내가 여기 있다는 건 비밀로 해주고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"흡혈귀와 인간의 러브 스토리가 담긴 책, 비교적 재밌었어. 한가하면 같이 읽어보지 않을래…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고했어. 피곤하면… 여기 누워볼래? 양보해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"윽… 들켰나? …지휘관이네. 어서 와.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/login.ogg"},"실패":{"voiceline":"역시…. 너무 무리했나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/lose.ogg"},"우편":{"voiceline":"창문 밖에 있는 박쥐들이 또 웅성거리고 있네…. 아, 우편을 전해줬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/mail.ogg"},"임무":{"voiceline":"또 새로운 게 왔다고? …조금만 더 쉬고 갈게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/mission.ogg"},"임무완료":{"voiceline":"임무 완료 보상, 확인하는 거 도와줄까……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"내가 할 수 있는 거라면 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/touch.ogg"},"터치2":{"voiceline":"목 한번 물려볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408024/touch2.ogg"},"입수시":{"voiceline":"인기척 없는 서재, 보드라운 소파… 쉬기에 딱 좋은 곳. 휴우… 지휘관. 책장에 있는 책은 마음 가는 대로 읽어도 괜찮으니까, 볼일 없으면 난 이만 잘게.",