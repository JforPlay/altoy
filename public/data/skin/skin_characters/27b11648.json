ttps://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/main2.ogg"},"메인3":{"voiceline":"비단잉어는 없었지만, 그 아카시가 데리고 온 만쥬들이 엄청난 속도로 물고기를 낚아 올리고 있더라……. 밤에 쓸 식재료는 충분할 것 같아. …딱히 난 상관없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/main3.ogg"},"전투개시":{"voiceline":"침몰시켜서… 아, 끌어당기지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/battle.ogg"},"상세확인":{"voiceline":"뤼초는 부엌, 나는 여기서 식자재를 조달하는 건데, 편해서 좋네. …아니라고? 부엌이 여기보다 훨씬 힘들걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/detail.ogg"},"드랍 설명":{"voiceline":"좋아, 이걸로 전설의 비단잉어를… 아… 조금만 더 하면 행운의 상징을 잡을 수 있었는데… 지휘관, 미안해….","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"돌아왔구나? 캬오~ 후후후…… 오늘은 느긋하게 보내야 한다더라. 나도, 지휘관이랑 함께라면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지금부터 재도전해서 활기 넘치는 녀석을 잡아 올게. 지휘관, 기다리고 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"보상인가? 이것도 받아놔도 돼? 연회 식재료도 많이 남을 것 같고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"가까이에서 보고 싶다고? 그럼… 응? 그쪽 말고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/touch.ogg"},"터치2":{"voiceline":"으앗. …(만지려고 하자, U-47은 뒤로 몸을 뺐다…….) 아, 미, 미안… 딱히 피하려던 건 아니었어….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/touch2.ogg"},"입수시":{"voiceline":"좋아, 이걸로 전설의 비단잉어를… 아… 조금만 더 하면 행운의 상징을 잡을 수 있었는데… 지휘관, 미안해….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408025/unlock.ogg"},"강화성공":null,"vote":null,"