Fernando2603/AzurLane/main/audio/voiceline/408023/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 쉴 거면 메탈 블러드의 가판대를 추천할게. 분위기도 좋고, 긴장도 풀리고……. (작은 목소리로) 나도 있고…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 와……하고 싶은 얘기 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/login.ogg"},"실패":{"voiceline":"돌아가야 해……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/lose.ogg"},"우편":{"voiceline":"신규…… 주문? 아니, 지휘관 앞으로 온 우편이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/mail.ogg"},"임무":{"voiceline":"동료에게 배달하는 임무가 들어왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/mission.ogg"},"임무완료":{"voiceline":"보상인가. 와, 좀 많네…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"이건 동료에게 전해줘야 해……. 커피는 다음에 내가 내려줄 테니까 참아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/touch.ogg"},"터치2":{"voiceline":"오늘 서비스는 없는 걸로.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/touch2.ogg"},"입수시":{"voiceline":"잠깐 실례, 지나갈게——아, 지휘관이구나. 나중에 얘기하자. 우선 이 커피 좀 배달하고 올게——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"깨끗이 청소했어, 이렇게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408023/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":n