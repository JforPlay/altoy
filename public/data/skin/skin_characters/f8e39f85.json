urLane/main/audio/voiceline/502037/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 배고파? 밥 곧 다 되니까 조금만 기다려…… 응, 핑하이. 지금은 못 안아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502037/touch.ogg"},"터치2":{"voiceline":"……응? 핑하이는 괜찮아. 그렇지만…… 언니가 지휘관을 날려버릴지도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502037/touch2.ogg"},"입수시":{"voiceline":"연회의 메인 요리로 게를 빼놓을 수 없지! 그러니까 절대 놓치면 안 돼! …아, 지휘관. 도와준다고? 주방은 핑하이랑 언니한테 맡겨둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502037/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['닝하이'] : 언니! 문어가 도망쳤어!","voicelink":null}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70978,"상점 카테고리 id":17,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"한정 (2025/04/02)","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502039,"클뜯 함순이 id":50203,"함순이 이름":"핑하이","한글 함순이 + 스킨 이름":"핑하이·改","영문 함순이 + 스킨 이름":"Ping Hai (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502039/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502039/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502039/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502039/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502039/shipyard.png","설명":"헤이~얍~ 우으…