[{"클뜯 id":406030,"클뜯 함순이 id":40603,"함순이 이름":"야드","한글 함순이 + 스킨 이름":"야드","영문 함순이 + 스킨 이름":"Jade","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406030/shipyard.png","설명":"야드급 항공모함-야드","자기소개":{"voiceline":"개조 항공모함 그나이제나우…… 같은 건 없어요. 나는 항공모함 야드, 대활약은 어려울지도 모르지만, 얌전히 지내드리죠♪ 지휘관, 뭐든 맡겨만 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/profile.ogg"},"메인1":{"voiceline":"뭐죠? 야드는 친구랑 수다 떠느라 바쁘다구요. 도움이 필요하면 다른 애라도 불러 오시죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/main1.ogg"},"메인2":{"voiceline":"흐음~ 쥬스타그램에 누가 이상한 글을 올렸나 했는데 지휘관이었네요. 착한 아이인 야드가 친절하게 정보를 알려드리죠. …실은 여기, 오타 내셨어요. 아하하하♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/main2.ogg"},"메인3":{"voiceline":"야드는 착하니까 하등생물이라고는 부르지 않아요. 그쵸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/main3.ogg"},"전투개시":{"voiceline":"착한 아이니까 잘 싸울게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/battle.ogg"},"상세확인":{"voiceline":"지휘관 방은 정돈된 것 치고는 먼지가 꽤나 쌓여 있네요. 여기라든가 여기, 제대로 청소 안 해요? 야드가 봐줄 테니까 어서 손을 움직이세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/detail.ogg"},"드랍 설명":{"voiceline":"야드급 항공모함-야드","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네요. 선물은 어떤 거려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/expedition.ogg"},"실망":{"voiceline":"지휘관은 심술궂어서 분명 다른 사람들도 다 싫어할 거예요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/feeling1.ogg"},"낯섦":{"voiceline":"휴우… 왜 야드가 이런 꼴을… 응? 아무것도 아니에요. 야드는 여기서 모두를 위해 조사를 하고 있었던 것뿐이에요. 지휘관이랑은 상관없는 일이라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/feeling2.ogg"},"호감":{"voiceline":"야드와 지휘관의 관계는… 후후후, 아직 아무도 눈치채지 못한 것 같네요. 꺅?! 지휘관? 갑자기 방에 들어오면 어떡해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/feeling3.ogg"},"기쁨":{"voiceline":"지휘관의 비밀 파일…… 여기에도 없네요. 어떡하지… 으앗?! 지휘관? 갑자기 방에 들어오지 말라고 했을 텐데요?! 아무리 여기가 지휘관의 방이라고 해도 마찬가지라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/feeling4.ogg"},"사랑":{"voiceline":"지휘관 방에 야드가…… 흐음~ 역시 들킨 건가요. 그래서 뭐죠? 야드는 착한 아이니까 당연히 지휘관 방에 몰래 들어가지도 않고, 지휘관을 놀리거나 하지도 않잖아요? 지휘관 생각도 그렇죠? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/feeling5.ogg"},"터치3":{"voiceline":"키가 작은 게 뭐 어때서요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/headtouch.ogg"},"모항귀환":{"voiceline":"뭐죠? 야드는 친구랑 약속이 있어서 바쁘다구요. 어머, 그러고 보니 지휘관에게 수고했다는 말도 아직 안 했네요. 아쉽겠지만, 야드는 지금 당장 나가봐야 해서요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/home.ogg"},"hp 경고":{"voiceline":"왜 야드가 이런 꼴을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이에요, 지휘관. 어젯밤엔 잘 잤나요? 밤새우는 건 나쁜 애들이나 하는 짓이라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/login.ogg"},"실패":{"voiceline":"흥, 화나…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/lose.ogg"},"우편":{"voiceline":"우편이 온 것 같네요. 야드에 대한 내용이 적혀있진 않죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/mail.ogg"},"임무":{"voiceline":"착한 야드가 대신 해드릴까요? 임무♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐네요. 어머, 지휘관은 설마 아직도 모르고 있었던 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/mission_complete.ogg"},"서약":{"voiceline":"서약 반지네요… 뭐, 지휘관이 뒤에서 몰래 준비하고 있었던 건 다 알고 있어서, 별로 놀랍지는 않은데요? 야드는 딱히 지휘관에게 그럴 생각 없다고 하면요? 후후후, 방금 건 농담이에요♪ 좋아한다고 하면, 깜짝 놀라주실 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/propose.ogg"},"스킬":{"voiceline":"이럼 되겠네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/skill.ogg"},"터치1":{"voiceline":"악수하자구요? 착하지, 앉아! 농담이에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/touch.ogg"},"터치2":{"voiceline":"꺅?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드 소속 항공모함, 이름은 야드라고 해요. 보아하니 당신이 지휘관인 것 같네요. 어머, 자기소개는 굳이 안 하셔도 돼요. 만나기 전에 이미 전~부 조사했으니까요. 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/unlock.ogg"},"강화성공":{"voiceline":"고마워요, 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후훗, 야드의 신발 밑창이라도 핥으세요. 자, 혀 내미셔야죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"관심 안 줄 땐 어떻게 해주면 좋을까~? 어머, 그렇게 걱정할 필요 없어요. 야드가 지금까지 지휘관을 곤란하게 만든 적이 있긴 했나요? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406030/feeling5_ex.ogg"},"터치3_ex"