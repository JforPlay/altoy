ne/406032/feeling5.ogg"},"터치3":{"voiceline":"후훗, 오늘은 모자를 쓰고…… 으아아! 모자를 벗기면 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406032/headtouch.ogg"},"모항귀환":{"voiceline":"응? 야드의 라이브 방송? 이미 끝난지 오래인데요… 방송을 놓치다니 안 되셨네요~ 후후, 거짓말이에요♪ 아직 시작 안 했어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406032/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어머, 용사님도 지각을 하시나요? 설마 밤을 새는 나쁜 아이라도 되신 건가요? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406032/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"라이브 준비도 중요하지만, 퀘스트도 소홀히 해서는 안 되죠. 아, 설마 지휘관… 일부러 방치해서 야드가 돕게 만들 셈인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406032/mission.ogg"},"임무완료":{"voiceline":"퀘스트 보상이 가득 도착했네요. 잘못 세지 않도록 조심하시길♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406032/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"응원봉이 필요하다고요? 자, 왼손! 오른손! 후후후, 착한 아이네요♪ 여기 받으세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406032/touch.ogg"},"터치2":{"voiceline":"짓궂은 용사님이시네요♪ 야드랑 여기서 나쁜 짓이라도 하시려구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406032/touch2.ogg"},"입수시":{"voiceline":"그래요, 제가 여기서 가장 유명한 아이돌 마녀 야드예요. 당신은 야드의 이름을 듣고 찾아온 용사님이죠? 지금 새로운 곡을 스트리밍하려던 참이니까, 꾸물거리지 말고 어서 도와주세요. 후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406032/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":