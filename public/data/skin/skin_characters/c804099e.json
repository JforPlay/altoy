[{"클뜯 id":308030,"클뜯 함순이 id":30803,"함순이 이름":"이58","한글 함순이 + 스킨 이름":"이58","영문 함순이 + 스킨 이름":"I-58","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308030/shipyard.png","설명":"순잠 을형·改 2형 잠수함 이58","자기소개":{"voiceline":"순잠 을형 개이, 통칭 세 번째 이54형 잠수함, 이58이야. 그 대전의 말기에 태어나, 임무에 몇 번이나 참여해서, 종전 직전에 인디애나폴리스를 격침시켰어. 꽤 큰 전투 성과지만, 뭐 그렇게 자랑하고 싶진 않아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/profile.ogg"},"메인1":{"voiceline":"딱히 육지에서도 활동할 수 있지만, 바닷속이 더 좋아. (꼬르르륵)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/main1.ogg"},"메인2":{"voiceline":"지휘관, 평소엔 어떤 수영법으로 헤엄쳐? 자유형? 접영? 평영?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/main2.ogg"},"메인3":{"voiceline":"바닷속에는 신기한 게 잔뜩 있어. 지휘관도 한 번 잠수해봐, 체험해 보는 게 좋다니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/main3.ogg"},"전투개시":{"voiceline":"대잠전은 맡기도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/battle.ogg"},"상세확인":{"voiceline":"조용한 밤은 좋아해. 누구도 내 존재를 눈치채지 못하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/detail.ogg"},"드랍 설명":{"voiceline":"순잠 을형·改 2형 잠수함 이58","voicelink":null},"의뢰 완료":{"voiceline":"물 위는 어떻게 되었을까……아, 지휘관, 의뢰팀이 돌아왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/expedition.ogg"},"실망":{"voiceline":"이 함대도 전쟁을 위해 존재한다는 거군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/feeling1.ogg"},"낯섦":{"voiceline":"동료가 되었으니 인디애나폴리스와 사이좋게 지내야겠지…그치만 그 아이의 언니는…으으…역시 나, 바닷속에 있는 편이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/feeling2.ogg"},"호감":{"voiceline":" \"스스로 발을 내딛지 않으면 아무것도 시작되지 않는다.\" ……그런 건가? 음…그 아이와 얘기해볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/feeling3.ogg"},"기쁨":{"voiceline":"금방은 이해할 수 없겠지만, 우리는 동료인걸…이제 시간에 맡길 수밖에 없어. 지휘관, 고마워. 답례로……쪽❤️","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/feeling4.ogg"},"사랑":{"voiceline":"과거를 잊는 건 그리 쉽지 않아…하지만, 지휘관이 모두에게 다른 미래를 그려주어서, 앞으로 나아갈 수 있도록 길을 열어 주었어…나, 지휘관을 좋아한다는 걸 자랑스럽게 생각해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 오늘 바다는 잠행하기 적합한가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/home.ogg"},"hp 경고":{"voiceline":"……간파당하고 있었다는 거네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 잠수함은 바다에서 멀어지면 말라죽는다고… 노, 농담이지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/login.ogg"},"실패":{"voiceline":"들켰군……다음은 더 은폐에 주의해야겠어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 편지……미안, 지금 막 바다에서 올라온 참이라 조금 편지가 젖어버렸어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/mail.ogg"},"임무":{"voiceline":"새로운 임무? 나도 나가는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/mission.ogg"},"임무완료":{"voiceline":"임무 보수……잠수할 때 들고갈 순 없을 거 같네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/mission_complete.ogg"},"서약":{"voiceline":"지휘관이라면, 모두가 행복한 미소를 지을 수 있는 세상을 만들 수 있을 거라 생각해…후훗, 내게 있어선, 지휘관의 곁에 있는 게 가장 큰 행복이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/propose.ogg"},"스킬":{"voiceline":"이쪽에서의 공격, 예측할 수 있겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/skill.ogg"},"터치1":{"voiceline":"잠수하기 전 워밍업은 중요하다고. 지휘관, 같이 스트레칭 안 할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/touch.ogg"},"터치2":{"voiceline":"나, 나도 조금 작다고 생각하지만……뭐 덕분에 움직이긴 편하지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/touch2.ogg"},"입수시":{"voiceline":"이58, 착임했다. 평소엔 모항 근처의 바닷속에 있으니까, 못찾겠을 땐 그곳을 찾아봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/unlock.ogg"},"강화성공":{"voiceline":"응, 몸이 가벼워졌어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"수상함이란 이 정도로군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0}]