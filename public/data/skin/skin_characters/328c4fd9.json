[{"클뜯 id":301390,"클뜯 함순이 id":30139,"함순이 이름":"나가츠키","한글 함순이 + 스킨 이름":"나가츠키","영문 함순이 + 스킨 이름":"Nagatsuki","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301390/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301390/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301390/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301390/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301390/shipyard.png","설명":"무츠키급 구축함 8번함 - 나가츠키 ","자기소개":{"voiceline":"무츠키급 '8번함' 나가츠키야! 호위 임무랑 수송 임무만 잔뜩 해왔지만, '쿨라만 해전'에선 열심히 싸웠어! 정말이라구! ……이게 뭐냐구? 후후후…… 이건 로리콘을 무찌르는 비밀병기 삐코닷!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/profile.ogg"},"메인1":{"voiceline":"이건 이렇게……손가락으로 이 고리를 힘껏 당기면……어뢰가 콰앙~할 때처럼 커다란 소리가 나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/main1.ogg"},"메인2":{"voiceline":"내 함력? 그 유명한 나카씨도 구해준 적이 있다구! ……아마도.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/main2.ogg"},"메인3":{"voiceline":"지휘관, 이 글자는 어떻게 읽는 거야?…'승리'? 잘 모르겠지만, 삐코를 울려야 할 거 같은 기분이 들어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/main3.ogg"},"전투개시":{"voiceline":"오, 오지마─! 내 삐코는 나쁜 아이들의 천적이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/battle.ogg"},"상세확인":{"voiceline":"누구를 위하여 삐코는 울리나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/detail.ogg"},"드랍 설명":{"voiceline":"무츠키급 구축함 8번함 - 나가츠키","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 재밌어보여~! 나도 보내달라구~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/expedition.ogg"},"실망":{"voiceline":"후아암……심심해…지휘과안… 뭔가 재밌는 것 좀 해봐아… 안 그럼 삐코 울려버린다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/feeling1.ogg"},"낯섦":{"voiceline":"니히히히, 지휘관은 수상한 사람이 아니니까, 삐코 걱정은 하지 않아도 돼……정말로 수상한 사람 아니지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/feeling2.ogg"},"호감":{"voiceline":"양치기 소년'이라구?……니히히, 아무래도 지휘관한테는 삐코를 진짜로 한 번 울려서, 나가츠키가 입만 산 게 아니란 걸 보여줄 필요가 있겠네~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/feeling3.ogg"},"기쁨":{"voiceline":"흐에에에…자, 잘못했어요……지휘관은 착하고 친절한 어른이니까, 나가츠키한테 화 안 낼 거지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/feeling4.ogg"},"사랑":{"voiceline":"삐코로 장난치지 말라구? 흐음……지휘관이 나랑 놀아준다면, 한번 생각해줄 수도 있을지도? 니히히♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 어서 와! 내 딸기 아이스크림은? 에? 사오란 말 못 들었다구!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/home.ogg"},"hp 경고":{"voiceline":"아아아앗! 좌, 좌초하는 건 아니지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/hp_warning.ogg"},"로그인":{"voiceline":"니히히, 오늘은 어떤 재밌는 일을 할까나? 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/login.ogg"},"실패":{"voiceline":"우겍……삐코는 그냥 경보기일 뿐이라니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/lose.ogg"},"우편":{"voiceline":"니히히히, 우편함에 쌓인 우편을 계속 읽지 않으면, 우편이 도망가버린다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/mail.ogg"},"임무":{"voiceline":"나가츠키가 사치스럽게 살 수 있도록 지휘관은 팍팍 일하라구~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/mission.ogg"},"임무완료":{"voiceline":"오오, 호화로운 보수네…… 엥! 내 몫은 없다구!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/mission_complete.ogg"},"서약":{"voiceline":"이 반짝이는 거……나가츠키 한테? 지휘관이 삐코 대신 날 지켜주는 거야? ……나, 지금 엄청 기뻐! 삐코 울려서 축하해도 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/propose.ogg"},"스킬":{"voiceline":"삐코의 힘을 봐라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/skill.ogg"},"터치1":{"voiceline":"니히히, 지휘관은……무슨 짓을 하면 삐코가 울리는지 알고 싶은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/touch.ogg"},"터치2":{"voiceline":"…………! 본성을 드러냈구나! 삐코의 심판을 받아라~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관? 조금 수상하긴 해도…… 위험한 사람은 아닌 것 같네. 나는 나가츠키! 흐흥, 날 바보 취급했다간 큰코다친다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/unlock.ogg"},"강화성공":{"voiceline":"와아와아! 신난다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이, 이겼나?……냐하하하! 봐, 봤느냐! 이것이 나가츠키님의 힘이닷!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['무츠키', '키사라기', '우즈키', '미나즈키', '후미즈키', '나가츠키', '미카즈키'] : 나가츠키와 유쾌한 동료들, 간다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301390/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고