[{"클뜯 id":401240,"클뜯 함순이 id":40124,"함순이 이름":"Z24","한글 함순이 + 스킨 이름":"Z24","영문 함순이 + 스킨 이름":"Z24","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401240/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401240/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401240/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401240/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401240/shipyard.png","설명":"1936 A “나르비크”형 구축함—Z24","자기소개":{"voiceline":"Z23부터, 나 등등 1936형, 그리고 이후의 구축함은 모두 번호를 호칭으로 하지. 이는 왜일까? 분명 \"레베레히트 마스\"나 \"게오르크 틸레\" 같은 멋지고 적이 기억하기도 어려운 이름이 훨씬...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/profile.ogg"},"메인1":{"voiceline":"\"블랙\"은 고귀함의 상징이다! 블랙 커피, 다크 초콜릿, 블랙 포레스트 케이크, 모두 이름에서부터 고귀한 느낌을 풍기지. 그렇게 생각하지 않는가, 인간~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/main1.ogg"},"메인2":{"voiceline":"하암~~ 무료하여 잠이 오는구나... 다음에 지휘실에 들어오는 자를 놀래켜주기라도 해야겠다~... 음, 안되는가? 재미없군...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/main2.ogg"},"메인3":{"voiceline":"나의 길을 관철하는 것이야 말로 인생이다! 그러니까 Z23, 숙제 따위는 나에게 짐일 뿐이야! 아얏! 아, 알았다. 난 신경쓰지 말거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/main3.ogg"},"전투개시":{"voiceline":"흐흥, 그럼 시작하지. 흥분케하는 피와 철의 축제를!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/battle.ogg"},"상세확인":{"voiceline":"인간, 감히 나를 두려워하지 않다니? 이미 충분히 위압감을 드러내 보였을텐데... 어찌하여......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/detail.ogg"},"드랍 설명":{"voiceline":"벌벌 떨어라, 인간! 그대의 면전에 있는 것은, 적과 흑의 두려움의 마왕, 메탈 블러드 구축함 Z24! 고민하지 말고, 나의 발 치에 엎드려 그대의 경외심을 표하라!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 보상? 관심 없다... 하지만 다크 초콜릿이나 블랙 포레스트 케이크 같은 맛있는 음식이라면 꼭 나에게 바치거라. 인간!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/expedition.ogg"},"실망":{"voiceline":"그대는... 지극히 타락한 인간이 어떤 최후를 맞이하게 될 것인지 알게 될 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/feeling1.ogg"},"낯섦":{"voiceline":"음... 하늘에서 이리저리 날아다니는 그 \"파리\"들은 정말 짜증나는군, 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/feeling2.ogg"},"호감":{"voiceline":"상대가 어떻든지, 나의 위력을 느낀다면 놀라서 줄행랑을 칠 것이다! ... 어째서 그대는 나에 대해 어떠한 두려움도 없는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/feeling3.ogg"},"기쁨":{"voiceline":"나에게 바칠 다크 초코 케이크가 있다고? 후훗, 넘어가 주지. 인간. 자~ 아... 아직도 멍하니 뭘 하는 게냐? 어서 먹여주거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/feeling4.ogg"},"사랑":{"voiceline":"좋아, 그대가 날 이렇게 존경하는 것을 보아, 그대에게 나와 친밀히 접촉할 수 있는 권력을 부여하겠다! 와라! (두 팔 벌리며)... 포옹이다, 포옹! 꼭 내가 이렇게 똑똑히 말을 해야하는가, 어리석은 인간!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/feeling5.ogg"},"터치3":{"voiceline":"가, 간도 크구나, 인간. 나의 머리를 만지다니...... 음, 다, 다시 만져도 괜찮다...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/headtouch.ogg"},"모항귀환":{"voiceline":"그대 드디어 돌아왔구나, 피곤해. 좀 쉬어야겠다. 급한 일이 있거나 다크 초콜릿이 있는 게 아니라면 부르지 말거라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/home.ogg"},"hp 경고":{"voiceline":"하아... 하아...... 이제 되었겠지...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/hp_warning.ogg"},"로그인":{"voiceline":"그대는 지금 시간이 몇 신줄 아는가? 어서 업무 위치로 돌아가거라, 나태한 인간!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/login.ogg"},"실패":{"voiceline":"하아... 하아... 이제...... 참지 않아도 되겠지? 모든 것들의 모든 것을 모조리 파괴해버려도 되겠지...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/lose.ogg"},"우편":{"voiceline":"심연으로 부터 온 정보... 후후......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/mail.ogg"},"임무":{"voiceline":"임무? 이런 자질구레하고 번거로운 일들을 계속 거기에 두지 마라. 서둘러서 처리해버리라고, 인간.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/mission.ogg"},"임무완료":{"voiceline":"흐흥, 뭐가 어떻든지 간에, 성과를 거두는 시간은 언제나 즐겁구나, 그렇지, 인간~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/mission_complete.ogg"},"서약":{"voiceline":"허~ 감히 정말로 나에게 서약을 내미는 것이냐, 그대의 용기를 칭찬해 주겠다, 인간! 흐흥, 오늘부터 변함없이 나에게 경외와 공물을 바쳐야 한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/propose.ogg"},"스킬":{"voiceline":"전부 나의 발 아래 무릎 꿇어라! 아하하하핫!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/skill.ogg"},"터치1":{"voiceline":"이 거대 발톱 멋지지 않은가? 위압감이든 살상력이든, \"마왕\"이라는 칭호에 걸맞지! 흐흐흥~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/touch.ogg"},"터치2":{"voiceline":"감히 나에게 이런 불경을... 필히 마음의 준비는 충분히 되어있겠지, 인간...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/touch2.ogg"},"입수시":{"voiceline":"벌벌 떨어라, 인간! 그대의 면전에 있는 것은, 적과 흑의 두려움의 마왕, 메탈 블러드 구축함 Z24! 고민하지 말고, 나의 발 치에 엎드려 그대의 경외심을 표하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/unlock.ogg"},"강화성공":{"voiceline":"잘했다, 인간! 힘이 점점 응집되는 것 같구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아하하하핫! 선혈과 화염이 주조한 전장의 불꽃이 정말 멋지구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"... 흥! (pose) 하하핫! 인간, 어떠냐? 무섭지!? 나에게 굴복하고 싶지!? ... 그, 그대의 반응을 보니 더 개조할 수 있을 것 같은데...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"드디어 돌아왔군. 피곤하다...... 가지마! 와서 내 어깨랑 등 좀 두들기거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"감히 날 이렇게 오래 기다리게 하다니, 인간! 이미 비서함의 일을 많이도 끝냈단 말이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"후후후후... 후후후후하하하하하하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['아드미랄 그라프 슈피'] : 흐흥, 같이 적을 산산조각내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/couple_encourage1.ogg"},{"voiceline":"['Z25'] : 그대의 검은 사마, 아주 재미있구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/couple_encourage2.ogg"},{"voiceline":"['Z26'] : 이번엔, 그대 혼자 하얀 폭풍에서 헤매게 두지 않을 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/couple_encourage3.ogg"},{"voiceline":"['Z36'] : 악마(Devil)여, 악마의 명령에 따라 적을 멸하라~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/couple_encourage4.ogg"},{"voiceline":"['Z23'] : 난 설교가 싫다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/couple_encourage5.ogg"}],"메인4":{"voiceline":"위문품을... 잊어? ...... 보아하니 그대에게 생명이란 얼마나 약한 것인지를 깨닫게 해줘야겠구나, 인간.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"어서 일을 시작해라, 인간! ...... 게으름 피우지 마! 그럼 이 발톱으로 긁어주겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/main5_ex.ogg"},"메인6_ex":{"voiceline":"공부? ... 왜, 왜 내가 Z25들이 하는 그런 것을 해야하나... 싫다! 숙제를 주지 말거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401240/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":1},{"클뜯 id":401241,"클뜯 함순이 id":40124,"함순이 이름":"Z24","한글 함순이 + 스킨 이름":"「마왕」의 축제","영문 함순이 + 스킨 이름":"Festival-going Fiend","스킨 타입":"New Year Kimono","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401241/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401241/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401241/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401241/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401241/shipyard.png","설명":"축제의 종소리가 울려 퍼졌다, 잘 왔구나, 인간! 나의 곁에서 나와 함께 이 즐거운 이방의 명절을 즐겨 보거라!","자기소개":null,"메인1":{"voiceline":"그대에게 아름다운 칠흑의 열매를 맛 보여주지, 입을 벌려라, 인간!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401241/main1.ogg"},"메인2":{"voiceline":"모처럼의 축제날이니, 그대가 나에 대한 경외를 잠시 풀도록 허락해주지. 그 대신, 내가 피로를 푸는 동안 함께 해라!","voicelink":null},"메인3":{"voiceline":"\"떡\"이라는 요리는 맛은 있지만, 아쉬운 것이... 검은색 떡이 있는지를 모르겠구나...?","voicelink":null},"전투개시":null,"상세확인":{"voiceline":"\"신년\"이라도 마왕이라는 위의를 잃어서는 안 된다. 그러니 이 거대 발톱은 절대 벗을 수 없어! 물건을 들거나 하는 것은... 너의 임무다, 인간!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401241/detail.ogg"},"드랍 설명":{"voiceline":"축제의 종소리가 울려 퍼졌다, 잘 왔구나, 인간! 나의 곁에서 나와 함께 이 즐거운 이방의 명절을 즐겨 보거라!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"충분히 쉬었나? 그렇다면 나와 함께 의전에 놀러 가자. 이건 너에게 영광이라고, 인간!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401241/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"그렇게 내 옆에 있고 싶은가? 흐흥~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401241/touch.ogg"},"터치2":{"voiceline":"축제날이라고 해도, 안되는 일이 있는 것이다. 인간, 나에게 벌을 받을 준비가 되었는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401241/touch2.ogg"},"입수시":{"voiceline":"축제의 종소리가 울려 퍼졌다, 잘 왔구나, 인간! 나의 곁에서 나와 함께 이 즐거운 이방의 명절을 즐겨 보거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401241/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"정월","상점 id":70472,"상점 카테고리 id":2,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":800,"기간":"상시","진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":401242,"클뜯 함순이 id":40124,"함순이 이름":"Z24","한글 함순이 + 스킨 이름":"코트 위의 테우펠","영문 함순이 + 스킨 이름":"The Devil on the Court","스킨 타입":"Sports Time","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401242/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401242/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/Az