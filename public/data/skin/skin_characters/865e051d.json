[{"클뜯 id":801070,"클뜯 함순이 id":80107,"함순이 이름":"르 테리블","한글 함순이 + 스킨 이름":"르 테리블","영문 함순이 + 스킨 이름":"Le Terrible","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801070/shipyard.png","설명":"아이리스 리브레 르 팡타스크급 구축함—르 테리블","자기소개":{"voiceline":"저는 브레스트 제10분대 소속으로 많은 함선들을 호송했습니다. 그리고 로열 네이비의 포화 속에서 스트라스부르와 함께 황급히 탈출했었죠. 하늘의 보살핌을 받아 아이리스 리브레를 선택한 후 마침내 승리의 서광을 보았습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/profile.ogg"},"메인1":{"voiceline":"르 말랭 언니와의 과거요? 제가 이미 사과했습니다. 그녀는 아직 마음 속에 담아두고 있는 것 같지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/main1.ogg"},"메인2":{"voiceline":"음? 지휘관님 멍하니 계시는 것은, 설마 지금…… 아, 제 말은, 게으름은 좋지 않다는 것입니다. 르 트리옹팡에게서 들으셨겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/main2.ogg"},"메인3":{"voiceline":"근심의 사슬이 너무 많으면, 이상의 날개가 속박 당하게 됩니다. 지휘관님, 더 높게 더 멀리 날고 싶은 야심을 가져보신 적 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/main3.ogg"},"전투개시":{"voiceline":"당신들은 무엇을 위해 싸우나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/battle.ogg"},"상세확인":{"voiceline":"저는 \"남이 나를 건드리지 않으면, 나도 남을 건드리지 않는다\"는 주의입니다. 하지만 모항의 많은 동료들이 저와 속도 대결을 하자고 하네요…… 결국 그들 모두 졌지만. 이로 인해 여기서 많은 동료들을 알게 되었습니다——좋은 일이죠, 그렇지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/detail.ogg"},"드랍 설명":{"voiceline":"아이리스 리브레 르 팡타스크급 구축함—르 테리블","voicelink":null},"의뢰 완료":{"voiceline":"물자, 연료…… 이번 의뢰의 수확도 매우 풍부하군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/expedition.ogg"},"실망":{"voiceline":"참회하고 싶다면, 추기경님이 계신 곳으로 이동해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/feeling1.ogg"},"낯섦":{"voiceline":"기도도 아니고 참회도 아니라고요? 그런가요, 그럼 저도 다른 일을 하면서 시간을 보내야겠네요… 으음.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/feeling2.ogg"},"호감":{"voiceline":"그냥 수다떨기요? 그럼, 생명, 사랑, 그리고 자유, 지휘관님에게 가장 중요한 것은 무엇인가요? 하하하, 조급해하지 마세요. 지휘관님이 주저하며 고민하는 모습이 보고 싶어서 물어본 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/feeling3.ogg"},"기쁨":{"voiceline":"다음 질문입니다. 지휘관님께선 마음에 있는 사람에 대해, 상대를 구속하는 것이 좋으신가요, 아니면 구속 당하는 것이 좋으신가요? 하하, 다른 선택지는 없습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 어느 날 르 테리블이 사지로 달려가려 한다면, 저지하실 건가요?…… 음~ 이 질문은 너무 간단한 것 같네요. 아, 절대 일부러 지휘관님을 고민하게 하는 것이 아니에요. 더 많이 이해하고 싶은 것 뿐이라구요. 하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/feeling5.ogg"},"터치3":{"voiceline":"음, 제 모자는 손대지 말아 주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/headtouch.ogg"},"모항귀환":{"voiceline":"필요로 하셨던 자료는 모두 정리했고, 홍차와 디저트는 여기 있습니다. 차는 뜨거우니 조심하세요… 네? 벌써 식었다고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/home.ogg"},"hp 경고":{"voiceline":"아이리스가 저희를 보우할 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/hp_warning.ogg"},"로그인":{"voiceline":"어서 오십시오, 지휘관님. 르 테리블에게 분부하실 일이 있으십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/login.ogg"},"실패":{"voiceline":"실패와 좌절은, 아이리스 리브레를 무너뜨리기에는 역부족입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/lose.ogg"},"우편":{"voiceline":"만약 지휘관님이 우편을 찾지 못하신다면…… 아, 제 말은, 제가 이미 찾아왔다는 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/mail.ogg"},"임무":{"voiceline":"얼굴을 찌푸리고 계신 걸 보니, 혹시 이 임무들 때문에 골치 아프신 건가요? 그렇군요…… 하하~ 아, 아닙니다. 제 말은, 제 도움이 필요하신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/mission.ogg"},"임무완료":{"voiceline":"보상이 이렇게 많은데 지휘관님 혼자서 다 정리하실 수 있나요? 으음…… 아, 그러니까, 조수를 더 찾아보시면 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/mission_complete.ogg"},"서약":{"voiceline":"반지를 주셨지만, 정말 죄송합니다. 전 아마도——핫, 하하, 하하하♪~… 이건 신성한 서약의 의식이니, 장난치지 않을게요. \"당신과 영원히 함께할 수 있어, 르 테리블은 매우 기쁩니다\"——이게 저의 대답입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/propose.ogg"},"스킬":{"voiceline":"아이리스 꽃이여, 피어나라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/skill.ogg"},"터치1":{"voiceline":"기도하거나 참회할 때 절 찾아 주세요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/touch.ogg"},"터치2":{"voiceline":"엇? 지휘관님, 저에게 지휘관님의 약점이 하나 더 생긴 것 같군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/touch2.ogg"},"입수시":{"voiceline":"아이리스 리브레를 수호하는, \"우아함\"의 이름을 지닌 슈퍼 구축함 르 테리블, 지휘관님의 의지를 좇아왔습니다. 지휘관님, 지금까지 항상 분투해 오신 이유가 무엇입니까? 부디 이 르 테리블에게 보여주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/unlock.ogg"},"강화성공":{"voiceline":"누구도 자신이 이미 최강에 도달했다고 단언할 수 없습니다. 지휘관님은 어떻게 생각하세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"겸손할 필요 없습니다, 지휘관님. 신은 저희에게 승리의 길로 인도하셨고, 저희를 종점까지 인도하신 것은 지휘관님입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/win_mvp.ogg"},"전투개시_ex":{"voiceline":"신성한 심판을 받으세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님, 시간 되시면 좀 더 이야기 하실래요? 아니요, 특별한 목적 같은 건 없어요. 아시다시피 하루만 지휘관님의 얼굴을 못 봐도 속이 타서요. 고민하시는 표정도, 즐거워하는 표정도 오래 보고 싶어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘 기운이 넘치는 것 같아요. 그럼, 이제 제가 뭘 해야 하죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"임무 보상 여기 있어요. 후후, 자랑스러워하시는 표정이 멋지시네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"저를 찾아 고민을 상의하고 싶다면, 전 기쁠 거예요, 지휘관님♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/touch_ex.ogg"},"터치2_ex":{"voiceline":"여기도… 제 약점이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":{"voiceline":"하하하, 지휘관님 덕분이에요. 다시 또 강해진 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/upgrade_ex.ogg"},"승리_ex":{"voiceline":"어때요? 우아함이란 이름의 르 테리블이, 지휘관님을 위해 이 정도로까지 싸웠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['르 말랭'] : 게으름 피운다고 르 트리옹팡에게 말할 겁니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801070/couple_encourage1.ogg"},{"voiceline":"['르 트리옹팡'] : 네, 함께 싸워요!","voicelink":"https://raw.