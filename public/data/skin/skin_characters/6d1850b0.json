[{"클뜯 id":201070,"클뜯 함순이 id":20107,"함순이 이름":"불독","한글 함순이 + 스킨 이름":"불독","영문 함순이 + 스킨 이름":"Bulldog","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201070/shipyard.png","설명":"B급 구축함·불독 (H91)","자기소개":{"voiceline":"불독은 B급의 막내입니다. 암호 통신기와 암호서의 노획, 항복협정의 조인 등의 실적이 있습니다. 지휘관이 바보 분이 아니라면 가치를 알 것입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/profile.ogg"},"메인1":{"voiceline":"지휘관은 바보입니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/main1.ogg"},"메인2":{"voiceline":"제일 자신 있는 건 잠수함 퇴치입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/main2.ogg"},"메인3":{"voiceline":"지휘관? 제 머리에 3초 이상 손 올리면 깨물 거에요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/main3.ogg"},"전투개시":{"voiceline":"지휘관, 전투 중입니다. 집중해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/battle.ogg"},"상세확인":{"voiceline":"지휘관이 소중히 여겨주면 기쁩니다만, 이상한 기대를 하진 말아 주세요. 응, 이상한.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/detail.ogg"},"드랍 설명":{"voiceline":"B급 구축함·불독 (H91)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 언제 의뢰에 나갔는지도 잊으셨습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/expedition.ogg"},"실망":{"voiceline":"………………응?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/feeling1.ogg"},"낯섦":{"voiceline":"이 함대말입니까? 므읏…… 좋지는 않지만, 싫지도 않은, 정도입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/feeling2.ogg"},"호감":{"voiceline":"단장포쨩, 원래는 4대 있었습니다. A쨩과 Y쨩이 대잠 강화를 위해 퇴역해서 지금은 B쨩과 X쨩 뿐…… 아주 약간…… 외롭습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/feeling3.ogg"},"기쁨":{"voiceline":"자랑은 아닙니다만, 감정을 얼굴에 드러내지 않는 것에 자신 있습니다. 지휘관은 이런 무표정한 아이가 싫지 않다는 것입니까? ……과연, 지휘관은 변태시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 바보에 변태지만 불독은 그런 사람이 싫다고 말한 적은 없다구요? …그래도 자기보다 작은 여자아이에게 이런 걸 말하게 하다니 역시 바보에 변태시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 그런 기대하는 눈으로 바라봐도 과자는 안 줄 거예요? 지휘관은 어른이죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관은 함대를 생각해서 빨리 돌아온 것이라 생각합니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/login.ogg"},"실패":{"voiceline":"이길 때도 질 때도 있습니다. 딱히 대단한 게 아니에요. ……칫……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/lose.ogg"},"우편":{"voiceline":"「소통능력」이 낮더라도 다른 사람에게서 온 편지는 제대로 읽어 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/mail.ogg"},"임무":{"voiceline":"임무 완료해도 비서함이 주의하지 않으면 안 된다니, 정말 바보가 된다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/mission.ogg"},"임무완료":{"voiceline":"보수도 받으러 가지 않을 정도로 게으르게 되었습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 외출 준비는 되셨습니까? ……뭘 걱정하고 계신가요? 경찰에게 가는 거라고 생각했습니까? 믿음직하지 못한 어른이군요, 하아…… 좀 더 중요한 신고가 있잖아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/propose.ogg"},"스킬":{"voiceline":"B쨩, X쨩, 부탁드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/skill.ogg"},"터치1":{"voiceline":"무슨 일이죠? 지휘관의 개인적인 용무라면 거절하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/touch.ogg"},"터치2":{"voiceline":"B쨩, X쨩, 지휘관을 조준해──","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/touch2.ogg"},"입수시":{"voiceline":"반가워요. B급 구축함 불독입니다. ……어른이니까 외모로 사람을 판단하지 말아 주세요. 지휘관이 그러는 어른이 아니란 걸 기대하고 있습니다. 잘 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/unlock.ogg"},"강화성공":{"voiceline":"역시 지휘관은 제게 이상한 기대를 가지고 있으시군요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"당연한 것입니다. 어린이 취급해서 머리를 만지지 말아 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"N","ex_chat_status":0}]