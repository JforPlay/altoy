[{"클뜯 id":901030,"클뜯 함순이 id":90103,"함순이 이름":"보클랭","한글 함순이 + 스킨 이름":"보클랭","영문 함순이 + 스킨 이름":"Vauquelin","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901030/shipyard.png","설명":"비시아 성좌 보클랭급 구축함-보클랭 ","자기소개":{"voiceline":"(엄청나게 멋있는 자기소개를 하고 싶지만 됭케르크와 알제리를 호송한 것 빼고는 별로 내세울만한 이력이 딱히 없는데……)음, 그래. 나는 비시아 성좌의 보클랭. 곧 위대해질 함선이지! 어때!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/profile.ogg"},"메인1":{"voiceline":"지휘관, 굉장히 무료해보이는데 내가 총검무를 보여줄게! 히얍! 으악, 지휘관 조심해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/main1.ogg"},"메인2":{"voiceline":"지휘관, 부탁 하나 해도 될까? 음, 그게 있잖아…… 저녁 먹을 때 피망 빼도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/main2.ogg"},"메인3":{"voiceline":"응응. 응응응. 오오, 그렇구나. 이해했어. 지휘관, 나에게 맡겨줘! ——이상하잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/main3.ogg"},"전투개시":{"voiceline":"대형! 구축함의 힘을! 보여주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/battle.ogg"},"상세확인":{"voiceline":"지휘관, 갑자기 나타나면 깜짝 놀란단 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/detail.ogg"},"드랍 설명":{"voiceline":"비시아 성좌 보클랭급 구축함-보클랭","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료 알. 림 입니다——! 음음, 좋아. 평범하게 맞이하러 가야지. 그치?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/expedition.ogg"},"실망":{"voiceline":"지휘관, 그거 알아? 내가 가장 싫어하는 건 바로 자기 분수를 모르는 사람이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/feeling1.ogg"},"낯섦":{"voiceline":"흐흐흥~ 오늘 됭케르크의 케이크는 어떠려나~ 지휘관도 알아 맞춰봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/feeling2.ogg"},"호감":{"voiceline":"그러고 보니까 타르투가 전에 성숙한 여성이 되려면 어떻게 해야 하냐고 물어본 적이 있었거든? 그때 아무렇게나 추리 소설을 보면 된다고 대답을 해줬는데 진심으로 받아들이는 바람에…… 조금 미안해졌어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/feeling3.ogg"},"기쁨":{"voiceline":"진짜 바보는 모르겠고 가끔 바보인 척 하는 건 나쁘지 않아. 그러면 내가 똑똑한 대답을 했을 때 다들 와, 보클랭 대단해! 라고 하겠지? ……아마도?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/feeling4.ogg"},"사랑":{"voiceline":"하지만 바보인척 할 때는 정말 즐거워. 복잡한 생각은 안 해도 되고, 모두에게 즐거움도 줄 수 있잖아? 지휘관도 피곤하면 가끔 해보는 건 어떨까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/feeling5.ogg"},"터치3":{"voiceline":"에헤헤헤……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/headtouch.ogg"},"모항귀환":{"voiceline":"자, 지휘관. 상으로 머리를 만지게 해줄게…… 아하하, 그런 표정 짓지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/home.ogg"},"hp 경고":{"voiceline":"진정하고 기회를 찾아야 해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 디저트 가져다 준다고 하지 않았어? 내 디저트는!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/login.ogg"},"실패":{"voiceline":"에, 지휘관. 내 의견을 묻는 거야? 이런 일은 지휘관이 결정 해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/lose.ogg"},"우편":{"voiceline":"우편? 아, 내가 가져올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901030/mail.ogg"},"임무":{"voiceline":"임무? 흐흥, 드디어 내가 등장