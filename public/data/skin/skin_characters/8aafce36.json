ndo2603/AzurLane/main/audio/voiceline/101030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 왜? 나랑 이야기해도 딱히 재미 없을 텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/feeling2.ogg"},"호감":{"voiceline":"응, 뭐라 하면 좋을까…… 한가하면 같이 낮잠이라도 잘래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 요즘 잠버릇이 나빠. 항상 내 쪽으로 붙고…… 어? 내가 간 거라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 신사적이네…… 오히려 울컥해. 캐신…… 그렇게 매력 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"여동생한테서, 계속 틀어박혀 있으면 죽는다는 말을 들었어… 항상 있는 일인데, 그다지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"아무리 지휘관이라도 날 방에서 끄집어낼 수 없어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/login.ogg"},"실패":{"voiceline":"귀찮아… 역시 그냥 돌아가자…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/lose.ogg"},"우편":{"voiceline":"새로운 편지…… 봐보지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/mail.ogg"},"임무":{"voiceline":"응……아직 완료하지 않은 임무도 있는데, 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/mission.ogg"},"임무완료":{"voiceline":"보너스가 들어왔어…… 열심히 했나 보네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 줄곧 이걸 준비해준 거구나. 난 형식은 아무래도 좋아…… 그래도 고마워. 기뻐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101030/propose.ogg"},"스킬":{"voiceline":"돌아가고 싶어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/aud