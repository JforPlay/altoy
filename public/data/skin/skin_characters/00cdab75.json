[{"클뜯 id":10500040,"클뜯 함순이 id":1050004,"함순이 이름":"나츠이로 마츠리","한글 함순이 + 스킨 이름":"나츠이로 마츠리","영문 함순이 + 스킨 이름":"Natsuiro Matsuri","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500040/shipyard.png","설명":"나는 hololive 소속의 미소녀 여고생 나츠이로 마츠리!! 즐겁게 노래하거나 수다를 떠는 재미있는 방송을 하고 있으니 꼭 봐줘!!","자기소개":{"voiceline":"hololive 청순 담당, 나츠이로 마츠리, 참가! 치어리더이니만큼 응원은 나에게 맡겨줘! 지휘관도 전력으로 힘내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/profile.ogg"},"메인1":{"voiceline":"지휘관, 어디를 보고 있는 거야? 마츠리가 아무리 매력적이라도 적당히 해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/main1.ogg"},"메인2":{"voiceline":"지휘관! 여기에는 귀여운 여자애들이 많으니까 즐겁지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/main2.ogg"},"메인3":{"voiceline":"응? 지휘관도 연속 방송 하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/main3.ogg"},"전투개시":{"voiceline":"후후후, 적들에게 이 자연재해 같은 여고생의 전투력을 보여주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/battle.ogg"},"상세확인":{"voiceline":"이봐, 나를 보면서 ‘미안'이라는 말하지 말라고. 어쨌든 마츠리도 여자애란 말이야. 주의해줘. 미안하다면 마츠리의 귀여운 점을 말해보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/detail.ogg"},"드랍 설명":{"voiceline":"나는 hololive 소속의 미소녀 여고생 나츠이로 마츠리!! 즐겁게 노래하거나 수다를 떠는 재미있는 방송을 하고 있으니 꼭 봐줘!!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조의 아이들이 돌아왔어, 지휘관! 돌격 인터뷰를 하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/expedition.ogg"},"실망":{"voiceline":"계속 이렇게 하면…… 귀여운 여자애들은 마츠리가 전부 독점해버릴 거라구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/feeling1.ogg"},"낯섦":{"voiceline":"치어리더 공연은 체력을 많이 필요로 해. 지휘관, 어서 나랑 같이 체력 단련을 해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/feeling2.ogg"},"호감":{"voiceline":"지휘관은 청순하고 귀여운 목소리가 좋아? 그렇다면 바로 체인지~ ‘콘콘 여우~’ 헤헤, 대단하지? 나는 목소리를 마음대로 바꿀 수 있다고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 모처럼 둘만 있는데 나를 부르는 호칭을 바꿀 때가 되지 않았을까? 나츠쨩이나 마츠리쨩 중에 선택해봐~ 나츠 형? 무, 무슨 뜻이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/feeling4.ogg"},"사랑":{"voiceline":"마츠리와 함께 방송을 해줘서 고마워! 다음번에는 더 엄청난 소재를 들고 올게. 잘 부탁해, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/feeling5.ogg"},"터치3":{"voiceline":"마츠리가 고양이 귀 모드를 실행하면 만지기 더 좋을 거라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/headtouch.ogg"},"모항귀환":{"voiceline":"노래하고 춤추고 돌고~♪ 후, 열심히 했다. 땀이 엄청나네~ 아, 지휘관. 돌아온 걸 환영해. 나랑 같이 연습할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/home.ogg"},"hp 경고":{"voiceline":"이제 한계인 거야? 안심해. 마츠리는 좀 더 버틸 수 있으니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 안녕~ 오늘도 열심히 하자. 이상한 계획이 있을 거라고 기대하지는 마. 나는 초——진지한 브이튜버니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/login.ogg"},"실패":{"voiceline":"와아아! 천재 여고생인 마츠리가 지다니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/lose.ogg"},"우편":{"voiceline":"아, 지휘관에게 주는 우편이야. 지휘관도 의외로 인기가 많네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/mail.ogg"},"임무":{"voiceline":"임무가 끝이 없네… 지휘관, 이제 8시밖에 안 됐어. 정신 차리고 깔끔하게 처리해버리자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/mission.ogg"},"임무완료":{"voiceline":"임무의 보상이 한가득~ 헤헤, 저녁은 바베큐 먹으러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/mission_complete.ogg"},"서약":{"voiceline":"그동안 지휘관이 마츠리에게 계속 격려와 응원을 보내줬으니, 이제는 마츠리와 함께 즐거워질 차례야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/propose.ogg"},"스킬":{"voiceline":"기운 차리고 제대로 한바탕하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/skill.ogg"},"터치1":{"voiceline":"킁킁… 킁킁…… 귀여운 여자애들은 다 어디로 간 거지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/touch.ogg"},"터치2":{"voiceline":"와아아아! 마…… 마츠리에게 손을 대는 건 절대 금지사항이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/touch2.ogg"},"입수시":{"voiceline":"나는 hololive 소속의 미소녀 여고생 나츠이로 마츠리!! 즐겁게 노래하거나 수다를 떠는 재미있는 방송을 하고 있으니 꼭 봐줘!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/unlock.ogg"},"강화성공":{"voiceline":"예~! 더 강해진 것 같아! 대단해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"MVP는 내가 가져가겠어☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['후부키', '시라카미 후부키'] : 후부킹↓, 후부킹↑후부킹↑ 후부킹!!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/couple_encourage1.ogg"},{"voiceline":"['아크 로열'] : 말할 필요 없어. 그런 눈빛, 알고 있으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/couple_encourage2.ogg"}],"메인4":{"voiceline":"올팬? 맞아. 마츠리는 확실히 올팬이야. 모든 방면에서 말이지. 지휘관도 올팬이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500040/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HOLO","레어도":"SR","ex_chat_status":0},{"클뜯 id":10500041,"클뜯 함순이 id":1050004,"함순이 이름":"나츠이로 마츠리","한글 함순이 + 스킨 이름":"마츠리의 일상생활","영문 함순이 + 스킨 이름":"Matsuri's Day Off","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500041/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500041/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500041/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500041/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10500041/shipyard.png","설명":"파자마로 갈아입고 청순함이 2배가 된 여고생, 나츠이로 마츠리야! 이봐, 지휘관! 이 모습 어때? 놀랐어? 홀라당 반하면 큰일 난다구~","자기소개":null,"메인1":{"voiceline":"하루 종일 집에 틀어박혀 있는 건 안 돼. 이렇게 입고 외출하자! 엑, 안돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500041/main1.ogg"},"메인2":{"voiceline":"다른 동료들과 같이 파자마 방송을 하고 싶어~ 파자마니까 서로 편하게 끌어안고 비비적 할 수 있어서 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500041/main2.ogg"},"메인3":{"voiceline":"지휘관의 머릿속에는 분명 [마츠리의 