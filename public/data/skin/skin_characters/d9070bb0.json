[{"클뜯 id":205100,"클뜯 함순이 id":20510,"함순이 이름":"밸리언트","한글 함순이 + 스킨 이름":"밸리언트","영문 함순이 + 스킨 이름":"Valiant","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205100/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205100/shipyard.png","설명":"퀸 엘리자베스급 전함-밸리언트, 현호02","자기소개":{"voiceline":"나는 퀸 엘리자베스급의 밸리언트다. 유틀란트부터 극동까지 모두 나 밸리언트가 용맹하게 전투에 참여했었지. 그리고 앞으로 내가 이 함대를 이끌고 계속 항해할거야. 나의 유능한 하인으로서 날 잘 보좌할거라고 믿는다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/profile.ogg"},"메인1":{"voiceline":"하인, 나 목말라. 메이드들에게 가서 홍차를 준비…아니야. 그러면 너무 늦지. 하인, 오늘의 차는 자네에게 맡길게. 문제 없지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/main1.ogg"},"메인2":{"voiceline":"지휘관이 되는데 가장 중요한 것은 바로 카리스마야. 카리스마가 있어야 위엄이 있어서 모두가 자네의 말을 따르게 되지. 알겠어, 하인?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/main2.ogg"},"메인3":{"voiceline":"디저트 타임!?... 큼흠… 업무와 휴식을 합리적으로 짜는 것도 지휘관으로서 가져야할 자질 중 하나지. 잘 배우라고, 하인!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/main3.ogg"},"전투개시":{"voiceline":"내 지휘를 들어라! 모두 공격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/battle.ogg"},"상세확인":{"voiceline":"엘리자베스는 지도자로서는 약간 지나치게 제멋대로야. 워스파이트 그녀들이 너무 오냐오냐 했어. 역시 이곳은 당연히 내가…응? 어떤 의미에서는 나도 다를바 없다고…? 무슨 말하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/detail.ogg"},"드랍 설명":{"voiceline":"퀸 엘리자베스급 전함-밸리언트, 현호02","voicelink":null},"의뢰 완료":{"voiceline":"으흠, 의뢰조는 매우 순조로운 것 같군. 나 대신 잘 위로해줘, 하인.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/expedition.ogg"},"실망":{"voiceline":"원래는 너에게 약간의 기대감이 있었어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/feeling1.ogg"},"낯섦":{"voiceline":"하인, 마침 잘왔어. 일이 끝났으면 나와 함께 체스 몇 판 두자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/feeling2.ogg"},"호감":{"voiceline":"너…너의 체스 실력이 이렇게 뛰어날 줄은 예상 못했네. 앞, 앞으로 좀 진지하게 상대해주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/feeling3.ogg"},"기쁨":{"voiceline":"잠,잠깐! 체스를 두기로 했다면, 모든 상황을 고려해야지. 방금 그 수는 내가 미처 보지 못해서 하인 네가 빈틈을 파고든 것일 뿐이야! 그러니까, 이…이번 수는 아닌 걸로 해야지! 하인, 이해하겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/feeling4.ogg"},"사랑":{"voiceline":"하인으로서 당연히 상관의 마음을 살펴야지… 내,내 뜻은 내가 한번은 이기도록 해줄 때란 말이지.(작은 소리로) 항상 너에게 지니까, 내가 체스에 자신감이 다 없어지겠다고… 암, 암튼! 네가 한번 져줘야돼! 거기다 일부러 져준다는 걸 내가 모르게! 이건 명령이야! 알겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/feeling5.ogg"},"터치3":{"voiceline":"너, 너…뭐하는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/headtouch.ogg"},"모항귀환":{"voiceline":"하인, 전투 상황은 어때? 내게 자세하게 말해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/home.ogg"},"hp 경고":{"voiceline":"하인… 어… 어서 날 보호할 방법을 생각해봐…! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/hp_warning.ogg"},"로그인":{"voiceline":"하인, 마침 잘 왔어. 오늘의 보고서를 가져와라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/login.ogg"},"실패":{"voiceline":"으윽…어떻게 이럴수가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/lose.ogg"},"우편":{"voiceline":"쳇! 왜 우편물이 모두 하인 너에게 가는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/mail.ogg"},"임무":{"voiceline":"이런 사소한 임무는 하인 너에게 맡기겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/mission.ogg"},"임무완료":{"voiceline":"사소한 임무일지라도 네가 훌륭하게 끝냈다면 마땅히 포상을 받아야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/mission_complete.ogg"},"서약":{"voiceline":"음, 아주 좋아. 너를 본 지휘관의 가장 믿을 만한 하인으로 인정하겠네! 네가 쭉 이렇게 충성을 다한 것을 봐서 특별히 내 곁에서 계속 나의 위대함을 체험할 수 있도록 허락하겠어, 이 반지를 우리 주종 관계의 증표로 하자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/propose.ogg"},"스킬":{"voiceline":"모든 것은 손바닥 안에 있어! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/skill.ogg"},"터치1":{"voiceline":"일이 있으면 얼마든지 말해. 내가 듣고 있을테니까, 하인.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/touch.ogg"},"터치2":{"voiceline":"너 뭐하는 거야!?... 하인을 너그럽게 대하는 것도 상급자가 가져야할 배포지. 이번은 그냥 넘어가겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/touch2.ogg"},"입수시":{"voiceline":"밸리언트, 내 이름이다. 이 함대를 이끌 사람의 이름이기도 하지. 가슴에 잘 새겨두도록…… 헌데, 넌 누구지? 지휘관…? 알았다. 하인이랑 비슷하게 여기면 되겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/unlock.ogg"},"강화성공":{"voiceline":"휴우~ 잘했어, 하인. 무슨 상을 갖고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"정확한 지휘와 용감한 전투는 완벽한 승리지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"일이 이렇게 됐으니, 승패는 이미 상관없어졌어. 나에겐 하인 너와 함께한 시간이야말로 가장 즐거운 시간이야.… 너도 그렇게 생각해? 그럼 정말 다행이다! 우리 다시 한 판 하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/m