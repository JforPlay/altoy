[{"클뜯 id":403080,"클뜯 함순이 id":40308,"함순이 이름":"론(μ장비)","한글 함순이 + 스킨 이름":"론(μ장비)","영문 함순이 + 스킨 이름":"Roon μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403080/shipyard.png","설명":"중순양함 론, 장비 테스트 임무를 위해 절찬 아이돌 활동 중입니다. 이번에는 함포가 아닌 노랫소리를 무기 삼아서 전투를 치르는 것이군요.","자기소개":{"voiceline":"메탈 블러드의 순양함 론, 현재 특수한 \"μ장비\"를 착용 중입니다. 특수하다고는 하지만 결국은 전투를 위해서 태어난 것, 역시 이걸로 무엇을 망가뜨릴 수 있을지 기대되네요. 지휘관님, 잘 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/profile.ogg"},"메인1":{"voiceline":"노래의 힘으로 동료를 치유하고, 또 적을 해치운다… 후후후, 굉장히 간단명료하군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/main1.ogg"},"메인2":{"voiceline":"사쿠라 엠파이어는 마음이 약하다고 해야 할지, 내성이 없다고 해야 할지…… 어떻게 지내면 좋을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/main2.ogg"},"메인3":{"voiceline":"노래에는 진심을 담아야 해요… 잘 하지는 못하지만 노력할게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/main3.ogg"},"전투개시":{"voiceline":"감히 우리 앞을 막다니? 정말… 용서할 수 없군요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/battle.ogg"},"상세확인":{"voiceline":"모두와 함께 아이돌 활동을 하는 것도 재밌지만… 장비 테스트를 소홀히 하고 있는 것 아닌가요? 음… 디테일에 집착하지 않는 편이 좋겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 론, 장비 테스트 임무를 위해 절찬 아이돌 활동 중입니다. 이번에는 함포가 아닌 노랫소리를 무기 삼아서 전투를 치르는 것이군요.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아온 모양이네요. 지휘관님도 이렇게 하고 싶으신 건가요? 줄 서면 하나하나 꼭 안아 줄게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/expedition.ogg"},"실망":{"voiceline":"지휘관님도 \"적\"이 되고 싶으신 건가요? 후후후, 하하하하하……!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/feeling1.ogg"},"낯섦":{"voiceline":"모두 지휘관님을 위해서 열심히 아이돌 활동을 하고 있네요~ 저요? 물론 저도 그렇지요~ 지휘관님을 위해서 웃고 있답니다…… 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/feeling2.ogg"},"호감":{"voiceline":"계속 아이돌 활동을 하고 있지만 미묘한 공허감이 느껴져요… 전투… 아니, 적을 처치할 기회가 적어져서 그러는 걸까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 응원차 콘서트에 와주신 걸 보니 마음이 꽉 차오르는 것 같아요… 음… 지휘관님의 시간, 목숨을… 모두 저에게 써버린… 그런 느낌?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/feeling4.ogg"},"사랑":{"voiceline":"전장에서 적을 죽이는 것이 가장 기분 좋은 일이라고 생각했는데, 지휘관님께서 다른 즐거움을 알려주셨네요… 후후, 저를 이렇게 바꿔놓으시다니… 쉽게 용서하지 않을 거예요, 지휘관님♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/feeling5.ogg"},"터치3":{"voiceline":"머리 쓰담쓰담~ 인가요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/headtouch.ogg"},"모항귀환":{"voiceline":"작전 수고하셨습니다. 레슨 때 챙겨주셨던 것에 대한 보답으로 저도 지휘관님을 위해 먹을 것을 만들었어요. 드셔보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/home.ogg"},"hp 경고":{"voiceline":"방해하는 것은…… 용서하지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 오늘은 뭘 해야 하나요? 지시를——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/login.ogg"},"실패":{"voiceline":"음… 역시 평범한 무기를 쓰는 것이 좋을까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/lose.ogg"},"우편":{"voiceline":"우편이 왔네요. 무슨 내용일까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/mail.ogg"},"임무":{"voiceline":"임무가 있나요? 좋아요~ 반드시 저를 데려가 주셔야 해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/mission.ogg"},"임무완료":{"voiceline":"오퍼를 열심히 받아오셨네요. 지휘관님, 대단해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/mission_complete.ogg"},"서약":{"voiceline":"\"이렇게 아름다운 것을 망가뜨리면 아쉬울 것 같네요\"—— 제 콘서트가 이렇게 멋진 일이라는 사실을 처음 깨달았어요. 저는 무대 위에서 더욱 빛나면서… 지휘관님의 시간과 생명을 빼앗을 거랍니다—— 영원히요♪ 후후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/propose.ogg"},"스킬":{"voiceline":"방해를 하다니…!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/skill.ogg"},"터치1":{"voiceline":"포옹이 필요한가요? 언제든지 환영이랍니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/touch.ogg"},"터치2":{"voiceline":"조금 있다가 \"친밀한 스킨십\"을 하러 오는 걸 잊지 마세요, 지휘관님~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/touch2.ogg"},"입수시":{"voiceline":"중순양함 론, 장비 테스트 임무를 위해 절찬 아이돌 활동 중입니다. 이번에는 함포가 아닌 노랫소리를 무기 삼아서 전투를 치르는 것이군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/unlock.ogg"},"강화성공":{"voiceline":"목소리로 하는 싸움이라니, 재밌겠네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아… 감정이 고조되기 시작했어요… 역시 적을 부숴버릴 때만이 흥분되는군요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편