[{"클뜯 id":403130,"클뜯 함순이 id":40313,"함순이 이름":"꼬마 슈피","한글 함순이 + 스킨 이름":"꼬마 슈피","영문 함순이 + 스킨 이름":"Little Spee","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403130/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403130/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403130/shipyard.png","설명":"도이칠란트급 장갑순양함—꼬마 슈피","자기소개":{"voiceline":"메탈 블러드 해군 도이칠란트급 장갑함 아드미랄 그라프 슈피라고 해. 난 평범한 중순양함들보다 더 강해! 화포 구경이 더 크니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/profile.ogg"},"메인1":{"voiceline":"지휘관은 업무에 집중하고 있어서, 놀 시간이 없구나…… 슈피는 착한 아이야, 지, 지휘관을 방해하면 안 돼…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main1.ogg"},"메인2":{"voiceline":"지휘관! 이거 껴봐——헷, 됐다! 이제 지휘관도 \"메탈 건틀렛\"이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main2.ogg"},"메인3":{"voiceline":"친구들이랑 이야기하는 거 정말 재밌어! 어떨 때는 맛있는 음식 얘기, 어떨 때는 재밌는 놀거리 얘기 그리고…… 헤헤, 아무튼 뭐든 얘기해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main3.ogg"},"전투개시":{"voiceline":"모항의 친구들을 위해 힘낼 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/battle.ogg"},"상세확인":{"voiceline":"만약 네가 위험에 처하면 내가 지켜줄 거야. 우리는 친구니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/detail.ogg"},"드랍 설명":{"voiceline":"도이칠란트급 장갑순양함—꼬마 슈피","voicelink":null},"의뢰 완료":{"voiceline":"우와, 엄청 많다! 이게 다 의뢰 보상이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/expedition.ogg"},"실망":{"voiceline":"지휘관, 날 내버려두지마…… 부탁이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/feeling1.ogg"},"낯섦":{"voiceline":"지휘관은 슈피가 모항에서 사귄 첫 번째 친구야! 헤헤, 난 이 메탈 건틀렛에 지휘관이 놀랄 줄 알았는데. 이건 악당들에게 겁줄 때만 사용해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/feeling2.ogg"},"호감":{"voiceline":"에이잭스 언니는 좋은 사람이야, 언제나 나랑 놀아줘. 하지만 도이칠란트 언니가 에이잭스 언니는 나쁜 사람이래…… 아 참! 에이잭스 언니가 말하는 \"아기 돼지\"가 무슨 말이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/feeling3.ogg"},"기쁨":{"voiceline":"항상 슈피랑 함께 해줘서 고마워! 지휘관! 슈피도 친구들을 많이 사귀었어. 모두와 함께 강해지면서 즐거운 나날을 보내고 있지! 고마움의 표시로 포옹하게 해줘~ 헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 슈피의 베스트 프렌드야. 지휘관이 제일 좋아! 우리 손가락 걸고 약속하자, 앞으로도 계속 좋은 친구하기로! 아, 메탈 건틀렛이 너무 크네…… 그럼 지휘관이 건틀렛 새끼손가락을 잡아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/feeling5.ogg"},"터치3":{"voiceline":"으왓! 까, 깜짝이야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/headtouch.ogg"},"모항귀환":{"voiceline":"Zzz… 후… 지휘관은…… 언제 돌아오는 걸까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/home.ogg"},"hp 경고":{"voiceline":"더, 더 이상 못 견딜 것 같아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관, 돌아왔구나. 난 이제 혼자가 아니야, 헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/login.ogg"},"실패":{"voiceline":"으앙…… 지휘관…… 집에 가고 싶어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/lose.ogg"},"우편":{"voiceline":"지휘관, 네 우편! 음, 편지 봉투는 너무 작아서 들기 불편해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/mail.ogg"},"임무":{"voiceline":"지휘관, 임무 완료하면 나랑 같이 있어줄 거야? 아, 임무가 너무 많으면 됐고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/mission.ogg"},"임무완료":{"voiceline":"임무 끝났어? 좋아! 언제쯤 슈피도 지휘관을 도와줄 수 있을까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/mission_complete.ogg"},"서약":{"voiceline":"와——! 슈피가 날고 있어! 지금 내가 지휘관보다도 더 커! 헤헤~ 저기, 지휘관, 좀 더 안아줄 수 있어? 그리고, 항상 나랑 같이 있겠다는 약속 꼭 기억해. 절대로 잊으면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/propose.ogg"},"스킬":{"voiceline":"내 친구를 괴롭히지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/skill.ogg"},"터치1":{"voiceline":"지휘관, 또 안아줘——헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/touch.ogg"},"터치2":{"voiceline":"앗! 도이칠란트 언니가 그랬는데, 지휘관이 여기에 손대면 조각조각 찢어버린다고…… 내, 내가 말릴게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/touch2.ogg"},"입수시":{"voiceline":"안녕, 메탈 블러드 해군 소속 아드미랄 그라프 슈피라고 해… 음, 난 여기서 친구들을 많이 사귀고 싶어. 나랑 친구가 되어줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/unlock.ogg"},"강화성공":{"voiceline":"이 새로운 힘으로 내 친구들을 잘 보호할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관, 악당 녀석들은 내가 쫓아냈어. 이제 아무도 우릴 괴롭힐 수 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/win_mvp.ogg"},"전투개시_ex":{"voiceline":"모항의 친구들을 위해, 그리고 가장 중요한 지휘관을 위해, 힘낼 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/battle_ex.ogg"},"상세확인_ex":{"voiceline":"사실, 난 싸우는 걸 별로 좋아하지 않아…… 하지만 어떤 악당들을 물리치지 않으면 친구들이랑 매일 즐겁게 놀 수 없다는 것도 알아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":{"voiceline":"헤헤, 기분 좋아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"후…… 후…… 지휘관…… 아직도 안 왔네…… 보고 싶은데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 돌아왔구나! 헤헤, 오늘의 허그해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"헤헤, 이제 \"메탈 건틀렛\"을 익숙하게 다룰 수 있어——아, 시, 실수로 너무 힘을 줘버렸어! 편지가…… 미, 미안해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/mail_ex.ogg"},"임무_ex":{"voiceline":"지휘관, 새로운 임무 있어? 나도 도와주고 싶어. 아주 조금이라도 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 완료했어! 헤헤, 많은 일을 하진 못했어도 이번엔 내가 지휘관의 일을 도와줬어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관의 허그, 좋아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/touch_ex.ogg"},"터치2_ex":{"voiceline":"음? 그러니까 여기에 무슨 특별한 게 있는 거야? 지휘관은 다른 언니들한테도 이렇게 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['도이칠란트'] : 도이칠란트 언니, 계속 나만 지켜보고 있지 않아도 돼……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/couple_encourage1.ogg"},{"voiceline":"['에이잭스'] : 에이잭스 언니, 나쁜 사람 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/couple_encourage2.ogg"},{"voiceline":"['꼬마 리나운'] : 우, 우리 친구할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/couple_encourage3.ogg"}],"메인4":{"voiceline":"없네…… 아, 내 말은, 과자가 없다고. 손가락 끝에 끼우는 그 과자. 아카시 상점에서 조금 샀어… 안 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"아, 지휘관, 슈피는 신경쓰지 않아도 돼! 지휘관이 업무에 집중할 때는 방해하지 않을 거니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main6_ex.ogg"},"메인7_ex":{"voiceline":"지휘관도 과자 먹고 싶다고…? 알았어!… 아, 메탈 건틀렛을 벗어야지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main7_ex.ogg"},"메인8_ex":{"voiceline":"지휘관! 새로운 친구를 많이 사귀었어도 널 절대 잊지 않을 거야! 지휘관은 내 마음 속에서 영원히 첫 번째라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"\"메탈 블러드… 최고 귀요미…\"？ 도이칠란트 언니, 이게 뭐야…？","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"저기, 꼬마 리나운이다! 꼬마 리나운ー! 응? 반응이 없네… 꼬마 리나운이 아닌가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403130/main9_ex.ogg"},"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":1}]