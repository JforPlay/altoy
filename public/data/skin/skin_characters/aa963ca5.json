[{"클뜯 id":303140,"클뜯 함순이 id":30314,"함순이 이름":"초카이","한글 함순이 + 스킨 이름":"초카이","영문 함순이 + 스킨 이름":"Choukai","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303140/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303140/shipyard.png","설명":"타카오급 중순양함 4번함 - 초카이 ","자기소개":{"voiceline":"타카오급 중순양함 4번함, 초카이입니다. 한때는 제 8함대의 기함으로서 수많은 해전에서 활약했습니다. 지휘관님, 무엇이든 초카이에게 맡겨주시기 바랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/profile.ogg"},"메인1":{"voiceline":"지휘관님은 역시 상냥하시네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/main1.ogg"},"메인2":{"voiceline":"지휘관님, 언제 외출하기 좋은 날에 민들레 구경이라도 함께 가지 않으시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/main2.ogg"},"메인3":{"voiceline":"지휘관님, 잠시 쉬지 않으시겠어요? 실은 이런 때를 대비해서, 피로 회복에 좋은 마사지를 공부해뒀답니다! 부디 사양 마시길~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/main3.ogg"},"전투개시":{"voiceline":"전 함선 상황 확인…… 포격전 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/battle.ogg"},"상세확인":{"voiceline":"에, 따분하지 않냐고요…? 괜찮습니다. 아무것도 하지 않아도, 지휘관님과 함께라면 초카이는 즐겁답니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/detail.ogg"},"드랍 설명":{"voiceline":"타카오급 중순양함 4번함 - 초카이","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰 완료, 보수 물자는…… 네! 전부 빠짐없이 적어두었습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/expedition.ogg"},"실망":{"voiceline":"지휘관님, 같이 힘내자구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 잠시 휴식하는 건 어떠신가요? …초카이의 노래가 듣고싶으시다구요? 으~음, 그렇다면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 오늘 저녁 메뉴는 뭐가 좋을까요? 으~음, 초카이가 정해도 괜찮나요? …야채를 넣은 크림 스튜나 돈까스, 둘 중 하나로 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님께서 즐거워하시는 게, 초카이의 가장 큰 행복이랍니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/feeling4.ogg"},"사랑":{"voiceline":"초카이는 지휘관님을 위해서라면 뭐든지 할 수 있다구요? ……지휘관님도 마찬가지라구요? 후후… 초카이는 지금 무척 행복해요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격 수고하셨습니다. 서류 작업은 초카이에게 맡겨주시고, 잠깐이라도 쉬셔요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/home.ogg"},"hp 경고":{"voiceline":"아직…… 괜찮습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 어서 오세요. 서류는 초카이가 정리해두었습니다. 그리고… 여기 쿠키는 어떠신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/login.ogg"},"실패":{"voiceline":"아직…… 싸울 수 있습니다! 더 이상 누구도 잃고 싶지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/lose.ogg"},"우편":{"voiceline":"지휘관님, 우편 내용을 읽어드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/mail.ogg"},"임무":{"voiceline":"지휘관님, 새로운 임무 목록을 정리해두었습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 해냈어요! 임무를 무사히 완료했습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/mission_complete.ogg"},"서약":{"voiceline":"으~음, 지휘관님께서 응해주시리라곤 생각도 못 했습니다만… 지휘관님께서 진심이시라면, 초카이는… 물론, 기쁘게 받도록 하겠습니다♪ 지휘관님, 이 행복의 반지, 끼워주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/propose.ogg"},"스킬":{"voiceline":"상냥한 건… 동료에게만이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/skill.ogg"},"터치1":{"voiceline":"해님이 떠 있는 동안 어디서 산책이라도 하시는 건 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/touch.ogg"},"터치2":{"voiceline":"지, 지휘관님께서 하고 싶다 말씀하시는 거라면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/touch2.ogg"},"입수시":{"voiceline":"마야의 동생, 초카이입니다. 앞으로 잘 부탁드립니다. 저기… 그러고보니 지휘관님과는 어디서 만난 적이 있는 것 같네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/unlock.ogg"},"강화성공":{"voiceline":"감사합니다. 이 초카이, 삼가 지휘관님을 위해 이 힘을 쓰겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/upgrade.ogg"},"vote":null,"승리":{"voiceline":"함께 신나게 싸워서 이기자구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['히에이'] : 이번에도 잘 부탁드립니다","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/couple_encourage1.ogg"},{"voiceline":"['마야'] : 함께 힘내자구요! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303140/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex