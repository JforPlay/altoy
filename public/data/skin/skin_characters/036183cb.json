73/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205073/shipyard.png","설명":"아름다운 아도니스여, 어찌 그대는 상자 속에 남아 총애받는 것을 원하지 않는가——지금 모습이 그대의 마음을 또 사로잡을 수 있을까? 후후훗.","자기소개":null,"메인1":{"voiceline":"웨일즈, 아도니스를 어찌 너에게 빼앗기겠는가... 그대의 체면을 생각해서, 그의 시간을 독차지하여 그대와 삼등분을 해도 안 될 것은 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205073/main1.ogg"},"메인2":{"voiceline":"아아, 바로 이 눈빛이다. 자제하고 싶지만 어느샌가 패배해버리고 마는 눈빛——두 눈동자로 영원히 나를 사로잡거라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205073/main2.ogg"},"메인3":{"voiceline":"그대는 승리할 가망이 전혀 없다——이 경기의 뜨거운 분위기나, 감미롭고 절대적인 나의 존재 모두——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205073/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"다른 사람에게 빼앗길 수 있는 사랑은 결코 좋은 것이 아니다. 그대가 완전히 나의 소유가 되어야만, 충분한 시간을 들여 함께할 가치가 있다——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205073/detail.ogg"},"드랍 설명":{"voiceline":"아름다운 아도니스여, 어찌 그대는 상자 속에 남아 총애받는 것을 원하지 않는가——지금 모습이 그대의 마음을 또 사로잡을 수 있을까? 후후훗. ","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":null,"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"마음에 드는가? 그대가 선택한 이 옷이 가장 그대를 흥분시킬 수 있겠지——정확하지 않는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205073/touch.ogg"},"터치2":{"voiceline":"독사는 금단의 열매를 탐내는 법——그대의 소망, 본성, 모든 것이 내게는 손바닥 보듯 훤하다. 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205073/touch2.ogg"},"입수시":{"voiceline":"아름다운 아도니스여, 어찌 그대는 상자 속에 남아 총애받는 것을 원하지 않는가——지금 모습이 그대의 마음을 또 사로잡을 수 있을까? 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205073/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"샴페인보다는 와인이 내 취향에 맞지만... 괜찮다, 그대가 원하는 대로 축하하자.","voicelin