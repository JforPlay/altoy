[{"클뜯 id":205070,"클뜯 함순이 id":20507,"함순이 이름":"듀크 오브 요크","한글 함순이 + 스킨 이름":"듀크 오브 요크","영문 함순이 + 스킨 이름":"Duke of York","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205070/shipyard.png","설명":"킹 조지 V급 전함 - 듀크 오브 요크 (HMS Duke of York)","자기소개":{"voiceline":"난 킹조지 V급의 듀크 오브 요크. 샤른호르스트? 재미있는 아이지만, 지금은 그대에게 더 흥미가 생기는군……저기, 그런 얼굴 하지 말아줄래? 아무리 나라도 참기 힘들어지니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/profile.ogg"},"메인1":{"voiceline":"전투의 비결? 후후, 난 그저 적이 찢어발겨지는 광경을 떠올릴 뿐이야. 그러면 적이 내 생각대로 되어주는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/main1.ogg"},"메인2":{"voiceline":"웨일즈, 또 내 포획물에 손을 댈 셈인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/main2.ogg"},"메인3":{"voiceline":"안심하고 눈을 감도록. 내 가슴에 안겨있는 한은, 아무것도 생각하지 않아도 되니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/main3.ogg"},"전투개시":{"voiceline":"죄 깊은 선혈의 꽃이여, 나의 곁에 만발하거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/battle.ogg"},"상세확인":{"voiceline":"나와 만나지 못한 것이, 그렇게나 그대를 애태우게 하였는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/detail.ogg"},"드랍 설명":{"voiceline":"킹 조지 V급 전함 - 듀크 오브 요크 (HMS Duke of York)","voicelink":null},"의뢰 완료":{"voiceline":"매혹적인 나르키소스여, 부디 매사에 신중을 기해주게. 절대 이 바다에 비치는 환영에 매혹되지 않도록…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/expedition.ogg"},"실망":{"voiceline":"조금 더 난폭해져도…좋을 것 같네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/feeling1.ogg"},"낯섦":{"voiceline":"좋은 눈매야. 그대의 눈동자에서 또 다른 세계가 보여.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/feeling2.ogg"},"호감":{"voiceline":"그대의 그 얼굴, 내게 있어선 유혹 이외에 아무것도 아니야…저기, 그대의 선혈은 날 어디까지 취하게 해줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/feeling3.ogg"},"기쁨":{"voiceline":"이상한 일이지…그대의 자는 얼굴을 보고 있자면 내 마음이 놓이게 돼……저기, 절대 눈 뜨지 마… 지금 그대의 눈동자를 보게 되면, 난 참을 수 없게 되어버릴 테니까……우후후","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/feeling4.ogg"},"사랑":{"voiceline":"무지한 뱀이여, 이제야 겨우 깨달았는가? 나는 이미 그대에게 빠져있다는 것을……그럼 그대의 모든 것을, 내게 바쳐주지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"개선의 나이팅게일이여, 죽음을 이겨낸 그대가 굳이 입을 다물고 있는 것은 대체 무엇 때문인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/home.ogg"},"hp 경고":{"voiceline":"조금 과하게 빠져들었나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/hp_warning.ogg"},"로그인":{"voiceline":"부정한 뱀이여, 그대는 지금 누구를 떠올리고 있는 것인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/login.ogg"},"실패":{"voiceline":"아아…어째서 얌전히 따르지 않는 것인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/lose.ogg"},"우편":{"voiceline":"집중하고 있는 그대는, 실로 옛 미켈란젤로의 조각상과 같아……싫지는 않네만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/mail.ogg"},"임무":{"voiceline":"날이 이 정도로 쾌청한데, 이대로 모항에 돌아갈 정도로 풍류를 모르는 짓은 하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/mission.ogg"},"임무완료":{"voiceline":"달 밝은 밤에 감로라……기대되는군. 오늘 밤이야말로, 그대에게 잊지 못할 밤이 될 테니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/mission_complete.ogg"},"서약":{"voiceline":"천재 시인이라도, 지금 그대의 사랑스러움을 글로 담을 순 없을 거야. 우후후…눈을 감고, 내 온기를 느껴, 내 마음의 소리에 귀를 기울여줘. 나야말로 그대 인생의 반려자가 될 자이니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/propose.ogg"},"스킬":{"voiceline":"그대여, 자신의 멸망에 한탄하거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/skill.ogg"},"터치1":{"voiceline":"밤은 길고도 짧은 법이지. 자, 그대를 비추는 빛을 꺼버리고, 내게 어울려주실까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/touch.ogg"},"터치2":{"voiceline":"아름답구나. 평소 태연한 그대의 눈이, 이렇게나 정욕의 불꽃에 타오르고 있을 줄이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/touch2.ogg"},"입수시":{"voiceline":"그렇군. 나를 미치게 하는 향기를 내는 건, 그대의 혼인가……죄 깊은 지휘관이여, 내가 바로 로열 네이비의 듀크 오브 요크다. 나의 이 이름, 제대로 마음에 새겨주게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/unlock.ogg"},"강화성공":{"voiceline":"내 전신을 끓어오르게 만드는 선혈의 광조…그대에겐 느껴지는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"산 자는, 가라앉은 자에게 끌려들어가는 게 운명……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/win_mvp.ogg"},"전투개시_ex":{"voiceline":"나의 눈동자와 함께 선홍빛으로 물들이자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"죄업이 무거운 뱀이여, 그대는 내 곁에 속박되어 영원히 사랑을 받으리라——교환하는 것이다. 그대는 나의 총애를 받고, 나는 그대에게 나를 안을 권리를 주는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"나의 총애를 얻은 지휘관, 그대는 지금 무얼 생각하고 있는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"한 몸으로 융합하자. 그대가 되든, 내가 되든, 혹은 다른 모든 것으로든——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"적색을 파괴하기 전에 녹여버리자. 찢고 파괴하기만 하는 걸로는 내겐 부족하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['프린스 오브 웨일즈'] : 당신의 소행은 언젠가 그 대가를 치를 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/couple_encourage1.ogg"},{"voiceline":"['샤른호르스트'] : 소용없는 발버둥은 그만두어주렴, 아기 고양아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"그대의 존재는 나의 전투 방식에 큰 영향을 주었다——그렇다, 그대와 정열 가득한 눈빛을 교환하고, 나의 눈동자도 선혈과 같은 붉은색으로 물들었다——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"킹 조지 5세든 웨일즈든, 앤슨이든 하우든, 나는 그대를 절대로 그녀들에게 넘길 수 없다. 그대는 내 최고의 사냥감이자 나의 증명서이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/main2_ex.ogg"},"메인3_ex":{"voiceline":"비참한 샤른호르스트, 그대는 이 근육과 피부, 이 눈동자 그리고 이 몸의 가치를 완전히 이해하지 못했다. 그렇다... 지휘관은 나에게 있어, 그렇게나 중요한 존재인 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205070/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":205072,"클뜯 함순이 id":20507,"함순이 이름":"듀크 오브 요크","한글 함순이 + 스킨 이름":"영원한 밤의 코롤라","영문 함순이 + 스킨 이름":"Eternal Night's Carola","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205072/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205072/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205072/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205072/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205072/shipyard.png","설명":"이 감미로운 기운… 역시 그대였나. 후후, 순간 입고 싶어 입은 이 드레스에 대한 그대의 감상은 어떠한지? 후후… 두 눈은 정직하지 않은가. ","자기소개":null,"메인1":{"voiceline":"긴장할 필요 없다. 옷은 옷일 뿐… 혹시 평소라면 내 곁에서 벗어날 수 있다고 생각했는가? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205072/main1.ogg"},"메인2":{"voiceline":"영원한 밤의 하늘은 얻기 어렵지만, 커튼을 친다면 나와 둘만의 영원한 밤 정도는 즐길 수 있겠지… 그대는 혹시 그 정도 기대도 하지 않았던 것인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205072/main2.ogg"},"메인3":{"voiceline":"그대의 이상은 물을 거슬러 오르는 것과 같이 힘들어 보이지만, 운명에 굴복하지는 않는 모습이 바로 내가 그대의 곁에 남아있는 이유기도 하지. 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205072/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"후후, 그대의 심장 소리가 들리는구나. 두근, 두근… 이렇게 건강하다니, 듣기 좋구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205072/detail.ogg"},"드랍 설명":{"voiceline":"이 감미로운 기운… 역시 그대였나. 후후, 순간 입고 싶어 입은 이 드레스에 대한 그대의 감상은 어떠한지? 후후… 두 눈은 정직하지 않은가.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"나에게 얼마든지 빠져도 좋아. 나에게 그대의 순정을, 충성을, 사랑을 바치도록 해… 만약 그렇다면 나도 그대를 영원히 안아줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205072/feeling5.ogg"},"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"그대… 역시 이 달콤한 핏빛 단비를 맛보고 싶은가?","voicelink":"https://raw.githubuserc