[{"클뜯 id":701120,"클뜯 함순이 id":70112,"함순이 이름":"스비레피","한글 함순이 + 스킨 이름":"스비레피","영문 함순이 + 스킨 이름":"Svirepy","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701120/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701120/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701120/shipyard.png","설명":"7U형 스토로제보이급 구축함 - 스비레피","자기소개":{"voiceline":"스토로제보이급 구축함 스비레피야. 그녜브니의 개조형으로 엄청난 출력과 장비를…… 감기에 잘 걸리는 걸 보니 추위에 약한 것 같다고? 여기 환경에 익숙하지 않아서 그래! 요새 잘 못 쉬어서 그렇고! 얕보지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/profile.ogg"},"메인1":{"voiceline":"의장에 그린 그림이 귀엽다고? 당연하지! 이 노스 유니온 심벌은 엄청난 실력의 그래피티 마스터, 즉 내가 그린 거니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/main1.ogg"},"메인2":{"voiceline":"어뢰 튀김 3인분, 해군 카레 2인분, 꿀맥주 5잔도 다 해치웠고… 야식으로 과자랑 산소 콜라만 있으면 밤에 공부할 때 배가 덜 고프겠지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/main2.ogg"},"메인3":{"voiceline":"익숙하지 않은 환경이라 컨디션이 쉽게 망가져. 젠장! 대체 언제쯤 내 활약을 보여줄 수 있는 거냐고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/main3.ogg"},"전투개시":{"voiceline":"한 판 붙어보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/battle.ogg"},"상세확인":{"voiceline":"……에, 에취! 왜 그런 눈으로 쳐다봐? 코가 간지러워서 그런 것뿐이라고! 딱히 감기에 걸린 건…… 외, 외투 벗어주지 마! 바보 아니야?! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/detail.ogg"},"드랍 설명":{"voiceline":"7U형 스토로제보이급 구축함 - 스비레피","voicelink":null},"의뢰 완료":{"voiceline":"어서 의뢰팀 애들 마중하러 다녀와. 벌써 다들 돌아왔잖아! 나 원 참…… 이런 것까지 내가 재촉하게 만들지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/expedition.ogg"},"실망":{"voiceline":"……휴우, 내가 보는 눈이 없어서 이상한 녀석을 고른 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/feeling1.ogg"},"낯섦":{"voiceline":"나도 늦게 자는 편인데 지휘관은 나보다도 더 늦게 자네…… 지휘관 업무는 원래 그렇게 번거로운 거야? 나는 뭐했냐고? 나, 난 좀 다른 걸 하느라…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/feeling2.ogg"},"호감":{"voiceline":"열심히 노력해야만 내 이름 \"스비레피\"의 의미인 \"포악\"이 어울리는 자가 될 수 있어! ……응? 이미 충분한 것 같으니까 너무 무리하진 말라고? 무, 무슨 소리야! 뭐… 노력을 인정해 준 건… 고맙지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/feeling3.ogg"},"기쁨":{"voiceline":"쿨쿨…… 반드시… 내 실력을 증명하고 말 거야…… 으아?! 잠들었나?! 엥? 왜 갑자기 열심히 한다고 칭찬해?! 설마… 나, 자는 동안 이상한 잠꼬대라도 한 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/feeling4.ogg"},"사랑":{"voiceline":"제멋대로인데다가 입도 험하고, 덤으로 환경에도 익숙하지 않아서 늘 컨디션이 안 좋고…… 난 아무리 봐도 사람들이 좋아할 타입은 아니지. 그렇지만 지휘관은 언제나 상냥하게 대해주고, 날 인정하고 칭찬해 줘서…… 네, 네가 좋다고만 하면… 늘 곁에 있어줘도 괜찮…은데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/feeling5.ogg"},"터치3":{"voiceline":"으아아! 무, 무슨 짓이야! 만지지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/headtouch.ogg"},"모항귀환":{"voiceline":"왔어? 상처 하나 없다니 대단한 녀석이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/home.ogg"},"hp 경고":{"voiceline":"괜찮아! 조금만 더 견디자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/hp_warning.ogg"},"로그인":{"voiceline":"이제야 온 거야? 정신 차려. 새로운 도전이 이제 곧 시작된다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/login.ogg"},"실패":{"voiceline":"기합이 모자랐던 건가… 다음에는 꼭 이긴다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/lose.ogg"},"우편":{"voiceline":"우편은 책상 위에 뒀어. 나 원 참…… 제대로 확인하는 거 잊지 마. 그러다 중요한 걸 놓칠 수도 있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/mail.ogg"},"임무":{"voiceline":"뭘 보고만 있는 거야! 그런다고 없는 물자가 솟아오르는 것도 아니니, 필요하면 임무를 처리하고 오라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/mission.ogg"},"임무완료":{"voiceline":"보상 확인했어. 네가 한 번 더… 고맙다고? 으, 으흠…… 딱히…… 힘든 것도 아니고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/mission_complete.ogg"},"서약":{"voiceline":"음, 손가락에 딱 맞네. 꽤 괜찮은 선물…… 응? 서약 반지? 자, 잠깐만! 너 지금 무슨 말을… 뭐? 나한테? 정말? 너무 좋…… 으음! 이, 이렇게 됐으니 계속 곁에 있어줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/propose.ogg"},"스킬":{"voiceline":"그래피티 스프레이! 분사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/skill.ogg"},"터치1":{"voiceline":"응? 내 엑스 피스톨 의장에 관심 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/touch.ogg"},"터치2":{"voiceline":"뭐야? 아주 두 동강을 내줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/touch2.ogg"},"입수시":{"voiceline":"스토로제보이급 구축함 스비레피야. 후후, 네 이야기는 예전부터 들었지만, 그렇다고 딱히 인정하고 있는 건 아니야. 꾸준히 기량을 갈고닦아서 강한 나를 열심히 따라잡아 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/unlock.ogg"},"강화성공":{"voiceline":"흐음! … 좋아. 이걸로 내 용맹함도 더욱 상승했겠군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"아하하하하! 내게 진 건 너희들에게 영광스러운 일이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":{"voiceline":"응? 의뢰팀 애들이 벌써 돌아왔어. 지휘관, 마중하러 안 나갈 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/expedition_ex.ogg"},"사랑_ex":{"voiceline":"지휘관이 내 곁에 없었다면, 내 자신의 힘과 가치를 증명하려고 계속 무리했을지도 몰라… 너무 세게 당긴 활시위 같다고? 응, 그럴지도 몰라… 지휘관이 없었다면 정말 어땠을까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"만지는 게 그렇게 좋으면…… 마, 만지게 해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"돌아왔어? 오늘도 잘하고 왔네! 상처도 없고 말이야. 헤헷, 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 와. 좋아. 오늘 지휘관은 꽤 활기차 보이는걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"새로운 임무야! 같이 처리하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"으아아아! 아직 밖이야! 가, 갑자기 무슨 짓이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['오그네보이'] :  내 그림이 제일 귀여워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"요즘 밤샘이 줄어서 다행이라고? 뭐, 그렇지…… 열심히 한다고 지휘관이 자주 칭찬해주기도 하니까, 가끔은 좀 편하게 지내도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/main5_ex.ogg"},"메인6_ex":{"voiceline":"에, 에취! 지휘관… 에어컨 온도 좀 올려줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"그럼 엄청난 실력의 그래피티 마스터의 신작을 공개하지! 어때? 우주에서 제일 귀엽지? 헤헤~ 지휘관이라면 알아줄 줄 알았어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701120/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SR","ex_chat_status":1},{"클뜯 id":701121,"클뜯 함순이 id":70112,"함순이 이름":"스비레피","한글 함순이 + 스킨 이름":"아트 오브 리벨리언","영문 함순이 + 스킨 이름":"Rebellious Artist","스킨 타입":"Special Exercise","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701121/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701121/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701121/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701121/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701121/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701121/shipyard.png","설명":"환호하라! 위대한 그래피티 마스터 스비레피 님께서 등장하셨다! 예술이 탄생하는 장면을 직접 볼 수 있다니 다들 운이 좋군! 감상할 미적 감각이 없는 녀석들은 다들 조심하라고~!","자기소개":null,"메인1":{"voiceline":"그냥 본인을 연기하는 느낌이라고? 그만큼 배역에 몰입했다는 의미지? …으, 응! 칭찬해준 답례로… 다음에 지휘관이 대사 까먹으면 도와줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/main1.ogg"},"메인2":{"voiceline":"\"아하하! 경찰 따위가 날 잡으려고 하다니 어리석긴! 온 거리를 내 낙서로 뒤덮을 거야! 너도 물론 도와줄 거지?\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/main2.ogg"},"메인3":{"voiceline":"\"좋은 생각이 떠올랐어! 낙서에 네 이름을 남기면 경찰은 내가 아니라 널 쫓겠지? 아하하☆\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"\"환호하라! 위대한 그래피티 마스터 스비레피 님께서 등장하셨다! 예술이 탄생하는 장면을 직접 볼 수 있다니 다들 운이 좋군! 감상할 미적 감각이 없는 녀석들은 다들 조심하라고~!\"","voicelink":null},"의뢰 완료":{"voiceline":"어서 의뢰팀 애들 마중하러 다녀와. 벌써 다들 돌아왔잖아! 어휴…… 또 이런 말 하게 만들지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"으음…… 흠…… 지휘관 모습, 좀 수수한 것 같지 않아? 이 그래피티 마스터 스비레피가 귀엽고 컬러풀하게 만들어줄게! ……됐다고? 후후, 거부할 권리는 없어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/feeling5.ogg"},"터치3":{"voiceline":"고양이 귀가 딱딱하다고? 저기… 진짜 고양이 귀가 아닌 건 알고 있지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/headtouch.ogg"},"모항귀환":{"voiceline":"왔어? 후훗, 내 신작도 슬슬… 여긴 물론 아니지. 어디냐고? 그건 완성된 후의 서프라이즈라서 비밀이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"늦었어! 여긴 이미 내 영역이야! 뭐, 도와준 대가로 좀 나눠줄 수는 있지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/login.ogg"},"실패":null,"우편":{"voiceline":"\"네 앞으로 온 우편은 여기 뒀어. 변상은 대신 좀 해줘. …윽. 따, 딱히 낙서에 네 이름을 남겨둔 건 아니야…\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/mail.ogg"},"임무":null,"임무완료":{"voiceline":"새로 도착한 보상… 여기에도 낙서하면…… 으아아, 진심으로 받아들이지 마! 농담이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"세트에서 촬영하는 거긴 하지만, 이 모습은 아무래도 춥…… 에, 에취!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/touch.ogg"},"터치2":{"voiceline":"이, 이런 건 좀 돌아간 다음에 하면 안 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701121/touch2.ogg"},"입수시":{"voiceline":"\"환호하라! 위대한 그래피티 마스터 스비레피 님께서 등장하셨다! 예술이 탄생하는 장면을 직접 볼 수 있다니 다들 운이 좋군! 감상할 미적 감각이 없는 녀석들은 다들 조심하라고~!\"","voicelink":"https://raw.githubusercontent.com/Fernando260