[{"클뜯 id":401430,"클뜯 함순이 id":40143,"함순이 이름":"Z43","한글 함순이 + 스킨 이름":"Z43","영문 함순이 + 스킨 이름":"Z43","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401430/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401430/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401430/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401430/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401430/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401430/shipyard.png","설명":"1936년 B형 구축함 - Z43","자기소개":{"voiceline":"운명의 상대여, 오너라! 나는 메탈 블러드의 Z43(퓌드)… 최강의 악마인 내가 암흑 진혼가로부터 너를 지키기 위해 내려왔노라… 크크크… 이 운명적인 만남을 영광으로 여겨라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/profile.ogg"},"메인1":{"voiceline":"악을 배신한 자라는 호칭은 어디서 왔냐고? 악과 관계를 끊고 큰 피해를 입히다 보니 어느새 이렇게 불리고 있더군…… 음? 악의 정체가 궁금하다고? 으, 으윽…! 그런 세세한 부분까지는 파고들지 마라! 아직 그 설정까지는 생각해 두지 않았다고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/main1.ogg"},"메인2":{"voiceline":"사역마는 어디서 지내냐고? 크크… 둘시는 파우치로 둔갑시켜서 이렇게 몸에 지니고 다니고, 델라만은 안대로 내 마안을 봉인하고 있지. 에헤헤, 귀엽지? 다 내가 디자인한 거…… 크흠! 길들인 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/main2.ogg"},"메인3":{"voiceline":"운명의 상대여, 궁금한 것이 있다! 네게도 전투에 나설 때… 전용 BGM 같은 게 있는가? 음… 내가 고르면, 재즈가 좋으려나… 그렇지! 재즈라면 정의로운 조직의 여유를 잘 표현할 수 있을 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/main3.ogg"},"전투개시":{"voiceline":"암흑 진혼가와의 전투는 내게 맡겨라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/battle.ogg"},"상세확인":{"voiceline":"암흑 진혼가(Dark Requiem)… 교활하고 사람을 현혹하는 것이 주특기인 무리지…… 음? 우리와 매일 바다에서 교전하는 적들을 말하는 거다만?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/detail.ogg"},"드랍 설명":{"voiceline":"1936년 B형 구축함 - Z43","voicelink":null},"의뢰 완료":{"voiceline":"동료들이 의뢰에서 귀환한 듯하군. 크크크… 다행히 암흑 진혼가의 훼방은 없었던 모양이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/expedition.ogg"},"실망":{"voiceline":"으으…… 어둠의 침식이 여기까지 진행된 건가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/feeling1.ogg"},"낯섦":{"voiceline":"운명의 상대여, 단단히 각오해라! 정의의 조직에서 적극적으로 관찰한 결과, 너는 간부로 등용되어야 할 존재로 판명됐으니까! 음? 누가 관찰한 거냐고? 물론 바로 나지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/feeling2.ogg"},"호감":{"voiceline":"모략? 작전? 이 영원한 마안 앞에서는 다 하찮고 우스꽝스러울 뿐이지! 벌레들이 발버둥 쳐봤자…… 아, 자… 잠깐! 지휘관한테 하는 말은 절대 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/feeling3.ogg"},"기쁨":{"voiceline":"운명의 상대여, 보아라! 너를 위해 디자인한 이 아바타를! 왼손에는 악마를 소환하는 마도서, 오른손에는 세상을 뒤엎는 마법진, 등에는 검고 흰 두 개의 날개! …와, 완전 멋있지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/feeling4.ogg"},"사랑":{"voiceline":"운명의 상대여, 오너라! 네 손바닥을 내 손바닥에 겹쳐라! 이렇게 너와 마음을 하나로 이어서…… 오, 오오오…! 이 느낌… 크크크! 역시 너는 악을 배신한 자인 내 매력에 저항할 수 없는 모양이군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/feeling5.ogg"},"터치3":{"voiceline":"으아아! 머리는 만지지 마라! 어둠을 감지하는 능력이 떨어진다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/headtouch.ogg"},"모항귀환":{"voiceline":"크크크… 사역마 델라만과 둘시가 네 귀환을 알려준 덕에 미리 간식을 준비해 뒀다. 자, 어서 허기를 채우거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/home.ogg"},"hp 경고":{"voiceline":"결계가… 무너진 건가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/hp_warning.ogg"},"로그인":{"voiceline":"크오오! 운명의 상대여, 오너라! ……아니, 왜 이렇게 늦은 거지?! …어, 어서 나와 함께 악의 조직――암흑 진혼가(Dark Requiem)의 음모를 파헤치자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/login.ogg"},"실패":{"voiceline":"크윽… 왼쪽 눈의 봉인이 욱신거린 탓인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/lose.ogg"},"우편":{"voiceline":"이미 난 마안으로 우편 내용을 파악하고 있지…… 으아아, 농담이야! 내 마음대로 우편을 훔쳐볼 리가 없잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/mail.ogg"},"임무":{"voiceline":"운명의 상대여, 명심해라! 임무를 열심히 완수하지 않으면, 내 정의를 관철하는 것도 불가능하다는 것을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/mission.ogg"},"임무완료":{"voiceline":"임무 완료…… 보상…… 으으…… 확인하는 것만 해도 꽤 시간이 걸릴 것 같군… 운명의 상대여, 뒤는 네게 맡기마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/mission_complete.ogg"},"서약":{"voiceline":"크흠, 네 관심을 끌려고 한 행동이기는 하지만…… 뭐? 지휘관은 그런 게 좋다고? …으흠! 그럼… 나와 영원한 인연을 맺고 싶은 건가? 좋아. 그렇다면 영원히 계속되는, 절대 배신할 수 없는 서약을…… 뭐, 뭐라고…?! 그, 그렇게 바로 알았다고 대답을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/propose.ogg"},"스킬":{"voiceline":"진정한 힘이 무언지 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/skill.ogg"},"터치1":{"voiceline":"큭…! 내 결계가… 무너진 건가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/touch.ogg"},"터치2":{"voiceline":"지, 지, 지휘관! 자꾸 그러면 마력이 폭주해서 세상이 멸망하고 말 거라고…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/touch2.ogg"},"입수시":{"voiceline":"크크크…… 내 운명의 상대여, 오너라. 정의의 화신으로서 검은 날개를 받았지만 여전히 빛을 좇는 자… 마안의 악마—— 악을 배신한 자(Rebel) Z43의 품에 안기거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/unlock.ogg"},"강화성공":{"voiceline":"크크크… 내 마력이 더 강해졌군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"승리의 영광은 나, 그리고 너에게 돌리마! 으하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"가끔은 망언을 내뱉고, 가진 힘을 과장스레 내세우지만… 어쩌면 그건 현실을 바꿀 수 없는 스스로의 무력함에서 도망치기 위함일지도 몰라. 하지만 지금은…… 네 손, 절대 놓지 않을게! 더는 슬퍼하거나 후회하지 않을 거야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"에헤헤헤… 괘, 괜찮은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"운명의 상대여, 어서 앉아서 쉬거라! 편안하게 몸을 누일 수 있도록 우리가 미리 소파를 정리해 뒀다! …우리라니, 누가 또 있냐고? 크크크, 내 사역마인 델라만과 둘시 말고 또 누가 있겠는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘…… 아니지. 운명의 상대여, 어찌하여 이토록 늦게 나타난 것이더냐?! 마음이 편치 않아, 늦잠도 제대로 못 잤지 않은가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"크크크… 정의를 관철한 것에 대한 포상인가… 내가 직접 확인해 주마! 으… 또 잘 모르겠네… 지, 지휘관! 도와줘…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"크크크… 마력의 파동이 느껴지는군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/touch_ex.ogg"},"터치2_ex":{"voiceline":"마, 마력을 또 넘치게 하려고…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"후후후! 그렇다! 이 힘은 운명의 상대와 손을 잡아 얻은 힘이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['Z36'] : 응? 제크짱도 데빌…이라는 설정?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"운명의 상대는 나를 이상하게 여기지 않는군…… 뭐? 오히려 마음에 든다고? 흐, 흥! 이 세상에 이렇게 오래 존재할 수 있는 건 모두 네 덕분일지도 모르겠군…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/main5_ex.ogg"},"메인6_ex":{"voiceline":"아, 아아아…… 드디어… 드디어! 네가 끈기 있게 알려준 덕분에, 드디어 보상 확인하는 방법을 터득했다! 크크크, 다음부터는 안심하고 맡기라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"내 운명의 상대여, 델라만은 네가 마음에 든 모양이다. 자, 똑같은 사역마가 담긴 이 안대를 착용하거라. 내가 직접 만들어서 멋지지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401430/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":1},{"클뜯 id":401431,"클뜯 함순이 id":40143,"함순이 이름":"Z43","한글 함순이 + 스킨 이름":"둘만의 비밀기지","영문 함순이 + 스킨 이름":"A Secret Base For Two","스킨 타입":"School Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401431/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401431/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401431/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401431/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401431/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401431/shipyard.png","설명":"왜 붕대가 잘 안 감겨…… 으으으! 아야야…! ……응? 지휘… 아니, 운명의 상대여! 도움이 필요하다! 마력을 제어하는 붕대가 폭주하고 있어…!","자기소개":null,"메인1":{"voiceline":"평소에는 붕대를 감아서 마력을…… 오늘따라 이상하게 잘 안 감기는군! 요즘 숙제를 밤새워서 하느라… 마력 제어력이 떨어진 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/main1.ogg"},"메인2":{"voiceline":"미끄럼틀에 붙어있는 종이? 크크크, 이건 내가 여기 설치한 마법 술식과 정의로운 계획, 그리고 방황하는 자를 인도하는…… 자, 잠깐! 지휘관, 마지막까지 들어 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/main2.ogg"},"메인3":{"voiceline":"으으으…… 아무리 애를 써도 붕대가 잘 안 감겨…! 운명의 상대여! 내 명령에 따르라! 당장 이 붕대를 잘 감아 봐! …그, 그래! 이건 네게 주는 시련이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"왜 붕대가 잘 안 감겨…… 으으으! 아야야…! ……응? 지휘… 아니, 운명의 상대여! 도움이 필요하다! 마력을 제어하는 붕대가 폭주하고 있어…!","voicelink":null},"의뢰 완료":{"voiceline":"마안에 포착되었군…… 그래! 의뢰팀 동료들이 귀환했다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"비밀기지에 지휘관이랑 단둘이…… 얼마 전에 망상했던 게 진짜로…… 아, 정말! 붕대만 잘 감겼으면 더 좋았을 텐데… 으으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"우리 둘만의 비밀기지로 잘 돌아왔다! 음…… 오, 오늘 수학 숙제가 좀 어려워서… 조, 조금 도와줄 수 있나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"운명의 상대여, 똑똑히 듣거라! 이 비밀기지를 네게 들켰으니…… 언제든 놀러 와도 좋다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/login.ogg"},"실패":null,"우편":{"voiceline":"어라? 비밀기지가 어딨는지는 아무도 모를 텐데, 어떻게 우편이… 운명의 상대여, 네 몸에는 그런 마법이 걸려 있는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"아, 아직 못 감았어…? 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401431/touch.ogg"},"터치2":{"voiceline":"자, 잠깐 멈춰! 거기가 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLa