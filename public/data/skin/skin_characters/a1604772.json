[{"클뜯 id":308020,"클뜯 함순이 id":30802,"함순이 이름":"이26","한글 함순이 + 스킨 이름":"이26","영문 함순이 + 스킨 이름":"I-26","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308020/shipyard.png","설명":"순잠 을형 잠수함 이26","자기소개":{"voiceline":"질문! 최초의 이글 유니온 상선을 격침한 사쿠라 엠파이어 잠수함은 누구일까요? 그래, 바로 이 귀엽고 똑똑한 이26이야! ……그 뒤론 어떻게 되었냐고? 옛날 무용담은 접어두자고, 중요한 건 지금이니까 말야! 흐흐흥~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/profile.ogg"},"메인1":{"voiceline":"이 귀는 어떻게 된 거냐고? 음, 만져보고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/main1.ogg"},"메인2":{"voiceline":"서류 정리……귀찮아……그것보다 지휘관, 비치발리볼이라도 안 할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/main2.ogg"},"메인3":{"voiceline":"잠깐 헤엄이나 쳐볼까~맞다! 지휘관, 누가 더 빠른가 시합해볼래? 헤헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/main3.ogg"},"전투개시":{"voiceline":"오늘의 럭키걸은 어느 아이일까~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/battle.ogg"},"상세확인":{"voiceline":"구릿빛 피부는 건강의 상징! 지휘관도 태닝 한 번 해보지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/detail.ogg"},"드랍 설명":{"voiceline":"순잠 을형 잠수함 이26","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었네! 다음은 나도 같이 넣어줘, 화물선 파괴하는 건 자신 있으니까 말야! 헤헤헤","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/expedition.ogg"},"실망":{"voiceline":"지휘관? 아~니야, 공기겠지? 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/feeling1.ogg"},"낯섦":{"voiceline":"잠행 개시! 목표 확인, 어뢰 발사! 퍼엉! 어때? 간단하지? 지휘관도 해볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/feeling2.ogg"},"호감":{"voiceline":"지휘관, 숨 참기 시합이라도 안 해볼래? 진 사람이 이긴 사람한테 안마 해주기! 이런 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/feeling3.ogg"},"기쁨":{"voiceline":"슬슬 눈치채주려나…저기…그……단추가 떨어졌어! 내가 무슨 말 할 거라 생각했어? 헤헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 어깨 좀 빌려줘~ 뿅! 헤헤헤, 나 말야 꽤 가볍다고! 그러니까, 집무실까지 목말 태워줘, 잘 부탁해~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어라, 지휘관, 머리숱이 좀 적어진 것 같은 느낌이… 아하하하! 농담, 농담이라니깐~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/home.ogg"},"hp 경고":{"voiceline":"아하하… 좀 위험한 듯……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/hp_warning.ogg"},"로그인":{"voiceline":"뿅! 헷헤~ 어때 지휘관, 깜짝 놀랐어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/login.ogg"},"실패":{"voiceline":"아야야야, 잠깐 너무 방심했어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/lose.ogg"},"우편":{"voiceline":"우편? 기한이 지나서 버렸어……농~담이야☆자, 빨리 확인해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/mail.ogg"},"임무":{"voiceline":"임무 왔다! 후우~딱 좋은 타이밍에 몸 좀 풀 수 있게 됐네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/mission.ogg"},"임무완료":{"voiceline":"보수를 옮기는 화물선을 보면, 가라앉히고 싶은 충동에 마음이 요동쳐…농담이야☆ 그럴 리 없잖아! 하하하, 빨리 보러 가자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/mission_complete.ogg"},"서약":{"voiceline":"실은 슬슬 이날이 오는 건 아닐까 하고 생각했었지만, 설마 오늘일 줄은 꿈에도 몰랐어……왠지 너무 기뻐서 모항을 100바퀴나 헤엄쳐서 돌 수 있을 거 같아! 응! 그러니까 지휘관, 나랑 함께 헤엄치자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/propose.ogg"},"스킬":{"voiceline":"찾~았다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/skill.ogg"},"터치1":{"voiceline":"응? 준비운동을 도와달라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/touch.ogg"},"터치2":{"voiceline":"지휘관, 지금 무슨 망상하는 거야? 알려줘~ 헤헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/touch2.ogg"},"입수시":{"voiceline":"잠수함 이26, 오늘부터 얹혀살 테니 착임 하도록 할게! 흐흥~ 나에 대해 혹시 굉장히 기대했던 거 아냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/unlock.ogg"},"강화성공":{"voiceline":"몸매도 더 좋아지면 좋을 텐데 말야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"깜짝 공격, 대성공!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['쥬노'] : 무서워 하지 마, 지금은 동료라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/couple_encourage1.ogg"},{"voiceline":"['새러토가'] : 준비운동을 제대로 안 하면 다친다고! 수리 도크의 아이돌 씨♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308020/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null