ling5.ogg"},"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"지휘관, 복귀를 환영해. 오늘도 함께 힘내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102059/login.ogg"},"실패":{"voiceline":"괜찮아, 아직 한 번 더 남았어......!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102059/lose.ogg"},"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"지휘관, 이런 일은, 여기선 안돼......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102059/touch2.ogg"},"입수시":{"voiceline":"새로운 장비… 적응하기가 약간 복잡하긴하지만, 지금의 나는 이 힘을 다룰 수 있을거라 믿어! 지휘관, 내 활약을 기대해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102059/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"헬레나, 아직 거만해지면 안 돼. 더욱더 강해져야만 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102059/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"개조","상점 id":0,"상점 카테고리 id":9997,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0}]