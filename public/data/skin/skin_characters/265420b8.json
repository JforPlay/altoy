":null,"메인1":{"voiceline":"물에 띄우는 소품들… OK. 타월도 OK. 술병도…… 아, 이런! 사쿠라 엠파이어 술을 따르는 걸 깜빡했…… 꺄악!? 발밑에 비누가… 빨리 찾아야 해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/main1.ogg"},"메인2":{"voiceline":"목욕 준비를 하는 건 처음인데… 새로운 걸 시도하려면 용기뿐만이 아니라 여러 가지가 필요하구나. 예를 들어 침착함이나, 지식, 손재주 같은……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/main2.ogg"},"메인3":{"voiceline":"후우… 과일 향에 편백나무 향까지, 냄새만 맡아도 정말 힐링돼… 지휘관도 같이 어때…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/main3.ogg"},"전투개시":{"voiceline":"난… 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/battle.ogg"},"상세확인":{"voiceline":"열심히 준비했으니까, 당연히 그만큼 즐거운 시간을 보내고 싶은 마음도 들지… 물론, 그게 잘 될지는 별개지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/detail.ogg"},"드랍 설명":{"voiceline":"꺄악?! 지, 지휘관…? 나, 난 괜찮아! 그냥 살짝 넘어진 것뿐이니까 걱정하지 마. 조광 유리가 꺼져 있었다고…?! 아, 으아아…///","voicelink":null},"의뢰 완료":{"voiceline":"큰일이야, 의뢰팀이 돌아왔어…… 지, 지휘관! 나는 괜찮으니까 먼저 가서 동료들 좀 맞이해 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"괜찮아, 헬레나. 이제 조금만 더 있으면 지휘관이랑 같이 들어갈 수 있어… 그러면…… 응? 도와줄 테니까 문 좀 열어달라고…? 그렇지! 나도 참… 애초에 지휘관을 부를 생각이었는데…… 아, 지휘관! 위험해!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 와, 지휘관. 이제 곧 준비가 끝나니까, 괜찮으면 지휘관도 같이 들어와. 서로 등도 밀어줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"이런 건 처음이라, 준비하는 방법이나 입욕법 같은 걸 잔뜩 찾아봤는데, 결국 다 실패했어… 지휘관한테 미리 물어볼 걸 그랬네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/login.ogg"},"실패":null,"우편":{"voiceline":"우편? 으아… 지휘관, 미안해… 먼저 혼자 확인하고 있어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/mail.ogg"},"임무":{"voiceline":"지휘관, 임무는 걱정하지 마. 나중에 천천히 처리하면 되니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/mission.ogg"},"임무완료":{"voiceline":"역시 지휘관은 대단해… 아, 이쪽도 곧 정리가 끝날 것 같아… 아마도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"비누가 떨어졌다고…? 어, 어디 갔지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/touch.ogg"},"터치2":{"voiceline":"유리 너머인데……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/touch2.ogg"},"입수시":{"voiceline":"꺄악?! 지, 지휘관…? 나, 난 괜찮아! 그냥 살짝 넘어진 것뿐이니까 걱정하지 마. 조광 유리가 꺼져 있었다고…?! 아, 으아아…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"후우… 땀을 흘리니까 개운하네. 아, 돌아가면 다시 들어가야지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102054/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"온천 타임","상점 id":71171,"상점 카테고리 id":22,"스킨 태그":"쁘띠모션, 배경","입수 영상":"O","재화":880,"기간":"한정 (2025/09/11)","진영":"USS","레어도":"SR","ex_chat_status":0},{"클뜯 id":102058,"클뜯 함순이 id":10205,"함순이 이름":"헬레나","한글 함순이 + 스킨 이름":"순백의 기적","영문 함순이 + 스킨 이름":"Miracle in White","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/imag