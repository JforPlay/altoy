audio/voiceline/102058/feeling5.ogg"},"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"지휘관, 어서 와. SG가 알려주긴 했지만, 아무래도 내 눈으로 직접 확인하지 않으면, 마음이 안 놓여서 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102058/login.ogg"},"실패":{"voiceline":"괜찮아, 헬레나. 분명 다음 기회가 있을 거야……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102058/lose.ogg"},"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"있잖아… 조금만 더 이렇게 손잡고 있어도, 괜찮아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102058/touch.ogg"},"터치2":{"voiceline":"조, 조금만 마음의 준비를 할 시간을……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102058/touch2.ogg"},"입수시":{"voiceline":"지휘관, 어, 어때…? 잘 어울려…? 이런 옷을 입을 날이, 이렇게 행복한 순간이 올 줄은 정말 꿈에도 몰랐어…. 정말… 고마워….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102058/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"헬레나, 우쭐해지면 안 돼…. 더, 더 강해져야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102058/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"서약","상점 id":0,"상점 카테고리 id":9998,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0},{"클뜯 id":102059,"클뜯 함순이 id":10205,"함순이 이름":"헬레나","한글 함순이 + 스킨 이름":"헬레나·改","영문 함순이 + 스킨 이름":"Helena (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102059/painting.