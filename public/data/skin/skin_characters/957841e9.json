[{"클뜯 id":304080,"클뜯 함순이 id":30408,"함순이 이름":"콘고(μ장비)","한글 함순이 + 스킨 이름":"콘고(μ장비)","영문 함순이 + 스킨 이름":"Kongou μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304080/shipyard.png","설명":"μ장비 실험 유닛 \"Cyanidin\"에 소속된 콘고랍니다. 제 우아함으로 지휘관님께 아이돌의 매력을 보여드리겠어요. 후후, 무대 위 모습을 마음에 새길 수 있도록 준비를 해두시길.","자기소개":{"voiceline":"콘고급 1번함 콘고랍니다. 아이돌에게 우아함과 명랑함은 빼놓을 수 없으니, 제가 \"Cyanidin\"을 더욱 빛나게 해드릴게요☆ …후후, 어때요? 지휘관? 제 매력에 푹 빠지셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/profile.ogg"},"메인1":{"voiceline":"홍차는 여기 있어요. 지휘관님도 드실… 아, 그건 콘고가 먼저 마시던 건데요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/main1.ogg"},"메인2":{"voiceline":"(킁킁) 이 좋은 냄새는 어디서… 어머, 아무래도 지휘관님 쪽에서 나는 것 같네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/main2.ogg"},"메인3":{"voiceline":"귀를 만지고 싶으시다고요? 물론 괜찮지만… 아니, 고양이 귀가 아니라 콘고의 귀를?! …빨개져서 자꾸 신경이 쓰인다고요? 그, 그건 홍차가 너무 뜨거워서 그런 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/main3.ogg"},"전투개시":{"voiceline":"연주할게요… 우리의 멜로디를!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/battle.ogg"},"상세확인":{"voiceline":"의상 모티브가 고양이 같나요? 어머, 우아하고 여유롭고, 정숙하면서도 매혹적인… 고양이의 기질이 이 콘고와 비슷한 것 같지 않으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/detail.ogg"},"드랍 설명":{"voiceline":"μ장비 실험 유닛 \"Cyanidin\"에 소속된 콘고랍니다. 제 우아함으로 지휘관님께 아이돌의 매력을 보여드리겠어요. 후후, 무대 위 모습을 마음에 새길 수 있도록 준비를 해두시길.","voicelink":null},"의뢰 완료":{"voiceline":"애프터눈티 준비는 제게 맡겨주세요. 후후, 의뢰팀 사람들이 다들 돌아왔잖아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/expedition.ogg"},"실망":{"voiceline":"어휴… 지휘관님의 방금 행동은 우아함과는 동떨어져 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/feeling1.ogg"},"낯섦":{"voiceline":"친화력과 열정, 성실함… 그리고 가장 중요한 것은 우아함이죠. 어엿한 아이돌이 되려면 다 필요해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/feeling2.ogg"},"호감":{"voiceline":"아이돌 콘고와 촬영… \"지휘관님과 콘고의 투샷\" 시간이에요! 이건 지휘관님의 특권… 아니, 콘고의 지휘관님께만 선사하는 특별 서비스랍니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/feeling3.ogg"},"기쁨":{"voiceline":"콘고와 찍은 사진을 소중히 여기고 계시군요… 후훗, 그렇다면 이번에는 콘고의 사진을 10권… 아니, 100권분은 찍어드릴게요! 아니, 역시 콘고만 찍힌 사진보다는 지휘관님과 함께 100권분을 찍는 편이 바람직하겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/feeling4.ogg"},"사랑":{"voiceline":"μ장비… 아이돌 임무에 지원한 이유 말인가요? 후훗, 궁금해하실 줄 알았어요. 굳이 말하자면 춤과 노래로 사랑과 희망을… 이란 건 농담이에요♪ 사실은 지휘관님께 콘고의 우아하고 아름다운 모습을 보여주고 싶었을 뿐이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/feeling5.ogg"},"터치3":{"voiceline":"지휘관님 손길이 따뜻해서 저도 모르게 고양이처럼 머리를 문지르고 싶어졌어요… 어머, 저도 참… 이 고양이 귀 때문에 그러는 걸까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 세트에 있는 고양이 발바닥 쿠션에서 잠깐 쉬는 게 어떠세요? 꽤 푹신해서 편해요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/home.ogg"},"hp 경고":{"voiceline":"이젠… 바, 발목이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 안녕하세요. 아직 시간이 있으니까 업무를 시작하기 전에 잠깐 둘이서 산책이라도 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/login.ogg"},"실패":{"voiceline":"아직 익숙하지 않은 탓일까요…… 이번에는 후퇴할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/lose.ogg"},"우편":{"voiceline":"최신 트렌드를 감안해서 이번 무대 계획을 짜볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/mail.ogg"},"임무":{"voiceline":"새로운 임무예요. 저도 함께 가는 건 어때요? 후후후, 빨리 대답하지 않으면 동의한 걸로 간주하겠어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/mission.ogg"},"임무완료":{"voiceline":"임무 완료예요. 보상으로 터치를…… 어휴 참, 의장에 달린 고양이 발이 아니라, 콘고의 손… 말한 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/mission_complete.ogg"},"서약":{"voiceline":"어머, 이건… 아무래도 제 노래에 담긴 마음이 제대로 지휘관님께 전해진 것 같네요♪ 물론 지휘관님의 마음도… 꽉 잡은 이 손으로 전해지고 있고요. 후후후♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/propose.ogg"},"스킬":{"voiceline":"클라이맥스는 지금부터예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/skill.ogg"},"터치1":{"voiceline":"어머, 지휘관님. 신청곡이라도 있으신가요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/touch.ogg"},"터치2":{"voiceline":"방금 건…… 너무 우악스럽게 구시면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/touch2.ogg"},"입수시":{"voiceline":"μ장비 실험 유닛 \"Cyanidin\"에 소속된 콘고랍니다. 제 우아함으로 지휘관님께 아이돌의 매력을 보여드리겠어요. 후후, 무대 위 모습을 마음에 새길 수 있도록 준비를 해두시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/unlock.ogg"},"강화성공":{"voiceline":"후… 이걸로 무대 공연도 문제 없겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"아이돌으로서의 승리도 당연히 우아하게 거둬야겠죠. 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['르 테메레르(μ장비)'] :  너무 독주하진 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/couple_encourage1.ogg"},{"voiceline":"['보이시(μ장비)'] :  템포를 맞춰요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304080/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0}]