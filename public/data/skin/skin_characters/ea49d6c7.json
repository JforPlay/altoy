[{"클뜯 id":9701020,"클뜯 함순이 id":970102,"함순이 이름":"포춘·META","한글 함순이 + 스킨 이름":"포춘·META","영문 함순이 + 스킨 이름":"Fortune META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701020/shipyard.png","설명":"처음 뵙겠습니다, 지휘관님. 저는 포춘이라고 해요. …사, 사슬은 신경 쓰지 말아 주세요. 힘을… 힘을 제어하기 위해서는 필요한 거라서요….","자기소개":{"voiceline":"포춘이라는 이름이 붙었지만, 운명에 끌려가는 건 나 같아…. 저기, 아무래도 이 모습… 신경 쓰이시죠? 이건 그러니까, 주변에 있는 동료들을 상처 입히지 않도록, 제가 스스로 보험처럼 걸어둔 거예요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/profile.ogg"},"메인1":{"voiceline":"운명은 바꿀 수 없다고도 하고, 운명은 스스로 개척해나가는 것이라고도 하는데… 그 운명이란 건 대체 뭘까요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/main1.ogg"},"메인2":{"voiceline":"이 제어할 수 없는 힘도 분명 운명이 제게 부과한 시련이겠죠. 이대로 휩쓸리는 것만은….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/main2.ogg"},"메인3":{"voiceline":"지휘관은 어떤 일에 대해 운명적이라고 느끼거나 하신 적 있으세요? 아, 아니에요. 좀 궁금했던 것뿐….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/main3.ogg"},"전투개시":{"voiceline":"하지 않으면 안 되는 건가요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/battle.ogg"},"상세확인":{"voiceline":"저에 대해서는 별로 신경 안 써주셔도…. 그리고, 그러니까… 감사합니다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/detail.ogg"},"드랍 설명":{"voiceline":"처음 뵙겠습니다, 지휘관님. 저는 포춘이라고 해요. …사, 사슬은 신경 쓰지 말아 주세요. 힘을… 힘을 제어하기 위해서는 필요한 거라서요….","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료된 것 같네요…. 죄송해요, 이런 모습이라 별 도움이 못 되어서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/expedition.ogg"},"실망":{"voiceline":"가까이 오지 마세요…! 죄, 죄송해요, 제어가 안 먹히는 건 아닌지 걱정이 되어서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/feeling1.ogg"},"낯섦":{"voiceline":"이렇게 만난 것도 운명의 인도…겠지요. 운명은 이번엔 저를 또 어디로 끌고 갈까요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/feeling2.ogg"},"호감":{"voiceline":"만약 운명의 여신님이 진짜로 계신다면, 잘 모르는 걸 많이 물어보고 싶었지만… 이제는 답 같은 건 어떻게 되든 상관없어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님과 함께 있으면 지금까진 없었던 새로운 방향으로 운명이 나아가는 것 같은 기분이 들어요…. 희미해서 잘은 모르겠지만, 무척 따뜻하기도 하고….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/feeling4.ogg"},"사랑":{"voiceline":"포춘의 운명, 지휘관님께 맡길게요. 지휘관님이라면 설령 제가 궤도에서 벗어난다고 해도, 원래 있던 방향으로 고쳐주시겠죠. 저… 지휘관 곁에 있어도, 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"작전이 무사히 끝났습니다. 지휘관님의 운명의 궤도도 좋은 미래로 뻗어나가고 있는 것 같네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/home.ogg"},"hp 경고":{"voiceline":"이 힘을… 쓰게 하지 말아줘…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님… 저기, 어서 오세요…? 인사는 이렇게 하면 되는… 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/login.ogg"},"실패":{"voiceline":"이, 이럴 수가…. 아니야, 이럴 순 없어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/lose.ogg"},"우편":{"voiceline":"지휘관님, 새로운 우편이…. 아, 손으로 직접 전해드릴 수가 없어서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/mail.ogg"},"임무":{"voiceline":"지휘관님, 저기… 혹시 잊으셨을지도 모르지만… 임무, 아직 안 끝난 게 있어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었습니다…. 분명 앞으로 다 잘 풀릴 거예요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/mission_complete.ogg"},"서약":{"voiceline":"이런 모습으로 반지를 받다니, 정말 죄송해요…. 이런 저를 받아주셔서 정말 감사합니다…! 지휘관님을 만난 건 운명의 레이스 중에서 가장 행복한 일일 거예요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/propose.ogg"},"스킬":{"voiceline":"요, 용서해주세요…. >_<","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/skill.ogg"},"터치1":{"voiceline":"저기… 신경 쓰이시면 만져보셔도 괜찮아요…. 저 스스로 잘 제어할 테니까요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/touch.ogg"},"터치2":{"voiceline":"으흐흑…. 이, 이건 운명의 시련인가요…. >_<","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/touch2.ogg"},"입수시":{"voiceline":"처음 뵙겠습니다, 지휘관님. 저는 포춘이라고 해요. …사, 사슬은 신경 쓰지 말아 주세요. 힘을… 힘을 제어하기 위해서는 필요한 거라서요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/unlock.ogg"},"강화성공":{"voiceline":"제어… 더 잘할 수 있게 됐어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"운명이 내 편을 들어줬구나. 아니면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null