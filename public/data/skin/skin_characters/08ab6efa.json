n/audio/voiceline/304040/feeling1.ogg"},"낯섦":{"voiceline":"히에이는 어떤 상황에서도 당황하지 않는구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/feeling2.ogg"},"호감":{"voiceline":"하루나와는 쌍둥이지만, 나에게 그 녀석은 성가신 여동생같은 존재야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/feeling3.ogg"},"기쁨":{"voiceline":"뭐, 언니들은 모두 우수하니까 말이지. 언니들의 발목을 잡지 않도록 이쪽도 필사적으로 열심히 할 수밖에 없지…… 나도 우수하다고? 하하하, 지휘관에게 인정받으니 기쁘군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/feeling4.ogg"},"사랑":{"voiceline":"히에이가 주최하는 파티에 댄스타임이 있네만… 같이 춰 주지 않겠나? 파트너를 생각해봤지만 지휘관밖에 떠오르지 않아서 말야…… 응? 보통은 남자가 먼저 물어보는 건가? 아하하, 그랬나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고했다. 다음은 이 몸도 데려가 보는 건 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/home.ogg"},"hp 경고":{"voiceline":"자아… 최후의 막이 열린다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 이 몸이 활약해 줄 일이 있는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/login.ogg"},"실패":{"voiceline":"포격전에서 흩어질 수 있는 건, 어쩌면 행운일지도 모르겠군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/lose.ogg"},"우편":{"voiceline":"우편이다. 지휘관은 인기가 많군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/mail.ogg"},"임무":{"voiceline":"흠, 이번에 돌아올 땐 선물은 뭐로 해야 하나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/mission.ogg"},"임무완료":{"voiceline":"피곤에 쓰러진 애들이 있다더군. 함께 숙소까지 부축하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304040/mission_complete.ogg"},"서약":{"voiceline":"서, 설마 지휘관에게 대쉬받을 줄은… 왠지 부끄