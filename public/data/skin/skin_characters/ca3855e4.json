[{"클뜯 id":204020,"클뜯 함순이 id":20402,"함순이 이름":"리펄스","한글 함순이 + 스킨 이름":"리펄스","영문 함순이 + 스킨 이름":"Repulse","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204020/shipyard.png","설명":"리나운급 순양전함·리펄스(HMS Repulse)","자기소개":{"voiceline":"나는 리나운급 순양전함── 리펄스야. 이래 봬도 높으신 분들이랑 여기저기 돌아다녀 봤다구! 뭐, 직접 움직이는 편이 좋지만 말이지! \n「리페어」? 아하하하, 지휘관은 매일 집에 틀어박혀 있지 않았으면 하네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/profile.ogg"},"메인1":{"voiceline":"Hey! 지─휘─관! 몸을 움직이자고~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/main1.ogg"},"메인2":{"voiceline":"지휘관은 강해 보이네, 언젠가 한 번 겨뤄볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/main2.ogg"},"메인3":{"voiceline":"에? 지휘관, 내가 성질이 급하다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/main3.ogg"},"전투개시":{"voiceline":"움직이는 것들 전부 날려버려! 랄까나☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/battle.ogg"},"상세확인":{"voiceline":"Hi! 지휘관! 움직이기 편하게 얇게 입어봤어~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/detail.ogg"},"드랍 설명":{"voiceline":"리나운급 순양전함·리펄스(HMS Repulse)","voicelink":null},"의뢰 완료":{"voiceline":"아웃도어파 리펄스를 방에 틀어박혀 있게 하구~ 벌로 저 아이들이 가져온 의뢰 성과를 시찰하러 가는 거야! Let's go!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/expedition.ogg"},"실망":{"voiceline":"지휘관이랑 같이 있으니 뭔가 지루해… 잠깐 나갔다 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/feeling1.ogg"},"낯섦":{"voiceline":"방에만 박혀있는 건 지루하고, 역시 밖은 좋네~ 지휘관도 매일 앉아 있기만 해서 기분 안 좋지? 같이 신선한 공기 마시러 가자구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/feeling2.ogg"},"호감":{"voiceline":"언니한테 성질 급하단 소리를 자주 듣긴 하지만, 나한테는 오히려 생각하는 게 귀찮다는 느낌이야. 거기다 지휘관도 있으니 두뇌 노동은 맡겨버려야지☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/feeling3.ogg"},"기쁨":{"voiceline":"지─휘─관! 에잇! …응? 너무 달라붙는다고? 에에~ 아무렴 어때~ 그것보다, 같이 놀러 가자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/feeling4.ogg"},"사랑":{"voiceline":"지휘관 말야, 나도 여자아이고, 아무리 대범하다고 해도 무방비하게 좋아하지도 않는 사람한테 달라붙지는 않잖아? 슬슬 눈치채주지 않을까나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"귀환하자마자 쉬면 안 돼! 조금 더 운동하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"헬로─ 지휘관! 같이 적을 너덜너덜하게 만들어주자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/login.ogg"},"실패":{"voiceline":"아아~ 적이 계속 끈질기게 구니까, 벌써 배가 꼬르륵거린다구… 이런 걸 이길 수 있을 리가 없어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/lose.ogg"},"우편":{"voiceline":"배달 담당 리펄스, 편지를 전달하러 왔습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/mail.ogg"},"임무":{"voiceline":"미션! 미션! 미션!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/mission.ogg"},"임무완료":{"voiceline":"Yes! 미션 보너스가 도착했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/mission_complete.ogg"},"서약":{"voiceline":"에에!? 나로 괜찮은 거야? 그치만 로열의 다른 언니들처럼 기품도 없고, 스타일이 좋은 것도 아니고 머리도 나쁘고…… 그, 그래도 지휘관을 향한 마음만큼은 누구한테도 지지 않는다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/propose.ogg"},"스킬":{"voiceline":"조준… 퐁!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/skill.ogg"},"터치1":{"voiceline":"에? 지휘관은 좀 더 말랑말랑한 여자애를 좋아하는 줄 알았어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/touch.ogg"},"터치2":{"voiceline":"우와앗! 자, 잠깐… 너무해! 나도 일단은 여자아이니깐 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/touch2.ogg"},"입수시":{"voiceline":"나는 리나운급 순양전함, 리펄스. 비스마르크 추격에 참여했지만 쫓아가질 못했었어. 그 이후에는 Z 함대… 이제 어뢰는 두 번 다신 보고 싶지 않아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 같이 바닷가에 산책하러 가지 않을래? 지켜줄 테니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"야호─! 이겼다구! 속전속결이야말로 승리의 지름길!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0},{"클뜯 id":204021,"클뜯 함순이 id":20402,"함순이 이름":"리펄스","한글 함순이 + 스킨 이름":"춘화의 연무","영문 함순이 + 스킨 이름":"Dance of Spring Blooms","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204021/shipyard.png","설명":"Hey, 지휘관! 후후후, 어디 가? 괜찮으면 검무 리허설 하는 것 좀 보고 가지 않을래? 이스트 글림 검술이랑 내 아이디어를 조합해서 만든, 완전히 새로운 오리지널 무예야♪","자기소개":null,"메인1":{"voiceline":"지휘관, 내 검 든 자세 어때? 무협영화에 나오는 거 같지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/main1.ogg"},"메인2":{"voiceline":"움직임에 군더더기가 많다고 언니가 그러던데, 이런 게 내 스타일이거든! 지휘관도 이런 내 쪽이 더 좋지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/main2.ogg"},"메인3":{"voiceline":"지휘관~ 연무할 때는 더 점프하거나, 휘리릭 하고 공중제비도 해보는 편이 좋을까? 왠지 엄청 재밌을 것 같아! …응? 좀 과하다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관, 이 옷 어때? 검무를 위해서 일부러 만든 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/detail.ogg"},"드랍 설명":{"voiceline":"Hey, 지휘관! 후후후, 어디 가? 괜찮으면 검무 리허설 하는 것 좀 보고 가지 않을래? 이스트 글림 검술이랑 내 아이디어를 조합해서 만든, 완전히 새로운 오리지널 무예야♪","voicelink":null},"의뢰 완료":{"voiceline":"지휘관한테 보고할게~ 의뢰가 완료됐어~ 그래도 마중 나가기 전에 이 새로운 기술부터 보고 가! Ta-da!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이 검무는 연회에서 모항 동료들에게 보여줄 거지만, 사실은 지휘관한테 보여주고 싶어서 연습한 거야! 나… 다른 애들에 비하면 우아하지도 않고 매력도 없잖아…? 그래서 내 가장 멋진 모습을 내 나름의 방식으로 보여주고 싶었어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/feeling5.ogg"},"터치3":{"voiceline":"에헤헤~ 칭찬해 주는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/headtouch.ogg"},"모항귀환":{"voiceline":"와아아, 지휘관! 아직 쉬기는 일러! 조금만 더 조언해 주라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"Hiya! 지휘관, 딱 좋은 타이밍에 잘 왔어! 내가 멋진 모습 보여줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/login.ogg"},"실패":null,"우편":{"voiceline":"소드 마스터의 반격! 질풍과도 같은 움직임으로 지휘관에게 우편 전달하기! 어서 확인해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이 검 보고 싶어? 그럼 조심해서 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/touch.ogg"},"터치2":{"voiceline":"으아아아! 지휘관…… 위험하다니까…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/touch2.ogg"},"입수시":{"voiceline":"Hey, 지휘관! 후후후, 어디 가? 괜찮으면 검무 리허설 하는 것 좀 보고 가지 않을래? 이스트 글림 검술이랑 내 아이디어를 조합해서 만든, 완전히 새로운 오리지널 무예야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204021/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":0,"상점 카테고리 id":3,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0}]