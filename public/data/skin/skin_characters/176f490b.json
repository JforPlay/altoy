[{"클뜯 id":399060,"클뜯 함순이 id":39906,"함순이 이름":"시만토","한글 함순이 + 스킨 이름":"시만토","영문 함순이 + 스킨 이름":"Shimanto","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399060/shipyard.png","설명":"경순양함—시만토","자기소개":{"voiceline":"사쿠라 엠파이어 소속 경순양함 시만토야. 소원이 구현화된 계획함으로서, 그리고 봉인이 풀린 용의 전승으로서 지휘관의 함대에 합류할게. 음… 그… 원하면 용신님이라고 불러도 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/profile.ogg"},"메인1":{"voiceline":"공물은 뭐가 좋냐고? 굳이 말하자면 지휘관이 좋아하는 간식으로… 뭐든 상관없어. 으흠, 뭐든 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/main1.ogg"},"메인2":{"voiceline":"아직 일이 다 안 끝났지? 조금만 더 참아. …게으름 피우면 천벌 내린다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/main2.ogg"},"메인3":{"voiceline":"나가토 님의 고충이 뭔지 알 거 같아. 이렇게 지휘관 덕분에 편하게 지내고는 있지만, 많은 사람에게 공경받는다는 건 피곤한 일이야. 항상 용신님이라고 불리는 것도 왠지 좀 부끄럽고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/main3.ogg"},"전투개시":{"voiceline":"용신의 포격을 받아라……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/battle.ogg"},"상세확인":{"voiceline":"마음 편하게 있어. 여긴 어디까지나 지휘관의 모항이니까, 용신님이 머무르는 방도 지휘관 집이라고 생각하……긴 어렵겠지만, 그렇게 굳어있지 말고 편하게 있어도 된다니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/detail.ogg"},"드랍 설명":{"voiceline":"경순양함 - 시만토","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰… 아하, 공물이라도 바치려고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/expedition.ogg"},"실망":{"voiceline":"용을 화나게 하면 어떻게 될지… 지휘관, 그게 궁금해서 일부러 그러는 건 아니…지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/feeling1.ogg"},"낯섦":{"voiceline":"그대가 해야 할 일, 취해야 할 태도는 둘 중 하나… 벌을 받지 않기 위해 용신의 힘을 두려워하며 따르던가, 지휘관으로서 함선 시만토를 믿고 의지하던가야. 나는 딱히 어느 쪽이든 상관없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/feeling2.ogg"},"호감":{"voiceline":"아직도 뭔가 좀 격식을 차리는 느낌이란 말이지. 그대가 고치지 못한다면, 나 또한 그에 맞춰 위엄있게 대할 수밖에… (꾸르륵…) 바, 방금 건 배에서 나는 소리가 아니라, 처, 천둥이야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/feeling3.ogg"},"기쁨":{"voiceline":"그래그래, 이렇게 평범하게 간식 먹고 수다 떨면 돼. 용신님이라고는 하지만 지금은 잡담에 어울리는 평범한 동료일 뿐, 그대가 원한다면 데이트도 해줄 수 있어. ……아, 그… 방금 말은 진심으로 한 건데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/feeling4.ogg"},"사랑":{"voiceline":"오늘 하루는 지휘관과 데이트하는, 별 위엄 없는 용신님이야. 자, 에스코트해줘. 나, 이런 건 처음이라서 위엄을 부리려야 부릴 수가 없다고…… 후후후, 조금은 용신님에게 어울려 주는 법을 터득한 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/feeling5.ogg"},"터치3":{"voiceline":"…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/headtouch.ogg"},"모항귀환":{"voiceline":"수고했어, 지휘관. 전투는 할 만했어? 아, 딱히 내가 뭘 해준 건 없으니까, 그렇게 깍듯하게 대해줄 필요는 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/home.ogg"},"hp 경고":{"voiceline":"역린을 건드린 벌… 내려주마……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/hp_warning.ogg"},"로그인":{"voiceline":"으흠, 지휘관. 그대의 소원을 말해보아라. …응? 왜 아무 말도 안 해? 비서함한테 아무 일도 안 시키려고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/login.ogg"},"실패":{"voiceline":"사악한 기운이 생각보다 더…… 윽…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/lose.ogg"},"우편":{"voiceline":"우편? 누가 가져다주려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/mail.ogg"},"임무":{"voiceline":"어서 임무를 처리해야지. 지휘관, 열심히 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/mission.ogg"},"임무완료":{"voiceline":"임무 끝났어? 그래, 수고했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/mission_complete.ogg"},"서약":{"voiceline":"맹세를 나누면 그대와 나는 떼려야 뗄 수 없는 관계가…… 이건 은혜이기도 저주이기도 해. 그래도 괜찮아? …그래? 후후후, 그럼 다음은 뭘 하면 돼? 키스? 포옹? 아니면…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/propose.ogg"},"스킬":{"voiceline":"식지수룡의 힘을 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/skill.ogg"},"터치1":{"voiceline":"용신님에게 소원을? 비라도 내려달라고 하려고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/touch.ogg"},"터치2":{"voiceline":"음… 벌을 내려줘야 하나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/touch2.ogg"},"입수시":{"voiceline":"불입의 봉인이 풀렸나니, 눈을 뜬 위대한 용신께 경의를 표하라…… 후후후, 그렇게 굳어 있을 필요 없어. 나는 시만토, 소원이 구현된 환상 중 하나… 지휘관, 앞으로 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/unlock.ogg"},"강화성공":{"voiceline":"강하게 해주려고? 그럼 이 힘, 마음껏 써도 되는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"숭상하라, 두려워하라. 거세게 휘몰아치는 용신의 폭풍을…… 아하하, 식신이 젖어서 다시 종이가 돼버렸네….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/win_mvp.ogg"},"전투개시_ex":{"voiceline":"용이 적을 섬멸하리라…랄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/battle_ex.ogg"},"상세확인_ex":{"voiceline":"잠깐 일은 내려놓고 느긋하게 쉬어. 여긴 좀처럼 사람이 안 오기도 하고, 들키더라도 용신님께 기도를 올리고 있었다고 하면 괜찮으니까 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔네. 후후, 용신님은 뭐든지 알고 있다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/expedition_ex.ogg"},"사랑_ex":{"voiceline":"그래그래, 격식 차리는 것도, 사양하기도 없기야. 여기서 가장 높은 사람은 지휘관이니까 마음껏 어필해도 돼. 나는 언제든 당신만의 시만토, 당신만의 용신님이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"이거 때문에 위엄이 느껴지는 거려나…? 아마...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"수고했어, 지휘관. 그나저나 선물은? 후후, 용신님에게 바칠 공물이 아니라, 거기서 있었던 재밌는 이야기도 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"자, 소원을 말해 보아라. 내가 그대의 힘에…… 잠깐! 정지! 그런 소원이라면 간식을 두 배로 늘리지 않으면 안 되거든?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"나한테 임무를 도와달라고 해도 괜찮아. 지금은 용신님이 아니라 비서함인걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/mission_ex.ogg"},"임무완료_ex":{"voiceline":"아, 설마 임무 완료했어…? 모처럼 도와주려고 했는데… 아니야, 잘 했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"내 힘이 필요해? 응, 얼마든 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/touch_ex.ogg"},"터치2_ex":{"voiceline":"용신님이 여러모로 은혜를 베풀어줬으면 해? 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"승리의 비라도 뿌려줄까? 후후후, 농담인데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['하쿠류'] :  칼은 꼭 잡고 있어, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/couple_encourage1.ogg"},{"voiceline":"['보클랭', '마이예 브레제', '아틸리오 레골로'] :  피망이 그렇게 싫어…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/couple_encourage2.ogg"}],"메인4":{"voiceline":"응, 잘했어. …아아, 이건 보통 종이비행기가 아니라 식지…… 음~ 확실히 지금은 지휘관 말대로 그냥 평범한 종이비행기네... 흠...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"요즘은 햇살이 강해서 좀 덥다고? …후훗, 이거 내가 나설 차례네. 내 비장의 비, 한가득 내려줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/main5_ex.ogg"},"메인6_ex":{"voiceline":"피곤해? 피곤하면 어쩔 수 없지. 컨디션이 좋아질 때까지 둘이서 쥬스타그램이라도 보면서 이야기나 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/main6_ex.ogg"},"메인7_ex":{"voiceline":"이 칼은 누구의…? 아, 아하~ 그렇구나. 이것만 있으면 그 아이에게 간식을 잔뜩 뜯어낼 수 있겠어. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399060/main7_ex.ogg"},"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":399061,"클뜯 함순이 id":39906,"함순이 이름":"시만토","한글 함순이 + 스킨 이름":"따끈따끈 용신님","영문 함순이 + 스킨 이름":"The Comfy Dragon God","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399061/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399061/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399061/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399061/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399061/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399061/shipyard.png","설명":"잘 왔노라. 그대에게 용신의 특별 수제 차를 한잔 대접하주마…… 아, 지금 물 끓이는 중이니까 잠깐만 기다려. 차 마신 다음에는 누워서 같이 느긋하게 쉬자.","자기소개":null,"메인1":{"voiceline":"참으로 훌륭한지고… 어때? 용신님의 차도 꽤 맛있지? 평소에 그냥 멋으로만 차를 헌상받는 건 아니라는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399061/main1.ogg"},"메인2":{"voiceline":"자, 여기 머리를 대고… (작은 목소리로) 그래, 여기도 나름 따뜻해서 괜찮지? 계속 이러고 있어도 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399061/main2.ogg"},"메인3":{"voiceline":"후~ 후~ 자, 이젠 괜찮을 거야. 아, 실수로 더 끓여버렸네. 입김으로 온도를 조절하는 건 정말 어렵다니까… 아니라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399061/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이 의상은 분명 '시중'을 들기 위한 것이라던데, 구체적으로는 뭘 하면 되는 거야? 용신님도 속세에 대해서는 잘 모르니까, 지휘관이 꼭 좀 이것저것 가르쳐줬으면 좋겠어~ 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399061/detail.ogg"},"드랍 설명":{"voiceline":"잘 왔노라. 그대에게 용신의 특별 수제 차를 한잔 대접하주마…… 아, 지금 물 끓이는 중이니까 잠깐만 기다려. 차 마신 다음에는 누워서 같이 느긋하게 쉬자.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네. 다과는 충분하려나? 나중에 아즈마네한테 부탁해서 더 가져다줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399061/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"좋아좋아, 착하다 착해…… 차의 향기를 음미하고, 용신님의 따뜻하고 부드러운 허벅지를 느끼면서 어서 꿈의 나라로 떠나는 거야~ 후후후, 아무 생각도 하지 말고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399061/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어. 먼저 차라도 마실래? 아니면 여기 누워서 쉴래? 뭘 고르든 몸이 따끈해질 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/39