[{"클뜯 id":9701110,"클뜯 함순이 id":970111,"함순이 이름":"카라비니에레·META","한글 함순이 + 스킨 이름":"카라비니에레·META","영문 함순이 + 스킨 이름":"Carabiniere META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701110/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701110/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701110/shipyard.png","설명":"전담 호위 카라비니에레, 착임했습니다! 이후 일정에 대한 리스크 점검과 대책을 완료했으니, 안심하고 외출하시기 바랍니다!","자기소개":{"voiceline":"「카라비니에레」라는 이름은 곧 신속함과 수호의 상징—— 오늘부터 지휘관님의 신변 안전은 제가 보장하겠습니다. 과거의 힘도, 각오도 모두 이 책무를 위해 바치겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/profile.ogg"},"메인1":{"voiceline":"보안 직원 점검 완료, 장비 리스트도……그건! 제가 계속 시험해 보고 싶었던 총 아닙니까?! 화력도 정확도도 전설급인… 순찰하면서 천천히 이야기하자고요? 물론 좋습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/main1.ogg"},"메인2":{"voiceline":"무기 손질은 호위 담당의 일과 중 하나지요. 구조와 성능, 그리고 정비 타이밍은…… 크흠, 또 전문적인 이야기로 들떠버렸군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/main2.ogg"},"메인3":{"voiceline":"모항에 이렇게 잘 정비된 마장이 있다니…! 복잡한 지형에서 보여주는 좋은 군마의 기동성은 절대 대체할 수 없지요… 아, 네! 업무가 끝나면 함께 타러 가시죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/main3.ogg"},"전투개시":{"voiceline":"지휘관님을 지키며, 위협원을 제거하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 혹시 이상이 있었던 겁니까? ……평소처럼 순찰을 도신 것뿐이라고요? 그렇군요… 경계를 유지하는 건 좋은 일이지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/detail.ogg"},"드랍 설명":{"voiceline":"  솔다티급 구축함 카라비니에레<color=#92fc63>(1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 무사히 귀환했습니다. 다들 돌아와서 다행입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/expedition.ogg"},"실망":{"voiceline":"……당신이 제가 충성을 바쳐야 할 대상인지는 아직 평가 중입니다. 결론이 날 때까지, 호위 임무는 철저히 수행하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/feeling1.ogg"},"낯섦":{"voiceline":"……제 보안 계획이 완벽하다고요? 에, 에헤헷……지휘관님께서 칭찬해 주시다니, 더없는 영광입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/feeling2.ogg"},"호감":{"voiceline":"경계를 단 한 순간도 늦추지 않는 것이 호위 임무지요. ……마, 만약 대화를 원하신다면 언제든 상대해 드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 피곤하시면 저와 잠시 대화를 나누며 기분 전환이라도 하시겠습니까? 총기 지식이나 말에 대한 이야기라면 얼마든지 알고 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/feeling4.ogg"},"사랑":{"voiceline":"모항에 있으니 마음이 끝없이 차분해지는군요. 이곳의 모든 것이… 특히 지휘관님의 존재가, 제 호위에 새로운 의미를 부여해 주었습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/feeling5.ogg"},"터치3":{"voiceline":"지휘관님, 아직 긴장을 풀 때가 아닙니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/headtouch.ogg"},"모항귀환":{"voiceline":"돌아오셨습니까? 부재 중 모든 사항은 순조롭게 진행되었습니다. 이쪽은 상세 내용을 기재한 근무 보고서입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/home.ogg"},"hp 경고":{"voiceline":"보안 계획을 다시 평가해야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 오늘의 보안 계획 점검을 완료했습니다. 언제든 집무를 개시하셔도 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/login.ogg"},"실패":{"voiceline":"지휘관님을 최우선으로 대피시키세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/lose.ogg"},"우편":{"voiceline":"지휘관님, 새로운 우편이 보안 검사를 통과했습니다. 언제든 확인 가능합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/mail.ogg"},"임무":{"voiceline":"지휘관님, 아직 대응이 필요한 안건이 남아 있는데, 저도 도와드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/mission.ogg"},"임무완료":{"voiceline":"임무 보상을 확인했습니다. …아니, 제게 있어서는 호위 임무를 완수하는 것 자체가 최고의 보상입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/mission_complete.ogg"},"서약":{"voiceline":"이 서약은…… 알겠습니다. 이 총과, 전문가로서의 제 모든 역량은 지휘관님을 위해 사용하겠습니다. 이는 명령에 따르는 것이 아니라, 카라비니에레가 개인적으로 드리는 약속입니다…… 앞으로도 잘 부탁드립니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/propose.ogg"},"스킬":{"voiceline":"조정 완료… 사격 개시합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/skill.ogg"},"터치1":{"voiceline":"지휘관님, 지금 총을 손질하고 있었는데…… 관심이 있으십니까?! 이쪽으로 오십시오! 예술품에도 뒤지지 않는 이 아이의 정밀한 내부 구조를 기꺼이 보여드리겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/touch.ogg"},"터치2":{"voiceline":"지, 지휘관님… 그렇게 깜짝 놀래키면 곤란합니다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/touch2.ogg"},"입수시":{"voiceline":"전담 호위 카라비니에레, 착임했습니다! 이후 일정에 대한 리스크 점검과 대책을 완료했으니, 안심하고 외출하시기 바랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/unlock.ogg"},"강화성공":{"voiceline":"지휘관님을 지키는 제 힘이 또 한층 강해졌군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"위협은 제거했지만, 호위 임무는 아직 끝나지 않았습니다. 부디 경계를 늦추지 말아 주시길.","voicelink":