[{"클뜯 id":305050,"클뜯 함순이 id":30505,"함순이 이름":"나가토","한글 함순이 + 스킨 이름":"나가토","영문 함순이 + 스킨 이름":"Nagato","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305050/shipyard.png","설명":"나가토급 전함 1번함 - 나가토 ","자기소개":{"voiceline":"사쿠라 엠파이어의 혼, 사쿠라 엠파이어의 자랑, 그리고 사쿠라 엠파이어의 영광…… 그 시대 자체의 상징이기도 한, 빅 세븐인 이 몸을, 괄목하여 보도록 하거라……이걸로 됐는가? 지쳤으니, 이 몸은 이제 쉬겠노라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/profile.ogg"},"메인1":{"voiceline":"다툼은 좋아하지 않는다, 그러나 그때는… 이 몸에게 선택지는 없었다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/main1.ogg"},"메인2":{"voiceline":"전쟁을 논하는 무리는, 과연 제대로 된 각오와 자신이 있는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/main2.ogg"},"메인3":{"voiceline":"그 재해에서 구한 백성들의 웃는 얼굴, 이 몸은 절대로 잊지 못한다… 그것이야말로 이 몸이 지키고 싶은 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/main3.ogg"},"전투개시":{"voiceline":"다시… 슬픈 전쟁을… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/battle.ogg"},"상세확인":{"voiceline":"모두의 얼굴에 미소가 넘치는구나…… 이 몸은 이 장소가 마음에 들었다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/detail.ogg"},"드랍 설명":{"voiceline":"나가토급 전함 1번함 - 나가토","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었다… 여, 여봐라… 모처럼 이 몸이 시간을 기억했는데, 그대는 아무 생각도 들지 않는 겐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/expedition.ogg"},"실망":{"voiceline":"그대의 바람은… 이 몸에게 과오를 되풀이하라는 것인가? 이 몸은… 알겠다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/feeling1.ogg"},"낯섦":{"voiceline":"무슨 일이냐? 이 몸? 이 몸은 아무것도 하고 있지 않다. 그 일을 야마토에게 맡겼으니, 이 몸이 할 일은 싸움밖에 남아있지 않노라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/feeling2.ogg"},"호감":{"voiceline":"모두와 좀 더 함께 있어, 라고? 함께 있어도 이 몸은 무엇을 하면 좋을지 모르거니와, 게다가 이 몸을 모두가 겁내는 것이 훤히 보인다…… 뭘 하고 있느냐! 어째서 이 몸의 장비를 벗기려 하는 것이냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/feeling3.ogg"},"기쁨":{"voiceline":"과연, 장비를 벗고 나서부터, 모두가 무서워하지 않게 되었구나. 확실히 기분이 가벼워졌다만… 하지만 이 희미한 상실감은 어째서인가… 기함을 야마토에게 물려줄 때와 같은 듯한……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/feeling4.ogg"},"사랑":{"voiceline":"소중히 대해주는 사람이 있는 게 좋은 건가? 그렇다면… 이 몸을 데려나온 것이 그대이니, 채, 책임을 져줘야겠다… 저기… 그, 그러니… 그, 그대에게 명한다… 이 몸을 소중히 하는 것이다… 어, 어떠냐…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"사람을 마중나간 적은 없다만… 포를 쏘면 되겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/home.ogg"},"hp 경고":{"voiceline":"결전의 때인가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/hp_warning.ogg"},"로그인":{"voiceline":"어서 오레… 혀, 혀를 깨물었을 뿐이니라…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/login.ogg"},"실패":{"voiceline":"우으…… 또 실패해버렸어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/lose.ogg"},"우편":{"voiceline":"이 종이조각은? '우편'? 그런가, 우편인가. 이 몸이 읽어봐도 되겠는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/mail.ogg"},"임무":{"voiceline":"임무의 서류는 이걸로 됐는가? 이 몸은 잘 모르겠다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/mission.ogg"},"임무완료":{"voiceline":"임무 보수… 영차… 후우… 여기 두면 되겠는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/mission_complete.ogg"},"서약":{"voiceline":"전란의 저편에 있는 것이, 그 모든 것을 집어삼키는 빛이 아니라 그대의 따뜻한 온기라면, 지금의 나는… 달리 아무것도 바라지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/propose.ogg"},"스킬":{"voiceline":"이 몸은 나가토… 사쿠라 엠파이어의 나가토다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/skill.ogg"},"터치1":{"voiceline":"……! 이, 이리도 쉽게 이 몸을 만진 자는 없었다… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/touch.ogg"},"터치2":{"voiceline":"……무, 무례한 놈!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/touch2.ogg"},"입수시":{"voiceline":"이 몸은 사쿠라 엠파이어 연합함대 기함…… 나가토다. 그대는 지휘관인가? 천하를 취할 자질이 있는지, 똑똑히 이 눈으로 보도록 하마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/unlock.ogg"},"강화성공":{"voiceline":"싸움이 멈추는 날이 오기를……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어리석은 놈이… 어찌하여 이 몸을 화나게 한 것이냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['IJN'] : 연합함대, 적을 분쇄하라","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305050/couple_encourage1.ogg"},{"voiceline":"['후소', '야마시로', '무츠'] : 제1 전대, 화력 전개","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/3