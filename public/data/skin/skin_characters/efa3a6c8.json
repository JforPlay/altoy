[{"클뜯 id":206080,"클뜯 함순이 id":20608,"함순이 이름":"테세우스","한글 함순이 + 스킨 이름":"테세우스","영문 함순이 + 스킨 이름":"Theseus","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206080/shipyard.png","설명":"콜로서스급 항공모함—테세우스","자기소개":{"voiceline":"콜로서스급 항공모함인 테세우스야. 그 대전에는 좀 완성이 늦어져서 전투에 참여하지는 못했어…. 그렇지만 괜찮아. 테세우스의 함선이 테세우스 그 자체라는 점은 무슨 일이 있어도 변하지 않으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/profile.ogg"},"메인1":{"voiceline":"안녕, 유니콘 씨. 유우한테 또 과자 주러 가도 돼? …응? 왜 그래? 나 무슨 이상한 말이라도 한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/main1.ogg"},"메인2":{"voiceline":"잔뜩 쌓인 업무가 무슨 달이고 있는 약초같아……. 지휘관, 잘 보고 있어. 내가 지금 싹 처리해 줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/main2.ogg"},"메인3":{"voiceline":"생각 날 때 바로 행동으로 옮기라고 하지만, 생각이 안 나더라도 손을 놀리면 안 돼. 일단은 기분전환으로 집무실 청소라도 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/main3.ogg"},"전투개시":{"voiceline":"전투 시작이야. 다들, 날 따라와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/battle.ogg"},"상세확인":{"voiceline":"여자의 비밀을 파헤치려는, 테세우스의 방 안을 몰래 들여다보는 나쁜 고양이는…… 잡았다♪ 응? 지휘관? 방금 건 지휘관이 아니라, 이 아이를 말하는 거였는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/detail.ogg"},"드랍 설명":{"voiceline":"콜로서스급 항공모함—테세우스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 사람들이 돌아왔어. 지휘관, 어떻게 할 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/expedition.ogg"},"실망":{"voiceline":"으스대지 말라구, 괴물 씨. 다른 사람들 대신 테세우스가 퇴치해버린다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/feeling1.ogg"},"낯섦":{"voiceline":"이런 곳에서 만나다니 별일이네, 지휘관. 날 찾기라도 한 거야? 에헤헤, 왠지 코를 킁킁거리면서 동료들을 찾는 멍멍이 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/feeling2.ogg"},"호감":{"voiceline":"지휘관도 같이 할래? 숲속에서 다과회를 즐기는 것도 괜찮지? …피크닉? 음, 확실히 피크닉이라고 하니까 피크닉인 것 같기도 하고….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/feeling3.ogg"},"기쁨":{"voiceline":"안녕, 모두의 영웅님. 업무는 괜찮아? 안 피곤해? 에헤헤, 무슨 일 있으면 언제든 테세우스에게 말하라구. 할 수 있는 건 해줄 거고, 못하는 거라도 열심히 생각해볼 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/feeling4.ogg"},"사랑":{"voiceline":"잘 보고 있으라구. 이게 테세우스의…… 에헤헤, 딱히 대단한 건 아니야. 지휘관한테 곤란한 일이 생기면 그걸 테세우스도 알 수 있게 주문을 좀 건 것뿐이야. 굳이 말을 안 걸어도 되니까 편리하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어, 승리를 이끄는 매님. 회고도 좋지만, 지금은 모두와 함께 솔직하게 기뻐하는 게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/home.ogg"},"hp 경고":{"voiceline":"테세우스는… 지지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침, 모항을 수호하는 기사님. 어젠 잘 잤어? 오늘도 테세우스랑 동료들, 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/login.ogg"},"실패":{"voiceline":"졌어……. 지휘관, 모두를 데리고 한번 다시 해보자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/lose.ogg"},"우편":{"voiceline":"지휘관한테 온 우편이네……. 전서구로 온 거라 나한테 온 건 줄 알았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/mail.ogg"},"임무":{"voiceline":"임무구나……. 알았어. 나랑 같이 처리하자, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/mission.ogg"},"임무완료":{"voiceline":"에헤헤, 아무리 곰이라도 다 못 받을 정도로 임무 보상이 많네. 잘됐다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/mission_complete.ogg"},"서약":{"voiceline":"반지는 건넸지만 고백할 타이밍에 대해선 잘 모르는 것 같네. 응응, 이럴 땐 내가…… 어머? 방금 걸로 결심이 섰다고? 자, 잘됐네! 에헤헤, 나, 도움이 된 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/propose.ogg"},"스킬":{"voiceline":"잘 보고 있어! 받아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/skill.ogg"},"터치1":{"voiceline":"응응. 지휘관의 걱정 거리, 내가 잘 들어줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/touch.ogg"},"터치2":{"voiceline":"앗, 갑자기 왜 그래…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/touch2.ogg"},"입수시":{"voiceline":"콜로서스급 경항공모함 테세우스야. 만나서 반가워, 함대를 이끄는 양치기님. 전투든 가사노동이든 주문이든, 테세우스에게 볼일이 있다면 언제든 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/unlock.ogg"},"강화성공":{"voiceline":"테세우스의 새로운 힘, 잘 보고 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어때? 나, 지휘관이 생각한 작전, 잘 수행한 것 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/win_mvp.ogg"},"전투개시_ex":{"voiceline":"나와 지휘관의 힘을 똑똑히 보아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/battle_ex.ogg"},"상세확인_ex":{"voiceline":"으음, 몰래 훔쳐보던 검은 고양이가 저기 있었는데… 에헤헤, 그렇게 굳지마. 지휘관이라면 언제든 환영이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰를 나갔던 동료들이 돌아왔어. 이럴 땐 고양이 자세로 손을 흔들… 틀렸어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/expedition_ex.ogg"},"사랑_ex":{"voiceline":"아, 지휘관, 고민있어? 에헤헤, 주문을 걸거나 하려는 건 아냐. 아무런 일도 없는데 테세우스를 보러 오셨다는 말이지?…\"테세우스가 보고 싶은 것\"도 고민 중 하나야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"수고했어, 동료들을 인도하는 갈매기님. 오늘도 열심이네. 머리 쓰다듬어 줄까? 아니면 편안히 숙면을 취할 수 있는 주문을 걸어줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"굿모닝, 테세우스의 기사님. 오늘도 같이 힘내자, 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"어려운 일 있어? 그럼 내가 나설 차례군. 하하, 잘 보라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/touch_ex.ogg"},"터치2_ex":{"voiceline":"쓰담 쓰담. 지휘관은 착한 아이~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"우리가 이겼어. 후후, 칭찬해 줄래? 사자 같이 멋진 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"음, 사무실을 청소할 때 다음 일은 뭐부터 시작할지 생각해 봤는데, 그러니까… 아, 먼저 지휘관에게 음료부터 준비해 줘야겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/main5_ex.ogg"},"메인6_ex":{"voiceline":"뒷산에서 삼림욕… 응! 재밌을 것 같아! 그럼 바로 다과회 세트랑 디저트를 준비해야…… 에? 피크닉이랑 비슷한 것 같네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206080/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"퍼시어스! 다음에도 유니콘이랑 같이 다과회 열 거야? 저번에 그 디저트들 너무 맛있었어!","voicelink":"https