[{"클뜯 id":301920,"클뜯 함순이 id":30192,"함순이 이름":"타에카제","한글 함순이 + 스킨 이름":"타에카제","영문 함순이 + 스킨 이름":"Taekaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301920/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301920/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301920/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301920/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301920/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301920/shipyard.png","설명":"유구모급 구축함 - 타에카제","자기소개":{"voiceline":"사쿠라 엠파이어 소속, 유구모급 구축함 타에카제야! 예전엔 못 보여줬던 진짜 실력을 지휘관한테 보여줄게! 눈 떼지 마~ 이게 바로 타에카제의 변화술!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/profile.ogg"},"메인1":{"voiceline":"쿠로마루를 만드는 수련을 하는 중이야! …이건 닌자 도구가 아니라, 맛있는 간식…이 아니라! 맛있는 병량환이야! 지휘관도 하나 먹어 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/main1.ogg"},"메인2":{"voiceline":"으아! 지휘관한테 잡혔어~! 하지만 아쉽게 됐네! 바뀌치기술! 받아랏! ……에헤헤, 또 잡아 보시지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/main2.ogg"},"메인3":{"voiceline":"이거 봐, 지휘관. 이게 바로 타에카제의 수상보행술…… 으아아! 저녁밥 생각에 집중이 풀려서… (보글보글) 어푸 어푸! 살려줘……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/main3.ogg"},"전투개시":{"voiceline":"닌자 타에카제! 적을 기습하러 간다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/battle.ogg"},"상세확인":{"voiceline":"응? 모자가 바람에 날려갔다고? 그, 렇구나! 오늘은 바람이 세네! 절대 바람처럼 닌자가 슬쩍 가져간 건 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/detail.ogg"},"드랍 설명":{"voiceline":"유구모급 구축함 - 타에카제","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이랑 같이 돌아왔어! …왜 상자로 변장했냐고? 이것도 닌자 수련 중 하나니까 그렇지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/expedition.ogg"},"실망":{"voiceline":"지휘관은 정말 재미없어… 장난칠 기분도 안 나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/feeling1.ogg"},"낯섦":{"voiceline":"분재? 나무? 맨홀 뚜껑? 다음엔 뭘로 변장해볼까~? 지휘관, 뭐 추천할 거 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/feeling2.ogg"},"호감":{"voiceline":"오늘 닌자 수련… 진짜 힘들었어! 지휘관, 어깨 좀 주물러 주라…… 으아?! 지, 지휘관? 왜 나무토막을…… 아! 미안해! 나도 모르게 바꿔치기술을 써버렸어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/feeling3.ogg"},"기쁨":{"voiceline":"후우…… 쿨쿨…… 앗! 아, 안 자고 있었어! 닌자의 사명은 지휘관을 곁에서 지키는 거잖아! 그러니까 지휘관이 일을 마치기 전까지는 타에카제도 여기서 같이…… 절대로 안 졸 거야…… 쿨쿨……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/feeling4.ogg"},"사랑":{"voiceline":"……후후후, 드디어 타에카제의 위장을 알아챘구나! 빨리 안 안아주면, 바로 슈슝하고 달아나 버릴 거야♪ ……뭐야, 빨리 좀 해. 이렇게나 지휘관한테 잡히려고 하고 있는데… /// ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/feeling5.ogg"},"터치3":{"voiceline":"으아아아! 안 돼! 안 돼! 안 돼! 닌자 수련에서는 잡힐 구석을 만들지 않는 게 가장 중요한데! 아무리 머리 쓰다듬는 게 기분 좋아도…… 안 돼…… 으아앙……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/headtouch.ogg"},"모항귀환":{"voiceline":"으랴아아아! 어서 와, 지휘관! 깜짝 놀랐지?! 에헤헤~ 뭐? 타에카제의 꼬리가 보였다고…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/home.ogg"},"hp 경고":{"voiceline":"아야야얏! ……약을 더 발라야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/hp_warning.ogg"},"로그인":{"voiceline":"연막탄, 펑! 후훗~ 갑자기 등장해서 놀랐지~? …켁, 콜록콜록…! 연기가… 너무 맵잖아……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/login.ogg"},"실패":{"voiceline":"으으, 은신술이 깨졌어…… 야압, 바꿔치기술! 탈출 성공!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/lose.ogg"},"우편":{"voiceline":"질풍이 새로운 우편을 싣고 왔어! 놀라운 정보가 있을지도 모르니까… 어서 확인해 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/mail.ogg"},"임무":{"voiceline":"임무 요청이 들어왔어! 신분을 감추는 잠입 임무? 아니면 정보 수집? 타에카제한테 맡기면 아무 흔적도 안 남기고 싹 처리해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 왔어! 이건 타에카제가 맡아둘게…… 후훗, 가져가고 싶으면 잡아봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/mission_complete.ogg"},"서약":{"voiceline":"이게 「사랑」이라는 이름의 유대… 만질 수 없지만 절대 끊어낼 수 없는 신기한 인연…… 붙잡을 수 없는 바람이라도 꼭 안아주면… 지휘관 품에서 떠나지 않을 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/propose.ogg"},"스킬":{"voiceline":"인법! 바람의 오의!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/skill.ogg"},"터치1":{"voiceline":"꼬, 꼬리 잡지 마…! 으아아! 다시는 의자로 변장하지 않을게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/touch.ogg"},"터치2":{"voiceline":"엥…? 에에에엥?! 지, 지, 지휘관?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/touch2.ogg"},"입수시":{"voiceline":"짜자잔! 숨바꼭질은 여기까지! 유구모급 구축함, 바람처럼 빠른 닌자 타에카제 등장! 지휘관한테 들켰으니…… 받아랏! 연막탄! 탈출 성공~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/unlock.ogg"},"강화성공":{"voiceline":"닌자 수련은 지금부터가 진짜 시작이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/upgrade.ogg"},"vote":null,"승리":{"voiceline":"신출귀몰! 자유자재! 변화의 닌자로서 실제로 보이고, 들리고, 자랑스럽게 말할 수 있는 대승리를 안겨주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"앗, 또 들켰어! 잠깐… 지휘관은 타에카제가 어디 숨는지 이미 다 알잖아~! 너무 불공평해~! 나빴어~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"타에카제는 늘 지휘관 곁에 있을 거야~ 오늘도, 내일도, 모레도, 글피도 계속! 만약 타에카제가 안 보이면…… 열심히 찾아줘야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"기분 좋아…… 더 만져줘…… 아무리 훌륭한 닌자라도, 가끔은 쉬어야 하는 법이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"야아아압~!! 후후후! 이번엔 확실히 놀랐지? 꼬리를 빗자루처럼 보이게 위장했지… 뭐!? 멀리서부터 흔들리는 게 다 보였다고? 비, 빗자루가…!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"드디어 왔네, 지휘관! 오늘 하루는 곁에서 지휘관을 지켜줄 거야! …후우, 그래도 인술로 천장에 매달리는 건 힘드니까… 그냥 지휘관 허벅지 위에 앉아서 지켜줘야지~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관, 타에카제 꼬리 좀 더 주물러 줘~ 좀 더 위쪽…… 응, 바로 거기야~ 아~ 진짜 천국이 따로 없네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/touch_ex.ogg"},"터치2_ex":{"voiceline":"여, 역시 어떻게 해야 할지 모르겠어……/// 전부 지휘관한테 맡길게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아카츠키', '쿠로시오'] : 임무가 끝나면 같이 수련하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관, 오늘 수련한 성과를 봐줘~! 후후후, 사랑이 듬뿍 담긴 도시락도 수련의 일부야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/main5_ex.ogg"},"메인6_ex":{"voiceline":"……갑자기 사라지는 일이 줄어들었다고? 당연하지~ 타에카제는 지휘관을 곁에서 지켜주고 싶으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관, 다음에 뭘로 변장할지 생각났어! 침구류가 딱 좋을 것 같지 않아? …이유? 에헴! 따끈따끈한 타에카제는 꼭 껴안고 자기 딱 좋거든~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301920/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":1},{"클뜯 id":301921,"클뜯 함순이 id":30192,"함순이 이름":"타에카제","한글 함순이 + 스킨 이름":"닌자 타에카제의 급강하 수련!","영문 함순이 + 스킨 이름":"Kunoichi's Emergency Landing","스킨 타입":"Ninja Castle","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301921/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301921/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301921/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301921/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301921/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301921/shipyard.png","설명":"으아아아! 떨어진다! …윽… 에, 에헤헤헤~ 좋은 아침이야, 지휘관…… 지, 지금은…… 그래! 닌자 수련을 하던 중이야! 일부러 지휘관을 놀라게 하려던 건 아니었어……","자기소개":null,"메인1":{"voiceline":"집무실 밖 나무에 숨어서 기회를 틈타 놀래켜준다… 정말 완벽한 작전이었는데! 왜 실패한 거냐고? 계속 자리를 안 잡고 서성이던 지휘관 때문이야, 다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301921/main1.ogg"},"메인2":{"voiceline":"후우… 올라오는 건 쉬웠는데, 내려가는 건…… 타에카제, 파이팅! 할 수 있어…! 3, 2, 1……! 안 돼… 너무 높아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301921/main2.ogg"},"메인3":{"voiceline":"으아… 주머니 끈이 풀려서 쿠나이가 사방으로 흩어졌어…! 으아, 지금 떨어지면 진짜 위험하겠지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/ma