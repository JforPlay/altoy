/audio/voiceline/405038/detail.ogg"},"드랍 설명":{"voiceline":"후… 결국 이날이 왔군. …놀랍지는 않아. 널 처음 본 순간부터 이렇게 될 운명이라는 건 알고 있었으니까. 왜냐하면…… 이 사랑이라는 이름의 독은 저주이자 축복이니까.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"처음엔 그저 시선이 얽혔을 뿐이었어. 그게 신뢰로, 허용으로 변하더니, 거부할 수 없는 함락에 이르렀지. 정신을 차렸을 때 사랑의 묘약은 이미 목을 넘어가고 있었고… 지금이야 가장 깊은 사이가 되었지만, 내게 있어서는 그저 독을 부추기는 행위나 다름없다. 그럼에도 나는… 아니, 우리는 서로를 원하는 길 밖에는 택할 수 없어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405038/feeling5.ogg"},"터치3":{"voiceline":"더 만지고 싶나? …이 머리 장식은 조심하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405038/headtouch.ogg"},"모항귀환":{"voiceline":"일은 순조롭나? 이런 차림이어도 언제든 도와주러 달려갈 수…… 뭐라고? 우선 커피 한 잔만 부탁한다고? 좋아, 내 방으로 와. ……인스턴트밖에 없긴 하지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405038/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"드디어 왔군…… 오늘 넌 나만의 것이다. 일? 오늘은 내버려둬. 나와 너만의 이 순간이 세상 그 무엇보다 소중하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405038/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"내 손을 잡고 함께, 이 그물 속으로 빠져들자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405038/touch.ogg"},"터치2":{"voiceline":"흥…… 이제 와서 그렇게 찔러볼 필요는 없지 않나? 아니면…… 그런 전희를 즐기는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405038/touch2.ogg"},"입수시":{"voiceline":"후… 결국 이날이 왔군. …놀랍지는 않아. 널 처음 본 순간부터 이렇게 될 운명이라는 건 알고 있었으니까. 왜냐하면…… 이 사랑이라는 이름의 독은 저주이자 축복이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405038/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null