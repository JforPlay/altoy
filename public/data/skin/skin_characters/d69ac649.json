[{"클뜯 id":405030,"클뜯 함순이 id":40503,"함순이 이름":"울리히 폰 후텐","한글 함순이 + 스킨 이름":"울리히 폰 후텐","영문 함순이 + 스킨 이름":"Ulrich von Hutten","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405030/shipyard.png","설명":"H급 전함—울리히 폰 후텐","자기소개":{"voiceline":"\"울리히 폰 후텐\". ……지휘관이 그렇게 부르는 한, 나는 그런 존재라고 정의된다. 이름이란 건 그런 것이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/profile.ogg"},"메인1":{"voiceline":"이 의장 말인가? 글쎄, 마음대로 움직여지긴 하지만, 가끔 불편할 때도 있다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/main1.ogg"},"메인2":{"voiceline":"모항의 수수께끼? ……그냥 수수께끼인채로 둬라. 그렇게 하는 편이 네게 더 오랫동안 즐거움을 주겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/main2.ogg"},"메인3":{"voiceline":"자기 자신을 소홀히 하지 마라. 자기 중심적으로 살라는 건 아니지만, 자신이 원하는 바를 위해 살지 않으면, 죽어도 제대로 죽을 수가 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/main3.ogg"},"전투개시":{"voiceline":"제길, 네놈들에게 먹여주기에는 탄약이 너무 아깝군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/battle.ogg"},"상세확인":{"voiceline":"편히 살고 싶으면 다른 사람 생각 따위엔 신경 꺼라. 이 세상에 태어난 이상, 타인의 마음대로 휘둘릴 만큼 우리의 뼈와 혼은 약한 것이 아니니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/detail.ogg"},"드랍 설명":{"voiceline":"H급 전함—울리히 폰 후텐","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아온 모양이군. 어서 정해라. 네가 마중 갈지, 아님 내가 갈지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/expedition.ogg"},"실망":{"voiceline":"네 자신이 뿌린 씨앗이다. 뒷처리는 알아서 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/feeling1.ogg"},"낯섦":{"voiceline":"신뢰는 독과도 같은 것, 한 번 그 맛을 보면, 푹 빠져서 눈자위를 하얗게 뒤집고 죽고 말지. 우리를 지키기 위해서는 타인을 의심하는 수밖에 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/feeling2.ogg"},"호감":{"voiceline":"너를 위해 무언가를 한다고, 너를 신뢰한다는 건 아니다. 이렇게나 많은 사람을 거느리고…… 흠모를 받는 네가 모른다고는 말하지 않겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/feeling3.ogg"},"기쁨":{"voiceline":"사람을 의심할 줄도 모르는 얼빠진 녀석. 이윽고 나는 너란 존재가 내게 있어서 독이라는 걸 깨닫고 말겠지…… 그 대가는 언젠가 치르게 해주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/feeling4.ogg"},"사랑":{"voiceline":"대가를 치러야 할 때다. 그래, 독이 몸 전체에 돌기 전에 어서 없애라고. 날 이렇게 만든 네게는 그럴 의무가, 책임이 있다…… 하긴, 이미 늦은 걸지도 모르겠지만 말이지, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/feeling5.ogg"},"터치3":{"voiceline":"제길, 무슨 짓이냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/headtouch.ogg"},"모항귀환":{"voiceline":"다들 무사한가? 흥, 잘했다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/home.ogg"},"hp 경고":{"voiceline":"당하기 싫으면 집중해라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/hp_warning.ogg"},"로그인":{"voiceline":"왔군. 책상 위에 산더미처럼 쌓인 서류 보았는가? 오늘 우리 둘이 처리해야 할 웃기지도 않는 일들이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/login.ogg"},"실패":{"voiceline":"졌으니 물러나마. 다음에는 이런 일 없을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/lose.ogg"},"우편":{"voiceline":"새로운 우편이로군. 기밀 사항이라도 적혀있는 건가…… 그렇군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/mail.ogg"},"임무":{"voiceline":"임무가 왔군. 할지 말지는 네가 정해라. 그건 네 자유다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/mission.ogg"},"임무완료":{"voiceline":"보상이 들어온 모양이군. 날개를 펼칠 수 있을 때에 맘껏 펼쳐 두어라. 축제 끝에 남는 것은 허망함 뿐이란 걸 알지라도.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/mission_complete.ogg"},"서약":{"voiceline":"푹 빠져라. 받아들여라. 네가 내게 저주를 건 것처럼, 나도 네게 저주를 걸어 주마. 신뢰…… 사랑이라는 독에 당해버려라. 나처럼 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/propose.ogg"},"스킬":{"voiceline":"비켜라, 방해된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/skill.ogg"},"터치1":{"voiceline":"생각하는 바가 있다면, 말로써 내뱉어라. 모두 받아 주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/touch.ogg"},"터치2":{"voiceline":"이걸 칭찬해줘야 할지, 아니면 혼을 내줘야 할지…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/touch2.ogg"},"입수시":{"voiceline":"나는 울리히 폰 후텐, 메탈 블러드의 희망과 회한의 상징. 내가 온 것에 대해 기뻐하든 아무렴 상관없든 네 마음대로 생각해도 좋다. 물론, 나도 그러하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/unlock.ogg"},"강화성공":{"voiceline":"무력에 지배되지 않는 평화를 위해, 힘을 필요로 한다……. 정말 모순이로군……. 아니, 아무 것도 아니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"……죽어라, 잔챙이 녀석들. 네 녀석들에게 낭비한 탄약만 생각하면 화가 치민다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/win_mvp.ogg"},"전투개시_ex":{"voiceline":"너희의 목숨, 모조리 거둬주마……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/battle_ex.ogg"},"상세확인_ex":{"voiceline":"무슨 일인가? 뭐 걱정되는 일이라도 있었나? 정말, 너 답지 않군……. 나를 신뢰하는 만큼, 다른 아이도 신뢰해 줘라. 그래야 너도, 그 아이도 안심할 수 있다. 물론, 나도 마찬가지고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰조가 돌아왔군. 어서 마중나갔다 와라. 그 아이들이 기뻐하는 모습, 보고 싶지 않은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/expedition_ex.ogg"},"사랑_ex":{"voiceline":"얌전히 있어, 어디 멀리 가지 말고. 푹 빠진 상대를 내가 그냥 내버려 둘 거라 생각한 거냐? 우릴 떼어 놓으려는 녀석이 나타나면……. 후후후, 글쎄…… 죽어버리라지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"어리광을 받아주니까 분한가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"괜찮은가? ……부하를 무사히 데려온 건지 걱정하는게 아니라, 네가 괜찮은 건지 걱정하는 거다……. 그래서, 정말 괜찮은 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"왔나. ……그렇지만 더는 네겐 볼일이 없다. 후후후, 놀라지만 말고 내가 뭘 했는지 맞춰봐라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/login_ex.ogg"},"실패_ex":{"voiceline":"모두…… 무사히 데리고 돌아가겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/lose_ex.ogg"},"우편_ex":{"voiceline":"새로운 우편이군. 개봉해뒀는데. 괜찮나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/mail_ex.ogg"},"임무_ex":{"voiceline":"새로운 임무로군. 일단 내가 도와줄 수 있는 부분은 해뒀다. 뒤는 잘 부탁한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무가 완료됐군. 피곤한가? ……그럼 기력이 회복되기까진 쉬는 편이 좋겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"우리 사이에, 뭘 이제와서 그런 걸 신경 쓰는 건가……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/touch_ex.ogg"},"터치2_ex":{"voiceline":"참는 게 특기가 아닌 사람은 너뿐이 아니란 걸 알고 싶은건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"말해봐라, 지금 건 만족스러웠는지 어땠는지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['프리드리히 데어 그로세'] :  연주하는 음악은 다르지만…… 흥.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/couple_encourage1.ogg"},{"voiceline":"['포미더블'] : 관심이 있으면 그냥 솔직하게 행동하면 된다, 아가씨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/couple_encourage2.ogg"}],"메인4":{"voiceline":"나도 취미 정도는 있다. 이래뵈도 꽤 즐기고 있다고. 네가 생각하는 나란 존재와도 모순되지 않는 걸로.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"응석 부리면 잘 대해줄텐데, 우선은 잘 대해줘야 응석을 부려주는군. ……흥, 이 고양이 녀석들, 이상한 부분이 닮았단 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/main5_ex.ogg"},"메인6_ex":{"voiceline":"\"모항의 수수께끼\", 어떻게든 찾아낼 생각이라면 말리진 않겠어. 나도 어울려 주지. 마침 한가했던 참이고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/main6_ex.ogg"},"메인7_ex":{"voiceline":"자신이 원하는 걸 먼저 생각하라고? 바보 같은 소릴, 그런 생각 다 한 다음에 널 위해서 이것저것 해주는 거라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/main7_ex.ogg"},"메인8_ex":{"voiceline":"되는대로 막 살 거면, 네가 쓰러질 때 슬퍼할 사람들의 얼굴을 생각해. 나는 슬퍼하고 싶지 않다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405030/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"UR","ex_chat_status":1},{"클뜯 id":405031,"클뜯 함순이 id":40503,"함순이 이름":"울리히 폰 후텐","한글 함순이 + 스킨 이름":"Mädchen Trümmer","영문 함순이 + 스킨 이름":"Mayhem Maid","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405031/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405031/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405031/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405031/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405031/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405031/shipyard.png","설명":"뭐야, 휴식 시간 때조차 날 귀찮게 하려는 거야?… 하핫, 농담 한 마디 한 거 가지고 움츠러들지마. 마침 누군가가 와서 내 답답함을 풀어주길 바라고 있었어.","자기소개":null,"메인1":{"voiceline":"돌아가야 하는데, 이 아이는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/main1.ogg"},"메인2":{"voiceline":"휴우, 귀찮아. 실외기가 너무 시끄럽군……. 아니, 그래도 혼자 있을 수 있는 공간은 소중하지. 으으, 이 스티커는 또 누가 붙인 거야…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/main2.ogg"},"메인3":{"voiceline":"안에서 이상한 짓을 하는 녀석이 보이면 어쩔지, 너도 잘 알지? ……그래, 말썽쟁이 녀석들에게 미리 일러둬야겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"뭐야, 휴식 시간 때조차 날 귀찮게 하려는 거야?… 하핫, 농담 한 마디 한 거 가지고 움츠러들지마. 마침 누군가가 와서 내 답답함을 풀어주길 바라고 있었어.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"애들이나 할법한 짓을 하는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/headtouch.ogg"},"모항귀환":{"voiceline":"(꿀꺽꿀꺽) ……후우, 다 비웠군. 미안, 한 병만 더 가져다 주겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘은 무슨 바람이 분 거지? 자, 어서 털어놔라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/login.ogg"},"실패":{"voiceline":"이런, 감히…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/lose.ogg"},"우편":null,"임무":{"voiceline":"임무를 받아 놓고 땡땡이치려는 건가? ……잘났군. 뭐, 나도 남말할 처지는 아니지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"\"어서오세요, 주인님. 주문은 무엇으로 하시겠어요?\" ……이제 됐나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/touch.ogg"},"터치2":{"voiceline":"뭣, 여기서 말이야? 성가시게 하는군…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/touch2.ogg"},"입수시":{"voiceline":"뭐야, 휴식 시간 때조차 날 귀찮게 하려는 거야?… 하핫, 농담 한 마디 한 거 가지고 움츠러들지마. 마침 누군가가 와서 내 답답함을 풀어주길 바라고 있었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"잘 한 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"엘베? 혹시 사고라도 칠까 걱정할 필요는 없다. 저래뵈도 개념은 있는 녀석이니……. 가장 걱정해야할 부분은 그게 아닌 것 같다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405031/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70628,"상점 카테고리 id":17,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1180,"기간":"상시","진영":"KMS","레어도":"UR","ex_chat_status":0},{"클뜯 id":405032,"클뜯 함순이 id":40503,"함순이 이름":"울리히 폰 후텐","한글 함순이 + 스킨 이름":"고고한 이그니션 타임","영문 함순이 + 스킨 이름":"Ignition