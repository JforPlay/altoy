[{"클뜯 id":301180,"클뜯 함순이 id":30118,"함순이 이름":"시라누이","한글 함순이 + 스킨 이름":"시라누이","영문 함순이 + 스킨 이름":"Shiranui","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301180/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301180/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301180/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301180/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301180/shipyard.png","설명":"카게로형 구축함 2번함·시라누이","자기소개":{"voiceline":"카게로형… 시라누이형 2번함의 시라누이라 하옵니다. 이름 때문에 요괴로 오해받기도 하지만 자연현상에서 유래된 이름이지요. 뭐, 이 모습은 「코스프레」라고 생각하시는 편이… 그럼, 잘 부탁드리옵니다. 이 왕바보… 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/profile.ogg"},"메인1":{"voiceline":"둥실둥실…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/main1.ogg"},"메인2":{"voiceline":"숨 막힐 듯 들러붙는 사람은 서툴러요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/main2.ogg"},"메인3":{"voiceline":"시원하다고 해서 소녀에게 들러붙다니… 왕바보인 겝니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/main3.ogg"},"전투개시":{"voiceline":"소녀의 싸움을, 봐주시겠사옵니까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/battle.ogg"},"상세확인":{"voiceline":"…이상한 곳을 만지신다면 목숨이 남아나지 않을 것이옵니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/detail.ogg"},"드랍 설명":{"voiceline":"카게로형 구축함 2번함·시라누이","voicelink":null},"의뢰 완료":{"voiceline":"1분간 기다렸사옵니다. 의뢰가 완료되었는데도 전혀 눈치채지 못하신 모양이라… 역시 소녀가 없으면 아무것도 할 수 없는 왕바보시군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/expedition.ogg"},"실망":{"voiceline":"정말이지 답이 없사와요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/feeling1.ogg"},"낯섦":{"voiceline":"소녀는 카게로와는 정반대… 그 아이가 빛이라면, 소녀는 그림자이옵니다… 지휘관? 지휘관은 물론 왕바보이시고요. 그 아이를 싫어하는 건 아니지만, 지휘관은 어떠신지요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/feeling2.ogg"},"호감":{"voiceline":"풀과 나무도 잠자는 늦은 밤에, 지휘관의 영혼을 먹어버릴 것입니다… 혹시 믿으신 겝니까? 소녀가 여태껏 이런 것들을 몇 마리나 쫒아냈건만, 정말이지 왕바보시군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/feeling3.ogg"},"기쁨":{"voiceline":"게으름뱅이에 왕바보이신 지휘관님께서 모두를 행복하게 해주고 싶다고 하시니… 이런 왕바보를 아무래도 가만히 내버려둘 순 없겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/feeling4.ogg"},"사랑":{"voiceline":"하아, 차라리 지휘관님의 수호령이라도 되는 편이 낫겠사옵니다… 그러면 언제라도 「딴지」… 아니 「지켜드릴」 수 있으니 말이어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"그렇게 격하게 바라보셔도 들뜨거나 하진 않사옵니다만…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오랜만입니다, 라고 말하면 될런지요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/login.ogg"},"실패":{"voiceline":"원통하옵니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/lose.ogg"},"우편":{"voiceline":"「우편물」인가요… 이 정도라면 못 해줄 것도 아니지요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/mail.ogg"},"임무":{"voiceline":"새로운 임무인가요… 소녀에게는 어찌 되든 좋은 일이어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/mission.ogg"},"임무완료":{"voiceline":"「보너스」가 왔다고… 앗, 받는 건 소녀에게 부탁하지 마시고, 직접 받으시어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/mission_complete.ogg"},"서약":{"voiceline":"하아… 설마 「귀신」을 상대로 이렇게까지 하다니, 지휘관님은 정말이지 왕바보이신겝니까? 그도 아니면 이상한 「영화」라는 것이라도 보신 건 아닌지?… 뭐, 물건에는 죄가 없으니, 이건 받아두겠사옵니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/propose.ogg"},"스킬":{"voiceline":"무수히 많은 도깨비불을, 이 일격에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/skill.ogg"},"터치1":{"voiceline":"즐거우시옵니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/touch.ogg"},"터치2":{"voiceline":"「귀신」에게조차 집착을 보이시다니, 역시…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/touch2.ogg"},"입수시":{"voiceline":"카게로형 2번함, 시라누이… 잘 부탁드리옵니다. 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/unlock.ogg"},"강화성공":{"voiceline":"역시나 왕바보이시군요. 귀중한 자원을 소녀에게 할애하시다니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 정도로 약할 줄은 생각지도 못했사와요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301180/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아카시'] : 파츠 회수라도 같이 하도록 할까요","voicelink":null}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"N","ex_chat_status":0},{"클뜯 id":301181,"클뜯 함순이 id":30118,"함순이 이름":"시라누이","한글 함순이 + 스킨 이름":"월병, 먹어 볼래?","영문 함순이 + 스킨 이름":"Mooncake Merchant","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/30