[{"클뜯 id":401160,"클뜯 함순이 id":40116,"함순이 이름":"Z16","한글 함순이 + 스킨 이름":"Z16","영문 함순이 + 스킨 이름":"Z16","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401160/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401160/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401160/shipyard.png","설명":"1934A형 구축함 - Z16 프리드리히 에콜트","자기소개":{"voiceline":"이몸으로 말할 거 같으면 메탈 블러드 구축함인 프리드리히 에콜트, Z16이라고 불러도 돼. 그때 건너편을 조금만 더 잘 살폈더라면…. 에잇! 이번에는 적인지 아군인지 잘 구분하면 되겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/profile.ogg"},"메인1":{"voiceline":"으아아, 글자가 너무 빽빽해서 눈이 침침해…. 안 되겠어, 현기증까지 나려고 해….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/main1.ogg"},"메인2":{"voiceline":"으드득으드득 깨물어 주마! 헤헤헷, 지휘관. 사탕 고마워! 혹시 더 줄 수 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/main2.ogg"},"메인3":{"voiceline":"지휘관, 졸리면 내가 앙 해줄게! 그럼 정신이 들 거야. …응? 안 된다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/main3.ogg"},"전투개시":{"voiceline":"벌써 시작된 건가? 간다아!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/battle.ogg"},"상세확인":{"voiceline":"두들겨 패주면 적도 얌전해지기 마련이지! 지휘관, 내 말 맞지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/detail.ogg"},"드랍 설명":{"voiceline":"1934A형 구축함 - Z16 프리드리히 에콜트","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아온 거 같아! 그… 몇 명이었더라? 너무 멀어서 잘 안 보여….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/expedition.ogg"},"실망":{"voiceline":"널 괴롭힌 게 누군지 어서 말해! 겁낼 거 없어! 이몸께서 되갚아줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/feeling1.ogg"},"낯섦":{"voiceline":"어려운 건 잘 모르겠지만, 나쁜 녀석은 쓰러트리고, 착한 녀석은 지키는 거… 이것만은 틀림없지? 누가 착한 녀석인지 나쁜 녀석인지, 이몸은 한눈에 알아볼 수 있거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/feeling2.ogg"},"호감":{"voiceline":"나쁜 녀석에도 여러 종류가 있어서, 잘 타이르면 반성하는 녀석도 있는가 하면, 주먹으로 '가르쳐주지' 않으면 반성하지 못하는 녀석들도 있지. 거기다 내가 진심을 다하면 거꾸로 더 날뛰는 녀석들도…. 뭐 대충 이런 느낌이랄까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/feeling3.ogg"},"기쁨":{"voiceline":"만약 언젠가 지휘관이 나쁜 녀석이 된다면, 내가 마음을 독하게 먹고 지휘관을 혼내줘야 하겠지…. 그렇게 되지 않도록, 분발해서 모두에게 사랑받는 좋은 사람이 되도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/feeling4.ogg"},"사랑":{"voiceline":"아, 지휘관이다! 헤헤헤, 왠지 지휘관을 만나면 기분이 좋아진단 말이지~! 오늘은 출격할 거야? 이몸께 맡겨! 물론, 맛있는 사탕을 준다면 더 기분이 좋아질 테지만 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔어? 흥, 출격은 참 재밌었겠지! 마음껏 적이랑 치고받고 할 수 있었을 테니까! …설마, 뒤에서 계속 숨어있기만 했던 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/home.ogg"},"hp 경고":{"voiceline":"그냥 긁힌 거야! 쫄 거 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/hp_warning.ogg"},"로그인":{"voiceline":"얌마! 거기 수상한 녀석! 지휘관 방에 몰래 숨어들어서 뭘…… 응? 지휘관이었네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/login.ogg"},"실패":{"voiceline":"말리지 마! 저 녀석들, 감히 내 동료들을 울리다니…. 절대 용서 못 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/lose.ogg"},"우편":{"voiceline":"우편? 이 얄팍한 봉투 말하는 거야? 겸사겸사 가져다주는 건 상관없는데, 중요한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/mail.ogg"},"임무":{"voiceline":"임무? 재미없어 보이는 것만 잔뜩… 싫어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/mission.ogg"},"임무완료":{"voiceline":"임무 완료야! 이제 여기 도장만 찍으면 되는 거지? 내가 할래~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 이게 그 유명한 '아무리 멀리 떨어져 있어도, 서로를 부르면 나머지 한쪽을 가진 상대방에게 전해진다'고 하는 그 특별한 반지 맞지? …엥, 그냥 평범한 반지라고? 그래…. 흠! 괜찮아! 딱히 그런 거 없어도 이몸이라면 지휘관의 위험을 감지하고 언제든 달려갈 수 있으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/propose.ogg"},"스킬":{"voiceline":"날려 주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/skill.ogg"},"터치1":{"voiceline":"응? 왜 그래? 갑자기 만지고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/touch.ogg"},"터치2":{"voiceline":"얌마! 어딜 만져!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/touch2.ogg"},"입수시":{"voiceline":"여어, 네가 지휘관이로군! 여러 번 확인했으니 틀림없겠지! 이몸께서는 메탈 블러드 소속 구축함인 Z16, 다른 이름으로는 프리드리히 에콜트라 불리는 분이시다! 헤헹, 좀이 쑤셔서 더는 못 참겠어! 어서 바다로 출항시켜서 싸우게 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/unlock.ogg"},"강화성공":{"voiceline":"헤헹, 이몸의 활약을 기대하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"헤헹, 이몸이야말로 최강이시지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/win_mvp.ogg"},"전투개시_ex":{"voiceline":"으드득으드득 물어 뜯어주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관이 머리를 쓰면, 이몸께서 주먹으로 적을 박살내는 거지! 에헤헤, 나랑 지휘관, 괜찮은 콤비인걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"윽, 드디어 돌아왔네. 집무실에서 기다리면 머리 아픈 서류 정리 업무말고는 할 게 없다고…. 다음에 출격할 땐 꼭 날 데리고 가는 거다! 약속해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"야, 지휘관! 에헤헤, 역시 지휘관 맞네! 자, 어서 오늘 업무 시작하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"그 얄팍한 봉투는 책상 위에 뒀어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/mail_ex.ogg"},"임무_ex":{"voiceline":"임무? 재미없는 것들 뿐이지만…. 뭐, 지휘관을 위해서니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 끝나면 또 평소처럼 도장 찍기 시간인 거지? 할래, 내가 할래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"에헤헷~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/touch_ex.ogg"},"터치2_ex":{"voiceline":"거, 거긴 안 된다니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"봐, 지휘관. 역시 이몸이야말로 최강이지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['셰필드'] :  그러니까… 도, 동료 맞지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/couple_encourage1.ogg"},{"voiceline":"['아드미럴 히퍼'] :  히, 히퍼구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/couple_encourage2.ogg"},{"voiceline":"['U-110'] :  네가 상어면, 이 몸은 거대 상어다! 크르릉!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관! 아 정말 지휘관! 그렇게 자꾸 날 내버려두면 깨물 거야! …흥, 날 너무 방치하니까 한 농담이야. 정말 깨물진 않는다고….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관, 이 박하사탕 엄청 맛있어! 하나 줄게! ……응? 안 깨물어 먹는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401160/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":1},{"클뜯 id":401161,"클뜯 함순이 id":40116,"함순이 이름":"Z16","한글 함순이 + 스킨 이름":"필승 홈런!","영문 함순이 + 스킨 이름":"Guaranteed Grand Slam!","스킨 타입":"Sports Time","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401161/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401161/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401161/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401161/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401161/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401161/shipyard.png","설명":"히힛, 지휘관, 마침 잘 왔어! 운이 좋은걸——왜냐면 이제 곧 내가 홈런 치는 멋진 모습을 볼 수 있을 테니까!","자기소개":null,"메인1":{"voiceline":"Z24는 커다란 메탈 글러브가 있어. 포수가 정말 잘어울릴 거야! …… 아, 테니스 경기에 참가하러 갔다고? 그럼 안되겠네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401161/main1.ogg"},"메인2":{"voiceline":"흐압! 어때, 저렇게 멀리 날아갔으니까, 분명히 홈런이겠——파, 파울이라고!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401161/main2.ogg"},"메인3":{"voiceline":"야구장에선 주의력을 집중하지 않으면 안 돼! 지휘