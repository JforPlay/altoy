[{"클뜯 id":107990,"클뜯 함순이 id":10799,"함순이 이름":"꼬마 엔터프라이즈","한글 함순이 + 스킨 이름":"꼬마 엔터프라이즈","영문 함순이 + 스킨 이름":"Little Enterprise","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107990/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107990/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107990/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107990/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107990/shipyard.png","설명":"요크타운급 항공모함—엔터프라이즈, 현호 CV-6","자기소개":{"voiceline":"적이 아무리 강하고 상황이 아무리 나빠도 전력으로 싸워서 승리할 거야... 이건 나 자신에 대한 요구야! 내가 충분히 강해지면 분명히 할 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/profile.ogg"},"메인1":{"voiceline":"\"회색 유령\"... 나를 말하는 건가? 굉장히 멋있게 들리네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/main1.ogg"},"메인2":{"voiceline":"요크타운, 호넷, 그리고 나... 우리 셋은 분명히 이글 유니온의 당당한 함선이 될 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/main2.ogg"},"메인3":{"voiceline":"전투 말고 다른 쪽에서도 노력하고 있어! ...하지만 레몬만은 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/main3.ogg"},"전투개시":{"voiceline":"엔터프라이즈, 출격! ...모, 모자가 비뚤어졌어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/battle.ogg"},"상세확인":{"voiceline":"베스탈이 왜 나를 어린애 취급하는지 모르겠어. 조금만 다쳐도 저렇게 전전긍긍하고... 혼자서도 할 수 있는데 말이야...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/detail.ogg"},"드랍 설명":{"voiceline":"요크타운급 항공모함—엔터프라이즈, 현호 CV-6","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰 완료야! 확실히 병참 보조가 든든하면 전선의 작전도 훨씬 순조로워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/expedition.ogg"},"실망":{"voiceline":"혹시 지휘관도 공부를 해야 하는 건가...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 오늘도 훈련 도와줘! 먼저 말 해둘게, 절대 봐주면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/feeling2.ogg"},"호감":{"voiceline":"왜 최강이 되고 싶냐고? ...왜냐하면, 적을 처치하고 동료를 보호하고, 갈등을 끝낼 수 있는 것은 최강의 히어로 뿐이니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/feeling3.ogg"},"기쁨":{"voiceline":"요크타운 언니는 나에게 아주 잘 해줘. 베스탈도 나를 신경 써주고 있고, 새러도 나랑 놀아주는데... 안 돼! 왜 다들 나를 귀여워하는 거야! 지휘관, 나, 나한테 좀 더 엄격하게 대해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/feeling4.ogg"},"사랑":{"voiceline":"이야기 속 히어로는 모든 사람을 지켰지만 홀로 외롭게 잊혀졌어... 하지만 나에게는 지휘관이 있으니까 무섭지 않아! 나의 임무가 끝나더라도 지휘관은 항상 내 곁에서 함께 놀아줄 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/feeling5.ogg"},"터치3":{"voiceline":"안 돼, 안 돼! 쓰다듬으면 키가 안 큰다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 방금 나 어땠어? 고쳐야 할 점은 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/home.ogg"},"hp 경고":{"voiceline":"이정도 어려움은 무섭지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘은 뭘 배워야 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/login.ogg"},"실패":{"voiceline":"져버렸다... 으, 분해...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/lose.ogg"},"우편":{"voiceline":"지휘관, 우편을 가져왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/mail.ogg"},"임무":{"voiceline":"새로운 임무? 바로 할게! ...엑, 지휘관의 임무야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/mission.ogg"},"임무완료":{"voiceline":"임무 완료야! 지휘관을 도울 수 있어서 영광이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/mission_complete.ogg"},"서약":{"voiceline":"이건... 지휘관이 나를 인정한다는 건가? 다행이다! 하지만 나는 아직도 지휘관에게 배워야 할 것이 많아... 내가 진정한 히어로가 되기 전에 절대로 나를 떠나면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/propose.ogg"},"스킬":{"voiceline":"끝이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/skill.ogg"},"터치1":{"voiceline":"나, 나에 대한 의견? 진지하게 들을게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/touch.ogg"},"터치2":{"voiceline":"응...? 무슨 뜻인지 잘 모르겠어...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/touch2.ogg"},"입수시":{"voiceline":"지휘관, 안녕, 난 이글 유니온 항공모함 엔터프라이즈야. 이글 유니온 최강의 전사가 되고 싶어. 하지만 아직 많은 걸 배워야 하지…… 지휘관, 날 도와줄 수 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/unlock.ogg"},"강화성공":{"voiceline":"이걸로 조금 더 강해졌어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아, 이번에도 1등이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"냉정해야 한다, 엔터프라이즈... 태우면 안 돼... 에, 지휘관? 저기, 지금 베스탈에게 밥하는 법을 배우고 있어... 으악?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"밤하늘에 빛나는 별... 저기가 우리가 언젠가 도착할 곳일까? 지휘관과 함께라면 분명히 이 꿈을 이룰 수 있을 거라고 믿어! 저 별들처럼 많은 어려움과 적을 극복해야 할지라도 괜찮을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"좋아! 오늘도 힘내서 일하고 공부하자! 지휘관, 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관의 의견은 큰 도움이 됐어! 지, 지휘관은 평소에 다른 동료들에게도 그래...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/touch_ex.ogg"},"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['꼬마 아카기'] : 몇 번을 겨뤄도 이기는 건 나야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/couple_encourage1.ogg"},{"voiceline":"['꼬마 아마기'] : 뜻밖의 강적이다... 하지만 지지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/couple_encourage2.ogg"},{"voiceline":"['에식스'] : 나를 넘어서는 건 쉽지 않다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/couple_encourage3.ogg"},{"voiceline":"['요크타운', '호넷'] : 엔터프라이즈의 실력, 잘 보라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/couple_encourage4.ogg"},{"voiceline":"['오마하'] : 작은 상처일 뿐이야. 진짜 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/couple_encourage5.ogg"},{"voiceline":"['엔터프라이즈'] : 진정한 히어로가 어떤 모습인지... 알고 싶어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/couple_encourage6.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"함대를 관리하는 것은 어려운 일이네! 도와줄 일 없을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"꼬마 독수리처럼 무럭무럭 자라서 엔터프라이즈가 될 거야. 어라, 그 뜻이 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107990/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":n