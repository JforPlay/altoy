[{"클뜯 id":408080,"클뜯 함순이 id":40808,"함순이 이름":"U-110","한글 함순이 + 스킨 이름":"U-110","영문 함순이 + 스킨 이름":"U-110","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408080/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408080/shipyard.png","설명":"메탈 블러드 IXB형 잠수함 U-110 ","자기소개":{"voiceline":"U-110은 메탈 블러드 소속의 IXB형 잠수함이야. 특기는 상선 사냥이지. 등위에 있는 건 에니그마로 아주 뛰어난 암호기야. U-110도 대단해. 다만 코드북이랑 지도를 잊은 것 뿐이지...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/profile.ogg"},"메인1":{"voiceline":"코드북, 코드북... 아, 숙소에 두고 왔다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/main1.ogg"},"메인2":{"voiceline":"지휘관, U-110랑 같이 놀자.U-110랑——같이——놀자고","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/main2.ogg"},"메인3":{"voiceline":"아까 항구에서 상어인 척하다가 한소리 들었어... 하지만 너무 재미있었다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/main3.ogg"},"전투개시":{"voiceline":"상어, 출격.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/battle.ogg"},"상세확인":{"voiceline":"머리는 마늘이 아니라 상어야. 무서운 상어라고, 캬오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/detail.ogg"},"드랍 설명":{"voiceline":"메탈 블러드 IXB형 잠수함 U-110","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 항구에 누가 돌아온 것 같다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/expedition.ogg"},"실망":{"voiceline":"지휘관, 왜 나랑 안 놀아줘...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 설마 이제 에니그마 안 쓰는 거야? 음, 그럼 암호 해독 게임기로 쓰자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/feeling2.ogg"},"호감":{"voiceline":"다들 U-110 머리카락 갖고 노는 걸 좋아하는 것 같아. 태어날 때부터 이랬어. U-110은 태어날 때부터 상어였다고, 캬오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/feeling3.ogg"},"기쁨":{"voiceline":"불독은 아주 똑똑해. U-110은 불독과 함께 노는게 좋아. 지휘관도 다음에 같이 놀자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 좋은 친구야. 그러니까 에니그마의 코드북을 하나 줄게. 게다가 이러면 U-110가 깜빡해도 괜찮잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 사무실은 너무 심심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/home.ogg"},"hp 경고":{"voiceline":"U-110은 아주 대단해. 절대 지지 않지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 막대사탕 가져왔어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/login.ogg"},"실패":{"voiceline":"코드북, 코드북... 안 잃어버렸다. 정말 다행이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/lose.ogg"},"우편":{"voiceline":"암호 편지라면 U-110한테 맡겨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/mail.ogg"},"임무":{"voiceline":"지휘관, 임무를 마치면 U-110랑 놀아줄 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/mission.ogg"},"임무완료":{"voiceline":"캬오! 상어가 임무 보상을 가져왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408080/mission_complete.ogg"},"서약":{"voiceline":"지휘관이 U-110에게 잘해주니까, U-110도 지휘관이 가장 좋아. 앞으로 