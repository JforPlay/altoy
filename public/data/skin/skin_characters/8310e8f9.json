[{"클뜯 id":299050,"클뜯 함순이 id":29905,"함순이 이름":"플리머스","한글 함순이 + 스킨 이름":"플리머스","영문 함순이 + 스킨 이름":"Plymouth","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299050/shipyard.png","설명":"경순양함 - 플리머스","자기소개":{"voiceline":"에든버러급의 다른 대안이자, 특별 계획함인 플리머스라고 합니다. 이 모항에서 저를 구현해준 지휘관님께 감사 말씀 올립니다. 부디 저를 마음껏 써주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/profile.ogg"},"메인1":{"voiceline":"아, 조심하세요. …에든버러 씨, 소문대로 조금 덤벙대는 구석이 있네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/main1.ogg"},"메인2":{"voiceline":"자료를 처분하라는 말씀이시죠. (폭발음) ……네, 방금 공격으로 자료가 모두 재가 되었습니다. 기뻐해주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/main2.ogg"},"메인3":{"voiceline":"업무에 진척이 없다구요? 네, 그럼 제가 동화를 들려드리지요. 옛날옛적에….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/main3.ogg"},"전투개시":{"voiceline":"상대해드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/battle.ogg"},"상세확인":{"voiceline":"평안하신지요. 오늘은 저, 지휘관님과 무사히 하루를 보낼 수 있을 것 같습니다. 네, 기뻐해주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/detail.ogg"},"드랍 설명":{"voiceline":"경순양함 - 플리머스","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰가 완료되었습니다. 지휘관님, 기뻐해주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/expedition.ogg"},"실망":{"voiceline":"지휘관님, 기뻐하시길. 지휘관님께서는 아직 저 플리머스를 의지할 수 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/feeling1.ogg"},"낯섦":{"voiceline":"저를 의지해주시길, 지휘관님. 저 플리머스가 여기 있는 이유는 모두의 지휘관님을 보살피기 위함이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/feeling2.ogg"},"호감":{"voiceline":"메이드대에 대해선 잘 모릅니다. 똑같이 지휘관님을 보살핀다는 점에서는 딱히 저와 다를 거 없어 보이는데, 지휘관님도 그렇게 생각하시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 기뻐하시길. 저, 오늘부터 메이드대 업무를 도와주기로 했답니다… 동료들과 함께인 편이 지휘관님을 더 잘 보살펴드릴 수 있고… 기뻐할 일이니까요. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 오늘은 뭘 해드릴까요? 원하신다면 지휘관님을 향한 응원은 물론, 봉사에 보살핌, 물론 사랑까지……. 기뻐해주시길. 플리머스는 지휘관님을 위해서라면 무엇이든 해드릴 수 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/feeling5.ogg"},"터치3":{"voiceline":"쓰다듬어주셔서 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 플리머스의 간식… 오늘은 사르데냐 엠파이어 스타일의 풀코스입니다. 기뻐해주시길. ……너무 과하다…구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/home.ogg"},"hp 경고":{"voiceline":"부끄러운 모습을 보여드리고 말았네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/hp_warning.ogg"},"로그인":{"voiceline":"기뻐하시길, 지휘관님. 상쾌한 아침입니다. 오늘은 어떤 업무부터 시작할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/login.ogg"},"실패":{"voiceline":"패배했네요, 지휘관님. 조금 난처한 기분입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/lose.ogg"},"우편":{"voiceline":"기뻐하시길, 지휘관님. 새로운 우편이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/mail.ogg"},"임무":{"voiceline":"새로운 임무입니다. 지휘관님, 제게 맡겨주시길. …? 직접 하신다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/mission.ogg"},"임무완료":{"voiceline":"임무 보상입니다. 열어 보죠…. 포격하면 못쓰게 되겠네요. 알겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 기뻐해주시길! 오늘부터 플리머스는 지휘관님 전속 함선이 되었답니다! 전속이라는 건 특별하다는 것… 즉, 저는 지휘관님께 특별한 함선이 된 거니까, 오늘만은 지휘관님을 제쳐두고 기뻐해도 될까요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/propose.ogg"},"스킬":{"voiceline":"실례하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/skill.ogg"},"터치1":{"voiceline":"플리머스의 노래를 듣고 싶으시다구요? 그럼, 어떤 노래가 듣고 싶으신지 알려주세요. 플리머스가 모르는 노래라면 배워서 올 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/touch.ogg"},"터치2":{"voiceline":"네, 원하는 대로 하시길. 지휘관님께서 기뻐하신다면야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/touch2.ogg"},"입수시":{"voiceline":"저를 구현해주신 지휘관님께 인사 올립니다. 저, 특별 계획함 플리머스는 지금 여기서 지휘관님의 명령을 기다리고 있답니다. 부디 이 축복스러운 만남에 기뻐하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/unlock.ogg"},"강화성공":{"voiceline":"강해졌습니다. 기뻐하시길, 지휘관님. 이걸로 플리머스는 더 '쓰기 편해'졌답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"저희의 승리입니다. 지휘관님, 기뻐해주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관님, 어떻게 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299050/battle_ex.ogg"},"상세확인_ex":{"voiceline":"평안하시온지요. 보시는 것처럼 로열 네이비 분들과 다과회를 즐기는 중이랍니다. 지휘관님도 함께 어떠신지요? 자리는… 제 허벅지에 