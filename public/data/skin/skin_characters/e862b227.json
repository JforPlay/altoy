[{"클뜯 id":9707070,"클뜯 함순이 id":970707,"함순이 이름":"글로리어스·META","한글 함순이 + 스킨 이름":"글로리어스·META","영문 함순이 + 스킨 이름":"Glorious META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707070/shipyard.png","설명":"지휘관님, 안녕하세요. 로열 네이비 소속 항공모함 글로리어스입니다. 여기 오게 되어 영광입니다. 잘 부탁드려요.","자기소개":{"voiceline":"네? 그 이야기는 이제 그만두죠. 의미 없는 과거보다는 소중한 미래를 바라봐야 해요. 지휘관님, 제가 도울 일이 있다면 언제든 말씀해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/profile.ogg"},"메인1":{"voiceline":"지휘관님께서 내린 홍차는… 어딘가 임플래커블 씨 느낌이 30% 정도 나네요… 후후, 역시 제가 내리는 편이 낫겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/main1.ogg"},"메인2":{"voiceline":"다시 일러스트리어스 씨와 겨룰 기회가 있다면, 이번에는 이길 자신이 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/main2.ogg"},"메인3":{"voiceline":"이 디저트들은… 메이드대에서 직접 만든 건가요? 기억 속 맛과 완벽하게 일치하네요… 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/main3.ogg"},"전투개시":{"voiceline":"로열 네이비의 글로리어스는 적을 놓치지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/battle.ogg"},"상세확인":{"voiceline":"…지휘관님도 홍차 드시겠어요? 바로 준비할 테니… 잠시만 기다리세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/detail.ogg"},"드랍 설명":{"voiceline":"글로리어스급 항공모함 글로리어스(HMS Glorious)<color=#92fc63> (1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"이렇게 성과로 가득한 함대를 보는 게 얼마 만인지… 지휘관님, 의뢰가 완료됐어요. 추후 처리는 제게 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/expedition.ogg"},"실망":{"voiceline":"…무슨 일이죠, 지휘관님? 부르셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 모항에서 가장 전망이 좋은 곳은 어디인가요? 잠깐 가보고 싶어서요… 네, 그냥 기분 전환을 위한 거니 걱정하지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/feeling2.ogg"},"호감":{"voiceline":"오늘 로열 네이비 기숙사를 지나다가 아크로열 씨와 구축함들을 멀리서 봤는데…… 뭐랄까, 여전하더군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/feeling3.ogg"},"기쁨":{"voiceline":"사실… 홍차 말고 허브티도 연구하기 시작했어요. 지휘관님, 괜찮으시면 한 잔 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/feeling4.ogg"},"사랑":{"voiceline":"이런 곳까지 오시다니… 네, 발 조심하시고, 손은 여기에…… 높은 곳에 있으면 참 좋아요. 풍경을 바라보여 바닷바람을 쐬면 마음도 잔잔해지거든요. 지금은 지휘관님이 함께하니, 이 평온한 시간이 더욱 소중하게 느껴지네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/feeling5.ogg"},"터치3":{"voiceline":"…죄송해요. 저, 또 멍하니 있었나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/headtouch.ogg"},"모항귀환":{"voiceline":"…아, 벌써 귀환하셨군요. 죄송해요. 조금 생각을 하느라…… 바로 업무를 시작하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/home.ogg"},"hp 경고":{"voiceline":"이 아픔… 이미 익숙해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 오늘은 날씨가 좋네요. 자, 최선을 다해서 업무를 처리해 나가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/login.ogg"},"실패":{"voiceline":"…또 패배하고 말았군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/lose.ogg"},"우편":{"voiceline":"지휘관님, 이 우편함은 어떻게… 죄송해요. 우편을 받아보는 게 오랜만이라, 조금 헷갈렸어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/mail.ogg"},"임무":{"voiceline":"임무 보상이 나오는 상층부도 나쁘지 않네요… 지휘관님, 같이 일을 처리해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/mission.ogg"},"임무완료":{"voiceline":"고생 많으셨어요. 푹 쉬세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/mission_complete.ogg"},"서약":{"voiceline":"지휘관님 마음은 잘 전해졌어요. 그래서 저도 보답하고자 조금은 솔직해지기로 했어요. 저는 로열 네이비의 글로리어스… 제가 있던 실험장에서는 마지막으로 남은 영광이었답니다. 그러니 살아 있는 한, 이 영광을 영원히 전해야 해요. 지휘관님… 그래도 저와 함께 이 길을 걸어주실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/propose.ogg"},"스킬":{"voiceline":"영광이여… 영원하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/skill.ogg"},"터치1":{"voiceline":"…네? 대화 상대라면 기꺼이 해드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/touch.ogg"},"터치2":{"voiceline":"…지휘관님, 장미가 아무리 아름다워도 그 가시에는 주의하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 안녕하세요. 로열 네이비 소속 항공모함 글로리어스입니다. 여기 오게 되어 영광입니다. 잘 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/unlock.ogg"},"강화성공":{"voiceline":"계속해서 승리를 쟁취해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"영광스러운… 개선을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['글로리어스'] : 무리하지 마세요. 당신은 충분히 훌륭하니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707070/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"META","레어도":"SSR","ex_chat_status":0}]