ineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502052/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502052/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502052/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502052/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502052/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502052/shipyard.png","설명":"지휘관, 행복한 새해…… 이런 인사나 건넬 상황이 아니야! 어서 장식을 가지고 도망친 저 녀석 잡는 것 좀 도와줘! 정말… 춘련을 준비하던 것뿐인데 어쩌다 이렇게 된 거냐구…!","자기소개":null,"메인1":{"voiceline":"잉 루이! 네 짓인 거 다 알아! 빨리 얘 좀 멈춰봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/main1.ogg"},"메인2":{"voiceline":"지휘관, 그…… 그렇게 조용히 있지 말고 뭔 말 좀 해봐. 둘이서 이렇게 책상 밑에 쭈그려 있으면, 그, 그러니까… 오해 받잖아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/main2.ogg"},"메인3":{"voiceline":"모항 장식은 괜찮으려나…… 응? 이미 만반의 준비가 되어 있다고? 꽤, 꽤나 믿음직스러운걸….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"아, 정말! 뭐야, 이 쬐그만 건?! 마치 날 일부러 피하는 것 같잖아…. 역시 잉 루이 녀석의 짓이 분명해! 춘련 장식을 얌전히 맡겨준 것부터 뭔가 수상했어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 행복한 새해…… 이런 인사나 건넬 상황이 아니야! 어서 장식을 가지고 도망친 저 녀석 잡는 것 좀 도와줘! 정말… 춘련을 준비하던 것뿐인데 어쩌다 이렇게 된 거냐구…!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"음… 딱히 그렇게까지 걱정 안 해줘도 괜찮아. 잉 루이가 장난치는 거엔 익숙해져 있고, 제대로 사과도 받았으니까……. 그래도 잉 루이 대신 사과하고 싶다면, 그, 그러니까…… 이거 끝나면 나랑 같이 있어 줘! …좋다고? 에헷, 잉 루이한테 오늘 일로 엄~청 배 아프게 만들어줘야지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"으으… 허리도 다리도… 지휘관, 넌 조금만 더 수고해줘! 나는 더는 무리야…. 쉬게 해줘….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"조금만 더…… 앗, 지휘관. 갑자기 왜 그래? 아니, 이 녀석 또 도망쳤잖아?! …너, 너를 탓하려는 건 아니야! 하아… 어쩌다 이렇게 된 거야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/login.ogg"},"실패":null,"우편":{"voiceline":"왜 여기에 지휘관 앞으로 온 우편이 있는 거지…? 실수로 떨어뜨렸다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이, 일부러 만지려고 한 건 아니야. 미안해! 이게 다 이 쪼매난 것 때문에….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/touch.ogg"},"터치2":{"voiceline":"이, 이, 이, 이 왕변태! 사람이 곤경에 빠진 틈을 타서… 으으…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/touch2.ogg"},"입수시":{"voiceline":"지휘관, 행복한 새해…… 이런 인사나 건넬 상황이 아니야! 어서 장식을 가지고 도망친 저 녀석 잡는 것 좀 도와줘! 정말… 춘련을 준비하던 것뿐인데 어쩌다 이렇게 된 거냐구…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502052/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70811,"상점 카테고리 id":3,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1080,"기간":"상시","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502053,"클뜯 함순이 id":50205,"함순이 이름":"차오 호","한글 함순이 + 스킨 이름":"푸른 물결, 빛나는 태양","영문 함순이 + 스킨 이름":"Azure Ripples, Shimmering Sun","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502053/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502053/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502053/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502053/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502053/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502053/shipyard.png","설명":"자, 잠깐! 그렇게 한마디도 없이 들어오면 어떻게 해! 수영복을 찾으려던 참인데… 아, 아무 것도 아니야! 딱히 쫓아내려는 건 아니니까 들어올 거면 빨리 들어와!","자기소개":null,"메인1":{"voiceline":"백조 튜브…? 뭐,귀여우니까 괜찮지 않아? 앉고 싶다고…? 돌아보지 않겠다고 약속하면 앉게 해 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/main1.ogg"},"메인2":{"voiceline":"(아까부터 계속 힐끔힐끔 쳐다보네… 들키면 어떡하지… 너무 부끄러워……!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/main2.ogg"},"메인3":{"voiceline":"수영장도 쾌적하고 햇살도 좋은데 지휘관까지 있어… 누가 봐도 행복한 상황인데 어쩌다 이렇게 된 거야…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"대체 어디로 간 거야…… 으흠, 노는 건 다음으로 미뤄도 되지? 지금 더 중요한 건…… 어휴! 어디 안 도망가! 수영복도 어딘가로 날아가버리지 않을 거고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/detail.ogg"},"드랍 설명":{"voiceline":"자, 잠깐! 그렇게 한마디도 없이 들어오면 어떻게 해! 수영복을 찾으려던 참인데… 아, 아무 것도 아니야! 딱히 쫓아내려는 건 아니니까 들어올 거면 빨리 들어와!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관이 바로 옆에 있는데, 아무것도 못 하다니…… 헉, 지휘관. 설마 처음부터 눈치채고 있었던 거야!? 그랬던 거면 그렇게 눈 피할 필요 없으니까… 날… 똑바로 바라봐 줘… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/feeling5.ogg"},"터치3":{"voiceline":"(가, 갑자기 무슨 짓이야…! 하마터면 들킬 뻔 했잖아…!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/headtouch.ogg"},"모항귀환":{"voiceline":"휴우… 돌아왔어? 작전하느라 힘들었지… 옆에 앉을 수 있게 비워줄 테니까 천천히 쉬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"돌아왔어? 할일 없으면 여기서 천천히 쉬어도 돼. …차오 호랑 놀고 싶다고? 좋아. …어라? 수영복이…… 자, 잠깐……! 안 돼! 지금은 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"으읏…… 잠깐 물결을 좀 멍하니 보고 있었던 것뿐이야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/touch.ogg"},"터치2":{"voiceline":"으읏?! 갑자기 만지면 어떡해… 빠지면 어떻게 하려고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/touch2.ogg"},"입수시":{"voiceline":"자, 잠깐! 그렇게 한마디도 없이 들어오면 어떻게 해! 수영복을 찾으려던 참인데… 아, 아무 것도 아니야! 딱히 쫓아내려는 건 아니니까 들어올 거면 빨리 들어와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502053/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"수영복","상점 id":71162,"상점 카테고리 id":6,"스킨 태그":"쁘띠모션, 배경","입수 영상":"O","재화":880,"기간":"한정 (2025/08/20)","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502059,"클뜯 함순이 id":50205,"함순이 이름":"차오 호","한글 함순이 + 스킨 이름":null,"영문 함순이 + 스킨 이름":"Chao Ho (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502059/painting.png","확대 일러":