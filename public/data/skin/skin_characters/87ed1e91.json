[{"클뜯 id":502050,"클뜯 함순이 id":50205,"함순이 이름":"차오 호","한글 함순이 + 스킨 이름":"차오 호","영문 함순이 + 스킨 이름":"Chao Ho","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502050/shipyard.png","설명":"나는 차오 호급 순양함 차오 호, 차오 호라고! 틀리지 말아줘! 잉 루이가 무슨 말을 했는지 모르겠지만, 기억해. 내가 언니라고!","자기소개":{"voiceline":"나는 차오 호급 순양함의 수석함. 경력은... 생략. 데이터... 생략. 생략이야 생략! 전부 생략!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/profile.ogg"},"메인1":{"voiceline":"체면치레하는 일은 모두 잉 루이게 맡기는 게 좋겠어! 난 옆에서 지켜주는 일을 하면 되지 뭐!... 아니지, 이러면 언니답지 못한 게 되잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/main1.ogg"},"메인2":{"voiceline":"내 앞에서 얼마나 돌아다니는 거야? 좀 앉아 있을 수 없어? 응? 그... 그렇게 널 의식하는 건 아니지만... 착, 착각하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/main2.ogg"},"메인3":{"voiceline":"모든 일은 꾸준히 해야만 최고 수준에 다다를 수 있지... 이건 잉 루이가 한 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/main3.ogg"},"전투개시":{"voiceline":"반드시 악을... 아! 까먹었다! 아무튼, 모든 적을 제거하겠어!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/battle.ogg"},"상세확인":{"voiceline":"왜 다들 잉 루이를 언니로 생각하는 거지... 내, 내가 언니라는 걸 못 믿겠다는 건가?! 지휘관이 말해 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/detail.ogg"},"드랍 설명":{"voiceline":"차오 호급 방호 순양함—차오 호","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔다고? 언제 갔었지...나, 나 까먹은 거 아니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/expedition.ogg"},"실망":{"voiceline":"우린 그렇게 친하지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/feeling1.ogg"},"낯섦":{"voiceline":"흠, 오늘은 춤 연습을 못 했어... 아, 지휘관? 저, 절대 훔쳐보면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/feeling2.ogg"},"호감":{"voiceline":"지휘관! 잉 루이가... 닝하이가 만든 만두를 두고 위협했어! 오늘 청소를 해 놓지 않으면 주지 않겠다고 말이야! 빨리 좋은 방법을 생각해 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 잉 루이가 말하길 성미가 급한 사람을 좋아하지 않는다고 하던데. 나 성질을 좀 죽여 볼게! 그러니까, 너, 너도 나를 너무 싫어하지마... 틈만 주면 기어오르지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/feeling4.ogg"},"사랑":{"voiceline":"새로운 춤 연습을 시작했어. 내 춤을 보는 첫 관객이면서, 그 이름을 지어 주었으면 하는데, 혹... 혹시 올 수 있어? 아니지, 혹시 한가하면 와 줘! 아니, 아니야! 꼭 와야 해! 알았지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/feeling5.ogg"},"터치3":{"voiceline":"그만 만져, 그만 만지라고. 너 때문에 머리칼이 엉망이 되잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/headtouch.ogg"},"모항귀환":{"voiceline":"지금 여기 아무도 없지? 몰래 춤 연습 좀 해볼까... 어, 어? 저... 언제 돌아왔어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/home.ogg"},"hp 경고":{"voiceline":"정신 차려야 해. 절대 적에게 얕보여선 안 된다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/hp_warning.ogg"},"로그인":{"voiceline":"왜 이렇게 늦게 오는 거야! 말해, 일부러 늦게 와서 내가 걱정하게 하려는 거지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/login.ogg"},"실패":{"voiceline":"우웅... 난 아직 약한가 봐...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/lose.ogg"},"우편":{"voiceline":"지휘관, 지금 당장 우편을 보지 않으면 우편함에 풀이 자랄지도 몰라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/mail.ogg"},"임무":{"voiceline":"새로운 임무야! 어서 가서 확인해 봐! 잉 루이가 또 엄마처럼 다그친다고 할라...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/mission.ogg"},"임무완료":{"voiceline":"이런 간단한 임무는 내게 식은 죽 먹기지~ 아아 물론 지휘관의 공도 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/mission_complete.ogg"},"서약":{"voiceline":"그......\"그대의 손을 잡고 인생의 끝까지 살아가리\"...라는 건 지금 이럴 때 말하는 거지？아, 아니면 또 다른 게 있을까...... 아아아 모르겠어. 생각이 안 나!! 어쨌든, 지휘관, 지금부터 책임져야 할 거야! 알겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/propose.ogg"},"스킬":{"voiceline":"노래 춤 모두 만능!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/skill.ogg"},"터치1":{"voiceline":"...... 무슨 생각하는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/touch.ogg"},"터치2":{"voiceline":"와아아!! 이,이,이런 무례한 자식!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/touch2.ogg"},"입수시":{"voiceline":"나는 차오 호급 순양함 차오 호, 차오 호라고! 틀리지 말아줘! 잉 루이가 무슨 말을 했는지 모르겠지만, 기억해. 내가 언니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/unlock.ogg"},"강화성공":{"voiceline":"이, 이번엔 좀 든든해 보이지 않았을까...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥, 다시 한번 말하는데, 우리 영역에 침범하려 하지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"차오 호급의 언니는 누구?... 정답입니다~ 차오 호가 바로 잉 루이의 언니지♪ 지휘관 잘 알고 있네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관... 저기, 난 너의 반려자이기도 하