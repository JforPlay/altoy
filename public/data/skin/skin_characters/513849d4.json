사임하는 것도 함께 검토하도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관이 외교에서의 주도권을 잡을 수 있도록 하는 것이 저의 책무입니다. 안심하세요. 프로니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/feeling2.ogg"},"호감":{"voiceline":"최근에는 외교 사무보다 지휘관의 개인적 용무의 대응에 쫓기는 일이 많아지고 있는 것 같습니다만…… 일부러 그러시는 건 아니겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/feeling3.ogg"},"기쁨":{"voiceline":"외교 스태프는 비서를 겸임하지 않지만… 개인적으로는 지휘관과의 관계를 보다 돈독하게 만들길 바라고 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/feeling4.ogg"},"사랑":{"voiceline":"지휘관이 더 많은 이익을 손에 넣길, 더욱 주도권을 잡길 원해…… 후후, 저, 이제 함대의 외교관에 어울리지 않게 되어버렸을지도 모르겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고하셨습니다. 조금 전의 전투에 대해서는 제가 실력을 발휘해보도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"좋은 타이밍입니다. 마침 사인을 해 주셨으면 하는 서류가 몇 장 있더군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/login.ogg"},"실패":{"voiceline":"이러면 교섭의 우위성이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 새 편지가…… 응? 이건 어디서 보낸 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/mail.ogg"},"임무":{"voiceline":"임무 달성은 자신의 능력을 과시할 좋은 찬스입니다. 새로운 임무를 훑어봐주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/mission.ogg"},"임무완료":{"voiceline":"미션 보너스 일람입니다. 확인을 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/mission_complete.ogg"},"서약":{"voiceline":"감사합니다. 이것으로 함대의 사무 처리에 한층 힘을 쏟을 수가 있겠네요── 에? 지휘관을 조금 대행해도 된다고요? 기쁜 농담입니다. ……어쨌든, 실망은 시키지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/propose.ogg"},"스킬":{"voiceline":"무력에 의한 위협도 외교의 일환이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/skill.ogg"},"터치1":{"voiceline":"이 담갈색 피부에 흥미가 있으십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/touch.ogg"},"터치2":{"voiceline":"외교관은 비서를 겸임하기 어렵습니다…… 자중해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/touch2.ogg"},"입수시":{"voiceline":"브루클린입니다. 지휘관, 정예 순양함으로서, 외교 활동은 제게 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/unlock.ogg"},"강화성공":{"voiceline":"실력은 함포 외교의 기본입니다. 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"그럼, 전쟁 배상에 관해 이야기하지 않겠나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0}]