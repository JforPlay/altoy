[{"클뜯 id":402050,"클뜯 함순이 id":40205,"함순이 이름":"뉘른베르크","한글 함순이 + 스킨 이름":"뉘른베르크","영문 함순이 + 스킨 이름":"Nürnberg","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402050/shipyard.png","설명":"라이프치히급 경순양함—뉘른베르크","자기소개":{"voiceline":"여러 차례 개장을 받았지만, 큰 전쟁에서 별로 쓸모가 없었어요... 계산해보면, 메탈 블러드 내에서 복역 기간도 비교적 길다고요? 저 자신도 믿기 어렵지만...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/profile.ogg"},"메인1":{"voiceline":"지휘관님은 소세지를 좋아하시나요? 음... 일이 잘 풀리면, 제가 만들어 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/main1.ogg"},"메인2":{"voiceline":"라이프치히가 쉽게 기절하는 병을 치료할 좋은 방법이 없을까요... 접촉을 통한 단련이요? 안 될 것 같은데... 아니, 지휘관님 설마 이 기회를 빌어 라이프치히에게 접근해서 나쁜 짓을 하려는 건 아니죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/main2.ogg"},"메인3":{"voiceline":"지휘관님에게 너무 과했나... 어떡하지... 지휘관님 화 안나셨겠지...? 돼, 됐어, 어차피 지휘관님은 머릿속에 이상한 생각 밖에 없는걸......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/main3.ogg"},"전투개시":{"voiceline":"모두... 맡은 바 소임을 다해 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/battle.ogg"},"상세확인":{"voiceline":"왜 혼자서 저를 보러 오신 거죠? 서, 설마 지휘관님, 아무도 없을 때를 틈타서...!? 아, 아닙니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/detail.ogg"},"드랍 설명":{"voiceline":"저는 라이프치히급 2번함, 뉘른베르크입니다. 오늘부터, 여기서 지휘관님을 위해 복무하겠습니다... 괜찮겠죠?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었어요. 제가 말씀드리지 않아도, 지휘관님은 뭘 해야할지 알고 계시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/expedition.ogg"},"실망":{"voiceline":"지휘관님... 정말 눈에 거슬리네요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/feeling1.ogg"},"낯섦":{"voiceline":"라이프치히가 갑자기 쓰러지지나 않을까 걱정돼요... 지휘관님, 잘 돌봐 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/feeling2.ogg"},"호감":{"voiceline":"소세지 굽는 법을 배우고 싶다고요? 문제 없습니다. 하지만, 미리 말해둘게요. 전 매우 엄격하답니다...... 잠깐, 혹시 지휘관님이 제게 접근하려는 수단은 아니겠죠!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/feeling3.ogg"},"기쁨":{"voiceline":"요새 지휘관님과 함께 지내는 시간이 점점 길어지네요... 으음, 지휘관님 역시 이상한 생각이 있으신 거죠! 이대로 방치하다간 저는... 응? 그렇게... 싫지는 않은데요...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/feeling4.ogg"},"사랑":{"voiceline":"곰곰히 생각해보면, 실제로 지휘관님에게 심한 일을 당한 적은 없는 것 같아요... 오히려 신사적인 관심을 더 받았지요... 지휘관님과 같이 있는 건 사실 매우 즐거워요... (작게)정말로 뭔가를 했다고 하더라도........ 제제제제가 지금 무슨 말을!? 아무 것도 못 들은 걸로 해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/feeling5.ogg"},"터치3":{"voiceline":"갑자기 머리를 만지다니, 부, 분명히 이상한 일을 생각하고 있죠! 제, 제 말 맞죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/headtouch.ogg"},"모항귀환":{"voiceline":"출격 수고하셨습니다, 지휘관님. 하지만, 모두를 위해 좀 더...! 버텨주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/home.ogg"},"hp 경고":{"voiceline":"아, 아파요.....","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/hp_warning.ogg"},"로그인":{"voiceline":"이제 업무 시간입니다. 히... 힘내세요, 지휘관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/login.ogg"},"실패":{"voiceline":"이럴수가... 제 책임입니다. 죄송합니다......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/lose.ogg"},"우편":{"voiceline":"새로운 우편이 있습니다, 지휘관님. 스팸 메일은 아니겠죠...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있습니다, 지휘관님. 이전의 임무는 다 완료하셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/mission.ogg"},"임무완료":{"voiceline":"임무를 모두 끝내셨다고요? 역시 지휘관님이시군요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/mission_complete.ogg"},"서약":{"voiceline":"저, 저 알았어요. 이번엔 모두 지휘관님 말을 들을게요... 그러니까...... 제 얼굴 좀 쳐다보지 말아 주세요. 정말 부끄러우니까! 계속 더 이러다간, 엄청 이상하게 변할 것 같아요... 아, 아무튼 이 의식 좀 빨리 끝내요! 웅웅...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/propose.ogg"},"스킬":{"voiceline":"여, 여기서 쓰러져 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/skill.ogg"},"터치1":{"voiceline":"설마 지휘관님, 무심코 툭툭 건드려서 점점 저의 경계심을 풀게 하려는!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/touch.ogg"},"터치2":{"voiceline":"꺄아악!? 너, 너무 직접적인 거 아녜요, 지휘관님!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/touch2.ogg"},"입수시":{"voiceline":"저는 라이프치히급 2번함, 뉘른베르크입니다. 오늘부터, 여기서 지휘관님을 위해 복무하겠습니다... 괜찮겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/unlock.ogg"},"강화성공":{"voiceline":"이런 노력들이 나중에는 모두 쓸모 있기를…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에? 제가 MVP? 정말 의외군요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관님, 명령을 내려 주세요...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":{"voiceline":"갑자기 만지다니...... 머리가 아니라 다른 곳을 만지는 것도 안돼요! 제가 이상한 생각을 할 수...와아악! 전 아무 말도 안했어요!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 오늘도 함대를 위해 열심히 일해요! 제가 함께 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"우웅...... 이건 그냥 무심코 건드리는 거야…무심코 건드리는 거!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/touch_ex.ogg"},"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"제가 MVP! 하하... 조, 조금 자랑해도 괜찮겠죠!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['라이프치히'] : 함께 용기내서 싸워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"모두를 위해 준비한 소세지... 안돼요! 아직 덜 됐어요! 누가 뭐래도 2분 동안 더 기다리게 할 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"nil","voicelink":null},"메인3_ex":{"voiceline":"또 게으름 피우나요? 지휘관님에게 버, 벌을 줘야겠네요... 아우......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402050/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":1},{"클뜯 id":402051,"클뜯 함순이 id":40205,"함순이 이름":"뉘른베르크","한글 함순이 + 스킨 이름":"정월의 여행","영문 함순이 + 스킨 이름":"Spring Wanderer","스킨 타입":"New Year Kimono","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/