[{"클뜯 id":101440,"클뜯 함순이 id":10144,"함순이 이름":"쿠퍼","한글 함순이 + 스킨 이름":"쿠퍼","영문 함순이 + 스킨 이름":"Cooper","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101440/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101440/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101440/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101440/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101440/shipyard.png","설명":"지휘관, 나는 쿠퍼! 후후~ 나와 함께 동료를 위해, 이 세계의 내일을 위해 싸우자! ","자기소개":{"voiceline":"나는 알렌 M. 섬너급 쿠퍼야. 알렌 M. 섬너 언니와 모에일 언니와 함께 올모크 만에서 사쿠라 엠파이어의 함대를 막으라는 명을 받았지. 하지만 활약을 하기도 전에… 으으, 젠장! 전부 다 그 녀석의 위력이 너무 강력해서, 발견하기 힘들어서야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/profile.ogg"},"메인1":{"voiceline":"공문? 이런걸 쓰는 게 적을 처치하는 데 무슨 도움이 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/main1.ogg"},"메인2":{"voiceline":"흐아암~ 고양이들을 보고 있으면 마음이 사르르 녹는 것 같다니까. 지휘관, 우리도 검은 고양이 한 마리 키우지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/main2.ogg"},"메인3":{"voiceline":"저기…… 지휘실에 대체 얼마나 더 있어야 하는 거야? 너무 지루해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/main3.ogg"},"전투개시":{"voiceline":"캐스트 오프! 간다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/battle.ogg"},"상세확인":{"voiceline":"가끔은 말이지, 모두가 위험에 처했을 때 나에게 숨겨진 엄청난 힘이 쨘! 하고 나타나서 세계를 구하면 어떨까 하는 생각을 해! … 하아, 정말이라면 얼마나 좋을까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 나는 쿠퍼! 후후~ 나와 함께 동료를 위해, 이 세계의 내일을 위해 싸우자!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조의 마중? 식은 죽 먹기지! 잘 보라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/expedition.ogg"},"실망":{"voiceline":"지휘관이 적이라고 해도 절대 봐주지 않겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/feeling1.ogg"},"낯섦":{"voiceline":"위험에 빠지면 큰 소리로 ‘쿠퍼!’하고 불러봐. 그러면 내가 반드시 지휘관에게 가서 화려하게 전부 해결해줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/feeling2.ogg"},"호감":{"voiceline":"지휘관, 쿠퍼가 왔어! 자, 어떤 적이라도 전부 쓰러뜨려 주지! …… 자료를 가져가라고? 으으으…… 진짜, 무시하지 말란 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/feeling3.ogg"},"기쁨":{"voiceline":"미안. 지난번에 불렀을 때는 모항의 검은 고양이에게 한눈을 파는 바람에 가지 못했어. 덕분에 지휘관이 하루 종일 나를 찾아 헤매게 만들었네…… 다음번에는 이런 일은 없을 거야! 하지만 고양이랑 노는 건 절대 포기할 수 없는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/feeling4.ogg"},"사랑":{"voiceline":"지휘관! 차라리 쿠퍼를 계속 곁에 두는 건 어때? 그러면 무슨 일이 일어나도 무섭지 않을 거야! …… 내가 더 걱정이라고? 어, 어떻게 반응해야 하는지 모르겠어…… 어쨌든 항상 곁에 있을게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관이 자리를 비웠을 때 내가 많은 걸 해결해뒀다고! 이 서류 좀 봐! 이렇게 쓰는 거 아니야? 이상하네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/home.ogg"},"hp 경고":{"voiceline":"안돼, 무서워하지 마! 지금이 바로 모두가 나를 필요로 하는 그 순간이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/hp_warning.ogg"},"로그인":{"voiceline":"히히, 씩씩한 지휘관을 보니 걱정 없네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/login.ogg"},"실패":{"voiceline":"한 번의 패배로는 절대 주눅 들지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/lose.ogg"},"우편":{"voiceline":"새로운 우편이네? 설마 구조 요청인가…… 망했다, 또 위기가 닥쳐오고 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/mail.ogg"},"임무":{"voiceline":"임무를 완료하지 않으면 모두에게 도움이 될 수 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 우리가 해낸 일은 분명 의미가 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/mission_complete.ogg"},"서약":{"voiceline":"지휘관이 나를 이렇게 소중하게 생각했다니… 정말정말 기뻐! 헤헤. 내일도, 모레도, 글피도 지휘관과 함께라면 무한한 용기가 솟아오를 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/propose.ogg"},"스킬":{"voiceline":"받아라! 사이클론 스매셔!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/skill.ogg"},"터치1":{"voiceline":"준비 끝났어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/touch.ogg"},"터치2":{"voiceline":"지휘관, 지금 무슨 짓을 했는지 알고는 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/touch2.ogg"},"입수시":{"voiceline":"지휘관, 나는 쿠퍼야! 헤헷~ 나와 함께 동료들을 위해, 이 세계의 내일을 위해 싸우자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/unlock.ogg"},"강화성공":{"voiceline":"강해져야만 더 많은 사람을 도울 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/upgrade.ogg"},"vote":null,"승리":{"voiceline":"하암…… 승리의 바람은 정말 편안한걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101440/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0