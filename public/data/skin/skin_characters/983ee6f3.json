[{"클뜯 id":301280,"클뜯 함순이 id":30128,"함순이 이름":"오야시오","한글 함순이 + 스킨 이름":"오야시오","영문 함순이 + 스킨 이름":"Oyashio","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301280/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301280/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301280/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301280/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301280/shipyard.png","설명":"카게로급 구축함 4번함 - 오야시오","자기소개":{"voiceline":"카게로급 4번함 오야시오야. '쿠로' 와는 언제나 함께하고 있어~ 그러니까, 쿠로가 꼭 제대로 설명해줄테니 우리에 관한 건 쿠로에게 들어줘. 아, 그것보다, 내 공연 안 볼래? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/profile.ogg"},"메인1":{"voiceline":"지휘관, 한가하면 내 공연이라도 안 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/main1.ogg"},"메인2":{"voiceline":"쿠로는 소중한 동료야! 이름의 유래는 물론, 내 고지식한 언니에서 따온 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/main2.ogg"},"메인3":{"voiceline":"실은 인형에 다는 건데 왜 어뢰에 달았냐고? 아하하…이게 말로만 듣던 '직업병' 이라는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/main3.ogg"},"전투개시":{"voiceline":"자자~ 동네 사람들~ 구경 한 번 와보세요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/battle.ogg"},"상세확인":{"voiceline":"지휘관, 내 손동작 말야, 되게 닌자 같지 않아? 에헤헤~ 실은 이거, 쿠로가 알려준 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/detail.ogg"},"드랍 설명":{"voiceline":"카게로급 구축함 4번함 - 오야시오","voicelink":null},"의뢰 완료":{"voiceline":"지휘관~ 의뢰가 완료되었다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/expedition.ogg"},"실망":{"voiceline":"지휘관이 어떻게 되던 쿠로는 절대 막지 않겠지만… 나는 절대로 그냥 넘기지 않을 거야! 쿠로를 위해서, 지휘관, 각오하라고! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/feeling1.ogg"},"낯섦":{"voiceline":"지휘관도 내 인형극을 봐볼래? 자자, 사양 말고 앉아보셔~ 관객이 잔뜩 있는 편이 즐거우니까 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/feeling2.ogg"},"호감":{"voiceline":"언니는 쿠노이치라 해도 너무 무뚝뚝해서 말야……내가 인형사가 되어 언젠가 언니를 웃게 해주면 좋겠다고 생각했지만, 아직은 좀 어렵네, 에헤헤……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 좋은 사람이네. 내 생각을 받아들여 줄 뿐만 아니라, 모두와 함께 협력해주니 말야……나, 언젠가 반드시 쿠로를 웃게 해줄 테니까, 그땐 꼭 함께 있어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 나 있잖아, 쿠로처럼 감정을 버리고 아무 생각 안 해도 좋지 않을까…하고 한 번 생각해 본 적이 있었지만…역시 나는 안 되겠더라고. 왜냐면 나는 쿠로를 좋아하고, 지휘관도 좋아하고, 인형극을 좋아하는 '오야시오' 인걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"쿠로, 지휘관에게 마사지해줘……음, 어깨 주위에서 몇 번을 뛰어야 시원해지려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, \"기운 낼 수 있게 내 인형극을 한 번 구경하는 건 어떠실라나~?\" 이렇게 말하는 거, 어때 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/login.ogg"},"실패":{"voiceline":"우와! 지휘관, 모두를 데리고 어서 도망치자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/lose.ogg"},"우편":{"voiceline":"지휘관, 어떤 어뢰에 편지가 들어있을지 맞춰 볼래? 틀리면……에이 뭐 폭발까지 하진 않을 테니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무를 수행하러 가자~ 나도 마침 새로운 공연 소재가 필요해서 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/mission.ogg"},"임무완료":{"voiceline":"지휘관, 임무 보수가 도착했어~ 새로운 공연을 짤 만한 게 있는 거 같으니까 잠깐 봐볼게~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/mission_complete.ogg"},"서약":{"voiceline":"그렇게 지휘관은 오야시오와 낮에도 밤에도 늘 함께 하며, 오래오래 행복하게 살았답니다~ 에헤헤, 매일 희극만 보면 질리겠지만, 지휘관과의 하루하루는 매일 희극이었으면 좋겠어~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/propose.ogg"},"스킬":{"voiceline":"클라이막스는 지금부터~라고♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/skill.ogg"},"터치1":{"voiceline":"지휘관, 그러고 보니 바다의 '오야시오' 해류에는 영양 염류가 풍부하다던데……내, 내 얘기가 아니라니깐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/touch.ogg"},"터치2":{"voiceline":"!! 으랏차~! ……지휘관, 미안……직업병이라 반사적으로 반격해버렸어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/touch2.ogg"},"입수시":{"voiceline":"언니는 쿠노이치, 동생은 인형사! 인생이란 참으로 놀라움의 연속이 아닐 수가 없으니! 카게로급 4번함 오야시오, 인형 '쿠로' 와 함께하는 인형극 한마당 구경 옵쇼~ 그러니까, 잘 부탁해 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/unlock.ogg"},"강화성공":{"voiceline":"오오, 새로운 공연 소재가 떠올랐어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관, 함대와 함께 개선~ 이번 이야기는 여기서 끝!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301280/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"