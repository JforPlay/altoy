g"},"드랍 설명":{"voiceline":"지, 지휘관… 미유키, 언제든 괜찮아… 오늘 옷차림이 너무 귀엽다고…? 고, 고마워… 에헤헤, 사실 지휘관이랑 데이트하려고 준비한 거야… 그… 붕대로 잘 감추면, 미유키의 불행도 어딘가 사라질 것 같아서…","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"오늘의 행운은 그… 미유키라도 지휘관 곁에 있으면 행복해질 수 있다는 걸까? …지휘관이 계속 행운을 미유키에게 나눠주겠다고? 아니야, 그래도 미유키는 소중한 지휘관이 행운을 가지고 있었으면 좋겠어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301042/feeling5.ogg"},"터치3":{"voiceline":"읏… 이렇게 귀를 쓰다듬으면 미유키… 깜빡 잠이 들 것 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301042/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 일하느라 고생 많았어! …아니, 미유키는 그렇게 오래 안 기다렸으니까 괜찮아. 음… 봐… 크레이프… 아직 따뜻하잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301042/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"아, 안녕. 지휘관… 지금부터 미유키랑 데이트해도 괜찮아? 그렇지만 아직 일이… 다 끝내고 왔다고? 다, 다행이다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301042/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지, 지휘관… 저기… 소, 손잡는 편이 좋을까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301042/touch.ogg"},"터치2":{"voiceline":"바, 밖에서는 아무래도 좀… 응… 그, 그럼 일단 돌아갈까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301042/touch2.ogg"},"입수시":{"voiceline":"지, 지휘관… 미유키, 언제든 괜찮아… 오늘 옷차림이 너무 귀엽다고…? 고, 고마워… 에헤헤, 사실 지휘관이랑 데이트하려고 준비한 거야… 그… 붕대로 잘 감추면, 미유키의 불행도 어딘가 사라질 것 같아서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301042/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인