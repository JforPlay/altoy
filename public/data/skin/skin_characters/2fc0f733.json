[{"클뜯 id":9705070,"클뜯 함순이 id":970507,"함순이 이름":"줄리오 체사레·META","한글 함순이 + 스킨 이름":"줄리오 체사레·META","영문 함순이 + 스킨 이름":"Giulio Cesare META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705070/shipyard.png","설명":"나는 제국의 정복자, 줄리오 체사레… 쓸데없는 잡담은 필요 없어. 자질구레한 일에 시간을 낭비하고 싶지는 않아.","자기소개":{"voiceline":"제국의 정복자, 줄리오 체사레야. 왔노라! 보았노라! 정복했노라!――― 승리를 거두고 마지막에는 고향으로… 영광으로 빛나는 그 땅으로 돌아가겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/profile.ogg"},"메인1":{"voiceline":"지휘관, 모항 주변의 초소 배치에 개선할 점이 있는 것 같아. 잠깐 논의해 볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/main1.ogg"},"메인2":{"voiceline":"대포와 항공기에만 주목하면 안 돼. 전투는 병사 하나하나가 큰 가치를 가지고 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/main2.ogg"},"메인3":{"voiceline":"아이리스의 수탉…… 로열 네이비의 사자? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/main3.ogg"},"전투개시":{"voiceline":"정복을 시작하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/battle.ogg"},"상세확인":{"voiceline":"응? 어디 새로 정복이라도 하려고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/detail.ogg"},"드랍 설명":{"voiceline":"콘테 디 카보우르급 전함 줄리오 체사레<color=#92fc63>(1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네. 병참의 중요성을 명심하면서 함께 그녀들의 개선을 맞이하러 가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/expedition.ogg"},"실망":{"voiceline":"……언젠가는 루비콘 강을 건너겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/feeling1.ogg"},"낯섦":{"voiceline":"지휘관은 지도자로서 굉장히 우수해. 우리가 협력하면 승리를 거두고, 영원한 영광을 손에 쥘 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/feeling2.ogg"},"호감":{"voiceline":"개선하는 광경을 수없이 꿈꿨어. 개선문의 꽃길을 걸으며, 모든 사람이 우리의 위업을 기리는 거지… 그저 내 헛된 꿈일 뿐이지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/feeling3.ogg"},"기쁨":{"voiceline":"고향이 어떤 모습이었는지 더는 기억나지 않지만, 아마 이곳처럼 평화롭고도 번영한 곳일 테지. 지휘관, 소중히 여기도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/feeling4.ogg"},"사랑":{"voiceline":"붉은 카펫에 축포……? 지휘관, 대체 이건 무슨…… 내 개선을 축하하기 위해서라고? …고마워! 제국의 정복자, 줄리오 체사레… 지금 승리를 거두고 돌아왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/feeling5.ogg"},"터치3":{"voiceline":"레기온의 투구도 좋아하지만… 군모도 나쁘지 않네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/headtouch.ogg"},"모항귀환":{"voiceline":"역시 몸은 전장 쪽이 익숙해. 다음 출격에는 나도 동행하겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/home.ogg"},"hp 경고":{"voiceline":"주사위가 던져진 이상… 계속해서 나아가야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/hp_warning.ogg"},"로그인":{"voiceline":"왔어? 집중해서 직무에 매진하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/login.ogg"},"실패":{"voiceline":"……더 많은 레기온이 필요해, 지휘관","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/lose.ogg"},"우편":{"voiceline":"우편에는 시효성이 있어. 그러니까 확인하는 걸 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/mail.ogg"},"임무":{"voiceline":"임무 처리하는 걸 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/mission.ogg"},"임무완료":{"voiceline":"정확하고도 효율적이야. 아주 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/mission_complete.ogg"},"서약":{"voiceline":"사랑하는 네가 있는 곳이 바로 내가 머무를 곳이지. 네가 지키고자 하는 존재는 나도 지키고 싶어. 네 적은 곧 나의 적… 지휘관, 함께 손을 잡고 미지로 가득한 광대한 세상에 맞서자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/propose.ogg"},"스킬":{"voiceline":"veni，vidi，vici！","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/skill.ogg"},"터치1":{"voiceline":"넓은 바다와 하늘, 이 모든 것은 우리에게 정복당하기 위해 존재하는 것… 그렇게 생각하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/touch.ogg"},"터치2":{"voiceline":"좋아. 지휘관도 정복자로서 그만한 야망은 가져야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/touch2.ogg"},"입수시":{"voiceline":"나는 제국의 정복자, 줄리오 체사레… 쓸데없는 잡담은 필요 없어. 자질구레한 일에 시간을 낭비하고 싶지는 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/unlock.ogg"},"강화성공":{"voiceline":"여기서 멈춰 있을 수는 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리와 영광은 늘 나와 함께하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['로마'] : 위대한 로마에 경의를 표하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705070/couple_encourage1.ogg"}],