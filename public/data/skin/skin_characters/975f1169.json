[{"클뜯 id":102040,"클뜯 함순이 id":10204,"함순이 이름":"피닉스","한글 함순이 + 스킨 이름":"피닉스","영문 함순이 + 스킨 이름":"Phoenix","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102040/shipyard.png","설명":"브루클린급 순양함·피닉스 (CL-46)","자기소개":{"voiceline":"나는 피닉스. 봉황으로서 한때 어떤 분이 탄 배지. 이름대로 어떤 사지여도 다 견뎌 보이겠어! 그러니까 어떤 위험한 임무라도 맡겨줘! 실망하게 하지는 않을 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/profile.ogg"},"메인1":{"voiceline":"내 방침은 「무슨 일이든 일등」이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/main1.ogg"},"메인2":{"voiceline":"아르헨티나의 태양은 좀 더 큰가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/main2.ogg"},"메인3":{"voiceline":"사지를 극복하는 것보다 스릴 넘치는 일 따윈 없다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/main3.ogg"},"전투개시":{"voiceline":"봐라! 동방은 붉게 타오르고 있다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/battle.ogg"},"상세확인":{"voiceline":"지휘관, 뭔 일 있었어? 눈이 멍하다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/detail.ogg"},"드랍 설명":{"voiceline":"브루클린급 순양함·피닉스 (CL-46)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료 (국어책 읽기) ……있잖아, 슬슬 나도 보내주지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/expedition.ogg"},"실망":{"voiceline":"저쪽으로 가버려, 이 겁쟁이!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/feeling1.ogg"},"낯섦":{"voiceline":"죽음을 무서워하지 않는 녀석만 살 자격이 있다는 거지! ──아, 지휘관 무서워하지 마! 딱히 산다든가 죽는다는가가 아니라, 마음의 준비만은 해두라고 말하고 싶었던 거라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/feeling2.ogg"},"호감":{"voiceline":"왜 그래? 나라도 괜찮다면 상담을 해주도록 하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/feeling3.ogg"},"기쁨":{"voiceline":"그분은 존경하고 있지만, 지휘관은 지휘관이야. 내 뒤에 지휘관만 있으면 무적이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/feeling4.ogg"},"사랑":{"voiceline":"과연, 지휘관과 있으면 몸이 타오르는 것 같은 이 기분이야말로, 사랑이라는 건가…… 이런 건 느꼈던 적이 없어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"엇차, 오늘도 무사히 돌아왔구만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/home.ogg"},"hp 경고":{"voiceline":"이 손이 승리를 잡으라고 외치고 있다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/hp_warning.ogg"},"로그인":{"voiceline":"Hey! 지휘관! 오늘도 이 피닉스가 지켜줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/login.ogg"},"실패":{"voiceline":"칫, 기억하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/lose.ogg"},"우편":{"voiceline":"헤이 지휘관! 새로운 편지라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/mail.ogg"},"임무":{"voiceline":"임무라면 일등이 아니면 안 되겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/mission.ogg"},"임무완료":{"voiceline":"우리의 보너스, 드디어 도착했구만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102040/mission_complete.ogg"},"서약":{"voiceline":"……고마워. 그럼 받아둘게. 그리고 저기…… 나는, 달달한 이야기나 애교 같은 건 잘 모르지만 선택받은 이상 실망만은 절대 시키지 않아!","voicelink":"https