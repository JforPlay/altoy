[{"클뜯 id":307080,"클뜯 함순이 id":30708,"함순이 이름":"시나노 ","한글 함순이 + 스킨 이름":"시나노 ","영문 함순이 + 스킨 이름":"Shinano","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307080/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307080/shipyard.png","설명":"야마토급 3번함—시나노 ","자기소개":{"voiceline":"나는 사쿠라 엠파이어의 항공모함, 시나노 . 야마토와 함께 사쿠라 엠파이어를 위해 이 한몸 바쳐야 했지만 결국 그런 결말을 맞게 되었지. 세상 일이라는 것이 얼마나 무상한지… 하지만 이번에는 네가 있으니 반드시 다른 결말을 맞을 것이라고 믿는다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/profile.ogg"},"메인1":{"voiceline":"아름다운 것은 짧기 마련. 하지만 한순간 빛나는 것이 조용히 사라지는 것보다는 낫겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/main1.ogg"},"메인2":{"voiceline":"지휘관, 피곤하면 내 품에서 잠시 눈을 붙이지 않겠나? 사쿠라 엠파이어의 구축함들이 좋아하는 것처럼……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/main2.ogg"},"메인3":{"voiceline":"모항에는 내가 보지 못한 신기한 것들이 참 많더군. 기회가 된다면 하나하나 해보고 싶다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/main3.ogg"},"전투개시":{"voiceline":"승부는 운명으로 정해진 것. 적어도… 최선을 다해야지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/battle.ogg"},"상세확인":{"voiceline":"Zzzzz… 운명의 굴레에서 벗어나는 힘이야 말로 진정한 강함이라는데… 정말 그런가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/detail.ogg"},"드랍 설명":{"voiceline":"야마토급 3번함—시나노 ","voicelink":null},"의뢰 완료":{"voiceline":"Zzzzzz… 절대로… 의뢰조 아이들의 마중을… 잊어서는 안 돼…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/expedition.ogg"},"실망":{"voiceline":"네 곁에는 그 어떤 빛도 보이지 않는구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/feeling1.ogg"},"낯섦":{"voiceline":"수많은 기대를 받았지만 그에 상응하는 실력을 보이지 못했으니, 이것 역시 운명이 나를 조롱하는 것 아니겠는가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/feeling2.ogg"},"호감":{"voiceline":"운명을 알고 있지만 바꿀 힘이 없구나. 아무 것도 모르는 것과 알면서도 바꿀 수 없는 것, 대체 어느 것이 더 불행한 일일까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/feeling3.ogg"},"기쁨":{"voiceline":"내가 꾸는 꿈은… 너무나 슬퍼서 잊고 싶은 꿈, 행복해서 깨고 싶지 않은 꿈… 심지어 현실도 꿈 같구나. 지휘관, 너는… 현실인가, 아니면 꿈인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/feeling4.ogg"},"사랑":{"voiceline":"지금까지 나는 \"어쩔 수 없는 운명\"에 얽매여 한탄만 했지… 하지만 지금, 여기에 너와 함께 있다면 어떤 운명도 두려워 하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/feeling5.ogg"},"터치3":{"voiceline":"지, 지휘관! 귀는 조금…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/headtouch.ogg"},"모항귀환":{"voiceline":"Zzzz… 이번에도… 무사히 돌아왔나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/home.ogg"},"hp 경고":{"voiceline":"나는… 여기서 물러서지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/hp_warning.ogg"},"로그인":{"voiceline":"돌아왔는가. 오래 기다렸다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/login.ogg"},"실패":{"voiceline":"미안하다. 모두의 발목을 잡았군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/lose.ogg"},"우편":{"voiceline":"편지에는 먼 곳에서 온 생각이 담겨있지. 절대 얕봐선 안 돼…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307080/mail.ogg"},"임무":{"voiceline":"임무… 제때 끝낼 수 있을까?","voicelink":"ht