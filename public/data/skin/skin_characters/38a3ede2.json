l},"의뢰 완료":{"voiceline":"푸~! 지휘관, 의뢰팀이 돌아왔어! 흠, 역시 튜바의 효과는 끝내준다니까~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301013/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"만약 내가 언젠가 정말로 스테이지에 오르면… 지휘관, 보러와 줄래? 아니면 아예 지휘관이 내 연주를 지휘해주는 것도 좋겠네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301013/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 출격 전의 응원곡, 도움됐어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301013/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 아침을 깨우는 행진곡 독주, 시작할게~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301013/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 내 연주를 듣고 싶어? 좋아! 만쥬들, 준비됐어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301013/touch.ogg"},"터치2":{"voiceline":"우왓! ……지휘관, 이거에 부딪혀도 모른다?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301013/touch2.ogg"},"입수시":{"voiceline":"지휘관, 봐봐! 이거, 어때? 나 참, 옷 말고! 이 튜바 말야! 지휘관에게 들려줄까~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301013/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"좋아, 모두를 위한 승리의 행진곡을…… 잠, 잠깐 기다려!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301013/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70096,"상