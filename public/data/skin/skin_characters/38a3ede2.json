[{"클뜯 id":301010,"클뜯 함순이 id":30101,"함순이 이름":"후부키","한글 함순이 + 스킨 이름":"후부키","영문 함순이 + 스킨 이름":"Fubuki","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301010/shipyard.png","설명":"특Ⅰ형 구축함 1번함・후부키","자기소개":{"voiceline":"얏호~! 세계가 놀래킨 구축함 후부키는 바로 날 두고 하는 말이라고! 아하하, 미안 미안, 별로 자랑할 생각은 없었어~ 왜냐면 그렇게 많은 전장에 참가했는데, 성과는 조금 밖에 없거든… 그래도 할 땐 하는 편이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/profile.ogg"},"메인1":{"voiceline":"오늘은 날씨가 좋네~ 지휘관도 그렇게 생각 안해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/main1.ogg"},"메인2":{"voiceline":"이나즈마, 지휘관은 인간적으론 형편없지만, 난 힘이 되줄테니까! 아마도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/main2.ogg"},"메인3":{"voiceline":"지휘관이라면, 나를 100번 칭찬해줘도 좋아! …으음, 100번은 역시 좀 질릴지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/main3.ogg"},"전투개시":{"voiceline":"날씨 좋고~ 간다앗!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/battle.ogg"},"상세확인":{"voiceline":"에헤헤, 지휘관은 외로움을 많이 타나봐~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/detail.ogg"},"드랍 설명":{"voiceline":"특Ⅰ형 구축함 1번함・후부키","voicelink":null},"의뢰 완료":{"voiceline":"어~이, 의뢰팀이 돌아왔다고~ 일어나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/expedition.ogg"},"실망":{"voiceline":"지휘관이라면 알아줄 거라 생각했는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/feeling1.ogg"},"낯섦":{"voiceline":"이거? ‘신장대’ 라는 건데, 뭔가 있어보여서 들고 나왔어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/feeling2.ogg"},"호감":{"voiceline":"동생들은 어떻게 지내고 있을까… 뭐 내 동생이니까, 분명 강하게 살고 있겠지! 응!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 어떤 타입의 여자애가 좋아? 응? 그냥 참고만 하려고 그러지. 아앗! 혹시 이상한 생각 했어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/feeling4.ogg"},"사랑":{"voiceline":"저번 건 참고만 했던 거라고. 뭐, 지금은 어떤 타입의 여자애가 더 좋다고 해도, 나를 ‘앞으로’ 좋아하게 만들면 되지롱~ 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"이렇게 해서, 이렇게…… 어라? 지, 지휘관?! 어서 와~ 아하하하… 지금 아무 것도 안하고 있었다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/home.ogg"},"hp 경고":{"voiceline":"농담할 상황이 아니네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘 컨디션은 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/login.ogg"},"실패":{"voiceline":"아야야…… 지휘관, 빨리 도망치자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/lose.ogg"},"우편":{"voiceline":"우편이네… 앗, 지휘관 앞으로 온 거구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/mail.ogg"},"임무":{"voiceline":"지휘관, 꽤 임무가 쌓여있다고~ 아앗! 농땡이 피웠구나~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/mission.ogg"},"임무완료":{"voiceline":"지휘관, 임무 보수야~ 내가 있으면 보수도 늘어나거나 할지도? 농담이야☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/mission_complete.ogg"},"서약":{"voiceline":"아, ‘앞으로’ 라고 했었는데, 의외로 금방 이렇게 됐네…… 아! 혹시 저번에 어떤 애가 좋냐고 물어봤을 때 거짓말한 거야? 정말이지 안되겠네 지휘관~ 그래도 용서해줄게♪ 에헤헤♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/propose.ogg"},"스킬":{"voiceline":"후후… 특형 구축함의 힘을 보여주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/skill.ogg"},"터치1":{"voiceline":"일 도와주는 거? 맞다! 한가해보이니까 그만 까 먹었네! 데헷☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/touch.ogg"},"터치2":{"voiceline":"꺄악?! 깜짝 놀랐어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/touch2.ogg"},"입수시":{"voiceline":"얏호~ 후부키급의 장녀는 바로 날 두고 하는 말이지! 당신이 지휘관이지? 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/unlock.ogg"},"강화성공":{"voiceline":"우오옷?! 컨디션 최고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"엣헴! 나 굉장하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아야나미'] : 적에게 따끔한 맛을 보여주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301010/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SR","ex_chat_status":0},{"클뜯 id":301011,"클뜯 함순이 id":30101,"함순이 이름":"후부키","한글 함순이 + 스킨 이름":"지각 5분전","영문 함순이 + 스킨 이름":"5 Minutes 