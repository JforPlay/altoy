[{"클뜯 id":202170,"클뜯 함순이 id":20217,"함순이 이름":"자메이카","한글 함순이 + 스킨 이름":"자메이카","영문 함순이 + 스킨 이름":"Jamaica","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202170/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202170/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202170/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202170/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202170/shipyard.png","설명":"피지급 경순양함 - 자메이카 (HMS Jamaica)","자기소개":{"voiceline":"나다…이 자메이카로 인해 메탈 블러드의 바렌츠 해 해전이 실패로 끝나고, 샤른호르스트도 노스케이프 해전에서 침몰의 운명을 맞았지. 텅스텐 작전? 물론 참가했다. 그 후의 내전에도 말이지…… '악' 이 그 발걸음을 멈추지 않는 한, 난 계속 싸운다……그래, 모든 건 '정의' 가 고른 선택지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/profile.ogg"},"메인1":{"voiceline":"보스, 내 <눈> 에 비치는 당신은, 정말로 당신인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/main1.ogg"},"메인2":{"voiceline":"보스, 경주라도 하겠나? 진정한 <뇌전> 을 보여주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/main2.ogg"},"메인3":{"voiceline":"나는 알고 있다. 이 세상의 어딘가가, 어둠의 밤에 감싸여있단 것을……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/main3.ogg"},"전투개시":{"voiceline":"내 마음엔 일말의 거리낌도 없다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/battle.ogg"},"상세확인":{"voiceline":"보스, 왼쪽 눈이 체인에 가려지지 않았나 봐주지 않겠나? 팔의 위치를 조정하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/detail.ogg"},"드랍 설명":{"voiceline":"피지급 경순양함 - 자메이카 (HMS Jamaica)","voicelink":null},"의뢰 완료":{"voiceline":"보스, 의뢰팀이 귀환했다……베란다에서 포즈를 취하지 말라고? 아, 알겠다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/expedition.ogg"},"실망":{"voiceline":"유감이다, 보스. 아무래도 내가 보는 <저 편> 과는 다른 것 같군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/feeling1.ogg"},"낯섦":{"voiceline":"보스, 잡담이라도 하겠나? 서로 <알아갈> 필요가 있어 보인다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/feeling2.ogg"},"호감":{"voiceline":"정의의 시대? 그런 건 원하지 않는다. 빛이 있는 곳엔 그림자도 있으니. 보스, <악>이란 그렇게 간단히 근절할 수 없는 법이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/feeling3.ogg"},"기쁨":{"voiceline":"자신의 정의와 이상에만 눈을 돌리면, 자기 자신을 잃어버리는 <악>의 길에 빠지게 되지. <어둠>으로부터 눈을 떼지 마라…보스, 내가 함께하겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/feeling4.ogg"},"사랑":{"voiceline":"중요한 것은 <정의의 마음>. 이것만 있으면, 아무리 꺾이더라도 우리는 종착점에 다다를 수 있다. 우리들이 <정의> 이므로……보스, 당신은 고독하지 않다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"바다 깊은 곳에서 꿈틀거리는 <악>이 느껴져…보스, 여기서… 얻기 어려운 <안심> 을 만끽하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/home.ogg"},"hp 경고":{"voiceline":"포기하지 않는 자에게만이 승리가 찾아오는 법. 뛰어올라라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/hp_warning.ogg"},"로그인":{"voiceline":"보스, 이 <눈> 이 포착했다……넥타이가 조금 비뚤어져 있군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/login.ogg"},"실패":{"voiceline":"아픔은 두럽지 않지만…아무것도 할 수 없었다는 게……칫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/lose.ogg"},"우편":{"voiceline":"보스, 동지로부터의 편지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/mail.ogg"},"임무":{"voiceline":"보스, 내게 맡길 <임무>는 없는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/mission.ogg"},"임무완료":{"voiceline":"보스, 임무의 보수다. 나? 흠, 난 이 <달성감>을 느긋하게 음미하는 것만으로 만족한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/mission_complete.ogg"},"서약":{"voiceline":"보스, 우리들이 하고 있는 것은 <황야>에 나아갈 길을 열어주는 것이다. 당신과 함께 가는 것이 나의 가장 큰 <행운> 이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/propose.ogg"},"스킬":{"voiceline":"생명의 찬가는… '용기' 의 찬가다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/skill.ogg"},"터치1":{"voiceline":"……보스, 너무 만지지 마라. 집중할 때 누가 만지면 놀라버리니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/touch.ogg"},"터치2":{"voiceline":"……보스, 자, 장소를 가리는 편이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/touch2.ogg"},"입수시":{"voiceline":"큭…또 눈이 쑤시는군…네가 보스인가? 난 자메이카다. 모든 것은 <정의> 의 선택을 위하여……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/unlock.ogg"},"강화성공":{"voiceline":"부족해…이 힘은, 아직…….!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/upgrade.ogg"},"vote":null,"승리":{"voiceline":"너희를 섬멸하는 것이야말로 <정의> 다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['찰스 오스본'] : 동지여, 함께 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/couple_encourage1.ogg"},{"voiceline":"['셰필드'] : 셰피, 너도 정의의 마음에 눈을 떴나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202170/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":nul