[{"클뜯 id":705050,"클뜯 함순이 id":70505,"함순이 이름":"소비에츠카야 러시아","한글 함순이 + 스킨 이름":"소비에츠카야 러시아","영문 함순이 + 스킨 이름":"Sovetskaya Rossiya","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705050/shipyard.png","설명":"소련급 전함—소비에츠카야 러시아 ","자기소개":{"voiceline":"23형 전함 소비에츠카야 러시아다. 대전 중 전략적인 목표를 이루기 위해 건조 계획을 세웠지만, 많은 이유 때문에 실행하지 못했지. 하지만 이 함대에서는 나의 진정한 가치를 증명하고 성과를 올릴 수 있을 것 같군. 기대된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/profile.ogg"},"메인1":{"voiceline":"보고서에 문제가 있나? 음, 초보적인 실수였군… 바로 보충하지. … 남들에게는 이야기 하지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/main1.ogg"},"메인2":{"voiceline":"더 넓은 시선으로 지휘하기를 바란다. 네가 어깨에 짊어진 것은 절대 너 혼자만의 것이 아니라는 것을 기억하도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/main2.ogg"},"메인3":{"voiceline":"장비 점검을 하던 중 나사가 몇개 나왔는데… 음, 자원이 늘어났다고 좋아해도 되는 것인가…? 역시 안 되겠지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/main3.ogg"},"전투개시":{"voiceline":"포격 개시! 단숨에 적을 제압하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/battle.ogg"},"상세확인":{"voiceline":"지휘관 동지인가… 미안하다. 방이 조금 난잡하군. 하지만 목표 달성을 위한 어쩔 수 없는 희생이었다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/detail.ogg"},"드랍 설명":{"voiceline":"소련급 전함—소비에츠카야 러시아","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰인가. 함대 운영에 있어 후방 지원은 확실히 할 수 있겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/expedition.ogg"},"실망":{"voiceline":"이런 소극적인 태도는 좋지 않다. 강제로 교정해 주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/feeling1.ogg"},"낯섦":{"voiceline":"너의 함대는 반석처럼… 음, 비유일 뿐이다. 다시 말하면 함대가 단결할 수 있기를 바란다. 우리 노스 유니온처럼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/feeling2.ogg"},"호감":{"voiceline":"지휘관 동지, 왜 그러나? 노스 유니온의 일원이 아닌 개인으로 나를 더 알고 싶은 것인가? 흠, 주관적인 선택은 싫어하지 않는다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/feeling3.ogg"},"기쁨":{"voiceline":"음, 재주가 좋군… 지휘관 동지, 음식을 준비해줘서 고맙다. 하지만 이런 전통적인 사교 의례가 아니라 더욱 더 원시적인 욕구에 대한 공세를 펴는 것은 아닌가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/feeling4.ogg"},"사랑":{"voiceline":"잘 했다…! 하지만 노스 유니온의 긍지를 걸고 지휘관 동지의 공세에 굴복할 수는 없지…! 자, 지휘관 동지. 이번에는 내 사랑의 공세를 그 몸으로 확실히 받아내도록! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했다. 영광스러운 승리인지, 패배를 향한 발걸음인지 한번 들어보도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/home.ogg"},"hp 경고":{"voiceline":"치명적인 피해는 아니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 동지, 오늘은 조금 늦었다. 근로 정신을 잊어서는 안 된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/login.ogg"},"실패":{"voiceline":"치욕이군…! 품질 문제가 이런 곳에서 일어나다니…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/lose.ogg"},"우편":{"voiceline":"편지가 도착했다. 지휘관 동지, 다음 편지가 오기 전에 빨리 확인하도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/mail.ogg"},"임무":{"voiceline":"임무가 도착했다. 사무적인 일은 나에게 넘기도록. 너는 지휘관의 일에 집중하면 된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/mission.ogg"},"임무완료":{"voiceline":"음, 보상 리스트에 문제가…? 전체적으로 문제는 없어야 할텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/mission_complete.ogg"},"서약":{"voiceline":"이 삶이 계속되는 동안 나의 사명을 다 할 것이다. 이 함대의 일원으로서, 그리고 너와 인연을 맺은 존재로서—— 이것은 이성적인 사고방식이 아닌, 주관적인 생각에서 도출한 결론이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/propose.ogg"},"스킬":{"voiceline":"전부 날려주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/skill.ogg"},"터치1":{"voiceline":"더 깊게 알고 싶나? 좋다. 그렇다면 매일 손 잡는 습관부터 시작하도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/touch.ogg"},"터치2":{"voiceline":"신사적인 행위라고 할 수 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/touch2.ogg"},"입수시":{"voiceline":"나는 「소비에츠카야 러시아」. 노스 유니온의 히든카드, 최강의 전함이다. 네 앞길과 혁명을 가로막는 장애물을 제거해 주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/unlock.ogg"},"강화성공":{"voiceline":"굉장히 이상적인 강화였다. 다음 번에도 부탁하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"침몰 확인. 너희는 노스 유니온을, 정의의 해방을 막을 수 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"항구는 물건이 많은 곳이지.그러니 나의 임무는 지휘관 동지의 정신 생활을 풍성하게 하는 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관 동지, 먹어라. 별 것 아니다. 내가 너에게 주는 지원 보급이라고 생각해도 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관 동지, 악수하자. 그래. 오늘도 같이 힘내자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/touch_ex.ogg"},"터치2_ex":{"voiceline":"아이리스 리브레의 말로 이야기 하면, étiquette이 아니라는 것인가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['넵튠', '모나크', '이부키', '이즈모', '론', '생 루이', '시애틀', '조지아', '키타카제', '아즈마', '프리드리히 데어 그로세', '가스코뉴'] : 생각에는 의미가 없다. 너희의 힘을 보여라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/couple_encourage1.ogg"},{"voiceline":"[900217] : 키로프, 뒤를 부탁한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/couple_encourage2.ogg"}],"메인4":{"voiceline":"너무 보수적인 전술이다! 침몰하지 않는 한 계속 싸울 수 있다——복구, 반성, 강화, 개선—— 이것이 바로 가장 합리적인 전투 사이클이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/main4.ogg"},"메인1_ex":{"voiceline":"최선을 다해서 전투를 하면 된다…인가. 합리적인 선택이군. 하지만… 나의 사무 능력을 너무 저평가 하는 것 아닌가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705050/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"nil","voicelink":null},"메인3_ex":{"voiceline":"nil","voicelink":null},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":705051,"클뜯 함순이 id":70505,"함순이 이름":"소비에츠카야 러시아","한글 함순이 + 스킨 이름":"게으른 감시자","영문 함순이 + 스킨 이름":"The Lackadaisical Lookout","스킨 타입":"Special Exercise","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705051/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705051/painti