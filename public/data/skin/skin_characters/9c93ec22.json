[{"클뜯 id":9703020,"클뜯 함순이 id":970302,"함순이 이름":"알제리·META","한글 함순이 + 스킨 이름":"알제리·META","영문 함순이 + 스킨 이름":"Algérie META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703020/shipyard.png","설명":"당신이 지휘관이겠네. 나는 중순양함 알제리야. 그나저나 여기서 어떤 즐거움을 맛볼 수 있나? 내게 실망시키지 마~ 후후훗.","자기소개":{"voiceline":"중순양함 알제리, 즐기기 위해 살아가는 존재야. 뭘 즐기냐고? 후후훗~ 말하자면… '모든 것'이 즐길 거리랄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/profile.ogg"},"메인1":{"voiceline":"주변 신경 쓰지 않고 자기가 누리는 것에만 신경을 쓰는 것, 사람들은 그걸 이기심이라고 부르지. 후후훗, 그렇게 얻어진 즐거움도 저급하긴 마찬가지야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/main1.ogg"},"메인2":{"voiceline":"난처한 것 같네. 내가 도와줄까? …후후후, 당신도 어려움에 처한 야옹이를 보면 도와주고 싶잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/main2.ogg"},"메인3":{"voiceline":"아픔도 즐거움의 일부지. 다른 사람에게 주는 것인지, 아니면 받는 것인지 상관 없이 말이야. 내 말이 무슨 의미인지 알겠어? 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/main3.ogg"},"전투개시":{"voiceline":"전투, 그 자체가 즐거운 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/battle.ogg"},"상세확인":{"voiceline":"즐거움의 반대말은 괴로움이 아니라 허무함이야. 그·러·니·까, 어떻게든 이 지루한 허무의 시간을 채워보자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/detail.ogg"},"드랍 설명":{"voiceline":"알제리호 경순양함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료된 모양이네. 보상이나 확인하러 가볼까? 어쩌면 예상 외의 즐거움이 있을지도 모르고 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/expedition.ogg"},"실망":{"voiceline":"하아~ 사고방식이 낡은 사람이라 진짜 즐거움이 뭔지 이해하지 못하나보네. 안타까워….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/feeling1.ogg"},"낯섦":{"voiceline":"전투가 즐거운 건 적을 쓰러뜨릴 때의 성취감뿐만 아니라, 전투 그 자체가 즐거워서야. 느긋하게 고통을 주 던지, 속전속결이던지, 항상 그때그때 즐기고 싶은 방식으로 정하곤 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/feeling2.ogg"},"호감":{"voiceline":"악마의 고혹'…… 뭐, 그런 건 어디까지나 자신의 이기적인 변명에 지나지 않지. 지휘관은 그런 낡아빠진 문구로 자신을 속인 적 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/feeling3.ogg"},"기쁨":{"voiceline":"즐길 줄 모르는 사람도 아니고, 내가 볼 때 지휘관은 사소한 것 때문에 욕구를 솔직하게 개방하지 못하고 있어. 그래, 내쪽으로 와…. 내가 사람의 본성이란 어떤 것인지 알려줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/feeling4.ogg"},"사랑":{"voiceline":"훌륭한 영웅이신 지휘관은 사악한 악마와 함께할 수 없겠지. 뭐 그래도 지휘관만 괜찮다면 언제든 내게 어리광 부려도 괜찮아. 찰나의 즐거움을 추구하는 것뿐, 그 누구도 비난할 권리는 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"그 상태를 보니… 방금 전투가 즐겁지 못한 것 같네. 적이 너무 약했던 걸까? 아니면 작전이 너무 순조로워서?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/home.ogg"},"hp 경고":{"voiceline":"그래! 이거야! 바로 이런 느낌!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/hp_warning.ogg"},"로그인":{"voiceline":"이제서야 온 이유는 뭐야? 쓸데없이 시간을 낭비하고 온 건 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/login.ogg"},"실패":{"voiceline":"달갑지 않고, 원망스럽고…. 그래, 이게 바로 패배의 맛이구나. 꽤 맛있는데~? 후후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/lose.ogg"},"우편":{"voiceline":"새 우편이 왔어. 미지의 무언가에 대한 기대감도 즐거운 것 같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/mail.ogg"},"임무":{"voiceline":"임무? 자신을 기쁘게 할 수 있는 시간을 왜 그런 곳에 쓰는 건데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/mission.ogg"},"임무완료":{"voiceline":"때로는 '임무를 처리한' 것 자체가 나중에 받는 보상보다 흡족할 때가 있지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/mission_complete.ogg"},"서약":{"voiceline":"사실 지휘관, 지금은 즐기고 있기는 커녕 오히려 너무 괴로워…. 서약을 나누는 게 싫다는 게 아니야. 얼마나 더 기다려야 하냐고 물어보고 싶었을 뿐이라구. 후후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/propose.ogg"},"스킬":{"voiceline":"특별히 나한테? 후후훗, 착하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/skill.ogg"},"터치1":{"voiceline":"하고 싶어도 애써 참는 당신의 모습… 참 구미가 당기는 거 알아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/touch.ogg"},"터치2":{"voiceline":"쾌락을 거절하지도 못하면서, 왜 순순히 받아들이지 않은 거야? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관이겠네. 나는 중순양함 알제리야. 그나저나 여기서 어떤 즐거움을 맛볼 수 있으려나? 나를 실망시키지 마~ 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/unlock.ogg"},"강화성공":{"voiceline":"휴우…… 스트레칭했다고 치면 되겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"너무 쉬운 승리는 재미없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"