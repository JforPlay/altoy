[{"클뜯 id":301900,"클뜯 함순이 id":30190,"함순이 이름":"아사나기","한글 함순이 + 스킨 이름":"아사나기","영문 함순이 + 스킨 이름":"Asanagi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301900/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301900/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301900/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301900/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301900/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301900/shipyard.png","설명":"카미카제급 구축함 - 아사나기","자기소개":{"voiceline":"카미카제급 8번함 아사나기다. 이전에는 제15형이라는 험상궂은 이름이었지만, 나중에는 마음이 통한 건지, 내 힘을 인정해 준 건지 지금의 이름을 얻게 되었다. 자, 내 지휘관이라는 점을 항상 명심하거라! 그렇지 않으면 강제로라도 근성을 주입시켜 주는 수밖에!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/profile.ogg"},"메인1":{"voiceline":"뭐라? 날 위해서 차를 내렸다고? 으, 음… 꽤 눈치가 빠른 녀석이군… 칭찬해 주마! 새뱃돈은 기대해도 좋을 게다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/main1.ogg"},"메인2":{"voiceline":"또 틀렸잖은가! 내 철권을…… 아프니까 그만하라고? 화, 확실히 아프게 하는 건 내 본래 의도가 아니니… 그래, 그럼 아프지 않도록 옆구리에 한 방 날려주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/main2.ogg"},"메인3":{"voiceline":"오이테, 내 구두를 어디 숨긴 게냐! 한 짝씩 떨어져 있어서 같이 신발함에 넣었다고? 으, 음… 그게, 그러니까… 미안하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/main3.ogg"},"전투개시":{"voiceline":"얼마나 강한지 어디 한번 보자꾸나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/battle.ogg"},"상세확인":{"voiceline":"흥, 내가 명예로운 카미카제급의 일원이라는 점을 명심해라! 주변 사람처럼 나를 공경하지 않는다면 이 주먹을… 경단을 준비했으니까 같이 먹자…고? 으, 음… 눈치가 빠른 녀석이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/detail.ogg"},"드랍 설명":{"voiceline":"카미카제급 구축함 - 아사나기","voicelink":null},"의뢰 완료":{"voiceline":"지휘관! 의뢰팀이 돌아왔잖은가? 배에 한 방 날리기 전에 어서 다과라도 준비해서 마중 나가거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/expedition.ogg"},"실망":{"voiceline":"음… 너무 실망하게 하지 마라. 내가 할 말은 그것뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/feeling1.ogg"},"낯섦":{"voiceline":"흥. 날 깔보다니… 본래라면 백번 두들겨 패도 이상할 거 없지만… 됐다, 지금은 배에 세게 한 방 먹이는 걸로 봐주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/feeling2.ogg"},"호감":{"voiceline":"업무는 항상 척척 빠르게 진행해야 하는 법이지. 걱정 마라, 언제든 내가 도와주마. 그럼 곤란할 거 없겠지? 물론 평소에도 날 의지해도 좋고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/feeling3.ogg"},"기쁨":{"voiceline":"뭐라고? 지휘관은 이미 다 끝냈다고…?! 아니, 그래… 이건 내가 예전에 도와줘서 빨리 끝난 건… 요행이다! 그래, 이건 요행일 뿐이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/feeling4.ogg"},"사랑":{"voiceline":"으앗?! …아, 아니, 아무것도 아니다. 딱히 네가 계속 신경 쓰여서 손놀림이 소홀해졌다던가, 그런 건 절대로 아니다! 그래! 네 녀석… 이런 식으로 내 주의를 분산시키는 거렷다! 어서 사실대로 자백하거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/feeling5.ogg"},"터치3":{"voiceline":"이, 이런 굴욕이! 그 조막만 한 배에 내 주먹을 꽂아주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관인가? 드디어 돌아온 게로군. 흥, 나를 무시하다니 베짱 한번 두둑…… 못 봤다고? 네 녀석 눈앞에 있었는데 무슨 소리냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/home.ogg"},"hp 경고":{"voiceline":"카, 카미카제급은 이 정도로 약한 소리를 내뱉을 정도로 나약하지 않다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/hp_warning.ogg"},"로그인":{"voiceline":"이제야 왔군, 지휘관! 지금까지 대체 뭘… 아니, 무시하고 어딜 가는 게냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/login.ogg"},"실패":{"voiceline":"으윽! 히, 힘을 좀 뺐을 뿐이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 우편이 온 모양이군. 방치하지 말고 어서 확인하거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/mail.ogg"},"임무":{"voiceline":"음~ 지휘관… 아직 임무가 남아있는 것 같다만? 산처럼 쌓이기 전에 냉큼 처리하지 못해?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/mission.ogg"},"임무완료":{"voiceline":"흠, 이건… 이 임무는 이미 끝났잖은가! 이거 참… 방치해 두는 건 나쁜 버릇이라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/mission_complete.ogg"},"서약":{"voiceline":"후후후… 내게 이걸 건넨다는 건 즉, 계속 날 의지하겠다는 심산이로군? 뭐? 아니라고? 날 의지할 뿐만 아니라, 내게 의지가 되고 싶다고? 누, 누가 네 녀석을! …이걸 받아도 그건 무리다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/propose.ogg"},"스킬":{"voiceline":"제대로 한 방 먹여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/skill.ogg"},"터치1":{"voiceline":"아, 그래 거기… 크으~ 지휘관, 마사지 기술이 꽤나 늘었구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/touch.ogg"},"터치2":{"voiceline":"무슨 짓이냐, 이 멍청이! 뭐가 좋다고 만지는 거냐…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/touch2.ogg"},"입수시":{"voiceline":"이거 정말… 음, 참으로 궁상스러운 애송이로고! 내 이름은 아사나기, 카미카제급 아사나기다! 오늘부터 네 부하로 들어갈 것 같다만…… 귀찮게 굴면 찌른다! 민폐 끼치면 때린다! 지휘관으로서 부적절한 행동을 하나라도 저지르면, 바로 배에 한 방 먹여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/unlock.ogg"},"강화성공":{"voiceline":"뭐, 조금은 강해졌을지도 모르겠군… 아주 조금, 조금 말이다!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301900/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우리 카미카제급을 얕본 벌이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/a