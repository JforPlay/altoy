[{"클뜯 id":9705050,"클뜯 함순이 id":970505,"함순이 이름":"로드니·META","한글 함순이 + 스킨 이름":"로드니·META","영문 함순이 + 스킨 이름":"Rodney META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705050/shipyard.png","설명":"여러 \"로드니\"를 대신해 인사드립니다. …\"저\"는 \"로드니\"라는 개념을 구현화한 것에 지나지 않습니다. 모쪼록 이해해 주시길……","자기소개":{"voiceline":"\"로드니\"는 다른 \"가지\"의 사람으로서의 투영이 고차원적으로 응집된 것입니다. 그리고 \"저\"는…… 글쎄요… \"가지\"에서의 \"로드니\"라는 개념의 구현화로 간주하셔도 문제없습니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/profile.ogg"},"메인1":{"voiceline":"\"강하다\"라는 건…… 네, 동료들의 평가죠. \"로드니\"는 그걸 \"힘에 대한 긍정\"으로 보고 있습니다…만, 별 의미는 없네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/main1.ogg"},"메인2":{"voiceline":"\"시간\"이라는 개념은 \"로드니\"에게 있어서 이해하기 어려운 것이에요. …하지만, 무척 중요…한 거죠? 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/main2.ogg"},"메인3":{"voiceline":"저녁 식사? 저는 딱히 뭐든…… 아니, 역시 로열 네이비 음식 말고 다른 걸로……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/main3.ogg"},"전투개시":{"voiceline":"여기까지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/battle.ogg"},"상세확인":{"voiceline":"내일 계획이요? …생각해 본 적이 없네요. \"로드니\"라는 개념에 시간 지향성은 의미가 없기에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/detail.ogg"},"드랍 설명":{"voiceline":"로드니 호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>'","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었습니다. \"로드니\"의 마중은 필요한가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/expedition.ogg"},"실망":{"voiceline":"영원 속을 걷는 \"저\"의 길은 \"고독\"… 당신은 어떤가요? 같은 길을 걸으시려는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/feeling1.ogg"},"낯섦":{"voiceline":"\"강하다\"…… 저를 묘사하는 데 자주 사용되는 말이죠. 하지만 무슨 의미가 있죠? \"로드니\"라는 개념에 있어서는 모든 것이 비슷합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/feeling2.ogg"},"호감":{"voiceline":"\"강하다\"라는 건 소중한 것을 지킬 수 있는 \"힘\"이라고 해석할 수 있군요. …연약한 존재를 지키기 위해서는 확실히 남다른 \"힘\"이 필요할 테지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/feeling3.ogg"},"기쁨":{"voiceline":"\"소중한 것\"은 \"힘\"으로 지킨다… 그렇다면 \"제\"가 지휘관님을 지키고자 하는 것은 지휘관님이 \"제\"게 있어서 \"소중한 것\"의 개념에 해당한다는 걸까요? \"로드니\"는 그 대답을 찾고 싶습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 지금의 \"로드니\"는…… 소중한 것을 지킬 \"힘\"도, 영원히 계속 지킬 수 있는 \"시간\"도 갖추고 있기에, \"강하다\"고 해석되는… 것이겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/feeling5.ogg"},"터치3":{"voiceline":"음… 응…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/headtouch.ogg"},"모항귀환":{"voiceline":"수고 많으셨습니다, 지휘관님. \"로드니\"는 당신의 노고에 감사하고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/home.ogg"},"hp 경고":{"voiceline":"물질체의 저항이 격렬해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/hp_warning.ogg"},"로그인":{"voiceline":"\"로드니\"는 듣고 있습니다. …물질세계의 일은 제게 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/login.ogg"},"실패":{"voiceline":"\"제\"가 지더라도 \"로드니\"는 지지 않습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/lose.ogg"},"우편":{"voiceline":"지휘관님께 온 우편입니다. 물질세계의 소통 방법은 흥미롭군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/mail.ogg"},"임무":{"voiceline":"임무… 수행을 기다리고 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/mission.ogg"},"임무완료":{"voiceline":"물적 보상… \"로드니\"가 대신 가지고 왔습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/mission_complete.ogg"},"서약":{"voiceline":"지휘관님도 \"저\"를 \"소중한 것\"으로 보고 계신가요? 그렇다면 저 강해지셔야 해요. 왜냐하면… \"로드니\"를 지키려면 보통 힘으로는… 아니, 설령 지더라도 로드니는 계속 지휘관님 곁에 있을 거예요. 네, 시간이 끝날 때까지… 계속.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/propose.ogg"},"스킬":{"voiceline":"말소하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/skill.ogg"},"터치1":{"voiceline":"이건 친근감의 증거…… \"로드니\"의 해석은 옳은가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/touch.ogg"},"터치2":{"voiceline":"\"저\"에게도, 그리고 \"로드니\"에게도 흥미로운 행동이군요. …계속하시죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/touch2.ogg"},"입수시":{"voiceline":"여러 \"로드니\"를 대신해 인사드립니다. …\"저\"는 \"로드니\"라는 개념을 구현화한 것에 지나지 않습니다. 모쪼록 이해해 주시길……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/unlock.ogg"},"강화성공":{"voiceline":"\"저\"를 강하게 만드셨다…고요? \"로드니\"라는 개념으로 의미 있는 행동은 아닐지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705050/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"다 부숴버리고 말았군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLan