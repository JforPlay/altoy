[{"클뜯 id":801080,"클뜯 함순이 id":80108,"함순이 이름":"마이예 브레제","한글 함순이 + 스킨 이름":"마이예 브레제","영문 함순이 + 스킨 이름":"Maillé Brézé","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/801080/shipyard.png","설명":"아이리스 리브레 보클랭급 구축함—마이예 브레제","자기소개":{"voiceline":"난 보클랭급 구축함 마이예 브레제야! 전투 중 호위, 대잠, 순찰, 운송 등 각 방면에서 모두 실력을 뽐냈지!… 마지막엔 문제가 생겨서 결국…… 에구구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/profile.ogg"},"메인1":{"voiceline":"다음 전투를 위해, 단련을 소홀히 해서는 안 되지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/main1.ogg"},"메인2":{"voiceline":"보클랭! 편식하면 안 돼!… 피, 피망…… 그건 나쁜 채소야, 그러니까 버려도 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/main2.ogg"},"메인3":{"voiceline":"다음 연습전에 리슐리외님이 와서 본다고!? 우와아… 이, 이번엔 더 열심히 준비해야겠다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/main3.ogg"},"전투개시":{"voiceline":"모두 돌격——! 정의의 전투다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/battle.ogg"},"상세확인":{"voiceline":"지휘관, 잘 들어! 이번 전투는 리슐리외님도 참여해. 바꿔 말하면, 이건 정의의 전투야! 영광스럽게 여겨야 한다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/detail.ogg"},"드랍 설명":{"voiceline":"아이리스 리브레 보클랭급 구축함—마이예 브레제","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어! 흐흠, 아이리스 리브레 호교 기사단이 출전했으면, 보상이 분명 더 많았을 건데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/expedition.ogg"},"실망":{"voiceline":"같이 목표를 향해 나아가자! 난 완전한 호교 기사가 되고, 지휘관도 완벽한 지휘관이 되어야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/feeling1.ogg"},"낯섦":{"voiceline":"제대로 자격을 갖추기까진 좀 멀었지만, 정의의 전투를 위해서라면, 목숨을 걸어서라도 받아들일 거야! 자, 마음껏 명령을 내려줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/feeling2.ogg"},"호감":{"voiceline":"지휘관, 전투 전에 불안하다면 이렇게 해봐——같이 손을 잡고, \"아이리스 리브레가 보우한다\"… 그래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/feeling3.ogg"},"기쁨":{"voiceline":"아이리스 리브레의 동료들 외에도 모항의 모두를 잘 보호해야 해… 음, 어깨 위의 짐이 유난히 무겁네… 리슐리외님, 지휘관, 난 어떻게 해야 좋을까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/feeling4.ogg"},"사랑":{"voiceline":"지휘관이 모두를 보호하기 위해 노력하는 것처럼, 나도 쉼없이 노력하면, 분명히 지켜낼 수 있을 거야! 리슐리외님도 그렇게 말했어! 좋아, 앞으로 훨씬 더 힘내서 노력하자, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/feeling5.ogg"},"터치3":{"voiceline":"이 머리 장식 괜찮지!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/headtouch.ogg"},"모항귀환":{"voiceline":"출격 수고했어! 그런데, 리슐리외님이었다면, 이정도는 아무 문제 없었을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/home.ogg"},"hp 경고":{"voiceline":"난 지지 않아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/hp_warning.ogg"},"로그인":{"voiceline":"마이예 브레제 착임!… 아! 지휘관, 좋은 아침!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/login.ogg"},"실패":{"voiceline":"거, 겉으로는 굴복했어도, 내 마음만은 절대…! 응? 틀렸나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/lose.ogg"},"우편":{"voiceline":"우편… 이 안에 분명 중요한 내용이 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/mail.ogg"},"임무":{"voiceline":"아직 완료하지 않은 임무가 있다고. 지휘관, 리슐리외님에게 한 소리 듣기 전에 다 끝내자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 지휘관, 보상을 확인할 시간이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 이 반지는 누구에게 주려고…… 나, 나한테!? 거짓말 아니지?ーー(작게) 괜찮긴 하지만, 조금 걱정이 돼, 이렇게 중요한 걸 내가 정말 할 수 있을까…… 우아앙…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/propose.ogg"},"스킬":{"voiceline":"신성한 힘을 느껴봐라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/skill.ogg"},"터치1":{"voiceline":"마이예 브레제는, 완전히 성장한 기사까지는 아직 거리가 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/touch.ogg"},"터치2":{"voiceline":"마이예 브레제의 위풍당당한 모습에 반했어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/touch2.ogg"},"입수시":{"voiceline":"아이리스 리브레 호교 기사단의 구축함, 마이예 브레제야! 거기 평범한 당신, 내가 왔으니 항로 문제는 더 이상 걱정할 필요 없어! …에? 네가 바로 지휘관이야!? 내내내내, 내가 방금 무슨 말을!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/unlock.ogg"},"강화성공":{"voiceline":"또 한 걸음 더 나아갔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"봤어!? 이게 바로 호교 기사단의 힘이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"알제리랑 같이 쇼핑 간다고!?… 부, 부럽거나 질투 같은 건 하지 않거든!…… 나도 같이 데려가줄 수 있어…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801080/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관! 다음 출격은 언제야? 정의의 전투에 사전 준비할 수 있도록, 최대한 빨리 기운을 업시