[{"클뜯 id":199060,"클뜯 함순이 id":19906,"함순이 이름":"캔자스","한글 함순이 + 스킨 이름":"캔자스","영문 함순이 + 스킨 이름":"Kansas","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199060/shipyard.png","설명":"전함 - 캔자스","자기소개":{"voiceline":"유니온의 전함, 캔자스……쿠울……아니, 자고 있지는 않지만, 단지 기운을 내는 것이 서툴러서…괜찮다. 지휘관을 위하여 언제든지 싸울 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/profile.ogg"},"메인1":{"voiceline":"음…특별한 용건이 없다면…경치라도 바라보고… 내친 김에 조금 눈도 붙이고……지휘관, 장소 선택을 부탁한다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/main1.ogg"},"메인2":{"voiceline":"지휘관…얼마 전에 간다고 했던 세미나 말인데…종류가 뭐든…사람의 밀도를 고려하고, 캔자스는 에너지가 불충분하니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/main2.ogg"},"메인3":{"voiceline":"일은 이제 처리완료…응? 너무 빠르다고? …그만큼 풀가동했다는 것…응, 이제 잘 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/main3.ogg"},"전투개시":{"voiceline":"그렇다면, 지금은 지휘관을 위하여 싸운다!…빨리 끝내자…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/battle.ogg"},"상세확인":{"voiceline":"머리카락? 하아암…흐트러져 있지 않다면 손질도 불필요하다. 이대로 내리는 편이…응? 물론…질이 좋은 수면을 취하기 위해서인 게 당연하잖나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/detail.ogg"},"드랍 설명":{"voiceline":"전함-캔자스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰완료인가? 잘됐군. ……돌아올 때까지 대기하고 있으니까……빨리 마중하러 갔다 오면 된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/expedition.ogg"},"실망":{"voiceline":"지휘관…에너지 낭비는…뭐 좋아, 원하는 대로 하면 돼……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 다시 깨우러 온 건가? 응…알겠다. 지휘관을 위하여 언제든지 출격해서……쿠울","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/feeling2.ogg"},"호감":{"voiceline":"지휘관? 이렇게 날씨가 좋은데, 조금만 더 누워있게 해줘…으음…지휘관도 같이 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 당신의 이곳은 조용하군……조금만, 크흠, 체재해도 되겠나?……필요하면 언제든지 각성시켜서……응? 뻔뻔해? ……뭐 그렇다면 그런 걸로…응, 잔다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/feeling4.ogg"},"사랑":{"voiceline":"캔자스를 바라보고 있는 건가?……벌써 상당히 보고 있는데……그런 행동을 하면 안심하고 수면을 취할 수 없다……뭐? 혼자서 조용히 자고 싶은지, 아니면 이대로 방해를 받고 싶은지? 그런 선택을 재촉받으면 곤란하다……지휘관이 있으면 기분좋은 수면이 가능한 것은 확실하니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/feeling5.ogg"},"터치3":{"voiceline":"지휘관, 그 손…아니, 아무것도 아니다. 이대로 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/headtouch.ogg"},"모항귀환":{"voiceline":"수고했다. …그런데 휴식 장소는 어디로 하지? 캔자스 쪽……아니면 지휘관 쪽…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/home.ogg"},"hp 경고":{"voiceline":"하암……에너지가, 못 버텨……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/hp_warning.ogg"},"로그인":{"voiceline":"하암……다시 새로운 하루다. 캔자스, 지휘관을 위하여 언제든 출격하겠……지만, 지금은 조금 눈을 붙여도 될까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/login.ogg"},"실패":{"voiceline":"그런가. 졌는가……함대를 결집시켜 퇴각의 준비를……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/lose.ogg"},"우편":{"voiceline":"메일…지금 확인하겠나…? 결재를 부탁한다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/mail.ogg"},"임무":{"voiceline":"음…임무 할당인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/mission.ogg"},"임무완료":{"voiceline":"임무 완료. ……함께 눈이라도 붙일 텐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 캔자스의 수면 중에 그런 중요한 결정을 하는 것은 바라지 않겠지?……이렇게 보여도, 캔자스는 계속 지휘관을 관찰하고 있다……아아, 지휘관을 위하여 언제든지 싸우겠다고 맹세한 이상, 계속 옆에 있는 것은 당연하다……아, 뭔가……갑자기…졸려온다……어쨌든, 이러면 계속 네 옆에서 잘 수 있어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/propose.ogg"},"스킬":{"voiceline":"각성했다. 덤벼 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/skill.ogg"},"터치1":{"voiceline":"으…음. 지휘관을 위하여 언제든지……하~암……만지는 것 뿐인가……좋을대로 해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/touch.ogg"},"터치2":{"voiceline":"지휘관……캔자스…지금은 일어나 있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/touch2.ogg"},"입수시":{"voiceline":"하암…지휘관인가? 잠시 눈을 붙였을 뿐인데 벌써 도착했다니…크흠. 유니온의 전함 캔자스, 지휘관을 위하여 언제든 출격 가능하다. …그런데 나온 김에 질문하겠다만, 오늘 참가하지 않으면 안되는 임무는 있는가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/unlock.ogg"},"강화성공":{"voiceline":"흠. 이렇게 하면 더 편하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아. 이겼다. …그러면 조금 빠른 귀환을 보고한다. 이 장소는 상당히 사람의 밀도가 높아……멘탈의 상태가 아주 좋다고는 할 수 없……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/win_mvp.ogg"},"전투개시_ex":{"voiceline":"네가 있으면 승리는 더욱 빨라진다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/battle_ex.ogg"},"상세확인_ex":{"voiceline":"사교……? 괜찮아. 캔자스의 이상적인 커뮤니케이션 상대는 지휘관 한 사람 뿐이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"다행이다. 의뢰가 완료되었다……지휘관, 빨리 돌아와줘. 네가 귀환할 때는 절대로 일어나 있도록 노력할게","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/expedition_ex.ogg"},"사랑_ex":{"voiceline":"지휘관은 벌써 수면 상태인가. ……설마 오늘의 캔자스의 노력이 부족했다는 것인가?……가동시간을 좀더 길게 해서, 여러가지를 할 수 있도록 하지 않으면 안되……는가? 아니, 역시 지금은 지휘관의 팔 안에서……잠을……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"하암……이 이상 쓰담쓰담 받으면, 정말 자버릴거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관, 무사귀환해 줘서 다행이다. 자, 머리를 천천히 캔자스의 허벅지에……좋은 기분이지? 이대로 같이 자자…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 또 깨우러 왔나? 알고 있어, 지금……아니……앞으로 5분……흠냐……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/login_ex.ogg"},"실패_ex":{"voiceline":"슬슬 퇴각이다……괜찮아. 안심해","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/lose_ex.ogg"},"우편_ex":{"voiceline":"또 새로운 메일인가……대단한 사교성이군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/mail_ex.ogg"},"임무_ex":{"voiceline":"임무인가…비록 지금 의욕이 안 생겨도……한숨 잔다고 임무가 없어지지는 않아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/mission_ex.ogg"},"임무완료_ex":{"voiceline":"이걸로……지휘관은 캔자스와 같이 안면할 수 있겠군","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"수면을 취하고 싶은 건가? 그러면 가까이 와줘. 캔자스는 벌써……눈꺼풀이 무거워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/touch_ex.ogg"},"터치2_ex":{"voiceline":"으음, 이러면……캔자스가…잠들 수 없게 되어 버려///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":{"voiceline":"성공했는가? 다행이다. 자, 캔자스는 계속 옆에……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/upgrade_ex.ogg"},"승리_ex":{"voiceline":"너를 위해 싸울 때에 한해서, 캔자스의 대기모드는 길게 지속하지","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":{"voiceline":"계속 쉬고 있었던 것은 아니다……지휘관이 보지 않는 곳에서……힘이 다했을 뿐이야. 지금 휴식을 취하고 있는 것은……언제든지 지휘관을 위하여 싸울 수 있도록 하기 위해서다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"쇼핑 리스트……음, 어렵군. 먼저 다음 작전계획을…아니, 역시 다음의…모두 선택을 재촉하는 것 뿐인가. 에너지가 끊길 것 같아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관, 좀 전부터 캔자스를 응시하고 있군……그저 멍하게 있을 뿐인가, 아니면 캔자스와 함께 쉬고 싶은 건가…아니…이 상황은 캔자스가 먼저 자는 편이 좋은 건가……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/main6_ex.ogg"},"메인7_ex":{"voiceline":"처리가 끝난 서류는 나중에 정리하자. 지휘관, 같이 눈이라도 붙일래?…기운이 나면 다시 도울게…그렇게 시간은 걸리지 않으니까","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/main7_ex.ogg"},"메인8_ex":{"voiceline":"지휘관, 오늘 어딘가에 같이 외출하지 않겠어? 지휘관이 있으면 캔자스는 기운이 나니까, 지휘관과 오래 있을 수 있어……물론 여기에서 좀더 눈을 붙이는 것도 좋지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199060/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":199061,"클뜯 함순이 id":19906,"함순이 이름":"캔자스","한글 함순이 + 스킨 이름":"미드나이트 레저","영문 함순이 + 스킨 이름":"Late-Night Leisure","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199061/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199061/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199061/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199061/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199061/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199061/shipyard.png","설명":"하아…… 이 정도면 되겠지. 오늘 밤 이곳에 있는 건 우리 둘뿐…… 지휘관이 어떤 요청을 하더라도, 지금까지 모은 에너지로 끝까지 함께해 줄게.","자기소개":null,"메인1":{"voiceline":"지휘관, 어깨에 기대게 해줘…… 에너지가 부족한 게 아니라, 그러니까…… 응. 이러고 있는 게… 좋으니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/main1.ogg"},"메인2":{"voiceline":"에너지를 사소한데 낭비해선 안 돼. 물론 내 「풀 파워」는…… 네가 원할 때까지 아껴둘게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/main2.ogg"},"메인3":{"voiceline":"오늘 밤의 캔자스는 지휘관이 시키는 대로야…… 뭘 할지, 어떻게 할지는 네가 정해. 절대… 먼저 잠들지는 않을 테니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"하아…… 이 정도면 되겠지. 오늘 밤 이곳에 있는 건 우리 둘뿐…… 지휘관이 어떤 요청을 하더라도, 지금까지 모은 에너지로 끝까지 함께해 줄게.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관이 내 곁에 있어…… 해가 뜰 때까지 잠들고 싶지만, 그렇다고 지휘관에게서 시선을 떼고 싶지도 않아…… 지휘관도 그렇다고? 후훗, 이런 낭만적인 밤에 자기모순에 빠지는 건, 서로 마찬가지네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/feeling5.ogg"},"터치3":{"voiceline":"이대로…… 조금만 더 있어 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/headtouch.ogg"},"모항귀환":{"voiceline":"하암…… 수고했어. 마침 맞이할 에너지를 다 모은 참이야. …같이 뭐라도 마실까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"음…… 지휘관이 나타나니까, 의식이 확 맑아졌어. 이런 신기한 기분을 느끼게 해주는 건, 오로지 지휘관뿐이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"지휘관, 임무가 전달됐어. ……빨리 끝낸 만큼, 여기서 오랫동안 느긋하게 보낼 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/mission.ogg"},"임무완료":{"voiceline":"임무 완료. ……우리 둘만의 밤을 안심하고 즐기자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"응? 주문하려고? 아니면…… 나랑 스킨십을 하고 싶은 것뿐? 어느 쪽이든 상관없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/touch.ogg"},"터치2":{"voiceline":"으음…… 슬슬 「풀 파워」를 발휘할 때인가…? 남은 에너지로 지휘관을 만족시켜 줄 수 있으면 좋겠는데……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/touch2.ogg"},"입수시":{"voiceline":"하아…… 이 정도면 되겠지. 오늘 밤 이곳에 있는 건 우리 둘뿐…… 지휘관이 어떤 요청을 하더라도, 지금까지 모은 에너지로 끝까지 함께해 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/unlock.ogg"},"강화성공":{"voiceline":"후우. 오늘 밤 「서비스」는 좀 더 길게 이어지겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/upgrade.ogg"},"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"…응? 추천 메뉴가 뭐냐고? 그건…… 어차피 내가 만드는 거니까, 그냥…… 「캔자스」를 주문해 보는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199061/main4.ogg"},"메인1_ex"