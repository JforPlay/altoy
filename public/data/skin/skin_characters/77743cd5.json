ne/main/audio/voiceline/100021/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 안심하고 내 뒤에 숨어, 푸링! 오늘은 무적의 부린 전대가 지휘관을 위해 정의를 집행할 거야, 푸링!","voicelink":null},"의뢰 완료":{"voiceline":"푸링! 의뢰팀이 돌아왔어, 푸링! 장부에 대한 새로운 단서라도 가지고 왔을까, 푸링?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관, 이건 정의를 위한 것만은 아니야, 푸링… 오히려… 아카시에게 괴롭힘 당하는 지휘관을 보고 싶지 않아서 그런 거야, 푸링! 앞으로 지휘관의 지갑은 이 부린이 지켜줄게, 푸링! 약속할게, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/feeling5.ogg"},"터치3":{"voiceline":"후훗, 마음껏 칭찬해도 돼, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/headtouch.ogg"},"모항귀환":{"voiceline":"푸링? 지휘관, 너무 멀리 가지는 마! 나쁜 사람한테 잡혀가면 큰일이니까, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"쉿…… 오늘은 몰래 아카시의 창고에 숨어들… 푸링?! 벌써 들켰네, 푸링! 이렇게 된 이상 어쩔 수 없지! 「슈퍼 냥냥 1호」 출동!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/login.ogg"},"실패":null,"우편":{"voiceline":"지휘관! 수상한 우편을 찾았어, 푸링! …푸링? 지휘관 앞으로 온 우편이었네, 푸링…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/mail.ogg"},"임무":{"voiceline":"푸링? 지휘관, 아직 안 끝낸 임무가 있는 모양이야, 푸링. 이건 부린한테 맡겨줘, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/mission.ogg"},"임무완료":{"voiceline":"푸링! 푸링! 지휘관, 보상이야! 다이아가 있을지도 몰라, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"푸링? 특별 작전 중이니까, 조용히 해, 푸링.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/touch.ogg"},"터치2":{"voiceline":"꺅! 지휘관! 그러면 위험해, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/touch2.ogg"},"입수시":{"voiceline":"지휘관, 안심하고 내 뒤에 숨어, 푸링! 오늘은 무적의 부린 전대가 지휘관을 위해 정의를 집행할 거야, 푸링!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/100021/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"기타","상점 id":0,"상점 카테고리 id":9999,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"UNIV (bulin)","레어도":"UR","ex_chat_status":0}]