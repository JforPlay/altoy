[{"클뜯 id":101080,"클뜯 함순이 id":10108,"함순이 이름":"모리","한글 함순이 + 스킨 이름":"모리","영문 함순이 + 스킨 이름":"Maury","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101080/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101080/shipyard.png","설명":"그리들리급 구축함·모리 ( DD-401)\n<color=#ffde38>획득 후 건조 개방</color>","자기소개":{"voiceline":"그리들리급 구축함 팀의 4번함 모리입니다. 막내지만 단거리라면 이글 유니온에서 가장 빠르다고 자신할 수 있어요. 너무 금방 배고파 하는 거 아니냐고요? 적게, 자주 먹어야 오래산다잖아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/profile.ogg"},"메인1":{"voiceline":"지휘관님. 운동하실 생각 없으신가요? 너무 앉아 있기만 하면 몸에 안 좋다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/main1.ogg"},"메인2":{"voiceline":"아아~ 또 웨이크섬에서 장거리 달리기라도 하는 건 줄 알았어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/main2.ogg"},"메인3":{"voiceline":"제, 제 배에서 나는 소리가 아니라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/main3.ogg"},"전투개시":{"voiceline":"속전속결로 갈게요! 안 그러면 또 금방 배고파지니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/battle.ogg"},"상세확인":{"voiceline":"저기… 왜 항상 준비 운동할 때… 여자애가 땀 흘리는 모습에 관심을 보이시는 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/detail.ogg"},"드랍 설명":{"voiceline":"그리들리급 구축함 모리(DD-401)\n<color=#ffde38>도감 보상 획득 시 일반 건조 오픈</color>","voicelink":null},"의뢰 완료":{"voiceline":"몸을 좀 움직이고 싶네요…… 지휘관님, 마침 의뢰가 완료됐어요. 다음은 저한테 맡겨주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/expedition.ogg"},"실망":{"voiceline":"죄송합니다. 연습이 있어서요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님. 언제나 앉아 있기만 하시는데 괜찮으신가요? 밖에서 운동이라도 하시는 게 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 빨리 달릴 수 있는 비법을 알려드릴까요? 꽤 심오하답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 곁에 계시면 오래 달릴 수 있고, 컨디션도 좋아져요. 신기해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 같이 운동해요. 제가 평소에 보는 풍경을 지휘관님께도 보여드리고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/feeling5.ogg"},"터치3":{"voiceline":"음…? 이건… 저를 격려해주시려는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/headtouch.ogg"},"모항귀환":{"voiceline":"휴식은 더 좋은 스프린트를 위한 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/home.ogg"},"hp 경고":{"voiceline":"흠! 아무래도 속도를 더 올려야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 같이 준비 운동하실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/login.ogg"},"실패":{"voiceline":"……빨리 돌아가서, 다들 걱정 안하게 해야지…(시무룩……)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/lose.ogg"},"우편":{"voiceline":"새로운 우편이에요. …뒤풀이 관련 인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/mail.ogg"},"임무":{"voiceline":"지휘관님! 아직 완료하지 않은 미션이 있어요. 라스트스퍼트, 힘내죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/mission.ogg"},"임무완료":{"voiceline":"하아~ 지쳤어요… 보너스로 온 산소 드링크… 제 몫도 부탁드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/mission_complete.ogg"},"서약":{"voiceline":"아무리 빨리 달려도 지휘관님의 손에서는 벗어날 수 없네요…… 뭐, 저도 도망치진 않을 거지만요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/propose.ogg"},"스킬":{"voiceline":"더 빠르게…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/skill.ogg"},"터치1":{"voiceline":"몸을 풀어주려고 그러시는 건가요? …감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/touch.ogg"},"터치2":{"voiceline":"!! …아무리 마사지라도 적당히 좀 하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/touch2.ogg"},"입수시":{"voiceline":"모리라고 합니다. 최고 속도 42.8노트의, 유니온 최속 기록 보유자예요. 하지만 마라톤은 좀 무리일지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/unlock.ogg"},"강화성공":{"voiceline":"아직이야… 더 빨리…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"내 속도를 따라 잡을 수 있을 리가 없지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0},{"클뜯 id":101089,"클뜯 함순이 id":10108,"함순이 이름":"모리","한글 함순이 + 스킨 이름":"모리·改","영문 함순이 + 스킨 이름":"Maury (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101089/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101089/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101089/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101089/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101089/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101089/shipyard.png","설명":"그리들리급 구축함팀 4번함 모리, 새 장비를 갖추고 방금 돌아왔어요! 지금이라면 전보다 더 빨리 달릴 수 있을 것 같아요! 지휘관님, 저기… 테스트하러 같이 가주실 수 있나요?","자기소개":null,"메인1":{"voiceline":"사실 아까부터 지휘관님께서 저를 찾고 계시다는 걸 느끼고 있었어요. ……이것이 바로 「스포츠 선수의 감」이라는 거겠죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/main1.ogg"},"메인2":{"voiceline":"일하시느라 수고하셨어요. 긴장을 풀 겸 같이 조깅이라도 어떠세요? 도중에 힘드시면 제가 업어 드릴 테니까, 걱정할 필요 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/main2.ogg"},"메인3":{"voiceline":"운동하기 좋은 날씨네요! 지휘관님, 저랑……(꼬르륵…) 음…… 가, 같이 에너지 보충이나 하러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관님과 안고 싶은 마음은 굴뚝같지만, 운동을 하고 온 직후라서 샤워를 해야 해요…… 괜찮다고 하셔도 저기… 제가 부끄러워서요…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/detail.ogg"},"드랍 설명":{"voiceline":"그리들리급 구축함팀 4번함 모리, 새 장비를 갖추고 방금 돌아왔어요! 지금이라면 전보다 더 빨리 달릴 수 있을 것 같아요! 지휘관님, 저기… 테스트하러 같이 가주실 수 있나요?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 나갔던 동료들이 돌아왔어요. 먼저 마중 나갈게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님, 정말 멋진 경치가 보이는 코스를 찾았어요! 지휘관님만 괜찮으시면, 둘이서 출발선에서 출발해서, 골인 지점까지 달리면서…… 끝까지 함께… 하고 싶어요…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/feeling5.ogg"},"터치3":{"voiceline":"에헤헤…… 아직 더 빨리 달릴 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 수고 많으셨어요! 멀리서 오시느라 힘드셨죠? 지금부터 마사지해 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"한계 속도로 지휘관님 곁에…! 휴우. …이 정도는 별거 아니에요. 아무리 멀리 계셔도 지휘관님께서 부르시면 바로 달려갈게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"지휘관님! 미완료된 임무를 확인하는 걸 잊지 마세요. 막판 스퍼트는 저도 함께 열심히 할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/mission.ogg"},"임무완료":{"voiceline":"서류 작업이 드디어 끝났네요. 기분 전환 겸 같이 운동이라도 하고 올까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님이 해주시는 마사지, 기분 좋아요…… 다음은 제가 해 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/touch.ogg"},"터치2":{"voiceline":"여기를 마사지하시려고요?! ……아, 아니, 아무것도 아니에요……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/touch2.ogg"},"입수시":{"voiceline":"그리들리급 구축함팀 4번함 모리, 새 장비를 갖추고 방금 돌아왔어요! 지금이라면 전보다 더 빨리 달릴 수 있을 것 같아요! 지휘관님, 저기… 테스트하러 같이 가주실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101089/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":