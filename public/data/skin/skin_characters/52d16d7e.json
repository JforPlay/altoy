[{"클뜯 id":302120,"클뜯 함순이 id":30212,"함순이 이름":"센다이","한글 함순이 + 스킨 이름":"센다이","영문 함순이 + 스킨 이름":"Sendai","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302120/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302120/shipyard.png","설명":"센다이급 경순양함 1번함 – 센다이","자기소개":{"voiceline":"센다이급의 1번함, 센다이다. 동생처럼 대단한 함력 따윈 없지만, 3수전의 기함을 맡아 많은 전투에 참가했지. 최후를 맞은 건 부건빌이였지만, 뭐 전사로서 후회는 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/profile.ogg"},"메인1":{"voiceline":"꿈은 정의를……뭐, 지금 건 농담으로 받아들여 줘","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/main1.ogg"},"메인2":{"voiceline":"내가 가진 건 이상과 주먹뿐이다. 그럼에도 계속 앞으로 나아가는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/main2.ogg"},"메인3":{"voiceline":"지휘관은 가장 큰 적이 누구라고 생각하나? 세이렌인가? 난 자신의 마음이라고 생각해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/main3.ogg"},"전투개시":{"voiceline":"이 내가 상대해주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/battle.ogg"},"상세확인":{"voiceline":"붕대? 이건 상처 같은 게 아니라, 주먹에 감는 건데……내게 상처를 입힐 수 있는 녀석들은 그렇게 많이 없거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/detail.ogg"},"드랍 설명":{"voiceline":"센다이급 경순양함 1번함 - 센다이","voicelink":null},"의뢰 완료":{"voiceline":"어이, 의뢰가 완료됐다. 설마 그 아이들을 기다리게 할 셈은 아니겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/expedition.ogg"},"실망":{"voiceline":"여긴 이제 작별해야 하나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/feeling1.ogg"},"낯섦":{"voiceline":"사람과는 그다지 깊이 관계를 갖지 않는 편이라, 그냥 내버려뒀으면 좋겠다만…뭐 안심해라. 네 부하가 된 이상 일은 제대로 할 테니 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/feeling2.ogg"},"호감":{"voiceline":"부정한 것은 주먹으로 바로잡아주지 않으면 성이 안 차, 이게 바로 내가 사는 방식이다. 그러니 남에게 폐를 끼치지 않도록 굳이 남들과 엮이지 않으려 하는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/feeling3.ogg"},"기쁨":{"voiceline":"줄곧 여기에 예전부터 있었던 것 같은… 뭐랄까, 내 입으로 말하는 것도 좀 그렇지만, 꽤 오래됐구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/feeling4.ogg"},"사랑":{"voiceline":"너란 녀석은 꽤 굉장하구나. 내가 하고 싶은 걸 하게 해주고, 나보다도 한 수 위란 말이지…너와 함께 있으면 시간이 어떻게 지나가는지도 모르겠어…네가 지금의 자신을 잊지 않는 한, 나 센다이는 바다의 끝까지 함께 해주겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"다음 출격은 언제야? 바꿀 붕대는 잔뜩 가져왔다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"워밍업이 끝났다. 출격할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/login.ogg"},"실패":{"voiceline":"아파라……후후후…역시 이거야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/lose.ogg"},"우편":{"voiceline":"자, 편지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/mail.ogg"},"임무":{"voiceline":"임무……좋아한다. 이런 거 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/mission.ogg"},"임무완료":{"voiceline":"지휘관, 보수 안 받아도 괜찮나? 나는 딱히 상관없지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/mission_complete.ogg"},"서약":{"voiceline":"지휘관… 이걸 받기 전까지는 네가 혹시 초심을 잃으면 내가 떠나면 그만이었지만, 이제 이걸 받은 이상… 사랑과 분노의 주먹은 아프다고, 우후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/propose.ogg"},"스킬":{"voiceline":"부서져라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/skill.ogg"},"터치1":{"voiceline":"지휘관, 무심코 가까이 오면 다쳐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/touch.ogg"},"터치2":{"voiceline":"지휘관, 사는 게 지겨워졌나? 두들겨 패줘 머리를 식혀줄까? 응?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/touch2.ogg"},"입수시":{"voiceline":"지휘관인가? 그런 거, 내겐 필요 없지만……뭐 이렇게 만난 것도 인연이겠지. 잠시 실례하도록 하마. 나는 센다이라 한다. 잊지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/unlock.ogg"},"강화성공":{"voiceline":"더욱 강해져서, 그러고 나서…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"훗, 붕대를 바꿀 수고를 덜었군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['카코'] : 카고, 내 곁에서 떨어지지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/couple_encourage1.ogg"},{"voiceline":"['진츠'] : 진츠, 나는 뭘 하면 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302120/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_status":0},{"클뜯 id":302129,"클뜯 함순이 id":30212,"함순이 이름":"센다이","한글 함순이 + 스킨 이름":"센다이·改","영문 함순이 + 스킨 이름":"Sendai (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302129/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302129/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302129/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302129/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302129/shipyard.png","설명":"흥, 보아하니 이 붕대는 이제 필요 없게 된 것 같군. 지휘관, 내가 어디까지 강해졌는지…시험으로 한 대 맞아보지 않겠나? ","자기소개":null,"메인1":{"voiceline":"나는 뭐든지 힘으로 밀어붙일 줄밖에 모르거든. 그래서 가끔은 너와 진츠가 부러워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/main1.ogg"},"메인2":{"voiceline":"진츠처럼 논리정연하게 말하려 해도 대개 마지막에는 주먹을 휘두르게 돼. 왜 이렇게 되는 걸까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/main2.ogg"},"메인3":{"voiceline":"수고하는 건 딱히 상관없지만, 지금의 자신을 언젠가 잊어버리는 게 두려워서 말야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/main3.ogg"},"전투개시":{"voiceline":"미안! 여기가 바로 너희가 죽을 장소야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/battle.ogg"},"상세확인":{"voiceline":"응? 아아, 지금 출격할 때의 포즈를 연습하고 있었다. 기합이란 것도 중요하다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/detail.ogg"},"드랍 설명":{"voiceline":"센다이级轻巡洋舰1号舰——센다이","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"수고했다. 단 거라도 좀 먹겠나? 나눠줄게. 뭐 내가 좋아하는 것들뿐이지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/home.ogg"},"hp 경고":{"voiceline":"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/hp_warning.ogg"},"로그인":{"voiceline":"돌아왔나? 집무에 집중해라. 출격할 때가 되면 불러줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"지휘관, 똑바로 서라. 우리 사이니, 이 한 방은 80% 파워로 때려주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/touch2.ogg"},"입수시":{"voiceline":"흥, 보아하니 이 붕대는 이제 필요 없게 된 것 같군. 지휘관, 내가 어디까지 강해졌는지…시험으로 한 대 맞아보지 않겠나? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"붕대, 붕대……아, 이제 필요 없나…깜빡 잊고 있었군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302129/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"개조","상점 id":0,"상점 카테고리 id":9997,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_status":0}]