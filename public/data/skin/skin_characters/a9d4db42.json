[{"클뜯 id":204040,"클뜯 함순이 id":20404,"함순이 이름":"꼬마 리나운","한글 함순이 + 스킨 이름":"꼬마 리나운","영문 함순이 + 스킨 이름":"Little Renown","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/204040/shipyard.png","설명":"리나운급 순양전함—리나운 ","자기소개":{"voiceline":"여기에 오기 전 고반에서 열심히 훈련했습니다. 전장에 일찍 합류하게 된 것은 제 실력에 대한 믿음이 있었기 때문이에요. 절대로 실망하게 하지 않을게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/profile.ogg"},"메인1":{"voiceline":"제가 있는 한 아무도 지휘관님을 해치지 못해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/main1.ogg"},"메인2":{"voiceline":"열심히 하는 꼬마 리나운이 귀엽다고요? … 음음, 꼬마 리나운에게 알려줄게요… 에에?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/main2.ogg"},"메인3":{"voiceline":"지휘관님 뿐 아니라 모항의 모두는 정말 대단해요… 저도 열심히 해야겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/main3.ogg"},"전투개시":{"voiceline":"로열 네이비, 서치 앤 디스트로이!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 나이트에 관한 책을 찾았는데 이해하기 어려운 내용이 너무 많아요. 가르쳐주실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/detail.ogg"},"드랍 설명":{"voiceline":"리나운급 순양전함—리나운","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰조가 10분 뒤에 돌아와요. 그러니… 에, 제 기억이 틀린건가요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/expedition.ogg"},"실망":{"voiceline":"지휘관님, 힘내세요! 무슨 일이 있어도 지휘관님을 포기하지 않을게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/feeling1.ogg"},"낯섦":{"voiceline":"이론과 실전 모두 다 중요해요. 훌륭한 로열 나이트가 되기 위해서 항상 열심히 훈련하고 있어요. 지휘관님도 함께 하실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/feeling2.ogg"},"호감":{"voiceline":"쉬는 것도 일 처럼 중요해요. 로열 나이트가 보기에도 지휘관님은 너무 무리하고 계세요. 이 일이 끝나면 얼른 가서 쉬셔야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 왜 책에 나오는 나이트들은 전부 충성을 맹세한 왕을 떠나는 건가요? 저는 그들과 달라요. 한번 한 맹세는 죽어도 후회하지 않을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 계속 지휘관님의 함대에 머물러도 괜찮은가요? 지휘관님의 곁에 있으면 계속 강해질 수 있을 것 같아요. 그리고 지휘관님이 정말 좋아요! …… 에에? 제가 무슨 이상한 말을 했나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/feeling5.ogg"},"터치3":{"voiceline":"으앗?! 뭐 하시는 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님은 대단해요…… 저도 열심히 노력하면 지휘관님 같이 대단해질 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/home.ogg"},"hp 경고":{"voiceline":"쫓아버리겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 리나운 대기 중입니다. 오늘 명령을 내려주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/login.ogg"},"실패":{"voiceline":"죄송해요, 지휘관님…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/lose.ogg"},"우편":{"voiceline":"으음, 이 우편은 지휘관님 거, 이것도 지휘관님 거, 이것도 또 지휘관님 거…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/mail.ogg"},"임무":{"voiceline":"지휘관님, 임무는 저에게 맡겨주세요. 에? 이미 임무를 끝내두셨다고요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/mission.ogg"},"임무완료":{"voiceline":"휘——유, 지휘관님. 임무 보상을 전부 가져왔…… 우와아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/mission_complete.ogg"},"서약":{"voiceline":"드디어 이 순간이 왔군요…… 알았어요. 리나운의 이름으로 약자에게 상냥할 것을 맹세합니다. 그리고…… 에? 맹세라는 것이 나이트의 맹세 아니었나요? 그렇다면 마지막 한 마디, 「영원히 변치 않는 사랑을 맹세합니다.」 지휘관님, 맹세할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/propose.ogg"},"스킬":{"voiceline":"리나운, 물러서지 않습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/skill.ogg"},"터치1":{"voiceline":"사탕이요? 지휘관님, 지금은 당분이 필요 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/touch.ogg"},"터치2":{"voiceline":"지휘관님, 이건 로열 네이비의 규율에 어긋나는 일이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/touch2.ogg"},"입수시":{"voiceline":"리나운급 순양전함 리나운, 전열에 합류했습니다! 지휘관님, 지금의 전 어리지만 실망시켜 드리진 않을겁니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/unlock.ogg"},"강화성공":{"voiceline":"지휘관님을 위해서 강해질 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다! 아, 안돼 안돼. 책에서 일희일비해서는 안 된다고… 음음, 참아야죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관님, 오늘 읽을 건 기사단 관련 서적이 아닌가요? 으음...... 지휘관님이 추천해주시는 대로 볼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"후방 지원은 벨파스트에게, 작전 보고는 리나운에게 맡겨 주세요! 이게 바로 메이드와 기사단의 직책이죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 리나운 대기 중입니다. 오늘의 명령을 하달해 주십시오... 아, \"가서 놀아\"라는 명령은 주지 마세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"음, 지금 당장은 당분을 보충할 필요는 없지만, 딱 한 알이라면......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/touch_ex.ogg"},"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":{"voiceline":"음... 네... 조, 졸리지 않아요, 안 잘 거예요. 전 지휘관님을 보호할 겁니다... 저 눈 안 문질렀어요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"꼬마 리나운이 귀엽나요? ....... 으음, 지휘관님, 칭찬을 들어 매우 기쁩니다만, 제가 바라는 것은 저의 능력을 인정 받는 것입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/204040/main2_ex.ogg"},"메인3_ex":{"voiceline":"nil","voicelink":null},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":1}]