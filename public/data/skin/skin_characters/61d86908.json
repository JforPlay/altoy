main/audio/voiceline/299034/home.ogg"},"hp 경고":{"voiceline":"아야야… 비둘기도 서방님께 도움이 되려냥…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/hp_warning.ogg"},"로그인":{"voiceline":"서·방·님~♪ 꺄아~♡ 쓰담쓰담~ 문질문질~ 보들보들~ 킁킁~! 아, 체셔가 안아주니까 어때? 평소보다 더 기분 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/login.ogg"},"실패":null,"우편":{"voiceline":"체셔가 마술로 우편을 카드에 숨겼어~ 아하하~ 농담이야, 서방님♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/mail.ogg"},"임무":{"voiceline":"서방님? 아직 임무가 안 끝났네. 마술사 체셔가 도와줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/mission.ogg"},"임무완료":{"voiceline":"임무 보상을 받은 다음에는… 서방님, 체셔랑 같이 불꽃놀이라도 구경하러 갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/mission_complete.ogg"},"서약":null,"스킬":{"voiceline":"사랑의 마술이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/skill.ogg"},"터치1":{"voiceline":"꺄아~ 서방님♡ 응? 서방님 얼굴이 갑자기 빨개졌네? 설마 체셔한테 또 홀딱 반한 거냥♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/touch.ogg"},"터치2":{"voiceline":"서·방·님~♡ 무슨 생각하는지 체셔는 다 알아♪ 당연히 괜찮아♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/touch2.ogg"},"입수시":{"voiceline":"서·방·님~♪ 봐~ 오늘은 마술사 체셔야~ 이거 이거 서방님, 체셔한테 더 반한 모양이네. 아까부터 눈을 전혀 못 떼고 있잖아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/unlock.ogg"},"강화성공":{"voiceline":"체셔, 새로운 마술을 배웠어♪ 나중에 서방님한테 보여줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"작전 성공~! 서방님? 체셔가 보여준 불꽃, 예뻤어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299034/win_mvp.ogg"},"전투개시_