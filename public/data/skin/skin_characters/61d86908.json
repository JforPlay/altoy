[{"클뜯 id":299030,"클뜯 함순이 id":29903,"함순이 이름":"체셔","한글 함순이 + 스킨 이름":"체셔","영문 함순이 + 스킨 이름":"Cheshire","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299030/shipyard.png","설명":"중순양함-—체셔 ","자기소개":{"voiceline":"나는 로열 네이비의 중순양함, 체셔! 하지만 서방님을 만나기 전에는 상상 속의 함선이었을 뿐이야. 그러니까 내 몸과 마음은 모두 서방님의 것이라는 거지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/profile.ogg"},"메인1":{"voiceline":"서방님, 로열 네이비의 함선들 사이에서 재밌는 일은 없었어? 다른 진영도 괜찮아. 이야기 해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/main1.ogg"},"메인2":{"voiceline":"체셔는 고양이가 아닌걸! 고양이처럼 귀엽지만, 고양이는 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/main2.ogg"},"메인3":{"voiceline":"주인님을 위한 홍차랍니다. 부디… 메이드단에게서 배워왔어. 어때? 비슷해? 헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/main3.ogg"},"전투개시":{"voiceline":"어디 보자, 오늘 너희가 준비한 메인 디쉬는 어뢰일까, 포탄일까~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/battle.ogg"},"상세확인":{"voiceline":"왜 서방님에게 첫눈에 반했냐고? 동물은 처음 본 생물을 애인으로 생각한대. 부모가 아니라 애인이라구~ 에이, 이게 중요한 게 아니야! 어쨌든 처음 본 그 순간부터 서방님은 내 서방님이었어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/detail.ogg"},"드랍 설명":{"voiceline":"중순양함-—체셔","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어! 함께 마중 나가자. 아, 맞아. 위문품을 들고가는 건 어떨까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/expedition.ogg"},"실망":{"voiceline":"으… 이게 내가 처음 좋아한 사람의 진면목인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/feeling1.ogg"},"낯섦":{"voiceline":"아, 서방님. 어디 갔다왔어? 재미있는 곳에 갔는데 나를 안 데려간 거면 화 낼거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/feeling2.ogg"},"호감":{"voiceline":"들어봐, 지난 번에 사쿠라 엠파이어 함선들과 놀았는데… 진짜 고양이 귀를 만져봤어! 정말이야! 헤헤, 부럽지? …벌써 만져봤다고? 정말이지, 가끔은 이쪽에게 맞춰달라구……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/feeling3.ogg"},"기쁨":{"voiceline":"서방님, 혹시 내가 평소에 전력으로 대시하는게 귀찮아? 만약 그렇다면…… 더 직접적으로 내 사랑을 받게 해주겠어! 일단은 먼저—— 다이빙 공격, 에헷~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/feeling4.ogg"},"사랑":{"voiceline":"서방님이 없었다면 나는 이렇게 아름다운 세계도 보지 못하고, 귀여운 동료들도 만나지 못했을 거야. 그리고 행복이라는 것도 느끼지 못했겠지… 그러니까, 자! 에헷! 안아줄게! 서방님, 세상에서 제일 좋아해! 헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/feeling5.ogg"},"터치3":{"voiceline":"고양이귀 머리핀이 좋아! 서방님도 한번 써볼래? 에이, 한번 써봐! 한번만 보여줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/headtouch.ogg"},"모항귀환":{"voiceline":"서방님, 다녀왔구나! 출격에서 다치지는 않았어? 힘든 적을 만나지는 않았어? 다른 애한테 한눈 팔지는 않았지? 헤헷, 그럼 됐어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/home.ogg"},"hp 경고":{"voiceline":"아야야야! ……하지만 서방님을 위해서라면 질 수 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/hp_warning.ogg"},"로그인":{"voiceline":"서~방~님~! 헷, 와락! ......너무 과격하다고? 헤헤, 서방님이니까 설레지 않을 수가 없잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/login.ogg"},"실패":{"voiceline":"적이 눈치채지 못할 때를 틈타서 어서 도망가자?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/lose.ogg"},"우편":{"voiceline":"우편이 왔어! 무슨 내용일까? 나도 보여줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/mail.ogg"},"임무":{"voiceline":"서방님과 나 사이를 괴롭히는 임무는 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 이번 임무는 우리한테 조금 쉬웠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/mission_complete.ogg"},"서약":{"voiceline":"서방님이 체셔에 대한 사랑을 표현하니까, 헤헤~ 보답으로 백번 '좋아해'라고 말해줄게! 시작할 거야, 분명히 말 했어! 다 듣기 전에 아무데도 못 가! 서방님~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/propose.ogg"},"스킬":{"voiceline":"사랑의 일격이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/skill.ogg"},"터치1":{"voiceline":"으흥? 서방님, 무슨 생각해? 헤헤, 얼굴에 다 써있다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/touch.ogg"},"터치2":{"voiceline":"아~ 정말이지, 기습 금지! 나한테 말 한마디 해줬으면 좋았잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/touch2.ogg"},"입수시":{"voiceline":"후아—— 엄청 오래 잔 것 같네~ 응? 네가 나를 깨운 거야? 그러면 오늘부터 네가 바로 내 서방님이야! 왜냐고? 나를 이 세상에 데려온 너에게 첫눈에 반했거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/unlock.ogg"},"강화성공":{"voiceline":"에헤헤. 서방님, 고마워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"서방님, 이겼어! 우리가 이겼어! 예~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"서방님~ 오늘은 어디 갈 거야~? 뭐가 먹고 싶어? 내가 하고 싶은 거? 체셔는… 서방님의 곁에 있고 싶어! 같이 맛있는 거 먹으러 가고 싶어! 가장 하고 싶은 말은——서방님, 세상에서 제일 좋아해! 헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299030/feeling5_ex.ogg"},"터치3_ex":{"voiceline"