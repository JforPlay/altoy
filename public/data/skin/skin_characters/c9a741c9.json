[{"클뜯 id":701020,"클뜯 함순이 id":70102,"함순이 이름":"그로즈니","한글 함순이 + 스킨 이름":"그로즈니","영문 함순이 + 스킨 이름":"Grozny","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701020/shipyard.png","설명":"그녜브니급 구축함—그로즈니 ","자기소개":{"voiceline":"나는 그녜브니급의 그로즈니. 수뢰 매설과 호위, 육지 지원에 특화되어 있어. 지휘관 동지, 필요한 게 있으면 언제든지 찾아줘. 같이 마시자는 제안이라면 더 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/profile.ogg"},"메인1":{"voiceline":"히끅… 지휘관 동지, 누가 술을 좋아하는지 알아? 토끼 같은 애…? 오오…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/main1.ogg"},"메인2":{"voiceline":"모항에 사천왕이라고 불리는 동료들이 있는 것 같아. 대단해. 그로즈니도 들어가고 싶어… 하지만 그러면 다섯명이 되어버리니까, 조금 아쉽네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/main2.ogg"},"메인3":{"voiceline":"적이든 여우든 모두 우리 집을 넘보는 거잖아. 그러니까 오면 쫓아버리자. 응.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/main3.ogg"},"전투개시":{"voiceline":"음, 무슨 말을 해야 할까? 그러면… Ура!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/battle.ogg"},"상세확인":{"voiceline":"Кролик를 쥐고 있으면 지휘관 동지도 얌전히 말을 듣네. 응, 차파예프의 말이 맞았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/detail.ogg"},"드랍 설명":{"voiceline":"그녜브니급 구축함—그로즈니","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 먼저 항구에 가있을게. 응, 모두가 돌아오는 모습을 제일 먼저 보고 싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/expedition.ogg"},"실망":{"voiceline":"지휘관 동지는 정말 이상하네. 모두들 이상한 사람이랑은 이야기 하지 말라고 했지만, 그렇다면 지휘관 동지가 외롭겠지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/feeling1.ogg"},"낯섦":{"voiceline":"모두들 이상한 사람에게 먹을 걸 받아오지 말랬어. 이상한 사람을 먹어서도 안 된대.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/feeling2.ogg"},"호감":{"voiceline":"모두들 나에게 이상한 사람을 조심하라고 했지만, 지휘관 동지는 이상한 사람이 아니지? 응. 그러니까 조금 먹어도 괜찮을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 동지가 주는 간식만 먹는 것도 좋지 않겠지. 그러니까 그로즈니가 지휘관에게 조금 나눠줄게. 자, 지휘관. 마셔봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/feeling4.ogg"},"사랑":{"voiceline":"…딸꾹. 지휘관 동지와 함께 있으면 나도 모르게 전부 마셔버린 다니까. 음… 왠지 모르게 지휘관 동지와 있으면 더 많이 마실수 있는 것 같아. 지휘관 동지, 다음 번에도… 다음 번에도 나랑—— 후아암… 응, 오늘은 먼저… 잘게… Zzz…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 동지, 따뜻한 코코아와 보르시 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/home.ogg"},"hp 경고":{"voiceline":"모자라…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/hp_warning.ogg"},"로그인":{"voiceline":"……히끅, 음. 지휘관 동지, 혹시 이 향기에 끌려서 온 거야? 응…… 한 잔 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/login.ogg"},"실패":{"voiceline":"으… 너무 마셨더니 어질어질해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/lose.ogg"},"우편":{"voiceline":"지휘관 동지, 편지를 가져왔어. 어라? 하나도 안 이상해. 모두 돌아가면서 하는 일인걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/mail.ogg"},"임무":{"voiceline":"‘일하지 않는 자 먹지도 말라’——이게 우리의 규율이야. 지휘관 동지, 내일 더 즐겁게 마시려면 임무를 끝내야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/mission.ogg"},"임무완료":{"voiceline":"잘 했어, 지휘관 동지. 오늘 밤 국물도 끝내줄 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/mission_complete.ogg"},"서약":{"voiceline":"그로즈니는 반지를 받는 것보다 이게 더 마음에 들어. 자, 같이 마시자. 이러면 지휘관 동지도 이제 가족이야… 응? 그러고 보니 지휘관 동지는 이미 가족이나 다를 바 없는데…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/propose.ogg"},"스킬":{"voiceline":"Кролик, грызть!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/skill.ogg"},"터치1":{"voiceline":"지휘관 동지, 이 간식들은 노력한 나를 위해 준비한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/touch.ogg"},"터치2":{"voiceline":"Кролик는 화가 나면 사람을 물어. … 어라? 이 아이는 사람을 자른다…가 맞겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/touch2.ogg"},"입수시":{"voiceline":"Здра́вствуйте, 지휘관 동지. 그녜브니급 구축함 그로즈니, 착함했어…… 어라? 왜 그렇게 멀리 떨어져 있는 거야? 손에 든 것…? 이건 나의 кролик, 귀여운 убийца지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/unlock.ogg"},"강화성공":{"voiceline":"역시 노스 유니온의 것이 맛있다니까. 히.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"хорошо, 몸이 따뜻해졌어. … 어라? 벌써 끝이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['키요나미', '베일리'] : 토끼토끼 동맹? 귀여울 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701020/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":nu