[{"클뜯 id":401470,"클뜯 함순이 id":40147,"함순이 이름":"Z47","한글 함순이 + 스킨 이름":"Z47","영문 함순이 + 스킨 이름":"Z47","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401470/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401470/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401470/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401470/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401470/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401470/shipyard.png","설명":"1936년 C형 구축함 - Z47","자기소개":{"voiceline":"메탈 블러드의 Z47이야. 취미는 쥬스타그램, 코디나 트렌드 체크…… 얼굴 맞대고 대화하는 건 서투르니까, 용건이 있으면 DM으로 보내줘. …휘관이는 이미 가장 위에 고정해 뒀거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/profile.ogg"},"메인1":{"voiceline":"핸드폰 배터리가 다 될 것 같아… 휘관아… 지휘관… 어, 어떡하면 좋아… 뭐? 마찰로 정전기를 일으키면 된다고? 엥? 뭐야, 그게… 완전 노잼… 어? 반대로 마음이 좀 편해진 것 같기도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/main1.ogg"},"메인2":{"voiceline":"휘관아~ 이 밈, 완전 웃기지…… 뭐? 이해가 안 된다고? 그, 그럼 내가 설명해 줄까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/main2.ogg"},"메인3":{"voiceline":"아, 으음… 휘관이는 내가 차가운 것 같아? 일부러 그러는 건 아니야… 사람이랑 대화하는 게 익숙하지가 않아서… 응? 그렇게 생각 한 적 없다고? …다행이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/main3.ogg"},"전투개시":{"voiceline":"성가시네… 빨리 좀 끝나라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/battle.ogg"},"상세확인":{"voiceline":"휘관이랑 폰으로 연락하는 거, 좋아…… 계속 함께 있는 것 같은 느낌이 들거든…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/detail.ogg"},"드랍 설명":{"voiceline":"1936년 C형 구축함 - Z47","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네. 뭐, 잘 돌아왔다고 DM도 보냈고… 휘관이한테도 DM했는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/expedition.ogg"},"실망":{"voiceline":"여전히 안읽씹이고… 또 날 무시하는구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/feeling1.ogg"},"낯섦":{"voiceline":"이 앱으로 매일 연락하면, 이렇게 조그만 토끼가 나와서 점점 자라거든… 그, 그러니까 휘관아… 매일 나랑 대화해줄래? 부탁이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/feeling2.ogg"},"호감":{"voiceline":"음…… 휘관이한테 DM 보냈는데, 자꾸 내 얼굴만 보고…… 너무 부끄러워……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/feeling3.ogg"},"기쁨":{"voiceline":"으음… 계속 안대를 하고 있으려니까 피곤하네. 응? 벗기면 안 돼. 이건 내 코디의 일부분이니까 이대로 두고 싶어. …걱정해 줘서 고마워. 휘관이는 너무 착하다니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/feeling4.ogg"},"사랑":{"voiceline":"이 앱, 둘이서도 쓸 수 있나 봐. 서로 DM을 남기거나 평소 일상을 공유하거나…… 어차피 맨날 같이 있는데 굳이 앱을 써야 하냐고? 응… 그…렇기는 해","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/feeling5.ogg"},"터치3":{"voiceline":"많이 쓰다듬어주면… 키도 자랄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/headtouch.ogg"},"모항귀환":{"voiceline":"드디어 돌아왔네. 있잖아, 방금 보낸 DM… 전투 지휘하느라 바빠서 아직 못 봤다고…? 아, 그래.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/home.ogg"},"hp 경고":{"voiceline":"싫어…… 정말 바보 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/hp_warning.ogg"},"로그인":{"voiceline":"아, 휘관이 왔어? ……새로 나온 머리핀을 둘러보던 참이야. ……이거 귀엽지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/login.ogg"},"실패":{"voiceline":"지, 진지하게 안 해서 그런 거야. ……창피해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/lose.ogg"},"우편":{"voiceline":"누가 DM을 보냈어. …내가 보낸 DM도 빨리 읽어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/mail.ogg"},"임무":{"voiceline":"아직 안 끝난 임무가 있어…? 알람을 몇 개 설정해 둘게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/mission.ogg"},"임무완료":{"voiceline":"임무 완료 보상 말인데…… 나도 들 수 있겠지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/mission_complete.ogg"},"서약":{"voiceline":"으, 으아…… 평소에 DM으로 했던 말을 이제는 직접 대놓고 해주는구나…… 흑…… 가, 갑자기 그렇게 애정 공세를 퍼부으니까 나… 과부하가 올 것 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/propose.ogg"},"스킬":{"voiceline":"힘껏 내려치면……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/skill.ogg"},"터치1":{"voiceline":"응? 뭐 재밌는 일이라도 있었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/touch.ogg"},"터치2":{"voiceline":"응? 이, 이건……?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/touch2.ogg"},"입수시":{"voiceline":"Z47이야. …휴우. 일단 연락처 교환이라도 해둘래? 응? 이 프사는 뭐냐고? 흑백 야옹이야. 내 머리핀이랑 똑같은 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/unlock.ogg"},"강화성공":{"voiceline":"위이이잉해서 붕붕하면 더 아프게 해줄 수 있어? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"이겼어. ……쥬스타그램에 올려서 축하나 받아야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"내 호칭? 글쎄… 부르고 싶은 대로 불러. Z47이든, 퓌지든, 내 사랑이든, 여자 친구든… 맘대로 불러…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401470/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔어. …DM도 보냈는데, 휘관이는 맨날 늦게 확인하니까 한 번 더 그냥 알려주기로 했어… ///"