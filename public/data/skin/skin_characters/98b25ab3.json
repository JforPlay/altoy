408012/main2.ogg"},"메인3":{"voiceline":"전에는 항상 혼자 있던 U-47이 오늘도 동료들이랑 같이 놀았어. 명절은 불가사의한 마력이 있나봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"나도 간단한 등롱을 만들 수 있어. 이것 좀 봐——이스트 글림의 언니들이 가르쳐 준 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 여기야. 네가 같이 달 보자며, 그래서 여기서 널 기다렸지! 월병이랑 차도 준비했다구!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아온 것 같아. 이제 모항에서 모여들 사람들이 더 많아졌겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"추석 뿐만이 아니라, 매일매일 날 볼 수 있으면 좋겠다고……? 내가 얘기했었잖아, 날 찾을 수 없을 때는 큰 소리로 \"U-81, 내가 졌어\"라고 외치면, 바로 나타날 거라고! 헤헤～","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"날씨가 맑아서 다행이야. 먹구름을 만났다면, 한 달을 기다려야 완전한 달을 볼 수 있었을 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 얼른 이쪽으로 와! 봐, 하늘에 날리는 등불이 점점 더 많아지고 있어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"잠깐만…… 헷, 월병을 반씩 나누자, 이건 네꺼야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/touch.ogg"},"터치2":{"voiceline":"지휘관! 이, 이런 때를 틈타서 기습하다니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/touch2.ogg"},"입수시":{"voiceline":"지휘관, 여기야. 네가 같이 달 보자며, 그래서 여기서 널 기다렸지! 월병이랑 차도 준비했다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408012/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"좋아, 이제 모항으로 돌아가서 동료들을 만나야겠어~","voicelink":"https://raw.githubu