[{"클뜯 id":408010,"클뜯 함순이 id":40801,"함순이 이름":"U-81","한글 함순이 + 스킨 이름":"U-81","영문 함순이 + 스킨 이름":"U-81","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408010/shipyard.png","설명":"메탈 블러드 ⅦC형 잠수함 U-81","자기소개":{"voiceline":"메탈 블러드 VIIC형 잠수함 U-81이다. 동형함은 많지만, 가끔은 시끄러워서 말이지! ……그리고, 그 아크 로열을 가라앉힌 적도 있다고! 그래도 그 사람, 조금 좀 특이한 것 같은…어디가 이상하단 건진 제대로 설명 못 하겠지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/profile.ogg"},"메인1":{"voiceline":"집무실에서 잠항할 수 있는 장소가 있는지 찾아보겠다. 헤헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/main1.ogg"},"메인2":{"voiceline":"발사 제원…컴퍼스에 축척…딸깍딸깍…후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/main2.ogg"},"메인3":{"voiceline":"지휘관도 술래잡기, 해보겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/main3.ogg"},"전투개시":{"voiceline":"조용히…살그머니…전장에 잠입…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/battle.ogg"},"상세확인":{"voiceline":"우왓~! 어떤가 지휘관, 깜짝 놀랐는가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/detail.ogg"},"드랍 설명":{"voiceline":"메탈 블러드 ⅦC형 잠수함 U-81","voicelink":null},"의뢰 완료":{"voiceline":"오오? 의뢰팀이 돌아왔나. 지휘관, 마중 나가도 되겠나? 가는 김에 모항에 잠깐 잠수 좀 하고 올테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/expedition.ogg"},"실망":{"voiceline":"Enttäuscht(실망이야)……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/feeling1.ogg"},"낯섦":{"voiceline":"헤헤, 술래잡기가 제일 좋아! 특기이기도 하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/feeling2.ogg"},"호감":{"voiceline":"자랑은 아니지만 꽤 좋은 전투 성과를 갖고 있다고. 그래 그래, 더 칭찬해도 좋으니까 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/feeling3.ogg"},"기쁨":{"voiceline":"오오? 또 찾았나. 최근엔 지휘관에게 자주 들키는 것 같군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/feeling4.ogg"},"사랑":{"voiceline":"방금 엄청난 사실을 깨달았다. 지휘관의 이불은 말도 안 되게 따뜻하다는 걸! 앞으로는 그쪽의 이불에서 자야……응? 뭔가 이상한 말이라도 했나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 타올이다. 땀 닦으라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/home.ogg"},"hp 경고":{"voiceline":"젠장, 어딘가에 숨어있어야겠군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 드디어 왔나. 이쪽은 너무 따분해서 죽는 줄 알았다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/login.ogg"},"실패":{"voiceline":"큭…지휘관이라면 반드시 복수해줄 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/lose.ogg"},"우편":{"voiceline":"기항할 때 받는 편지는 기쁜 법이지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/mission.ogg"},"임무완료":{"voiceline":"임무 보수다…필요 없다면 내가 가져가겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/mission_complete.ogg"},"서약":{"voiceline":"이건…말로만 듣던 '고백' 이란 건가! 헤헤헤, 왠지 기쁘고…부끄러운……무, 물론 지휘관은 정말 좋아한다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/propose.ogg"},"스킬":{"voiceline":"발사 각도 오케이, 쏴라~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/skill.ogg"},"터치1":{"voiceline":"폭격기?! 우와아아아아앗! …지휘관, 농담이라도 해선 안 될 말도 있다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/touch.ogg"},"터치2":{"voiceline":"우와앗! 그러니까 지휘관, 위험하다니까! 하마터면 어뢰를 쏠 뻔했잖아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/touch2.ogg"},"입수시":{"voiceline":"후훗, 이걸로 내게도 지휘관이 생기게 되었네! 나는 U-81, 좋아하는 건 술래잡기, 뭐 나를 못 찾겠을 땐 \"U-81, 내가 졌어~\" 하고 소리치면 나와줄 수도 있지만 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/unlock.ogg"},"강화성공":{"voiceline":"몸이 더욱 홀가분해졌군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"U보트의 힘, 똑똑히 보았느냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":408011,"클뜯 함순이 id":40801,"함순이 이름":"U-81","한글 함순이 + 스킨 이름":"정밀한 세레나데","영문 함순이 + 스킨 이름":"Soft Serenade","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408011/painting.png","확대 일러":null,"sd 일러":"https://raw.