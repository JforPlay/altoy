[{"클뜯 id":301470,"클뜯 함순이 id":30147,"함순이 이름":"우미카제","한글 함순이 + 스킨 이름":"우미카제","영문 함순이 + 스킨 이름":"Umikaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301470/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301470/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301470/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301470/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301470/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301470/shipyard.png","설명":"시라츠유급 구축함 7번함・우미카제","자기소개":{"voiceline":"改시라츠유급'…우미카제들은 분명 그렇게 불렸었죠. 그 대전에서 자매함 넷이서 송구스럽게도 24 구축대로서 활약했었습니다… 좋은 추억만 있었던 건 아니었지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/profile.ogg"},"메인1":{"voiceline":"지휘관님, 창문을 열어둘까요? 통풍도 잘 되고, 기분 전환에 좋답니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/main1.ogg"},"메인2":{"voiceline":"야마카제, 카와카제의 일을 방해하면 못 써. …노, 놀 거라면 우미카제랑……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/main2.ogg"},"메인3":{"voiceline":"창가에 먹이를 놔두면, 갈매기가 와주려나… 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/main3.ogg"},"전투개시":{"voiceline":"풍상측 확인, 전망 좋음…… 응!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/battle.ogg"},"상세확인":{"voiceline":"지휘관님… 실례를 무릅쓰고 말씀드립니다만… 스, 스킨십은 조, 조금 거북합니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/detail.ogg"},"드랍 설명":{"voiceline":"시라츠유급 구축함 7번함・우미카제","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 얻은 물자, 잔뜩 쌓였네요. 우미카제도 함께 옮기는 게 좋을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/expedition.ogg"},"실망":{"voiceline":"지휘관님, 도움이 되어드리지 못해 죄송합니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/feeling1.ogg"},"낯섦":{"voiceline":"갈매기에 먹이를 주거나, 작고 귀여운 동물을 만지는 건 괜찮은데, 어째서 지휘관님의 스킨십은 고역인 걸까요… 하아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 저기… 함께 갈매기에게 먹이를 줘보시지 않으시겠어요? …네! 송구스럽지만 우미카제, 빵가루를 나눠드리겠… 으와와, 죄송합니다! 떨어트려 버렸어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 송구스럽지만, 우미카제의 손을 잡아주시지 않겠습니까? 스킨십에 견딜 수 있도록 훈련하고자 하니… 무슨 일이 있어도 놓지 말아 주시기 바래요! 저, 절대로! 버텨내겠습니다!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/feeling4.ogg"},"사랑":{"voiceline":"지휘관님 덕분에, 이제 우미카제도 제법 스킨십에 익숙해진 것 같습니다… 소, 송구스럽습니다만, 앞으로도 우미카제의 '연습'에 어울려주시겠습니까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/feeling5.ogg"},"터치3":{"voiceline":"꺅!? 그, 그만둬 주세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 에헤헤, 송구스럽지만, 실은 언제쯤 돌아오시나 생각하던 참이었습니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/home.ogg"},"hp 경고":{"voiceline":"우미카제는 조금 더, 견딜 수 있습니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/hp_warning.ogg"},"로그인":{"voiceline":"안녕하십니까, 지휘관님. 송구스럽습니다만, 오늘 스케줄을 정리해두었습니다. 달리 뭔가 도와드릴 일이 있는지요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/login.ogg"},"실패":{"voiceline":"우미카제는 괜찮습니다… 다른 동료분들은 괜찮으신가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/lose.ogg"},"우편":{"voiceline":"지휘관님, 새로운 우편을 책상 위에 올려두었습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/mail.ogg"},"임무":{"voiceline":"지휘관님, 그게… 송구스럽습니다만, 우미카제도 도와드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/mission.ogg"},"임무완료":{"voiceline":"임무 완료입니다! 지휘관님께 도움이 돼서, 우미카제도 무척 기뻐요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/mission_complete.ogg"},"서약":{"voiceline":"우미카제, 송구스럽고도 부끄럽지만… 드디어 무사히 꼈습니다…! 저기… 지휘관님… 앞으로도 계속 우미카제를 곁에 두어주시기 바랍니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/propose.ogg"},"스킬":{"voiceline":"우미카제, 송구스럽습니다만 도움이 되어드리겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/skill.ogg"},"터치1":{"voiceline":"죄, 죄송합니다…! 스킨십은, 그게, 조금…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/touch.ogg"},"터치2":{"voiceline":"으읏… 지휘관님……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/touch2.ogg"},"입수시":{"voiceline":"改시라츠유급 구축함 우미카제입니다... 전력을 다해 지휘관님과 함대의 다른 동료들을 지원할 것입니다... 자, 잘 부탁드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/unlock.ogg"},"강화성공":{"voiceline":"늘 감사합니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에헤헤… 전부 여러분 덕분입니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"저기, 지휘관님이라면, 약간의 스킨십이라면 부, 분명 괜찮을 거예요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님, 송구스럽지만 우미카제, 껴안아 드리겠습니다…… 에, 에잇! 아으… 왠지 졸음이 와서 연습이 안될 것 같네요… 하암…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301470/feeling5_ex.