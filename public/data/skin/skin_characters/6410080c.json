[{"클뜯 id":408030,"클뜯 함순이 id":40803,"함순이 이름":"U-557","한글 함순이 + 스킨 이름":"U-557","영문 함순이 + 스킨 이름":"U-557","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408030/shipyard.png","설명":"메탈블러드 VIIC형 잠수함 U-557 ","자기소개":{"voiceline":"나는 메탈블러드의 VIIC형 잠수함, U-557. 4번의 출격에서 6척의 상선과 갈라테아를 침몰시켰어...하지만 그 다음날 아군에게 로열의 잠수함으로 오인받아 침몰당했지...잠항 사고를 일으킨 적도 있고, 혹시 저주받은거 아닐까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408030/profile.ogg"},"메인1":{"voiceline":"\"첫번째 전성기\"는 선배들의 이야기로 만들어 봤어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408030/main1.ogg"},"메인2":{"voiceline":"운이 나쁘니 다른 사람과 접촉하고 싶지 않아. 그러면 폐를 끼치지 않잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408030/main2.ogg"},"메인3":{"voiceline":"비서함의 일, 열심히 할게. 이것만은 망치지 않았으면해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408030/main3.ogg"},"전투개시":{"voiceline":"문제가 없으면 좋겠는데......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408030/battle.ogg"},"상세확인":{"voiceline":"1센트는 행운을 가져다 주는 동전이라고 하던데...돼지 저금통 한가득 동전을 모았지만 왠지...차이가 없는것 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408030/detail.ogg"},"드랍 설명":{"voiceline":"메탈블러드 VIIC형 잠수함 U-557","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰...끝난 것 같아","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408030/expedition.ogg"},"실