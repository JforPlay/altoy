[{"클뜯 id":101330,"클뜯 함순이 id":10133,"함순이 이름":"부시","한글 함순이 + 스킨 이름":"부시","영문 함순이 + 스킨 이름":"Bush","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101330/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101330/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101330/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101330/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101330/shipyard.png","설명":"플레처급 구축함 - 부시 (DD-529)","자기소개":{"voiceline":"플레처급의 부시에요. 자매들 처럼 태평양의 전장에서 활약하고, 임무를 잔뜩 맡았었죠! ……항공기? 꺅, 갑자기 무서운 얘기 하지 마세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/profile.ogg"},"메인1":{"voiceline":"몰래 농땡이를 부리면, 지휘관님이 못 알아채겠지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/main1.ogg"},"메인2":{"voiceline":"우으……계획같은 거 귀~찮~아, 생각이 들면 바로 실행! 이러면 좋잖아요~! ……에에? 안 된다고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/main2.ogg"},"메인3":{"voiceline":"언니도 동생도 엄청 많다구요! 자주 이름을 까먹긴 하지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/main3.ogg"},"전투개시":{"voiceline":"부시, 파이팅!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/battle.ogg"},"상세확인":{"voiceline":"왜요 왜요? 뭘 하면 되나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함 - 부시 (DD-529)","voicelink":null},"의뢰 완료":{"voiceline":"아, 의뢰에서 돌아온 모두를 마중 나갈게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/expedition.ogg"},"실망":{"voiceline":"지휘관님, 웃어줘요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/feeling1.ogg"},"낯섦":{"voiceline":"와아! 하, 항공기가 날아왔어! ……아? 뭐, 뭐야, 풍뎅이인가요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/feeling2.ogg"},"호감":{"voiceline":"실은 꽤 날렵한 편이라고요! 자자~ 이 반복 옆뛰기를 봐보라구요! ……하아, 하아, 힘들다……더는 무리야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/feeling3.ogg"},"기쁨":{"voiceline":"지금이다! ……어때요? 이건 대처 언니가 알려준 장난이에요! ……에? 그래도 지휘관님은 누가 장난 쳐 주면 좋아한다고 대처 언니가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/feeling4.ogg"},"사랑":{"voiceline":"왠지 지금은 그렇게 항공기가 무섭지 않은 느낌이 드네요. 이건 분명 지휘관님의 애정이 있어서! ……라고 대처 언니가 그랬는데, 틀렸나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오오! 다들 돌아왔어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/home.ogg"},"hp 경고":{"voiceline":"아, 아직 괜찮아요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/hp_warning.ogg"},"로그인":{"voiceline":"저기…오늘 일정이 뭐였었죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/login.ogg"},"실패":{"voiceline":"시, 싫어! 날아오지 마~!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/lose.ogg"},"우편":{"voiceline":"우편을 가져왔어요! 뭐라 쓰여있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/mail.ogg"},"임무":{"voiceline":"아직 임무가 남아있네요. 혹시……지휘관님 또 농땡이 부린 거에요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/mission.ogg"},"임무완료":{"voiceline":"미션 컴플리트! ……이런 느낌으로 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/mission_complete.ogg"},"서약":{"voiceline":"이걸로, 지휘관님이 제 가장 소중한 사람이 된 건가요? 그럼, 제 말은 뭐든지 다 들어주는 건가요? 그럼 그럼~ 저번의 새로 생긴 그 가게의 과자가 먹고 싶으니까, 지금 당장 가자구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/propose.ogg"},"스킬":{"voiceline":"적은 어디있나요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/skill.ogg"},"터치1":{"voiceline":"왜요 왜요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/touch.ogg"},"터치2":{"voiceline":"여긴 만지면 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/touch2.ogg"},"입수시":{"voiceline":"플레처급의 부시에요! 오늘부터 여기서 지낼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/unlock.ogg"},"강화성공":{"voiceline":"에? 이걸로 강해질 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에헤헤~ 간단하네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101330/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":101331,"클뜯 함순이 id":10133,"함순이 이름":"부시","한글 함순이 + 스킨 이름":"꼬마 화가","영문 함순이 + 스킨 이름":"Budding Painter","스킨 타입":"Others","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101331/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101331/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Ferna