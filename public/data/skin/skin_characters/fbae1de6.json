[{"클뜯 id":805010,"클뜯 함순이 id":80501,"함순이 이름":"리슐리외","한글 함순이 + 스킨 이름":"리슐리외","영문 함순이 + 스킨 이름":"Richelieu","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/805010/shipyard.png","설명":"아이리스 리브레 리슐리외급 전함—리슐리외 ","자기소개":{"voiceline":"아이리스 리브레의 리더, 리슐리외급 전함 리슐리외입니다. 운명에 어긋난 생을 살며 조국의 흥망성쇠를 목격했지만… 이번에는 반드시… 중요한 것을 지킬 수 있을 것이라고 믿고 있어요. 자유와 평화가 모두 이 함대에서 시작될 것이라고 믿습니다——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/profile.ogg"},"메인1":{"voiceline":"「FVRENTIBVS EMINET AVSTRIS」… 굳건한 신앙과 끝없는 노력만 있다면 어떤 고난도 우리를 쓰러뜨릴 수 없다고 믿고 있어요——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/main1.ogg"},"메인2":{"voiceline":"모항의 저 아이들… 「지휘냥」인가요? 후후, 정말 귀여운 아이들이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/main2.ogg"},"메인3":{"voiceline":"로열 네이비? 다음 티타임에 와인을 가져올 수 있게 허락해준다면 조금 더 쉽게 어울릴 수 있을지도 모르겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/main3.ogg"},"전투개시":{"voiceline":"자유와 명예의 이름으로, 전 함대! aux armes, marchons!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/battle.ogg"},"상세확인":{"voiceline":"나를 믿고 따르면 원하는 것을 얻을 수 있을 겁니다. 기도하고 찾으세요. 그렇다면 길이 열릴 것입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/detail.ogg"},"드랍 설명":{"voiceline":"아이리스 리브레 리슐리외급 전함—리슐리외","voicelink":null},"의뢰 완료":{"voiceline":"순조로운 의뢰 완료는 함대가 잘 돌아간다는 증거지요. 잘 하셨습니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/expedition.ogg"},"실망":{"voiceline":"현실에 안주하면 결국 파멸할 뿐입니다. 이 점을 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/feeling1.ogg"},"낯섦":{"voiceline":"전쟁을 일으켰다고 저를 미워하는 이도 있고, 저를 추기경으로 경외하는 사람도 있지요. 또 누군가는 완고한 성직자라고 저를 증오하기도 합니다…… 지휘관님은, 저를 어떻게 생각하시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/feeling2.ogg"},"호감":{"voiceline":"오셨군요. 앉으세요. 뭘 마시고 싶으세요? …너무 어색해 하지 않아도 된답니다. 저라도 일을 하지 않을 때는 평범하게 지내고 있으니까요. 아무리 독실한 신자라도 신앙만으로는 살 수 없어요. 모두 음식과 술이 필요하지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/feeling3.ogg"},"기쁨":{"voiceline":"또 오셨군요. 지휘관님께 친절을 베푼 것이 조금 후회되기 시작했답니다—— 장난이에요. 믿을 수 있고 서로를 이해하는 사람과 사귈 수 있다는 것은 사치스러운 일이지요. 저는 운이 좋은 모양이네요. 물론, 지휘관님도 마찬가지겠지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/feeling4.ogg"},"사랑":{"voiceline":"사람과 사람 사이의 거리감은 의미 있는 것이죠. 상사와 부하, 함대의 리더와 지휘자, 함선과…… 후후, 당분간은 모두가 우리 관계를 오해하게 두도록 하죠. 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/feeling5.ogg"},"터치3":{"voiceline":"당신도 하늘의 가호를 받을 수 있기를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/headtouch.ogg"},"모항귀환":{"voiceline":"작전 종료. 함대가 무사 귀환했습니다. 수고했어요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/home.ogg"},"hp 경고":{"voiceline":"희망은… 아직 꺼지지 않았어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, Bonjour. 제가 기도하고 있을 동안 차를 마시면서 잠시 기다려주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/login.ogg"},"실패":{"voiceline":"이것도… 신이 내린 시련일까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/lose.ogg"},"우편":{"voiceline":"우편은 누군가가 보내는 축복이지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/mail.ogg"},"임무":{"voiceline":"임무도 일종의 시련이겠지요. 바른 마음가짐으로 끝내주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/mission.ogg"},"임무완료":{"voiceline":"보상은 하늘이 주시는 노동의 댓가랍니다. 감사히 받겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/mission_complete.ogg"},"서약":{"voiceline":"아이리스 리브레의 리더로서 맹세할 수는 없지만 함선 리슐리외로서 영원히 당신을 지키고 응원할 것을 맹세할게요. 신성한 아이리스 리브레의 이름으로——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/propose.ogg"},"스킬":{"voiceline":"천벌을 받으세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/skill.ogg"},"터치1":{"voiceline":"신에게 바치는 기도를 들어주세요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/touch.ogg"},"터치2":{"voiceline":"…그 용기는 칭찬할 만하군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/touch2.ogg"},"입수시":{"voiceline":"저는 아이리스 리브레 함대의 지도자이자 추기경 리슐리외입니다. 당신도 신앙과 자유를 위해 싸운다면, 제가 승리를 가져다 드리겠습니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/unlock.ogg"},"강화성공":{"voiceline":"국민을 이끄는 데에는 힘이 필요한 법—— 고맙습니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"전장을 떠도는 망령들에게 영원한 안녕과 구원을, 아멘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"요즘 장 바르와 함께 하는 시간이 늘었답니다. 서로 각자 할 일을 하면서 대화는 나누지 않지만 곁을 내주는 느낌이 들어서 굉장히 즐거워요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/805010/detail_ex.ogg"},"의