[{"클뜯 id":207140,"클뜯 함순이 id":20714,"함순이 이름":"포미더블(μ장비)","한글 함순이 + 스킨 이름":"포미더블(μ장비)","영문 함순이 + 스킨 이름":"Formidable μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207140/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207140/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207140/shipyard.png","설명":"지휘관님. 일러스트리어스급 3번함, 아이돌 포미더블이 인사드려요. 지금부터 시작하는 라이브를 마음껏 즐겨주시길 바라요. 후후후♪ 이렇게 인사하니까 처음 만났을 때 그 설렘이 느껴지죠?","자기소개":{"voiceline":"우아한 로열 레이디이자 유닛 \"Alizarin\"의 멤버로 활동 중인 포미더블이예요! 지금부터 시작하는 라이브에는 저만의 매력을 온 힘을 다해서 쏟아부을 거예요. 기대하셔도 좋아요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/profile.ogg"},"메인1":{"voiceline":"들려드릴 곡은… 물론! 짜잔! 포미더블 스타일의 로큰롤! 지휘관님, 듣기만 해도 짜릿하시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/main1.ogg"},"메인2":{"voiceline":"자, 지휘관님! 이쪽을 오세… 왜냐구요? 당연히 포미더블 곁에 더 가까이 계셨으면 해서죠♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/main2.ogg"},"메인3":{"voiceline":"일러스트리어스 언니의 라이브는 역시 반짝반짝 빛이 나네요… 아! 저도 지지 않을 거예요! 지휘관님도 한 사람만 편애하고 그러시면 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/main3.ogg"},"전투개시":{"voiceline":"레이디의 로큰롤을 보여드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/battle.ogg"},"상세확인":{"voiceline":"후훗♪ 지휘관님, 오늘 포미더블 의상은…… 네?! 괴, 굉장히 근사하다구요? 으흠, 아… 아직 다 물어보지도 않았는데… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님. 일러스트리어스급 3번함, 아이돌 포미더블이 인사드려요. 지금부터 시작하는 라이브를 마음껏 즐겨주시길 바라요. 후후후♪이렇게 인사하니까 처음 만났을 때 그 설렘이 느껴지죠?","voicelink":null},"의뢰 완료":{"voiceline":"딩동딩동~♪ 의뢰 보상이 도착했어요. 라이브용 설비도 온 것 같으니까 같이 확인하러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/expedition.ogg"},"실망":{"voiceline":"라이브 할 때 우울한 것 같았다고요? 흥! 그건 다 어떤 둔탱이 바보 때문에…… 꺅?! 너무 가까워요! 바, 바보! 용서할게요! 용서한다니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님? 일찍 오셨네요. 후후후, 그렇게나 포미더블의 라이브가 기대되시면, 리허설 무대에 참여해서 남들보다 빨리 보시는 게 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/feeling2.ogg"},"호감":{"voiceline":"흐음… 포미더블의 라이브와 일러스트리어스 언니의 라이브를 비교하다니, 어떻게 그런 말씀을! ……그래서, 어때요? 어느 한 쪽만 꼽자면 여, 역시 저…… 으흠, 아무것도 아니에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/feeling3.ogg"},"기쁨":{"voiceline":"음… \"μ장비\" 실험에 참가한 이유요? 그야…… 진정한 포미더블로 있고 싶어서죠. 로열 레이디답게 행동하지 않아도 되고, 좋아하는 음악을 마음껏 즐길 수 있고, 게다가 지휘관님의…… 후훗, 꽤 이득이잖아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/feeling4.ogg"},"사랑":{"voiceline":"어서 오세요, 지휘관님. 오늘도 포미더블의 레슨을 견학하시려고요? 이건…… 포미더블의 홍보 포스터? 설마 지휘관님이 포미더블의 라이브를 그렇게나 마음에 들어 하실 줄은…! 네! 보답으로 오늘은 포미더블의 가~~장 귀여운 모습을 보여드릴게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/feeling5.ogg"},"터치3":{"voiceline":"지, 지금은 아이돌 활동 중이라구요! …아앗! 잠깐, 손은 원래대로 두세요! 그렇다고 빼시면 안 되죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/headtouch.ogg"},"모항귀환":{"voiceline":"인터미션이 끝났네…… 지휘관님, 제 응원 잘 부탁드려요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/home.ogg"},"hp 경고":{"voiceline":"헉…! 이런 연주 방법이…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/hp_warning.ogg"},"로그인":{"voiceline":"응? 지휘관님, 빨리 오셨네요. 그럼… 지금 바로 아이돌 포미더블의 솔로 라이브를 지휘관님께 보여드릴게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/login.ogg"},"실패":{"voiceline":"준비가 모자랐어요…… 다, 다음에는 꼭 완벽한 공연을 보여드리고 말겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 온 팬레터도 있네요. 확인하는 거 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/mail.ogg"},"임무":{"voiceline":"오늘 임무 목록은 여기…… 너무 바쁘다고 임무 수행하는 것까지 잊으시면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/mission.ogg"},"임무완료":{"voiceline":"후후후… 포미더블의 라이브와 묵직한 임무 보상 중에 어떤 게 더 중요한가요? …후후후, 지휘관님이니까 둘 다겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/mission_complete.ogg"},"서약":{"voiceline":"이건… 응원치고는 상상 이상인걸요… 지휘관님은 무대 위의 포미더블을 이렇게…… 네, 무슨 말이 하고 싶으신지는 다 알아요! 제 모든 마음을 유일무이한 라이브로 전부 남김없이 털어놓을게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/propose.ogg"},"스킬":{"voiceline":"앵콜 가볼까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/skill.ogg"},"터치1":{"voiceline":"읏, 지휘관님은 포미더블의 제일가는 팬이 되고 싶으신 거죠? 네! 분명 그럴 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/touch.ogg"},"터치2":{"voiceline":"지휘관님, 이건 농담으로 넘길 수 없겠네요. 후훗, 변명 따위는 듣고 싶지 않아요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/touch2.ogg"},"입수시":{"voiceline":"지휘관님. 일러스트리어스급 3번함, 아이돌 포미더블이 인사드려요. 지금부터 시작하는 라이브를 마음껏 즐겨주시길 바라요. 후후후♪이렇게 인사하니까 처음 만났을 때 그 설렘이 느껴지죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/unlock.ogg"},"강화성공":{"voiceline":"역시 이거죠♪ 후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"후훗, 완벽한 공연이었죠. 우리의 마음도 분명 전해졌을 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['일러스트리어스(μ장비)'] :  일러스트리어스 언니, 지금은 제가 센터랍니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/couple_encourage1.ogg"},{"voiceline":"['프린츠 오이겐(μ장비)'] :  포미더블도 지지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/couple_encourage2.ogg"},{"voiceline":"['노시로(μ장비)'] :  라이브 분위기를 더 뜨겁게 달궈요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207140/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":0}]