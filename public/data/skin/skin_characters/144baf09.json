[{"클뜯 id":603020,"클뜯 함순이 id":60302,"함순이 이름":"차라","한글 함순이 + 스킨 이름":"차라","영문 함순이 + 스킨 이름":"Zara","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/603020/shipyard.png","설명":"차라급 중순양함—차라 ","자기소개":{"voiceline":"나는 차라급 중순양함의 1번함, 차라야. 수면의 포격전을 위해 탄생했기 때문에 자랑스러운 주포 사거리와 중기갑 방어를 가지고 있지. 기함으로서의 역할도 충실히 수행했어. 그 운명의 밤이 오기 전까지는…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/profile.ogg"},"메인1":{"voiceline":"\"tenacemente\"——어떤 전장이라도 최선을 다해서 싸워야 한다는 게 나의 모토야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/main1.ogg"},"메인2":{"voiceline":"방에서 바라보는 아름다운 밤 하늘은 싫지 않은데? 하지만 야간 출항은 조금 피해줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/main2.ogg"},"메인3":{"voiceline":"주제에서 조금 벗어났지만, 나는 스타일링에는 자신이 있다고? 히히, 그러니 다음 번에 한번 단장을 해줄까, 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/main3.ogg"},"전투개시":{"voiceline":"기함은 익숙해. 전 함대, 전투 대형 유지. tiro!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/battle.ogg"},"상세확인":{"voiceline":"어머? 우리 자매들이 아름답다는 이야기는 자주 듣지만, 지휘관이 계속 쳐다본다면 이상한 오해를 사게 되겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/detail.ogg"},"드랍 설명":{"voiceline":"차라급 중순양함—차라","voicelink":null},"의뢰 완료":{"voiceline":"이렇게 많은 물자를 안전하게 수송하다니, 정말 대단하네… 제대로 칭찬해줘야겠어, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/expedition.ogg"},"실망":{"voiceline":"안돼… 이런 지휘관은, 매력적인 곳이 단 하나도 없어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/feeling1.ogg"},"낯섦":{"voiceline":"지휘관이 어떤 고민이 있던, 다 들어줄게. 너무 걱정하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/feeling2.ogg"},"호감":{"voiceline":"폴라는 그렇게 보여도 사실 쉽게 상처받는 아이야… 만약 누가 그 아이를 괴롭힌다면… 설사 지휘관이라도 절대 용서하지 않아","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/feeling3.ogg"},"기쁨":{"voiceline":"모처럼 단 둘이 있는 기회인데, 지휘관은 뭔가 하고싶은 것 없어? … 귀를 파달라고? 그러면 먼저… 내 다리에 누워야겠네~ ……후후, 지휘관 너무 뻣뻣해. 힘 좀 빼봐~ 내가 부~드럽게 서비스 해줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/feeling4.ogg"},"사랑":{"voiceline":"이제는 지휘관과 말이 필요가 없는 사이가 됐네. 후후, 내가 지금 무슨 생각했는지 알아맞춰 볼래? ——당연히… 지휘관 생각을 하고 있지. 귀여운 바보~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격 수고했어~ 피로 회복용 와인이라도 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/home.ogg"},"hp 경고":{"voiceline":"내 장갑은… 아직 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/hp_warning.ogg"},"로그인":{"voiceline":"어서와, 지휘관. 차라와 자매들은 항상 너의 사열을 기다리고 있다고~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/login.ogg"},"실패":{"voiceline":"윽… 그 치욕적인 밤은 떠올리고 싶지 않은데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이 도착했어. 받지 않는다면 내가 큰 소리로 읽어버릴지도 모른다? 혹시 그 아이의 \"러브레터\"일 수도 있다고~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/mail.ogg"},"임무":{"voiceline":"에? 어려운 임무가 있어? 내가 한번 볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/mission.ogg"},"임무완료":{"voiceline":"임무 완수! 보상이 풍성하네. 지휘관도 칭찬받아야겠어. 착하다, 착하다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/mission_complete.ogg"},"서약":{"voiceline":"이렇게 작은 반지로 차라를 영원히 곁에 두고 싶어하다니… 너무 쉽게 생각한 것 아니야? ——아하하, 지휘관의 그런 표정, 정말 몇번 봐도 질리지 않아~ 장난이야, 장난. 반지같은 거 없어도 나는 지휘관 곁을 떠나지 않을테니 안심해——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/propose.ogg"},"스킬":{"voiceline":"내 방어를 쉽게 뚫을 생각은 하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/skill.ogg"},"터치1":{"voiceline":"지휘관… 내 사브르에 관심이 있는 거야? 아니면, 다른 곳에… 관심이 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/touch.ogg"},"터치2":{"voiceline":"아? ——…흠, 흠흠… 지휘관? 차라급의 자랑거리는 \"중갑방어\"뿐이 아니라고. 혹시 차라급의 위력을 직접 맛보고 싶은건 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/touch2.ogg"},"입수시":{"voiceline":"Ciao. 만나서 영광이야, 지휘관. 중순양함 차라, 너의 함대에 승리와 영광을 가져다 주지. 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/unlock.ogg"},"강화성공":{"voiceline":"Grazie! 이 주포는 적을 더 잘 잡을 수 있겠어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"말했던 것처럼 차라가, 널 위해 승리와 영광을 가져다 줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['워스파이트'] : 이번에는 맹우인가… 화력지원은 부탁할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/603020/couple_encourage1.ogg"}],"메인4":nu