main/audio/voiceline/107233/main2.ogg"},"메인3":{"voiceline":"지휘관님, 선물 포장 다 끝났어요. 크리스마스 트리로 옮기는 거 도와주시지 않을래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107233/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"물론 새러토가 선배에게 줄 선물은 올해도 준비했죠. 그렇지만 왠지 새러토가 선배… 기쁜 표정은 아닌 것 같던데…… 왜일까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107233/detail.ogg"},"드랍 설명":{"voiceline":"갈아입고는 왔는데…… 이게 진짜 '루돌프' 의상이라고? 좀 너무 대담한 느낌이…… 아, 지휘관님. 마침 잘 오셨네요. 여기, 제 크리스마스 선물이에요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"아, 잠깐, 지휘관님. 위험해요! ……죄, 죄송해요. 새러토가 선배처럼 선물을 함재기로 전달할 수 있을까 시험해보던 중이었는데… 하필이면 그 타이밍에 지휘관님이 돌아오셔서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107233/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"메리 크리스마스, 지휘관님. 같이 신나게 크리스마스를 즐겨봐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107233/login.ogg"},"실패":null,"우편":{"voiceline":"새로운 우편? 조금 있다가 선물 보낼 때 가지고 올게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107233/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"제가 웃는 모습이 좋으시다면…… 조, 조금 더 웃어 볼게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107233/touch.ogg"},"터치2":{"voiceline":"자, 잠깐만요! 리본이 풀리면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107233/touch2.ogg"},"입수시":{"voiceline":"갈아입고는 왔는데…… 이게 진짜 '루돌프' 의상이라고? 좀 너무 대담한 느낌이…… 아, 지휘관님. 마침 잘 오셨네요. 여기, 제 크리스마스 선물이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107233/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,