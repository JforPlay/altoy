ithubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/expedition.ogg"},"실망":{"voiceline":"아무래도 새러토가 선배의 지시를 받는 편이 더 낫겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 오늘도 차를 마시면서 전술에 관한 이야기를 나누실 건가요? 지, 지금은 좀… 방 정리를 좀 하고 올게요. 30분만 기다려 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/feeling2.ogg"},"호감":{"voiceline":"제 취미요? 책을 보거나 새러토가 선배의 전투 방식을 연구하는 것이에요… 이상하죠? 새러토가 선배는 엔터프라이즈와 비교해도 절대 지지 않을 거라고 생각해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/feeling3.ogg"},"기쁨":{"voiceline":"새러토가 선배는 겉보기에는 장난스럽지만 그 누구보다도 전투에 능숙하답니다. 그리고 후배들을 잘 돌봐주기도 하고요. 저도 전쟁터에서 몇 번이고 가르침을 받았어요. 그리고, 그리고… 응? 지휘관님, 지금 졸고 계시는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 이건…?! 새러토가 선배의 사진이 왜 지휘관님에게… 제 방 구석에서 발견하셨다고요? …으, 방심하다니… 이따가 다시 설명할게요! 그, 그러니까… 비밀 지켜주셔야 해요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"힘들어 보이시네요. 여기 타월이 있으니 땀을 닦으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/home.ogg"},"hp 경고":{"voiceline":"그때와 비교하면… 아직 멀었어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/hp_warning.ogg"},"로그인":{"voiceline":"오셨군요. 잘 쉬셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/login.ogg"},"실패":{"voiceline":"아직도 새러토가 선배에는 훨씬 못 미치는 것 같네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/lose.ogg"},"우편":{"voiceline":"우편? 제가 가져오지요. 지휘관님은 계속 업무에 집중해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107230/mail.ogg"},"임무":{"voiceline":"임무가 도착했나요? 그럼 출발하