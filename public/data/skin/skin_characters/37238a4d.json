[{"클뜯 id":201260,"클뜯 함순이 id":20126,"함순이 이름":"매치리스","한글 함순이 + 스킨 이름":"매치리스","영문 함순이 + 스킨 이름":"Matchless","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201260/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201260/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201260/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201260/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201260/shipyard.png","설명":"M급 구축함 - 매치리스 (G52)","자기소개":{"voiceline":"로열 네이비 M급 구축함, 매치리스야☆ 북극의 에스코트에서 노스케이프 해전, 퀸 메리의 호위 임무까지 참가했었어~ 이름은 강해 보이지만, 사실은 전~혀 안 세니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201260/profile.ogg"},"메인1":{"voiceline":"날 띄워 줘도 아무것도 안 나온다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201260/main1.ogg"},"메인2":{"voiceline":"우왓, 또 추워졌어……지휘관 씨, 출항 때 코트 좀 빌려도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201260/main2.ogg"},"메인3":{"voiceline":"계속 비서함 하고 싶다아~ 응? 뭐라고? 지금 아무 말도 안 했는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201260/main3.ogg"},"전투개시":{"voiceline":"지, 지휘관 씨에게 지켜질 수 있게 할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201260/battle.ogg"},"상세확인":{"voiceline":"누구라도 지키고 싶은 사람이 있지……그러니까, 지켜야 하는 아이는 나뿐만이 아니라구, 지휘관 씨☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201260/detail.ogg"},"드랍 설명":{"voiceline":"M급 구축함 - 매치리스 (G52)","voicelink":null},"의뢰 완료":{"voiceline":"위험하지 않은 수송 의뢰도 지휘관 씨와 함께 가고 싶네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201260/expedition.ogg"},"실망":{"voiceline":"나를 지키는 거……역시 무리인가……","