[{"클뜯 id":501030,"클뜯 함순이 id":50103,"함순이 이름":"창춘","한글 함순이 + 스킨 이름":"창춘","영문 함순이 + 스킨 이름":"Chang Chun","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501030/shipyard.png","설명":"안샨급 구축함 - 창춘 ","자기소개":{"voiceline":"이스트 글림 안샨급 구축함, 사천왕의 셋째, 창춘이야. 이스트 글림 해군의 기둥으로서, 선원 육성이나 노하우 축적에 크게 공헌했어. 응? 푸슌 언니 또 사고를 쳤다고…? 안샨 언니도 큰일이네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/profile.ogg"},"메인1":{"voiceline":"이래 봬도 우리들은 상당한 명가 출신이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/main1.ogg"},"메인2":{"voiceline":"여름에는 타이위안이 통기성이 좋은 걸 준비해주니까 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/main2.ogg"},"메인3":{"voiceline":"푸슌 언니, 밤에 혼자서 학교에 가면 무서운 '유령'과 마주칠 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/main3.ogg"},"전투개시":{"voiceline":"어째서 싸우는 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/battle.ogg"},"상세확인":{"voiceline":"푸슌이 산 건 여기 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/detail.ogg"},"드랍 설명":{"voiceline":"안샨급 구축함 - 창춘","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어! 내 딤섬도 있는 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/expedition.ogg"},"실망":{"voiceline":"지휘관…… 그러면 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/feeling1.ogg"},"낯섦":{"voiceline":"…'학교의 유령'? 나, '루퍼트 왕자의 눈물'이라는 게 유령에 효과적이라고 들어서 푸슌 언니에게 가르쳐준 것 뿐인데? 창문이 깨졌어? 잘 모르겠는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/feeling2.ogg"},"호감":{"voiceline":"응, 지휘관도 여길 발견했구나. 비밀기지? 에헤헤, 잘 모르겠는데~ 그러고 보니 지휘관, 내 간식 못봤어? …응? 그건 못 먹는 건데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 물놀이라면 학교 뒤편의 해변을 추천해. 응? 아무것도 꾸미고 있지 않아. 우연히 지휘관이 튜브를 산 걸 망원경 너머로 봐버려서. 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/feeling4.ogg"},"사랑":{"voiceline":"답답하니까 인형 옷을 벗어달라고? 에헤헤~ 지휘관이 하나 약속해주면 그럴게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"모두에게 마사지를 해 줄게. 내 손은 약손~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/home.ogg"},"hp 경고":{"voiceline":"재밌어질 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 좋은 아침~ 에헤헤~ 이제 아침은 아니지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/login.ogg"},"실패":{"voiceline":"윽, 실패한 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/lose.ogg"},"우편":{"voiceline":"새로운 우편? 흠흠, 마침 이 책상다리를 받칠 게 없어서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/mail.ogg"},"임무":{"voiceline":"임무…… 중요하지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/mission.ogg"},"임무완료":{"voiceline":"다음은… 어라, 뭔가 창고가 불타고 있어…? 아아! 내 딤섬이!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/mission_complete.ogg"},"서약":{"voiceline":"내게서 영원히 떨어지지 않는다고 약속해주면 이걸 받아줄게~ 뭐, 가끔은 거짓말이라도 믿는 게 내 장점이니까 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/propose.ogg"},"스킬":{"voiceline":"경금귀명의 백호, 나의 별자리를 지켜봐줘♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/skill.ogg"},"터치1":{"voiceline":"지휘관도 이 옷이 마음에 들면, 타이위안에게 한 벌 더 만들어달라고 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/touch.ogg"},"터치2":{"voiceline":"지휘관은 이런 사람이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/touch2.ogg"},"입수시":{"voiceline":"구축함 창춘, 착임했어~ 추위에 딱히 약한 게 아니야. 두껍게 입은 건 따뜻해서 기분 좋으니까 그런거라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/unlock.ogg"},"강화성공":{"voiceline":"미사일은…… 언제쯤이면 장착하는 걸까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"오늘도 아무 일 없는 날이네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['안샨'] : 응, 언니 말대로 경계할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/couple_encourage1.ogg"},{"voiceline":"['타이위안'] : 당황하지 말고 언니 뒤에 숨어있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501030/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영