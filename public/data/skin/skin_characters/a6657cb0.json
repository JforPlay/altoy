[{"클뜯 id":499010,"클뜯 함순이 id":49901,"함순이 이름":"론","한글 함순이 + 스킨 이름":"론","영문 함순이 + 스킨 이름":"Roon","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499010/shipyard.png","설명":"중순양함 - 론","자기소개":{"voiceline":"메탈 블러드의 순양함, 론입니다. 이전 세계에선 꽤 구상 단계에서만 존재했었습니다만……그보다도 지휘관, 제겐 보인답니다…당신의 마음속 깊은 곳의, 저와 닮은 듯한 '무언가' 가… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/profile.ogg"},"메인1":{"voiceline":"아름다운 것이 전장에서 무참히 짓밟히는 걸 볼 때마다, 저는…아아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/main1.ogg"},"메인2":{"voiceline":"지휘관의 마음, 치유해 드리고 싶어요. 음…어떻게 해야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/main2.ogg"},"메인3":{"voiceline":"취미? 방생하는 것입니다만, 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/main3.ogg"},"전투개시":{"voiceline":"후후, 저를 보고도 도망치려고 하다니, 설마 도망칠 수 있을 거라 생각하는 건가요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/battle.ogg"},"상세확인":{"voiceline":"지휘관은 일 말고 다른 취미는 없으신가요? 괜찮으시다면 같이 릴렉스 하지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 - 론","voicelink":null},"의뢰 완료":{"voiceline":"의뢰에 나간 아이들, 정말 열심이네요……자~ 한 줄로 서세요~ 지금부터 한 명씩 포옹해줄게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/expedition.ogg"},"실망":{"voiceline":"지휘관……용서 못 해!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/feeling1.ogg"},"낯섦":{"voiceline":"모항에서의 생활 말인가요? 문제없답니다. 다만……너무 평화로운 건 아닌지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/feeling2.ogg"},"호감":{"voiceline":"우리의 사명은 전장에서 서로 죽이는 것이죠……그러니, 서로 죽이는 것에 살짝 빠져있어도 정상이라고 생각 안 하세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/feeling3.ogg"},"기쁨":{"voiceline":"아아…함포의 포화로 적을 찢어발기고 산산조각내어 부숴버릴 때의 감촉……못 참겠네요……지휘관도 이해하시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/feeling4.ogg"},"사랑":{"voiceline":"후훗, 지휘관과 함께 있으면, 전장에서 적을 죽이는 때보다 더욱 충실감을 느낀답니다…이건 사랑의 힘인가요? 하지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"저도 적을 해치워버리고 싶어요~ 후후…적을 가라앉히면 가라앉힐수록 자신의 가치를 증명할 수 있게 되니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/home.ogg"},"hp 경고":{"voiceline":"나를 상처입히다니…용서 못 해!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/hp_warning.ogg"},"로그인":{"voiceline":"이 모항은 평화롭네요. 다들 정말 친절하시고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/login.ogg"},"실패":{"voiceline":"으윽…오늘은 유인 매복 전술인가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/lose.ogg"},"우편":{"voiceline":"나쁜 소식은 없죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/mail.ogg"},"임무":{"voiceline":"이번엔 어떤 임무인가요? 조금 기대되네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/mission.ogg"},"임무완료":{"voiceline":"다음 임무도 함께 힘내자고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/mission_complete.ogg"},"서약":{"voiceline":"고맙습니다. 그런데 말이죠, 저…이제야 깨달았답니다. 마음의 틈을 메우는 것은 전투에서의 살육도 사랑도 아니라, '질투' 라는 이름의 증오란 것을…지휘관? 당신을 사랑하는 것만큼, 다른 아이들을 격렬히, 격렬히, 격렬히 증오한답니다…더는…용서할 수 없어!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/propose.ogg"},"스킬":{"voiceline":"나를…얕보지 마!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/skill.ogg"},"터치1":{"voiceline":"지휘관, 앙~하세요……후후, 어떤가요? 전보다 더 잘 만들어졌나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/touch.ogg"},"터치2":{"voiceline":"응? 지휘관도 저와 포옹하고 싶으세요? 좋아요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/touch2.ogg"},"입수시":{"voiceline":"설마 내가 이곳에 오다니……안녕하세요, 론이라고 합니다. 아직 이곳에 익숙하지 않으니, 안내를 부탁드려도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 고맙습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"나를 보고도 자침하지 않을 뿐만 아니라 가라앉히는데 내 손까지 번거롭게 하다니…용서 못 해!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":499011,"클뜯 함순이 id":49901,"함순이 이름":"론","한글 함순이 + 스킨 이름":"다크레드 스마일","영문 함순이 + 스킨 이름":"Dark Red Grin","스킨 타입":"Party Dress","전체 일러":"htt