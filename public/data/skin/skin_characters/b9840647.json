[{"클뜯 id":9703010,"클뜯 함순이 id":970301,"함순이 이름":"트렌토·META","한글 함순이 + 스킨 이름":"트렌토·META","영문 함순이 + 스킨 이름":"Trento META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703010/shipyard.png","설명":"중순양함 트렌토, 지휘관을 보좌하러 왔습니다. 제 등장으로 지휘관님이 더 성장할 수 있다면, 더할 나위 없겠죠.","자기소개":{"voiceline":"중순양함 트렌토입니다. 전방 작전이든, 후방 작전이든, 뭐든 맡겨 주세요. 제가 여기 있는 이유… 말씀이신가요? 그야 지휘관의 함선인걸요. 당연히 지휘관을 보좌하기 위함이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/profile.ogg"},"메인1":{"voiceline":"한가해지면 이것저것 괜한 생각이 드니까… 오히려 뭐든 작업이 있는 편이 집중하기 쉬운 때도 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/main1.ogg"},"메인2":{"voiceline":"결단을 내리는 자로서, 망설임은 치명타가 될 수도 있어요. 하지만, 누구든 감정에 얽매이고 말지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/main2.ogg"},"메인3":{"voiceline":"피곤하세요? 아, 잠깐만 기다려주세요. 지금 가볍게 드실 만한 걸 만들테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/main3.ogg"},"전투개시":{"voiceline":"윽……. 지금은 다른데 정신이 팔려 있을 때가 아니에요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/battle.ogg"},"상세확인":{"voiceline":"지휘관 곁에 있으면 마음이 편해요. 기분 나쁜 환영으로 고통받지 않아도 되고…. 지휘관에게는 신비로운 힘이 있는 것 같아요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 트렌토 <color=#92fc63>(해당 META 캐릭터를 이미 보유 중인 경우, 보상이 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐습니다. 성공적으로 수행한 아이들을 맞이하러 갈게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/expedition.ogg"},"실망":{"voiceline":"이곳도 마음이 불안해지는 건 마찬가지네요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/feeling1.ogg"},"낯섦":{"voiceline":"안색이 안 좋다구요? 후후, 괜찮아요. 별로 즐겁지 않은 꿈을 꾼 것 뿐…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/feeling2.ogg"},"호감":{"voiceline":"지휘관은 악몽으로 여러 번 가위에 눌려본 경험 있나요? 그럴 때는 어떻게……. 아, 아니에요. 말하기 어려우면, 굳이 말하지 않아도….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/feeling3.ogg"},"기쁨":{"voiceline":"생각대로 잘 안 풀리는 일은 없나요? 고민이 있으면 제가 뭐든 들어 드릴게요. ……그것보다 제가 더 걱정이라구요? 후후, 괜찮아요. 예전과 비교해서 지금은 꽤 괜찮아졌으니까…. 이것도 다 잘하고 있는 지휘관 덕분인걸요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/feeling4.ogg"},"사랑":{"voiceline":"행복한 꿈을 꿨답니다. 평화로운 모항, 지휘관, 모두가 제가 만든 요리를 둘러싸고 즐겁게 식사를 하는 꿈을…. 후후, 잘 생각해보면, 이 꿈은 지휘관 덕분에 거의 이뤄진 거나 마찬가지지만요. 자, 아~ 하세요. 제가 먹여드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"읏?! …휴우, …또 기분 나쁜 환영이…. 아뇨, 괜찮아요~ 잠깐 멍하니 있었을 뿐, 아무 것도 아닙니다. 그것보다 뭐라도 먹고 체력을 보충하지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/home.ogg"},"hp 경고":{"voiceline":"아, 아직 끝나지 않았어요……. 윽.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/hp_warning.ogg"},"로그인":{"voiceline":"제시간에 돌아오셔서 마음이 놓이네요. 업무를 시작하시기 전에, 우선은 오늘 일정을 살펴보시지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/login.ogg"},"실패":{"voiceline":"퇴각하죠. 우린 이런 곳에서 끝날 만큼 약하지 않아요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/lose.ogg"},"우편":{"voiceline":"새로운 우편입니다. 소중한 거라면 꼭 보관해두세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/mail.ogg"},"임무":{"voiceline":"새로운 임무입니다. 조금만 더 힘냅시다. 저도 도울테니깐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐습니다. 네, 참 잘…… 했어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/mission_complete.ogg"},"서약":{"voiceline":"모든 것이 제겐 너무 사치스러운 바람이라고 생각했는데, 설마 실현될 줄이야……. 행복한 꿈을 꾸는 것보다, 그 꿈이 실현되는 편이 좋죠….언젠가 지휘관이 악몽으로 가위에 눌린다면, 제 곁으로 오세요. 저… 트렌토가 푹 재워드릴테니…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/propose.ogg"},"스킬":{"voiceline":"전투에 집중해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/skill.ogg"},"터치1":{"voiceline":"포옹 말씀이신가요? 그러니까… 이렇게? 아, 너무 힘을 준 것 같네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/touch.ogg"},"터치2":{"voiceline":"후후후, 조금 정도는 응석부려도 괜찮답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/touch2.ogg"},"입수시":{"voiceline":"중순양함 트렌토, 지휘관을 보좌하러 왔습니다. 제 등장으로 지휘관님이 더 성장할 수 있다면, 더할 나위 없겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/unlock.ogg"},"강화성공":{"voiceline":"이 힘이 더욱 더 지휘관과 모두에게 힘이 될 수 있도록….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리는… 우리 것입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_e