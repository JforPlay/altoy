voiceline/301320/feeling1.ogg"},"낯섦":{"voiceline":"어느 사탕도 맛있어 보여, 못 고르겠어… 지히간, 도와줘─","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/feeling2.ogg"},"호감":{"voiceline":"지히가─안! 가─치─노─올─자─아─! 뭐 하고 싶어? 지히간, 골라봐─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/feeling3.ogg"},"기쁨":{"voiceline":"지히간! 오늘은 소꿉놀이하자! 지히간이 아빠, 무츠키가 엄마, 야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/feeling4.ogg"},"사랑":{"voiceline":"「여보! 오늘은 또 그 여자 만나러 간 거야!? …아직도 나한테 숨길 거야!? 도… 도둑고양이의 냄새가 나!」…응? 이거, TV에서 봤어! …무슨 뜻이냐구? 몰라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지히간이 오기 전에… 앗!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지히간도 사탕 먹고싶어? 내꺼 안 줄 꺼야─","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/login.ogg"},"실패":{"voiceline":"우우… 지히간…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/lose.ogg"},"우편":{"voiceline":"지히간한테, 편지─! 갖고 싶으면, 무츠키한테 사탕, 줘─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/mail.ogg"},"임무":{"voiceline":"임…무─? 뭐야? 사탕?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/mission.ogg"},"임무완료":{"voiceline":"상, 상, 사탕, 사탕♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/mission_complete.ogg"},"서약":{"voiceline":"서…약? 사이 좋은 거? 으무… 알았어! 지히간, 사탕 줄께! 이걸로 사이좋네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/propose.ogg"},"스킬":{"voiceline":"사탕의 힘, 보여줄 꺼야~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301320/ski