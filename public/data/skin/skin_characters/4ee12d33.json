[{"클뜯 id":9701060,"클뜯 함순이 id":970106,"함순이 이름":"카스미·META","한글 함순이 + 스킨 이름":"카스미·META","영문 함순이 + 스킨 이름":"Kasumi META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701060/shipyard.png","설명":"카스미…… 왔어. 지휘관. 카스미는 뭘 하면 돼?","자기소개":{"voiceline":"카스미에게는 다른 사람 눈에는 안 보이는 게 보여… 그리고 느껴져. 카스미는 혼자가 아니야. 외톨이라도 무섭지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/profile.ogg"},"메인1":{"voiceline":"푸른 불꽃? ……지휘관 눈에도 보여?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/main1.ogg"},"메인2":{"voiceline":"혼자인 거에…… 카스미, 익숙해졌어. 안 무서워. 지휘관, 카스미는 이제 아무것도 두렵지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/main2.ogg"},"메인3":{"voiceline":"카스미가 내린 차, 좋아? 맘에 들면 지휘관이 돌아올 때마다 내려줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/main3.ogg"},"전투개시":{"voiceline":"강 건너편으로… 보내줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/battle.ogg"},"상세확인":{"voiceline":"카스미… 아사시오급 카스미야. 지휘관, 카스미는 혼자여도 괜찮아. 이제부터 어디로 향하면 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/detail.ogg"},"드랍 설명":{"voiceline":"카스미…… 왔어. 지휘관. 카스미는 뭘 하면 돼?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 사람들이 돌아오는 걸 봤어. 다들 지휘관을 기다리고 있어. 지휘관. 너무 오래 기다리게 하지는 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/expedition.ogg"},"실망":{"voiceline":"카스미는 혼자여도 괜찮으니까… 혼자 있게 해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 둥실이 기억해? 미안…… 카스미, 아직은 둥실이에 대해 말하고 싶지 않아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/feeling2.ogg"},"호감":{"voiceline":"둥실이는 머나먼 곳으로 여행을 떠났지만, 가끔은 카스미를 만나러 와. 둥실이가 돌아오면 카스미, 굉장히 강해져……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/feeling3.ogg"},"기쁨":{"voiceline":"강해진 카스미는…… 좀 적응이 안 돼? 그럴 거 없어. 카스미는 그대로니까. 지휘관…… 카스미가 강해져서… 무서워?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/feeling4.ogg"},"사랑":{"voiceline":"카스미의 「힘」에는 평소에는 제한을 걸어두고 있어. 그 제한을 해제하지 않으면 둥실이는 못 돌아와. 그렇지만 지휘관이 있으니까 카스미는 혼자가 아니야. ……둥실이가 사라지기 전부터 느끼고 있었어. 지휘관은 없어서는 안 될 소중한 존재란걸……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/feeling5.ogg"},"터치3":{"voiceline":"카스미의 머리, 차가워…… 지휘관, 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/headtouch.ogg"},"모항귀환":{"voiceline":"따뜻한 차를… 카스미가 준비했어. 지휘관… 자, 마셔.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/home.ogg"},"hp 경고":{"voiceline":"카스미, 여기서 가라앉을 수는 없어……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 어서 와……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/login.ogg"},"실패":{"voiceline":"제한을 풀어야 해…… 둥실아… 다른 사람들을 지켜줘…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/lose.ogg"},"우편":{"voiceline":"카스미, 지휘관 앞으로 온 우편을 가지고 왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/mail.ogg"},"임무":{"voiceline":"새로운 임무가 왔어. 지휘관… 게으름 피우는 건 좋지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/mission.ogg"},"임무완료":{"voiceline":"임무 완료…… 지휘관, 보수는 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 카스미를 선택해 준 거야? 정말? 지휘관은 카스미에게 가장 소중한 사람…… 카스미, 지휘관이랑 계속 함께 있고 싶어. 카스미도 더는… 외톨이가 아니야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/propose.ogg"},"스킬":{"voiceline":"지나가시오…… 지나가시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/skill.ogg"},"터치1":{"voiceline":"지휘관…… 카스미랑 이야기하고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/touch.ogg"},"터치2":{"voiceline":"지휘관, 흑… 카스미에게 그런 짓을……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/touch2.ogg"},"입수시":{"voiceline":"카스미…… 왔어. 지휘관. 카스미는 뭘 하면 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/unlock.ogg"},"강화성공":{"voiceline":"카스미…… 더 선명하게 보여.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"카스미, 이겼어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0