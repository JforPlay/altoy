[{"클뜯 id":9702080,"클뜯 함순이 id":970208,"함순이 이름":"보이시·META","한글 함순이 + 스킨 이름":"보이시·META","영문 함순이 + 스킨 이름":"Boise META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9702080/shipyard.png","설명":"지휘관님, 저는 「META」의 보이시……책무이므로, 당신과 당신의 함대에 필요한 방호를 제공하게 해 주세요.","자기소개":{"voiceline":"브루클린급 경순양함 「META」 보이시야…… 지휘관을 지키기 위해 왔어. 마스크는 내 힘의 일부니까 너무 신경쓰지 마…… 앞으로는 계속 같이 항해하자……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/profile.ogg"},"메인1":{"voiceline":"마스크를 쓰고 있다고 딱히 불편하지는 않아. 익숙하니까…… 마, 만져보고 싶다고? 음…… 그건……안 돼……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/main1.ogg"},"메인2":{"voiceline":"늘 지휘관을 보고, 지키고 있으니까 믿어줘…… 그저…… 남들보다 조금 조용할뿐이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/main2.ogg"},"메인3":{"voiceline":"……지휘관, 누구든 괴롭히는 사람이 있으면 말해줘. 내가 열심히…… 그쪽한테 자중해달라고 부탁할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/main3.ogg"},"전투개시":{"voiceline":"후… 하… 후… 하… 시작해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/battle.ogg"},"상세확인":{"voiceline":"이 마스크는 중요하니까 절대 만지면 안 돼…… 특별한 설비랑 연결되어 있는데… 그 설비가 멀쩡히 돌아가야 전투 중에도 지휘관을 안전하게 지킬 수 있거든…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/detail.ogg"},"드랍 설명":{"voiceline":"브루클린급 순양함·보이시<color=#92fc63>（1척만 소지할 수 있습니다. 2척째를 입수했을 경우, 한계 돌파 소재로 변환됩니다）</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 끝났어. 고생하고 온 동료들을… 같이 위로해주러 가지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/expedition.ogg"},"실망":{"voiceline":"……지휘관, 모두의 안전은 어떻게 하려고 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/feeling1.ogg"},"낯섦":{"voiceline":"잠수…? 더 깊이 들어갈 수는 있지만… 그래도 쉽지는 않아…… 지휘관, 혹시 내가 잠수해서 정찰해야 하는 임무라도 있는 거야……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/feeling2.ogg"},"호감":{"voiceline":"후… 하… 후… 하… 응? 심호흡하고 있었어. 이러면 마음이 금방 차분해지거든…… 지휘관도 한번 해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/feeling3.ogg"},"기쁨":{"voiceline":"그러고보니 지휘관이랑은 정말 많은 격전을 돌파해 왔지… 이렇게 느긋하게 보내는 시간이…… 드물게 느껴질 정도로.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/feeling4.ogg"},"사랑":{"voiceline":"나한테 내릴 특별한 지시라도 있어? 아니면 그냥 내 옆에 있고 싶다던가…? 뭐든 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/feeling5.ogg"},"터치3":{"voiceline":"마, 마스크는 만지지 마……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와. 컨디션은 괜찮아 보이네… 그래도 다쳤을 때는 꼭 나한테 알려줘야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/home.ogg"},"hp 경고":{"voiceline":"다들…… 위험…해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/hp_warning.ogg"},"로그인":{"voiceline":"오늘 할 일은…… 지휘관에게 도움이 돼서 기뻐…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/login.ogg"},"실패":{"voiceline":"마스크는 아직 괜찮아…… 지휘관,다들 후퇴시켜 줘. 내가 엄호할게…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔어. 내가 읽어줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/mail.ogg"},"임무":{"voiceline":"지휘관, 다음 임무를 처리할 시간이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/mission.ogg"},"임무완료":{"voiceline":"이제 임무 완료지? 응…… 뭔가 요령이 좀 생긴 것 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/mission_complete.ogg"},"서약":{"voiceline":"내가 있는 한… 내가 모두를 지키는 한…… 위험한 일은 절대 일어나게 두지 않아. 이게 지휘관의 맹세에 대한 대답…… 보이시의 약속이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/propose.ogg"},"스킬":{"voiceline":"……다들, 내 보호 아래서 움직여!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/skill.ogg"},"터치1":{"voiceline":"지휘관? ……듣고 있으니까 말해 봐…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/touch.ogg"},"터치2":{"voiceline":"후… 하… 후… 하… 방금 아무 일도 없었지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/touch2.ogg"},"입수시":{"voiceline":"지휘관, 난 「META」 보이시야. ……지휘관과 너희 함대를 방호하는 건 내 책무니까, 나한테 맡겨 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/unlock.ogg"},"강화성공":{"voiceline":"마스크의 힘이 강해졌어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"위협 제거 완료. 다들 무사해? …다행이다. 후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9702080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인