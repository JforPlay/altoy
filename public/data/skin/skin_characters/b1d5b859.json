.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"모두가 자신의 방식으로 여름의 해변을 즐기고 있네요. 지휘관님도 어울리시는 게 어떤가요? 모래성이나 비치 발리볼 같은… 저요? 저는 여기서 모두를 지켜보는 것으로 만족해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807011/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 어디가 안좋으신가요? ...... 그냥 너무 덥다구요? 음, 알겠어요, 여긴 빈 공간이 많으니까, 앉으세요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관님, 방금 수영을 하고 오셨지요? 여기 새 타올이 있으니 사용하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 튜브가 필요하신가요? 저쪽에 있는 아이들과 놀 때 요긴하게 쓰일지도 몰라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807011/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"수영복이 매력적이라고요? …지휘관님, 사실 모두에게 이런 칭찬을 하시는 것은 아닌가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807011/touch.ogg"},"터치2":{"voiceline":"엉큼한 짓은 남들이 보지 않는 곳에서 한다라… 역시 지휘관님이시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807011/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 어디가 안좋으신가요? ...... 그냥 너무 덥다구요? 음, 알겠어요, 여긴 빈 공간이 많으니까, 앉으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"수영복","상점 id":703