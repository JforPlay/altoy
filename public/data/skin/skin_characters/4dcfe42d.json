[{"클뜯 id":303060,"클뜯 함순이 id":30306,"함순이 이름":"치쿠마","한글 함순이 + 스킨 이름":"치쿠마","영문 함순이 + 스킨 이름":"Chikuma","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303060/shipyard.png","설명":"토네급 중순양함 2번함・치쿠마","자기소개":{"voiceline":"토네급 중순양함 치쿠마라고 합니다. 다른 순양함에 비해 수상기 탑재 수가 뛰어나죠. 즉, 하늘을 나는 '눈'을 꽤나 많이 갖고 있답니다. 후후후, 정보를 보다 쉽게 모을 수 있을 것 같지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/profile.ogg"},"메인1":{"voiceline":"지휘관의 소문이요? ... 어머, 신경 쓰이신다면 직접 알아보는 걸 추천드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/main1.ogg"},"메인2":{"voiceline":"재미있는 정보를 수집하는 걸 좋아합니다만… 글쎄요, 아오바는 좋아할 것 같네요. 이런 이야기는~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/main2.ogg"},"메인3":{"voiceline":"수상기의 '눈'이 정비가 필요하듯, 저나 지휘관의 눈에도 충분한 휴식을 줘야겠죠. 그편이 더 잘 볼 수 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/main3.ogg"},"전투개시":{"voiceline":"전장의 양상은 이미 이 '눈'으로 파악했습니다. 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/battle.ogg"},"상세확인":{"voiceline":"정보가 많을수록 주도권을 쥐게 되지요. 전투에서는 물론, 일상에서도… 그쵸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/detail.ogg"},"드랍 설명":{"voiceline":"토네급 중순양함 2번함・치쿠마","voicelink":null},"의뢰 완료":{"voiceline":"음… 수상기의 정보에 따르면, 슬슬 의뢰팀 일행이 모항에 돌아왔을 시간일까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/expedition.ogg"},"실망":{"voiceline":"죄송해요. 지휘관 같은 사람은 조금…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/feeling1.ogg"},"낯섦":{"voiceline":"자, 수상기의 '눈'에 무엇이 비췄는지 확인해보죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/feeling2.ogg"},"호감":{"voiceline":"어머, 제가 뭘 알고 있는지 궁금하시나요? 으음~ 모항의 모두의 지휘관에 대한 호감도 같은 거? 농담이에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/feeling3.ogg"},"기쁨":{"voiceline":"으음~ 궁금하다고 하셔도 갑자기 알려드리기는 좀 그렇네요… 그래, 지휘관이 제 부탁들 하나 들어주시면, 지휘관이 궁금하신 정보 하나를 가르쳐드리는 건 어때요? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/feeling4.ogg"},"사랑":{"voiceline":"후후후, 비밀을 알려드리는 조건으로, 저랑 데이트해주셔야겠어요♪ …설마, 뒤늦게 후회했다, 라는 말은 하기 없기에요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/feeling5.ogg"},"터치3":{"voiceline":"귀를 튕겨보고 싶으신가요? 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/headtouch.ogg"},"모항귀환":{"voiceline":"출격 수고하셨습니다. 전투 보고서 작성은 어떠신지요? 오늘의 경험을 미래의 승리의 밑거름으로 삼도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/home.ogg"},"hp 경고":{"voiceline":"이 정도는… 뒤쳐질 만한 건 아닙니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/hp_warning.ogg"},"로그인":{"voiceline":"시간은… 좋아, 예상했던대로네요. 어서 오세요, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/login.ogg"},"실패":{"voiceline":"정보 수집이 미흡했던 탓이군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔습니다. 새로운 정보를 놓치시지 않도록 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/mail.ogg"},"임무":{"voiceline":"지휘관, 업무를 방치하는 건 그다지 좋은 습관이 아니라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/mission.ogg"},"임무완료":{"voiceline":"임무 보상… 종류는 다양합니다만, 세부적인 확인은 지휘관께서 맡아주실 수 있겠어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/mission_complete.ogg"},"서약":{"voiceline":"치쿠마가 전혀 놀라지 않아서 조금 실망하셨나요? 그럴 리가요. 저도 놀랐답니다? 지금은 놀라움보다 기쁨이 훨씬 클 뿐이에요♡ 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/propose.ogg"},"스킬":{"voiceline":"아는 게 곧 힘이에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/skill.ogg"},"터치1":{"voiceline":"도움을 요청하는 건, 한 번 스스로 정보를 정리한 후에 하는 게 좋다고 생각해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/touch.ogg"},"터치2":{"voiceline":"지휘관의 약점을 또 하나 잡은 것 같네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/touch2.ogg"},"입수시":{"voiceline":"치쿠마입니다, 처음 뵙겠습니다… 이렇게 말해야 하겠지만, 사실 전 지휘관에 대해 알고 있어요~ 아주 많이요. 제가 어떻게 아는지 알고 싶나요? 후후~ 우선 비밀입니다. 앞으로 천천히 알게 될 거에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/unlock.ogg"},"강화성공":{"voiceline":"색적 능력도 향상된 것 같군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아는 것과 보이는 것이 같다면, 승리도 필연… 이랄까요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"♪~ 어머, 뭐하고 있는지 궁금하신가요? 정보 수집이에요. 지휘관님은 의외로 무방비한 구석이 많으시네요. 후후후♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303060/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"어머, 데이트 신청해 주시는 건가요? 으음~ 저는 보답으로 뭘 알려드려야할까요… 후후후, 오늘 제가 가보고 싶은 곳은 어떨까요?","voicelink":"https://raw