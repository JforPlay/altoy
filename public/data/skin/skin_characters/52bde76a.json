[{"클뜯 id":9707010,"클뜯 함순이 id":970701,"함순이 이름":"히류·META","한글 함순이 + 스킨 이름":"히류·META","영문 함순이 + 스킨 이름":"Hiryuu META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707010/shipyard.png","설명":"저는 히류, 2항전의 히류입니다. 이왕 가입하게 되었으니, 지휘관의 명에 따르겠습니다. 지휘관이... 진정으로 함대를 지휘할 자격이 있는 사람이길 바랍니다.","자기소개":{"voiceline":"항공모함, 2항전 히류입니다... 저는 병사, 싸울 수 있는 병사입니다. 지휘관은 이것만 알고 계시면 충분합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/profile.ogg"},"메인1":{"voiceline":"엔터프라이즈? 적으로든, 또는 아군으로든 존경할 만한 존재죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/main1.ogg"},"메인2":{"voiceline":"하나후다요? 지금은 놀 생각할 때가 아니죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/main2.ogg"},"메인3":{"voiceline":"평상시의 단련은 솜씨를 자랑하기 위한 게 아니에요. 전장에서 더욱 잘 동료를 보호하고, 적을 처치하기 위함이지요. 안 그래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/main3.ogg"},"전투개시":{"voiceline":"병사는 신속함이 첫째죠! 함재기, 출격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/battle.ogg"},"상세확인":{"voiceline":"제 쪽에서 한가하게 빈둥댈 시간이 있으면, 항구의 다른 동료들에게 더 관심을 가져 주는 것도 괜찮을 텐데요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/detail.ogg"},"드랍 설명":{"voiceline":"히류호 항공모함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"물자가 풍족한 지금을 소중히 여기세요. 언젠가 다시 그리워질 거니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/expedition.ogg"},"실망":{"voiceline":"... 신경 쓰지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/feeling1.ogg"},"낯섦":{"voiceline":"더 이상 묻지 마세요. 이제 저는 지휘관의 병사이고, 지휘관은 저의 지휘관일 뿐이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/feeling2.ogg"},"호감":{"voiceline":"전장에서는 순간의 주저함이 전체의 패배를 초래할지도 모르죠. 그래서, 전 전투하지 않을 때도 어떻게 승리를 가져올지 생각해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/feeling3.ogg"},"기쁨":{"voiceline":"강적을 만나더라도, 자신에게 승산이 전혀 없음을 알더라도, 서슴없이 싸울 건가요?——\"중요한 것을 지키기 위해서라면\"...이요? 흥, 순진하긴 하지만, 싫진 않네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/feeling4.ogg"},"사랑":{"voiceline":"지휘관의 몸에서 굳건한 \"신념\"을 느낄 수 있어요. 지휘관이라면, 혹시... 아, 저도 순진한 면이 있나 보군요...... 아니에요, 아무튼, 전 지휘관을 인정했어요. 제가 지휘관의 가장 예리한 칼날이 될 테니, 절 마음껏 휘두르세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"전 신경 쓰지 마시고, 지휘관이 해야할 일을 하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/home.ogg"},"hp 경고":{"voiceline":"아직... 절망할 때는 아닙니다!","voicelink":null},"로그인":{"voiceline":"말씀해 주시죠. 오늘 섬멸해야 할 적들은 어디있는지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/login.ogg"},"실패":{"voiceline":"언니... 미안......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/lose.ogg"},"우편":{"voiceline":"지휘관의 편지입니다. 잘 챙기세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/mail.ogg"},"임무":{"voiceline":"자질구레한 일들이 잔뜩 있네요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/mission.ogg"},"임무완료":{"voiceline":"임무를 완성하셨으면, 어서 보고하고 보상을 수령하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/mission_complete.ogg"},"서약":{"voiceline":"이게 바로... 서약의 증명인가요? 알았어요. 지휘관이 저, 이 \"명검\"을 이렇게 아껴주니, 저도 지휘관의 뜻에 순응할 수밖에 없군요. 아쉬운 건, 제가 상냥하지도 않고, 몸매도 좋지 않아서, 서운하시겠네요, 하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/propose.ogg"},"스킬":{"voiceline":"지금이 바로 분발할 때입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/skill.ogg"},"터치1":{"voiceline":"무슨 일 있으면 말해 주세요. 그렇게 걱정할 필요 없습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/touch.ogg"},"터치2":{"voiceline":"!? ... 다음엔, 정말로 벨 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/touch2.ogg"},"입수시":{"voiceline":"저는 히류, 2항전의 히류입니다. 이왕 가입하게 되었으니, 지휘관의 명에 따르겠습니다. 지휘관이... 진정으로 함대를 지휘할 자격이 있는 사람이길 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/unlock.ogg"},"강화성공":{"voiceline":"...... 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"한 차례 전투의 부분적인 승리는, 결코 지나치게 기뻐할 만한 것이 아니에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기