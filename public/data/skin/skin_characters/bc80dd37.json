[{"클뜯 id":302070,"클뜯 함순이 id":30207,"함순이 이름":"유라","한글 함순이 + 스킨 이름":"유라","영문 함순이 + 스킨 이름":"Yura","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302070/shipyard.png","설명":"나가라급 경순양함 4번함・유라","자기소개":{"voiceline":"나가라급 경순양함 유라입니다. 그 대전에선 제 4 수뢰전대의 기함을 담당했습니다. 과거에는 자매함보다 다소 먼저 무대에서 내려왔습니다만, 이번에야말로 마지막까지 버텨내는 '나'를 보여드리도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/profile.ogg"},"메인1":{"voiceline":"지휘관님, 차가 너무 뜨거우시다면… 음… 제가 후~ 후~ 해드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/main1.ogg"},"메인2":{"voiceline":"아부쿠마 언니? 먹고 자기만 하는 건 좋지 않다고 생각합니다만? 아니라구요? 어쩜…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/main2.ogg"},"메인3":{"voiceline":"구축함 아이들은… 그렇군요, 늘 기운차게 여기저기 돌아다니는 통에, 좀처럼 보조를 맞추기가 어려운 것 같습니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/main3.ogg"},"전투개시":{"voiceline":"조금 더 상태를 지켜보는 게 좋을지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/battle.ogg"},"상세확인":{"voiceline":"때때로, 제가 제 자신이 아닌 것 같은 기분이 듭니다… 그것도 분명 '나' 때문이겠죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/detail.ogg"},"드랍 설명":{"voiceline":"나가라급 경순양함 4번함・유라","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔습니다. 일손이 부족하다면 '나'도 가도록 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/expedition.ogg"},"실망":{"voiceline":"혹시, 점괘에서 나온 '재앙'은 지휘관님이었을까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 제게 맡기실 임무가 없으시다면, 뒷산에 있는 신사 일을 도우러 가보도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/feeling2.ogg"},"호감":{"voiceline":"나' 말인가요? 아아, 그 또한 저라고 해야할지… 으음… 지휘관님도 이해하시기 쉽게 설명드리자면, '시키가미' 같은 거라고 해야겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/feeling3.ogg"},"기쁨":{"voiceline":"점괘를 보니… 지휘관님께 악운이 닥치겠군요. 이건 아부쿠마 언니들과 만든, 사악한 기운을 피하는 부적과 행운을 부르는 부적입니다. 방심하시지 마시고 늘 지니고 계시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/feeling4.ogg"},"사랑":{"voiceline":"지휘관님 생각을 할 때마다, '혹시 무슨 일이 생긴다면'하고 저도 모르게 걱정하게 되네요. '나'… 아니, 제가 늘 곁에 있도록 해주시겠어요? 그렇게 해주신다면, 저도 분명 더는 걱정하지 않아도 될 테니까요","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/feeling5.ogg"},"터치3":{"voiceline":"제 뿔을 만져보시려는 겁니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/headtouch.ogg"},"모항귀환":{"voiceline":"잘 돌아오셨습니다. 죄송합니다. 이 서류는 어디에 두어야 할지 잘 모르겠어서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/home.ogg"},"hp 경고":{"voiceline":"진형을 재정비하는 편이 좋겠군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 그러니까… 환영합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/login.ogg"},"실패":{"voiceline":"일단, 철수하는 게 좋을지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/lose.ogg"},"우편":{"voiceline":"내가' 읽어드리도록 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/mail.ogg"},"임무":{"voiceline":"어머, 지휘관님. 이 임무는 너무 방치해두지 않는 편이 좋을 것 같습니다만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/mission.ogg"},"임무완료":{"voiceline":"어머, 그러고 보니… 임무 완료 보상을 받을 수 있단 거… 말하지 않았던가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/mission_complete.ogg"},"서약":{"voiceline":"지휘관님과 결혼하게 되다니… 정말 괜찮나요? 후후후, 너무 기뻐서 어쩔 줄 모르겠어요… 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/propose.ogg"},"스킬":{"voiceline":"우선은 신중히 가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/skill.ogg"},"터치1":{"voiceline":"제게 무슨 볼일이 있으신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/touch.ogg"},"터치2":{"voiceline":"지휘관님께 시집가는 수밖에 없겠네요. 후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/touch2.ogg"},"입수시":{"voiceline":"저... 혹시 모항의 지휘관님이 어디 계신지 아시나요? 저는 방금 막 착임한 유라라고 해요——에, 당신이 지휘관님!? 그… 신분증 같은 거 있나요? 확인해 보고 싶어서요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/unlock.ogg"},"강화성공":{"voiceline":"어머, 지금 무슨 일이 일어난 것 같은데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"'나' 덕분이네요. 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/win_mvp.ogg"},"전투개시_ex":{"voiceline":"힘이 넘치는 것 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/battle_ex.ogg"},"상세확인_ex":{"voiceline":"'나'는 착한 아이예요. 지휘관님도 분명 저처럼 친해지실 수 있을 거예요. 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302070/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"'내가' 항상 저를 곁에서 지켜주듯이, 저도 지휘관님을 