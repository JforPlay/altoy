[{"클뜯 id":301300,"클뜯 함순이 id":30130,"함순이 이름":"카미카제","한글 함순이 + 스킨 이름":"카미카제","영문 함순이 + 스킨 이름":"Kamikaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301300/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301300/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301300/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301300/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301300/shipyard.png","설명":"카미카제형 구축함 1번함·카미카제","자기소개":{"voiceline":"카미카제형 구축함 1번함, 카미카제일세. 제1 구축대에 소속된 이 이름, 힘찬 울림이지 않은가? (웃음) 대전쟁 초기부터 태평양 제도를 전전하며, 허투루 함대의 대선배 노릇을 한 게 아닐세. 이래 뵈도, 대잠전이 특기라네. 그 이리 떼 놈들과의 사투를 떠올릴 때마다 피가 끓어오르는구먼~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/profile.ogg"},"메인1":{"voiceline":"마지막까지 버티는 자야말로 승자일세!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/main1.ogg"},"메인2":{"voiceline":"호크빌! 이 몸에 비할 정도는 아니네만, 그야말로 무사라 할 만한 자였네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/main2.ogg"},"메인3":{"voiceline":"제5 전대… 괜찮은 자들이었네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/main3.ogg"},"전투개시":{"voiceline":"잠수함과 어뢰를 조심하게. 전력으로 가겠네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/battle.ogg"},"상세확인":{"voiceline":"호오~ 지휘관은 이 몸의 어디에 흥미가 있다는 겐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/detail.ogg"},"드랍 설명":{"voiceline":"카미카제형 구축함 1번함·카미카제","voicelink":null},"의뢰 완료":{"voiceline":"오늘도 의뢰라는 것을 무사히 해냈는가. 음, 수고 많았네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/expedition.ogg"},"실망":{"voiceline":"지휘관은 의외로 시시한 족속이구먼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 장비를 옛것이냐 새것이냐로 따지는 것은 수준 낮은 초짜배기들이나 하는 짓일세.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/feeling2.ogg"},"호감":{"voiceline":"취미? 충분한 숙식과, 지휘관을 만지작거리는 것 정도겠구먼. (큰 웃음) 그 표정을 보고 싶었다네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/feeling3.ogg"},"기쁨":{"voiceline":"음, 지휘관은 어떤 아이가 취향인지 궁금하구먼~ 이몸인가? 아니면 단아한 쪽인가? ──그건 진심인가? 자~ 보시게, 확실히 녹음해두었다네☆ 그럼, 그 아이에게 들려주도록 할까─","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/feeling4.ogg"},"사랑":{"voiceline":"(소곤) 지휘관… 이 몸은 그대를, 마음에 들어 하고 있는 것일세♡ ──글쎄, 지휘관, 얼굴이 달아올랐구먼~ 귀까지 시뻘겋게 되어서는.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"자, 오늘도 무사히 돌아왔구먼! 상으로 이 몸이 직접 만든 영양 음료라도 마시게! 자자~ 사양 말게나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"아, 왔는가~ 오늘은 왠지 이상한 일이라도 하는 겐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/login.ogg"},"실패":{"voiceline":"으윽… 이 성능으로는 역시 따라주질 못하는 겐가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/lose.ogg"},"우편":{"voiceline":"전서… 유니온의 사자, 가 아닐까 싶구먼…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/mail.ogg"},"임무":{"voiceline":"시중인가. 보러 가겠는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/mission.ogg"},"임무완료":{"voiceline":"음? 시중의 급료인가? 어디 보자, 옮길 때는 주의하게나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301300/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 지금이라면 아직 마음을 바꿔도 늦지 않다네~ 옳지 