main/audio/voiceline/101140/feeling1.ogg"},"낯섦":{"voiceline":"왜 내가… 칫, 귀찮은 녀석을 만났구만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/feeling2.ogg"},"호감":{"voiceline":"지휘관은 의외로 차분하네. 그럼 좀 더 어울려줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/feeling3.ogg"},"기쁨":{"voiceline":"날 일일이 부르는 것도 귀찮지? 이제 그냥 네 방에 머물도록 할게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/feeling4.ogg"},"사랑":{"voiceline":"아─아… 귀찮은데, 나도 모르게 뭔가 해주고 싶게 되어버리는 기분… 귀찮아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"비서함이란 거, 귀찮아… 졸려… Zzz…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"매일 인사를 해야 한다니… 귀찮아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/login.ogg"},"실패":{"voiceline":"칫, 귀찮아… 못 어울려주겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/lose.ogg"},"우편":{"voiceline":"편지야. 나중에 '안 알려줬어' 같은 소리 하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/mail.ogg"},"임무":{"voiceline":"귀찮네, 더 빠릿빠릿하게 할 순 없는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/mission.ogg"},"임무완료":{"voiceline":"하아, 어째서 매번 보너스를 잘 챙기라고 주의를 주지 않으면 안 되는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/mission_complete.ogg"},"서약":{"voiceline":"귀찮지만… 지휘관을 위해서라면 어쩔 수 없지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/propose.ogg"},"스킬":{"voiceline":"하아… 귀찮아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101140/skill.ogg"},"터치1":{"voiceline":"지휘관… 적당히 