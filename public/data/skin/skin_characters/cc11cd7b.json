[{"클뜯 id":101480,"클뜯 함순이 id":10148,"함순이 이름":"잉그레이엄","한글 함순이 + 스킨 이름":"잉그레이엄","영문 함순이 + 스킨 이름":"Ingraham","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101480/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101480/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101480/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101480/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101480/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101480/shipyard.png","설명":"알렌 M. 섬너급 구축함—잉그레이엄, 현호 DD-692","자기소개":{"voiceline":"음… 생각해 봐도 역시 소개할 게 없어… 차라리… 내가 만든 알렌 M. 섬너급 미니어처를 보여줄까? 이건 주포고, 이건 대공포, 이건 심해 폭탄 장치야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/profile.ogg"},"메인1":{"voiceline":"지휘관, 여기서 이거 만드는데 네 업무 방해하진 않았겠지?… 그럼 됐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/main1.ogg"},"메인2":{"voiceline":"양말이 없다고? 아침에 깜박했나봐… 됐어, 중요한 거 아냐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/main2.ogg"},"메인3":{"voiceline":"나사가 옷장 밑으로 떨어진 것 같아… 저기, 내가 주울 거야, 넌 이상한 곳만 쳐다보지 않으면 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/main3.ogg"},"전투개시":{"voiceline":"각 모듈 조정 완료. 출격할 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/battle.ogg"},"상세확인":{"voiceline":"물건을 파괴하는 것은 어렵지 않아. 하지만 물건을 하나 만드는 건 정말 어렵지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/detail.ogg"},"드랍 설명":{"voiceline":"알렌 M. 섬너급 구축함—잉그레이엄, 현호 DD-692","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 끝났어. 괜찮다면 내가 자투리 부품 가져가도 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/expedition.ogg"},"실망":{"voiceline":"만약 네 머리에 나사가 있다면, 난 무조건 안에 어떤 이상한게 있나 열어볼 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/feeling1.ogg"},"낯섦":{"voiceline":"어떤 부품에 아주 조금의 오차라도 제조품 전체의 결과에 영향을 줄 수 있어…… 그러니까, 정확성을 반드시 보장해야해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/feeling2.ogg"},"호감":{"voiceline":"쿠퍼, 저번에 말한 \"변신 도구\" 완성했어...... 잠깐, 알렌, 이상한 스티커 맘대로 붙이지마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 내가 남는 시간에 부품들 모아서 훈장 만들었어. 이리 와봐, 달아 줄게——풋, 꽤 잘 어울리네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 앞으로 무슨 일 있으면 나 찾아와도 돼…… 아 물론 아무 일 없을 때도 괜찮아. 아무튼, 네가 곁에 없으면 좀 외로우니까…… 크, 크흠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/feeling5.ogg"},"터치3":{"voiceline":"머리핀? 손에 닿는대로 집은 건데… 이상해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/headtouch.ogg"},"모항귀환":{"voiceline":"음… 여기가 역시 안 맞았구나, 1mm 정도…… 아, 지휘관, 마침 잘 왔어, 이것 좀 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/home.ogg"},"hp 경고":{"voiceline":"아! 여기 보수하기 정말 귀찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/hp_warning.ogg"},"로그인":{"voiceline":"너 지각했네? 지휘관에게 멈추지 않는 알람 시계를 만들어 주는게 좋을려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/login.ogg"},"실패":{"voiceline":"아… 돌아가서 이 장비들 잘 점검해 봐야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/lose.ogg"},"우편":{"voiceline":"우편… 내가 우편함 업그레이드시켜 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/mail.ogg"},"임무":{"voiceline":"새로운 임무? 아, 여기저기 다니고 싶지 않은데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/mission.ogg"},"임무완료":{"voiceline":"임무 완료 확인 서류에 서명할 펜 찾아? 자, 이거 빌려줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/mission_complete.ogg"},"서약":{"voiceline":"난 또 네가 비교적 둔한 건줄 알았는데, 이렇게 주동적일 줄이야. 참, 이건 직접 만든 반지야…… 이 서약의 반지와는 비교할 수 없지만, 네가 소중히 여겨줬으면 좋겠어. 난 두 개는 만들고 싶지 않으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/propose.ogg"},"스킬":{"voiceline":"내 탓은 안 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/skill.ogg"},"터치1":{"voiceline":"야, 아무렇게나 건드리지마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/touch.ogg"},"터치2":{"voiceline":"바로 이 손 맞지? 나한테 잡히면 잘못했다고 할 때까지 캘리퍼스로 집을 거야——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/touch2.ogg"},"입수시":{"voiceline":"이글 유니온 구축함, 잉그레이엄이야. 음... 특별히 소개할 건 없는데... 아무튼 앞으로 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/unlock.ogg"},"강화성공":{"voiceline":"장비 강화… 그런대로 괜찮은 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아, 장비 상태 퍼펙트~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['알렌 M. 섬너'] : 알렌, 너무 풀어지면 안돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101480/couple_en