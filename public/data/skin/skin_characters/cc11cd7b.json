료수를 마시는 거야. 그리고 맛이랑 느낌을 나한테 말해주면 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101481/detail.ogg"},"드랍 설명":{"voiceline":"음… 단맛을 더 추가해도 되겠어… 그리고 이걸 좀 더…——음? 왔어? 좋아, 이제부터 넌 시음 인원 1호야. 창의적인 음료수를 만들기 위해서 같이 노력하자!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료했어. 안에 레시피로 쓸만한 게 있는지 볼게……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101481/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"새로운 음료수 개발 성공하면, \"골드 시음 멤버\" 훈장을 만들어 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101481/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘은 지각 안 했네, 보상으로 이거 한 잔 줄게. 당도 2배짜리야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101481/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"!? 다음 번에 고농축 레몬즙 만들어 준다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101481/touch2.ogg"},"입수시":{"voiceline":"음… 단맛을 더 추가해도 되겠어… 그리고 이걸 좀 더…——음? 왔어? 좋아, 이제부터 넌 시음 인원 1호야. 창의적인 음료수를 만들기 위해서 같이 노력하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101481/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"카니발","상점 id":70586,"상점 카테고리 id":16,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2025/08/27)","진영":"USS","레어도":"SSR","ex_chat_status":0}]