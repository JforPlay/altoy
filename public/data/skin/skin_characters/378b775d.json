[{"클뜯 id":103110,"클뜯 함순이 id":10311,"함순이 이름":"위치타","한글 함순이 + 스킨 이름":"위치타","영문 함순이 + 스킨 이름":"Wichita","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103110/shipyard.png","설명":"위치타급 중순양함·위치타 (CA-45)","자기소개":{"voiceline":"유일무이한 바다의 맹장, 그건 나 위치타 님이다! \n내가 직접 손쓰면 항공모함이라도 유린해 보이지── 그러니 지휘관이여, 너의 힘도 기대하도록 하겠어.\n","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/profile.ogg"},"메인1":{"voiceline":"어뢰? 물러터졌군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/main1.ogg"},"메인2":{"voiceline":"보이는가, 우리는 저 드넓은 바다의 끝을 향할지니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/main2.ogg"},"메인3":{"voiceline":"이 거포의 일사로 해결하지 못할 문제 따위 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/main3.ogg"},"전투개시":{"voiceline":"전군, 포격 개시! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/battle.ogg"},"상세확인":{"voiceline":"중순의 기준인 나의 힘, 맛보도록!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/detail.ogg"},"드랍 설명":{"voiceline":"위치타급 중순양함·위치타 (CA-45)","voicelink":null},"의뢰 완료":{"voiceline":"응? 의뢰가 완료됐나…… 흥, 내 함대의 강성함이 있다면 의뢰 따윈 간단한 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/expedition.ogg"},"실망":{"voiceline":"흥, 나도 보는 눈이 없는 듯하다…… 설마 이런 도움 안 되는 자를 의지할 줄은……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/feeling1.ogg"},"낯섦":{"voiceline":"나의 꿈은 세계 정복이다! 세계를 정복한 후? 흥, 그런 것 알까보냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/feeling2.ogg"},"호감":{"voiceline":"이 채찍에 흥미가 있나? 뭐 예전에 적당히 산 물건인데 의외로 사용하기 편리하더군. 특히 지도를 칠 때 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/feeling3.ogg"},"기쁨":{"voiceline":"이제 와서지만 나의 방자함에 어울려줘서 사실은 감사하고 싶은 것이다… 앞으로도 어울려도 된다고? 하핫! 역시 내가 찾아낸 지휘관이다! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/feeling4.ogg"},"사랑":{"voiceline":"지휘관이여. 처음엔 농담이었지만, 지금은 우리가 힘을 합치면 혹시 정말로 이 바다를 정복할 수 있을지도 모른다! 뭐, 내 것은 네 것이야, 반으로 할 필요도 없겠지. 그렇지 않나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘 수고했다. 너도 쉬도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/home.ogg"},"hp 경고":{"voiceline":"비장의 계획이라도 펼쳐보는 게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/hp_warning.ogg"},"로그인":{"voiceline":"돌아왔나. 나를 기다리게 하다니, 어서 출정 준비나 하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/login.ogg"},"실패":{"voiceline":"이거야말로 재미있어. 흥, 철수한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/lose.ogg"},"우편":{"voiceline":"편지 같은 건, 너에게 일임하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/mail.ogg"},"임무":{"voiceline":"새로운 임무? 읽어보도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/mission.ogg"},"임무완료":{"voiceline":"이 나에게 보너스라고!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/mission_complete.ogg"},"서약":{"voiceline":"너에 대해선 친구…… 아니, 친구로서 있을 생각은 없다── 잠깐 기다려, 지금 정리하지, 아니, 딱히 거절한다는 건… 조금 마음을 정리하게 해줘……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/propose.ogg"},"스킬":{"voiceline":"이 일격으로 끝낸다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/skill.ogg"},"터치1":{"voiceline":"뭐야, 겨루어보고 싶어졌나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/touch.ogg"},"터치2":{"voiceline":"이 채찍을 맛보고 싶은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관인가? 좋아, 오늘부터 너는 내 참모다. 이 바다를 정복하기 위해 힘을 다해라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/unlock.ogg"},"강화성공":{"voiceline":"이 힘이 있으면……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"하! 송사리들 따위, 상대도 되지 않는군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['런던', '카가'] : 아하하하하하하! 이 나를 만족시킬 비책을 펼쳐 보여라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103110/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0},{"클뜯 id":103111,"클뜯 함순이 id":10311,"함순이 이름":"위치타","한글 함순이 + 스킨 이름":"\"장군\"의 저녁 만찬","영문 함순이 + 스킨 이름":"The General's Banquet","스킨 타입":"Party 