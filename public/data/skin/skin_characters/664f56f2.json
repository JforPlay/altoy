[{"클뜯 id":807020,"클뜯 함순이 id":80702,"함순이 이름":"팽르베","한글 함순이 + 스킨 이름":"팽르베","영문 함순이 + 스킨 이름":"Painlevé","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/807020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/807020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/807020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/807020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/807020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/807020/shipyard.png","설명":"조프르급 항공모함 - 팽르베","자기소개":{"voiceline":"소망' 덕분에 이 자리에 이렇게 설 수 있게 된 항공모함 팽르베예요. 소망을 이루는 건 쉬운 일이 아니라, 때로는 후회와 희생도 필요로 하죠…… 그렇다고 무언가 소망하는 마음을 포기해서는 안 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/profile.ogg"},"메인1":{"voiceline":"지휘관님, 기도는 뭐든지 이뤄주는 소원 기계가 아니랍니다. 지나친 기원은 되도록 자제해 주시길… 그렇지 않으면 천벌이 내릴지도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/main1.ogg"},"메인2":{"voiceline":"지휘관님, 실은 저…… 그게, 음… 아무것도 아닙니다. 방금 건 신경 쓰지 말아주세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/main2.ogg"},"메인3":{"voiceline":"점성술, 타로 카드, 커피 점술, 그리고 '팔괘'…… 오늘은 어떤 걸로……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/main3.ogg"},"전투개시":{"voiceline":"오늘은 축복받은 행운의 날인 걸요. 분명… 괜찮을 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/battle.ogg"},"상세확인":{"voiceline":"마음 속에 강한 소망을 품어야만, 우리는 더 멀리 나아갈 수 있어요. 지휘관님, 아이리스의 축복을 받는 여행자로서 부디 명심하시기를……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/detail.ogg"},"드랍 설명":{"voiceline":"조프르급 항공모함 - 팽르베","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 귀환했어요. 출발 전에 오늘 하루동안 축복을 받을 수 있는 '행운의 아이템'을 추천해 드렸으니, 분명 좋은 성과를 거뒀을 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/expedition.ogg"},"실망":{"voiceline":"지휘관님과 만난 후부터 불길한 징조가 늘어난 것 같아요. 이건 대체……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/feeling1.ogg"},"낯섦":{"voiceline":"아…… 음…… 네, 지휘관님께서 소망하시는 바는 잘 알고 있어요. 저로서는 지금은 계속 이 상태를 유지하는 편이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/feeling2.ogg"},"호감":{"voiceline":"축복받은 '행운의 아이템', 괜찮으면 받아 주시겠어요? …네! 분명 지휘관님께도 행운을 가져다줄 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님은…… 제 생각을 바로 알아주시네요. 후후후, 굳이 말로 하지 않아도 상대방에게 마음을 읽히는 느낌…… 나쁘지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/feeling4.ogg"},"사랑":{"voiceline":"기도를 드리면 머릿속에 바로 지휘관님 모습이 떠올라서, 요새는 기도도 행복하게…… 대, 대체 무슨 말을 하는 걸까요, 저…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님께서 외출하신 동안 계속 여기서 기도를 드리고 있었답니다. …아, 마실 것과 간식도 준비해 뒀어요. 괜찮으시면 다 함께 드시는 게 어떠세요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/home.ogg"},"hp 경고":{"voiceline":"저의 소망에… 답을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관님. 조금만 있으면 기도가 끝나니, 잠시만 기다려 주실 수…… 있으실까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/login.ogg"},"실패":{"voiceline":"어째서…… 기도가 모자랐던 걸까요? 아니면 불길한 징조를 제가 미처 눈치채지 못한 걸까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/lose.ogg"},"우편":{"voiceline":"새 우편…… 휴우… 좋은 소식이길……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/mail.ogg"},"임무":{"voiceline":"임무에는…… 어쩌면 '행운을 부르는 순서'가 있을지도 몰라요. 아, 그러니까 순서대로 처리하면 좋은 일이 일어난다…는 의미로…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/mission.ogg"},"임무완료":{"voiceline":"임무가 모두 완료되었네요. '행운을 부르는 순서'는 효과가 있었나요? 보상이 더 많이 들어 오거나 하진 않았고요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/mission_complete.ogg"},"서약":{"voiceline":"사실은 소망하는 게 참 많지만…… 후후, 지금은 딱 하나, 곧 이뤄질 것 같은 소망으로 머리가 가득해요. 지휘관님, 제 소망을 이뤄주셔서 정말 감사합니다. 지휘관님을 좋아하길….. 정말 잘했어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/propose.ogg"},"스킬":{"voiceline":"나의 행동은 곧 아이리스의 소망……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/skill.ogg"},"터치1":{"voiceline":"지휘관님…… 제가 해주었으면 하는 게 있는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/touch.ogg"},"터치2":{"voiceline":"죄, 죄송해요. 지금은 이런 건……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/touch2.ogg"},"입수시":{"voiceline":"아이리스 리브레의 조프르급 항공모함 2번함 팽르베예요. 인사 말씀드립니다…… 그리고 당신께, 모든 동료에게 아이리스의 행운이 깃들기를……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/unlock.ogg"},"강화성공":{"voiceline":"네…… 지휘관님께서 원하시는 바라면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우리의 소망이…… 닿은듯 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관님께서 지금 소망하시는 건? ……아, 아뇨! 말씀하지 않으셔도 괜찮아요. 후후후, 좋아하는 분과 같은 걸 소망하면 서로 더 가까워질 수 있다는 말을 들은 것뿐이라…...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/807020/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"지휘관님, 의뢰에서 돌아온 동료들 마중하러 같이 나가요. …아, '행운의 아이템