oicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔소! 그들에게 줄 선물이… 엣, 어디 갔단 말이오??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301093/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관 나리, 조금 전에 여기서 만난 적이 있지 않소이까… 소, 소인이 한 바퀴를 빙 돌았다고!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301093/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 나리, 오늘밤 이 선물들을 제때 배송해야만 한다오. 만약 함께하길 원한다면, 지금 바로 움직여야 하오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301093/login.ogg"},"실패":{"voiceline":"자, 자세가 흐트러지면 아니되오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301093/lose.ogg"},"우편":null,"임무":{"voiceline":"야간의 모항에서는 불가사의한 만남이 있을 수 있다고? 지지지,지휘관 나리! 소, 소인은 그런 일 따위로 동요하지 않는다오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301093/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관 나리, 혹시…… 소인을 잘 보호할 수 있겠소?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301093/touch.ogg"},"터치2":{"voiceline":"우왓! 로 로프를 놓치겠소!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301093/touch2.ogg"},"입수시":{"voiceline":"우오옷! 지휘관 나리, 비키시오! 소인은 산타를 도와 모항의 사람들에게 선물을 배송 중이오. 더 이상 시간을 지체할 수 없소! … 이 방향이 아니란 말이오? 에에엑?!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301093/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,