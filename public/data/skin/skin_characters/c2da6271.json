? 그건 무엇이오?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이…… 으와앗?! 위, 위험했소…. 지휘관, 받아줘서 고맙소….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301094/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"어서 오시오, 지휘관 나리! 자, 속행하도록 하겠소! 하압! 보시오, 은신술!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301094/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"윽, 기술 시연이 아니라 구경거리 제공이라니…. 그, 그렇지만 소인은 이 정도로는 낙심하지 않소!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301094/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무로군…. 공연을 더 알차게 만들기에 딱 좋겠소.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301094/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관 나리, 자유로이 관람해도 좋소!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301094/touch.ogg"},"터치2":{"voiceline":"마, 만지는 건 금지라오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301094/touch2.ogg"},"입수시":{"voiceline":"제6구축대 공연장에 오신 걸 환영하오, 지휘관 나리! 지금부터 이 소인이 먼저 최강의 인술을 펼쳐 보이겠소! …'서커스'? 그건 무엇이오?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301094/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"소인의 인술은 곡예가 아니라 진짜… 아, 아마도 그럴 것이라오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301094/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":n