,"voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705012/detail.ogg"},"드랍 설명":{"voiceline":"그렇게나 많은 술들을 전부 맛보았지만, 역시 내가 가진 것이 최고군. 자, 동지여, 휴일을 축하하며, 보드카 한 잔 즐기자고!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"방이 지저분하다고? 동지 말이 일리가 있어. 그럼 정리를 해볼까! 근데, 어디서부터 시작해야 해? 잡지부터 아니면, 술병부터?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"동지여, 설마 함께 술을 마시러 온 거야? 마침 잘 왔어. 이건 아브로라가 가지고 온 보드카, 네게 따라줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705012/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"어서, 동지여, 내게 술 한잔 따라주렴!… 설마, 이 정도 술에 취할 거라고 생각한 건 아니겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705012/touch.ogg"},"터치2":{"voiceline":"동지여, 취한 건가. 그래도 괜찮아. 소파를 빌려줄 테니, 여기 누워서 쉬도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705012/touch2.ogg"},"입수시":{"voiceline":"그렇게나 많은 술들을 전부 맛보았지만, 역시 내가 가진 것이 최고군. 자, 동지여, 휴일을 축하하며, 보드카 한 잔 즐기자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705012/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"홈웨어","상점 id":70511,"상점 카테고리 id":20,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"SN","레어도":"SR","ex_chat_status":0}]