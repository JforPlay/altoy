[{"클뜯 id":705010,"클뜯 함순이 id":70501,"함순이 이름":"강구트","한글 함순이 + 스킨 이름":"강구트","영문 함순이 + 스킨 이름":"Gangut","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705010/shipyard.png","설명":"강구트급 전함—강구트 ","자기소개":{"voiceline":"나는 노스 유니온의 강력한 전함, 강구트! 구형이라고 얕보지 말게나. 사람이던 전함이던 약할 수록 강력함을 갈망하고, 궁지에 몰릴 수록 революция을 추구한다네. 발트해에서 레닌그라드까지, 치욕을 참고 최후의 순간까지 싸웠기 때문에 찬란하게 빛날 수 있었다네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/profile.ogg"},"메인1":{"voiceline":"동지여, 한 잔 하지 않겠는가… 뭐? 보드카 한 잔에 쓰러지면 안 되는 것 아닌가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/main1.ogg"},"메인2":{"voiceline":"동지여! 이 해군들의 이야기를 들으니 가슴이 뛰지 않는가? 그것이 바로 혁명자, 인생의 빛이라네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/main2.ogg"},"메인3":{"voiceline":"쉽게 이기다니? 동지여, 그게 무슨 헛소리인가? 고전하지 않으면 전력을 다하지 않는다네! 다음 번에는 나를 더 위험한 전장으로 보내주게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/main3.ogg"},"전투개시":{"voiceline":"우리의 용기를 보여주게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/battle.ogg"},"상세확인":{"voiceline":"패배하고 넘어지고, 진흙탕에서 구를지라도 다시 한번 일어날 수 있는 힘——그것이 우리가 추구하는 революция(혁명), 우리가 사랑하는 небо(천국)이라네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/detail.ogg"},"드랍 설명":{"voiceline":"강구트급 전함—강구트","voicelink":null},"의뢰 완료":{"voiceline":"‘얼음 여정’때와 같은 씁쓸한 귀항이 아닌, 이번 동료들이 가지고 오는 것은 희망이로군. 마중하러 가지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/expedition.ogg"},"실망":{"voiceline":"무모함을 용기로 삼는 자에게는 미래가 없다네, 동지여.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/feeling1.ogg"},"낯섦":{"voiceline":"나는 전함 강구트. 다른 이름으로 나를 불러도 좋다네. 하지만 이름보다 더 중요한 것은 결과지. 너무 구애받지 말고 좋을 대로 부르면 된다네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/feeling2.ogg"},"호감":{"voiceline":"동지여, 오해하지 말게. 이것은 우리의 싸움이기도 하지만 그대의 전투이기도 하다네. 현재에 안주하지 말고 함께 앞으로 나아가세.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/feeling3.ogg"},"기쁨":{"voiceline":"아하하하하! 잘 했다네! 동지여! 이제 곧 서로의 생명, 용기, 모든 것을 걸고 수많은 어려움과 적에게 도전하겠지! 이보다 더 혁명적인 일이 있겠는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/feeling4.ogg"},"사랑":{"voiceline":"단도직입적으로 말 하겠네! 동지의 빛이 나를 감동시켰다네——그래, 그대를 좋아한다네 이제 내 앞에 있는 것을 ‘동지를 향한 사랑’의 도전이라고 부르겠네! 자, 내 사랑의 포옹을 받게나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오오, 동지여. 승리의 개선인가? 승패를 떠나서 최선을 다 하는 것이면 충분하다네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/home.ogg"},"hp 경고":{"voiceline":"후하하하하! 이제야 내가 있어야 할 전장 같군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/hp_warning.ogg"},"로그인":{"voiceline":"동지여. 오늘은 어떤 적과 싸워야 하는가? 나 강구트가 함께 싸워주도록 하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/login.ogg"},"실패":{"voiceline":"동지여, 이것은 패배가 아닌 각성이라네! 혁명의 초심을 잊지 않게 각성하는 것이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/lose.ogg"},"우편":{"voiceline":"편지가 왔다네. 동지여, 어서 열어보게나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/mail.ogg"},"임무":{"voiceline":"명령은 질서를 유지하기 위해 존재하네. 더 큰 계획을 위해 빨리 끝내도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/mission.ogg"},"임무완료":{"voiceline":"잘 했다네! 이 상은 우리 혁명에 좋은 찬사가 될 터이니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/mission_complete.ogg"},"서약":{"voiceline":"서약…인가. 이제와서 큰 의미는 없다만, 동지와의 관계가 한 걸음 더 나아갔다는 증명이라고 생각하니 큰 수확이겠지. 좋아, 건배하세나! 동지여! 앞으로도 잘 부탁한다네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/propose.ogg"},"스킬":{"voiceline":"혁명에 축복을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/skill.ogg"},"터치1":{"voiceline":"장비? 우리가 더 강해질 수 있다면 모두 사용할만 하지. 굉장히 합리적인 생각 아닌가? 나는 내가 약하다는 사실이 달갑지 않다네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/touch.ogg"},"터치2":{"voiceline":"동지여, 이게 무슨 짓이지? 설마 노스 유니온의 처벌이 무겁다는 것을 모르지는 않을텐데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/touch2.ogg"},"입수시":{"voiceline":"후하하하! 잘 해왔구나, 동지여! 함께 힘을 모아서 이 푸른 바다를 지키기 위해 노력하세나! 이 한몸 스러질 때까지, 온 힘을 다해서!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/unlock.ogg"},"강화성공":{"voiceline":"동지여, 그대도 강해져야 한다네! 그리고 나와 함께 전장에서 빛나야 하지 하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"축하하지! 우리는 자격이 있다네! 이 기쁨을 다음 승리의 밑거름으로 삼지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"그렇군. 동지는 나의 장비에 대해서 더 알고 싶었던 건가! 얼마든지! 아주 용기있는 행동이라네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/touch_ex.ogg"},"터치2_ex":{"voiceline":"동지이니 따지지 않겠네! 용감한 행동에 칭찬을 보내지! 자, 마음껏 만지게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['미카사'] : 후하하하! 같이 싸울 날이 있을 줄은 몰랐다네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/couple_encourage1.ogg"},{"voiceline":"['아브로라'] : 혁명의 빛을 비추거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"동지여~ 조금 더 마시게나~ 마라 녀석이 어울려주지 않으니~ 해가 뜰 때까지 달려보세~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"nil","voicelink":null},"메인3_ex":{"voiceline":"강적이 없나? 그렇군. 동지가 욕구불만이란 말인가… 걱정말게. 내가 상대해 주지. 덤비게! 생명을 불태워 보세!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705010/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SR","ex_chat_status":1},{"클뜯 id":705011,"클뜯 함순이 id":70501,"함순이 이름":"강구트","한글 함순이 + 스킨 이름":"단호한 집행자","영문 함순이 + 스킨 이름":"Imposing Warden","스킨 타입":"Special Exercise","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705011/shipyard.png","설명":"동지여, 이번 연습을 준비해 준데 감사하지! 죄악을 막고, 벌을 내리며 그들을 갱생시키는 중대한 책임! 받아들이지!","자기소개":null,"메인1":{"voiceline":"메탈 블러드나 이글 유니온 느낌이 나지 않는가? 후후, 너무 무섭게 분장하면 꼬맹이들이 놀라 자빠지겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705011/main1.ogg"},"메인2":{"voiceline":"’여기는 강구트… 감시 구역은 모두 정상이다. 계속 순찰하겠다.’","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705011/main2.ogg"},"메인3":{"voiceline":"동지여, 술이 마시고 싶은가? 좋다네! 빈 시간이 있으니 같이 마셔주도록 하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"동지여, 죄를 시인하기에는 아직 이르다네! 온 힘을 다해 저항하게나. 마지막까지 필사적으로 도망치게! 그래야 진정한 성장을 이룰 수 있다네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705011/detail.ogg"},"드랍 설명":{"voiceline":"동지여, 이번 연습을 준비해 준데 감사하지! 죄악을 막고, 벌을 내리며 그들을 갱생시키는 중대한 책임! 받아들이지!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"동지여, 연습을 보러 왔는가? 하하하. 궁금한 것이 있다면 물어보게. 아는 것은 전부 대답해 주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705011/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무에 어려움이 있는가? 조사할 것이 있다면 도와줄 수 있다네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705011/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"벽에 있는 배지? 장식을 위한 복제품일 뿐이라네. 가지고 싶다면 얼마든지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705011/touch.ogg"},"터치2":null,"입수시":{"voiceline":"동지여, 이번 연습을 준비해 준데 감사하지! 죄악을 막고, 벌을 내리며 그들을 갱생시키는 중대한 책임! 받아들이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임