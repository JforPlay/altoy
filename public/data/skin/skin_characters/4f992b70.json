[{"클뜯 id":207120,"클뜯 함순이 id":20712,"함순이 이름":"인도미터블","한글 함순이 + 스킨 이름":"인도미터블","영문 함순이 + 스킨 이름":"Indomitable","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207120/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207120/shipyard.png","설명":"일러스트리어스급 항공모함 인도미터블","자기소개":{"voiceline":"일러스트리어스급 4번함으로서 세 언니와 조금 다른 부분은 있어요…. 잠깐, 전적이나 수리 기간이 아니라, 탑재기 숫자를 말하는 거라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/profile.ogg"},"메인1":{"voiceline":"어머, 다과회 초청이요? …사양할게요. 시종일관 우아한 태도를 유지하는 건 피곤해요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/main1.ogg"},"메인2":{"voiceline":"잠깐 조는 건 체력 회복을 위해서, 멍하니 있는 건 정신적 조화를 위해서, 산책하는 건 기분 전환을 위해서. 어쨌든 쉬는 건 다 나름 목적이 있어요. 땡땡이가 아니라구요. 전~혀.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/main2.ogg"},"메인3":{"voiceline":"휴우… 의욕이 안 생기네요…. 업무요? 이미 다 처리해뒀어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/main3.ogg"},"전투개시":{"voiceline":"기, 기함이라구요? 귀찮아…가 아니라, 갑니다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/battle.ogg"},"상세확인":{"voiceline":"동형함 언니들은 다들 우수해요. 난처한 일이 있으면, 우선은 언니들에게…. 저요? 뭐, 이야기 정도는 못 들어 드릴 것도 없죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/detail.ogg"},"드랍 설명":{"voiceline":"일러스트리어스급 항공모함 인도미터블","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네요. 여기서 기다려드릴테니, 어서 확인해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/expedition.ogg"},"실망":{"voiceline":"하아… 괜히 기대해서 손해 봤네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 지금 바쁘세요? …한창 바쁘신 것 같네요. …으흠, 그럼… 계속 열심히 하세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/feeling2.ogg"},"호감":{"voiceline":"취미…요? …갑자기 물어보시니까 딱히 생각이 안 나네요. 글쎄요… 무언가를 하는 것 보다는, 아무것도 하지 않아도 되는 쪽이 더 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/feeling3.ogg"},"기쁨":{"voiceline":"매우 바쁜 때야말로 적절한 휴식이 필요한 때죠. 머리를 비우고 긴장을 푸는 건 말처럼 그렇게 쉽지가 않답니다. 지휘관님, 잘 모르셔도 괜찮아요. 후후훗, 다음에 제가 차근차근 알려드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/feeling4.ogg"},"사랑":{"voiceline":"후훗, 지휘관님도 땡땡이… 으흠, 휴식의 중요성이 몸에 배어들기 시작하셨나요? 매우 바람직해요. 좋아요, 앞으로는 정기적으로 '아무것도 생각하지 않는' 연습을 하도록 해요! 장소는… 제 방 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/feeling5.ogg"},"터치3":{"voiceline":"앗?! 정말, 멍때리고 있었는데 왜 방해하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 출격하느라 고생하셨어요. …딱히 게으름 피우고 있던 건 아니에요. 작전이 잘 진행되도록 기도를 드리고 있었던 것뿐이라고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/home.ogg"},"hp 경고":{"voiceline":"이대론 위험하겠어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 안녕하세요. 어머, 벌써 업무 시작하시려구요? 우선은 컨디션을 가다듬은 다음에 해도…. 자, 창문을 열고 바람을 좀 쐬는 건 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/login.ogg"},"실패":{"voiceline":"또 수리를 해야 하는 건가…. 뭐, 상관없어요. 그동안 편하게 지낼 수 있을 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/lose.ogg"},"우편":{"voiceline":"새로운 우편? 어쩌면 휴가 공지일지도…. 응? 그럴 리 없다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/mail.ogg"},"임무":{"voiceline":"새로운 임무네요. …지휘관님처럼 전투 경험이 풍부한 분께는 식은 죽 먹기겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/mission.ogg"},"임무완료":{"voiceline":"임무를 무사히 완료하셨네요! 후훗, 정말 잘했어요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/mission_complete.ogg"},"서약":{"voiceline":"서약 의식? …왠지 귀찮을 것 같은데…. 지휘관님께 불만이 있는 건 아니에요. 딱히 식 같은 거 올리지 않아도… 그러니까… 저는 당신을…. 이, 이런 부끄러운 대사를 어떻게 제 입으로 말하게 하실 수 있으세요?! 끝났으니까, 전 이만 돌아갈래요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/propose.ogg"},"스킬":{"voiceline":"아주 조금만 진심으로 가볼까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/skill.ogg"},"터치1":{"voiceline":"무슨 볼일이라도…? 딱히 없으면 좋겠는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/touch.ogg"},"터치2":{"voiceline":"휴가를 두 배로, 덤으로 과자도 추가해 주신다면, 방금 건은 비밀로 해드리죠. 후후, 나쁘지 않은 거래죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/touch2.ogg"},"입수시":{"voiceline":"일러스트리어스급 4번함, 장갑 항공모함인 인도미터블이에요. 하암… 왠지 좀 귀찮아지기 시작했어요…. 이 뒤는 나중에 이어서 해도 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/unlock.ogg"},"강화성공":{"voiceline":"강해졌네. 숨기는 편이 좋으려나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"제가 MVP? 너무 열심히 했나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관님을 위해서, 조금만 진심으로 가볼까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/battle_ex.ogg"},"상세확인_ex":{"voiceline":"난처한 일이 있으면… 우선은 언니들…이 아니라 제게 상담하셔도… 사, 상관없다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔네요. 어서 확인해주세요. 아, 그… 저도 동행할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/expedition_ex.ogg"},"사랑_ex":{"voiceline":"이번 데이트에서 지금부터 할 건… 방에서 같이 멍하니 있다가, 느긋하게 차를 즐기고, 장식된 꽃을 보면서 멍하니… 네? 외출이요? 오, 오늘은 됐어요. 데이트하러 나가면 저도 모르게 너무 많이 걷다 보니 다음날 다리가 땡땡 부어서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관님이 무사히 돌아오실 수 있도록……. 아야야… 기도만 했는데 벌써 피곤하네요…. 어, 어머? 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 안녕하세요. …그러니까 그… 역시 뭐라도 하는 편이 좋겠…지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/login_ex.ogg"},"실패_ex":{"voiceline":"안심하시길. 저, 푹 자기만 해도 바로 건강해지는 타입이거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/lose_ex.ogg"},"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"사실은 말이죠, 따, 딱히 볼일 없이 제게 말을 걸어주셔도 괜찮다구요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/touch_ex.ogg"},"터치2_ex":{"voiceline":"심술궂으시네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"MVP라구요? …안 돼요. 열심히 한 만큼, 나중에 확실히 쉬어야 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['일러스트리어스', '빅토리어스', '포미더블'] :  언니들, 힘내세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/couple_encourage1.ogg"},{"voiceline":"['프린스 오브 웨일즈', '리펄스'] :  이번에는 결석하지 않겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"어제는 푹 주무셨나요? 피곤할 때는 산책을 다녀오거나, 멍하니 있으면 좋답니다. 저도 함께 할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/main5_ex.ogg"},"메인6_ex":{"voiceline":"포미더블, 다른 언니들 앞에서는 내숭을 떠는 것 같네요…. 뭐, 취미 이야기를 하고 싶은 심정은 알겠지만, 그런 장르의 음악은 좀… 머리가 너무 울려서 참아줬으면 해요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님은 다도회에 참가하실 건가요? 그, 그럼… 으으, 고민이 되네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207120/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":207121,"클뜯 함순이 id":20712,"함순이 이름":"인도미터블","한글 함순이 + 스킨 이름":"나른한 메이드씨","영문 함순이 + 스킨 이름":"Ms. Motivationless Maid","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207121/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207121/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207121/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207121/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207121/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207121/shipyard.png","설명":"하아… 재밌을 것 같아서 메이드복을 입어본 것까진 좋은데, 갈아입은 것만으로 벌써 의욕이 바닥났어요…. 어머, 지휘관님? 마침 잘 됐어요. 같이 멍때리지 않을래요?","자기소개":null,"메인1":{"voiceline":"제가 할 수 있는 거… 말씀이세요? 글쎄요… 지휘관님이 취침하시기 전에 이불을 덥혀 두는 것 정도라면… 괜찮으려나요?","voicelink":"https://raw.githubusercontent.com/F