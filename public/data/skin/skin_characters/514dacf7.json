[{"클뜯 id":408130,"클뜯 함순이 id":40813,"함순이 이름":"U-31","한글 함순이 + 스킨 이름":"U-31","영문 함순이 + 스킨 이름":"U-31","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408130/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408130/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408130/shipyard.png","설명":"VIIA형 잠수함 - U-31","자기소개":{"voiceline":"메탈 블러드의 VIIA형 잠수함 U-31이야. 전투든 지휘관 경호든 뭐든 척척이지~ 아, 당분간은 나한테 지휘관 전속 보디가드를 시켜줘. 수상한 녀석이 지휘관 곁에 접근하지 못하도록 확실하게 지켜줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/profile.ogg"},"메인1":{"voiceline":"음~ 아무래도 지휘관에게 접근하려는 수상한 사람이 있는 것 같네. 그래도 걱정 마. 지휘관한테서 눈 떼지 않고 철저히 감시해 줄 테니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/main1.ogg"},"메인2":{"voiceline":"지휘관, 멈춰! 거기 가만히 있어! 킁킁…… 응? 누군가의 냄새가 나… 누굴까~? 아하♡ 내 냄새잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/main2.ogg"},"메인3":{"voiceline":"요즘 낮에는 의욕이 잘 안 생기는데, 밤만 되면 텐션이 올라가~ 딱 야근에 적합한 상태랄까…? 지휘관, 밤에는 내가 침대 옆에 딱 붙어서 지켜줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/main3.ogg"},"전투개시":{"voiceline":"후후~ 봐주지 않을 테다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/battle.ogg"},"상세확인":{"voiceline":"좋아, 보안 검색 시간이야~ 혹시 모를 상황에 대비해서 확실히 확인해 둬야지. 에이, 움직이지 마. 마음껏 지휘관을 만지게 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/detail.ogg"},"드랍 설명":{"voiceline":"VIIA형 잠수함 - U-31","voicelink":null},"의뢰 완료":{"voiceline":"아, 의뢰팀이 돌아왔네~ 그럼, 지휘관. 같이 마중 나가자! 그러면 계속 내 시야에 지휘관을 넣어둘 수 있겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/expedition.ogg"},"실망":{"voiceline":"……지휘관 전속 보디가드는 잠깐만 쉬어야겠다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/feeling1.ogg"},"낯섦":{"voiceline":"지휘관은 어떤 머리 스타일이 좋아? 트윈테일? 아니면 긴 생머리? 아니면 역시 나 같은 사이드테일이 제일 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/feeling2.ogg"},"호감":{"voiceline":"이건 뭐냐고? 이건 지휘관의 집무실과 방의 모든 소리를 포착하는 건데, 지휘관의 안전을 확보하려면 필요한 거야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/feeling3.ogg"},"기쁨":{"voiceline":"음~ 어제는 지휘관이 이상한 잠꼬대를 하는 게 녹음되어 있던데~ 궁금해? 꼭 안아주면 알려줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/feeling4.ogg"},"사랑":{"voiceline":"음~ 지금 나도 괜찮은 부분이 충분히 많지만, 그래도 조금은 더 자라는 편이 좋으려나? 이대로가 좋다고? 아하♡ 그렇구나~ 그러니까 나는 지휘관의 취향 저격존에 들어가 있다는 거지? 역시 지휘관은 눈이 높다니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/feeling5.ogg"},"터치3":{"voiceline":"엥? 고작 머리를 쓰다듬는 걸로 만족한 거야? 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/headtouch.ogg"},"모항귀환":{"voiceline":"수고했어, 지휘관~ 문 잠그고 올 테니까 잠깐 거기 앉아서 쉬어♪ 응? 왜 잠그냐고? 그야 물론 지휘관의 안전을 지키기 위해서지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/home.ogg"},"hp 경고":{"voiceline":"이, 이거 좀 위험한데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/hp_warning.ogg"},"로그인":{"voiceline":"오, 왔네~ 잠깐, 그대로 가만히 있어~ 냄새 체크, 그리고 만져보기… 좋아, 도청기 같은 건 없는 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/login.ogg"},"실패":{"voiceline":"어, 어라?! 금지된 무기라도 쓴 거 아니야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/lose.ogg"},"우편":{"voiceline":"확인은 끝났어. 우편 안에는 위험물 없음! 그렇지만 이상한 핑크색 우편이 몇 통 섞여 있길래, 그건 다 몰수했어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/mail.ogg"},"임무":{"voiceline":"어머, 지휘관. 아직 안 끝낸 임무가 있어~ 물론 내가 같이 해줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/mission.ogg"},"임무완료":{"voiceline":"임무 완료야. 포상을 원해? 아니면 내 쪽이 더 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/mission_complete.ogg"},"서약":{"voiceline":"드디어 이날이 왔네. 나… 계속 참고 있었어~ 에헤헤, 예전부터 고백하려고 이것저것 많이 시도했는데, 이렇게 지휘관이 먼저 진지하게 고백할 줄이야~ … …정말, 너무 행복해서 머리가 새하얘. 이거 지휘관 마음대로 하게 놔둘 수밖에 없겠네♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/propose.ogg"},"스킬":{"voiceline":"바다 밑바닥에 꼬르륵 가라앉아라♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/skill.ogg"},"터치1":{"voiceline":"지휘관, 오늘 보안 검색을 해달라는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/touch.ogg"},"터치2":{"voiceline":"지휘관, 설마… 「큰 편이 좋다」든가, 그런 무례한 생각을 하는 건 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/touch2.ogg"},"입수시":{"voiceline":"아하♡ 지휘관이 바로 너구나? 보자마자 나도 모르게 가슴이 설렜어♪ 앞으로 친·하·게 잘 지내자구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/unlock.ogg"},"강화성공":{"voiceline":"또 강해졌네~ 이것도 다 지휘관이 열심히 지도해준 덕분이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"이렇게 강한 건 나도 어쩔 수가 없어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408130/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 지휘관~ 우유는 그냥 우유랑 초코우유 중에 