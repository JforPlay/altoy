usercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301211/touch.ogg"},"터치2":{"voiceline":"햐우!? 이, 이런 건…… 아으……(하츠하루는 기절한 모양이다)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301211/touch2.ogg"},"입수시":{"voiceline":"다들 모여 있네……저, 저는 괜찮아요……저, 저도 참가하라구요? 우으, 지휘관님께서 그렇게 말씀해주신다면, 히, 힘내야지……！","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301211/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"기타","상점 id":70139,"상점 카테고리 id":9999,"스킨 태그":"X","입수 영상":"X","재화":700,"기간":"상시","진영":"IJN","레어도":"R","ex_chat_status":0},{"클뜯 id":301212,"클뜯 함순이 id":30121,"함순이 이름":"하츠하루","한글 함순이 + 스킨 이름":"등불의 하츠하루","영문 함순이 + 스킨 이름":"Hatsuharu in the Limelight","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301212/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301212/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301212/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301212/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301212/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301212/shipyard.png","설명":"지휘관님, 오늘 지휘관님의 저녁 연회 파트너로서로열의 예절을 약간 배웠어요… 그, 그것도… 기준을 보나요?","자기소개":null,"메인1":{"voiceline":"아리아케는 동생들을 정말 잘 돌봐요. 저도 그렇게 노력해야죠...","voicelink":"https://raw.githu