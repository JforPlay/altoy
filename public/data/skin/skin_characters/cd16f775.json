[{"클뜯 id":10900010,"클뜯 함순이 id":1090001,"함순이 이름":"라이잘린 스타우트","한글 함순이 + 스킨 이름":"라이잘린 스타우트","영문 함순이 + 스킨 이름":"Reisalin Stout","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900010/shipyard.png","설명":"안녕! 라이잘린 스타우트라고 해. 라이자라고 불러줘! 아직 함선이란게 뭔지 잘 모르겠지만…… 때가 되면 다 해결되겠지! 앞으로 잘 부탁할게!","자기소개":{"voiceline":"연금술사인 라이잘린 스타우트야. 모두들 날 라이자라고 불러. 연금술은 꽤 깊이가 있는 분야야. 별 특이할 것 없는 것도 발상에 따라 다양한 걸로 바꿀 수 있거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/profile.ogg"},"메인1":{"voiceline":"왕도만큼은 아니지만, 여기도 꽤 번화한 곳이네. 미아가 되지 않도록 조심해야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main1.ogg"},"메인2":{"voiceline":"앗, 마물?! ……아, 얘들은 '지휘냥'이라고 부른다구? 그렇구나~ 귀엽네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main2.ogg"},"메인3":{"voiceline":"학교라…. 나도 고향 섬에서는 선생님이었어. 정식 교사는 아니어서 학생들이라곤 다 조그만 아이들뿐이었지만 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main3.ogg"},"전투개시":{"voiceline":"좋았어! 대담하게 가보자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/battle.ogg"},"상세확인":{"voiceline":"있잖아, 지휘관. 아카시네 가게에 커다란 가마솥도 팔려나? 그것만 있으면 연금 솥으로 쓸 수 있을 텐데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/detail.ogg"},"드랍 설명":{"voiceline":"안녕! 라이잘린 스타우트라고 해. 라이자라고 불러줘! 아직 함선이란게 뭔지 잘 모르겠지만…… 때가 되면 다 해결되겠지! 앞으로 잘 부탁할게!","voicelink":null},"의뢰 완료":{"voiceline":"심부름 갔던 사람들이 돌아왔어! 어떤 재료를 가지고 왔을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/expedition.ogg"},"실망":{"voiceline":"부탁? 어떻게 할까……. 응? 보상이 있다고? 그럼 하겠습니닷!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/feeling1.ogg"},"낯섦":{"voiceline":"응, 오늘도 컨디션 좋고! 그럼 어서 무언가 새로운 걸 찾으러 떠나자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/feeling2.ogg"},"호감":{"voiceline":"모항의 뒷산에는 재밌는 재료가 많이 있을 것 같단 말이지……. 응? 지휘관, 데려가 준다고? 신난다! 고마워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 괜찮으면 같이 낚시하러 안 갈래? ……응? 도구가 없다고? 괜찮아, 내가 만든 특제 낚싯대가 있으니까! 이것만 있으면 물고기가 팍팍 잡힐거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/feeling4.ogg"},"사랑":{"voiceline":"오늘도 평화롭네……. 이렇게 모항에서 평범한 나날을 보낼 수 있는 건 모두 지휘관이 힘써주는 덕분이겠지. 늘 고마워, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/feeling5.ogg"},"터치3":{"voiceline":"앗, 통이다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와, 지휘관! 오늘 모험은 어땠어? 차라도 마시면서 들려줬으면 좋겠네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/home.ogg"},"hp 경고":{"voiceline":"아직이야, 지금부터라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관이네! 오늘은 어디로 모험을 떠날 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/login.ogg"},"실패":{"voiceline":"에구…! 이제 좀 감을 잡았나 싶었는데 말이지……. 일단은 후퇴하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/lose.ogg"},"우편":{"voiceline":"우편이 왔어! 뭐라고 적혀있을까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/mail.ogg"},"임무":{"voiceline":"지휘관~ 업무가 남아있는 것 같은데, 안 끝내도 괜찮은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/mission.ogg"},"임무완료":{"voiceline":"와아, 재료가 많이 들어왔어! 아, 지휘관이 받을 보상이구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/mission_complete.ogg"},"서약":{"voiceline":"앗, 이걸 나한테?! 어떡해……. 지금, 이 세상에 온 이후로 가장 설레는 것 같아……. 고마워, 지휘관. 그 마음에 보답하기 위해 나도 더 열심히 할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/propose.ogg"},"스킬":{"voiceline":"단숨에 해치우겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/skill.ogg"},"터치1":{"voiceline":"연금술로는 어떤 걸 만들 수 있냐구? 으음……. 한 마디로 딱 말하긴 어렵네. 재료만 있으면 웬만한 건 만들 수 있기도 하고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/touch.ogg"},"터치2":{"voiceline":"……마침 새로 만든 폭탄의 위력을 시험해보려던 참인데 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/touch2.ogg"},"입수시":{"voiceline":"안녕! 라이잘린 스타우트라고 해. 라이자라고 불러줘! 아직 함선이란게 뭔지 잘 모르겠지만…… 때가 되면 다 해결되겠지! 앞으로 잘 부탁할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/unlock.ogg"},"강화성공":{"voiceline":"응, 더 능숙해진 느낌이야! 고마워, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"대승리! 역시 난 대단해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/win_mvp.ogg"},"전투개시_ex":{"voiceline":"다들, 준비 됐어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/battle_ex.ogg"},"상세확인_ex":{"voiceline":"후후후, 지휘관군. 우리 아틀리에에 온 걸 환영하네! 막 이래. 일단 그쪽에 앉아 있어. 지금 차 내올 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"어려운 일이 있으면 언제든 내게 말해줘! 이 세상의 평온한 일상을 지켜주는 지휘관을 위해, 나도 최선을 다할 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘은 어떤 모험이 기다리고 있을까? 두근 거리네, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"지휘관, 아직 처리할 일이 남아있는 것 같아. 활기를 북돋아 주는 약을 조합해줄 테니까, 마시고 마지막까지 힘내자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/mission_ex.ogg"},"임무완료_ex":{"voiceline":"고생 많았어, 지휘관! 그럼, 잠깐 한숨 돌릴까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"아니아니아니, 아무리 나랑 지휘관 사이라도 그건 안 되지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"신난다, 이겼어! 이것도 지휘관 덕분이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['클라우디아 발렌츠'] :  또 같이 모험할 수 있게 됐네, 클라우디아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/couple_encourage1.ogg"},{"voiceline":"['릴라 디자이어스'] :  릴라 씨, 늘 의지하고 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/couple_encourage2.ogg"},{"voiceline":"['파트리샤 아벨하임'] :  파티, 잘 지냈어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/couple_encourage3.ogg"}],"메인4":{"voiceline":"특수 장비……. 잘 모르는 부분도 많지만, 재료를 써서 무언가를 만들거나 강화한다는 점에서 연금술이랑 통하는 면도 있긴 해……. 잠깐 작업하는 것 좀 견학해도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"안녕~ 어라? 지휘관, 자고 있네. 요새 일 때문에 바쁘기도 했으니, 피로에 잘 드는 약이라도 조합해줘야겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main6_ex.ogg"},"메인7_ex":{"voiceline":"오늘 식당의 일일 메뉴는 '성게 크림 파스타'…. '성게'라는 건 저 나무에서 자라는 거 맞지? 응? 식물이 아니라 해산물이라고? 그렇구나, 내가 살던 세상의 '성게'랑은 다른 거구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main7_ex.ogg"},"메인8_ex":{"voiceline":"저 꽃도, 이 풀도, 내가 살던 세상에는 없는 종류야. 연금술 재료로 쓰면 어떤 게 만들어질까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"드레이크 씨! 모험 동료를 모집한다는 소리를 들었는데, 나도 들어가도 될까?! …신난다! 그럼 어서 모험할 곳을 정하자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"다른 사람에게 공부를 시키는 건 어려운 일이지. 나도 Z23처럼 선생님을 했을 때는 여러모로 머리가 아팠어. 옛날의 나처럼 '너무 까불거리는 애'는 특히 더….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main9_ex.ogg"},"메인10_ex":{"voiceline":"브리스톨, 이런 곳에서 뭐 하는 거야? …응? 모항의 수수께끼를 조사하는 중이라고? 왠지 재밌을 거 같아! 나도 같이 해도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900010/main10_ex.ogg"},"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"RYZA","레어도":"SSR","ex_chat_status":1},{"클뜯 id":10900011,"클뜯 함순이 id":1090001,"함순이 이름":"라이잘린 스타우트","한글 함순이 + 스킨 이름":"밤새는 연금술사","영문 함순이 + 스킨 이름":"Late-Night Alchemist","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900011/shipyard.png","설명":"지휘관, 어서 와! 후후, 다른 사람이랑 이렇게 밤을 새우는 건 오랜만이네. 나, 오늘 하루 동안 계속 기대하고 있었어. 그래서 우선은 뭐부터 할래?","자기소개":null,"메인1":{"voiceline":"오늘은 오전 중에 뒷산을 탐험하고, 그 후엔 클라우디아랑 파티랑 셋이서 카페에 다녀왔어. 즐거운 하루였어…. 지휘관은 어떻게 보냈어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900011/main1.ogg"},"메인2":{"voiceline":"흐아아암…. 이러고 있으니까 졸리네…. 아니, 지휘관은 벌써 잠든 거야? 그럼 나도 그만 자야겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900011/main2.ogg"},"메인3":{"voiceline":"잘 자, 지휘관. 내일도 같이 열심히 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이 베개, 푹신푹신해서 기분 좋네. 이걸 베고 잠들면 좋은 꿈을 꿀 것 같아. 지휘관도 만져 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900011/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 어서 와! 후후, 다른 사람이랑 이렇게 밤을 새우는 건 오랜만이네. 나, 오늘 하루 동안 계속 기대하고 있었어. 그래서 우선은 뭐부터 할래?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관, 오늘 하루도 고생 많았어! 괜찮으면 내가 어깨라도 주물러줄까? …좋아, 그럼 이쪽으로 누워 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"쿨쿨……. 앗! 어… 어서 와, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900011/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"출출해? 내가 그럴 줄 알고… 짜자잔! 과자를 준비해뒀지! 쿠키에 초콜릿에… 지휘관은 어떤 게 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900011/touch.ogg"},"터치