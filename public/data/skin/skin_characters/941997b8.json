":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301161/battle.ogg"},"상세확인":{"voiceline":"이 수트는 잘 맞긴 한데 그네를 탈 때는 좀 불편하단 거다. 으으...고르기 힘들다는 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301161/detail.ogg"},"드랍 설명":{"voiceline":"드디어 \"어디서든 탈 수 있는 그네\" 완성인거다! 지휘관, 어때? 부럽지? 타고싶지? 미안하지만 이건 고귀한 유키카제님 전용이란 거다!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"지휘관, 마침 잘 왔어. 그네 좀 밀어달라는 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301161/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"맞아, 그렇게. 좀 더 세게 밀어도 괜찮아! 와~난다 나는거다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301161/touch.ogg"},"터치2":{"voiceline":"와아악! 깜짝이야, 넘어질 뻔 했네...지휘관, 죽을래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301161/touch2.ogg"},"입수시":{"voiceline":"드디어 \"어디서든 탈 수 있는 그네\" 완성인거다! 지휘관, 어때? 부럽지? 타고싶지? 미안하지만 이건 고귀한 유키카제님 전용이란 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301161/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"이 유키카제님이 즐거움만 쫓는다고 생각하면 큰 오산인 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301161/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"기타","상점 id":70057,"상점 카테고리 id":9999,"스킨 태그":"X","입수 영상":"X","재화":700,"기간":"상시","