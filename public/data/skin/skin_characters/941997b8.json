[{"클뜯 id":301160,"클뜯 함순이 id":30116,"함순이 이름":"유키카제","한글 함순이 + 스킨 이름":"유키카제","영문 함순이 + 스킨 이름":"Yukikaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301160/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301160/shipyard.png","설명":"카게로급 구축함 8번함 유키카제","자기소개":{"voiceline":"잘 들어, 나는 고귀하고 운이 좋은 무적의유키카제·Eight·카게로The.Geni...(혀 깨물기) 뭐, 아 이 단어는 너무 혀가 꼬인다! (낮은 목소리) 쿨럭, 어쨌든, 날 얻게 되었으니 행운인 줄 알라는거다. 이제 이 몸의 행운의 덕을 보게 될 거다. 호호홋!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/profile.ogg"},"메인1":{"voiceline":"호호호, 유키카제님은 무적인 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/main1.ogg"},"메인2":{"voiceline":"지휘관이 부탁한다면야 못 도와줄 것도 없지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/main2.ogg"},"메인3":{"voiceline":"냐, 냐...흥! 이 유키카제님의 기분이 좋았으니 한번 맞춰 준거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/main3.ogg"},"전투개시":{"voiceline":"죽고 싶으면 덤비라는 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/battle.ogg"},"상세확인":{"voiceline":"유키카제님의 용감한 자태를 잘 봐두라는 말이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/detail.ogg"},"드랍 설명":{"voiceline":"카게로급 구축함 8번함 유키카제","voicelink":null},"의뢰 완료":{"voiceline":"왕! 의뢰를 다 마치고 이렇게 외치면 더 좋은 보상을 받는다는거 진짜인거야...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/expedition.ogg"},"실망":{"voiceline":"너는 이 유키카제님의 행운에 어울리지 않는다는 말인거다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/feeling1.ogg"},"낯섦":{"voiceline":"산타클로스? 그런건 있을리가 없다는 거다, 너 바보야? 아, 올해는 크리스마스 선물이 없는 거야? 자, 잠깐만...진정하고 이야기 좀 하자는 거다. 아마 있을지도 모른다는 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/feeling2.ogg"},"호감":{"voiceline":"놀이공원이 가고 싶은 거야? 흥, 그런 곳을 이렇게 어른스러운 유키카제님이 좋아 할리가...아, 그냥 해본 말이라고? 잠깐, 이야기 좀 하자는 거다, 놀이공원도 참 재미있는 곳이라는 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/feeling3.ogg"},"기쁨":{"voiceline":"데이트? 흥, 우아한 유키카제님께서 아무 인간이랑 데이트를 할 것 같아? 아, 그럼 다른 사람한테 물어본다고? 잠깐, 잠깐 기다리라는 거다! 유키카제님을 이용하고 버리려는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/feeling4.ogg"},"사랑":{"voiceline":"웨딩 드레스? 흥, 드디어 이 유키카제님과의 미래를 생각하기 시작한 거야? 음, 이거 괜찮다는 거다. 아, 다른 사람거야? 자, 잠깐...(오열)나도 내가 제 멋대로인 건 알지만, 다른 사람 결혼식이라고? 이 나쁜 자식!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/feeling5.ogg"},"터치3":{"voiceline":"후...깜짝 놀랐다는거다.(작은 소리로)응? 흥, 아무 것도 아니라는거다, 하던 일이나 계속하라는거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/headtouch.ogg"},"모항귀환":{"voiceline":"네가 무사할 수 있었던 건 내 행운 덕인거다, 나한테 감사하란거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/home.ogg"},"hp 경고":{"voiceline":"흥, 유키카제님의 진정한 능력을 보여주겠다는 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/hp_warning.ogg"},"로그인":{"voiceline":"드디어 온 것이냐! 유키카제님을 위해 어서 일하란거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/login.ogg"},"실패":{"voiceline":"흥, 날 여기 이렇게 썩혀 두다니...한번만 봐주겠다는 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/lose.ogg"},"우편":{"voiceline":"메일 왔...젠장, 나보다 더 반기는 거냐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/mail.ogg"},"임무":{"voiceline":"아직 임무가 남았단 말이다. 지휘관, 넌 정말 서툴다는거다.(무시)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/mission.ogg"},"임무완료":{"voiceline":"임무 보상은...뭐, 뭐야. 몰래 볼 생각은 없었단 말이다, 그냥 내가 대신 먼저 확인 해 줄까 했던 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/mission_complete.ogg"},"서약":{"voiceline":"그렇게 간절하게 부탁하니 이 유키카제님께서 자비심을 베풀어 특별히 이 유키카제님을 안는 걸 허락 하겠다는 거다! 자, 뭘 망설여? 이런 천재일우의 기회를!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/propose.ogg"},"스킬":{"voiceline":"난 유키카제님인 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/skill.ogg"},"터치1":{"voiceline":"후...깜짝 놀란거다.(작은 소리로)응? 아무 것도 아닌거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/touch.ogg"},"터치2":{"voiceline":"네가...감히...흑...나가 죽으란거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/touch2.ogg"},"입수시":{"voiceline":"흥! 이곳까지 오다니, 상으로 이 행운의 유키카제님께서 네 함대에 합류해 주겠다는 거다! 영광으로 알라는거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/unlock.ogg"},"강화성공":{"voiceline":"유키카제님의 위대함을 알아봤다고? 그 안목은 꽤 괜찮다는거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"패자는 얼른 사라지란거다! 오호호!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"그 멍청한 꼴을 보니 아무래도 결과는 이 유키카제님에게