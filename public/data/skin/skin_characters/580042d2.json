[{"클뜯 id":201220,"클뜯 함순이 id":20122,"함순이 이름":"주노","한글 함순이 + 스킨 이름":"주노","영문 함순이 + 스킨 이름":"Juno","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201220/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201220/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201220/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201220/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201220/shipyard.png","설명":"J급 구축함·주노 (F46)","자기소개":{"voiceline":"J클래스 4번함 주노라고 합니다.\n아으… 몸이 별로 좋지 않아서 작은 트러블이 자주 일어나고 전장에도 그렇게 익숙해지진 않았습니다만… 지휘관을 위해 힘내겠습니다! 그러니까 차갑게 대하지만 말아주세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/profile.ogg"},"메인1":{"voiceline":"어, 그게… 저지가 저와 놀고 싶은 것 같아서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/main1.ogg"},"메인2":{"voiceline":"에! …파스타…? 피, 필요 없습니다. 거절해도 됩니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/main2.ogg"},"메인3":{"voiceline":"지휘관, 뭔가 도와드릴 거라도 있습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/main3.ogg"},"전투개시":{"voiceline":"지휘관을 위해서, 힘내겠습니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/battle.ogg"},"상세확인":{"voiceline":"지휘관. 이, 이것도 신체 검사입니까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/detail.ogg"},"드랍 설명":{"voiceline":"J급 구축함·주노 (F46)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰에 나간 분들이 돌아왔어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/expedition.ogg"},"실망":{"voiceline":"지휘관, 제가 싫어진 건가요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/feeling1.ogg"},"낯섦":{"voiceline":"지휘관의 곁에 있을 수 있어 기쁩니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/feeling2.ogg"},"호감":{"voiceline":"지금까지 굉장한 성과를 얻어내진 못했지만, 지휘관의 주변을 지키는 거라면 분명 괜찮아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/feeling3.ogg"},"기쁨":{"voiceline":"이름은 「유노」라고도 할 수 있지만 질투하거나 하지는 않아요? 지휘관의 곁에 있을 수 있는 것만으로 행복해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/feeling4.ogg"},"사랑":{"voiceline":"이 왕관이요? 단순한 장식이에요? 그렇지만 만약 주노가 공주님이라면 지휘관…… 주노의 왕자님이 되어 주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 뭔가 할 수 있는 일은 없나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관. 어서 오세요. 오늘 사용하실 서류는 이미 정리해 뒀어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/login.ogg"},"실패":{"voiceline":"역시… 안 되나요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/lose.ogg"},"우편":{"voiceline":"지휘관 지휘관. 새로운 우편이에요. 체크해줘요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/mail.ogg"},"임무":{"voiceline":"새로운 임무가… 그렇지만 지휘관이 하고 싶지 않다면 괜찮아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/mission.ogg"},"임무완료":{"voiceline":"포상, 뭘까… 분명 좋은거겠죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/mission_complete.ogg"},"서약":{"voiceline":"주노의 꿈은…… 지휘관의 신부가 되는 것 입니다. 이 반지를 지휘관이 하는 약속이라고 생각해도 될까요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/propose.ogg"},"스킬":{"voiceline":"저기… 그게… 주노, 힘내겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/skill.ogg"},"터치1":{"voiceline":"아아, 그런….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/touch.ogg"},"터치2":{"voiceline":"에… 지, 지휘관, 그런 곳… 보지 말아줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/touch2.ogg"},"입수시":{"voiceline":"지휘관. 처음 뵙겠습니다. 주노라고 합니다. 지휘관의 호위는 맡겨주세요… 힘내겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/unlock.ogg"},"강화성공":{"voiceline":"이걸로 지휘관을 위해 조금 더 도움이 될 수 있겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/upgrade.ogg"},"vote":null,"승리":{"voiceline":"모두에게 폐를 끼치진 않은 거죠?…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201220/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0},{"클뜯 id":201221,"클뜯 함순이 id":20122,"함순이 이름":"주노","한글 함순이 + 스킨 이름":"맛있는 축제?","영문 함순이 + 스킨 이름":"Fairly Flavourful Festival","스킨 타입":"Summer Fest","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201221/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201221/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201221/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/ski