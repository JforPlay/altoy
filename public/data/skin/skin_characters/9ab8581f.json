[{"클뜯 id":9703060,"클뜯 함순이 id":970306,"함순이 이름":"볼차노·META","한글 함순이 + 스킨 이름":"볼차노·META","영문 함순이 + 스킨 이름":"Bolzano META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703060/shipyard.png","설명":"저는 볼차노… 사르데냐 동맹 소속 기사입니다. 지휘관님, 제게 맡길 책무를 지시하시기 바랍니다.","자기소개":{"voiceline":"사르데냐 동맹의 기사, 중순양함 볼차노입니다. 저에 대해 더 알고 싶으시다고요? 그럴 필요는 없을 것 같군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/profile.ogg"},"메인1":{"voiceline":"지휘관님, 굳이 가까워지려고 하실 필요 없습니다. 당신은 그저 명령만 내리시면 됩니다. 어떤 임무든 제가 처리해 보이지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/main1.ogg"},"메인2":{"voiceline":"……지휘관님, 책상 위의 과자는 제가 먹으라고 둔 건가요? 저는 괜찮…… 명령…이라고요? 알겠습니다. 잘 먹겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/main2.ogg"},"메인3":{"voiceline":"다음 임무 계획은 여기……네, 제대로 보신 겁니다. 제가 다 처리하지요. 별로 어려운 일은 아닙니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/main3.ogg"},"전투개시":{"voiceline":"제 임무는 승리를 거두는 것… 제 발목 잡지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/battle.ogg"},"상세확인":{"voiceline":"……음? 제가 나서야 하나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 볼차노<color=#92fc63>(1척만 소지 가능. 중복으로 획득한 경우에는 한계 돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 임무 검토를 완료했습니다. 정리한 목록은 책상 위에 두었으니 꼭 확인하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/expedition.ogg"},"실망":{"voiceline":"이 정도는 혼자서 처리할 수 있으니, 따라오지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/feeling1.ogg"},"낯섦":{"voiceline":"모항 동료들을 소개해 주고 싶다고요? 필요 없습니다. 동료 같은 건 불필요해요. 물론 당신의 특별대우도… 딱히…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/feeling2.ogg"},"호감":{"voiceline":"지휘관님께서 서류를 정리해 주신 거죠? 부정하실 필요 없습니다. 이 서류 정리 방식만 봐도 아니까요…… 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/feeling3.ogg"},"기쁨":{"voiceline":"누군가 곁에 있는 느낌은 익숙하지 않지만, 지휘관님… 그게 당신이라면…… 노력하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/feeling4.ogg"},"사랑":{"voiceline":"……당신을 거절할 생각은 없습니다. 하지만 제 곁에 계시면 제 불행에 휘말리고 마실 겁니다…… 지금까지 계속 불행했고, 늘 암흑 속을 걸어왔으니까요…… 당신에게는 어떤 상처도 드리고 싶지 않아요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/feeling5.ogg"},"터치3":{"voiceline":"가까이 오지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 제게 주시는 선물…이라고요? 감사합니다. 하지만 다음부터 이런 행동은 삼가셨으면 합니다. 저 같은 자에게 잘 대해주셔도 득 될 일은 하나도 없으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/home.ogg"},"hp 경고":{"voiceline":"임무는…… 꼭 완수할 겁니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/hp_warning.ogg"},"로그인":{"voiceline":"인사는 불필요하겠지요. 맡은 바 책무는 처리했습니다. 이제는 당신께서 맡은 책무를 처리하실 차례지요. 성실히 임하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/login.ogg"},"실패":{"voiceline":"불행한 운명에서는 벗어날 수 없다…는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/lose.ogg"},"우편":{"voiceline":"지휘관님, 새로운 우편이 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/mail.ogg"},"임무":{"voiceline":"아직 임무를 완료하지 않으셨군요. 제가 도와주길 기대라도…… 명령…이라고요? 그럼 제게 모두 맡겨주시길. 번거롭게 도와주실 필요 없습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/mission.ogg"},"임무완료":{"voiceline":"임무 완료입니다. 다른 용건이 없으면 이만 돌아가도록 하지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/mission_complete.ogg"},"서약":{"voiceline":"무슨 일이 있어도… 저를 곁에 두고 싶으신 건가요? 정말 알 수 없는 사람이군요… 알겠습니다. 이제는 더 이상 당신을 거절하지 않을게요. 어떤 불행이 닥쳐와도 제가 온 힘을 다해 지켜드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/propose.ogg"},"스킬":{"voiceline":"불행한 영혼이여, 잠들라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/skill.ogg"},"터치1":{"voiceline":"여기 앉으시려고요? 그럼 저는 저쪽에 앉지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/touch.ogg"},"터치2":{"voiceline":"이런 짓을 하셔도 하나도 재미있지 않습니다만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/touch2.ogg"},"입수시":{"voiceline":"저는 볼차노… 사르데냐 동맹 소속 기사입니다. 지휘관님, 제게 맡길 책무를 지시하시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/unlock.ogg"},"강화성공":{"voiceline":"순조롭다고요…? 별일이 다 있군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"작전 임무 완료. 동맹 기사 볼차노, 지금부터 본대로 귀환하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":nul