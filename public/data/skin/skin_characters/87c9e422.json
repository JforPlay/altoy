g"},"메인3":{"voiceline":"다음 일정…? 이 수액 팩이 다 떨어질 때까지 지휘관 동지 곁에 있을 거야. 괜찮아. 이렇게 떨어지는 방울을 세고 있으면 몇 시간이고…… 아니면 이야기라도 좀 나눌까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702072/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"미리 책을 몇 권 읽고, 동료들에게 이것저것 배웠어. 나머지는 지휘관 동지를 상대로 시술하고 평가만 받으면…… 후후후, 잘 부탁할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702072/detail.ogg"},"드랍 설명":{"voiceline":"……움직이지 마. 지금 지휘관 동지는 「환자」, 그리고 나는 환자를 검사하는 「간호사」… 서로의 거리가 평소와 다른 건 당연한 거야…… 아무리 그래도 이런 자세로 덮쳐 올 필요 있냐고? …으흠, 그렇기는 하네…///","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관 동지가 정말 아파서 쓰러진 거면, 이 기회를 틈타 단숨에 공략할 수 있었겠지… 하지만 누가 동지가 다치거나, 병에 진짜로 걸리길 바라겠어… 그러니 보로실로프의 이 작전도 실행하지 못한 채, 계속 「거짓말」인 채로 남겠지…… 앗…/// 「진짜」로… 만들어 준다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702072/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"작전하느라 고생 많았어. 다치진 않았고? 어디 불편한 곳은? 기분은…… 음, 보로실로프한테 검사를 받는 기분이 어떻냐…고 묻는 거야… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702072/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"도구를 이용한 검사도 물론 할 거지만, 역시 직접 물어보거나 만져봐야 해. 지휘관 동지 몸에 무슨 일이 일어났을 가능성도 있으니까, 더 신중을 기해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702072/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무 연락은 나한테 맡겨, 지휘관 동지는 이대로 가만히 있으면 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702072/mission.ogg"},"임무완료":{"voiceline":"임무가 완료된 모양이네. 지휘관 동지, 이제 안심하고 「검사」를 계속할 수 있겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702072/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"아주 잠깐만 따끔~할 거야. 그러니 긴장 풀어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702072/touch.ogg"},"터치2":{"voiceline":"지휘관 동지… 준비는 이미 끝났어… ///","voice