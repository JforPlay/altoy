[{"클뜯 id":702070,"클뜯 함순이 id":70207,"함순이 이름":"보로실로프","한글 함순이 + 스킨 이름":"보로실로프","영문 함순이 + 스킨 이름":"Voroshilov","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702070/shipyard.png","설명":"키로프급 경순양함 - 보로실로프","자기소개":{"voiceline":"노스 유니온 소속, 키로프급 경순양함 보로실로프야. 키로프는 이미 알고 있지? 나는 계획을 세우고, 키로프는 실행에 옮겨…… 인상이 전혀 다르다고? 그러게. 동료들도 매번 그러더라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/profile.ogg"},"메인1":{"voiceline":"\"열화처럼 작열하고, 얼음처럼 냉철하다\"――나와 키로프에 대한 동료의 평가야. 흠, 뭐 그런 거겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/main1.ogg"},"메인2":{"voiceline":"지휘관 동지, 지금 몇시야? 고마워. …휴우, 아직 '그걸' 놓친 건 아닌 모양이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/main2.ogg"},"메인3":{"voiceline":"시간을 보내는 방법? 난 얼음을 두고 천천히 녹는 모습을 계속 바라봐……. 지휘관 동지는?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/main3.ogg"},"전투개시":{"voiceline":"예행연습이라면 몇 번이고 했어. 실패는 안 해…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/battle.ogg"},"상세확인":{"voiceline":"여기서 저기로, 그리고 그 앞에서는… 아, 지휘관 동지. 마침 집무실의 비상 탈출 경로를 검토하던 중이야. 한번 확인해 볼래? 언젠가 도움이 될지도 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/detail.ogg"},"드랍 설명":{"voiceline":"키로프급 경순양함 - 보로실로프","voicelink":null},"의뢰 완료":{"voiceline":"앗, 벌써 시간이 이렇게? ……아, 알려줘서 고마워. 의뢰팀이 돌아온 걸 잊어버릴뻔했어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/expedition.ogg"},"실망":{"voiceline":"지휘관 동지랑은 잘 안 맞을 것 같아서…… 미안해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/feeling1.ogg"},"낯섦":{"voiceline":"딱히 볼일이 없으면 일부러 찾을 필요도 없겠지. 서로 자기 일만 하면 되는 거야. 거리는 확실하게 두는 편이… 좋잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/feeling2.ogg"},"호감":{"voiceline":"유사시 계획을 세울 때를 대비해서 평소에 군학 서적을 자주 읽어. 지휘관 동지도 관심 있으면 몇 권 정도 빌려줄까? 음, 예를 들면 <거리감의> ……미, 미안해. 실수야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 동지, 임무 진척 상황은 어때? ……다 끝났어? 그럼, 군사 의뢰는? ……그것도 다 완료했다고…? 그렇구나, 잘 하고 있구나. (작은 목소리로) '자연스럽게 거리를 좁히는' 작전, 실패한 것 같네…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/feeling4.ogg"},"사랑":{"voiceline":"지휘관 동지, 왜 그래? 난 평소랑 똑같으니까, 특별히 걱정할 건 없는데……. (작은 목소리로) 괜찮아. 네가 날 봐줄 때까지 언제까지나 기다릴게. '지휘관 공략 작전', 절대 실패하지 않을 거야…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/feeling5.ogg"},"터치3":{"voiceline":"왜 그런 짓을?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/headtouch.ogg"},"모항귀환":{"voiceline":"도착한 서류를 분류해서 중요도가 낮은 건 내가 해두면, 지휘관 동지가 돌아왔을 때… 아, 언제 왔어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/home.ogg"},"hp 경고":{"voiceline":"조금만 더, 조금만 더 버텨……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 동지, 어서 와. 언제 돌아올지 몰라서 계속 여기서 대기하고 있었는데…… 이거야말로 비서함이 다해야 할 책무 맞지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/login.ogg"},"실패":{"voiceline":"정말 미안해, 지휘관 동지. 내 실책은 나 혼자 수습할게….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/lose.ogg"},"우편":{"voiceline":"지휘관 동지, 어서 우편을 확인해줘. 상대방은 우리처럼 끈기있게 못 기다릴 수도 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/mail.ogg"},"임무":{"voiceline":"쌓인 눈은 저절로 녹지만, 쌓인 임무는 그렇지 않아. ……지휘관 동지, 늦기 전에 빨리 해치우자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/mission.ogg"},"임무완료":{"voiceline":"지휘관 동지, 임무가 완료됐어. 예정에 따르면 다음 작업은…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/mission_complete.ogg"},"서약":{"voiceline":"(작은 목소리로) '지휘관 공략 작전'이 성공했나? 아니면…… 아, 아무것도 아니야. 지휘관 동지가 나랑 같은 마음인 것 같아서 기뻐. 앗, 처음부터 다 알고 있었다고?! 그렇구나……. 나도 솔직할 걸 그랬네…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/propose.ogg"},"스킬":{"voiceline":"녹아라…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/skill.ogg"},"터치1":{"voiceline":"외출할 거야? 그럼 지휘관 동지, 보로실로프가 여기서 대기해줬으면 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/touch.ogg"},"터치2":{"voiceline":"그, 그렇게 맘대로 만지지 마….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/touch2.ogg"},"입수시":{"voiceline":"드디어 만났네, 지휘관 동지. 나는 노스 유니온 소속인 경순양함 보로실로프야. 응? 그렇게 오래 기다린 건 아닌 것 같은데… 뭐, 몇 시간 정도였어. 그렇게 긴 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/unlock.ogg"},"강화성공":{"voiceline":"절대적인 실력 역시 임무 완수를 보증해주겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"충분한 정보에 치밀하게 짜인 작전만 있다면, 절대 실패할 일 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"'데이트'는 작전의 사전 준비처럼 제대로 계획을 세워야 해. <모항 데이트 장소 모음집>, <데이트 테크닉 100선>, <데이트로 지휘관의 마음을 사로잡는 방법>――일단은 이 정도지……. 응? 지휘관 동지한테 맡겨도 돼? 그, 그렇게 말한다면야…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"잘… 모르겠어…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"아, 지휘관 동지. 업무에 너무 집중해서 돌아온 줄도 몰랐어. 사실은 더 특별하게 맞아주고 싶었는데, 돌아오는 시간을 잊어버려서… 미안해…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 와, 지휘관 동지. 계속 기다릴 필요 없다고? ……괜찮아, 계속 보고 싶었는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"손이 차갑네……. 따뜻하게 해줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/touch_ex.ogg"},"터치2_ex":{"voiceline":"서로 더 솔직하게…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['키로프'] :  키로프가 있으면 분명 잘 될 거야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"\"하고 싶다면 대담하게\"―― 키로프가 무슨 말을 하려고 한 건진 알아. 그렇지만 난 뭐랄까…. 감정 같은 걸 더 신중히 해야 한다고 생각해. 왜냐면 처음…이니까…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/main5_ex.ogg"},"메인6_ex":{"voiceline":"'거리감'은 관계를 맺는 데 필요한 거라고 생각해. 그렇지만 이렇게 찰싹 붙어서 이야기하는 것도……. 후훗, 행복하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"내가 '얼음처럼 냉철'하다고 생각해? 후후, 얼음은 이미 네 덕분에 녹아버렸는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702070/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":702071,"클뜯 함순이 id":70207,"함순이 이름":"보로실로프","한글 함순이 + 스킨 이름":"따뜻한 눈을 경치로, 진심을 그대에게","영문 함순이 + 스킨 이름":"Devoted as the Warm Snow","스킨 타입":"Hot Springs","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702071/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702071/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702071/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702071/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702071/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702071/shipyard.png","설명":"지휘관 동지, 물 온도는 어때? 마음에 들었으면 좋겠다. 후후, <눈 내리는 날 데이트 장소 TOP10>으로 계획을 세운 게 정답이었네.","자기소개":null,"메인1":{"voiceline":"때때로 불어오는 찬 바람, 뜨끈뜨끈한 물……. 어쩌면 이것도 '얼음'과 '불꽃'으로 비유할 수 있지 않을까? 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702071/main1.ogg"},"메인2":{"voiceline":"너무 오래 있으면 현기증이 난다고? 나는 괜찮은 것 같은데……. 끈기 있게 계속 대기하는 게 익숙해서 그런가? 지휘관 동지야말로 어디 몸이라도 안 좋아지면 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702071/main2.ogg"},"메인3":{"voiceline":"이럴 때 긴급 출격 요청이라도 오면 어떻게 해야 할까…. 아, 모처럼 데이트하는 중인데 이런 생각 하면 안 되겠지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702071/main3.ogg"},"전투개시":{"voiceline":"괜찮아, 긴급 출격 연습도 대강 하고 왔으니까…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702071/battle.ogg"},"상세확인":{"voiceline":"강구트랑 세바스토폴이 보드카를 들고 안으로 들어가네. 설마 온천 안에서 