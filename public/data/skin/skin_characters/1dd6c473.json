[{"클뜯 id":9600120,"클뜯 함순이 id":960012,"함순이 이름":"퀸 앤즈 리벤지","한글 함순이 + 스킨 이름":"퀸 앤즈 리벤지","영문 함순이 + 스킨 이름":"Queen Anne's Revenge","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600120/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600120/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600120/shipyard.png","설명":"범선 - 퀸 앤즈 리벤지","자기소개":{"voiceline":"퀸 앤즈 리벤지… 이름은 선미에 적혀 있으니까 직접 가서 봐. 가라앉기 싫으면 귀찮게 굴지 마. 후후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/profile.ogg"},"메인1":{"voiceline":"완벽한 아이 메이크업에 완벽한 코디, 완벽한 퀸 앤즈 리벤지… 기분이 좋아졌어. 응? 딱히 어딜 나가려는 건 아닌데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/main1.ogg"},"메인2":{"voiceline":"약탈할 때 상대가 지휘관 같으면…… 후후후… 참 재밌겠네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/main2.ogg"},"메인3":{"voiceline":"욕실에 아직 물이 샌다고? 후… 후후후…… 아무래도 수리 담당을 바다에 던져버려야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/main3.ogg"},"전투개시":{"voiceline":"귀찮아… 집에서 지휘하면 안 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/battle.ogg"},"상세확인":{"voiceline":"…휴, 어쩔 수 없잖아. 보물 속에서 방 열쇠를 찾고, 침대에서 문까지 가는 길도 찾아내야 한다고…… 그래서 외출하는 게 안 내키는 거야. 모을 가치가 있는 게 있다면야 나가겠지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 퀸 앤즈 리벤지","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀을 마중하러 갈 시간이야. 반짝거리는 보물이 있다면…… 다 나한테 넘겨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/expedition.ogg"},"실망":{"voiceline":"내 방침에 자꾸 불평하면 태우는 건 서류만으로 끝나지 않을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/feeling1.ogg"},"낯섦":{"voiceline":"방 청소? ……그런 사소한 건 네가 알아서 하지 그래? 나한테는 더 중요한 일이 있거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/feeling2.ogg"},"호감":{"voiceline":"뒷정리에 재능이 있는 것 같네…… 여기 와서 좀 도와. 이 정도는 5분이면 끝나지? 이걸 만약 내가 하면…… 누가 하는 게 더 나은지 정도는 너도 잘 알잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/feeling3.ogg"},"기쁨":{"voiceline":"얌전히… 50분만 더 기다려. 이런 예쁜 드레스를 입으려면 시간이 좀 걸려. ……그렇게 궁금하면 안에 들어와서 좀 도와주지 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/feeling4.ogg"},"사랑":{"voiceline":"이 반지를 줄게. ……딱히 특별한 건 아니야. 많이 있으니까 마음껏 골라…… 하지만 그전에 대답부터 해줘야겠어. 까마귀가 빛나는 걸 좋아하듯…… 날… 원해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/feeling5.ogg"},"터치3":{"voiceline":"머리 장식이 흐트러지면 안 되는데… 하아… 걱정하지 마. 바닷속 문어와 친구가 되는 것도 나쁘지 않을 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/headtouch.ogg"},"모항귀환":{"voiceline":"오, 무사히 돌아왔네. ……있잖아, 오늘 화장 꽤 잘 먹었지? 슬슬 칭찬 좀 해주는 게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/home.ogg"},"hp 경고":{"voiceline":"드레스가 더러워졌잖아…… 유서 쓸 시간도 못 얻어낼 줄 알아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/hp_warning.ogg"},"로그인":{"voiceline":"왔구나. 외출할 준비 중이라서 조금 걸릴 거야. 심심하면 방이나 좀 치우지 그래.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/login.ogg"},"실패":{"voiceline":"저 성가신 녀석들… 다음에는 기필코 바다에 모조리 수장시켜 주고 말겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/lose.ogg"},"우편":{"voiceline":"방금 네 앞으로 온 우편을 봤어. 지금 안 찾으면… 다시는 못 찾을지도 모른다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/mail.ogg"},"임무":{"voiceline":"임무가 아직 덜 끝났는데 쉬려고? 보물이 땅에서 그냥 솟아나는 줄 알아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/mission.ogg"},"임무완료":{"voiceline":"이게 다야? ……더 손쉽고 빠르게 벌 수 있는 방법 알려줄까? 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/mission_complete.ogg"},"서약":{"voiceline":"꿈에 그리던… 빛나는 서약 반지… 드디어 내 손에 들어왔어. 후후, 내 아름다움에 잘 어울리지? 이걸 손에 끼면 이제 살아 있는 동안에는 돌이킬 수 없게 될 거야. ……절대 후회 안 한다고? 후후, 그래야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/propose.ogg"},"스킬":{"voiceline":"몽땅 물고기 밥으로 만들어주마……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/skill.ogg"},"터치1":{"voiceline":"오늘도 내가 제일 예쁘단 건 잘 알아. …어서 옷자락 좀 정리해 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/touch.ogg"},"터치2":{"voiceline":"완벽하게 꾸민 내게 반하기라도 한 거야? 후후후…… 유언은 그게 다야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/touch2.ogg"},"입수시":{"voiceline":"나는 퀸 앤즈 리벤지야. 아름다운 보물을 좋아하지. 음… 네가 지휘관이지? 그럼 이 어질러진 것들 치우는 것 좀 도와줘. ……밤에 천천히 감상하고 싶거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/unlock.ogg"},"강화성공":{"voiceline":"후후후, 이제 적을 모조리 수장시킬 수 있겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후훗, 모든 건 내 손바닥 안이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"외출 준비를 벌써 해놨다고? …안타깝네. 다른 옷으로 갈아입을 거니까 다시 해줘야겠어","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"나도 모르는 사이에 네 흔적이 방 곳곳에 남아 있더라…… 언제부터 이렇게…… 네게 의존하게 된 걸까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"또 머리를 흐트러뜨렸네… 뭐, 이걸 계기로 새로운 헤어스타일을 시도해볼 수 있다고 생각하면 되려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"으으음…… 아직 한참… 이른데…… 아직 일어나기 싫어. 머리를 정리해준다면, 생각해볼 수도 있겠지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"내가 이걸 입은 걸 보고 싶다고? ……그렇게 해 줄 수도 있지. 직접 입혀준다면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/touch_ex.ogg"},"터치2_ex":{"voiceline":"후후…… 각오는 돼 있어야 할 텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['로열 제임스', '어드벤처'] : 네 몫은 잘 챙겨놨어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"안 쓰는 건 수납장에 넣으라고? 안 돼. 네가 준 선물들로 이미 꽉 찼거든. …다 네 탓이야. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/main5_ex.ogg"},"메인6_ex":{"voiceline":"이 반지, 너한테 딱 어울릴 거 같아. …껴줄 테니까 가만히 있어. ……후후, 역시 내 센스는 최고야","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"있잖아, 너무 늦으면 안 되는 거 알지…? 안 그러면 방이 원래대로 돌아가버릴지도 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600120/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"