null,"호감":null,"기쁨":null,"사랑":{"voiceline":"모든 준비는 끝났으니, 이제 의식을 시작하자. 걱정하지 마. 촉수도 널 아프게 하진 않을 테니…… 힘을 빼고 함께 허무의 심연 속으로 떨어지자……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600121/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"이제 도망칠 곳은 없어. 믿는 자여, 어서 그 노동과 헌신으로 우리의 오래된 계약을 완수하도록 해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600121/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"의식 준비는 다 끝났어? ……뭐? 신은 그런 자잘한 일에는 관여하지 않는다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600121/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":{"voiceline":"임무는 끝났고, 의식도 거의 완성됐어…… 권속은 참 봉사에 능하단 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600121/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"신에게 뭘 바라는 거지? 어서 말해 봐. 어쩌면 들어줄지도 모르잖아? 후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600121/touch.ogg"},"터치2":{"voiceline":"형언할 수 없는 이 지고의 존재에게 몸을 바치려 하다니…… 후후, 그 용기만은 인정해 줄게.♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600121/touch2.ogg"},"입수시":{"voiceline":"길 잃은 인간… 너는 형언할 수 없는 지고의 존재를 깨우고 말았어…… 자, 어서 내 권속이 되어 의식을 돕도록 해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600121/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이세계 모험","상점 id":71226,"상점 카테고리 id":24,"스킨 태그":"L2D, 배경","입수 영상":"O","재화":1180