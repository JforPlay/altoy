[{"클뜯 id":101070,"클뜯 함순이 id":10107,"함순이 이름":"맥콜","한글 함순이 + 스킨 이름":"맥콜","영문 함순이 + 스킨 이름":"McCall","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101070/shipyard.png","설명":"그리들리급 구축함·맥콜 ( DD-400)","자기소개":{"voiceline":"그리들리급 3번함 맥콜이야. 언니들과 똑같이 오랫동안 살아남은 것 말곤 딱히 특별한 건 없지만… 뭐, 모두의 활약을 볼 수 있어서 좋았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/profile.ogg"},"메인1":{"voiceline":"응, 뭐랄까 우리, 꽤 죽이 잘 맞네…… 아이스크림 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/main1.ogg"},"메인2":{"voiceline":"후우…… 하와이의 날씨가 더워서 녹아버릴 것 같아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/main2.ogg"},"메인3":{"voiceline":"…아우… 아, 큰일났다, 아이스크림 녹아버렸다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/main3.ogg"},"전투개시":{"voiceline":"아, 역시 전투인가. 아무리 그래도 계속 피하기만 해선 지나갈 수 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/battle.ogg"},"상세확인":{"voiceline":"미안, 조금만 서둘러주지 않겠어? 새로 나온 아이스크림 사고 싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/detail.ogg"},"드랍 설명":{"voiceline":"그리들리급 구축함·맥콜 ( DD-400)","voicelink":null},"의뢰 완료":{"voiceline":"……아, 자매함이 돌아왔다. 아이스크림 주고 올게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/expedition.ogg"},"실망":{"voiceline":"(맥콜은 아이스크림에 집중하고 있는 모양이라 이쪽을 눈치채지 못한 모양이다.)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/feeling1.ogg"},"낯섦":{"voiceline":"사쿠라 엠파이어의 한가한 사람들은 오후 내내 차 한 잔으로 보낸다나 봐. 여러 가지 듣고 싶은걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/feeling2.ogg"},"호감":{"voiceline":"멍하니 있는 요령? 머리를 새하얗게 비우고 아무것도 생각하지 않으려고 하면 돼. 그래도 뭐, 그러는 사이에 아이스크림이 곧잘 녹아버리지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 씨, 아이스크림 있어? 간접키스? 지휘관이라면 괜찮아…… 그것보다, 멍하니 있게 잠깐 등 좀 빌려줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/feeling4.ogg"},"사랑":{"voiceline":"사실은, 매일 아이스크림 먹으면서 종일 멍하니 지내면서 쭉 변치 않는 나날이 계속됐으면 좋겠다고 생각했어. 근데 지휘관 씨를 만나고 나서부턴, 꼭 그렇지만도 않다는 기분이 들어서 말야…… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"왠지 덥네, 식힐만한 거 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 씨, 오늘은 이대로 앉아 있기만 하면 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/login.ogg"},"실패":{"voiceline":"우와아, 깜짝 놀라서 아이스크림 떨어뜨려 버렸어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/lose.ogg"},"우편":{"voiceline":"하아. 이런 편지는 정말 끝이 없다니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/mail.ogg"},"임무":{"voiceline":"미션인가~ 될 대로 돼라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/mission.ogg"},"임무완료":{"voiceline":"보수 포장하는 것 좀 도와줘─. 택배로 보내도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101070/mission_complete.ogg"},"서약":{"voiceline":"나, 지휘관 씨와 만나고 나서 꽤 변했단 말이지… 앞으로 많은 일이 있겠지만 지휘관하고 함께 있다는 것만은 안 변했으면 좋겠다…","voicelink":"