[{"클뜯 id":304070,"클뜯 함순이 id":30407,"함순이 이름":"꼬마 아마기","한글 함순이 + 스킨 이름":"꼬마 아마기","영문 함순이 + 스킨 이름":"Amagi-chan","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304070/shipyard.png","설명":"아마기급 순양전함 1번함 - 아마기","자기소개":{"voiceline":"사쿠라 엠파이어 소속 순양전함 아마기입니다. 이 모항에서 쑥쑥 자라서 지휘관님과 아카기의 힘이 되겠어요—— 그러려면 잘 먹고 잘 자야죠, 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/profile.ogg"},"메인1":{"voiceline":"역시 로열 네이비의 메이드장이에요. 이렇게 멋진 홍차라니, 정말 감탄했어요... 후~ 후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/main1.ogg"},"메인2":{"voiceline":"아카기, 지휘관  님은 부하가 아니에요....계속 이렇게 지휘관님을 귀찮게 한다면 혼쭐을 내겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/main2.ogg"},"메인3":{"voiceline":"아, 또 만쥬를 경단으로 만들어 버렸다... 조금 배가 고파서 그런가봐요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/main3.ogg"},"전투개시":{"voiceline":"계획대로 행동하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/battle.ogg"},"상세확인":{"voiceline":"크흠, 으... 괜, 괜찮아요... 아마기가 간식을 먹을 때 사레가 들려서... 꿀꺽꿀꺽... 으으...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/detail.ogg"},"드랍 설명":{"voiceline":"아마기급 순양전함 1번함 - 아마기","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰가 끝났어요. 원하신다면 아마기가 다음 출격할 인원에 대한 건의를 드려도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/expedition.ogg"},"실망":{"voiceline":"지휘관님, 혹시 몸이 안 좋아서 정신까지 영향을 받은 건 아니죠...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/feeling1.ogg"},"낯섦":{"voiceline":"사쿠라 엠파이어와 아카기, 그리고 모항의 동료들을 지키기 위해서 아마기는 뭐든지 할 준비가 되어 있어요. 지휘관님, 부디 명령을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/feeling2.ogg"},"호감":{"voiceline":"아마기의 건강을 바란다니, 그... 지휘관님의 부하와 함선으로서 건강 관리는 굉장히 중요한 일이에요... 아마기가 조금 더 특별한 일을 해야 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/feeling3.ogg"},"기쁨":{"voiceline":"냠냠... 맛있다... 아, 지휘관님, 죄송해요. 실수로 떡을 먹어버렸어요... 마음껏 먹어도 괜찮다고요? 그, 그렇다면 아마기가 맛있게 먹도록 할게요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 휴식 시간이에요. 아마기의 건강을 걱정하면서 지휘관님의 몸을 돌보지 않는 것은 전혀 설득력이 없는 일이랍니다. 자, 제가 이불을 깔아드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/feeling5.ogg"},"터치3":{"voiceline":"으으으, 지휘관님, 잠시만요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 오셨군요. 사쿠라 엠파이어의 간식을 드시겠어요? ...괜찮다면 아마기도 같이 먹어도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/home.ogg"},"hp 경고":{"voiceline":"어디서 잘못된 걸까요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 오늘의 확인해야 할 자료는 모두 여기에 두었습니다. 이정도는 저도 혼자서 할 수 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/login.ogg"},"실패":{"voiceline":"크흠... 이런 모습으로 아카기 일행을 보러갈 수는 없어요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/lose.ogg"},"우편":{"voiceline":"간식이 왔나요? ...평, 평범한 편지였네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/mail.ogg"},"임무":{"voiceline":"끝내지 못한 임무가 있어요. 임무의 보수는 가장 알맞은 곳에 사용해야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 임무가 끝났어요. 다음 임무는 언제 확인할 예정이세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 안 돼요. 만약 아마기가 이 반지를 받는다면 아카기는 분명히... 아카기도 괜찮다고 했나요? 다행이다, 그 아이도 성장했군요... 아, 아니요, 지금은 아카기보다 먼저 지휘관님의 마음을 헤아려야... 저기, 그게요! 아마기, 정말 영광이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/propose.ogg"},"스킬":{"voiceline":"후후후...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/skill.ogg"},"터치1":{"voiceline":"이건 옷이 흘러내린 것이 아니라 사실... 감기 조심하라고요? 네, 꼭 그럴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/touch.ogg"},"터치2":{"voiceline":"? 지휘관님, 아마기는 지금 뭔가 생각하고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/touch2.ogg"},"입수시":{"voiceline":"순양전함 아마기, 지휘관님을 뵙습니다. 크흠… 아, 괜찮습니다. 방금 바람이 불어와서… 에취! 으음……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/unlock.ogg"},"강화성공":{"voiceline":"아카기를 지키기 위해서 아마기도 더 강해져야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"그러면... 어떻게 이 승리를 이용해야 할까요? ...후후후...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관님, 입 벌리세요, 아~ 좋아요, 다음은 아마기 . 아~… 음, 맛있다! 다음은 또 지휘관님 차례에요～","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님, 아마기 의 무릎 베게 어떠신가요? 지휘관님이 있어서, 이만큼이나 오래 버틸 수 있었어요. 헤헤, 아카기가 화내기 전에, 똑바로 침대에 이불 펴고 자죠. 안녕히 주무세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관님, 이 모찌는 히에이가 만드는 법을 알려줬어요. 드셔 보실래요? 아카기랑 다른 동료들도 맛있다고 했어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 오늘 연습전의 요지는 책상에 두었습니다. 시간 되실 때 훑어 보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"아카기처럼 꼬리에 부비적하고 싶나요…？","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/touch_ex.ogg"},"터치2_ex":{"voiceline":"차라리 아카기도 부를까요? 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"아마기 의 전략이 승리한 것 같군요. 후후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['아카기', '꼬마 아카기', '아카기(μ장비)'] : 아카기, 지휘관님을 곤란하게 해서는 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/couple_encourage1.ogg"},{"voiceline":"['카가(전함)', '토사'] : 지휘관님에게 무서운 표정을 보이지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"아마기 는 운동을 잘 못해요. 간단한 체조 밖에는… 음, 하지만 지휘관님도 같이 몸을 움직이시겠다면 아마기 도 노력할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304070/main5_ex.ogg"},"메인6_ex":{"voiceline":"nil","voicelink":null},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님, 괜찮으면 카가랑 같이 바둑을 두셔 줄 수 있나요? 카가는 항상 \"다음엔 꼭 이긴다\"라고 말해서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/3040