[{"클뜯 id":301940,"클뜯 함순이 id":30194,"함순이 이름":"후지나미","한글 함순이 + 스킨 이름":"후지나미","영문 함순이 + 스킨 이름":"Fujinami","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301940/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301940/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301940/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301940/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301940/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301940/shipyard.png","설명":"유구모급 구축함 - 후지나미","자기소개":{"voiceline":"사쿠라 엠파이어 소속 구축함 후지나미야. 운이 없어서 자주 실패하긴 하지만, 패션 감각만큼은 자신 있어! 음흠, 지휘관도 그건 인정하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/profile.ogg"},"메인1":{"voiceline":"지휘관, 오늘 내 양말 느낌 있지? 뭐…? 예전이랑 다른 게 뭔지 모르겠다고?! 가, 가까이서 제대로 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/main1.ogg"},"메인2":{"voiceline":"트렌드를 쫓기만 하면 안 돼. 트렌드라는 건 말이지, 자기가 직접 만드는 거야~ 그러니까 지휘관, 후지나미가 생각한 새로운 코디 한 번 입어 볼래? 분명 잘 어울릴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/main2.ogg"},"메인3":{"voiceline":"으으…… 이 과일, 너무 떫어…… 다음부터는 지휘관 거 얻어먹어야지. 지휘관이 고른 거면 안심이 되니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/main3.ogg"},"전투개시":{"voiceline":"트렌드 패션을 맛보게 해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/battle.ogg"},"상세확인":{"voiceline":"트렌디한 코디랑 사쿠라 엠파이어 스타일을 섞는 건 내 특기야! 내 반짝반짝 빛나는 모습, 잘 지켜봐 줘! 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/detail.ogg"},"드랍 설명":{"voiceline":"유구모급 구축함 - 후지나미","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어. 열심히 한 착한 애들한테 제대로 보답해야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/expedition.ogg"},"실망":{"voiceline":"괜찮아, 지휘관. 어차피 난 항상 운도 없어서, 이런 건 익숙하거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/feeling1.ogg"},"낯섦":{"voiceline":"꽃무늬 리본…… 프릴 가터…… 반짝이는 핑크 액세서리…… 어떻게 코디하면 좋을까? 아하, 지휘관이 정해줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/feeling2.ogg"},"호감":{"voiceline":"리본이 자꾸 느슨해진단 말이지~ ……다시 좀 묶어줄래? 왜 부탁하냐고? 지휘관은 운이 좋잖아~ 게다가 이런 부탁은 기꺼이 들어줄 거잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/feeling3.ogg"},"기쁨":{"voiceline":"요즘 왠지 운이 좋단 말이야…… 설마 지휘관 덕분인가? 후훗, 딱히 칭찬하는 거 아니거든♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/feeling4.ogg"},"사랑":{"voiceline":"지휘관~ 지휘관이 할 액세서리도 사 왔어~! …커플로 하자는 거 아니거든?! 지휘관 때문에 내 센스까지 떨어지면 어떻게 하려구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/feeling5.ogg"},"터치3":{"voiceline":"내 뿔, 귀엽지? 자~ 안 아프니까 꾹꾹 눌러봐도 돼~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와~ 괜찮아, 제대로 일하고 있으니까! 그래서 말인데~ 나한테 보상으로 뭘 줄 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/home.ogg"},"hp 경고":{"voiceline":"엉망진창이네…… 이런 거 너무 싫어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/hp_warning.ogg"},"로그인":{"voiceline":"안녕, 지휘관~ 오늘 내 패션 센스에 깜짝 놀랐지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/login.ogg"},"실패":{"voiceline":"으…… 에너지드링크가 부족해서 그래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/lose.ogg"},"우편":{"voiceline":"어라라~? 그거 누가 보낸 러브레터 아니야? 나도 봐도 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/mail.ogg"},"임무":{"voiceline":"임무 도와줄까? ……어? 그, 그냥 말해본 건데, 정말 나한테 맡기면 실패할지도 몰라……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/mission.ogg"},"임무완료":{"voiceline":"……업무, 제대로 마친 거야?! 지휘관은…… 정말 운이 좋다니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/mission_complete.ogg"},"서약":{"voiceline":"이, 이건…… 뭐야, 생각보다 평범하네! 그래도 지휘관이 고른 거니까…… 원하는 대로 달아줄게♪ 흐흥, 역시 패셔너블한 사람은 뭘 걸쳐도 잘 어울린다니까~～♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/propose.ogg"},"스킬":{"voiceline":"새 신발로 걷어차 주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/skill.ogg"},"터치1":{"voiceline":"내가 고른 액세서리, 완전 잘 어울리지? 우훗, 이게 바로 후지나미식 패션 센스라구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/touch.ogg"},"터치2":{"voiceline":"꺅! 가, 갑자기 뭐야…… 뭐, 속옷 코디가 궁금하면… 특별히 보여줄 수도… 있긴 하지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/touch2.ogg"},"입수시":{"voiceline":"에헤헤, 나는 후지나미야. 트렌드의 사랑을 듬뿍 받는 나이스 걸이지! 각오해 둬. 진짜 패션이 뭔지 제대로 알려줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/unlock.ogg"},"강화성공":{"voiceline":"내 노력이 결실을 맺은 건가…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/upgrade.ogg"},"vote":null,"승리":{"voiceline":"예이! 승리~! 있잖아, 내 반짝반짝 빛나는 순간 봤어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 나 중요한 사실을 하나 깨달았어. 내가 어떤 코디를 해도 지휘관은 늘 칭찬해 준다는 걸…… 이거 혹시, 이미 후지나미의 머리부터 발끝까지 푹 빠졌다는 뜻 아니야~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"행운을 나눠주려고? 그럼 받아줄까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"……흐음, 어떤 옷을 입고 지휘관을 맞이할까? ……잠깐, 왜 벌써 돌아온 거야?! 후, 후후후훔쳐보지 마! 적어도 갈아입고 난 다음에…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"후훗, 후지나미가 강력 추천한 코디로 출근했네… 그럼 나도 보상을 아끼지 않을게…… 쪽♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"이 코디 마음에 들어? 그럼~ 벗어서 디테일한 부분까지 확 보여줘 버릴까 봐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/touch_ex.ogg"},"터치2_ex":{"voiceline":"아니, 아니! 먼저 리본부터 풀고 레이스를 벗겨야지~ ……꺅! 순서대로 하라니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['초카이'] : 정말…… 다음부터는 조심 좀 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"조금 있다가 나가려고? 우산 준비해 뒀어. 나랑 커플 컬러로 딱 맞춰서♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관이랑 같이 있게 된 뒤로 불운도 줄어든 것 같아. ……그래도! 데이트가 잘 되려면 역시 만전의 준비를… 더블…아니 트리플 체크는 기본이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관, 이 패션 잡지 좀 봐! 모항에서 내일 유행한다는 색이 무려…… 잠깐, 내일? 설마 나보다 먼저 트렌드를 앞지르는 애가 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301940/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스