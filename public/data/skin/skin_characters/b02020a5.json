[{"클뜯 id":9705030,"클뜯 함순이 id":970503,"함순이 이름":"애리조나·META","한글 함순이 + 스킨 이름":"애리조나·META","영문 함순이 + 스킨 이름":"Arizona META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705030/shipyard.png","설명":"저는 애리조나… 이런 말씀 드리긴 좀 그렇지만, 정말 절 여기 두셔도 괜찮으신 건가요? …지휘관님께서 그렇게 말씀하신다면… 알겠습니다.","자기소개":{"voiceline":"만약 다른 세상이 있다면, 그곳에도 애리조나가 있을까요…? 만약 그렇다면, 부디 무수히 많은 세상 속에는 더 일찍 지휘관님을 만나, 눈물없는 나날을 보내고 있는 애리조나가 있기를….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/profile.ogg"},"메인1":{"voiceline":"애리조나의 눈물'… 저 말씀이신가요? 감정을 제어하지 못하는 모습을 보여드린 것 같네요…. 죄송해요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/main1.ogg"},"메인2":{"voiceline":"저랑 오랫동안 같이 있으면, 잔혹한 꿈에 휘말리고 마는 것 같아요. 그러니 웬만하면… 신경 안 쓰신다구요? 그…렇군요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/main2.ogg"},"메인3":{"voiceline":"아, 방금 소리는… 저 때문에 또 무언가 망가진 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/main3.ogg"},"전투개시":{"voiceline":"이게 올바른 판단이기를…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/battle.ogg"},"상세확인":{"voiceline":"가능하다면 모든 걸 다시 시작하고 싶어요. …그렇지만, 설령 다시 시작할 수 있다고 해도, 결국은 똑같은 결말을 맞이하게 되는 건 아닐까요…? 지휘관님 생각은 어떠세요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/detail.ogg"},"드랍 설명":{"voiceline":"애리조나 호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>'","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어요. …같이 마중을? 괜찮아요. 제가 가봤자 안 좋은 일만 일어날 테니….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/expedition.ogg"},"실망":{"voiceline":"역시 절 혼자 두시는 게 좋겠어요. 안 그러면 다른 동료들까지 상처 주게 될 테니….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/feeling1.ogg"},"낯섦":{"voiceline":"조금 더 거리를 둬 주시면 안 될까요…? 아뇨, 지휘관님을 멀리 하려는 게 아니라, '이쪽' 베스탈이 드리는 조언인데… 안 그러면 지휘관님께 안 좋은 일이….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/feeling2.ogg"},"호감":{"voiceline":"곁에 있어도 정말 그… 그러니까, 끔찍한 꿈을 꾸거나 하지 않으세요? 정말요? 지휘관님을 못 믿는 건 아니에요. 그렇지만…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/feeling3.ogg"},"기쁨":{"voiceline":"마음이 놓이는 안정감…. 지휘관님 곁에 있으니, 이 감각이 조금씩 돌아오는 것 같아요…. 이렇게 행복한데, 잃게 되면 어쩌나 무서워서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/feeling4.ogg"},"사랑":{"voiceline":"절망과 고통의 심연에서 절 구해주신 지휘관님…. 당신이야말로 제가 마지막으로 의지할 수 있는 희망이랍니다. 더, 더 노력해서… 언젠간 반드시 이 부정적인 감정을 극복하고 말겠어요! 지휘관님, 그때까지 제 곁에서 기다려…주실 수 있으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"저기… 지휘관님께서 안 계시는 동안, 집무실 조명이 또 망가져서… 죄송해요, 또 폐를 끼치고 말았네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/home.ogg"},"hp 경고":{"voiceline":"안돼! 이대로면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/hp_warning.ogg"},"로그인":{"voiceline":"어서 오세요. 지휘관님께서 계시니, 집무실도 환해지네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/login.ogg"},"실패":{"voiceline":"만약, 만약 다시 되돌릴 수 있다면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 온 편지예요…. 책상 위에 둘게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/mail.ogg"},"임무":{"voiceline":"아직 남아있는 임무가 있을까요? 가능한 한 도와드릴게요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/mission.ogg"},"임무완료":{"voiceline":"임무가 무사히 완료됐어요… 휴우, 순조롭게 진행돼서 다행이에요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/mission_complete.ogg"},"서약":{"voiceline":"계속 곁에서, 저를 지켜봐주시겠다구요…? …으흑…!! 죄, 죄송해요, 눈물이… 눈물이 멈추지 않아서… 지휘관님을 믿어요…. 당신은 유일한 제 마음의 안식처….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/propose.ogg"},"스킬":{"voiceline":"이제 끝내도록 하죠…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/skill.ogg"},"터치1":{"voiceline":"죄, 죄송해요! 함부로 절 만지면… 괘, 괜찮으세요? …다행이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/touch.ogg"},"터치2":{"voiceline":"이건… 무슨 징계 같은 건가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/touch2.ogg"},"입수시":{"voiceline":"저는 애리조나… 이런 말씀 드리긴 좀 그렇지만, 정말 절 여기 두셔도 괜찮으신 건가요? …지휘관님께서 그렇게 말씀하신다면… 알겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/unlock.ogg"},"강화성공":{"voiceline":"도움이 될 수 있다면 좋겠는데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리는… 축하할만한 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":nul