[{"클뜯 id":401360,"클뜯 함순이 id":40136,"함순이 이름":"Z36","한글 함순이 + 스킨 이름":"Z36","영문 함순이 + 스킨 이름":"Z36","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401360/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401360/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401360/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401360/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401360/shipyard.png","설명":"1936년 B형 구축함 – Z36","자기소개":{"voiceline":"브레멘 출신의 구축함, 사람들은 나를 \"데빌 아이돌 제크\" 라고 부르지! 동료와 함께 발트해를 건너왔지만, 마지막에는 그 심해에 가라앉는 검은 마구가 되어……흥, 내 고혹의 힘으로 당신에게 승리를 가져다 주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/profile.ogg"},"메인1":{"voiceline":"지휘관, 퓐 못 봤어? 한순간에 모습을 감추는 그 신출귀몰함, 이 마안을 가지고 있어도…엣, 저기 있다구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/main1.ogg"},"메인2":{"voiceline":"고혹의 힘을 주입하는 데빌 아이돌의 노래, 아무도 도망갈 수 없어! (번쩍!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/main2.ogg"},"메인3":{"voiceline":"후후후…전투든! 콘서트든! 이 힘을 해방시키면 식은 죽 먹기지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/main3.ogg"},"전투개시":{"voiceline":"봉인 해제! 자아, 데빌 아이돌의 힘을 그 눈에 똑똑히 새기도록 해! (번쩍!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/battle.ogg"},"상세확인":{"voiceline":"흐흥~, 어때? 이 불길한 힘을 표현하는 그라나트(Granat)의 마안……레, 렌즈 낀 거 아니거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/detail.ogg"},"드랍 설명":{"voiceline":"1936B형 구축함 - Z36","voicelink":null},"의뢰 완료":{"voiceline":"멀리 나갔던 동료들이 돌아왔어. 감사하는 마음으로 귀환을 영접하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/expedition.ogg"},"실망":{"voiceline":"당신이 파멸하는 미래, 이 제크의 마안이 포착했다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/feeling1.ogg"},"낯섦":{"voiceline":"흐흥, 데빌 아이돌의 파장을 수신할 수 있는 소질이 있는 자인 것 같군! 자아, 이 제크의 팬이 되도록!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/feeling2.ogg"},"호감":{"voiceline":"흐흥, 데빌 아이돌의 각인을 그 몸에 깃들게 해 주지!...앗! 기다려! 아직 다 못 그렸단 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/feeling3.ogg"},"기쁨":{"voiceline":"각인을 공유하는 자……그래, 당신은 지금 데빌 아이돌과 운명을 함께하는 사람이야! 즉, 제크의 팬이라는 거지! 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/feeling4.ogg"},"사랑":{"voiceline":"큭…지휘관 곁에서라면 내 고혹의 힘을 사용하지 않더라도 마음속에서 무한하게 우러러나오는 용기와 사랑을 느낄 수 있어. 그건 즉……지휘관을 좋아하게 되었다는 뜻이지! 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/feeling5.ogg"},"터치3":{"voiceline":"보여주도록 하지! 이 몸의 어둠의 율동을……잠깐, 지휘관! 이 이상 머리를 쓰다듬으면 키가 안 큰다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/headtouch.ogg"},"모항귀환":{"voiceline":"하아…하아……왜 이렇게 지쳤냐구? 흥, 그야 물론 이 고혹의 힘을…아앗, 알았어, 알았다구! 콘서트 연습이 있었어! ><","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/home.ogg"},"hp 경고":{"voiceline":"큭, 힘이 폭주한다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/hp_warning.ogg"},"로그인":{"voiceline":"오오, 마침 잘 왔군! 흠, 나의 신곡……이름하여 '악마서곡-데빌 인트로'……듣고 가지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/login.ogg"},"실패":{"voiceline":"큭…데빌 아이돌에게 패배린 없어……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/lose.ogg"},"우편":{"voiceline":"숭배자로부터 편지가?......음, 그렇구나, 지휘관한테 온 건가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/mail.ogg"},"임무":{"voiceline":"하늘에 빛나는 것은, 갈 곳을 잃은 샛별! 자아, 행등을 시작하는 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/mission.ogg"},"임무완료":{"voiceline":"별이 가져다 준 우리들의 분진을 위한 보상……지휘관, 놓치지 말고 보도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/mission_complete.ogg"},"서약":{"voiceline":"데빌 아이돌, 함께 영혼의 선율을 연주하는 상대를 손에 넣었다! 그렇다면 해야 할 일은 하나뿐……무대에서도, 전장에서도, 고혹의 힘은 앞으로 사랑하는 지휘관만을 위해서 사용할거야!......즉, 제크는 계속 당신과 함께라는 거야♪ 알겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/propose.ogg"},"스킬":{"voiceline":"고혹을 관장하는 악마의 전력……온몸으로 받아랏!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/skill.ogg"},"터치1":{"voiceline":"자, 잠깐 기다려! 아무리 지휘관이어도 내 힘을 봉인한 이 붕대를 푸는 것은 용서받을 수 없어! 용서 못 해요! 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/touch.ogg"},"터치2":{"voiceline":"데, 데빌 아이돌의 몸을 멋대로 만지면 벌 받을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/touch2.ogg"},"입수시":{"voiceline":"음후후훗, 당신이 지휘관인가? 이렇게 만난 것 또한 운명의 인도…… 매혹의 힘을 관장하며, 메탈 블러드의 염원을 가슴에 품은, 이름하여 '데빌 아이돌 제크짱', 당신의 힘이 되어주지! (짜잔~~~!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/unlock.ogg"},"강화성공":{"voiceline":"악마에게 받은 고혹의 힘…데빌 아이돌의 각성이 지금, 다시 한 번!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 승리는 운명이 인도한 것…즉, 필승이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['Z35'] : 데빌 아이돌 듀엣……엣!? 퓐, 날 두고 가지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401360/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0}]