[{"클뜯 id":103270,"클뜯 함순이 id":10327,"함순이 이름":"루이빌","한글 함순이 + 스킨 이름":"루이빌","영문 함순이 + 스킨 이름":"Louisville","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103270/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103270/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103270/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103270/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103270/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103270/shipyard.png","설명":"노샘프턴급 중순양함—루이빌, 현호 CA-28","자기소개":{"voiceline":"노샘프턴급 중순양함 루이빌입니다. 그 대전에서는 항공모함을 지원하거나, 훈련함을 하거나, 전함대를 요격하거나…… 어머, 훈련함을 했던 건 그것보다 더 옛날 일이었나…? 음… 잘 모르겠네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/profile.ogg"},"메인1":{"voiceline":"럭키 루랑은 자주 마시러 가요~ 아, 그렇지만 마시면 다음 날에는 무슨 일이 있었는지 잘 기억을 못해요… 그렇게 많이 취한 것도 아닌데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/main1.ogg"},"메인2":{"voiceline":"업무 내용은 잘 기억하고 있어요. 음, 루이빌도 그 정도는 열심히 외우면 기억할 수 있다구요. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/main2.ogg"},"메인3":{"voiceline":"업무에 너무 빠져들면 주변을 잘 안 보게 되고, 평소 기억하고 있는 걸 잊어버릴 수도 있어요. 아무리 일정이 빡빡해도 너무 열심히 하는 건 안 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/main3.ogg"},"전투개시":{"voiceline":"레이디 루! 참전합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/battle.ogg"},"상세확인":{"voiceline":"지휘관님의 오늘 일정… 잘 기억해 두라구요…? 기, 기억하기만 하는 거면 너무 쉽잖아요? 그럼, 이다음 일정은 어떻게 되냐구요? 그, 그건…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/detail.ogg"},"드랍 설명":{"voiceline":"노샘프턴급 중순양함 - 루이빌 CA-28","voicelink":null},"의뢰 완료":{"voiceline":"누군가 돌아왔다구요? …음, 의뢰팀이라는 건 저도 알아요. 지휘관님, 놀리지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/expedition.ogg"},"실망":{"voiceline":"동료를 슬프게 하거나 상처를 주면 안 돼요. 그것만은 기억해 두세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 슬슬 휴식 시간이에요. 간식으로 과자라도…… 방금 음료도 가져다주지 않았냐구요? 그러고 보니… 그렇네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/feeling2.ogg"},"호감":{"voiceline":"오늘 지휘관님 업무를 도와드리러 왔어요. 늘 피곤하신 것 같아서 힘이 좀 되어드리려고…… 사실은 어제 그러기로 약속했다구요? 아, 아하하하… 저… 정말 괜찮은 걸까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 오늘 서류는 전부 정리해뒀어요. …시간이요? 아… 죄송해요, 저도 참… 시간을 잊고 있었네요… 어, 어차피 아직 일도 안 끝났으니, 조금만 더 계속해도…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/feeling4.ogg"},"사랑":{"voiceline":"쿨쿨… 아, 안 되지… 지휘관님 집무실에서 저도 모르는 새에 잠이 들었나 봐요. 어, 어라…? 왜 여기 있는 거죠…? 지휘관님의 업무를 돕고 있었다…구요? 어머, 제가 그런 좋은 일을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/feeling5.ogg"},"터치3":{"voiceline":"어머…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 어서 오세요. 시장하실까봐 영양 만점 도시락을 준비했으니 천천히 드세요. ……같이 안 먹냐고요? 네! 그럼… 어머, 제 몫은 따로 준비를 안 했네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/home.ogg"},"hp 경고":{"voiceline":"여차할 때를 대비해 철수 경로를…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/hp_warning.ogg"},"로그인":{"voiceline":"오늘 업무 내용은 모항 시찰, 연습 계획 확인, 친목회 참가에… 응? 아침에는 우선 뭘 하는 거였죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/login.ogg"},"실패":{"voiceline":"패배한 것 같아요… 지휘관님, 이 경로로 도망가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/lose.ogg"},"우편":{"voiceline":"우편이 왔네요. 우선은 이것부터 개봉해서… 어라? 어느 쪽이 새로운 우편이었죠…? 지휘관님, 기억나세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/mail.ogg"},"임무":{"voiceline":"분명 처리해야 할 임무가 아직 있는 것 같은데… 지휘관님, 한 번만 더 체크해 볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/mission.ogg"},"임무완료":{"voiceline":"임무 완료네요. 보상 수령은 까먹기 전에 해두는 편이 좋을 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 뭘 멍하니 계세요? 다음은 사랑의 맹세를…… 응? 우선 키스부터 하는 거였나요…? 조, 좋아요. 순서를 잊은 게 아니라, 조금 단계를 생략하려고 하신다는 것쯤은 저도 아니까요… 조, 조금 더 뒷단계로 나아가도… 저는 괜찮아요. ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/propose.ogg"},"스킬":{"voiceline":"목표에 집중… 발사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/skill.ogg"},"터치1":{"voiceline":"무슨 일 있으세요, 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/touch.ogg"},"터치2":{"voiceline":"아…? 지금 만지신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/touch2.ogg"},"입수시":{"voiceline":"중순양함 루이빌, 모항에 도착했습니다. 앞으로 지휘관님 곁에서… 그러고 보니 지휘관님의 집무실은 어디였죠? 이쪽은 아닌 것 같고, 저쪽…? 저기~ 죄송합니다. 길 좀 알려주실 수 있으실까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/unlock.ogg"},"강화성공":{"voiceline":"강화에 성공했습니다. 이건 대단한 일이죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/upgrade.ogg"},"vote":null,"승리":{"voiceline":"루이빌, MVP를 획득했습니다. 이건 대단한 일이죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/win_mvp.ogg"},"전투개시_ex":{"voiceline":"레이디 루, 지휘관님과 함께――","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/battle_ex.ogg"},"상세확인_ex":{"voiceline":"오늘 일정은… 영화관에서 새로운 세트를 시찰하고, 밥을 먹고…… 지휘관님이랑 함께하는 거니까 잘 기억하고 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"지휘관님, 의뢰팀이 돌아왔어요. 다들 수고했으니 도시락을 부두까지 가져다줄까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/expedition_ex.ogg"},"사랑_ex":{"voiceline":"쿨쿨…… 음… 어라…? 지휘관님이 왜 제 방에…… 응? 아하, 집무실이었군요… 왜 그런 착각을…… 음… 여기 진짜 집무실 맞…죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관님, 어서 오세요. 도시락 같이 드시겠어요? 후후후, 사양 마시고 드세요. 지휘관님이 맛있게 드시는 모습이 바로 제 영양분이니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘 업무 내용은 학교 순찰, 장비 점검, 루이빌과 데이트…… 네? 사실은 데이트뿐이라구요? 그, 그래요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"뭐 잊으신 거라도 있으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/touch_ex.ogg"},"터치2_ex":{"voiceline":"으읏…/// 여, 역시 만지신 거 맞죠? 정말, 머리로는 기억 못해도, 몸은 기억하고 있다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['노샘프턴', '시카고', '휴스턴'] :  내 옷 사이즈가 좀 안 맞는 것 같은…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관님, 여기 서류에는 이미 사인하셨어요. …정말, 지휘관님에 대해서는 열심히 기억할 거라고 했잖아요… 보세요, 사인 되어있죠? 흥.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/main5_ex.ogg"},"메인6_ex":{"voiceline":"……하아, 앗. 아, 아무것도 아니에요! 지휘관님의 얼굴을 계속 보고 있다가, 업무 중인 걸 깜빡하다니… 그런 건…… 아읏…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"어제는 지휘관님이랑 같이 마셨잖아요. 기억 안 나세요? …마, 맞다. …지휘관님이 중간에 필름이 끊겨서, 그래서… 아, 아무것도 아니에요. ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103270/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":1},{"클뜯 id":103271,"클뜯 함순이 id":10327,"함순이 이름":"루이빌","한글 함순이 + 스킨 이름":"판타지 추천","영문 함순이 + 스킨 이름":"An Order of Dreams","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103271/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103271/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103271/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103271/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103271/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103271/shipyard.png","설명":"지휘관님, 여기 주문하신… 음… 분명 전표에 적혀 있을 텐데… 어라? 그러고 보니 전표를 어디에다 뒀죠? 으… 지휘관님 주문에서 실수하면 큰일인데…","자기소개":null,"메인1":{"voiceline":"각설탕을 포크에 올려놓고 불을… 후후, 지휘관님도 같은 술이라도 이렇게 특별하게 마시는 편이 더 좋지 않아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103271/main1.ogg"},"메인2":{"voiceline":"더 마시고 싶으시면 언제든 말씀하세요. 가, 가능하면 똑같은 걸로 주문해 주시면 고맙… 아뇨, 열심히 외울게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103271/main2.ogg"},"메인3":{"voiceline":"휴스턴의 의상이 평소보다 몸에 붙는 것 같기도 하고