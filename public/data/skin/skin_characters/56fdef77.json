[{"클뜯 id":605070,"클뜯 함순이 id":60507,"함순이 이름":"안드레아 도리아","한글 함순이 + 스킨 이름":"안드레아 도리아","영문 함순이 + 스킨 이름":"Andrea Doria","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605070/shipyard.png","설명":"안드레아 도리아급 전함 - 안드레아 도리아","자기소개":{"voiceline":"안드레아 도리아급의 1번함이야. 선배로서 내세울 만한 함력은 별로 없지만, 후배를 보살피는 데에는 문제없어! 뭐든지 맡겨줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/profile.ogg"},"메인1":{"voiceline":"따뜻한 우유, 한 잔 더 할래? 지금 바로 가져다 줄 테니까 식기 전에 마셔.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/main1.ogg"},"메인2":{"voiceline":"좀 편안하게 있고 싶어도 누가 들어오면 어쩌나 하고… 휴우…… 지휘관도 이런 거 고민하고 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/main2.ogg"},"메인3":{"voiceline":"지휘관, 나… 애들 앞에서 잘하고 있어? …너무 응석을 받아주기만 하는 건 아니지? 좀 자신이 없어서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/main3.ogg"},"전투개시":{"voiceline":"후배들에게 꼴사나운 모습을 보일 순 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/battle.ogg"},"상세확인":{"voiceline":"휴우… 지휘관, 나 믿음직스러워 보여? 그… 후배들한테 엉성한 모습을 보이면… 그렇지. 선배로서 귀감이 되어야겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/detail.ogg"},"드랍 설명":{"voiceline":"안드레아 도리아급 전함 - 안드레아 도리아","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어. 고생한 애들을 위로해주러 같이 가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/expedition.ogg"},"실망":{"voiceline":"지휘관... 무슨 일 있어? 힘이 될 수 있는 부분이 있다면, 내가 더 분발할게….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/feeling1.ogg"},"낯섦":{"voiceline":"모항에는 다양한 애들이 있고, 그 중에는 지휘관을 난감하게 하는 말썽쟁이도 있지? 감당하기 힘들 땐 언제든 이 누나한테 맡겨달라구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/feeling2.ogg"},"호감":{"voiceline":"지휘관, 혹시 고민있어? …참기만 하는 건 안 좋아. '들켰구나'라고? 에헤헷, 나도 지휘관처럼 고민하면 얼굴에 드러나는 타입이거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/feeling3.ogg"},"기쁨":{"voiceline":"휴우… 지휘관, 나 '괜찮은 선배' 역할, 잘 수행하고 있는 것 같아? 애들한테 못 미덥게 보이는 건 아니겠지…… 그걸 알기 위해서라도 조금은 동료에게 의지해 보는 편이 좋다고? 그, 그럼… 지휘관한테 의지해도 돼…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/feeling4.ogg"},"사랑":{"voiceline":"계속 믿음직스러운 모습을 보이는 건 힘들어…. 아, 그렇지만 지휘관만 곁에 있어 준다면, 아무리 우울해도 딛고 일어설 수 있어. 그러니까… 예를 들면 자신감이랑 의욕을 충전! …해주는 것 같은? 에헤헷, 나한테는 지휘관이 가장 가까운 사람이니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관이 자리를 비운 동안 동료가 몇 명 왔었어. 아, 지휘관에게 전해달라는 말은 여기에 다 적어뒀으니까 한번 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/home.ogg"},"hp 경고":{"voiceline":"조, 조금만 더 힘내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 슬슬 업무 시작하려고? 우선 따끈한 우유 한 잔 하고 시작할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/login.ogg"},"실패":{"voiceline":"괜찮아. 지금은 실패했지만, 다음에는 꼭 지휘관이 승리로 이끌어 줄 테니까…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/lose.ogg"},"우편":{"voiceline":"새 우편이 왔어. 얼마 전에 주문한 우유가 벌써 온 걸까……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/mail.ogg"},"임무":{"voiceline":"새 임무야. 후배들에게 맡겨서 가벼운 수업으로 활용해 볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어! 응응, 다들 잘 했어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/mission_complete.ogg"},"서약":{"voiceline":"지휘관에게 인정받아서 나, 너무너무 영광스러워… 응? 앞으로 잘 부탁한다고? 응! 물론이야! 지휘관도 언제든 내게 응석 부려도 돼! 괜찮으면 가끔은 내 투정도 들어주고… 에헤헷♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/propose.ogg"},"스킬":{"voiceline":"더 이상 다가오지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/skill.ogg"},"터치1":{"voiceline":"음… 지휘관, 이러면 긴장이 좀 풀릴까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/touch.ogg"},"터치2":{"voiceline":"어, 어쩌다 지휘관까지 말썽을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/touch2.ogg"},"입수시":{"voiceline":"지휘관, 만나서 반가워. 사르데냐 엠파이어의 전함인 안드레아 도리아야. 오늘부터 신세를 지겠네. 아, 지휘관 함대에 도움이 필요한 애가 있다면 내가 미력하나마 열심히 노력해서 돌봐줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/unlock.ogg"},"강화성공":{"voiceline":"선배로서 다른 애들한테 뒤처져서는 안 되겠지…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"내 활약이 보다 많은 동료들에게 격려가 될 수 있기를….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/win_mvp.ogg"},"전투개시_ex":{"voiceline":"괜찮아, 내겐 지휘관이 있으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/battle_ex.ogg"},"상세확인_ex":{"voiceline":"의지해도 좋다는 말을 해줘서 기쁘긴 한데, 매일 바빠 보이는 지휘관에게 부담을 주는 것도… 으… 혼자서 고민해봤자 어쩔 도리가 없으니, 트렌토네한테 고민 상담이라도 받아 볼까...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰가 완료됐네. 보수 집계는 내게 맡겨줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"요즘은 출격도 많아서 정신 없지? 자, 서류를 확인하기 쉽게 정리해 뒀어. 이걸로 지휘관도 10분 정도는 쭉 쉴 수 있을 거야. 에헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘 마실 따뜻한 우유를 준비해 뒀어. 훌쩍 마시고 활기차게 업무 시작해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"임무야. 한숨 돌리고 나랑 같이 처리해 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/mission_ex.ogg"},"임무완료_ex":{"voiceline":"무사히 완료했네. 역시 지휘관! 장하다, 장해… 에헤헷, 다른 애들 몫은 나중에♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"왜~? 응석 부리고 싶어졌어? 우후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/touch_ex.ogg"},"터치2_ex":{"voiceline":"마음껏 어리광 부려도 된다구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이거야말로 멋진 선배의 품격이라는 거지! 에헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관에게 귀여움 받는 걸 좋아하는 애도 있고, 지휘관을 귀여워하는 걸 좋아하는 애도…… 나로선 좀 뭐랄까… 묘한 느낌이 든다고 해야 하나...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"멋진 선배로서의 모습을 유지하려면 역시 지휘관과 단둘이서 보내는 시간을 만드는 편이 좋겠지. 그렇지만 그러면 나만 지휘관을 독점하는 것 같은……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605070/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"RN","레어도":"SR","ex_chat_status":1},{"클뜯 id":605071,"클뜯 함순이 id":60507,"함순이 이름":"안드레아 도리아","한글 함순이 + 스킨 이름":"Have a safe flight!","영문 함순이 + 스킨 이름":"Have a Safe Flight","스킨 타입":"On The Job","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605071/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605071/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605071/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605071/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/605071/shipyard.png","설명":"\"저는 객실 승무원인 안드레아 도리아입니다. 쾌적한 비행이 되실 수 있도록 최선을 다하겠습니다.\" …지휘관, 방금 건 자연스러웠어……? 아직은 조금 긴장하고 있는 것 같다고? 하아… 역시 처음 해보는 일이라 어렵네….","자기소개":null,"메인1":{"voiceline":"구명조끼 착용 방법 시연이 있겠습니다……. 음… 지휘관, 이 다음에는 어떻게 하는 거였지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605071/main1.ogg"},"메인2":{"voiceline":"음료는 뭘로 할래? 주스, 커피, 사이다? 물론 따뜻한 우유도 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605071/main2.ogg"},"메인3":{"voiceline":"거기, 비행기 안에서는 장난치면 안 돼. 말 안 들으면 지휘관 불러올 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605071/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"\"오늘은 저희 항공편을 이용해 주셔서 대단히 감사합니다.\" …휴우, 이런 식으로 읽으면 되는 건가? 익숙하지 않은 걸 하려니 실수할까봐 걱정돼서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605071/detail.ogg"},"드랍 설명":{"voiceline":"\"저는 객실 승무원인 안드레아 도리아입니다. 쾌적한 비행이 되실 수 있도록 최선을 다하겠습니다.\" …지휘관, 방금 건 자연스러웠어……? 아직은 조금 긴장하고 있는 것 같다