[{"클뜯 id":105100,"클뜯 함순이 id":10510,"함순이 이름":"메릴랜드","한글 함순이 + 스킨 이름":"메릴랜드","영문 함순이 + 스킨 이름":"Maryland","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105100/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105100/shipyard.png","설명":"콜로라도급 전함 메릴랜드 (BB-46)","자기소개":{"voiceline":"이글 유니온 콜로라도급 전함 2번함의 메릴랜드다. 일전에는 빅 세븐으로 의전 행사에 자주 끌려갔었지. 전적? 훈장은 7개니까 평범한 편인가? 그것보다, 빅 세븐이라 어쩔 수 없었지만, 속력이 낮은 것이 조금 안타까웠어! 그때 항공 모함들을 따라잡을 수 있었다면, 그런 결과는…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/profile.ogg"},"메인1":{"voiceline":"베프와 함께 싸우는 게 가장 즐겁지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/main1.ogg"},"메인2":{"voiceline":"기습은 싫어. 정정당당히 치고받는 것이야말로 전투잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/main2.ogg"},"메인3":{"voiceline":"일 말인가? …잘 몰라. 네가 말하는 대로 하도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/main3.ogg"},"전투개시":{"voiceline":"어이, 거기! 날 실망시키지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/battle.ogg"},"상세확인":{"voiceline":"의전? 명예? 나는 전투 이외의 일 따윈 어찌 되든 상관없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/detail.ogg"},"드랍 설명":{"voiceline":"콜로라도급 전함 메릴랜드 (BB-46)","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰도 전쟁과 관계가 있긴 하지만, 아무래도 의욕이 생기질 않는군….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/expedition.ogg"},"실망":{"voiceline":"약한 사람은 따를 가치가 없다… 듣곤 했었지, 그런 이야기를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/feeling1.ogg"},"낯섦":{"voiceline":"빅 세븐이라는 것을 누가 정했는지는 몰라. 뭐 그 두 사람이 매일 말하고 있을 정도니, 특별한 의미가 있는 것이겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/feeling2.ogg"},"호감":{"voiceline":"전쟁은 혼자 어떻게든 할 수 있는 것이 아니야. 생사를 함께하는 동료, 끝까지 지지해주는 진영의 힘이 없다면 아무리 강해도 지게 되지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/feeling3.ogg"},"기쁨":{"voiceline":"싸워서 해결할 수 없는 문제도 있다고? 흠, 갑작스럽게 믿기는 어렵지만……너라면 어떻게든 해 주겠지? 내가 반한 지휘관이니까 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/feeling4.ogg"},"사랑":{"voiceline":"내 눈이라도 보라고. 여기까지 왔으니 더 이상 말은 필요 없겠지. 안 그래, 내가 가장 신뢰하는 전우여…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"칫, 재미없군. 가만히 있는 건","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/home.ogg"},"hp 경고":{"voiceline":"싸움은 바로 이래야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/hp_warning.ogg"},"로그인":{"voiceline":"화약 냄새가 나는군. 싸움이 시작된 건가? 앗…. 베스탈이 식사를 만들고 있던 것 뿐이었나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/login.ogg"},"실패":{"voiceline":"오클라호마 녀석이 있었다면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/lose.ogg"},"우편":{"voiceline":"회신은 대공 기관총을 설치한 후에 할까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/mail.ogg"},"임무":{"voiceline":"임무를 수행해내지 않으면, 훈장 같은 건 손에 들어오지 않아","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105100/mission.ogg"},"임무완료":{"voiceline":"보상이다. …칫, 별 거 없네.","voicelink":"https://raw.githubusercont