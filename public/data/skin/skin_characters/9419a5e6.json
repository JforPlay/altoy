 Drummer","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105102/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105102/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105102/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105102/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105102/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105102/shipyard.png","설명":"오, 지휘관. 너도 여기서 쉬고 있었나 보군. 괜찮아. 다른 녀석들한테는 여기 있다고 말 안 할 테니, 걱정하지 말고 불꽃놀이나 보라고.","자기소개":null,"메인1":{"voiceline":"웨스트버지니아가 아이들한테 뭔가 보여주자고 하더군. 그래서 어쩔 수 없이 분위기를 띄울만한 걸로 갔는데… 설마 동요일 줄이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/main1.ogg"},"메인2":{"voiceline":"해변에서 하는 쇼는 이 정도로 화려해야 제맛이지. 신나게 놀아야 스트레스도 풀리는 법이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/main2.ogg"},"메인3":{"voiceline":"…크으~! 해변에서 마시니까 진짜 끝내주네! 지휘관, 같이 한 잔 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/main3.ogg"},"전투개시":{"voiceline":"박살을 내주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/battle.ogg"},"상세확인":{"voiceline":"그러고 보니 지휘관, 저번에 콜로라도랑 웨스트버지니아랑 같이 했던 라이브는 어땠어? 맘에 들면 다음엔 나 혼자서 해줄 수도 있는데…… 지휘관만을 위한 프라이빗 쇼라고나 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/detail.ogg"},"드랍 설명":{"voiceline":"오, 지휘관. 너도 여기서 쉬고 있었나 보군. 괜찮아. 다른 녀석들한테는 여기 있다고 말 안 할 테니, 걱정하지 말고 불꽃놀이나 보라고.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어. 다들 기운이 넘치는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"굳이 말하지 않아도 내 마음, 잘 알잖아? 이제 우린 겨우 서로 등이나 맡기는 사이가 아니야. 넌 내가 싸우는 이유이자…… 아, 뭘 이런 말까지 하게 만들어! 쑥스럽게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/feeling5.ogg"},"터치3":{"voiceline":"야! 머리가 다 엉망이 되잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/headtouch.ogg"},"모항귀환":{"voiceline":"딱 좋은 타이밍에 왔군. 불꽃놀이가 막 시작한 참이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"불꽃놀이 보기 딱 좋은 자리를 맡아뒀지! 자, 어서 앉으라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/login.ogg"},"실패":{"voiceline":"흥…… 져버렸군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/lose.ogg"},"우편":{"voiceline":"여기까지 전해 주다니… 대체 얼마나 일을 많이 떠안고 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 같이 수영하러……뭐? 청바지를 입고 어떻게 하냐고? 벗으면 되잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/touch.ogg"},"터치2":{"voiceline":"지휘관, 「대가」를 치를 준비는 됐나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/touch2.ogg"},"입수시":{"voiceline":"오, 지휘관. 너도 여기서 쉬고 있었나 보군. 괜찮아. 다른 녀석들한테는 여기 있다고 말 안 할 테니, 걱정하지 말고 불꽃놀이나 보라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"하하하! 완벽한 쇼였어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105102/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_e