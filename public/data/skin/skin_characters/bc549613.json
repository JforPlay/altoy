ttps://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/main2.ogg"},"메인3":{"voiceline":"함대에는 이스트 글림 출신 분들의 수가 적긴 하지만, 그렇다 해서 그분들을 쓸쓸하게 만들어선 안 되겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이스트 글림의 의상엔, 확실히 이국의 매력이 있군요. 메이드대의 제복으로 도입하는 것도 생각하고 있습니다만…… …주인님, 어떠신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/detail.ogg"},"드랍 설명":{"voiceline":"주인님, 그 놀라신 모습은……이스트 글림의 드레스 모습을 바라셨다고 알고 있습니다만, 혹시 이 벨파스트가 잘못 안건지요?","voicelink":null},"의뢰 완료":{"voiceline":"주인님, 의뢰에 힘써주신 분들께 세뱃돈이라도 보내는 게 어떠신지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"벨파스트가 할 수 있는 거라곤, 다른 세력의 문화를 배워 주인님께 보다 잘 봉사하는 것 외에 없습니다. 그에 비해, 주인님께서 함대에 해주시는 건 훨씬 많은데도, 이 벨파스트까지 돌봐주시다니…… 정말이지 곤란한 주인님입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"부디 맛있게 드십시오. 명절에도 집무에 임하시는 주인님을 위해 준비한, 특별한 과자입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오십시오, 주인님. 이스트 글림 각지의 찻잎을 들여놓았습니다. 오늘은 어떤 차를 원하시는지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"벨파스트, 신춘의 경사스런 시기지만, 분부를 내려주신다면 응하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/touch.ogg"},"터치2":{"voiceline":"이 의상의 가장 큰 단점은… 주인님의 마음을 어지럽힌다는 점이군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202121/touch2.ogg"},"입수시":{"voiceline":"주인님, 그 놀라신 모습은……이스트 글림의 드레스 모습을 바라셨다고 알고 있습니다만, 혹시 이 벨파스트가 잘못 안 건지요?","voicelink":"https://raw.githubus