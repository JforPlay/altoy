nk":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202128/detail.ogg"},"드랍 설명":{"voiceline":"\"당신은 저의 운명의 상대인가요?\" …우후후, 인사 올리겠습니다. 벨파스트는 앞으로, 주인님과 영원히 백년해로할 것입니다.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"메이드가 아닌 새로운 자신에게 익숙해지라, 이건가요? ……어려운 말씀을 하시는군요. 하지만……벨파스트에게 있어, 이만큼 행복한 고민은 없답니다. 주인님♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202128/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오늘도 여행담이 있으신지요? 우후훗, 벨파스트가 준비한 간식이라도 드시며 들려주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202128/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘도 늘 하시던 걸 준비해 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202128/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"뒤를 따르는 것 보다, 옆에 서는 편이 더욱 더 주인님과 같은 세계를 볼 수 있게 되네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202128/touch.ogg"},"터치2":{"voiceline":"꺄악…참, 청소 중인데……그렇게 급해하지 않으셔도 된다고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202128/touch2.ogg"},"입수시":{"voiceline":"\"당신은 저의 운명의 상대인가요?\" …우후후, 인사 올리겠습니다. 벨파스트는 앞으로, 주인님과 영원히 백년해로할 것입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202128/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"서약","상점 id":0,"상점 카테고리 id":9998,"스킨 태그":"X","입수 