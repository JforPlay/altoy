oiceline":"드레스는 괜찮은 것 같고, 메이크업 잘 됐나 다시 한번 봐야겠다…… 오늘 파티는 지휘관도 참석하니까, 너무 이상하게 꾸미면 안돼——엣, 지휘관!?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 물자가 도착한 모양이야. 지휘관, 확인 좀 해줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102221/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이, 이런 옷은 어때… 왠지 평소와 다른 이미지고, 혹시 지휘관은 나보다 애틀랜타 언니들을 기대했다거나… 그, 그렇지 않다고? 그, 그럼 됐어! …됐다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102221/feeling5.ogg"},"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"음… 입술은 괜찮으려나… 지휘관? 벌써 왔어? 지, 지금 갈게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102221/login.ogg"},"실패":null,"우편":{"voiceline":"우편이라면 늘 두는 곳에 놔뒀어. 나중에 확인 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102221/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"피곤해… 인사하러 돌아다니는 게 이렇게 힘든 일이었을 줄이야… 아, 화장, 화장… 지휘관, 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102221/touch.ogg"},"터치2":{"voiceline":"꺄악!? 뭐, 뭐야!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102221/touch2.ogg"},"입수시":{"voiceline":"드레스는 괜찮은 것 같고, 메이크업 잘 됐나 다시 한번 봐야겠다…… 오늘 파티는 지휘관도 참석하니까, 너무 이상하게 꾸미면 안돼——엣, 지휘관!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102221/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"오늘만큼은 자랑해도 되겠지… 내, 내가 넘버 1이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102221/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":n