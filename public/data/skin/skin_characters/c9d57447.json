[{"클뜯 id":102220,"클뜯 함순이 id":10222,"함순이 이름":"산후안","한글 함순이 + 스킨 이름":"산후안","영문 함순이 + 스킨 이름":"San Juan","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102220/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102220/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102220/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102220/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102220/shipyard.png","설명":"애틀란타급 경순양함-산후안, CL-54 ","자기소개":{"voiceline":"나는 대공순양함, 애틀란타급 4번함 산후안이야. 많은 항공모함 편대에 소속되었었지. 엔터프라이즈, 새러토가, 와스프 그리고 에식스급 의 몇몇과 함께 한 적이 있어. 항공모함의 조수 경험은 풍부하다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/profile.ogg"},"메인1":{"voiceline":"지휘관… 또 멍 때리고 있는 건 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/main1.ogg"},"메인2":{"voiceline":"항공모함의 조수라면 하늘만 보면 되는데, 지휘관의 조수를 하는 건 그렇게 쉽지 않네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/main2.ogg"},"메인3":{"voiceline":"언니들이 지휘관에게 폐를 끼치진 않지? 그럼 다행이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/main3.ogg"},"전투개시":{"voiceline":"대공지원은 나에게 맡겨줘. 모두 돌격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/battle.ogg"},"상세확인":{"voiceline":"책에 써있던 대로 새 덫을 놓았는데 왜 아무것도 잡히지 않지? 이상하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/detail.ogg"},"드랍 설명":{"voiceline":"애틀란타급 경순양함-산후안, CL-54","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 물자가 도착한 것 같네. 지휘관, 아냐…… 내가 가서 볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/expedition.ogg"},"실망":{"voiceline":"이런 지경까지 되어버린건가. 하지만 포기하지 않겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/feeling1.ogg"},"낯섦":{"voiceline":"항상 게으른 얼굴을 하고 있으면 모두의 신뢰를 잃게 될 거라구. 지휘관! 정신차려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/feeling2.ogg"},"호감":{"voiceline":"내 말이 듣기 싫을 수도 있지만 지휘관이라면 그 뜻을 알아줄 거라고 생각해. 윽… 그, 그렇지? 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/feeling3.ogg"},"기쁨":{"voiceline":"사실 처음에는 지휘관에게 미움받을 준비를 하고 있었는데… 물론 지금 같은 상황도 즐거워! 하지만, 더 친한 사람들끼리는 뭘 해야 하는지 잘 모르겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/feeling4.ogg"},"사랑":{"voiceline":"그, 그러니까아… 시간 있으면 같이… 데이트 어, 어때? 평소에 내가 지휘관에게 깐깐했으니까 우리 둘 사이에 거리를 좁히는 책임도 내가 져야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아온 걸 환영해, 전부 다… 잘 되어가고 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/home.ogg"},"hp 경고":{"voiceline":"경, 경상일 뿐이야. 아직 괜찮아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/hp_warning.ogg"},"로그인":{"voiceline":"너무 게·을·러! 오늘의 일은 이미 시작됐다구? 정말이지… 빨리 와. 옷 좀 정리해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/login.ogg"},"실패":{"voiceline":"으… 모두의 퇴각을 엄호하러 왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/lose.ogg"},"우편":{"voiceline":"우편 가져다 줄게. 보는 거 잊으면 안돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/mail.ogg"},"임무":{"voiceline":"아직도 안 끝낸 임무가 있다고? 도저히 힘들면 도와주지 않을 수 없지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/mission.ogg"},"임무완료":{"voiceline":"임무 완료야. 어때? 느낌 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/mission_complete.ogg"},"서약":{"voiceline":"지, 지휘관이 언니들보다 신경을 덜 쓰게 하니까… 한 명 정도는 더 돌봐도 큰 부담이 아니라 승낙한거라고! …그, 그저 지휘관은 특별하니까! 다른 사람이면 신경도 안 썼어. 알, 알겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/propose.ogg"},"스킬":{"voiceline":"비행금지구역에 들어왔구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/skill.ogg"},"터치1":{"voiceline":"지휘관, 지금은 힘들다고 할 때가 아니야…… 문서 처리가 끝나면 안마라도 해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/touch.ogg"},"터치2":{"voiceline":"어,어어어어디를 만지는거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/touch2.ogg"},"입수시":{"voiceline":"대공순양함, 애틀란타급 4번함 산후안이야. 유니온 항공전대의 믿음직한 서포터지! 도움이 필요해 보이는 지휘관이네… 도울 수 있게 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/unlock.ogg"},"강화성공":{"voiceline":"호위를 더 잘 할 수 있게 되었네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/upgrade.ogg"},"vote":null,"승리":{"voiceline":"전과는 평소 노력의 결과물이야. 자랑거리도 아니지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['애틀란타'] : \"언니\"라고 항상 강조할 필요 없거든……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/couple_encourage1.ogg"},{"voiceline":"['샌디에이고'] : 샌디에이고, 지금은 장난칠 때가 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102220/couple_encourage2.ogg"},{"voiceline":"['쥬노'] : 주노, 겁나면 무리하지 않아도 돼…","voicelink":"https://raw.githubuser