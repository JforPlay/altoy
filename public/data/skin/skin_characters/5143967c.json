AzurLane/main/audio/voiceline/10500050/expedition.ogg"},"실망":{"voiceline":"아~아. 지휘관님의 실력은 고작 이정도구나… 실망스럽다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/feeling1.ogg"},"낯섦":{"voiceline":"그렇다면! 이 세계에서도 도깨비불로 놀래켜보자~ 에? 지휘관님, 놀라지 않는 건가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 짐과 함께 아침까지 게임으로 승부를 가리자! 짐은 절대 지지 않는다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/feeling3.ogg"},"기쁨":{"voiceline":"일어나~ 일어나~ 일·어·나! 계속 게으름을 피우면 두고 가버리겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/feeling4.ogg"},"사랑":{"voiceline":"지휘관님~ 짐이 좋은 술을 하나 가져왔다. 오늘 밤은 짐과 단둘이 술 한잔 어때~ 특, 특별한 뜻은 없다고…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/feeling5.ogg"},"터치3":{"voiceline":"짐의 뿔을 마음대로 만지지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 수고했키리! 식사는 이미 준비됐어. 대단하지 않아? 헤헤, 짐과 함께 먹어보자고! 음~ 맛있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/home.ogg"},"hp 경고":{"voiceline":"윽… 카르마, 시라누이. 뒤는 짐에게 맡겨라……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관님 돌아왔구나~ 짐은 방송 준비를 하고 있어. 조금만 기다려줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/login.ogg"},"실패":{"voiceline":"졌…다고? 다음 번에는 반드시 이기겠어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/lose.ogg"},"우편":{"voiceline":"흐흐흥~♪ 지휘관님, 우편이 왔어. 자, 짐이 가져왔다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/mail.ogg"},"임무":{"voiceline":"인간님들의 일에 대한 고민은 짐이 해결해 주지! 짐이 임무를 완수하는 데 도움을 줄테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 지휘관님. 대단해, 대단해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/mission_complete.ogg"},"서약":{"voiceline":"지휘관님…? 이, 이건…? 짐이 받아도 괜찮은 건가… 에헤헤, 고맙다, 지휘관님~ 앞으로도 계속 함께야~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/propose.ogg"},"스킬":{"voiceline":"아수라수라찰 귀신베기!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/skill.ogg"},"터치1":{"voiceline":"응? 이것들? 이 붉은 검은 [아수라], 다른 하나는 [나찰]이다. 어때? 멋있지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/touch.ogg"},"터치2":{"voiceline":"짐의 성씨를 [베기]라고 하는 소문이 들리더군. 지휘관님도 한번 시험해 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/touch2.ogg"},"입수시":{"voiceline":"안녕하키리! 짐은 hololive 소속의 버츄얼 귀신, 나키리 아야메! 시키가미와 함께 영혼의 땅에서 왔다. 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/unlock.ogg"},"강화성공":{"voiceline":"힘이… 넘치고 있어! 정말 신기한 세계로구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"짐의 완벽한 승리야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아야나미'] : 귀신이 둘이면 100배는 강하다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10500050/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex"