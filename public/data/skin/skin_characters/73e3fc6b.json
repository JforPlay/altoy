[{"클뜯 id":307100,"클뜯 함순이 id":30710,"함순이 이름":"아카기(μ장비)","한글 함순이 + 스킨 이름":"아카기(μ장비)","영문 함순이 + 스킨 이름":"Akagi μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307100/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307100/shipyard.png","설명":"사쿠라 엠파이어의 비술이라면 이 정도의 변신은 쉽게… 후후, 지휘관님? 아카기의 모습이 어떠신가요? ","자기소개":{"voiceline":"특수 병기-사쿠라 엠파이어의 항공모함 아카기, 인사 올립니다. 지휘관님, 이번에는 예전과 다르게 ‘아이돌’ 스타일을 시도해 보았답니다. 잘 부탁드려요~ 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/profile.ogg"},"메인1":{"voiceline":"아카기도 정말 궁금하네요~ 지휘관님이 누구의 팬인지… 네… 정말 궁금해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/main1.ogg"},"메인2":{"voiceline":"’아이돌’과는 조금 다르지만, 상관없어요. 지휘관님이 원한다면 저는 무엇이든……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/main2.ogg"},"메인3":{"voiceline":"카가, 이 뒤의 연습을 전부 취소해 주겠니? 지휘관님과 함께 있는 시간은 1초도 낭비할 수 없거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/main3.ogg"},"전투개시":{"voiceline":"아카기의 라이브, 제대로 봐달라고요~ 우후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/battle.ogg"},"상세확인":{"voiceline":"지휘관님을 위해서라면 아카기는 무엇이든 할 수 있어요. 물론 ‘아이돌’ 같은 일이라도요… 우후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/detail.ogg"},"드랍 설명":{"voiceline":"사쿠라 엠파이어의 비술이라면 이 정도의 변신은 쉽게… 후후, 지휘관님? 아카기의 모습이 어떠신가요?","voicelink":null},"의뢰 완료":{"voiceline":"벌레 따위가… 지휘관님, 잠시 기다려주실 수 있나요","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/expedition.ogg"},"실망":{"voiceline":"아카기에게 사과하는 지휘관님의 비명소리… 그것도 꽤 듣기 좋은 노래겠네요… 우후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 제 라이브를 보고 싶다고 하셨다면서요? 기뻐요~ 카가, 맨 앞의 자리를 비워둘 수 있니? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/feeling2.ogg"},"호감":{"voiceline":"지휘관님이 원하신다면 아카기의 라이브는 오직 지휘관님의 것이랍니다~ 맞아요. 아카기의 스테이지도 영원히 지휘관님만을 위한 스테이지가 될 거예요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/feeling3.ogg"},"기쁨":{"voiceline":"이제 다른 사람은 필요 없어… 역시 지휘관님을 위해서… ‘청소’를 한 번 해야겠네…… 후후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/feeling4.ogg"},"사랑":{"voiceline":"다른 멤버들과 잘 지내라고요? 지휘관님의 뜻이라면, 아카기도 따르겠지만… 그 대신 지휘관님? 아카기만을 바라봐 주세요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 응원의 라이브는 어떨까요? 물론 아카기 혼자랍니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/home.ogg"},"hp 경고":{"voiceline":"내 사랑은 이 정도가 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 오늘의 스케쥴은 어떤 것인가요? 우후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/login.ogg"},"실패":{"voiceline":"큭… 위험했네요. 지휘관님께 이런 모습을 보여드릴 수는 없죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/lose.ogg"},"우편":{"voiceline":"편지… 지휘관님? 설마… 다른 사람에게 팬레터를 보내진 않으셨겠죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/mail.ogg"},"임무":{"voiceline":"지휘관님, 임무는 저에게 맡겨주실 수 없나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/mission.ogg"},"임무완료":{"voiceline":"임무 완료랍니다. 이 뒤에도 아카기의 곁에 있어 주실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/mission_complete.ogg"},"서약":{"voiceline":"우후후후… 이걸로 저의 모든 것은 지휘관님의 것, 지휘관님의 모든 것도 저의 것이 되었네요… 앞으로 라이브처럼… 지휘관님의 눈과 귀… 그리고 마음을 사로잡을 거예요… 지휘관님, 이미 도망갈 길은 없답니다…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/propose.ogg"},"스킬":{"voiceline":"우후후… 떨어져라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/skill.ogg"},"터치1":{"voiceline":"지휘관님, 무엇을 망설이고 계시는 걸까요? 아카기는 항상 만반의 준비를 갖추고 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/touch.ogg"},"터치2":{"voiceline":"관중석의 눈빛을 신경 쓸 필요는 없어요? 지휘관님이 원하신다면… 우후후♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/touch2.ogg"},"입수시":{"voiceline":"사쿠라 엠파이어의 비술이라면 이 정도의 변신은 쉽게… 후후, 지휘관님? 아카기의 모습이 어떠신가요? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/unlock.ogg"},"강화성공":{"voiceline":"이것이 바로 사랑의 힘이랍니다~ 우후후후~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어머, 앵콜을 요구하는 아이들까지 모두 태워버렸네? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['가스코뉴(μ장비)', '클리블랜드(μ장비)', '아드미랄 히퍼(μ장비)', '셰필드(μ장비)'] : 지휘관님의 얼굴을 봐서 너희들과 맞춰주도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307100/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":nu