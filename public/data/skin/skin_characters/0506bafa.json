[{"클뜯 id":408100,"클뜯 함순이 id":40810,"함순이 이름":"U-37","한글 함순이 + 스킨 이름":"U-37","영문 함순이 + 스킨 이름":"U-37","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408100/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408100/shipyard.png","설명":"메탈 블러드 IXA형 잠수함 U-37 ","자기소개":{"voiceline":"VII형 잠수함보다 우리 IX형 잠수함이 더 크고 더 멀리 갈 수 있어! 우리는 적이 예상하지 못한 곳까지 가서 매복할 수 있지, 그리고——펑! 어뢰 명중! ... 허드슨 베이에서의 일? 그건 그냥 영화일 뿐이야! 진정한 나는 그때 2선에서 아주 잘 있었다고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/profile.ogg"},"메인1":{"voiceline":"\"자료가 사라졌어\" 이런 핑계를 대고 업무 검사를 넘어갈 수 있을까? ... 역시 안되나...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/main1.ogg"},"메인2":{"voiceline":"소위 협력이란, 모두 같이 힘을 내야하지! 그러니까, 적절하게 업무들을 다른 동료들에게 나누어 줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/main2.ogg"},"메인3":{"voiceline":"만약 내 꼬리를 마음대로 만졌다간, 커다란 물고기 뿔로 엉덩이를 찌를 거야! 헤헤, 농담이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/main3.ogg"},"전투개시":{"voiceline":"내가 어디에서 왔~게?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/battle.ogg"},"상세확인":{"voiceline":"내 파티너의 몸에는 위험한 부분이 많으니까, 만질 때 꼭 조심해야해, 지휘관~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/detail.ogg"},"드랍 설명":{"voiceline":"먼 바다를 순찰하는 사냥꾼, U-37 도착! ...음, 지휘관 너 왜 이렇게 멍하니 있어? 어쨌든, 이름도 알려줬으니까, 난 먼저 이만~","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조 돌아왔어? 내가 갈게, 내가! 계속 사무실에만 있으니까 답답해 죽겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/expedition.ogg"},"실망":{"voiceline":"나 갈래! 다시 안 돌아올 거야! 메롱~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/feeling1.ogg"},"낯섦":{"voiceline":"여기는 숙소, 여기는 학교, 여기는 지휘실... 으음, 모항 건물들 위치 대충 다 파악했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/feeling2.ogg"},"호감":{"voiceline":"내 함장은 엄청 커서 두 명도 탈 수 있어! 타볼래? 아주아주 먼 곳까지 데려가 줄 수 있어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/feeling3.ogg"},"기쁨":{"voiceline":"먼 바다에서의 임무를 수행할 때는, 몇날며칠을 홀로 보내야하는 걸 견뎌야해. 하지만 걱정 마, 내가 지휘관의 자는 모습을 찍었으니까. 이걸 가지고 가면 외롭지 않을 거야! 헤헷~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/feeling4.ogg"},"사랑":{"voiceline":"때론 다가가고 싶고, 때론 숨어서 나를 못찾아 조급해하는 너를 보고 싶어... 이게 바로 \"사랑\"인가봐! 이 모순된 마음을 갖게 한 장본인으로서, 제대로 책임져야해. 히힛~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"먼 바다의 사냥꾼 복귀! 사냥감은 놓쳤지만, 마침 땡땡이를 치는 지휘관을 잡아왔어! 히힛~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/home.ogg"},"hp 경고":{"voiceline":"우와, 여기서는 깊이 내려가서 몸을 숨기는게 낫겠어...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/hp_warning.ogg"},"로그인":{"voiceline":"어서와! 별 일 없으면, 난 잠수하고 놀러 갈게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/login.ogg"},"실패":{"voiceline":"유감이지만, 다음에 다시 와서 사냥해야겠어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔어! 어쩌면 아주 먼 곳의 바다에서 온 걸지도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있다고? 잠수 모드 가동! ...음, 운송함을 가로막는 임무 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/mission.ogg"},"임무완료":{"voiceline":"임무 완성! 근데, 나랑은 상관 없는 것 같네? 뭔가 기운이 안 나...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/mission_complete.ogg"},"서약":{"voiceline":"이 날이 올 거라고 일찌감치 예상했었지만, 정말 오고나니까 가슴이 뛰어! 고마워, 바보 같고, 사랑스럽고, 내가 제일 좋아하는 지휘관~ 안심해, 난 항상 네 곁에 있을 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/propose.ogg"},"스킬":{"voiceline":"여긴 못 지나간다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/skill.ogg"},"터치1":{"voiceline":"바닷물에 젖은 소녀의 매끈한 피부, 느낌이 어때~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/touch.ogg"},"터치2":{"voiceline":"지휘관, 설마 잠수함의 몸체에 특별한 관심을 갖고 있는 거야? 으흠~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/touch2.ogg"},"입수시":{"voiceline":"먼 바다를 순찰하는 사냥꾼, U-37 도착! ...음, 지휘관 너 왜 이렇게 멍하니 있어? 어쨌든, 이름도 알려줬으니까, 난 먼저 이만~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/unlock.ogg"},"강화성공":{"voiceline":"항속 능력이 상승했다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"돌아가서 뒷풀이 해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관, 그거 알아? 파트너가 위험한 인물이라면, 그 사람 자신도 꽤 위험한 존재라는 뜻이래~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 내가 제일 설레는 순간이 언제인지 알아? 바로… 지휘관이랑 매복 작전을 완벽하게 성공시켜서 적의 허를 찌를 때야! 그래도 출격 전에… 아주 조금은 전술에 대해 「상의」할 필요가 있을지도~? 그치, 지휘관~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"헤헤, 머리 엉망돼도 괜찮아! 이런 친밀한 느낌, 난 좋아하거든~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"먼바다에 나가 있을 때 가장 그리운 건 말이지… 모항에 돌아온 지휘관을 덥석 낚아채는 바로 그 순간이야! 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"에헤헤, 잡았다~! 여기서 지휘관을 몰래 기다리고 있었어! 어때? 이 먼바다의 사냥꾼이 얼마나 대단한지 또 실감했지~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지금… 체온 확인하는 거야? 나 그렇게 쉽게 감기 안 걸리거든~ 에… 에… 에취!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/touch_ex.ogg"},"터치2_ex":{"voiceline":"그렇게 좋으면… 후후~ 나도 가만히 있진 않을 거니까 각오해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['U-81', 'U-47', 'U-557', 'U-556', 'U-73', 'U-101', 'U-522', 'U-110', 'U-96'] : 울프팩, 사냥 시작!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"바다 밑 세상은 진짜 재밌어! 가끔 반짝이는 심해어도 볼 수 있고~ 궁금하지? 그럼 같이 보러 가자~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/main5_ex.ogg"},"메인6_ex":{"voiceline":"이렇게 가까운 사이인데 지휘관은 아직도 내 꼬리에 관심 많네~? 차가운 꼬리보다… 내 피부가 더 부드럽지 않아~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"일하긴 정말 싫지만~ 지휘관이 열심히 하는 모습을 보니… 나도 좀 힘내야겠다는 생각이 들어! 그러니까 지휘관의 휴식 시간은 이 성실한 나한테 전부 다~ 써줘야 해~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408100/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":408101,"클뜯 함순이 id":40810,"함순이 이름":"U-37","한글 함순이 + 스킨 이름":"물거품처럼 노래하는 정월","영문 함순이 + 스킨 이름":"New Year's Nightingale","스킨 타입":"New Year Kimono","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408101/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408101/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408101/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408101/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408101/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408101/shipyard.png","설명":"그럼~ 이어서 U-37이 바치는 노래 한 곡을 들어줘! ... 음, 지휘관, 왜 아직도 그렇게 멍한 모습인 거야? 내가 어렵게 사쿠라 엠파이어 동료한테 엄청난 걸 배워왔다고~ 진지하게 들어, 시작할게——","자기소개":null,"메인1":{"voiceline":"음, 옷이 계속 이렇게 떨어지니까, 좀 귀찮네... 하지만, 지휘관은 좋지~? 히히~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/main1.ogg"},"메인2":{"voiceline":"U보트 동료들이랑 \"하네츠키\" 하기로 했어. U-110 그 아이, 흥미진진한 모습이~ 그런데... 음, 정말 이렇게 입고 운동할 수 있을까......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/main2.ogg"},"메인3":{"voiceline":"일렉 기타 같은 악기가 나한테 더 잘 어울리는 것 같다고 생각하지만... 지금 이런 모습에는 별로겠지, 아하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"\"그럼, 손님께서는 잠시 자리에 앉아 주십시오, 여자아이의 독주가 있을 것입니다.\"... 으흠, 역시 나야. 그럴듯하게 배워왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/detail.ogg"},"드랍 설명":{"voiceline":"그럼~ 이어서 U-37이 바치는 노래 한 곡을 들어줘! ... 음, 지휘관, 왜 아직도 그렇게 멍한 모습인 거야? 내가 어렵게 사쿠라 엠파이어 동료한테 엄청난 걸 배워왔다고~ 진지하게 들어, 시작할게——","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"듣기론, 연주는 연주가의 마음이 반영된데... 그, 난 아직 가장 간단한 것 밖에 못하는 초보자이긴 하지만... 연주 속에... 내 감정을 들을 수 있겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"좋아! 놀러 가야지~ 와아아악!?——휴, 고마워, 지휘관, 넘어질 뻔했다...... 사쿠라 엠파이어 동료들은 정말 대단해. 이런 옷을 입고도 그렇게 자유자재라니......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"해피 뉴 이어, 지휘관! 음... 새해를 테마로 한 노래가 뭐가 있을까......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"에헤, 난 내 피부에 자신 있다고~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/touch.ogg"},"터치2":{"voiceline":"에이, 지휘관은 역시 유혹을 참지 못하네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/touch2.ogg"},"입수시":{"voiceline":"그럼~ 이어서 U-37이 바치는 노래 한 곡을 들어줘! ... 음, 지휘관, 왜 아직도 그렇게 멍한 모습인 거야? 내가 어렵게 사쿠라 엠파이어 동료한테 엄청난 걸 배워왔다고~ 진지하게 들어, 시작할게——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408101/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"정월","상점 id":70469,"상점 카테고리 id":2,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"KMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":408102,"클뜯 함순이 id":40810,"함순이 이름":"U-37","한글 함순이 + 스킨 이름":"로드 피스 메이커스","영문 함순이 + 스킨 이름":"Keeping Peace in the Streets","스킨 타입":"Special Exercise","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408102/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408102/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408102/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408102/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408102/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408102/shipyard.png","설명":"「여어~ 왔구나, 파트너! 요즘 모항에서 폭주하는 녀석들이 아주 신났더라고~ 슬슬 본때를 보여줘야겠어! 평소처럼 이쪽은 내가 맡을 테니까, 저쪽은 파트너한테 맡길게!」","자기소개":null,"메인1":{"voiceline":"「이 장갑, 파트너한테 줄게! 같이 힘을 합쳐서 모항 도로에 평화를 되찾아 주자!」 …후훗, 가끔은 이런 진지한 대사도 색다르고 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/main1.ogg"},"메인2":{"voiceline":"「속도라면 그런 폭주족 녀석들한테는 절대 안 져! 파트너, 어서 타! 도로의 안전을 지키는 우리의 진짜 실력을 보여주자고!」","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/main2.ogg"},"메인3":{"voiceline":"「모든 『길』은 『교통안전』으로 통하는 법이지! 파트너, 저 녀석들을 쫓을 때도 안전운전 하는 건 잊지 마!」","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"「파트너, 지금 가장 중요한 임무는 그 녀석들을 감시하는 거야! …『스파크 스피더즈』와 취… 『취한 빵셔틀즈』… 푸흡. 녀석들의 레이스가 더 위험해지기 전에 슬슬 움직여야겠어.」 ――이름이 너무 이상해서 나도 모르게 터졌네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/detail.ogg"},"드랍 설명":{"voiceline":"「여어~ 왔구나, 파트너! 요즘 모항에서 폭주하는 녀석들이 아주 신났더라고~ 슬슬 본때를 보여줘야겠어! 평소처럼 이쪽은 내가 맡을 테니까, 저쪽은 파트너한테 맡길게!」","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"「파트너~ 예이~ 하이 파이브! 임무 달성한 거 축하해! (철컥) 후훗, 수갑 채웠으니까 이제 나한테서 도망 못 가~」 ……뭐? 열쇠가 없다고…? 에헤헷~ 그럼 이대로, 영원히 하나가 되는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/feeling5.ogg"},"터치3":{"voiceline":"그렇게 서두를 거 없어. 모자 벗어줄 테니까 맘껏 쓰다듬어도 돼♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/headtouch.ogg"},"모항귀환":{"voiceline":"수고했어~! 오늘도 고생 많았어♪ 내가 이걸로 집까지 데려다줄까~? 괜찮아, 촬영용이긴 해도 허가는 이미 받아놨어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 오늘은 일찍 왔네! 촬영 시작 전에 나랑 드라이브하러 가는 건 어때? 달리는 동안엔 내 허리를 꽉 잡고 있어야 해. 속도에 놀라지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이 의상, 그럭저럭 괜찮지? 꽤 그럴싸하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/touch.ogg"},"터치2":{"voiceline":"에헤헷~ 설마… 수갑이라도 채워줬으면 하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/touch2.ogg"},"입수시":{"voiceline":"「여어~ 왔구나, 파트너! 요즘 모항에서 폭주하는 녀석들이 아주 신났더라고~ 슬슬 본때를 보여줘야겠어! 평소처럼 이쪽은 내가 맡을 테니까, 저쪽은 파트너한테 맡길게!」","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408102/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"특수 훈련","상점 id":71156,"상점 카테고리 id":12,"스킨 태그":"배경","입수 영상":"O","재화":880,"기간":"한정 (2025/07/23)","진영":"KMS","레어도":"SSR","ex_chat_