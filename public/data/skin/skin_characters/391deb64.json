[{"클뜯 id":201330,"클뜯 함순이 id":20133,"함순이 이름":"이카로스","한글 함순이 + 스킨 이름":"이카로스","영문 함순이 + 스킨 이름":"Icarus","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201330/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201330/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201330/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201330/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201330/shipyard.png","설명":"I급 구축함-이카로스","자기소개":{"voiceline":"경력이라면…한때 후드님을 위해 워스파이트와 호위한 적이 있어요. 그리고…대잠수함 작전에서의 얼마간 경험도 있구요. 여러곳을 가보고 적잖은 임무에 참여한 적이 있으니, 경험이 풍부하다고 할 수 있는 셈이죠. 하하하, 그래서 전투에서든 생활에서든 얼마든지 이카로스에게 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/profile.ogg"},"메인1":{"voiceline":"지휘관님, 외출하시려면 먼저 저에게 알려주세요. 제가 날씨에 따라 우산이라던지 외투 같은 것들을 준비해드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/main1.ogg"},"메인2":{"voiceline":"에스키모가 사람들이랑 놀고 싶은가봐요…지휘관님, 우선 일에 집중하세요. 제가 그녀를 위해 동료들 몇몇에게 연락해볼게요. 음…애버크롬비가 딱 맞겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/main2.ogg"},"메인3":{"voiceline":"구축함은 역시 그래도 최상급이 있어야해. 더 큰 포신과 많은 어뢰가 있을 수 있다면… 앗! 그냥 혼잣말이에요. 신경쓰지 마세요(///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/main3.ogg"},"전투개시":{"voiceline":"좋아요…! 이어서 화력을 전력으로 가동하겠어요! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/battle.ogg"},"상세확인":{"voiceline":"지휘관님의 세탁할 옷들…내일 세끼 식사 준비…그리고 또…앗!지휘관님, 언제 오신거에요? 별 것 아니에요. 그저 평소 하던 준비 작업을 하고 있는 것 뿐이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/detail.ogg"},"드랍 설명":{"voiceline":"I급 구축함-이카로스","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 제가 의뢰조 동료들을 맞이하러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/expedition.ogg"},"실망":{"voiceline":"으윽, 계속 이렇게 가다간 이카로스만 지휘관님 곁에 남아 있겠어… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님 그리고 모항의 동료들은 모두 이카로스가 당연히 지켜야할 중요한 존재에요. 모두를 해치려고 하는 적은 화력을 전면 개방하여 신속하게 소멸시키는 것이 당연한거죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 요즘 조금 무리하신거 아닌가요? 적당한 휴식은 하셔야 해요. 한번에 너무 빠르거나 높게 난다면 태양에 날개가 녹아서 바닷속으로 빠져 죽을 거에요. 응? 이건 어디서 본듯한 전설 속 이야기의 상황인데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/feeling3.ogg"},"기쁨":{"voiceline":"휴우… 요즘 지휘관님 곁에 있는 시간이 점점 길어지는 것 같아. 지휘관님을 돌보는 것도 이미 습관의 하나가가 된 것 같아. 설마…오히려 이카로스가 지휘관님에게 의지력이 생긴건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 마치 태양 같아요. 그곳에만 있을 뿐인데도 사람에게 따뜻함을 느끼게 해요. 하지만 너무 가까이 가면 강렬한 열기에 삼켜질까 두렵게도 만들어요. 지휘관님, 제가… 조금 더 가까이 가도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/feeling5.ogg"},"터치3":{"voiceline":"헤헤…이런 제가… 밉지 않으신가요? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/headtouch.ogg"},"모항귀환":{"voiceline":"돌아오신 것을 환영합니다, 지휘관님. 자리를 비우신 동안 제가 방청소를 다 해놓았어요. 네? 칭찬 같은 건… 그렇게 예의 차리실 것 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/home.ogg"},"hp 경고":{"voiceline":"어뢰가 아직 준비되지 않았어… 윽… 이카로스, 조금만 더 견뎌! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님 오셨어요? 음, 필요한 자료들은 모두 테이블에 놔뒀어요. 차도 곧 갖다 드릴테니, 안심하시고 일하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/login.ogg"},"실패":{"voiceline":"만약 방금 어뢰를 다시 한 번 일제 사격할 수 있었더라면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/lose.ogg"},"우편":{"voiceline":"새로운 우편물을 정리해뒀어요. 가져다 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/mail.ogg"},"임무":{"voiceline":"새로운 임무가 내려왔어요. 정신을 차리고 끝내도록 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/mission.ogg"},"임무완료":{"voiceline":"임무를 완료했어요. 지휘관님 정말 최고에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/mission_complete.ogg"},"서약":{"voiceline":"원래 제가 지휘관님에게 대하는 것처럼 지휘관님도 저를 떠나지 못할 것 같으셨군요? 헤헤헤, 저 매우 기뻐요. 앞으로의 모든 일들도 지휘관님께 잘 부탁드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/propose.ogg"},"스킬":{"voiceline":"장전 완료! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/skill.ogg"},"터치1":{"voiceline":"제가 해야할 일이 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/touch.ogg"},"터치2":{"voiceline":"이, 이런 일은 역시 그래도…(///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 지휘관님. 저는 로열 네이비의 I급 구축함 이카로스입니다. 특기는 호송 작전과 대잠수함 작전이에요. 앞으로 많은 가르침 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/unlock.ogg"},"강화성공":{"voiceline":"이로써 더 강한 화력을 발사할 수 있게 되었어요. 크흠…지휘관님을 더 잘 도와드릴 수 있겠군요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼어요~ 모두 지휘관님 덕분이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지금 보니, 태양보다 지휘관님은 겨울의 난로를 더 닮은 것 같아요. 사람을 따뜻하게 하지만 화상 입을 걱정을 할 필요도 없어요. 헤헤헤, 이렇게 함께 붙어있어도 상관없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"음…지휘관이 쓰담쓰담해주시면 매우 마음이 편해져요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님 오셨어요? 네. 자료와 스케줄은 모두 이곳에 두었습니다. 그리고 지휘관님을 위해 레몬차도 준비해뒀어요. 비타민을 보충해야만 일을 더 잘하실 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"이카로스 여기 있어요. 무슨 일 있으면 얼마든지 제게 말씀하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/touch_ex.ogg"},"터치2_ex":{"voiceline":"이, 이런 일은 그래도 장소를 바꿔서…(///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['후드'] : 이번엔 놓치지 않을 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/couple_encourage1.ogg"},{"voiceline":"['워스파이트'] : 또 함께 작전을 수행하게 되었네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"후드 씨는 오늘도 역시나 우아하군요… 지휘관님도 힘내세요, 목표는 후드 씨와 같은 품격을 갖추는 겁니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/main5_ex.ogg"},"메인6_ex":{"voiceline":"숨바꼭질에서 술래할 때… 항상 직감에 따라 모두를 찾았어요. 실은 저 여기에 재능이 있다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님의 도시락이에요, 편식은 안됩니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201330/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":