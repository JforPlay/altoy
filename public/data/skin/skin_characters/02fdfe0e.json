ink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/feeling1.ogg"},"낯섦":{"voiceline":"어이, 너 어딜 보고 있는 거냐. 얘기 안 해도 다 안다니까! ……귀엽다고? 칭찬해봤자 아무것도 안 나온다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/feeling2.ogg"},"호감":{"voiceline":"좀 믿음직스럽진 못한 지휘관이지만, 그래도 기대하고 있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/feeling3.ogg"},"기쁨":{"voiceline":"어이, 지휘관! 다음에 어딘가로 놀러 가자고! 참고로 네놈한텐 거절할 권리가 없으니까 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/feeling4.ogg"},"사랑":{"voiceline":"걱정하지 마라, 늘 네 곁에 있어주마. 왠지는 몰라도 내 가슴이 뜨거워지고 힘이 솟아나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"이번 싸움은 괜찮지 않았나? 그 기세로 앞으로도 잘 부탁하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/home.ogg"},"hp 경고":{"voiceline":"네 녀석이 날 화나게 하는 구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/hp_warning.ogg"},"로그인":{"voiceline":"느리다고. 정말이지… 언제까지 기다리게 할 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/login.ogg"},"실패":{"voiceline":"다음에 내 발목을 잡으면 박살 내주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/lose.ogg"},"우편":{"voiceline":"어이, 우편이 왔다. 빨리 보고 와라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/mail.ogg"},"임무":{"voiceline":"빨리 임무를 끝내버리라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/mission.ogg"},"임무완료":{"voiceline":"좋아! 보너스다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100070/mission_complete.ogg"},"서약":{"voiceline":"이걸… 내게? 너 진심으로 얘기하는 거냐? 그런가, 진심인가…… 알겠