[{"클뜯 id":901060,"클뜯 함순이 id":90106,"함순이 이름":"에페","한글 함순이 + 스킨 이름":"에페","영문 함순이 + 스킨 이름":"Épée","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901060/shipyard.png","설명":"르 아르디급 구축함 - 에페","자기소개":{"voiceline":"안녕, 비시아 성좌 소속, 르 아르디급 구축함 에페야. 보… 보다시피 좀 사정이 있어서 여러모로 서툴지만, 나아지려고 사실 매일 노력하고 있어… 이, 이런 에페라서 지휘관에게 민폐가 되진 않길 바라…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/profile.ogg"},"메인1":{"voiceline":"음…… 응? 무슨 할 말이라도 있냐고? 아, 아니야… 에페는 그… 지휘관한테서 눈을 뗄 수가 없어서… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/main1.ogg"},"메인2":{"voiceline":"저, 저기! 지휘관 옷을 세탁하려고 했는데, 쓱쓱 문질렀더니 너덜너덜해져서…… 흑… 지휘관, 미안해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/main2.ogg"},"메인3":{"voiceline":"지, 지금 에페는 지휘관한테 별 도움이 되지 않을지도 모르지만… 열심히 노력할 거야! 많이 부족하지만, 그래도 에페는 지휘관을 지키는 기사가 되고 싶어…… 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/main3.ogg"},"전투개시":{"voiceline":"아, 아프지 않아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/battle.ogg"},"상세확인":{"voiceline":"에페는 지휘관을 지키고, 즐겁게 하는 게 성스러운 책무야… 응! 아직은 지휘관한테 폐를 많이 끼치고 있지만, 앞으로 많이… 많~~이 노력할게…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/detail.ogg"},"드랍 설명":{"voiceline":"르 아르디급 구축함 - 에페","voicelink":null},"의뢰 완료":{"voiceline":"음…… 지, 지휘관. 에페도 같이 의뢰팀 마중하러 나가도 돼…? ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/expedition.ogg"},"실망":{"voiceline":"지, 지휘관… 이렇게 돼버린 건 분명… 모두 다 에페 때문일 거야…… 흑……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/feeling1.ogg"},"낯섦":{"voiceline":"음…… (이, 이 정도면 지휘관도 엿보고 있다는 건 모르겠지…… 우으… 성실하게 일하는 지휘관에게서 눈을 뗄 수가 없어…///)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/feeling2.ogg"},"호감":{"voiceline":"에페, 지휘관에게 도움이 될 방법을 공부해 왔어… 그럼, 성과를 보여달라고? 으, 응! 우선은 \"지휘관의 옷을 정리하는 방법\"부터…… 아. 으아아…… 또 너덜너덜해졌어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/feeling3.ogg"},"기쁨":{"voiceline":"음…… (으, 으아아아?! 누, 눈이 마주쳤어…! 으아… 지휘관 눈을 보니까 심장이 더 두근거려…… ///)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/feeling4.ogg"},"사랑":{"voiceline":"지, 지휘관이 왜 에페를……? 응? 에페가 눈으로 이야기하는 걸 흉내 낸 것뿐이라고…? 으아아아?! 지, 지휘관, 처음부터 눈치채고 있던 거야? 으아아앙…… 너무 부끄러워……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/feeling5.ogg"},"터치3":{"voiceline":"저, 저기…! 에페는 머리가 헝클어져도 괜찮아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 어서 와! 다, 다친 데 없어서 다행이야…… 마중 올 때는 뛰지 말고 천천히 오라고? 으아아——! 흑… 넘어졌어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/home.ogg"},"hp 경고":{"voiceline":"아직 패배를 인정하기는… 싫어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/hp_warning.ogg"},"로그인":{"voiceline":"지, 지휘관, 어서 와! 좀 걸리긴 했지만, 필요한 서류는 전부… 전부 다 갖췄어… 에헤헤……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/login.ogg"},"실패":{"voiceline":"여, 역시 무리야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 우편이 왔어……! 으아…… 중요한 우편을 빼먹은 건 아닐까, 에페… 너무 걱정이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/mail.ogg"},"임무":{"voiceline":"지휘관, 아직 완료하지 않은 임무가 있어… 여, 역시 에페가 부족해서 처리하지 못한 임무가 생긴 거야…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/mission.ogg"},"임무완료":{"voiceline":"다행이다…! 임무가 무사히 끝났어…… 에페도 도움이 좀 되었으려나… 두근두근…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/mission_complete.ogg"},"서약":{"voiceline":"저, 정말 받아도 돼? …반지를 에페 같은 애한테 주다니…… 밝지도, 매력적이지도 않고, 아무런 재주도 없는 이런 에페에게…… 그런 에페가 좋다고? 흑, 으아아앙…… 에페, 지휘관이랑 계속, 계속, 계~~속! 같이 있을 거야……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/propose.ogg"},"스킬":{"voiceline":"에페를 방해하지 마…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/skill.ogg"},"터치1":{"voiceline":"우으…… 에페가 할 수 있는 게 있으면 뭐든 말해줘…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/touch.ogg"},"터치2":{"voiceline":"지, 지휘관을 기쁘게 할 수 있다면……! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/touch2.ogg"},"입수시":{"voiceline":"후우… 하아… 영차… 파이팅… 에페는 괜찮을 거야… 하아아…! 지, 지휘관! 비시아 성좌의 호교 기사 에페야! 잘 부탁해! …어, 어때? 합격점 정도는 따낼 수 있으려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/unlock.ogg"},"강화성공":{"voiceline":"이걸로 더 도움이 될 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"후우… 에페도 모두를 승리로 이끌 수… 있을 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"에, 에페는 지휘관을 지킬 성스러운 책무가 있으니까 멀리 