[{"클뜯 id":11000030,"클뜯 함순이 id":1100003,"함순이 이름":"호무라","한글 함순이 + 스킨 이름":"호무라","영문 함순이 + 스킨 이름":"Homura","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11000030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11000030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11000030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11000030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11000030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11000030/shipyard.png","설명":"내 이름은 호무라다. 호무라 홍련대를 이끌고 있지. 예전에는 다른 녀석들처럼 어떤 학교에 소속되어 있었다만, 사정이 좀 있어서… 뭐, 그런 건 신경 쓸 거 없다.","자기소개":{"voiceline":"호무라라고 한다. 예전에는 헤비조라는 곳에 속했지만, 지금은 연을 끊은 상태다. 흔히 말하는 '탈주 닌자'라는 거지. 떠나는 새는 뒤를 어지르지 않는 법, 아직도 미야비와는 앙금이 남아있지만… 후회는 없다. 게다가 지금 리더를 맡고 있는 호무라 홍련대도 내 소중한 동료니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/profile.ogg"},"메인1":{"voiceline":"제복은 단순한 편이 좋다만… 의장은 그 힘 때문인지 아무래도 거창해지고 마는군… 어쩔 수 없는 일이다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main1.ogg"},"메인2":{"voiceline":"음? 뭐 숨기는 거라도 있나? 숨길 생각은 버리는 게 좋을걸. 강제로 털어놓게 만들기 전에 어서 털어놔 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main2.ogg"},"메인3":{"voiceline":"오늘은 고기를 먹고 싶군. 격렬한 훈련을 치른 날은 특히 더 보급이 중요하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main3.ogg"},"전투개시":{"voiceline":"홍련의 힘을 뼈저리게 깨닫게 해주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/battle.ogg"},"상세확인":{"voiceline":"응? 나에 대해 더 알고 싶다…고? 좋아, 알려주마. 수행 방법이 궁금한 건가? 아니면 검술? 뭣하면 지금 바로 직접 겨뤄보는 것도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/detail.ogg"},"드랍 설명":{"voiceline":"내 이름은 호무라다. 호무라 홍련대를 이끌고 있지. 예전에는 다른 녀석들처럼 어떤 학교에 소속되어 있었다만, 사정이 좀 있어서… 뭐, 그런 건 신경 쓸 거 없다.","voicelink":null},"의뢰 완료":{"voiceline":"임무로 나간 녀석들이 돌아왔군. 수고했다는 말 정도는 해주라고, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/expedition.ogg"},"실망":{"voiceline":"……배짱이 두둑하군. 이제 어떻게 하느냐에 따라 네 운명이 결정될걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/feeling1.ogg"},"낯섦":{"voiceline":"후훗, 대단한 녀석이군. 설마 이렇게나 겁이 없을 줄은 몰랐어. 아니, 지금 칭찬하고 있는 거다만?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/feeling2.ogg"},"호감":{"voiceline":"대체 어딜 보는 거냐?! 아, 아니 화내는 건 아니다. 네 시선이 딱히 싫은 건 아니니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/feeling3.ogg"},"기쁨":{"voiceline":"나도 아직 수행이 부족하군… 뭐? 내가 약한 소리를 하는 게 신기하다고? …아마 네 앞이라서 이러는 거겠지… (작은 목소리로) 아니, 아무것도 아니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/feeling4.ogg"},"사랑":{"voiceline":"…나는 탈주 닌자다. 즉 세상 사람들이 볼 때는 정체 모를 부적응자나 다름없겠지. 하지만 여기선 그런 건 상관없다. 너와 함께 싸울 수 있는, 그런 의미가 있는 곳이니 나로서도 무척 마음이 편안해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/feeling5.ogg"},"터치3":{"voiceline":"뭐, 뭐냐, 갑자기…! 사람들 앞이었으면 베었을 지도 몰라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/headtouch.ogg"},"모항귀환":{"voiceline":"수고했어. 어때? 무슨 사고 같은 건 없었지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/home.ogg"},"hp 경고":{"voiceline":"윽! 젠장, 승부를 가리는 건 지금부터다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/hp_warning.ogg"},"로그인":{"voiceline":"오, 지휘관! 드디어 모항으로 돌아온 모양이군. 그럼 슬슬 시작할까? 과연 날 따라올 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/login.ogg"},"실패":{"voiceline":"젠장…… 이런 곳에서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이… 흠, 나도 쌓이지 않도록 조심해야겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/mail.ogg"},"임무":{"voiceline":"아직 일이 남아있군. 쌓아두지 말고 얼른 처리해 둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/mission.ogg"},"임무완료":{"voiceline":"잠깐, 완료한 일이 있잖아. 그냥 내버려 두는 건 좋지 않다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/mission_complete.ogg"},"서약":{"voiceline":"네가 이 세상에서 이정표가 되어준 덕분에 전투에 집중할 수 있었다. 지휘관, 나는 그런 네 기대에 부응했을지 모르겠군……그렇군, 그럼 됐다. 앞으로도 같이 힘을 모아 싸우자고. 이 호무라, 전력을 다해 네 힘이 되도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/propose.ogg"},"스킬":{"voiceline":"호무라! 춤추듯 이 목숨을 바치마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/skill.ogg"},"터치1":{"voiceline":"왜 그래, 지휘관? 뭐 신경 쓰이는 거라도 있나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/touch.ogg"},"터치2":{"voiceline":"가까이 오지 마! …베이고 싶은 거냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/touch2.ogg"},"입수시":{"voiceline":"내 이름은 호무라다. 호무라 홍련대를 이끌고 있지. 예전에는 다른 녀석들처럼 어떤 학교에 소속되어 있었다만, 사정이 좀 있어서… 뭐, 그런 건 신경 쓸 거 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/unlock.ogg"},"강화성공":{"voiceline":"수행의 성과지. 의장에도 익숙해지고 있어. 조금씩… 강해지고 있다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"열심히 단련한 힘과 기량을 마음껏 감상하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/win_mvp.ogg"},"전투개시_ex":{"voiceline":"보여주마! 내 싸우는 방식을 말이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/battle_ex.ogg"},"상세확인_ex":{"voiceline":"남의 지휘 아래에서 움직이는 건 쉽지 않다는 걸 뼈저리게 느꼈다. 하지만 싫은 느낌은 아니군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"전투만이 내 전부였을… 터다. 그렇지만 너와 나누는 이 평범한 일상도 의외로 나쁘지 않다고 생각하는 내 모습이 조금 당황스럽군. 조금만 더 이 불확실한 상태를 즐기고 싶은 마음이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"아, 지휘관 잘 왔다. 컨디션은 괜찮나? 네 컨디션이 안 좋으면 나도 불안해서… 아니, 아무것도 아니다! 오늘도 잘 부탁한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"일이 아직 남은 것 같군. 내가 도와줄 테니 어서 처리하자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/mission_ex.ogg"},"임무완료_ex":{"voiceline":"일이 몇 개 완료된 모양이군. …정말 부지런하단 말이지. 뭐, 그게 네 장점이기는 하지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"쓸데없는 짓 마라. 할 거면 정면에서 당당하게 오라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"흥, 아직 부족해! 이 정도는 너무 쉽지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['아스카'] :  거유녀! 멋대로 달려들지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/couple_encourage1.ogg"},{"voiceline":"['이카루가'] :  학급위원장님께 앞을 내어줄 수는 없겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/couple_encourage2.ogg"},{"voiceline":"['유미'] :  유미, 여기에서까지 악닌인 나에게 싸움을 걸거나 하진 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/couple_encourage3.ogg"}],"메인4":{"voiceline":"시마카제, 확실이 그 옷은 움직이기 편할 것 같다만, 보기에는 좀… 아! 설마 그것이 목적… 환혹술이었던 건가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"과감한 행동도 때론 필요하지. 우선은 한 발짝 내딛는 것부터. 생각은 나중에 하고 말이다. 그런 거라면 자신 있을 텐데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main6_ex.ogg"},"메인7_ex":{"voiceline":"훈련이라면 얼마든 할 수 있지만… 휴식도 지휘관에게 걱정을 끼치지 않을 정도로는 취하도록 하마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main7_ex.ogg"},"메인8_ex":{"voiceline":"너무 자주 쓰다듬는 거 아닌가? 싫다는 건 아니지만… 부끄럽다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"'의장발경'…이라고?! 아야나미, 뭐냐 그 기술은… 너무 멋있잖아!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"유다치, 이 고기 줄 테니까 한 판만 겨루어… 응? 고기가 어디 간 거지…? 앗! 언제 유다치 입 속에?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main9_ex.ogg"},"메인10_ex":{"voiceline":"아카시, 가게 보는 중에 미안하다만, 내 무기 좀 봐주지 않겠나? 뭐? 돈? 음… 뭘 사려는 건 아니고… 응? 수리비? 내 곤란한 상황을 이용하다니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11000030/main10_ex.ogg"},"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SENRAN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":11000031,"클뜯 함순이 id":1100003,"함순이 이름":"호무라","한글 함순이 + 스킨 이름":"시노비 앵글러","영문 함순이 + 스킨 이름":"The Shinobi Angler","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/