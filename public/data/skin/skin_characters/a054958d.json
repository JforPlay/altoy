ntent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/main2.ogg"},"메인3":{"voiceline":"지휘관, 배고프신가요? 이럴 때는 바로…… 재블린의 도시락 요리 세트가 필요하죠! 재료만 있다면, 언제 어디서든 요리할 수 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/main3.ogg"},"전투개시":{"voiceline":"용자 재블린, 전력을 다하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/battle.ogg"},"상세확인":{"voiceline":"용자 일행은 반드시 마왕을 무찌를 겁니다!…… 그런데 마왕 역할을 맡은 게 누구였죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/detail.ogg"},"드랍 설명":{"voiceline":"하아…… 하아…… 드디어 손에 넣었네요! 용자의…… 아, 거, 걱정 마세요! 겉으로 보기엔 좀 이상할지 몰라도, 공격력은 확실히 상승했으니까요!","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 다들 돌아왔어요! 어서 마중 나가요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"수고하셨어요, 지휘관! 숙소로 돌아가 축하 파티를 열어요! 그 가게는 음식도 맛있다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관! 에헤헤, 재블린이 획득한 용자의…… 자, 장비 어때 보여?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/login.ogg"},"실패":{"voiceline":"저비스에게 응급 조치 방법을 배웠다면 좋았을걸……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/lose.ogg"},"우편":null,"임무":{"voiceline":"새로운 의뢰에요…… 아, 보상이 꽤 괜찮아 보이네, Z23!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/mission.ogg"},"임무완료":{"voiceline":"평소 임무에 대한 보상은 여기 있어요. 인게임 의뢰 보상은 어디있죠……？","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"정말 어쩔 수 없을 때는 이 장비를 만들어서 먹어버리면 돼요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/touch.ogg"},"터치2":{"voiceline":"이, 이건 그런 게임이 아니에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/touch2.ogg"},"입수시":{"voiceline":"하아…… 하아…… 드디어 손에 넣었네요! 용자의…… 아, 거, 걱정 마세요! 겉으로 보기엔 좀 이상할지 몰라도, 공격력은 확실히 상승했으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"우리의 승리에요! 레어 아이템이 드랍되길……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201217/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이세계 모험","상점 id":70759,"상점 카테고리 id":24,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"한정 (2025/04/02)","진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":201218,"클뜯 함순이 id":20121,"함순이 이름":"재블린","한글 함순이 + 스킨 이름":"행복한 유월의 신부","영문 함순이 + 스킨 이름":"Blissful Purity","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201218/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201218/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201218/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201218/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201218/shipyard.png","설명":"오늘의 재블린은, 세상에서 제일 행복해요! 에헤헤~ ","자기소개":null,"메인1":{"voiceline":"지휘관이 계~속 재블린을 보고 있다는 걸 눈치채고 있지만, 그래도 상대 안 해주면 역시 흥칫뿡 할 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/main1.ogg"},"메인2":{"voiceline":"지휘관! 제가 도와줄 수 있는 건 없나요? 정말로요? 진짜 없어요? 뭐든지 괜찮은데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/main2.ogg"},"메인3":{"voiceline":"지금 지휘관에 대해서만 계속 생각하다 벽에 부딪쳤잖아요~! 지휘관 탓이에요! 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/main3.ogg"},"전투개시":{"voiceline":"사랑의 힘을 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/battle.ogg"},"상세확인":{"voiceline":"그러고 보니 지휘관, 그 때는 재블린, 줄곧 '크헤헤' 하고 웃지 않았었네요……그치만 별수 없었다구요! 그 땐 너무 행복해서 웃어버릴 것만 같았는걸요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/detail.ogg"},"드랍 설명":{"voiceline":"오늘의 재블린은, 세상에서 제일 행복해요! 에헤헤~","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 같이 돌아온 모두를 마중하러 가자고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"중요한 날에 드레스를 입고, 좋아하는 사람이 반지를 끼워주다니……재블린에게는 이게 가장 행복한 일이에요! 지휘관~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격하고 돌아온 지휘관은 귀여운 재블린이 힘나게 해줄게요~! 헤헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/home.ogg"},"hp 경고":null,"로그인":null,"실패":null,"우편":{"voiceline":"지휘관, 우편은 책상위에 놔뒀어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/mail.ogg"},"임무":{"voiceline":"지휘관과 함께 임무를 완수해야겠네요! 엣헴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/mission.ogg"},"임무완료":{"voiceline":"지휘관, 임무보수를 잘 받아주세요! 나, 나중에도 확인할 테니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201218/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"영차! …에헤헤, 역시 지휘관의 품