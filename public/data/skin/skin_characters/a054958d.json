[{"클뜯 id":201210,"클뜯 함순이 id":20121,"함순이 이름":"재블린","한글 함순이 + 스킨 이름":"재블린","영문 함순이 + 스킨 이름":"Javelin","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201210/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201210/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201210/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201210/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201210/shipyard.png","설명":"J급 구축함·재블린 (F61)","자기소개":{"voiceline":"지휘관, 안녕하세요! J클래스 구축함, 재블린입니다! 모두와 덩케르크 전투에 참여했었죠! 도중에 약간 트러블이 있었지만, 마지막까지 싸웠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/profile.ogg"},"메인1":{"voiceline":"오늘 하루도 힘내자구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/main1.ogg"},"메인2":{"voiceline":"후우… 역시 존재감이 희미해지는 건 싫네요…이럼 안 되지! 재블린, 더욱 힘낼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/main2.ogg"},"메인3":{"voiceline":"재블린은 운이 매우 좋다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/main3.ogg"},"전투개시":{"voiceline":"좋은 심심풀이가 되겠네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/battle.ogg"},"상세확인":{"voiceline":"지휘관이 이렇게나 재블린을 신경 써준다니, 기뻐요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/detail.ogg"},"드랍 설명":{"voiceline":"J급 구축함·재블린 (F61)","voicelink":null},"의뢰 완료":{"voiceline":"조금 지쳤습니까? 마침 의뢰가 완료되었던 참이에요. 항구로 나가 자매들을 맞이하러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/expedition.ogg"},"실망":{"voiceline":"지휘관, 좀 더 자중하지 않으면, 재블린은 지휘관을 안 좋아하게 될 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/feeling1.ogg"},"낯섦":{"voiceline":"……제가 귀여운가요? …에에에~~! 거짓말이죠? 지휘관, 또 재블린을 놀리고 있어~ >__<","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/feeling2.ogg"},"호감":{"voiceline":"지휘관과의 거리가 점점 가까워지네요. 후후후, 그렇지만 좀 더 노력해야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/feeling3.ogg"},"기쁨":{"voiceline":"지휘관. 저 있죠, 만화처럼 전설의 나무 아래에서 고백받고 싶달까~……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/feeling4.ogg"},"사랑":{"voiceline":"에헤헤, 지휘관과 단 둘이네, 무척 기뻐요! 아, 재블린이 도시락 만들었는데, 드실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/feeling5.ogg"},"터치3":{"voiceline":"지휘관, 재블린은 기운이 넘친답니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관 수고하셨습니다. 등 안마해드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/home.ogg"},"hp 경고":{"voiceline":"지휘관을 위해서 모두 힘내!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 어서… 오세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/login.ogg"},"실패":{"voiceline":"으으으… 방심했습니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/lose.ogg"},"우편":{"voiceline":"저기저기, 새로운 편지예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/mail.ogg"},"임무":{"voiceline":"지휘관 지휘관, 새로운 임무가 통지되었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/mission.ogg"},"임무완료":{"voiceline":"지휘관 지휘관, 보너스에 뭐가 있는지 빨리 봐요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/mission_complete.ogg"},"서약":{"voiceline":"지휘관 무슨 일인가요? 표정을 굳게…… 에? ……잠깐만, 재블린은 마음의 준비가 아직… 어떡하지 어떡하지. 머리카락이 조금 부스스하고 외모도 평범하고…… 지휘관, 잠깐만 기다려주세요! 꼭 기다려야 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/propose.ogg"},"스킬":{"voiceline":"재블린의 활약, 지켜봐주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/skill.ogg"},"터치1":{"voiceline":"지휘관, 피곤하신가요? 그럼…수다라도 떨자고요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/touch.ogg"},"터치2":{"voiceline":"꺄아~! 지휘관, 야한 건 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/touch2.ogg"},"입수시":{"voiceline":"재블린입니다! 지휘관, 잘 부탁드려요. 응? 관심 있는 여자애 앞에서 어떻게 하면 좋을지 모르겠다는 표정하고 있어~ 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/unlock.ogg"},"강화성공":{"voiceline":"에헤헤, 지휘관이 신경 써주니까, 왠지 따뜻해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/upgrade.ogg"},"vote":null,"승리":{"voiceline":"저 굉장한가요? 꺄악~ 그럴리가~ 그래도, 좀 더 좋은 칭찬법으로 칭찬해주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['주노'] : J클래스의 실력을 보여줄게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/couple_encourage1.ogg"},{"voiceline":"['라피'] : 지휘관을 위해서 함께 힘내죠!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/couple_encourage2.ogg"}],"메인4":{"voiceline":"지휘관 지휘관. 재블린과 놀아줘~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201210/main4.ogg"},"메