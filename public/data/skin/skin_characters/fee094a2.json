[{"클뜯 id":202080,"클뜯 함순이 id":20208,"함순이 이름":"셰필드","한글 함순이 + 스킨 이름":"셰필드","영문 함순이 + 스킨 이름":"Sheffield","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202080/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202080/shipyard.png","설명":"사우스햄튼급 경순양함 – 셰필드, 현호C24 ","자기소개":{"voiceline":"타운급 경순양함, 셰필드입니다. 메탈 블러드 함대와 싸웠었습니다. 샤른호르스트의 침몰을 목격하고, 비스마르크와 티르피츠와의 전투에도 참가하였습니다. 대전 말기에는 수리 중이라 출격할 수 없었습니다……이걸로 됐습니까? 그럼, 청소를 하러 돌아가도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/profile.ogg"},"메인1":{"voiceline":"주인님, 정말 좋아. 이래 보여도 감정을 3할 정도 담았습니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/main1.ogg"},"메인2":{"voiceline":"잠깐 눈을 붙이실 거라면 주인님, 기상 시간을 알려주십시오. 이 총으로 깨워드릴 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/main2.ogg"},"메인3":{"voiceline":"벨파스트는 주인님의 응석을 너무 받아줍니다. 그대로라면, 주인님은 분명 못쓸 인간이 될 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/main3.ogg"},"전투개시":{"voiceline":" '청소' 하지 않으면 안 되는 '쓰레기'가 많은 것 같군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/battle.ogg"},"상세확인":{"voiceline":"응? '청소'는 총포로 하는 것이, 메이드의 상식입니다. 주인님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/detail.ogg"},"드랍 설명":{"voiceline":"사우스햄튼급 경순양함 — — 셰필드, 현호C24 ","voicelink":null},"의뢰 완료":{"voiceline":"…지금 총성으로 의뢰에 관한 기억이 돌아왔습니까? 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/expedition.ogg"},"실망":{"voiceline":"주인님은 해충과 생김새가 비슷하시네요. 세상엔 참 불가사의한 일이 많습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/feeling1.ogg"},"낯섦":{"voiceline":"그렇군요 주인님께선 이제야 자신이 '안 타는 쓰레기' 라는 걸 알게 되시어, 제게 폐기처분을 부탁드린 거군요…그럴 리가, 지금 건 농담입니다. 차를 내려 드릴 테니, 잠시만 기다려주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/feeling2.ogg"},"호감":{"voiceline":"주인님께서 조용히 애독하시는 책을 편히 읽으실 수 있도록 다시 진열을 했습니다. 방으로 돌아가시면 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/feeling3.ogg"},"기쁨":{"voiceline":"벨파스트를 보고 배우라는, 말씀이십니까? 메이드란 대가를 바라지 않고, 성심성의껏 봉사하는 것이라 인식하고 있습니다만, 그녀는 메이드로서는 욕심이 너무 많습니다…아주 조금은, 부럽다고 생각하기도 합니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/feeling4.ogg"},"사랑":{"voiceline":"주인님, 셰필드의 평소의 언동으로 인해 곤혹스러우신가요? 송구스럽습니다만, 그건 저의 애정표현이라 이해해 주시기 바랍니다. 저는 주인님을 사모하고 있습니다. 네, 정말로요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고하셨습니다, 주인님. 다음 순서는 여기 있는 서류가 되겠습니다. 힘내주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/home.ogg"},"hp 경고":{"voiceline":"해충…조금 까다롭군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/hp_warning.ogg"},"로그인":{"voiceline":"주인님, 발밑을 조심…거기……방금 다 닦아둔 참이라서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/login.ogg"},"실패":{"voiceline":"주인님, 뒤는 제가 맡겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/lose.ogg"},"우편":{"voiceline":"주인님, 편지 구분을 완료했습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/mail.ogg"},"임무":{"voiceline":" '청소' 임무라면 맡겨주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/mission.ogg"},"임무완료":{"voiceline":"임무 보수를 전부 제게 선물해줄 셈이십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/mission_complete.ogg"},"서약":{"voiceline":"성모의 이름에 맹세하건데, 주인님께 상처입히는 자에겐 제가 사랑의 철퇴를……주인님? 아뇨, 아무것도 아닙니다. 방금 건 잘못 들으신 겁니다. 빨리 이 부끄러운 의식을 끝내도록 하지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/propose.ogg"},"스킬":{"voiceline":"들으셨습니까? 이 조종의 소리를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/skill.ogg"},"터치1":{"voiceline":"해ㅊ…주인님, 무슨 일이십니까? 죄송합니다, 방금 전엔 혀를 깨물었습니다. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/touch.ogg"},"터치2":{"voiceline":"전장에서도 이런 기개가 있다면 좋겠습니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/touch2.ogg"},"입수시":{"voiceline":"앗…해충으로 인식해서 저도 모르게 그만 쏴버렸습니다만……당신이 주인님입니까…? 실례했습니다…로열 네이비 메이드대, 경순양함 셰필드. 분부대로 따르겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/unlock.ogg"},"강화성공":{"voiceline":"후우……좋은 감촉이군요. 주인님, 감사드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 전투 결과에 만족하십니까, 주인님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['벨파스트'] : 솜씨는 무뎌지지 않았죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202080/couple_encourage1.ogg"},{"voiceline":"['아크 로열'] : 소드피쉬는 제대로 들고 있어주십시오.","voicelink"