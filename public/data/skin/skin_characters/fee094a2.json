망상일 뿐이지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202081/detail.ogg"},"드랍 설명":{"voiceline":"…에이전트의 신분을 들켜버렸나요. 어쩔 수 없군요. 주인님은 여기서 죽어주셔야겠습니다…ㅡㅡ당연히 농담이에요. 그저 취미일 뿐이랍니다.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"주인님, 오늘 밤은 또 어떤 새로운 임무가 저희를 기다리고 있습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202081/login.ogg"},"실패":null,"우편":{"voiceline":"주인님, 이 중요한 우편을 어떤 물건과 교환하실거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202081/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"주인님. 일부러 찾아오실 필요는 없습니다. 잠시 뒤에 주인님을 다시 안전하게 모셔드려야 하니까요. 귀찮은 일이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202081/touch.ogg"},"터치2":{"voiceline":"주인님의 용기에 경의를. 그 의미로 이 특제 탄환 한 발, 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202081/touch2.ogg"},"입수시":{"voiceline":"…에이전트의 신분을 들켜버렸나요. 어쩔 수 없군요. 주인님은 여기서 죽어주셔야겠습니다…ㅡㅡ당연히 농담이에요. 그저 취미일 뿐이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202081/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"기타","상점 id":70142,"상점 카테고리 id":9999,"스킨 태그":"X","입수 영상":"X","재화":700,"기간":"상시","진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":202082,"클뜯 함순이 id":20208,"함순이 이름":"셰필드","한글 함순이 + 스킨 이름":"잠깐의 휴식","영문 함순이 + 스킨 이름":"A Moment's Respite","스킨 타입":"Summer Fest","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202082/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202082/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202082/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202082/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202082/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202082/shipyard.png","설명":"이것이 사쿠라 엠파이어의 축제… 굉장히 떠들썩하군요. 사람이 이렇게 많으니 끝난 뒤 뒷정리도 큰일이겠습니다. …이렇게 말은 했지만 저도 축제를 즐기고 있습니다. 무슨 문제라도? ","자기소개":null,"메인1":{"voiceline":"이게 바로 솜사탕인가요. …(한입) 달다, 와…… 지금 뭘 기대하시는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/main1.ogg"},"메인2":{"voiceline":"주인님은 이런 축제를 어떻게 생각하십니까? 원하신다면 다음 번에는 유럽식 다른 축제를 열어도 좋을 것 같습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/main2.ogg"},"메인3":{"voiceline":"사우스햄튼, 왜 근무시간에 축제에 왔지요? …하아… 정말 어쩔 수 없군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/main3.ogg"},"전투개시":{"voiceline":"어디서든 해충은 박멸해야 합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/battle.ogg"},"상세확인":{"voiceline":"스위프트슈어, 확실히 축제 때는 방에 있는 것 보다는 모두와 함께 나와 놀아야 합니다. …모두와 함께 노는 것은 분명히 재미있을 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/detail.ogg"},"드랍 설명":{"voiceline":"이것이 사쿠라 엠파이어의 축제… 굉장히 떠들썩하군요. 사람이 이렇게 많으니 끝난 뒤 뒷정리도 큰일이겠습니다. …이렇게 말은 했지만 저도 축제를 즐기고 있습니다. 무슨 문제라도? ","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"무슨 용건이라도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/headtouch.ogg"},"모항귀환":{"voiceline":"불꽃이 꽤 괜찮네요. 평소에는 폐하를 위해 준비한 로열의 불꽃과 같은 것들도 봤습니다만, 이것도 썩 나쁘지 않네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"주인님, 여기 계셨군요. 두고 가신 줄 알고 다른 메이드들과 연락을 하려고 했습니다. 대체 뭘 하러 가셨던건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이 옷은 시원한 편이군요. 메이드단 모두가 빅토리어스씨에게 감사해야 할 것 같습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/touch.ogg"},"터치2":{"voiceline":"총은 몸에 잘 들고 있어야 합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/touch2.ogg"},"입수시":{"voiceline":"이것이 사쿠라 엠파이어의 축제… 굉장히 떠들썩하군요. 사람이 이렇게 많으니 끝난 뒤 뒷정리도 큰일이겠습니다. …이렇게 말은 했지만 저도 축제를 즐기고 있습니다. 무슨 문제라도? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202082/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"여름 축제","상점 id":70222,"상점 카테고리 id":10,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"한정 (2025/04/02)","진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":202083,"클뜯 함순이 id":20208,"함순이 이름":"셰필드","한글 함순이 + 스킨 이름":"레이븐의 저녁 만찬","영문 함순이 + 스킨 이름":"Black Crow's Finery","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202083/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando