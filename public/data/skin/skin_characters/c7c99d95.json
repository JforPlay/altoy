[{"클뜯 id":308040,"클뜯 함순이 id":30804,"함순이 이름":"이25","한글 함순이 + 스킨 이름":"이25","영문 함순이 + 스킨 이름":"I-25","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/308040/shipyard.png","설명":"순잠 을형 잠수함 이25 ","자기소개":{"voiceline":"저는 순잠 을형 잠수정 이25입니다. 일생동안 여러차레 순찰과 통상 파괴, 운송 임무를 완수했으며, 상당히 대담한 작전도 몇 차례 실시했답니다. 어떤 임무라도 맡겨주세요. 지휘관님~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/profile.ogg"},"메인1":{"voiceline":"식사 할 때마다 동급 자매들이랑 함께 \"잘 먹겠습니다\"라고 할 때 편안한 느낌이 들어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/main1.ogg"},"메인2":{"voiceline":"동생이 폐를 끼쳤군요. 너무 활발하지 않나요?...음...저는 저렇게 힘이 넘치는 아이를 상대하기가 너무 힘들어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/main2.ogg"},"메인3":{"voiceline":"지휘관님...지휘관님...?정신이 드세요?...죄송해요, 좀 걱정이 되어서요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/main3.ogg"},"전투개시":{"voiceline":"가끔은 좀 눈에 띄어야...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 바쁘신데 번거롭게 해드려 정말 죄송합니다만...정찰기 성능 테스트 좀 도와주시겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/detail.ogg"},"드랍 설명":{"voiceline":"순잠 을형 잠수함 이25","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 전원 무사하게 복귀했습니다~음...위로의 뜻으로 수제 초콜릿을 가져다 주는게 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/expedition.ogg"},"실망":{"voiceline":"지휘관님, 죄송하지만 이 말씀은 드려야 할 것 같아서요...지휘관님의 산만함이 다른 사람들에게 피해가 가서요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 자주 방문해 주셔서 감사합니다. 오늘은 열심히 일을 할 수 있겠네요. 헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/feeling2.ogg"},"호감":{"voiceline":"...오늘은 지휘관님이 안오시려나...외로워 죽겠네...지, 지휘관님?! 방금 이야기 들으셨어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 가, 갑자기 찾아와 죄송합니다...그냥 갑자기 좀 외로워져서요...좀 건방진가요?헤헤...그 때 대전에서 제가 이렇게 적진으로 파고 들었잖아요? 좀 들어보실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/feeling4.ogg"},"사랑":{"voiceline":"아우...지휘관님...오, 오늘도 같이 있어도 되나요? 지휘관님과 함께 있으면 전 절대 외롭지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님이 웃고 계신 걸 보니 이기셨나보군요. 하하~어깨 좀 주물러 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/home.ogg"},"hp 경고":{"voiceline":"일이 좀 어렵게 됐어요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/hp_warning.ogg"},"로그인":{"voiceline":"우음...지휘관님, 돌아오신 것을 환영합니다. 자리를 비우신 동안 발생한 사항을 정리해 두었으니 검토 부탁드립니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/login.ogg"},"실패":{"voiceline":"다들 괜찮아요...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/lose.ogg"},"우편":{"voiceline":"지휘관님, 계속해서 새로운 우편이 오고 있으니 어서 읽어보세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/mail.ogg"},"임무":{"voiceline":"아직 마치치 못한 임무들이 있어요~ 지휘관님, 함께 해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/mission.ogg"},"임무완료":{"voiceline":"이건 다 여러분의 노력의 결실이니 가슴을 당당히 펴고 받아야죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/mission_complete.ogg"},"서약":{"voiceline":"이게 바로 지휘관님과의 맹세의 증거...감사합니다! 저 너무 행복해요!...그리고...사실은 이렇게 하루 종일 지휘관님과 함께 있을 수 있는것도 정말 기뻐요...헤헤","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/propose.ogg"},"스킬":{"voiceline":"지금이 바로 공격 할 때입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/skill.ogg"},"터치1":{"voiceline":"하아...지휘관님 분부대로 보급을 완료했습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/touch.ogg"},"터치2":{"voiceline":"어...지휘관님 이, 이 느낌이 좋으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/touch2.ogg"},"입수시":{"voiceline":"후...드디어 사람을 만났네요. 지휘관님, 처음 뵙겠습니다. 저는 이25라고 합니다. 앞으로 제가 지휘관님께 도움이 될 수 있었으면 좋겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/unlock.ogg"},"강화성공":{"voiceline":"절 이렇게 듬직하게 만들어 주셔서 정말 감사해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"헤헤, 앞으로도 임무 많이 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['이26'] : 이탈하시면 안된답니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308040/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"