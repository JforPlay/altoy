[{"클뜯 id":101500,"클뜯 함순이 id":10150,"함순이 이름":"허먼Ⅱ","한글 함순이 + 스킨 이름":"허먼Ⅱ","영문 함순이 + 스킨 이름":"Hammann II","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101500/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101500/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101500/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101500/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101500/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101500/shipyard.png","설명":"에드솔급 호위구축함—허먼II, 현호 DE-131","자기소개":{"voiceline":"흥, 허먼은 여전히 허먼이야. 요크타운 언니 일도 알려줬으니, 굳이 네가 말해줄 필요는 없어. 그, 그래도 진짜 허먼에게 해주고 싶은 게 있다면…… 아무 것도 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/profile.ogg"},"메인1":{"voiceline":"…바보 지휘관, 진짜로 계속 이대로 끝날 때까지 일만 할 생각이야? ……아, 아무 것도 아니야! 네 할 일이나 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/main1.ogg"},"메인2":{"voiceline":"새로운 장비에 대한 적응…. 흥, 당연히 괜찮지! 이 정도로 허먼 걱정할 필욘 없다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/main2.ogg"},"메인3":{"voiceline":"후후후, 이걸로 168에게 이런저런 일을…… 자, 잠깐! 요크타운 언니! 허먼은 168이랑 친해지고 싶은 것뿐이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/main3.ogg"},"전투개시":{"voiceline":"흥! 새로운 힘을 손에 넣은 허먼을 보라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/battle.ogg"},"상세확인":{"voiceline":"아, 아까부터 왜 계속 허먼을 보는 건데?! 설마 지휘관, 진짜로 변태…… 장비를 검사하고 있는 것 뿐이라구? 모, 못 믿겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/detail.ogg"},"드랍 설명":{"voiceline":"에드솔급 호위구축함—허먼II, 현호 DE-131","voicelink":null},"의뢰 완료":{"voiceline":"의뢰에서 돌아 온 동료들 마중 나갔다 와! ……빨리 돌아와야 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/expedition.ogg"},"실망":{"voiceline":"흥! 허먼은 이제 너 같은 건 몰라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/feeling1.ogg"},"낯섦":{"voiceline":"흥! 요크타운 언니가 널 믿는다고 해도, 허먼까지 쉽게 넘어갈 거라곤 생각하지 말라구! ……앞으로도 모자란 부분이 있으면 고치겠다고? 윽…… 어, 어쨌든! 지켜보고 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/feeling2.ogg"},"호감":{"voiceline":"왜 갑자기 뚫어져라 쳐다보냐고? ……좀 보면 어때서?! 지금 허먼이 무슨 스토커라도 된다는 거야?! 허먼이 제대로 감시하지 않으면 이상한 짓을 저지를까봐 걱정이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/feeling3.ogg"},"기쁨":{"voiceline":"흐, 흥! 잘하고 있는 것 같으니, 허먼이 어쩔 수 없이 칭찬해줘야겠네! ……그, 그렇다고 허먼이 완전히 널 인정했다고는 생각하지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/feeling4.ogg"},"사랑":{"voiceline":"흥! 바보 지휘관은 허먼이 감시 안 하면, 바로 다른 애들한테 눈을 돌리지……. 꺅?! 가, 갑자기 왜 그래?! 뭘 그렇게 가까이서 보는 거야! 하, 하고 싶은 말이 뭔진 알겠어! …정말 ……전혀 그런 분위기 아니었잖아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/feeling5.ogg"},"터치3":{"voiceline":"왜 모항에는 머리를 쓰다듬어주는 걸로 기뻐하는 애들이 있는 건지 아직도 이해가 안 가……. 딱히 쓰다듬어달라고 한 말 아니거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/headtouch.ogg"},"모항귀환":{"voiceline":"왜 아직 지휘관이 안 돌아온 거지……. 꺅?! 가, 갑자기 아무 소리도 없이 들어오지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/home.ogg"},"hp 경고":{"voiceline":"싫어! 이런 건…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/hp_warning.ogg"},"로그인":{"voiceline":"흥! 딱히 네가 돌아오든 말든, 허먼이 알 바 아니거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/login.ogg"},"실패":{"voiceline":"으윽…… 이거, 지휘관한테 혼나겠는걸……. 따, 딱히 아무 말도 안 했거든?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/lose.ogg"},"우편":{"voiceline":"지휘관! 우편은 허먼이 가져다 줬다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/mail.ogg"},"임무":{"voiceline":"바보 지휘관! 아직 안 끝낸 임무 있는 거 까먹었어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/mission.ogg"},"임무완료":{"voiceline":"잠깐! 아직 수령 안 한 게 있다구! ……임무 보상 말이야! 이 바보!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/mission_complete.ogg"},"서약":{"voiceline":"아, 아무 말 없이 꼭 안아주기만 하면 돼. 그리고 얼굴 보지 마! 웃지도 마! 겨우 허먼이 용기를 내서 좋아하는 사람 품에 안겨, 솔직해지겠다고 마음먹은 거라구….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/propose.ogg"},"스킬":{"voiceline":"허먼을 얕보지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/skill.ogg"},"터치1":{"voiceline":"꺅?! 갑자기 허먼을 만지지 마! 깜짝 놀랐잖아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/touch.ogg"},"터치2":{"voiceline":"변태! 색마! 방금 거 요크타운 언니한테…… 요, 요크타운 언니한테 굳이 이르지 않아도, 허먼한테는 아직 방법이 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/touch2.ogg"},"입수시":{"voiceline":"어, 어딜 보는 거야, 이 변태!! 뭐? 불가항력? 그런 말을 허먼이 믿을 것 같아?! 제대로 자기소개 하려고 했는데…… 나중에 두고 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/unlock.ogg"},"강화성공":{"voiceline":"윽, 안 된다고 할리 없잖아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다! ……뭐, 뭐야! 딱히 네가 칭찬해줘도 안 기쁘거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101500/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"어, 어차피 허먼은 늘 까칠하게만 구니까, 싫으면 싫다고…… 꺅! 알았어! 알았다니까! 지휘관이 마음을 바꿀만한 사람이 아니란 건 알았어! 정말…///","vo