[{"클뜯 id":102310,"클뜯 함순이 id":10231,"함순이 이름":"휴스턴Ⅱ","한글 함순이 + 스킨 이름":"휴스턴Ⅱ","영문 함순이 + 스킨 이름":"Houston II","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102310/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102310/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102310/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102310/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102310/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102310/shipyard.png","설명":"클리블랜드급 경순양함 - 휴스턴Ⅱ CL-81","자기소개":{"voiceline":"…왠지 분위기가 차분해진 것 같다구요? 에헤헤, 칭찬해주셔서 감사합니다! 지휘관님, 그건 아마 여유가 있어서 '차분'해진 걸 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/profile.ogg"},"메인1":{"voiceline":"야호…? 왠지 그리운 느낌… 이걸 말하는 게 대체 얼마 만인지… 지휘관님이 듣고 싶으시다면…… 야, 야호~☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/main1.ogg"},"메인2":{"voiceline":"지휘관님은 어떤 휴스턴이 좋으세요? 씩씩하고 발랄한 휴스턴? 아니면 쿨하고 차분한 휴스턴? ……둘 다요? 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/main2.ogg"},"메인3":{"voiceline":"뭐든 단번에 좋아질 순 없고 날마다 노력을 게을리하지 않는 게 관건…… 휴스턴의 노력하는 모습을 앞으로도 지켜봐 주세요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/main3.ogg"},"전투개시":{"voiceline":"휴스턴의 컨디션은 양호… 그럼 오늘도 슬슬 움직여 볼까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/battle.ogg"},"상세확인":{"voiceline":"지식은 곧 힘'이라는 말이 있죠. 오늘 휴스턴은 '힘'이 넘쳐흐른답니다. 지휘관님의 기대에 부응할 수 있을 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/detail.ogg"},"드랍 설명":{"voiceline":"클리블랜드급 경순양함 - 휴스턴Ⅱ CL-81","voicelink":null},"의뢰 완료":{"voiceline":"비행기랑 로켓은 모두 내 동료~ 지, 지휘관님?! 방금 거 들으셨어요? 으, 음…! 의뢰가 완료됐으니 어서 마중하러 나가주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/expedition.ogg"},"실망":{"voiceline":"휴스턴의 기억이 잘못된 걸까? 지휘관님은 분명 더…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/feeling1.ogg"},"낯섦":{"voiceline":"오랜만에 지휘관님이랑 놀았네~ 예전보다 더 재밌었을지도! …에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/feeling2.ogg"},"호감":{"voiceline":"(작은 목소리로) 그, 그럼 안 돼, 휴스턴. 지휘관님을 자꾸 귀찮게 하면… 응? 아, 아무것도 아니에요! 지휘관님, 같이 산책이라도 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/feeling3.ogg"},"기쁨":{"voiceline":"휴스턴의 고민은 바로! …지, 지휘관님. 심장 소리 들리세요…? 지휘관님 때문에 여기가 자꾸 두근두근, 쿵쿵거려요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 휴스턴이 예전에 한 말 기억하세요? 음… 기억 못 하셔도 괜찮아요. 어쨌든 한 번 더 지휘관님께 고백할 거니까요. 휴우… 좋아! 지, 진지하게 들어주셔야 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/feeling5.ogg"},"터치3":{"voiceline":"기분 좋아… 지휘관님, 조금만 더 쓰다듬어 주세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/headtouch.ogg"},"모항귀환":{"voiceline":"후훗~ 휴스턴이 또 전투 임무를 완벽하게 수행했네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/home.ogg"},"hp 경고":{"voiceline":"무사히 모항으로 돌아갈 수 있도록…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/hp_warning.ogg"},"로그인":{"voiceline":"어서 오세요. 그럼 오늘 업무를 같이 처리하죠… 끝나면 어딘가 놀러 가고 싶다구요? 아직 시작도 안 했는데… 지휘관님도 참!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/login.ogg"},"실패":{"voiceline":"졌어요… 나중에 확실히 회고를 해야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/lose.ogg"},"우편":{"voiceline":"지휘관님, 우편이 도착했어요. 아, 여기로 가지고 올까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/mail.ogg"},"임무":{"voiceline":"지휘관님, 아직 끝나지 않은 임무가 있어요. 같이 처리해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/mission.ogg"},"임무완료":{"voiceline":"혹시 모르니 누락된 보상은 없는지 확인해 볼게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/mission_complete.ogg"},"서약":{"voiceline":"이, 이상하네… 평범하게 대답하려고 했는데 진심으로 고백을 받으니까 너무 기뻐서 아무 말도 안 나와… 후~ 하~ 후~ 하~ …정말요?! 휴스턴도 지휘관님이 너무 좋아요!!☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/propose.ogg"},"스킬":{"voiceline":"3, 2, 1! 발사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/skill.ogg"},"터치1":{"voiceline":"지휘관님? 왜 그러세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/touch.ogg"},"터치2":{"voiceline":"지휘관님은 아무리 시간이 지나도… 색골이시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/touch2.ogg"},"입수시":{"voiceline":"휴스턴, 새로운 모습으로 지휘관님 곁으로 귀환했어요. …모습이 많이 변한 것 같다구요? 후후… 이게 바로 성장이라는… 걸까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/unlock.ogg"},"강화성공":{"voiceline":"오늘 휴스턴 상태라면 제2우주속도도 여유롭게 돌파할 수 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/upgrade.ogg"},"vote":null,"승리":{"voiceline":"칭찬해 주셔서 고마워요! 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관님, 휴스턴… 잘하고 있나요? 에헤헤, 지금 휴스턴은 지휘관님이 무슨 생각을 하시는지 다 알 수 있다구요☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"잘 생각해 보면 처음 만났을 때부터 지휘관님이 좋았어요. 그땐 그저 제 마음을 깨닫지 못했던 것뿐… 그대로 놓치지 않아서 정말 다행이야… 음… 야, 야호~☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"으음… 무, 물론 기분은 좋지만… 그렇다고 쓰다듬어 주시려고 굳이 하루를 통째로 비워두실 필요까지는…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"야호~☆ 가장 씩씩한 인사를 지휘관님께~ …왠지 그리운 느낌이 든다구요? 에헤헤, 그야 지휘관님이 이런 휴스턴도 좋다고 하셨잖아요?☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"앞으로는 '색골 지휘관님'이라고 불러드려야 하나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['노샘프턴Ⅱ'] :  그쪽도 많이 변했네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관님, 추우세요? 그럼 이 코트라도… 으아아, 그냥 덮고 계시라는 거지, 누가 그렇게 킁킁 냄새 맡으래요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/main5_ex.ogg"},"메인6_ex":{"voiceline":"앗, 지휘관님. 이건… 휴스턴과 보내는 일상을 기록하고 계셨군요. 에헤헤, 다음에 둘이서 추억을 되새기면서… 분명 즐거울 거예요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님이랑 같이 놀 수 있다! 야호☆ …지, 지금 웃으셨죠! 정말… 웃지 않기로 약속했는데…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102310/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":102311,"클뜯 함순이 id":10231,"함순이 이름":"휴스턴Ⅱ","한글 함순이 + 스킨 이름":"레디 투 서비스!","영문 함순이 + 스킨 이름":"Ready to Serve!","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102311/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102311/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102311/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102311/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102311/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102311/shipyard.png","설명":"오래 기다리셨습니다! 휴스턴, 레디 투 서비스! …음, 이런 의상을 입는 건 처음이라 왠지 좀 부끄럽네요… 사이즈도 조금 작은 것 같고…","자기소개":null,"메인1":{"voiceline":"지휘관님은 딸기 케이크의 딸기를 마지막에 드시는 타입이구나…… 저, 저를 위해 남겨 두셨다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102311/main1.ogg"},"메인2":{"voiceline":"으아아… 실수로 케이크를 떨어뜨렸어… 아직 먹지도 않았는데… 그, 그렇다고 주워서 먹지는 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102311/main2.ogg"},"메인3":{"voiceline":"가게 사람들한테 접객 인사를 '야호☆'로 바꾸도록 추천하라구요? …노, 농담이죠? 그런 거… 너무 부끄럽잖아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102311/main3.ogg"},"전투개시":{"voiceline":"서비스 정신'을 보여드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102311/battle.ogg"},"상세확인":null,"드랍 설명":{"voiceline":"오래 기다리셨습니다! 휴스턴, 레디 투 서비스! …음, 이런 의상을 입는 건 처음이라 왠지 좀 부끄럽네요… 사이즈도 조금 작은 것 같고…","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"요 며칠간 메이드대에서 여러 가지를 배웠어요! 특히 지휘관님을 기쁘게 하려면 어떻게 서비스를 제공해야 한다던가… 에헤헤, 나중에 연습 상대를 부탁드려도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102311/feeling5.ogg"},"터치3":{"voiceline":"으아아… 자꾸 만지시면 토끼 귀가 빠질 거예요……","voicelink":"https://raw.githubusercontent.com/Fern