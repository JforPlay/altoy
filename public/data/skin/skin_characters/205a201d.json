[{"클뜯 id":103060,"클뜯 함순이 id":10306,"함순이 이름":"포틀랜드","한글 함순이 + 스킨 이름":"포틀랜드","영문 함순이 + 스킨 이름":"Portland","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103060/shipyard.png","설명":"포틀랜드급 중순양함·포틀랜드 (CA-33)","자기소개":{"voiceline":"인디의 언니인 포틀랜드야~ 착실히 하라고? 하아… 포틀랜드 따위 인디애나폴리스급이었으면 좋았을 텐데…… 별 16개 받고 큰 작전에도 참가했지만 나에 대한 건 아무래도 상관없으니까, 여동생 이야기 하는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/profile.ogg"},"메인1":{"voiceline":"지휘관, 빨리 출발하자구요. 인디는 꾸물거리는 거 안 좋아한다구요","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/main1.ogg"},"메인2":{"voiceline":"우리 동생도 참, 정말 멋지다니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/main2.ogg"},"메인3":{"voiceline":"인디의 얇은 책 보고 싶어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/main3.ogg"},"전투개시":{"voiceline":"…인디, 아아, 아니지… 모두 날 따라와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/battle.ogg"},"상세확인":{"voiceline":"저기, 지휘관. 들어보세요! 우리 여동생 엄청 엄청 귀여워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/detail.ogg"},"드랍 설명":{"voiceline":"포틀랜드급 중순양함·포틀랜드 (CA-33)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 다음 의뢰는 저와 인디로 팀을 짜서 나가도 될까요? 귀여운 인디 사진 나중에 보여드릴 테니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/expedition.ogg"},"실망":{"voiceline":"인디한테 하아하아하는 거 방해하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/feeling1.ogg"},"낯섦":{"voiceline":"인디 귀여워어어어어어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/feeling2.ogg"},"호감":{"voiceline":"지휘관. 어렸을 적 인디 사진 볼래요? 보고 싶지 않다고 해도 보여줄 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/feeling3.ogg"},"기쁨":{"voiceline":"지휘관. 인디가 수박 먹고 있는 사진은 어딨어요? 아, 고마워요! 그리고 그 껴안는 베개 안고 있는 건요? 아, 여깄구나. 고마워요~! 모르는 사이에 저보다 인디 컬렉션을 더 잘 알게 됐네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/feeling4.ogg"},"사랑":{"voiceline":"──아이요? 글쎄…… 인디 닮은 애가, 음…… 10명, 일단 10명 원해요! ……꺄앗! 우으 정말, 지금 무슨 말 하게 하는 거예요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관. 여기 있던 인디 봤어??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"저기, 지휘관. 들어보세요! 우리 여동생 엄청 귀여워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/login.ogg"},"실패":{"voiceline":"젠장…, 동생한테 이런 모습 보여줄 수 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/lose.ogg"},"우편":{"voiceline":"편지 가져왔어요~ 뭐에요? 저도 일 제대로 할 수 있다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/mail.ogg"},"임무":{"voiceline":"미션을 제대로 하지 않으면 동생을 볼 면목이 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/mission.ogg"},"임무완료":{"voiceline":"지휘관. 보너스는 인디 간식 사는 데 써도 돼요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/mission_complete.ogg"},"서약":{"voiceline":"지휘관과 언제나 함께 인디를 감상할 수 있게 됐네요…… 하지만 역시 저한텐 인디가 제일! 그것만큼은 양보할 수 없어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/propose.ogg"},"스킬":{"voiceline":"하아아, 귀여운 인디…… 거기 방해하지 말아줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/skill.ogg"},"터치1":{"voiceline":"지휘관 지휘관, 들어보세요. 인디는 부드럽다구요! 같이 만져볼래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/touch.ogg"},"터치2":{"voiceline":"아앗! …인디에게조차 이런 곳 만져진 적 없는데!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/touch2.ogg"},"입수시":{"voiceline":"처음 뵙겠어요, 지휘관. 전 인디의 언니 포틀랜드. 산호해 해전, 미드웨이 해전, 과달카날섬 전투, 남태평양 해전 모두 참전했어요. 네? 인디가 뭐냐구요? 사랑하는 여동생, 인디애나폴리스의 별명이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/unlock.ogg"},"강화성공":{"voiceline":"이걸로 인디를 더 이렇게 저렇게 할 수 있겠네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"사랑하는 인디야~ 언니 굉장하지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":103061,"클뜯 함순이 id":10306,"함순이 이름":"포틀랜드","한글 함순이 + 스킨 이름":"학원에서 인디랑!","영문 함순이 + 스킨 이름":"At School With Indy!","스킨 타입":"School Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103061/painting.png","확대 일러":null,"sd 일러":"https://raw.githubuser