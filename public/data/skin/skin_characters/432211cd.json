[{"클뜯 id":399050,"클뜯 함순이 id":39905,"함순이 이름":"하쿠류","한글 함순이 + 스킨 이름":"하쿠류","영문 함순이 + 스킨 이름":"Hakuryuu","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399050/shipyard.png","설명":"항공모함—하쿠류","자기소개":{"voiceline":"난 사쿠라 엠파이어 항공모함 하쿠류다. 누구라도 나의 실력에 의문을 품는다면, 언제든 나에게 도전을 환영한다. \"짓밟는다\"는게 무엇인지 알려주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/profile.ogg"},"메인1":{"voiceline":"이곳에 온 후로 실력을 키울 적이 적지 않게 늘었다. 즐겁기까지 하군... 친구? 흥, 나에겐 한둘이면 충분하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/main1.ogg"},"메인2":{"voiceline":"무기는 나의 영혼이다. 손에 아무것도 없다면, 아마도…… 아니, 아무것도 아니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/main2.ogg"},"메인3":{"voiceline":"한가로울 때 주먹밥을 몇 개 만들었다. 배가 고프다면 가져가서 먹어도 좋다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/main3.ogg"},"전투개시":{"voiceline":"누가 감히 나 하쿠류를 적으로 삼을지 두고 보겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/battle.ogg"},"상세확인":{"voiceline":"방이 어지럽다고? 무슨 상관이야. 어차피 어떤 물건을 찾더라도 금방 찾을 수 있는데, 그럼 충분하잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/detail.ogg"},"드랍 설명":{"voiceline":"항공모함—하쿠류","voicelink":null},"의뢰 완료":{"voiceline":"왜 이렇게 술렁이나 했더니, 의뢰조가 돌아왔군. 맞이하러 가자고? 아, 그럼 가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/expedition.ogg"},"실망":{"voiceline":"흥, 하찮은 것 같으니, 내게서 멀리 떨어져라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/feeling1.ogg"},"낯섦":{"voiceline":"잘하면 칭찬하고, 잘못하면 비평하고, 한 가지 일은 그 한 가지 일에만 한정시키는 것이 나의 원칙이다. 내 자신의 일은 잘 할 것이니, 내 걱정은 할 필요 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/feeling2.ogg"},"호감":{"voiceline":"잘했구나, 나와 협력하며 나아갈 자격이 있군… 흥, 만일 나에게 안일을 탐하며 퇴보하는 모습을 보인다면, 난 누구보다도 빠르게 널 버릴 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/feeling3.ogg"},"기쁨":{"voiceline":"(작게) 나의 검을 보았나? 분명히 손 옆에 두었는데, 깨고 나니 없더구나…… 어, 어쨌든, 이러고 있다간 곤란하게될 수 있으니, 어서 날 도와 찾아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/feeling4.ogg"},"사랑":{"voiceline":"읏, 수치스러운 일면을 네가 알게 되었으니, 비밀이 새지 않도록 항상 너를 쳐다볼 수밖에 없겠군. 지금부터, 너의 모든 행동에 내가 함께하겠다...... 같이 놀러 가는 거라면? 물론 포함이다... 잠깐, 어딘가 잘못된 것 같은데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/feeling5.ogg"},"터치3":{"voiceline":"함부로 내 머리에 손을 대다니, 내가 베어버릴까 두렵지 않은가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/headtouch.ogg"},"모항귀환":{"voiceline":"내 검… 나의 검……후~ 역시 손에 쥐고 있어야 안심이 되는군…… 응? 여기서 뭐해? 지금 멍 때릴 시간이 아닐 텐데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/home.ogg"},"hp 경고":{"voiceline":"나 하쿠류에게 피해를 입히다니……!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/hp_warning.ogg"},"로그인":{"voiceline":"좋다, 딱 맞춰왔군. 네가 늦잠을 자거나 할 줄 알았는데 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/login.ogg"},"실패":{"voiceline":"어, 어서 철수해! …… 내 검은!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/lose.ogg"},"우편":{"voiceline":"새로운 우편…… 도전장은 아닌가? 시시하군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/mail.ogg"},"임무":{"voiceline":"임무? 사소한 일에 나의 시간을 낭비하길 싫다. 스스로 방법을 찾아 해결해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/mission.ogg"},"임무완료":{"voiceline":"괜찮군. 이런 사소한 일을 질서 정연하게 완성하다니, 칭찬받을 만해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/mission_complete.ogg"},"서약":{"voiceline":"흥, 내가 너의 말에 따르는 것을 그렇게 보고 싶어 하지 말아라…… 잠깐, 내 검! 어, 언제 가져간 것이야!? 말에 따르면 되지 않겠나!? 어서 돌려 주어라! 읏, 완패다… 하지만, 기분이 나쁘지만은 않군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/propose.ogg"},"스킬":{"voiceline":"강림하라, 천벌이여!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/skill.ogg"},"터치1":{"voiceline":"뭐지? 할 말이 있다면 해라, 우물쭈물하지 말고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/touch.ogg"},"터치2":{"voiceline":"넌 호랑이의 간을 먹었나보구나……어이, 멈추라는 말 못 들었나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관인가? 내 이름은 하쿠류. 날 통제하려는 그 어떤 노력도 헛수고일 것이다. 잘 명심해두어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/unlock.ogg"},"강화성공":{"voiceline":"이제, 다른 이들과의 격차가 더 벌어지겠구나......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"겨우 너희들 같은 것들이 이 하쿠류를 이기려 한다고? 가소롭군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"하아, 힘들군, 정리하기 싫다…… 아, 지휘관, 이왕 왔는데, 방 정리하는 것 좀 도와주지 않겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"뭐야? 의뢰조 마중? 알았다 알았어…… 끄, 끌지마라! 적어도 검은 챙기고—— 크흠, 됐다, 출발하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":{"voiceline":"뭐, 뭘 하려고!? 어이, 어, 어서 멈추어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"누구냐!? 하쿠류, 하쿠류 여기다! 부부부디 나를 잡아먹지 말아라……!? …… 너, 너였나? 무기가 없을 때 날 놀래키지 말아라……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"너였군, 오늘은 뭘…——내 검을!? 검이 없는 상황에 점점 익숙해지라고…? 싫다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"어, 어차피 널 이기지 못할테니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['준요', '아카기', '다이호'] : 대하기가 그렇게 편하진 않군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"대련은 대련이다. 단순히 싸우면 되지, 왜 굳이 사람 긴장시키는 그런 친목회를 만든 건가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"너에게 예비용 무기를 준비해 주는 건 어떻겠는가. 그러면 만일 내가 무기를 챙기지 않았을 때, 네가 도와줄 수 있으니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/main2_ex.ogg"},"메인3_ex":{"voiceline":"주먹밥을 만들어야겠다! 너도 흰쌀밥 먹지? 백룡이라서 흰쌀을 만들었다고…… 너, 너 바보냐!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399050/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"UR","ex_chat_status":1},{"클뜯 id":399051,"클뜯 함순이 id":39905,"함순이 이름":"하쿠류","한글 함순이 + 스킨 이름":"쾌도 메이드?","영문 함순이 + 스킨 이름":"Slice, Dice, and Serve","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399051/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399051/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399051/shipyard.png","설명":"손님, 주문하신 모둠회 나왔습니다! … 너무 가깝다고? 왜, 이 하쿠류가 직접 음식을 올려주는데, 뭐가 불만이야? …… 음, 그래 이거지. 얌전히 받으면 된다고~","자기소개":null,"메인1":{"voiceline":"뭐냐? 이 하쿠류 앞에서 소동을 피우는 괘씸한 무리들은……. 회가 한 접시 모자르다고? 알았다. 바로 떠주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/main1.ogg"},"메인2":{"voiceline":"뭐? 내가 부엌칼은 못 다룰 줄 알았다고? 별 우스꽝스러운 소리를 하는군! 내 화려한 칼솜씨, 똑똑히 지켜봐라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/main2.ogg"},"메인3":{"voiceline":"저기, 차라리 내 옆에서 도와주는 건 어떤가? 너라면 필시 큰 도움이 될 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"동료 덕분에 부엌은 깨끗하게 정리정돈되고 있군. 뭐, 나는 조금 어지러워도 딱히 신경 안 쓰지만 말이지. 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/detail.ogg"},"드랍 설명":{"voiceline":"손님, 주문하신 모둠회 나왔습니다! … 너무 가깝다고? 왜, 이 하쿠류가 직접 음식을 올려주는데, 뭐가 불만이야? …… 음, 그래 이거지. 얌전히 받으면 된다고~","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"끄응…… 지휘관, 마침 잘 왔다. 너도 새로운 메뉴 좀 생각해 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어, 어라……. 이 날카롭고 꺼림칙한 감촉은…… 으아?! 내, 내 검…? 고맙다……. 크흠! 지휘관, 당장 업무에 착수해라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/login.ogg"},"실패":null,"우편":{"voiceline":"새로운 우편? ……설마, 라이벌이 보낸 도전장인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/mail.ogg"},"임무":{"voiceline":"또 주문이 새로 들어온 건가? 흥, 지금 만들어 주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/mission.ogg"},"임무완료":{"voiceline":"임무를 완료했다고? 여기 주문도 지금 막 완성된 참이었다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"마음대로 내 검에 손대지 마라!! ……윽, 미안……. 조금 난폭하게 군 것 같군. 많이 놀랐는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/touch.ogg"},"터치2":{"voiceline":"이 하쿠류의 검에 삼등분이 나고 싶은 거냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/touch2.ogg"},"입수시":{"voiceline":"손님, 주문하신 모둠회 나왔습니다! … 너무 가깝다고? 왜, 이 하쿠류가 직접 음식을 올려주는데, 뭐가 불만이야? …… 음, 그래 이거지. 얌전히 받으면 된다고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399051/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70634,"상점 카테고리 id":17,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"IJN","레어도":"UR","ex_chat_status":0},{"클뜯 id":399052,"클뜯 함순이 id":39905,"함순이 이름":"하쿠류","한글 함순이 + 스킨 이름":"비단 옷과 선율","영문 함순이 + 스킨 이름":"Flash of Silk and Strings","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399052/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399052/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399052/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399052/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399052/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399052/shipyard.png","설명":"칼은… 좋아. 흥, 너로군. 매일 우리와 전장을 누비는 생활을 하는 자가 설마 이렇게 음률에도 능할 줄은 몰랐군. 그럼, 어디 우선은 이 곡으로 너를 시험해 보마!","자기소개":null,"메인1":{"voiceline":"카, 칼 걱정은 마라! 내가 연주하는 가락에만 집중하는 거다! 알겠나?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/main1.ogg"},"메인2":{"voiceline":"뭐? 시끄럽다고? 흥, 내 생각대로 풍류를 즐길 줄 모르는 야만스러운 자로군. 싸움이 잦더라도 자신을 갈고닦는 걸 잊지 마라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/main2.ogg"},"메인3":{"voiceline":"한잔 걸치고 싶은 기분이군…… 흥, 여기 안줏거리는 없는 거냐? 어쩔 수 없군. 잠깐 장 좀 보러 다녀오마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"역시 축하 연회장이라 잘 정리되어 있군. 흥, 어차피 만취꾼 녀석들이 엉망으로 만들 텐데 열심히 해봤자 무슨 소용이겠냐마는. 네 생각도 그렇지 않나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/detail.ogg"},"드랍 설명":{"voiceline":"칼은… 좋아. 흥, 너로군. 매일 우리와 전장을 누비는 생활을 하는 자가 설마 이렇게 음률에도 능할 줄은 몰랐군. 그럼, 어디 우선은 이 곡으로 너를 시험해 보마!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔다고? 여기 불러서 같이 내 연주를 듣는 건 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"카, 카, 칼 어딨어?! 지금 음악이니 뭐니 할 때가…… 흐, 흥! 이 하쿠류의 약점을 이용하려고 하다니 간이 배 밖으로 나온 녀석이군! 네 녀석 뜻대로는 안 될 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"후훗, 방금 건 어땠나? 호오, 아무 말이 없군. 이거 너무 훌륭해서 목소리도 나오지 않는 모양이지? 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"♪~ 방금 곡은 어떤 곡인지 맞혀 봐라. …즉흥 연주는 아니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/touch.ogg"},"터치2":{"voiceline":"칼은 여기 없다! …그런 의도는 아니었다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/touch2.ogg"},"입수시":{"voiceline":"칼은… 좋아. 흥, 너로군. 매일 우리와 전장을 누비는 생활을 하는 자가 설마 이렇게 음률에도 능할 줄은 몰랐군. 그럼, 어디 우선은 이 곡으로 너를 시험해 보마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399052/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70900,"상점 카테고리 id":7,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1180,"기간":"상시","진영":"IJN","레어도":"UR","ex_chat_status":0},{"클뜯 id":399053,"클뜯 함순이 id":39905,"함순이 이름":"하쿠류","한글 함순이 + 스킨 이름":"용조백련","영문 함순이 + 스킨 이름":"Folded Over a Thousand Times","스킨 타입":"Summer Fest","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399053/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399053/painting_n.png","sd 일러":"https://raw.gi