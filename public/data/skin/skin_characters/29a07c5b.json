[{"클뜯 id":107220,"클뜯 함순이 id":10722,"함순이 이름":"인디펜던스","한글 함순이 + 스킨 이름":"인디펜던스","영문 함순이 + 스킨 이름":"Independence","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107220/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107220/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107220/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107220/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107220/shipyard.png","설명":"인디펜던스급 항공모함 - 인디펜던스(CVL-22) ","자기소개":{"voiceline":"클리블랜드급의 5번함으로 건조되고 있던 나는, 항공모함의 필요성이 급증한 상황에 따라 경항공모함으로 개장되었다. 그렇게 새로운 힘을 얻은 덕분에 이후의 전투에서 활약할 수 있었고, 또 모두와 함께 승리를 거머쥐게 된 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/profile.ogg"},"메인1":{"voiceline":"클리블랜드…… 언니라고 부르면 되는 건가? 아니면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/main1.ogg"},"메인2":{"voiceline":"맡은 업무의 우선도를 최고 레벨로 설정하도록 하지, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/main2.ogg"},"메인3":{"voiceline":"속내를 살피는 건 아무래도 서툰 것 같다…… 요컨대 지휘관, 무슨 일이든 얼굴을 마주 보고 직접 알려다오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/main3.ogg"},"전투개시":{"voiceline":"집중해라, 경계를 늦추지 마라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/battle.ogg"},"상세확인":{"voiceline":"필요하다면, 야간 작전도 대응 가능하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/detail.ogg"},"드랍 설명":{"voiceline":"인디펜던스급 항공모함 - 인디펜던스(CVL-22)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 물자…… 도착해있네. 옮길 수고를 덜었군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/expedition.ogg"},"실망":{"voiceline":"단도직입적으로 묻지. 뭘 하는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/feeling1.ogg"},"낯섦":{"voiceline":"항공모함의 야간 전투가 신경 쓰이나? 알았다. 다음 야간 전투 연습 때는 알려주도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/feeling2.ogg"},"호감":{"voiceline":"경항공모함은 전투력 상으론 정규 항공모함에 미치지 못할지도 모른다만…… 내 실력을 인정해준다면, 그걸로 충분하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/feeling3.ogg"},"기쁨":{"voiceline":"내게 하고 싶은 말은 없나? 전투든, 다른 일이든, 뭐든지. …갑자기 왜 그러냐고? 아아, 지휘관의 마음속에서 난 대체 어떤 존재인지 알고 싶은 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/feeling4.ogg"},"사랑":{"voiceline":"말로는 표현할 수 없는 것도 있다'…라고? 이해할 수 없군. 말하지 않는다면, 상대가 알 수 없는 것 아닌가? 예를 들면, 내가 지휘관을 좋아한다는 걸 말로 하지 않으면, 지휘관은 그걸 어떻게 알아챌 수 있단 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"다음 작전계획이라도 준비할 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/home.ogg"},"hp 경고":{"voiceline":"승산은… 얼마나 있는 거지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘 특훈과 통상 임무도 순조롭게 수행 중이다. 안심해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/login.ogg"},"실패":{"voiceline":"철수도 작전 중의 하나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/lose.ogg"},"우편":{"voiceline":"우편은 여기 있다. 확인해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/mail.ogg"},"임무":{"voiceline":"새로운 작전 임무다. 빨리 해치우자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/mission.ogg"},"임무완료":{"voiceline":"임무를 완료하더라도 긴장을 늦춰선 안 된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/mission_complete.ogg"},"서약":{"voiceline":"운명의 갈림길에서 지휘관과 만난 덕분에, 내가 돌아갈 곳을 찾았다… …이상한 비유…인가? 그, 그러니까, 요컨대 그런 거다. 나도 좋은 말이 떠오르지 않아… …어쨌든, 앞으로 잘 부탁한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/propose.ogg"},"스킬":{"voiceline":"목표를 포착했다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/skill.ogg"},"터치1":{"voiceline":"나? 무슨 용무라도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/touch.ogg"},"터치2":{"voiceline":"해군부에 출두해서 설명을 요구해도 될까. ……지금 당장.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/touch2.ogg"},"입수시":{"voiceline":"경항공모함 인디펜던스다. …경항공모함, 이라는 함종에는 신경 쓰지 말고, 임무를 팍팍 맡겨다오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/unlock.ogg"},"강화성공":{"voiceline":"바로 실전 연습 준비라도 하지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/upgrade.ogg"},"vote":null,"승리":{"voiceline":"경항공모함의 힘을 얕보지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['클리블랜드'] : 클리블랜드……언니?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/couple_encourage1.ogg"},{"voiceline":"['엔터프라이즈', '새러토가'] : 야간전투 항공모함대, 집결!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107220/couple_encourage2.ogg"},{"voiceline":"['에식스', '매사추세츠', '사우스다코타', '워싱턴'] : 테스크 포스38, 오퍼레이셔널!","voicelink":"https://raw.githubusercontent.com/Fernando2603/Az