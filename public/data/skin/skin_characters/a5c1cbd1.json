[{"클뜯 id":108040,"클뜯 함순이 id":10804,"함순이 이름":"블루길","한글 함순이 + 스킨 이름":"블루길","영문 함순이 + 스킨 이름":"Bluegill","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108040/shipyard.png","설명":"가토급 잠수함 블루길, 현호 SS-242 ","자기소개":{"voiceline":"가토급의 일원으로 바다를 돌며 큰 활약을 했다고! 헤헤~ 이 모항에서 블루길의 이름을 다시 한번 드높이겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/profile.ogg"},"메인1":{"voiceline":"오늘같이 화창한 날은 수영하기 딱 좋은 날이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/main1.ogg"},"메인2":{"voiceline":"아, 그거 폐지 아니야! 새로운 블루길 파일이야! 전부 다 내가 쓴 거라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/main2.ogg"},"메인3":{"voiceline":"저기, 지휘관! 언제까지 책상만 보고 있을 거야? 안 쉬어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/main3.ogg"},"전투개시":{"voiceline":"블루길, 출발!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/battle.ogg"},"상세확인":{"voiceline":"하루 종일 연구실에만 틀어박혀 있는 사쿠라 엠파이어의 과학 매니아 유바리…… 끌어내서 같이 놀 방법은 없을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/detail.ogg"},"드랍 설명":{"voiceline":"가토급 잠수함 블루길, 현호 SS-242","voicelink":null},"의뢰 완료":{"voiceline":"지휘관! 의뢰한 물자가 모두 도착했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/expedition.ogg"},"실망":{"voiceline":"괜찮아. 지휘관도 햇빛을 좀 받으면 고민이 날아갈 테니까 분명 다시 기운 차릴 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 잘 들어! 사실 블루길은 민물고기야! …… 알고 있었어? 우우, 지휘관을 깜짝 놀래킬 수 있을 줄 알았는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/feeling2.ogg"},"호감":{"voiceline":"아, 지휘관 발견! 허그! …… 이러면 지휘관이 곤란해? 내, 내가 힘이 너무 셌나? 아니야? 그럼 왜 곤란해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관이 곤란했던 이유를 알았어! 분명 블루길에게 끌어 안겨지는 게 부끄러워서 그랬던 거야! 맞지? 괜찮아. 모두에게 물어봤는데 다들 신경 안 쓰던걸! …… 지휘관, 왜 이마를 짚는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/feeling4.ogg"},"사랑":{"voiceline":"내가 지휘관을 엄청 곤란하게 했었구나…… 정말 미안해! 하지만 지휘관을 끌어안고 있으면 정말정말 기쁜걸! 그러면 지휘관이 괜찮다고 할 때 다시 끌어안아 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고했어! 허그!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/home.ogg"},"hp 경고":{"voiceline":"망했어 망했어 망했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 다녀왔어? 커튼을 이렇게 열면—— 헤헤, 지휘실에 햇빛이 가득!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/login.ogg"},"실패":{"voiceline":"위험했다…… 다음번에는 안 이럴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/lose.ogg"},"우편":{"voiceline":"블루길에게 온 편지야! 엣, 지휘관 거잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/mail.ogg"},"임무":{"voiceline":"임무? 순찰 임무라면 나도 지휘관을 도와줄 수 있지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 수영하러 가자—— 아직 안 돼? 왜?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/mission_complete.ogg"},"서약":{"voiceline":"이제 지휘관을 안아도 돼?! … 휴우… 이렇게 지휘관을 끌어 안고 있으니까 정말 행복해! 헤헤, 조금만 더 안고 있을게. 조금 더 행복해질 수 있게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/propose.ogg"},"스킬":{"voiceline":"블루길 어택!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/skill.ogg"},"터치1":{"voiceline":"나랑 격투 게임 하자는 거지? 받아라! 블루길 펀치!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/touch.ogg"},"터치2":{"voiceline":"으앗! 지휘관, 열정이 너무 과해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/touch2.ogg"},"입수시":{"voiceline":"오오, 발견! 블루길의 지휘관! ......에헤헤, 오늘부터, 네가 바로 블루길의 지휘관이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/unlock.ogg"},"강화성공":{"voiceline":"야호—— 조금 더 빨라진 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리한 이번 전투를 블루길 전투라고 부르자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['유바리'] : 이건 무슨 새로운 장비야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/couple_encourage1.ogg"},{"voiceline":"['데이스', '알바코어', '카발라'] : 가토급, 신나게 놀아보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108040/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":n