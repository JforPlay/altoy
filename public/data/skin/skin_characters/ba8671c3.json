[{"클뜯 id":207040,"클뜯 함순이 id":20704,"함순이 이름":"빅토리어스","한글 함순이 + 스킨 이름":"빅토리어스","영문 함순이 + 스킨 이름":"Victorious","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207040/shipyard.png","설명":"일러스트리어스급 항공모함 - 빅토리어스 (HMS Victorious) ","자기소개":{"voiceline":"일러스트리어스급 항공모함 2번함, 빅토리어스야! 대서양에서 인도양, 태평양까지…이 빅토리어스, 바닷바람과 함께할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/profile.ogg"},"메인1":{"voiceline":"전쟁이란 추한 법이지. 그리고 이 월계관이야말로 평화와 미의 상징…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/main1.ogg"},"메인2":{"voiceline":"티르피츠, 나와 놀아주지 않으면, 또 방을 폭격해버릴 거다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/main2.ogg"},"메인3":{"voiceline":"폭력은 좋아하지 않지만, 곤란한 일을 해결할 땐 폭력이 가장 빠른 길일 때가 많지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/main3.ogg"},"전투개시":{"voiceline":"정말, 대포와 화약은 이 전쟁을 더 추악하게 만들 뿐이라니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/battle.ogg"},"상세확인":{"voiceline":"사랑도 싸움도, 더욱 대담해져도 좋아~ 자, 여차하면 나도 응원해 줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/detail.ogg"},"드랍 설명":{"voiceline":"일러스트리어스급 항공모함 - 빅토리어스 (HMS Victorious) ","voicelink":null},"의뢰 완료":{"voiceline":"밍기적 거리지마! 함재기로 입항하는 순간을 사진으로 찍어주기로, 의뢰 나간 아이들이랑 약속했단 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/expedition.ogg"},"실망":{"voiceline":"정말~ 엉망진창으로 만들어 줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/feeling1.ogg"},"낯섦":{"voiceline":"트라팔가르 해전에서 나를…? 저기, 사람 잘못 본 거 아냐? 정말~ 나한텐 말야, 그 사람은 그냥 남의 집 아이라니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/feeling2.ogg"},"호감":{"voiceline":"비스마르크 추격전이랑 텅스텐 작전? 그때는 들떠서 그냥 도와줬을 뿐, 딱히 무훈함이 될 생각은 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/feeling3.ogg"},"기쁨":{"voiceline":"기분이 좀 안 좋은데…지휘관 한가해? 좋아! 그럼 내가 확실히 코디해줄게! 아름다운 걸 보면 기분도 좋아지니 말야~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/feeling4.ogg"},"사랑":{"voiceline":"지휘관이 앞으로 어떻게 될지 궁금하네~ 물론 지금의 지휘관도 충분히 좋아하지만……어머, 얼굴 새빨간 것좀 봐. 지휘관, 진짜 귀엽다니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"승리한 기념으로, 이 월계관을 써보는 건 어때? 분명 어울릴 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/home.ogg"},"hp 경고":{"voiceline":"어머머, 방심했네","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/hp_warning.ogg"},"로그인":{"voiceline":"평온한 파도, 시원한 바닷바람…지금 이 순간에도 새로운 미의 탄생이 축복받고 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/login.ogg"},"실패":{"voiceline":"지더라도 기품을 잃지 않는 것…이게 바로 패자의 예법이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/lose.ogg"},"우편":{"voiceline":"인쇄보단 역시 자필 편지가 좋아. 지휘관, 어떻게 필체에서 글쓴이의 심경을 알아내는지, 알고 싶지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/mail.ogg"},"임무":{"voiceline":"제멋대로 구는 건 아름다운 나의 특권이야. 임무를 맡긴다니, 생각도 할 수 없는 일이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/mission.ogg"},"임무완료":{"voiceline":"정말이지, 이번뿐이야! 두 번 다신 임무 안 도와줄 거니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/mission_complete.ogg"},"서약":{"voiceline":"그렇게 깊게 생각하지 마. 당신 자신만의 페이스로 나와 사귀면 돼. …자, 흔치 않은 기념일이니, 긴장하지 말라고~ 앞으론 날 언제나 즐겁게 해줄 수 있도록 노력하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/propose.ogg"},"스킬":{"voiceline":"아름다운 세상이여, 이 나를 위해 노래를 바치려무나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/skill.ogg"},"터치1":{"voiceline":"지휘관이 그렇게 기죽어 있으면 나도 기가 죽는다고. 이렇게 아름다운 내가 옆에 있으니까, 자, 즐겁게 해보자구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/touch.ogg"},"터치2":{"voiceline":"지, 지금 '그걸' 한 거지?!! 앗, 저기…그건…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/touch2.ogg"},"입수시":{"voiceline":"로열 네이비 소속 항공모함, 빅토리어스. 자, 나의 착임에 찬가를 바치도록! 승리의 상징인 내가 있다면, 무슨 일이든 잘 될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/unlock.ogg"},"강화성공":{"voiceline":"나를 칭찬할 땐 말은 필요 없어! 마음을 움직이는 건 언제나 말이 아니라 행동이니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이렇게 까지 너덜너덜하게 만들어버렸으면…아무리 승리의 상징인 나라도 마음껏 기뻐할 순 없겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['새러토가'] : 잘 부탁할게. 나보다 납작한 '정규모함' 씨~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207040/couple_encourage1.ogg"},{"voiceline":"['일러스트리어스'] : 언니…너, 너무 흘러내려 갔다니깐!","voicelink":