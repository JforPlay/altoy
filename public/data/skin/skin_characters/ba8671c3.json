.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207043/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207043/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207043/shipyard.png","설명":"하아… 늦여름의 바람을 맞으며 달구경이라니, 꽤 운치가 있네. 후후, 지금은 로열 네이비의 레이디가 아닌 사쿠라 엠파이어의 숙녀답게, 우아하게 차를 음미…… 꺅?! 뜨, 뜨거워!","자기소개":null,"메인1":{"voiceline":"옷을 만드는 게 아니라, 누군가 옷을 만들어 주는 느낌이 꽤 신선하네… 사쿠라 엠파이어 의상, 돌아가면 좀 공부해 볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207043/main1.ogg"},"메인2":{"voiceline":"다음에는 인도미터블도 부르는 게 어떠냐고? 걔는 이 기모노를 입는 것도 귀찮아할 거라 꽤 어려울 텐데? 뭐, 지휘관이 부르면 와주긴 하겠지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207043/main2.ogg"},"메인3":{"voiceline":"하아암…… 지휘관, 경단 좀 줘♪ 경단이 있어야 달구경도 제맛이라는 말을 들은 적이 있거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207043/main3.ogg"},"전투개시":{"voiceline":"조금 움직이기 불편하네… 딱히 안 움직여도 이길 수 있지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207043/battle.ogg"},"상세확인":{"voiceline":"아름다운 풍경이야말로 아름다운 빅토리어스에게 잘 어울리지. 농담이야♪ 아무리 아름다운 풍경이라도 지휘관을 빼놓을 순 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207043/detail.ogg"},"드랍 설명":{"voiceline":"하아… 늦여름의 바람을 맞으며 달구경이라니, 꽤 운치가 있네. 후후, 지금은 로열 네이비의 레이디가 아닌 사쿠라 엠파이어의 숙녀답게, 우아하게 차를 음미…… 꺅?! 뜨, 뜨거워!","voicelink":null},"의뢰 완료":{"voiceline":"선물은… 아! 지금은 의뢰팀에게 선물을 받을 차례지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207043/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"승리를 축하하는 의미로… 아, 지금 수박을 맛있게 먹어볼게! 후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207043/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"후~ 후~ 날씨가 조금씩 선선해져서 그런지 차가 더 뜨겁게 느껴지네. …차라리 아이스티로 바꾸는 게 어때?","voic