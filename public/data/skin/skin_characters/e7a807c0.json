[{"클뜯 id":405060,"클뜯 함순이 id":40506,"함순이 이름":"꼬마 프리드리히","한글 함순이 + 스킨 이름":"꼬마 프리드리히","영문 함순이 + 스킨 이름":"Little Friedrich","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405060/shipyard.png","설명":"전함·프리드리히 데어 그로세","자기소개":{"voiceline":"안녕. 메탈 블러드 해군의 불가사의한 악장, 프리드리히 데어 그로세야. …꼬마는 어떤 곡을 연주하고 싶니?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/profile.ogg"},"메인1":{"voiceline":"축음기는 시대를 앞선 발명품이야. 그것 덕분에 소중한 기억을 소리로 보존할 수 있게 되었지… 그 \"소중한 기억\", 같이 남겨 볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/main1.ogg"},"메인2":{"voiceline":"이성과 감성. …후후, 마치 선율 속에서 찾아내는 균형 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/main2.ogg"},"메인3":{"voiceline":"후후후, 연주하렴… 뜨거운 감정을 마그마처럼 분출시키며…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/main3.ogg"},"전투개시":{"voiceline":"음표와 함께 사라지거라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/battle.ogg"},"상세확인":{"voiceline":"꼬마야, 내가 연주를 들려줄까? 혼란스러운 머릿속이 정리될 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/detail.ogg"},"드랍 설명":{"voiceline":"전함——꼬마 프리드리히","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 나간 동료들이 돌아왔단다. 축하의 악장을 연주하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/expedition.ogg"},"실망":{"voiceline":"음~ 아…… 이 악장은 조금 실망스러운걸……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/feeling1.ogg"},"낯섦":{"voiceline":"\"존재하는 것은 합리적\"이라는 말이 있지… 그러니 내가 왜 여기 있는지는 생각하지 말고, 내 연주에만 빠져들면 된단다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/feeling2.ogg"},"호감":{"voiceline":"음~ 전장에서 보여주는 용기가 악장에 어떤 놀라운 변화를 가져다주려나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/feeling3.ogg"},"기쁨":{"voiceline":"지금 여기서 즐거운 시간을 보내는 건 어떻니? 예를 들면… 프레첼 하나를 양쪽에서 동시에 물고 먹다가, 마지막에는…… 그런? 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/feeling4.ogg"},"사랑":{"voiceline":"꼬마는 내게 응석을 부리고 싶은 걸까? 아니면 내가 응석을 부리기를 바라는 걸까? 후후후, 어느 쪽이든 오늘만은 허락할게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/feeling5.ogg"},"터치3":{"voiceline":"즐겁네. 꼬마에게도 해주고 싶은걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오렴. 후후, 위대한 교향곡을 구상하고 있었단다. 우리 꼬마의 개선을 축하하기 위해서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/home.ogg"},"hp 경고":{"voiceline":"후후, 카덴차인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/hp_warning.ogg"},"로그인":{"voiceline":"오늘 공연이 시작할 거란다. 꼬마야, 어서 앉으렴.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/login.ogg"},"실패":{"voiceline":"조화가 무너진 트릴… 컨디션을 조정해야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/lose.ogg"},"우편":{"voiceline":"꼬마 앞으로 온 우편이야. 어머, 소리가 나는 엽서도 있는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/mail.ogg"},"임무":{"voiceline":"원하는 것을 어떤 행동으로 교환한다… 후후, 임무라는 거군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/mission.ogg"},"임무완료":{"voiceline":"임무 보상은 제대로 확인했니? 음… 어떤 곡을 연주해야 우리 꼬마를 손에 넣을 수 있으려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/mission_complete.ogg"},"서약":{"voiceline":"이건… 후후후, 우리 꼬마는 이게 무슨 의미인지는 알고 있는 거니? 그럼 원하는 대로 내 생명의 전부를 꼬마에게 맡기고, 꼬마의 전부를 받아들일게……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/propose.ogg"},"스킬":{"voiceline":"교향곡 제5번을 연주하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/skill.ogg"},"터치1":{"voiceline":"응? 오늘은 뭐가 듣고 싶니, 꼬마야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/touch.ogg"},"터치2":{"voiceline":"후후후, 이게 꼬마가 내린 결단이니?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/touch2.ogg"},"입수시":{"voiceline":"어서 오렴, 꼬마야. 오늘은 뭘 함께 즐겨볼까? 네 재능? 영광? 아니면 청춘? …모두 내게 털어놔 보렴♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/unlock.ogg"},"강화성공":{"voiceline":"상쾌한 기분……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"승리의 앙코르는 지금부터 시작이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"전부를 받아들인다는 말은 그저 미사여구일 뿐만이 아니란다. 그러니 모두, 전부 다 내게 맡겨주렴. 꼬마가 준 모든 것은 내 마음속 가장 소중한 곳에 간직할게… 후후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"어서 오렴, 후후. 꼬마를 위해 연주하는 개선의 악장을 들어보렴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"큰 사랑을 한 몸에 받는 자여, 오늘은 어떤 연주를 들려줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"꼬마에게 내 뜨거운 마음을 보여줄게~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"이성과 감성을 섬세한 균형으로 엮어, \"마음\"으로 연주하는 \"사랑\"이라는 이름의 악장…… 꼬마가 내게 들려주었지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"축음기가 기록한 곡은 소중한 기억과 마찬가지로 누군가와 함께 나눌 수 있단다. …꼬마야, 기쁜 일이든 슬픈 일이든 모두 나누자꾸나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405060/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":1}]