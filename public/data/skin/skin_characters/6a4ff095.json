[{"클뜯 id":9708010,"클뜯 함순이 id":970801,"함순이 이름":"U-556·META","한글 함순이 + 스킨 이름":"U-556·META","영문 함순이 + 스킨 이름":"U-556 META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9708010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9708010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9708010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9708010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9708010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9708010/shipyard.png","설명":"바다의 퍼시벌 U-556이 왔어. 과연 내가 도와줄 수 있는 게 있기는 할까……. 폐만 끼칠 거 같은데, 잘 부탁해♪","자기소개":{"voiceline":"언니랑 한 약속은…… 물론 기억하고 있지! 그치만 자꾸 입에 담으면 언니도 난감하잖아? 언니도 내가 계속 언니만 따르는 건 원하지 않는 거 같고… 어쨌든! 지금은 마음 속에 담아두고 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/profile.ogg"},"메인1":{"voiceline":"「어른」이란 뭘까? 맨날 질릴 때까지 놀 수 없게 된다는 건가? 후후후, 그렇게 간단한 건 아니겠지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/main1.ogg"},"메인2":{"voiceline":"뭐든 기분전환이라도 할까…… 그래! 도움이 필요한 애가 없는지 모항을 순찰해야겠다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/main2.ogg"},"메인3":{"voiceline":"지휘관~ 후훗, 다른 애랑 약속을 한 건지 뭔지는 모르겠지만, 잊지 않도록 조심하라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/main3.ogg"},"전투개시":{"voiceline":"미안해. 적이라서 어쩔 수가 없어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/battle.ogg"},"상세확인":{"voiceline":"약속…… 지휘관은 동료들이랑 약속 많이 했지? 약속은 다 지켜줬어? 이래저래 포기할 수밖에 없었던 약속도 분명 몇 개는 있겠지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/detail.ogg"},"드랍 설명":{"voiceline":"U-556 호 잠수함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>'","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 애들이 돌아왔어. 마중 나가기로 약속 했지? 어서 가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/expedition.ogg"},"실망":{"voiceline":"서로 상관하지 않는 편이 좋을지도 모르겠네. 어쨌든 지휘관은 지휘관으로서 할 일을 하고, 나는 내 나름대로 할 일을 할게. 서로 더는 빚진 거 없는 걸로 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/feeling1.ogg"},"낯섦":{"voiceline":"「바다의 퍼시벌」 출동이다! 후훗, 오늘은 내 도움을 필요로 하는 애들이 어디 있을까~ 지휘관 이름으로 사람들 도와줘도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/feeling2.ogg"},"호감":{"voiceline":"지휘관이 갑자기 사라지면, 그건 모항 애들과의 약속을 배신하는 게 되려나? 그러니까 지휘관, 다들 함부로 내팽개치거나 하진 말라구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/feeling3.ogg"},"기쁨":{"voiceline":"「누군가와의 중요한 약속」 ……지휘관은 이게 어린 아이 같은 목표라든가, 그저 환상에 불과하다고 생각하진 않아? 후훗, 아니라고 말해줄 줄 알았어♪ 지휘관은 다정한 사람이니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/feeling4.ogg"},"사랑":{"voiceline":"아무 고민 없는 '바다의 퍼시벌'이 되고 싶었고, 매일 아무 목적 없이 잠수하고 놀고만 싶었어~ 그렇다고 지금의 내가 싫은 건 아니야. 적어도 내 속마음을 털어놓을 수 있는 지휘관이랑 만났으니까…… 그치?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/feeling5.ogg"},"터치3":{"voiceline":"응? 으응? 뭐 하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔어? 자리를 비운 동안 모항 동료들한테 이것저것 해줬어. 후훗, 지휘관 이름으로 말이야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/home.ogg"},"hp 경고":{"voiceline":"방해하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/hp_warning.ogg"},"로그인":{"voiceline":"어서 와~ 누구랑 약속 했어? 선약이 있는 거면 이만 실례할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/login.ogg"},"실패":{"voiceline":"괜찮아, 무리해서 싸울 필요 없어. 이별 때문에 눈물 흘리는 건 이제 싫다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/lose.ogg"},"우편":{"voiceline":"우편이 왔어~ 겸사겸사 가지고 왔지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/mail.ogg"},"임무":{"voiceline":"새 임무가 있어. 나는 별로 상관없지만, 내버려 둬서 쌓이면 지휘관이 점점 더 번거로워질걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어. 보상 가지고 올게. 어디까지나 겸사겸사 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/mission_complete.ogg"},"서약":{"voiceline":"「약속」… 그게 나한테 어떤 의미인지 잘 알고 있지? 이제 진짜 마지막 약속이야. 절대 배신하지 말고, 끔찍한 일을 저지르지 말아줘. …지휘관, 약속…해줄 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/propose.ogg"},"스킬":{"voiceline":"원망하기 없기다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/skill.ogg"},"터치1":{"voiceline":"지금은 놀 시간이 없다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/touch.ogg"},"터치2":{"voiceline":"설마 지휘관…… 이미 익숙해진 건? 후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/touch2.ogg"},"입수시":{"voiceline":"「바다의 퍼시벌」 U-556이 왔어. 과연 내가 도와줄 수 있는 게 있기는 할까……. 폐만 끼칠 거 같은데, 잘 부탁해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/unlock.ogg"},"강화성공":{"voiceline":"강해진다고 해서 더 많은 걸 할 수 있다는 법은 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼으니까 뭐 됐어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9708010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex"