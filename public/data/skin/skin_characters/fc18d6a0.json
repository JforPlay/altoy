ercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/main1.ogg"},"메인2":{"voiceline":"(이건 어디까지나 지휘관님과의 마케팅 계획…… 그래! 상품 판매를 위해 필요한 거야! 갑자기 무언가에 눈 뜨거나 쾌감을 느끼거나 하지는 않겠…지?! 우읏…! ///)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/main2.ogg"},"메인3":{"voiceline":"지, 지휘관님? 추우시면 여기 코트에 들어오시겠어요? 저도 사실… 에취!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/main3.ogg"},"전투개시":{"voiceline":"윽… 조심해야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/battle.ogg"},"상세확인":{"voiceline":"하아… 구매부의 신상 수영복을 이기려면, 디자인과 비용에 집중하는 것 말고도, 실제로 착용한 모습을 미리 체험해서 모두의 수요에 부응할 수 있도록 해야…… 하아…… 그, 그렇죠? 지휘관님…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/detail.ogg"},"드랍 설명":{"voiceline":"음… 세트 거울로 찍은 사진을 지휘관님께 전송…… 지휘관님 말대로 이번 신상 수영복 디자인이 유출되면 큰일이니까… 하지만 이렇게라도 안 하면 지휘관님과의 계획이…!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 귀환한 모양이네요. 지휘관님, 마중은 음… 너무 오래 걸리지 않았으면 하는데… 하아… 하아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님, 여기 사전 답사가 끝나면 다음은 어디로……? 어트랙션을 전부 둘러보러 간다고요? …다음에 이 수영복을 입고 지휘관님과 놀 계획이라, 예행연습을 하기에는 딱 좋기는 하겠지만…… 아읏… 아, 아뇨! 분발할게요! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님도 고생 많으셨어요…! 아하하, 몰래 나가는 건 역시 힘드네요. 여기 같은 다목적실이 없었으면, 지휘관님이랑 만나는 것도 꽤 힘들었겠어요… 후우…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"하아, 하아…… 그렇게 멀리서 걸어온 것도 아닌데 지쳐버렸어요… 들키지 않으려고 신경을 써서 그런 걸까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/login.ogg"},"실패":{"voiceline":"하아하아… 주위를 살피면서 싸우려니까 역시 힘드네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/lose.ogg"},"우편":null,"임무":{"voiceline":"지휘관님이 임무를 완수하시면 모항에서 사업을 하는 동료들의 삶도 윤택해져요. 늘 감사히 여기고 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/mission.ogg"},"임무완료":{"voiceline":"임무 완료입니다! 다음 투자처는 어디로 할까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"하, 한 장 더 찍는 편이 좋을까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/touch.ogg"},"터치2":{"voiceline":"하아, 하아…… 지휘관님, 저기… 목소리를 내면 아무래도 들키겠… 꺅?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/touch2.ogg"},"입수시":{"voiceline":"음… 세트 거울로 찍은 사진을 지휘관님께 전송…… 지휘관님 말대로 이번 신상 수영복 디자인이 유출되면 큰일이니까… 하지만 이렇게라도 안 하면 지휘관님과의 계획이…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"이겼어요! 아, 승리 축하연에서 수영복을 선보여도 괜찮을 것 같네요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/519012/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"동화 속 세계","상점 id":71053,"상점 카테고리 id":26,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"한정 (2025/10/15)","진영":"ROC","레어도":"SR","ex_chat_status":0}]