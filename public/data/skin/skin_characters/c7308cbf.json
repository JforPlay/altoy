[{"클뜯 id":902020,"클뜯 함순이 id":90202,"함순이 이름":"마르세예즈","한글 함순이 + 스킨 이름":"마르세예즈","영문 함순이 + 스킨 이름":"Marseillaise","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/902020/shipyard.png","설명":"라 갈리소니에르급 경순양함 - 마르세예즈","자기소개":{"voiceline":"라 갈리소니에르급 경순양함, 아이리스 리브레의 전투 천사 마르세예즈입니다. 지칠 줄 모르며, 아픔을 두려워하지 않고, 오로지 평화와 정의만을 위해 검을 휘두르죠. 언젠가는 세상에 남겨진 모든 부정한 것들이 사라질 날이 오리라 믿으며……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/profile.ogg"},"메인1":{"voiceline":"죄송합니다. 비서함으로 임명되었음에도 불구하고, 지휘관의 성스러운 책무에 큰 도움이 되지 못해서…… 전투 이외의 다른 지식도 습득하면 좋았을 텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/main1.ogg"},"메인2":{"voiceline":"라 갈리소니에르? 가끔 곤란하게 하는 건 사실이지만…… 그래도 괜찮아요. 아무리 심판정이라고 해도, 이 전투 천사 마르세예즈에게는 대적할 수 없답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/main2.ogg"},"메인3":{"voiceline":"지금 과학부 바쁜가요? 그럼 다음 기회에라도…… 아, 아니에요, 아무것도. 조금 여쭈어볼 것이 있어서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/main3.ogg"},"전투개시":{"voiceline":"아이리스에 대한 위협은… 오로지 제거할 뿐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/battle.ogg"},"상세확인":{"voiceline":"웅장한 곡조는 성스러운 책무를 다하는 병사들에게 힘을 실어주죠. 지휘관, 이런 곡조를 전장에서…… 음… 사실 마르세예즈의 의장에는 전투 시 곡을 연주하는 기능이 있는데…… 이상한가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/detail.ogg"},"드랍 설명":{"voiceline":"라 갈리소니에르급 경순양함 - 마르세예즈","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료군요. 전투하느라 고생 많으셨…… 음? 이 물자는 위험을 무릅쓰고 적으로부터 빼앗은 것 아닌가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/expedition.ogg"},"실망":{"voiceline":"지휘관, 당신과는 적대하고 싶지 않아요. ……부디 과오를 깨닫고 갱생하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/feeling1.ogg"},"낯섦":{"voiceline":"마르세예즈, 내려진 이름에 걸맞도록 동료들을 고무시킬 수 있는 존재가 되겠어요. 깃발을 들고 선두에서 길을 개척하는, 성스러운 의지로 전투를 승리로 이끄는 천사로서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/feeling2.ogg"},"호감":{"voiceline":"자유 아이리스 교국도 비시아 성좌도 근원은 같은 아이리스…… 이 모항에서 다시 동료들과 하나가 되었네요. 지휘관, 당신께는 감사하고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/feeling3.ogg"},"기쁨":{"voiceline":"전투 말고는 잘 몰라서…… 알려주시는 건 감사하지만, 그… 어디부터 시작하면 좋을까요? 음… 누군가에게 가르침을 받은 경험도 많이 없어서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/feeling4.ogg"},"사랑":{"voiceline":"죄, 죄송합니다. 꽤나 오래 폐를 끼치고 말았네요……. 그렇지만 저, 지금까지는 맛보지 못한 즐거운 시간에 흠뻑 빠져서… 가능하다면 이대로 계속했으면 하는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"군사의 사기를 그렇게 북돋아 줄 수도 있군요. …역시 지휘관, 대단하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/home.ogg"},"hp 경고":{"voiceline":"마지막까지 성스러운 책무를 다하겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/hp_warning.ogg"},"로그인":{"voiceline":"전투 천사 마르세예즈, 지휘관께서 도착하시기만을 기다리고 있었습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/login.ogg"},"실패":{"voiceline":"패배했…습니다…… 실망을 안겨드리고 말았네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 우편이 왔네요. 이 검으로 개봉해도 되나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/mail.ogg"},"임무":{"voiceline":"새 임무인가요? 마르세예즈가 지휘관을 위해 해드릴 수 있는 건…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었습니다. 보상 수령과 이동 중 호위는 맡겨주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/mission_complete.ogg"},"서약":{"voiceline":"전투 천사 마르세예즈, 이 칼날에 맹세합니다. 사랑하는 지휘관을 적으로부터 지키고, 위해를 가하려는 자에게 아이리스의 이름으로 성스러운 형벌을 내리겠다고…... 이 생명이 계속되는 한….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/propose.ogg"},"스킬":{"voiceline":"Marchons!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/skill.ogg"},"터치1":{"voiceline":"정의, 평화, 아이리스 리브레를 위해 지휘관의 뜻을 관철하리라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/touch.ogg"},"터치2":{"voiceline":"응? 지휘관? 마르세예즈, 잘 모르겠어요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/touch2.ogg"},"입수시":{"voiceline":"아이리스 리브레 소속, 전투 천사 마르세예즈입니다. 지휘관, 당신의 명령을 들려주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/unlock.ogg"},"강화성공":{"voiceline":"평화와 정의를 위한 성스러운 책무는 이상만으로 수행할 수 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"성스러운 아이리스의 검으로 교국과 원수진 자를 모조리 베어 넘기리라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/902020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"전투밖에 몰랐던 제가 이렇게 다양한 경험을 하다니…… 마르세예즈, 지휘관과 함께 하는 모든 것에 행복을 느껴요. 아마 이게 '사랑'이라는 거겠죠……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9020