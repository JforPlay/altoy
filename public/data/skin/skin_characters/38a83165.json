[{"클뜯 id":407020,"클뜯 함순이 id":40702,"함순이 이름":"꼬마 그라프 체펠린","한글 함순이 + 스킨 이름":"꼬마 그라프 체펠린","영문 함순이 + 스킨 이름":"Zeppy","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407020/shipyard.png","설명":"항공모함 그라프 체펠린 ","자기소개":{"voiceline":"나는 그라프 체펠린, 메탈 블러드 최초의 항공모함이다! 흥, 듣고서 놀라도록 해라. 비행기를 통솔하는 자가 미래의 해전을 제패한다. 그리고 이 그라프 체펠린이야말로 하늘에 빛나는 샛별이 될 것이다! ……그러니까 빨리 돌아가게 해줘! ……아, 안 돼? 큭……, 이거나 먹어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/profile.ogg"},"메인1":{"voiceline":"……으음, ……크으으윽. ……어째서 경은 나와 놀아주지 않는 것인가! 이거나 먹어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/main1.ogg"},"메인2":{"voiceline":"흥, 나를 쉽게 부리지는 못할 거라고! ……간식? ……머, 먹고 싶어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/main2.ogg"},"메인3":{"voiceline":"으음, 이건 이렇게……. 아니야, 이렇게……? 으으……. 뭐, 뭐야! 도와주지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/main3.ogg"},"전투개시":{"voiceline":"함재기의 강함을 깨달아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/battle.ogg"},"상세확인":{"voiceline":"왜 이곳에도 메탈 블러드 사람이……. 게다가 다들 크고, 조금 무서워…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/detail.ogg"},"드랍 설명":{"voiceline":"항공모함 그라프 체펠린","voicelink":null},"의뢰 완료":{"voiceline":"부두에 누가 돌아왔다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/expedition.ogg"},"실망":{"voiceline":"흥, 다가오지 마라! 나는 자력으로 메탈 블러드에 돌아가겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/feeling1.ogg"},"낯섦":{"voiceline":"그 얼굴은 뭐냐! 메탈 블러드에 돌아가지 않은 이유는, 이곳이 너무 넓어서 돌아갈 길을 모르는 것 뿐이다! 큭! 일부러 넓게 만든 것이 분명해……?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/feeling2.ogg"},"호감":{"voiceline":"내 도움을 받고 싶으면 빨리 말하면 되잖아……. 이렇게 맛있는 케이크를 매일 먹을 수 있다면……. 조금 더 이곳에 있어줄 수도 있다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/feeling3.ogg"},"기쁨":{"voiceline":"내가 먹을……. 에잇, 오늘의 간식은 뭐냐! 메, 메탈 블러드에 안 돌아가냐고……? 크으으윽……. 나, 나의 미래는 아직 밝다! 조금 더 기다리게 해도 되니까! 응, 분명히 괜찮다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/feeling4.ogg"},"사랑":{"voiceline":"경은 의외로 좋은 사람이고, 이곳 사람들도 나에게 친절해서……. 내가 엄청난 항공 모함이 되면, 이 함대에서 계속 경과 함께 싸워도 좋다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"경은 제법 하는군. 내 지휘관을 수행하기에 마땅할지도 몰라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/home.ogg"},"hp 경고":{"voiceline":"흐, 흥이다! 지지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/hp_warning.ogg"},"로그인":{"voiceline":"가, 갑자기 어디로 사라진 것인가! 이거나 먹어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/login.ogg"},"실패":{"voiceline":"내, 내 잘못이 아니다! 아침밥이 부족했을 뿐이다! 아마도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/lose.ogg"},"우편":{"voiceline":"메일이 한 통 부족해? 거, 거짓말?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/mail.ogg"},"임무":{"voiceline":"뭐? 임무 완수는 상식 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/mission.ogg"},"임무완료":{"voiceline":"임무 보수, 많네…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/mission_complete.ogg"},"서약":{"voiceline":"바보바보바보! 이런 것을 나에게 주면 메탈 블러드에 돌아가고 싶지 않다고! 으으……. 그, 그럼 약속해! 내가 돌아가면 나중에 꼭 나를 찾으로 오겠다고, 알았어? 약속한 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/propose.ogg"},"스킬":{"voiceline":"조, 종언을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/skill.ogg"},"터치1":{"voiceline":"마음대로 만지지 마! 이거나 먹어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/touch.ogg"},"터치2":{"voiceline":"이 쓰레기! 이거나 먹어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/touch2.ogg"},"입수시":{"voiceline":"경은 누구지? 여기는 어딘가?? ……알았다! 경은 나 그라프 체펠린에게 무례를 범하려는 녀석이군! 나, 나는 메탈 블러드 최초의 항공모함 그라프 체펠린이다! 후후후, 허를 찔렀다고는 하나, 여기까지 유괴하다니……. 이거나 먹어라, 이 발칙한 노옴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/unlock.ogg"},"강화성공":{"voiceline":"쉬, 쉽게는 길들여지지 않는다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"음, 음후후후후……. 역시 비행기야말로 최강이다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['그라프 체펠린'] : 나는 모든 것을 사랑한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/couple_encourage1.ogg"},{"voiceline":"['꼬마 벨파스트', '꼬마 히에이', '꼬마 아카기'] : 경들과는 다르다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407020/cou