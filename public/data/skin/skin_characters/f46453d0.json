[{"클뜯 id":202340,"클뜯 함순이 id":20234,"함순이 이름":"리버풀","한글 함순이 + 스킨 이름":"리버풀","영문 함순이 + 스킨 이름":"Liverpool","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202340/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202340/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202340/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202340/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202340/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202340/shipyard.png","설명":"글로스터급 경순양함 - 리버풀","자기소개":{"voiceline":"페넌트 넘버 C11, 글로스터급 경순양함인 리버풀이야. 함력상 경험은 그럭저럭 있고, 다양한 함대에 소속돼서…… 항공 어뢰? 아하하하… 발랄하고 능력있는 리버풀은 그런 거 하나도 안 무서워♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/profile.ogg"},"메인1":{"voiceline":"메이드 업무는 확실히 잘 한다고는 못하지만, 그래도 할 수 있기는 해. 리버풀의 능력만 있으면 어떤 트러블이 생겨도 문제없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/main1.ogg"},"메인2":{"voiceline":"오늘은 간식을 잔뜩 받았어! 말린 과일에 도너츠, 장어구이…… 너무 많다고? 후후후, 리버풀은 모항 사람들이랑 사이가 엄청 좋으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/main2.ogg"},"메인3":{"voiceline":"음…… 이건 좀 너무 과하고, 이건 좀 굳어있는 느낌이고… 그리고… 아, 주인님! 리버풀이랑 투샷 한 장만 부탁할게! 3, 2, 1, Smile~♪ 좋아, 괜찮네~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/main3.ogg"},"전투개시":{"voiceline":"정신차리고~ 파이팅!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/battle.ogg"},"상세확인":{"voiceline":"Smile~ Smile~ 주인님, 웃는 얼굴로 있어야 행운이 찾아온대! 인생은 \"웃는 만큼 이득 본다\"고도 하잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/detail.ogg"},"드랍 설명":{"voiceline":"글로스터급 경순양함 - 리버풀","voicelink":null},"의뢰 완료":{"voiceline":"주인님, 의뢰팀 동료들을 마중하러 나갈 때는 웃는 얼굴로 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/expedition.ogg"},"실망":{"voiceline":"……으아, 이러다간 주인님이 아니라 리버풀이 주인님을 혼내는 꼴이 되겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/feeling1.ogg"},"낯섦":{"voiceline":"다른 로열 메이드보다 더 활기가 넘치는 것 같다고? 그야, 발랄하고 능력 넘치는 메이드니까 어쩔 수 없지! 아하~ 주인님, 혹시 리버풀을 뇌까지 근육이라고 생각하는 거 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/feeling2.ogg"},"호감":{"voiceline":"주인님, 장어덮밥이랑 랍스카우스 중에 뭐 먹을래? 응, 둘 다 상관 없다…고 하니까, 둘 다 만들어야겠다♪ 후후후, 두 음식 다 리버풀이 잘 만드는 요리니까 사실 처음부터 둘 다 만들려고 했었어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/feeling3.ogg"},"기쁨":{"voiceline":"요즘 좀 이상하다고? 그런가… 주인님은 왜… 얼굴이 빨갛다고? 어디 몸이 안 좋은 건…… 으앗?! 가, 갑자기 왜 가까이 오고 그래…… 체, 체온 잴 필요 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/feeling4.ogg"},"사랑":{"voiceline":"주, 주인님! 음… 사실 주인님한테 전하고 싶은 말이…… 긴장하고 있는 거 아니냐고? 아니야! 음, 그게…… 후우, 난 주인님을 좋아해! ……아, 아, 아니! 지금 당장 대답해 줄 필요는 없어! 오히려 리버풀 쪽이 아직 대답을 들을 준비가 안 되어 있다고 할까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/feeling5.ogg"},"터치3":{"voiceline":"앗싸♪ 주인님이 쓰다듬어줬다♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와, 주인님! 리버풀이 지금 홍차를…… 아! 벌써 식어버렸네. 다시 내려서 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/home.ogg"},"hp 경고":{"voiceline":"하하하, 이거 짜릿한걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침, 주인님! 후후, 새로운 하루는 웃는 얼굴로 맞이해야지! Smile~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/login.ogg"},"실패":{"voiceline":"아하하하… 발랄 속성 메이드라 뭐든 팍팍 해결할 수 있을 줄 알았는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/lose.ogg"},"우편":{"voiceline":"우편이 산더미처럼 쌓였어! 으아아아! 무너진다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/mail.ogg"},"임무":{"voiceline":"새로운 임무 목록이 왔…… 아니, 엄청 길잖아! 이걸 다 처리해야 하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/mission.ogg"},"임무완료":{"voiceline":"……보상 확인? 아하하, 그런 건 좀 자신이 없어서 말이야~ 곁에서 기록 사진 남기는 정도라면 할 수 있는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/mission_complete.ogg"},"서약":{"voiceline":"리버풀에게 줄 선물이 있다고…? 음… 상자 속에는…… 응? ……이건?! 그, 그리고 중요한 얘기가 있다고…? 아, 알았어! 이제 마음의 준비는 끝났어… 좋아! 계속, 계속! 주인님 곁에 있을게…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/propose.ogg"},"스킬":{"voiceline":"술래잡기 시작~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/skill.ogg"},"터치1":{"voiceline":"(작은 목소리로) 음… 주인님은 뭐 하고 싶은 거 없어? 리버풀이 같이 해줄게. …메이드 업무는 괜찮냐고? 아하하, 지금 땡땡이치는 중이니까 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/touch.ogg"},"터치2":{"voiceline":"아하하하, 주인님이 그렇게 장어밥이 되고 싶다면, 그렇게 만들어 줄 수도 있어☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/touch2.ogg"},"입수시":{"voiceline":"Hello~ 주인님! 글로스터급 경순양함인 리버풀이야! 자, 어서 이쪽으로 와~ 3, 2, 1~ 치즈♪ …좋아, 잘 찍혔네! 아, 혹시 글로스터가 물어보면 날 본 건 비밀로 해주지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/unlock.ogg"},"강화성공":{"voiceline":"강해졌어! 어쩌면 핸드폰 카메라 성능도 좋아진 거 아닐까? 응? 그럴 일은 없다고? …그렇구나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"우리의 승리야! 자, 주인님~ 리버풀이랑 투샷으로 Smile 사진 한 장 찍자♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/win_mvp.ogg"},"전투개시_ex":{"voiceline":"주인님에게 멋진 모습을 보여줘야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"리버풀은 메이드인데 늘 주인님에게 걱정만 끼치는 것 같아… 그러니 늘 돌봐주는 주인님에게 보답을 해야겠지! 앞으로는 더 많이 데이트하자! 그리고 주인님과의 투샷도, 주인님과의 추억도… 더 많이 남길 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"주인님? 에헤헤헤♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"아! 어서 와, 주인님! 전리품도 있어! 후후후, 기념 사진…이 아니라, 주인님이랑 전리품으로 기념 사진을 찍게 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"주인님, 오늘도 계속 웃어줘! Smile♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"새로운 임무가 왔어! 주인님, 전부 처리하면 오늘은 리버풀이 직접 만든 요리를 두 배로…… 그렇게 많이 못 먹는다고? 뭐어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/mission_ex.ogg"},"임무완료_ex":{"voiceline":"으아아! 주인님, 어서 일어나! 새로운 임무가 도착했어! (작은 목소리로) 음… 너무 과했나…? 으응, 아무것도 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"(작은 목소리로) 응, 주인님. 뭐 하고 싶은 거라도 있어? 뭐든 괜찮아! 주인님을 보좌하는 게 메이드의 책무니까☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/touch_ex.ogg"},"터치2_ex":{"voiceline":"어머… 이렇게 갑자기… 뭐 딱히 안 된다는 건 아니지만☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"신난다, 주인님! 아, 그렇게 껴안으면 투샷을 못 찍는다고? 아하하하… 잠깐만~ 으흠, 이러면 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['글로스터'] :  으아아! 리버풀이 잘못했으니까 이번에는 좀 봐주라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/couple_encourage1.ogg"},{"voiceline":"['맨체스터'] :  맨체스터, 리버풀이랑 같이 사진 찍자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"음… 어떻게든 장어랑 랍스카우스를 조합해서… 아, 주인님! 리버풀이 만든 새로운 요리 먹어볼래? 왜 뒷걸음질 치는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/main5_ex.ogg"},"메인6_ex":{"voiceline":"어떤 곤경에 처하더라도 계속 웃으면 행운이 찾아와! 그래, 상대가 아무리 강해도, 메이드 수행이 힘들어도…… 분명 행운이 찾아올 거야! 주인님, Smile♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"걱정 마, 주인님! 리버풀은 꾸준히 메이드 스킬을 수행 중이거든! 계속 열심히 하면 리버풀도 한 사람 몫을 다하는 메이드가 될 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202340/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":1},{"클뜯 id":202341,"클뜯 함순이 id":20234,"함순이 이름":"리버풀","한글 함순이 + 스킨 이름":"블레싱 블레이즈","영문 함순이 + 스킨 이름":"Breeze of Blessings","스킨 타입":"Rpg Adventure","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202341/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202341/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202341/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202341/icon.png","쥬스타 아이콘 일러":"https://ra