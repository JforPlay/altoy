[{"클뜯 id":506020,"클뜯 함순이 id":50602,"함순이 이름":"화지아","한글 함순이 + 스킨 이름":"화지아","영문 함순이 + 스킨 이름":"Hwah Jah","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506020/shipyard.png","설명":"수상기 항공모함—화지아","자기소개":{"voiceline":"젠하이와 마찬가지로, 이스트 글림 수상기 항공모함인 화지아입니다. 안타깝게도 갈고 닦은 보검도 뽑지 못하고, 물거품이 되고만… 저였지만… 어두운 이야기는 여기까지 하죠. 지휘관님, 화지아랑 재밌는 거 하자는 약속은 기억하고 계시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/profile.ogg"},"메인1":{"voiceline":"지휘관님은 평소에 어떻게 노고를 달래시나요? 호화로운 요리라도 드시나요? 아니면 밤새도록 미친듯이 논다던가? 저는… 아뇨, 참고하려구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/main1.ogg"},"메인2":{"voiceline":"낯선 분과 대화를 나눌 때는 예의를 갖추고 대하는 게 중요하지요. 예의 있게 대해도 대화가 안 통하는 분이 상대라면… 보다 직접적인 방법으로 나갈 수 밖에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/main2.ogg"},"메인3":{"voiceline":"마파두부…? 두부를 요리하는 방법만 수백 가지가 있는데, 굳이 매운 맛에 얽매이지 않아도 괜찮겠죠. 게다가 매운 건 저… 쥐약이라…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/main3.ogg"},"전투개시":{"voiceline":"마음껏 두드려 패라, 라는 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/battle.ogg"},"상세확인":{"voiceline":"그러고 보니, 이글 유니온 파티에 참석하고 싶다고 손을 드니까 다들 신기하게 보던데… 뭐 이상한 점이라도 있었던 걸까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/detail.ogg"},"드랍 설명":{"voiceline":"수상기 항공모함—화지아","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아왔네요. 고생했다고 위로해주러 나갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/expedition.ogg"},"실망":{"voiceline":"어떤 말을 해도, 하루하루 살아가야 하는 거니까... 대충 내버려 둘게요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/feeling1.ogg"},"낯섦":{"voiceline":"느닷없이 무리에 섞이려고 하면, 아무리 예의 바르게 인사를 건네도 거리를 두게 되죠. 다행스럽게도 여기 마침 소개해드릴 만한 분이… 지휘관님, 발 벗고 나서 주시지 않으시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/feeling2.ogg"},"호감":{"voiceline":"얼마 전, 동료들과 귀신의 집에 갔었어요……그런데 귀신들보다 동료들이 허둥대는 모습을 보는 게 더 재밌어서… 지휘관님은 귀신이 무서우신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/feeling3.ogg"},"기쁨":{"voiceline":"동료들과 시간을 보내면서 깨달았는데, 이 정도로 많은 사람 중에서 두각을 나타내기는 쉽지 않겠네요…. 그렇다면 차라리 도망치는 편이…… 어머? 방금 건 혼잣말이니까 신경 쓰지 마시길. 그것보다 지휘관님, 최근 동료들의 평가에 관심이라도 있으신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/feeling4.ogg"},"사랑":{"voiceline":"알고 지낸 지도 시간이 꽤 흘렀으니, 화지아가 딱히 '착한 아이'가 아니란 건 이미 눈치채셨겠죠. 뭐, 이게 누구 때문이냐고 하면… 물론 지휘관님 때문이죠. 이렇게 '나쁜 것'을 화지아에게 알려주신 건 다른 누구도 아닌 지휘관님 아니신가요? 후후, 그 책임, 확실히 져 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"응? 지휘관님, 방금 어디 가셨었어요? 설마 저 몰래 무슨 재미있는 거라도… 후후, 농담이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/home.ogg"},"hp 경고":{"voiceline":"윽, 잠깐 방심했어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 벌써 업무 시간인가요? …조금만 더 땡땡이치는 건 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/login.ogg"},"실패":{"voiceline":"이 굴욕은… 언젠가 두 배로 갚아드리죠…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/lose.ogg"},"우편":{"voiceline":"새로운 우편이네요. 그러고 보니, 지휘관님은 평소에 다양한 행사에 초대받거나 하시죠? 괜찮으시면 저도 함께해도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/mail.ogg"},"임무":{"voiceline":"임무 중에는 재밌는 것도 있다는 소리를 들은 적이 있어요. 지휘관님만 괜찮으시다면, 다음에는 저도 함께해도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/mission.ogg"},"임무완료":{"voiceline":"임무 완료예요. 즉, 잠깐 동안 쉬어도 괜찮다, 라는 거겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/mission_complete.ogg"},"서약":{"voiceline":"지휘관님께 있어서 일등이 되겠다고는 감히 바라지 않아요. 그렇지만 이건 확실히 나눈 약속이니, 만약 도중에 저를 내팽개치신다면, 저… 굉~~장히 화를 낼 거예요. 무슨 일을 저지를지 상상도 못 하실 정도로 화낼 거거든요? 후후후, 그럼~ 앞으로도 잘 부탁드려요. 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/propose.ogg"},"스킬":{"voiceline":"말이 안 통한다면 실력 행사뿐이죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/skill.ogg"},"터치1":{"voiceline":"괜찮아요. 지금은 편하게 있어도 아무한테도 들키지 않으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/touch.ogg"},"터치2":{"voiceline":"즉, 지금부터는 정당방위를 행사해도 괜찮다, 라는 거겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 처음 뵙겠습니다. 이스트 글림 소속인 화지아라고 해요. 둘만 있으니까 단도직입적으로 여쭈어보겠는데… 크흠, 여기엔… 그러니까… 두근거리는 재미있는 행사도 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/unlock.ogg"},"강화성공":{"voiceline":"지휘관님의 배려, 꼭 보답하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후, 화지아의 '지아(甲)'는 일등이라는 의미랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/win_mvp.ogg"},"전투개시_ex":{"voiceline":"이곳에서 마음껏 싸울 수 있는 것도 지휘관님이 제게 주신 좋은 기회입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"그런데 지휘관님, 나가 계신 동안 설마 다른 여자아이랑 꽁냥거린 건 아니시겠죠…… 헤헤, 단지 지휘관님의 반응을 보고 싶어서 농담한 것 뿐이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 오늘은 일이 많지 않아요. 업무가 다 끝나면 뭘 할지 미리 계획해 보는 것도 좋겠는데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"그러니까…… 일이 다 끝났으면, 나가서 다른 동료들과 뭔가 해도 되지 않을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/touch_ex.ogg"},"터치2_ex":{"voiceline":"응? 지휘관님, 제가 생각했던 것보다 훨씬 더 대담하시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"가장 큰 공신은 지휘관님이어야 맞겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['젠하이'] :  수상기 사용법 좀 알려주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"얍!…… 아, 아무것도 아녜요. 그냥 갑자기 부채로 쳐보고 싶어서요. 아무 이유도 없어요. 사적인 원망 같은 것도 담겨있지 않구요. 그냥 그뿐이예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506020/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":1},{"클뜯 id":506021,"클뜯 함순이 id":50602,"함순이 이름":"화지아","한글 함순이 + 스킨 이름":"강시 함선의 봄날 밤","영문 함순이 + 스킨 이름":"The Festive Undead","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506021/shipyard.png","설명":"강시 화지아예요. 모쪼록 잘 부탁드… 어머, 지휘관님. 왜 그러시죠? 다들 평소와는 다른 모습을 하고 있길래, 저도 옷을 갈아입고 온 건데…… 좀 이상한가요?","자기소개":null,"메인1":{"voiceline":"원앙훠궈'는 이름 그대로 커플을 위한 전골……이라는 건 농담입니다. 사실은 취향이 다른 사람들을 위한 반쪽으로 나뉜 냄비랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/main1.ogg"},"메인2":{"voiceline":"하이티엔이 굉장히 매운 빠오즈를 만들었다던데…… 으으, 그 빠오즈에 표시가 되어 있길 바랄 수밖에요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/main2.ogg"},"메인3":{"voiceline":"영화 속에서 강시는 분명 뛰면서 이동했었죠. 그러니까 이렇게, 팔짝팔짝! 음, 이거… 좀 이상한 느낌인데요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"어머? 의상이 좀 지나치게 대담했나요? 그래도 다른 동료들이랑 비교했을 때 튀지 않을 정도로 고른 건데……. 게다가 가끔은 색다른 느낌을 내는 것도 좋지 않을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/detail.ogg"},"드랍 설명":{"voiceline":"강시 화지아예요. 모쪼록 잘 부탁드… 어머, 지휘관님. 왜 그러시죠? 다들 평소와는 다른 모습을 하고 있길래, 저도 옷을 갈아입고 온 건데…… 좀 이상한가요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"얍! ……지휘관님을 놀라게 해드리지 못했네요…. 다음엔 푸슌 네처럼 손전등이라도 준비하는 편이 좋으려나요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요. 동료들이랑 만나서 같이 재밌는 거라도 찾으러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"진짜 강시는 아니라서 손을 차갑게 할 순 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/touch.ogg"},"터치2":{"voiceline":"부적을 떼면 벌 받으실 텐데요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/touch2.ogg"},"입수시":{"voiceline":"강시 화지아예요. 모쪼록 잘 부탁드… 어머, 지휘관님. 왜 그러시죠? 다들 평소와는 다른 모습을 하고 있길래, 저도 옷을 갈아입고 온 건데…… 좀 이상한가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506021/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70807,"상점 카테고리 id":3,"스킨 태그":"특수배경 (움짤), 쁘띠모션","입수 영상":"X","재화":900,"기간":"상시","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":506029,"클뜯 함순이 id":50602,"함순이 이름":"화지아","한글 함순이 + 스킨 이름":"화지아·改","영문 함순이 + 스킨 이름":"Hwah Jah (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506029/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506029/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506029/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506029/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506029/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/506029/shipyard.png","설명":"자, 지휘관님. 잘 보세요. 이것이 바로 개조를 마친 화지아랍니다. 음… 새로운 모습에 놀라셨나요? 걱정하지 마세요. 저는 변함없이 언제나 당신의 화지아니까요~ ……굳이 변한 점을 들자면, 즐거움에 더욱 솔직해진 정도려나요♪","자기소개":null,"메인1":{"voiceline":"아, 그렇지. 지휘관님. 찻집을 차릴 기회가 있으면, 꼭 불을 이용한 공연을 해보고 싶어요. 그러면 손님들도 많이 모이겠죠? …네? 그러면 분위기가 엉망이 될 거라고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/main1.ogg"},"메인2":{"voiceline":"예의 있게 대하고, 성심을 다해 논하는… 화지아의 스타일은 변함이 없어요. 말이 통하지 않더라도, 지금의 저는 얌전히 제 말을 듣게 할 힘을 가지고 있으니까요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/main2.ogg"},"메인3":{"voiceline":"매운 훠궈…말씀인가요? 아하하하… 계속 새로운 것에 도전하는 저도 그건…… 좀 어려울 것 같네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"그러고 보니 요즘, 파티를 열면 즐겁다는 걸 알았답니다. 모두 모여 기상천외한 아이디어나 의견을 잔뜩 교환할 수 있어서 꽤 신선한 느낌이에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/detail.ogg"},"드랍 설명":{"voiceline":"자, 지휘관님. 잘 보세요. 이것이 바로 개조를 마친 화지아랍니다. 음… 새로운 모습에 놀라셨나요? 걱정하지 마세요. 저는 변함없이 언제나 당신의 화지아니까요~ ……굳이 변한 점을 들자면, 즐거움에 더욱 솔직해진 정도려나요♪","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아왔다고요? 저도 모두의 노고를 달랠 준비를 마친 참입니다. 완벽한 타이밍이죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"조금 달려졌다고는 해도, 지휘관님은 분명 지금의 화지아도 마음에 들어 하시겠죠? 우후후… 왜냐하면 이렇게 변한 건 모두… 지휘관님의 「가르침」 덕분이니까요♪ 네, 앞으로도 책임지고 저를 돌봐주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/feeling5.ogg"},"터치3":{"voiceline":"어머… 혹시 저… 요즘 너무 얌전하지 않나요? 후후후, 농담입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 돌아오셨나요? 마침 재밌을 것 같은 곳을 발견했는데… 괜찮으시면 화지아와 함께 가보시지 않으실래요? 기분도 전환할 겸, 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님. 업무가 중요하다는 것은 잘 알지만, 가끔은 설레고 두근거리는… 즐거운 걸 해보지 않을래요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/login.ogg"},"실패":null,"우편":{"voiceline":"새로운 우편이 도착했어요. 관례적인 사무 연락이 아니라, 즐거운 행사의 초대장이면 좋겠는데… 지휘관님, 같이 확인할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/mail.ogg"},"임무":{"voiceline":"또 즐거운 임무라도 있었나요? 평소처럼 도울 수 있게 해주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/mission.ogg"},"임무완료":{"voiceline":"어머? 임무가 끝났나요? 후후후, 만약 다음 일정이 없으면, 제가 좋은 제안을 하나 드려도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"음…? 일은 제쳐두고 밖으로 나가고 싶어지셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/touch.ogg"},"터치2":{"voiceline":"음? 설마… 저를… 떠보시는 건가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/touch2.ogg"},"입수시":{"voiceline":"자, 지휘관님. 잘 보세요. 이것이 바로 개조를 마친 화지아랍니다. 음… 새로운 모습에 놀라셨나요? 걱정하지 마세요. 저는 변함없이 언제나 당신의 화지아니까요~ ……굳이 변한 점을 들자면, 즐거움에 더욱 솔직해진 정도려나요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/506029/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"개조","상점 id":0,"상점 카테고리 id":9