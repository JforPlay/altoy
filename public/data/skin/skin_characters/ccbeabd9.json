[{"클뜯 id":304020,"클뜯 함순이 id":30402,"함순이 이름":"히에이","한글 함순이 + 스킨 이름":"히에이","영문 함순이 + 스킨 이름":"Hiei","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/304020/shipyard.png","설명":"콘고급 고속전함 2번함 - 히에이","자기소개":{"voiceline":"해가 뜨는 나라에서 건조된 첫 콘고급 전함, 히에이라고 합니다. 의전함으로써 함대를 사열하고, 함대를 이끌어 솔로몬 전투에 참가했었죠. 지휘관님, 준비는 되셨는지요? 연회가 곧 시작된답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/profile.ogg"},"메인1":{"voiceline":"하아……키리시마가 연회에 참가하기만 하면, 따라온 아이들 때문에 엉망진창이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/main1.ogg"},"메인2":{"voiceline":"싸움에 있어 지혜도 용기만큼 중요합니다. 계책을 버리고 용기에만 기대는 승리는 두 번 다신 없을 거에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/main2.ogg"},"메인3":{"voiceline":"어떤 상황에서도 지휘관님을 지켜내겠어요. 후후, 그게 가능하니까 '의전함' 인걸요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/main3.ogg"},"전투개시":{"voiceline":"후후, 의전의 여흥으로 상대 해 드리도록 할까요","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/battle.ogg"},"상세확인":{"voiceline":"후후, 말차와 홍차…어느 쪽이 더 좋으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/detail.ogg"},"드랍 설명":{"voiceline":"콘고급 고속전함 2번함 - 히에이","voicelink":null},"의뢰 완료":{"voiceline":"다들 어서 오세요. 이상한 사람이랑 마주치진 않았죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/expedition.ogg"},"실망":{"voiceline":"정말 유감이군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/feeling1.ogg"},"낯섦":{"voiceline":"우후후, 지휘관님, 뭔가 고민거리라도 있으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/feeling2.ogg"},"호감":{"voiceline":"키리시마……정말 인기가 많네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/feeling3.ogg"},"기쁨":{"voiceline":"연회에서 모두의 웃는 얼굴을 보고 있으면, 준비하느라 지쳤던 게 싹 가신답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 오늘 밤은 연회가 끝난 뒤……시간을 내주실 수 있을까요? 우후후, 네, 아무쪼록 기대해주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 오십시오. 마침 차가 데워진 참이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/home.ogg"},"hp 경고":{"voiceline":"지휘관님……아직은 포기할 때가 아닙니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/hp_warning.ogg"},"로그인":{"voiceline":"전투 후의 연회야 말로 제일 마음이 편안해지죠……그건 그렇고 지휘관님, 저…이 다음 일정은 비어있답니다…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/login.ogg"},"실패":{"voiceline":"당해버린 걸까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/lose.ogg"},"우편":{"voiceline":"전부 새로운 편지인가요? 고생이 많으십니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/mail.ogg"},"임무":{"voiceline":"힘이 남아 있을 때 한 번에 처리하자고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/mission.ogg"},"임무완료":{"voiceline":"후후, 축하의 의미로 오늘 밤은 연회를 열어 볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/304020/mission_complete.ogg"},"서약":{"voiceline":"이건…… '앞으로는 계속 함께' 라는 의미인가요? 고맙습니다. 