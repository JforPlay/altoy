ando2603/AzurLane/main/audio/voiceline/201020/feeling1.ogg"},"낯섦":{"voiceline":"의욕이 나질 않네… 잠이라도 잘까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/feeling2.ogg"},"호감":{"voiceline":"잠자기 딱 좋은 곳을 알고 있어… 지휘관도 함께 땡땡이쳐보는 건 어떨까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관…잘 생각해봐. 나와 함께 있으면 재미없을 걸…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/feeling4.ogg"},"사랑":{"voiceline":"나는 그다지 말을 많이 하진 않지만… 그래도 우리들, 이젠 말을 주고받지 않아도 서로를 이해할 수 있어… 그렇지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 와, 흐아암… (하품) 좀 졸린 걸까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"음냐음냐… 아, 지휘관, 어서 와.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/login.ogg"},"실패":{"voiceline":"이 정도 결과로는 기분이 좋지 않으려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/lose.ogg"},"우편":{"voiceline":"우편…지휘관 앞으로 온 거려나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/mail.ogg"},"임무":{"voiceline":"미션 로그도 확인하는 게 좋을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/mission.ogg"},"임무완료":{"voiceline":"하암, 보너스가 도착한 걸까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/mission_complete.ogg"},"서약":{"voiceline":"…미안… 너무 기뻐서 지금 무슨 말을 해야 할지 모르겠어… 소중하게 여길게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/propose.ogg"},"스킬":{"voiceline":"조금 노력해 볼까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201020/skill.ogg"},"터치1":