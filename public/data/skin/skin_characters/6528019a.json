[{"클뜯 id":101420,"클뜯 함순이 id":10142,"함순이 이름":"스몰리","한글 함순이 + 스킨 이름":"스몰리","영문 함순이 + 스킨 이름":"Smalley","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101420/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101420/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101420/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101420/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101420/shipyard.png","설명":"스몰리, 구축함, 취미는 킥복싱, 착임.","자기소개":{"voiceline":"난 스몰리야, 플레처급의 스몰리. 함력은 별로 얘기할만한 게 없어. 전에 멀리에서 거물을 한번 본 것 말고는. 하지만 전투 후에 일을 좀 했지... 취미는 내가 다시 말 안 해도 되겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/profile.ogg"},"메인1":{"voiceline":"지휘관, 내가 운동을 알려줄 수 있어. 앉아서 할 수 있는 그런 거. 운동이 너무 부족하면 건강에 안 좋거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/main1.ogg"},"메인2":{"voiceline":"자유 격투에서 중요하게 여기는 건 조금도 거리낄 것이 없는 거야. 어떤 부위도 무기가 될 수 있지. 비록... 해전에서 사용하지 못하긴 하지만. 그래서 그냥 취미인 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/main2.ogg"},"메인3":{"voiceline":"기회가 되면 전함급 언니들과 겨루어보고 싶어. 언니 중에... 세 보이는 사람이 꽤 많거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/main3.ogg"},"전투개시":{"voiceline":"일단 준비 운동 먼저 하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/battle.ogg"},"상세확인":{"voiceline":"볼티모어 씨? ...... 아, 지휘관인가...... 미안, 방금 단련하느라 몰랐어. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함—스몰리, 현호 DD-565","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 완료했어? 지휘관, 누가 먼저 항구에 도착하나 시합할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/expedition.ogg"},"실망":{"voiceline":"아, 넌 계속 집에 있어. 난 운동하러 갈게, 안녕.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 같이 운동하러 갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/feeling2.ogg"},"호감":{"voiceline":"지휘관, 다음에 쉬는 날 같이 운동용품 사러 가는 거 어때? 좋은 장비가 보조해주면 효과가 더 좋거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 역시 너도 아는 거지? 운동으로 자신이 조금씩 바뀌는 걸 보는 그런 성취감, 헤헷, 우리 정말 잘 맞는다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/feeling4.ogg"},"사랑":{"voiceline":"역시 두 사람이 서로 재촉하고 도와주니까 혼자 할 때보다 훨씬 재미있다... 지휘관, 우리 함께 최고를 향해 달리자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수건 줄게 땀 닦아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/home.ogg"},"hp 경고":{"voiceline":"운동 부족이야...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 사무실에서 훈련해도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/login.ogg"},"실패":{"voiceline":"여기 공기가 좀 별로다...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/lose.ogg"},"우편":{"voiceline":"새로운 우편이 있다고? 내가 가져올게. 10초, 아니, 8초면 충분해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/mail.ogg"},"임무":{"voiceline":"임무로 자신의 능력을 인증하는 거야? 마음에 들어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/mission.ogg"},"임무완료":{"voiceline":"난 보상보다 임무로 자신을 증명하는 느낌을 더 좋아해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/mission_complete.ogg"},"서약":{"voiceline":"안심해, 지휘관. 난 운동만 아는 멍청이는 아니니까. 이렇게 오래 함께 열심히 했으니 네가 무슨 생각하는지 나도 알아. 다만, 그게... 어떻게 반응해야 할지 모르겠어... 그러니까, 내 말은... 나도 좋아...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/propose.ogg"},"스킬":{"voiceline":"너희는 피할 수 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/skill.ogg"},"터치1":{"voiceline":"지휘관, 너도 자유 격투를 배워봐. 스스로 지킬 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/touch.ogg"},"터치2":{"voiceline":"내... 돌려차기를 받아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/touch2.ogg"},"입수시":{"voiceline":"스몰리, 구축함, 취미는 킥복싱, 착임.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/unlock.ogg"},"강화성공":{"voiceline":"고마워, 몸이 좀 가벼워진 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후, 상태 괜찮네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['플레처'] : 언니, 제가 지켜줄게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101420/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":101421,"클뜯 함순이 id