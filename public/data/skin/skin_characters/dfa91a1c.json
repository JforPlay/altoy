[{"클뜯 id":701050,"클뜯 함순이 id":70105,"함순이 이름":"타슈켄트(μ장비)","한글 함순이 + 스킨 이름":"타슈켄트(μ장비)","영문 함순이 + 스킨 이름":"Tashkent μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701050/shipyard.png","설명":"동지쨩, 이 옷차림 어때? …아 그래, 타슈켄트가 아이돌이 되었다는데 반응이 겨우 이 정도야? 흥, 콘서트 때 반드시 \"와우\"하고 놀라게 해줄테다.","자기소개":{"voiceline":"나는 노스 유니온의 구축함, 지금은 μ장비 테스트 임무를 진행 중인 아이돌 타슈켄트야. 동지쨩, 노스 유니온의 저력을 볼 준비는 됐겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/profile.ogg"},"메인1":{"voiceline":"다른 참가자들은 다 악기를 다룬다고? …아 그래, 어떤 상대를 만나더라도 우리는 절대 지지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/main1.ogg"},"메인2":{"voiceline":"의상에 춤까지 모두 완벽하다니… 알바코어는 정말 대단해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/main2.ogg"},"메인3":{"voiceline":"안무 맞추는 건 정말 어려워… 노래는 들으면 어떤 상황인지 알겠는데, 춤은 계속 다른 사람을 쳐다봐야 하잖아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/main3.ogg"},"전투개시":{"voiceline":"시작한다! Ура!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/battle.ogg"},"상세확인":{"voiceline":"타슈켄트는 춤도 잘 추고 노래도 남들보다 잘 해… 동지쨩, 아직도 마음이 안 놓여? ……아 그래, 진짜 걱정이 많네. 타슈켄트는 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/detail.ogg"},"드랍 설명":{"voiceline":"동지쨩, 이 옷차림 어때? …아 그래, 타슈켄트가 아이돌이 되었다는데 반응이 겨우 이 정도야? 흥, 콘서트 때 반드시 \"와우\"하고 놀라게 해줄테다.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료야. 아이돌이라고 하더라도 평소 업무를 게을리 하면 안 되지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/expedition.ogg"},"실망":{"voiceline":"타슈켄트 혼자서도 할 수 있어. …동지쨩의 도움은 필요하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/feeling1.ogg"},"낯섦":{"voiceline":"타슈켄트의 아이돌 모습이 기대된다고? …아 그래, 장비 테스트를 하려고 했으니 조금 기합을 넣는 것도 좋겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/feeling2.ogg"},"호감":{"voiceline":"동지쨩, 타슈켄트가 모두와 팀 활동을 하는 게 걱정돼? 흥, 걱정 마. 노스 유니온의 일원은 단체 퍼포먼스에 익숙하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/feeling3.ogg"},"기쁨":{"voiceline":"모두와 호흡을 맞추면서 개성을 드러내는 건 어려운 일이야… 동지쨩도 그런 걱정을 한 적이 있었으나… 타슈켄트도… 아, 동지쨩? 타슈켄트를 도와서 방법을 생각해줄 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/feeling4.ogg"},"사랑":{"voiceline":"동지쨩, 지금 타슈켄트가 어때 보여? ……아, 그래. 봐, 모두와 함께 레슨 받고 무대에 오르고… 이제 동지쨩도 타슈켄트를 걱정하지 않아도 돼. 흐흥♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/feeling5.ogg"},"터치3":{"voiceline":"타슈켄트를 애 취급 하는 거야? 흥.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/headtouch.ogg"},"모항귀환":{"voiceline":"커피와 홍차, 초콜릿 우유, 주스와 보드카… 다녀온 동료들에게 줄 것은 다 여기에 있어… 동지쨩, 뭐 마실래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/home.ogg"},"hp 경고":{"voiceline":"동지쨩이 아직 보고 있어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/hp_warning.ogg"},"로그인":{"voiceline":"타슈켄트의 오늘 스케쥴은 맡겨둘게, 동지쨩.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/login.ogg"},"실패":{"voiceline":"호흡이 안 맞았나? 왜 이렇게 된거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/lose.ogg"},"우편":{"voiceline":"일과 관련된 편지가 왔어. 동지쨩, 볼티모어 일행에게 보여주기 전에 먼저 타슈켄트와 함께 확인하자?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/mail.ogg"},"임무":{"voiceline":"동지쨩, 임무가 있어. 어서 해치우자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/mission.ogg"},"임무완료":{"voiceline":"임무 완료야, 잘 했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/mission_complete.ogg"},"서약":{"voiceline":"흐흥, 동지쨩은 역시 너무 순진하네. 모두와 함께 무대위에서 빛나는 것만으로는 안 돼. 타슈켄트는 그 중에서 가장 빛나는 스타가 되기 위해서 노력할 거야. 그러니까 동지쨩, 계속, 계속 타슈켄트를 바라봐줘♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/propose.ogg"},"스킬":{"voiceline":"눈 뗄 생각 하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/skill.ogg"},"터치1":{"voiceline":"초콜릿 줄 거야? …아 그래, 선물 고마워, 동지쨩.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/touch.ogg"},"터치2":{"voiceline":"동, 동지쨩?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/touch2.ogg"},"입수시":{"voiceline":"동지쨩, 이 옷차림 어때? …아 그래, 타슈켄트가 아이돌이 되었다는데 반응이 겨우 이 정도야? 흥, 콘서트 때 반드시 \"와우\"하고 놀라게 해줄테다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/unlock.ogg"},"강화성공":{"voiceline":"아무래도 열심히 하는 수밖에 없겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이건 μ장비뿐 아니라 타슈켄트의 승리기도 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex"