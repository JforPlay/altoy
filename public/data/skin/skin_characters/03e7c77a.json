[{"클뜯 id":102140,"클뜯 함순이 id":10214,"함순이 이름":"몬트필리어","한글 함순이 + 스킨 이름":"몬트필리어","영문 함순이 + 스킨 이름":"Montpelier","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102140/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102140/shipyard.png","설명":"클리블랜드급 경순양함 몬트필리어 (CL-57) ","자기소개":{"voiceline":"너 말이야, 클리블랜드급은 그 대전에서 이글 유니온의 최강 경순양함이었다고, 그러니 우리 언니에겐 더욱 경의를 표하도록. ……나 말이야? 렌넬이랑 오거스타 만 외에도 몇 번 작전에 투입됐었다. 이 정도야 보통이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/profile.ogg"},"메인1":{"voiceline":"어떻게 해야 클리블랜드 언니처럼 될 수 있을까…… 웃어 보라고? ……그건 좀 무리일 지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/main1.ogg"},"메인2":{"voiceline":"동형함 자매들 말고 다른 사람들은 좀 껄끄러워. 지휘관, 너에 대해선…… 노력할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/main2.ogg"},"메인3":{"voiceline":"지휘관, 난 궁금해. 언니가 비서함으로 일할 때는 어떤 느낌인지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/main3.ogg"},"전투개시":{"voiceline":"해상기사단, 진군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/battle.ogg"},"상세확인":{"voiceline":"언니이~! …가 아니라 지휘관이었네. 무슨 일이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/detail.ogg"},"드랍 설명":{"voiceline":"클리블랜드급 경순양함 몬트필리어 (CL-57)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어. 의뢰하러 나간 애들을 마중하러 가지 않을 텐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/expedition.ogg"},"실망":{"voiceline":"언니도 사람 보는 눈이 없나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/feeling1.ogg"},"낯섦":{"voiceline":"언니가 널 선택한 이유는 모른다. 하지만 난 언니의 눈을 믿어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/feeling2.ogg"},"호감":{"voiceline":"언니는… 강하고 멋지고, 미소가 눈부시고, 그야말로 어떤 상대라도 쓰러트릴 수 있을 것만 같은…… 나도 언젠가, 그렇게 되고 싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/feeling3.ogg"},"기쁨":{"voiceline":"지휘관이라는 건, 안전한 장소에서 잘난 듯이 명령만 내릴 뿐이라 생각했어…… 실제로 가까이서 보니, 이제야 알겠어. 지휘관도 힘든 거구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/feeling4.ogg"},"사랑":{"voiceline":"언니 말이라고 무턱대고 뭐든 다 듣는 건 아니야. 언니의 말은 늘 옳으니까, 언니의 말을 들을 뿐…… 이제 알겠어. 언니가 선택한 넌 역시 우수해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어. 좀 쉬지 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/home.ogg"},"hp 경고":{"voiceline":"언니가 그랬어… 포기해선 안 된다고!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/hp_warning.ogg"},"로그인":{"voiceline":"왔어? 그럼 난 나갔다 올게. 여긴 너무 따분해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/login.ogg"},"실패":{"voiceline":"언니… 미안해… 해상기사단의 이름에 먹칠을 하고 말았어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/lose.ogg"},"우편":{"voiceline":"우편, 여기 뒀어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/mail.ogg"},"임무":{"voiceline":"지휘관, 임무다. 시간은 금이야… 빨리 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/mission.ogg"},"임무완료":{"voiceline":"보상이라…… 이것도 임무니까. 가지고 올게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/mission_complete.ogg"},"서약":{"voiceline":"언니는 자신의 마음을 따르라고 했어. 그래서 난 여기에 있지……자신의 마음을 따라서. 지휘관, 넌 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/propose.ogg"},"스킬":{"voiceline":"눈에 거슬린다. 사라져.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/skill.ogg"},"터치1":{"voiceline":"……? 볼일이 없으면 부르지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/touch.ogg"},"터치2":{"voiceline":"버, 버텨내야 해……이건 언니에 대한 믿음을 시험하는 게 분명하다고…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/touch2.ogg"},"입수시":{"voiceline":"지휘관인가? 믿음직스럽지… 않아 보이는군. 하지만 언니가 여기에 있으니… 어쩔 수 없지. 몬트필리어, 착임하겠어. 지시 같은 건 하지 않아도 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/unlock.ogg"},"강화성공":{"voiceline":"언니에 조금 더 가까워졌어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리하는 느낌…… 나쁘지 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['클리블랜드'] : ……언니에게 수치를 주진 않겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/couple_encourage1.ogg"},{"voiceline":"['센다이', '묘코', '시구레'] : 야전이라면 나도 할 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/couple_encourage2.ogg"},{"voiceline":"['덴버'] : 언니에게 부끄럽지 않은 전사가 되어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102140/couple_encourage3.