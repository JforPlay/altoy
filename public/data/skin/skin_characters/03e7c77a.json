 새해를 맞는 것도 나쁘지 않을지도. …역시 이 차림으로 댄스를? 하아……아직 좀 어색하지만, 언니한테 보여주기 전의 리허설이라 생각하고 보여줄까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102141/feeling5.ogg"},"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":null,"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"……이런 차림으로 댄스를? 여전히 말도 안되는 생각만 하고 있네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102141/touch.ogg"},"터치2":{"voiceline":"다들 새해 준비로 바쁜데, 네 머릿속에 든 건 이런 거냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102141/touch2.ogg"},"입수시":{"voiceline":"이것이 사쿠라 엠파이어 스타일의 새해 의상… 언니, 마음에 들려나…… 응? 지휘관, 있었어? 음, 그래, 새해 복 많이 받아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102141/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"정월","상점 id":70137,"상점 카테고리 id":2,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":102142,"클뜯 함순이 id":10214,"함순이 이름":"몬트필리어","한글 함순이 + 스킨 이름":"마경의 프린세스？","영문 함순이 + 스킨 이름":"Persephone's Throne","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102142/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102142/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102142/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102142/