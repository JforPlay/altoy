ubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/main1.ogg"},"메인2":{"voiceline":"응? 방금 마신 건 술인가……? 열기 때문에 어지러워서 그런가…… 잘 모르겠더군…… 하아, 어떻게 된 거지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/main2.ogg"},"메인3":{"voiceline":"앗… 아직…… 몸이 뜨겁군… 지휘관, 뭐라도…열을 식힐 방법을 좀……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관…… 언니들은 온천에 들어간 후에도 멀쩡한데, 왜 나만 비틀거리는 거지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/detail.ogg"},"드랍 설명":{"voiceline":"하아…… 너무 더워… 물맛도 이상하고…… 지휘관? 너도 목욕하고 온 건가? 그럼 같이 쉬다가…… 어라… 왠지 묘하게 몸이 달아오르는 것 같은데……","voicelink":null},"의뢰 완료":{"voiceline":"시간은 금…… 어서 동료들을… 마중하러 다녀와…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관… 으으… 뜨거워서 잘 수가 없어…… 열기가 식질 않는군…… 아, 아니, 딱히 너 때문은 아니지…만… 잠깐 열을 식히는 걸… 도와주지 않겠나…？","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/feeling5.ogg"},"터치3":{"voiceline":"으음… 의외로… 마음이 놓여… 쿨쿨……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/headtouch.ogg"},"모항귀환":{"voiceline":"다녀왔어? 왠지 머리가 어질어질하는군…… 왜 그렇게 갖춰 입고 있는 거지? 보고 있기만 해도 숨막힐 듯 덥군…… 갈아 입는 걸 도와줄 테니까 어서 이쪽으로……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관……그렇게 껴입으면 안 더워? 음……더운 건 몬트필리어뿐이라고? 그럴리가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/login.ogg"},"실패":null,"우편":{"voiceline":"우편은…… 저기에 뒀어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102143/mail.ogg"},"임무":{"voiceline":"임무인가? 목욕하자마자 바로… 아니, 오히려 지금이라면 효율적으로… 처리할 수 있을지도……","voicelink":"https://raw.githubusercont