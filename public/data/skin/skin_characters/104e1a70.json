ndo2603/AzurLane/main/audio/voiceline/101120/feeling1.ogg"},"낯섦":{"voiceline":"지휘관한테는 아무리 장난을 걸어도 얼빠진 표정만 지으니까… 재미 없다구─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/feeling2.ogg"},"호감":{"voiceline":"지휘관 말야, 내가 항상 장난치고 싶어져 버리는데… 그러면, 날 싫어하게 되지는 않을까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/feeling3.ogg"},"기쁨":{"voiceline":"내가 '지휘관을 좋아해'라는 말을 하면, 지휘관은 어떤 반응을 보여줄까? 헤헤, 농담이야~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 눈을 감아─ …쪽♡ 흐흐흐, 내가 뽀뽀한 것 같다고? …정답이야─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고했어~ 대처가 스트레스 좀 풀어줄까~? 괜찮아, 장난치는 거 아니래도~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 오늘은 모두에게 어떤 식으로 장난을 쳐볼까? 히히힛.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/login.ogg"},"실패":{"voiceline":"으으─, 장난치지 못했어~ 아, 스펜스, 저리 비켜! 부, 부딪쳐버린다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/lose.ogg"},"우편":{"voiceline":"새로운 편지가 왔어! 수, 숨기거나 하진 않으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/mail.ogg"},"임무":{"voiceline":"에헤헤, 게임은 아직 끝나지 않았어! 땡땡이치면 안 돼☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/mission.ogg"},"임무완료":{"voiceline":"보너스가 필요 없다면, 대처가 대신 받을래~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/mission_complete.ogg"},"서약":{"voiceline":"말해두겠지만, 대처가 '이제 장난 같은 건 그만뒀다'고 생각하면 큰 오산이라구? 이것도 사랑의 한 형태인걸. 그러니까~ 앞으로도 잘·부·탁·해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101120/prop