on.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302212/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302212/shipyard.png","설명":"지휘관님, 거기 멍하니 서서 뭐하는 거예요? 당신도 기분 전환하러 여기 온 거죠? 우린 둘 다 이곳의 풍경에 놀라진 않을 것 같네요.","자기소개":null,"메인1":{"voiceline":"와앗!? ... 정말 죄송해요. 하마터면 떨어질 뻔했네요... 자, 잡아줘서 고마워요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/main1.ogg"},"메인2":{"voiceline":"이곳 분위기가 정말 괜찮네요. 또 좋은 점을 꼽자면, 아가노에게 희롱당할 일은 없겠어요... 그녀가 절 걱정하지 않고 있는게 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/main2.ogg"},"메인3":{"voiceline":"이곳 세트도 아주 규모가 크네요. 음, 저는 아주 예쁘다고 생각하는데... 이곳을 보고 있으면, 일순간 심지어 자신이 모항에 있다는 것조차 잊게 돼요. 그러고보니까, 지휘관도 막 왔을 때 멍하니 있었죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/main3.ogg"},"전투개시":{"voiceline":"얼어 붙어라.... 당신들의 시간은 여기까지입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/battle.ogg"},"상세확인":{"voiceline":"걱정은 필요 없어요. 준비와 인사 등 연회에서 해야할 일은 모두 다했어요. 앞으로는 천천히 경치를 감상하시면 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 거기 멍하니 서서 뭐하는 거예요? 당신도 기분 전환하러 여기 온 거죠? 우린 둘 다 이곳의 풍경에 놀라진 않을 것 같네요.","voicelink":null},"의뢰 완료":{"voiceline":"여긴 의외로 모항과 아주 가깝네요. 의뢰조 사람들을 맞이해주러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이 세트는... 대체 어떤 장소의 분위기를 표현하고 싶은 걸까요...? 새장, 까마귀, 바다, 푸른 장미... 그리고, 제 곁으로 온 당신...... 저기, 방금 이런... 느낌도 괜찮네요... 지휘관님도 그렇게 생각하나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"충분히 쉬셨다면 같이 연회회장에 가서 얼굴을 비출까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"후... 됐다, 다음부터 조심해. 또 새장을 건드리면 안돼...... 전 방금 이 아이들을 돌봐주고 있었어요, 지휘관님은요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"혹시 아가노도 이곳을 좋아할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/touch.ogg"},"터치2":{"voiceline":"그...... 이렇게 제가... 안마를 해드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 거기 멍하니 서서 뭐하는 거예요? 당신도 기분 전환하러 여기 온 거죠? 우린 둘 다 이곳의 풍경에 놀라진 않을 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"냉정한 전투 지휘 앞에서——당신들의 저항은 무의미해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302212/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70422,"상점 카테고리 id":7,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":900,"기간":"상시","진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":302213,"클뜯 함순이 id":30221,"함순이 이름":"노시로","한글 함순이 + 스킨 이름":"겨울눈의 훈향","영문 함순이 + 스킨 이름":"Fragrance of the Eastern Snow","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302213/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302213/painting_n.png","sd 일