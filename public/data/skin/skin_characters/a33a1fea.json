[{"클뜯 id":302210,"클뜯 함순이 id":30221,"함순이 이름":"노시로","한글 함순이 + 스킨 이름":"노시로","영문 함순이 + 스킨 이름":"Noshiro","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302210/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302210/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302210/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302210/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302210/shipyard.png","설명":"아가노급 경순양함 2번함——노시로 ","자기소개":{"voiceline":"언니의 말 대로 우리는 때를 잘못 타고 태어났을 수 있어요. 하지만 신예 아가노급의 일원으로서 저에게 실력을 발휘할 환경만 만들어 주신다면, 절대로 당신을 실망시키지 않을 거랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/profile.ogg"},"메인1":{"voiceline":"음, 내일 세끼를 뭘 먹을지 먼저 계획해 볼까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/main1.ogg"},"메인2":{"voiceline":"합리적으로 분류하고 정리하면 필요한 자료를 찾는 시간을 줄일 수 있어요. 당신도 책상 정리를 해보는 건 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/main2.ogg"},"메인3":{"voiceline":"아가노 언니는 항상 웃고 있지만… 언니가 무슨 생각을 하는지 읽을 수가 없어서, 결국은 농락당하기만 하네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/main3.ogg"},"전투개시":{"voiceline":"작전 계획을 다시 한 번 확인해 보죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/battle.ogg"},"상세확인":{"voiceline":"어떤 상황이라도 냉정하게 생각하면 문제를 해결할 수 있다, 이게 제 철칙이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/detail.ogg"},"드랍 설명":{"voiceline":"아가노급 경순양함 2번함——노시로 ","voicelink":null},"의뢰 완료":{"voiceline":"다음 의뢰조를 파견할 시간이군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/expedition.ogg"},"실망":{"voiceline":"꽤나 조급한 것 같네요. 냉정하게 자신의 행동에 대해 반성해보는 건?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/feeling1.ogg"},"낯섦":{"voiceline":"훈련에 대해 생각하고 있었어요. 당신도 해야할 일을 하지 그래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/feeling2.ogg"},"호감":{"voiceline":"아가노 언니가 함께 훈련을 하자고 했지만… 음… 또 놀리려고 하는 것 같은데… 하지만 거절하기에는 마땅한 이유가 없고… 그래요. 그 시간에 저에게 당신이 일을 맡겨주면 되겠네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/feeling3.ogg"},"기쁨":{"voiceline":"그러고 보니, ‘여자의 직감’이 뭐죠? 동료들이 이야기하는 것을 듣고 궁금해서 물어본 건데…… 당신도 잘 모르는 건가요? 미안해요. 곤란하게 했군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/feeling4.ogg"},"사랑":{"voiceline":"이게 바로 ‘두근거림’이라는 건가요… 저는 ‘직감’보다는 이성적인 사고방식에 익숙해져 있기에, 이런 기분은 혼란스럽네요… 하지만 이해했어요. 제 마음도, 그리고 당신의 마음도.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"음……응? 아, 죄송해요. 생각 중이라서. 돌아오셨군요. 그렇다면 이번 출격의 결과에 대해 피드백 해볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/home.ogg"},"hp 경고":{"voiceline":"적의 함정인가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/hp_warning.ogg"},"로그인":{"voiceline":"어머나, 일찍 오셨네요. 그렇다면 오늘의 계획을 먼저 생각해보는 건 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/login.ogg"},"실패":{"voiceline":"물러날 수밖에 없네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/lose.ogg"},"우편":{"voiceline":"우편? 제가 확인하죠. 이상한 내용은 없겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/mail.ogg"},"임무":{"voiceline":"임무가 많으면 먼저 중요한 순서대로 나눠보지 그래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/mission.ogg"},"임무완료":{"voiceline":"임무 보상을 받았어요. 혹시나 빠진 것이 없는지 한번 확인해보죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/mission_complete.ogg"},"서약":{"voiceline":"마음을 받아들였으니 그에 맞는 보답을 해야겠죠. 그 뒤는…… 데이트, 도시락 싸기, 감정 교류. 하지만 훈련도 게을리 할 수 없고 비서함 업무도…… 아, 죄송해요. 잠시 멍하게 있었네요. 계, 계속 하나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/propose.ogg"},"스킬":{"voiceline":"바로 지금!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/skill.ogg"},"터치1":{"voiceline":"문제가 생기면 먼저 냉정하게 생각해보는 건 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/touch.ogg"},"터치2":{"voiceline":"방, 방금 전 행동에 대해서 검토가 필요해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/touch2.ogg"},"입수시":{"voiceline":"아가노급 2번함, 노시로 , 오늘부로 함대에 착임했답니다. 함께 노력해 서로에게 자신의 능력을 증명해보도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/unlock.ogg"},"강화성공":{"voiceline":"전력 향상은 당신에게 맡기겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/upgrade.ogg"},"vote":null,"승리":{"voiceline":"냉정한 생각과 정확한 판단으로 도출해낸 결과는, 당연히 승리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아가노'] : 언니, 또 다치지 않게 조심하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/couple_encourage1.ogg"},{"voiceline":"['호넷', '와스프'] : 음… 너무 가, 가까이 오지 말아줄래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302210/couple_encourage2