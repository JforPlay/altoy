zurLane/main/audio/voiceline/103100/feeling1.ogg"},"낯섦":{"voiceline":"퀸시 언니는 계속 남들 도와주느라 바빠서 나랑 같이 멍 때릴 시간도 없는 것 같네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/feeling2.ogg"},"호감":{"voiceline":"지휘관은……누구에게나 다 상냥하네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/feeling3.ogg"},"기쁨":{"voiceline":"누구에게라도 다 이러는 거야? 그치만 날 보면, 지휘관 엄청 상냥한 얼굴 하는 걸……왜 그러는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/feeling4.ogg"},"사랑":{"voiceline":"구름과 바다를 보는 것 보다, 지금은 지휘관을 보는 게 더 좋아졌어……지휘관의 미소, 걱정하는 모습, 기뻐하는 모습, 다 너무 재밌는 걸……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 와, 지휘관. 오늘 구름은 보기 드문 모양이네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/home.ogg"},"hp 경고":{"voiceline":"아, 아직 싸울 수 있어! 아마도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/hp_warning.ogg"},"로그인":{"voiceline":"지휘관의 자는 얼굴, 귀여워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/login.ogg"},"실패":{"voiceline":"지휘관, 도망갈 준비해야겠어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/lose.ogg"},"우편":{"voiceline":"새 우편이 왔네……너무 머네, 가지러 가기 싫어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/mail.ogg"},"임무":{"voiceline":"임무……꼭 다 해야 하는 건 아니잖아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/mission.ogg"},"임무완료":{"voiceline":"지휘관, 내가 대신 쉬어줄까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103100/mission_complete.ogg"},"서약":{"voiceline":"언니들이랑만 노는 것도 재밌지만…지휘관이 함께해준다면 분명 더 재밌을 거야. 그러니까, 앞으로도 잘 부탁해!","voicelink":"https://raw.githubusercontent.com