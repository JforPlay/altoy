[{"클뜯 id":9705080,"클뜯 함순이 id":970508,"함순이 이름":"안드레아 도리아·META","한글 함순이 + 스킨 이름":"안드레아 도리아·META","영문 함순이 + 스킨 이름":"Andrea Doria META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705080/shipyard.png","설명":"사르데냐 동맹의 안드레아 도리아야. 지휘관, 여기가 너희 모항이야? 그렇구나~ 좋은 곳이네. 푹 빠질 것 같아~","자기소개":{"voiceline":"나는 안드레아 도리아… 레이디 도리아라고 불러도 돼. 지휘관이 궁금한 건 사르데냐 동맹의 역서야? 아니면…… 「나」?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/profile.ogg"},"메인1":{"voiceline":"…이미 친숙한 그 안드레아와 별 차이가 없는 것 같다고? 후후, 그렇게 생각해도 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/main1.ogg"},"메인2":{"voiceline":"따뜻한 우유가 제일 좋지만, 우유가 들어있지 않은 핫초코도 괜찮네… 응, 지휘관이랑 이야기하니까 갑자기 마시고 싶어졌어. 지휘관, 같이 마실까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/main2.ogg"},"메인3":{"voiceline":"후… 오래 일했더니 좀 피곤하네. 지휘관, 같이 잠깐 쉬지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/main3.ogg"},"전투개시":{"voiceline":"승리를 향해 전진!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/battle.ogg"},"상세확인":{"voiceline":"요즘 사르데냐 함대의 훈련 성적이 조금 떨어져서, 어떻게 컨디션을 조정해야 할지 고민 중이야… 지휘관, 뭐 좋은 방법 없을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/detail.ogg"},"드랍 설명":{"voiceline":"안드레아 도리아급 전함 - 안드레아 도리아<color=#92fc63>(1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"음… 순탄한 항로 없이는 사업도 번창할 수 없는 법이지. 지휘관, 잘했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/expedition.ogg"},"실망":{"voiceline":"지휘관, 요즘 들어 의사 결정이 조금 부적절한 느낌이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 아까부터 무언가 말하고 싶은 게 있는 표정인데… 고민 있으면 내가 들어줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/feeling2.ogg"},"호감":{"voiceline":"부하의 멘탈과 컨디션에 신경 쓰고, 개인별로 케어하는 것… 이 점은 아직 지휘관한테 많이 배워야 할 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 아무것도 첨가하지 않은 따뜻한 우유처럼, 온화하면서도 어딘가 그리운 느낌을 줘. 그에 비하면 난 우유 없는 핫초코라고 해야 하나? 끝없이 깊고, 검게 소용돌이치는…… 후후후, 지휘관. 우유랑 섞은 핫초코 한 잔 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/feeling4.ogg"},"사랑":{"voiceline":"내 과거에 대해서 더 알고 싶다고…? 기록에 남아있지 않은 일화 같은 거? 음…… 역시 아직은 이른 것 같아. 나한테 지휘관은 특별한 존재니까, 이 유대감을 더 소중히 하고 싶어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/feeling5.ogg"},"터치3":{"voiceline":"어머…? 내 긴장을 풀어주려고? 지휘관이 직접 해주는 서비스라니, 너무 기뻐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 피곤한 게 얼굴에 보이네. 동료들 회고 같은 사소한 일은 나한테 맡기고 먼저 쉬고 있어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/home.ogg"},"hp 경고":{"voiceline":"괜찮아. 그냥 좀 긁힌 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 이제 일 시작하려고? 그 전에 따뜻한 우유 한 잔 어때? …후후, 이건 내가 마실 거고, 지휘관 건 지금 데워서 가지고 올게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/login.ogg"},"실패":{"voiceline":"이런… 다친 사람은 어서 돌아가서 치료받아! 승리를 되찾는 건 내일로 미루자…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 우편을 가지고 왔어. 그냥 정기 연락이니까 한가할 때 확인하면 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무가 도착했어. 뭐 내가 도와줄 건 없을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/mission.ogg"},"임무완료":{"voiceline":"지휘관, 임무가 무사히 완료됐어. 아… 미안해. 나도 모르게 지휘관 머리를 쓰다듬을 뻔했네. …정말 고생 많았어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/mission_complete.ogg"},"서약":{"voiceline":"서약을 나눴네. 이제부터 난 영원히 떠나지 않고, 계속 지휘관 곁을 지킬…… 아직도 내 이야기가 궁금해? 그럼…… 사랑하는 지휘관에게 백 가지 이야기 중 딱 하나만 들려줄까 봐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/propose.ogg"},"스킬":{"voiceline":"그래, 더 가까이 와~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/skill.ogg"},"터치1":{"voiceline":"우울할 때는… 그냥 따뜻하게 안아주면 지휘관 마음도 달래줄 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/touch.ogg"},"터치2":{"voiceline":"후후후, 나한테는… 마음껏 응석 부려도 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/touch2.ogg"},"입수시":{"voiceline":"사르데냐 동맹의 안드레아 도리아야. 지휘관, 여기가 너희 모항이야? 그렇구나~ 좋은 곳이네. 푹 빠질 것 같아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/unlock.ogg"},"강화성공":{"voiceline":"이건 꽤…… 후후, 꽤 괜찮네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"충분히 이길만해서 이긴 거지. 후후후, 다들 고생 많았어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705080/win_mvp.ogg"},"전투개시_ex":null,"상