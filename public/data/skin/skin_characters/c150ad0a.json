zurLane/main/audio/voiceline/301492/main2.ogg"},"메인3":null,"전투개시":{"voiceline":"전투 준비 완료! 지휘관, 어서 명령을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301492/battle.ogg"},"상세확인":{"voiceline":"은밀히 지키는 것이 내 역할이라지만, 이렇게 계속 방문자를 기다리기만 하니 좀 지루하군. 대신 경비를 설 테니까, 카와카제는 눈이라도 좀 붙이라고? ……그 말, 진심인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301492/detail.ogg"},"드랍 설명":{"voiceline":"…누군가 했더니, 너였군. 여기부터는 금단의 영역이다. 아무리 너라도—— …이미 들어온 걸 어떻게 하냐고? 으음, 이런 경우엔…… 어떻게 해야 하지……?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료로군. 흠… 지휘관과 확인하러 나가는 것뿐이라고는 하지만, 정말 자리를 비워도 괜찮은 건가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301492/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"「다들 꿈꾸던 세상을 누리고 있다」…고? 그렇군. 사람에 따라 형태는 달라도, 너와 함께 있는 이 세상을 즐기고 있다는 건 같겠지. 그래, 나도 마찬가지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301492/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"작전 회고 보고서는 여기 있다. 그래, 네가 돌아온 후부터 뒤에서 점검해 뒀지. …그러고 보니 이 모습, 밀정 임무를 수행할 때도 좋겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301492/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어디든, 어떤 임무든, 내 역할은 크게 다르지 않아. 너를 위해서 전력을 다할 뿐이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301492/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새로운 임무로군. 지휘관, 일단 각자 맡은 일로 돌아가는 게 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301492/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"으… 이쪽에서 유혹한 기억은 없다만…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301492/touch2.ogg"},"입수시":{"voiceline":"…누군가 했더니, 너였군. 여기부터는 금단의 영역이다. 아무리 너라도—— …이미 들어온 걸 어떻게 하냐고? 으음, 이런 경우엔…… 어떻게 해야 하지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLan