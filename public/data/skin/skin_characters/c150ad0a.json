[{"클뜯 id":301490,"클뜯 함순이 id":30149,"함순이 이름":"카와카제","한글 함순이 + 스킨 이름":"카와카제","영문 함순이 + 스킨 이름":"Kawakaze","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301490/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301490/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301490/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301490/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301490/shipyard.png","설명":"시라츠유급 구축함 9번함 - 카와카제 ","자기소개":{"voiceline":"개(改)시라츠유급 즉, 우미카제급 3번함 카와카제다. 그 대전에서는 동급함으로 제24 구축대를 결성했다. 솔로몬…말인가. 확실히, 여러 가지 추억이 담긴 장소다. 아이언 바텀 사운드, 노샘프턴, 그리고 최후의 기억도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/profile.ogg"},"메인1":{"voiceline":"포탄은 상대를 죽이는 흉기다. 아무리 미사여구를 늘어놓아도 그것은 변하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/main1.ogg"},"메인2":{"voiceline":"모르는 것이 있으면 진츠 씨에게 물어봐라. 나는…… 굳이 따지자면 센다이 씨에 가까우니까 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/main2.ogg"},"메인3":{"voiceline":"이 함대는 꽤나 유쾌한 녀석이 많군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/main3.ogg"},"전투개시":{"voiceline":"싸움은…… 아무것도 변하지 않았구나","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/battle.ogg"},"상세확인":{"voiceline":"낚시는 좋아한다. 머리를 비우고, 아무것도 생각하지 않아도 좋으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/detail.ogg"},"드랍 설명":{"voiceline":"시라츠유급 구축함 9번함 - 카와카제","voicelink":null},"의뢰 완료":{"voiceline":"의뢰완료다. 보고서의 확인, 잊지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/expedition.ogg"},"실망":{"voiceline":"결국은 나의 예상을 뛰어넘지 못할 정도의 인간이라는 건가. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/feeling1.ogg"},"낯섦":{"voiceline":"전쟁에 선악미추 따위는 없다. 적도 아군도 그것은 똑같다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/feeling2.ogg"},"호감":{"voiceline":"지휘관도 전쟁을 겪어봤던 몸이잖아? 어째서 그런 허풍을 믿지? 정의, 사랑, 평화 따위……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/feeling3.ogg"},"기쁨":{"voiceline":"현실에서 눈을 돌리고, 그저 이상과 꿈을 외친다…… 그런 우매함과 연약함은 질색이다. 지휘관은 그렇게 되지 않을… 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/feeling4.ogg"},"사랑":{"voiceline":"꿈을 포기하지 않으면, 언젠간 현실로 만들 수 있다는 건가… 흥, 대단히 진부한 대답이군. 하지만 당신이라면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"전투가 끝나면 어떻게 되냐고? 다음 전투가 시작될 뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/home.ogg"},"hp 경고":{"voiceline":"이 정도… 신경 쓸 필요도 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/hp_warning.ogg"},"로그인":{"voiceline":"오늘도 아무것도 다를 것 없는 날이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/login.ogg"},"실패":{"voiceline":"아직… 가라앉지 않았군. 어쩔 수 없는…건가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/lose.ogg"},"우편":{"voiceline":"우편이다. 나? 이런 것은 그다지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/mail.ogg"},"임무":{"voiceline":"새로운 임무다. ……뭐라고? 잠깐 잡담이라도 하자는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/mission.ogg"},"임무완료":{"voiceline":"보수가 왔군. 기대할 정도의 물건은 아니겠지만, 우선은 받아둬라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/mission_complete.ogg"},"서약":{"voiceline":"설마 지휘관과 이렇게 될 줄이야…… 당신을 오래 상대하고 있었더니, 나까지 연약한 이상을 믿게 됐다… 나를 이렇게까지 여리게 만든 책임, 확실히 져 주겠지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/propose.ogg"},"스킬":{"voiceline":"안심해라. 순식간에 끝내주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/skill.ogg"},"터치1":{"voiceline":"비서함의 업무? 업무에 호불호 같은 건 없어. 비서함이든, 비서함이 아니든 그런 것은 상관없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/touch.ogg"},"터치2":{"voiceline":"……시시한 짓을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/touch2.ogg"},"입수시":{"voiceline":"시라츠유급, 이름은 카와카제. 친해질 생각은 없다. 인사 같은 건 필요 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/unlock.ogg"},"강화성공":{"voiceline":"강해진 기분… 나쁘지 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/upgrade.ogg"},"vote":null,"승리":{"voiceline":"솔로몬… 나를 부르고 있는 건가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['노샘프턴'] : 이번엔 아군인가… 뭐, 좋다","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301490/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":301491,"클뜯 함순이 id":30149,"함순이 이름":"카와카제"