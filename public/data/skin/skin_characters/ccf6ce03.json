[{"클뜯 id":303010,"클뜯 함순이 id":30301,"함순이 이름":"후루타카","한글 함순이 + 스킨 이름":"후루타카","영문 함순이 + 스킨 이름":"Furutaka","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303010/shipyard.png","설명":"후루타카형 중순양함 1번함·후루타카","자기소개":{"voiceline":"후루타카형 중순양함… 뭐, 후루타카로 됐어! 이래 봬도 제1차 솔로몬 해전에서 꽤 활약했다고! 그리고, 아오바와는 오랫동안 함께 활약했어. 뭐, 무심코 들이박는 바람에 그만 돌아올 수 없게 되어버렸지만… 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/profile.ogg"},"메인1":{"voiceline":"지휘관, 카코는 딱히 지휘관을 싫어하는 게 아니니까, 너무 신경 쓰지 말아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/main1.ogg"},"메인2":{"voiceline":"어… 나 바보니까, 회의는 카코랑 둘이서 해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/main2.ogg"},"메인3":{"voiceline":"아파라… 아아 괜찮아, 방금 자다가 굴러떨어져서 머리 부딫친 것뿐이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/main3.ogg"},"전투개시":{"voiceline":"전투는 확실히 잘 해내 보일 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/battle.ogg"},"상세확인":{"voiceline":"좀 지루하네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/detail.ogg"},"드랍 설명":{"voiceline":"후루타카형 중순양함 1번함·후루타카","voicelink":null},"의뢰 완료":{"voiceline":"지휘관! (넘어짐) 아팟! 아, 괜찮아, 의뢰를 끝마쳤다는 보고를 하려 했었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/expedition.ogg"},"실망":{"voiceline":"(후루타카는 무시하듯 당신의 옆을 그대로 지나쳤다)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/feeling1.ogg"},"낯섦":{"voiceline":"카코는 언제나 자기가 중순양함의 모범이란 마음을 먹어서 저렇게 되어버렸지만, 평소엔 정말 상냥하다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/feeling2.ogg"},"호감":{"voiceline":"지휘관~ 아팟! …헤헤, 땡큐─, 또 넘어져 버렸어… 실은 덤벙대지 않으려고 신경 쓰고 있긴 한데, 여긴 너무나 즐거워서, 무심코 방심해버린단 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/feeling3.ogg"},"기쁨":{"voiceline":"으응… 카코랑 함께 생활한다든지, 미카와 함대나 제6 전대 아이들과 언제라도 만날 수 있다면 좋겠다는 상상을 해. 지휘관이 이 소망을 이뤄줬어. 그러니까, 지휘관을 위해서라면 무엇이든 할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/feeling4.ogg"},"사랑":{"voiceline":"지휘관이 좋다면 나도 딱히 상관없다구? 하지만 나, 연애 같은 건 잘 모르고, 해본 적도 없으니까 말야… 가르쳐 줄 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 방금 또 넘어져 버렸는데, 반창고 같은 거 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관… 문을 열 땐 조심해줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/login.ogg"},"실패":{"voiceline":"진 건가… 분하다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/lose.ogg"},"우편":{"voiceline":"지휘관, 미안해… 중간에 넘어져 버려서 편지가 구겨져 버렸어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/mail.ogg"},"임무":{"voiceline":"새로운 임무인가~ 왠지 어려울 것 같네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/mission.ogg"},"임무완료":{"voiceline":"보너스를 받으러 갈 때 넘어져 버려서, 아야야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/mission_complete.ogg"},"서약":{"voiceline":"뭘까, 이 느낌… 처음이야… 지휘관과 함께라면 더욱더 잔뜩 느낄 수 있겠지? 기대되는걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/propose.ogg"},"스킬":{"voiceline":"좋─아, 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/skill.ogg"},"터치1":{"voiceline":"무슨 일이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/touch.ogg"},"터치2":{"voiceline":"설마 지휘관이 나한테 흥미가 있을 줄이야… 솔직히 말해서 좀 기쁜걸~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/touch2.ogg"},"입수시":{"voiceline":"아, 미안, 부딪쳐버렸어… 에에!? 당신이 지휘관!? 후, 후루타카형 1번함 후루타카, 지금 막 착임했습니다! (소곤) 방금 건 잊어주라? 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 땡큐─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에? 내가 1등??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"N","ex_chat_status":0},{"클뜯 id":303019,"클뜯 함순이 id":30301,"함순이 이름":"후루타카","한글 함순이 + 스킨 이름":"후루타카·改","영문 함순이 + 스킨 이름":"Furutaka (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303019/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303019/chibi.png",