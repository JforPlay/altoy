[{"클뜯 id":205110,"클뜯 함순이 id":20511,"함순이 이름":"리벤지","한글 함순이 + 스킨 이름":"리벤지","영문 함순이 + 스킨 이름":"Revenge","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205110/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205110/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205110/shipyard.png","설명":"R급 전함 - 리벤지","자기소개":{"voiceline":"로열 네이비 소속, 리벤지급 전함의 네임쉽인 리벤지라고 합니다. 유틀란트 해전에서 조금 활약하긴 했지만, 그 후부터는 호위 임무에 종사하며 전선에는 그다지 나가지 않아서……. 죄송합니다, 조금 실망…시켜 드린 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/profile.ogg"},"메인1":{"voiceline":"꺅?! 죄송합니다. 테이블의 서류를 못 봤어요…. 지금 바로 정리하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/main1.ogg"},"메인2":{"voiceline":"얼마 전, 서두르다가 구축함과 부딪히고 말았어요…. 서로 상처는 없어서 다행이었지만, 그래도….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/main2.ogg"},"메인3":{"voiceline":"계속 업무를 보고 있자니, 목이랑 어깨가 뻐근하시죠? 괘, 괜찮으시다면 제가 마사지를 해드려도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/main3.ogg"},"전투개시":{"voiceline":"다들, 저를 따르세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/battle.ogg"},"상세확인":{"voiceline":"낯빛이 어두우신 것 같네요…. 혹시 고민이 있으신 건가요? 이야기를 들어 드릴 테니 괜찮으시다면 뭐든 제게 말씀해 주세요. 고민거리는 마음에 담아두지 말고 털어놓는 편이 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/detail.ogg"},"드랍 설명":{"voiceline":"R급 전함 - 리벤지","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 귀환했습니다. 저랑 함께 맞이하러 가요, 지휘관 각하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/expedition.ogg"},"실망":{"voiceline":"낙담하지 마세요! 지휘관 각하께서 자신을 바로잡는다면, 모두가 지휘관 각하를 다시 받아줄 날이 반드시 올 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/feeling1.ogg"},"낯섦":{"voiceline":"저, 저기… 지휘관 각하, 처음 만났을 때 부딪힌 거… 정말 괜찮으세요? …혹시 걱정되시면, 종합 검진이라도 받아 보시는 편이….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/feeling2.ogg"},"호감":{"voiceline":"약한 자를 지키는 것은 로열 나이트의 책임… 아, 딱히 지휘관 각하가 약자라는 건 절대 아니에요. 전장에서라면 분명 지휘관 각하 쪽이 지켜지는 쪽에 가깝긴 하지만….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/feeling3.ogg"},"기쁨":{"voiceline":"늘 모두를 위해 힘쓰시는 지휘관 각하께서도 가끔은 자신만을 위한 시간을 만들어 휴식을 취하셨으면 해요. 그때에는 제가 지휘관 각하를 쓰담쓰담해 드리면서, '수고 많으셨습니다. 늘 고생이 많으십니다~'라고 격려해 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/feeling4.ogg"},"사랑":{"voiceline":"지휘관 각하는 이 모항에 있어서, 그리고 제게 있어서 가장 소중한 분이에요. 그러니 지휘관 각하의 안전을 지키는 건 무엇보다도 중요한 것… 네, 여기서도, 전장에서도… 전력을 다해 지키겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/feeling5.ogg"},"터치3":{"voiceline":"저, 저기…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/headtouch.ogg"},"모항귀환":{"voiceline":"무사히 귀환하신 모습을 보니 마음이 놓입니다. 일단은 휴식을 취하시길 바라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/home.ogg"},"hp 경고":{"voiceline":"기죽지 않아요…!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침입니다, 지휘관 각하. 오늘은 리벤지가 도와드릴 수 있는 일이 있을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/login.ogg"},"실패":{"voiceline":"역시 너무 달린 모양이네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/lose.ogg"},"우편":{"voiceline":"지휘관 각하 앞으로 온 우편입니다! 지금 가지고 올까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/mail.ogg"},"임무":{"voiceline":"새로운 임무 말씀이십니까? 제 도움이 필요하시면, 언제든 말씀해 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/mission.ogg"},"임무완료":{"voiceline":"임무 보상, 바로 받아 오겠습니다! …앗, 목록 확인이 먼저겠네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/mission_complete.ogg"},"서약":{"voiceline":"하아, 하아…. 지휘관 각하께서 제게 볼일이 있다는 소리를 듣고, 서둘러 왔어요. 이건… 반지? 이, 이럴 수가… 죄죄죄죄죄송합니다! 너무 갑작스러워 마음의 준비가 아직……. 기, 기꺼이! 받아들이겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/propose.ogg"},"스킬":{"voiceline":"지휘관 각하와 모두는 제가 지키겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/skill.ogg"},"터치1":{"voiceline":"급한 용무신가요? 네, 지금 바로 그쪽으로… 자, 잡담 말씀이세요…? 죄송합니다. 또 허둥대고 말았네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/touch.ogg"},"터치2":{"voiceline":"그런 행동은 여자에게 실례라구요, 지휘관 각하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/touch2.ogg"},"입수시":{"voiceline":"……앗?! 죄, 죄송합니다! 서두르다가 부딪혀서…. 지휘관 각하 맞으세요? 네, 넵! 로열 네이비 소속 전함 리벤지, 지금 착임했습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/unlock.ogg"},"강화성공":{"voiceline":"감사합니다. 지휘관 각하의 기대를 저버리지 않겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋았어, 이대로 계속 전진해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/win_mvp.ogg"},"전투개시_ex":{"voiceline":"원한은 없습니다만…. 전투 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관 각하께서는 약하시지 않아요. 그러니 전 로열 나이트로서가 아니라, 당신을 사랑하는 여자로서 당신을 지킬 겁니다. 그것이야말로 제 바람이자, 가장 큰 행복……. 무, 물론, 부하로서도 충실히 지켜드릴 거구요.///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관 각하가 부디 무사하시도록……. 다행이다… 실은 저도 함께 출격해서 지켜드리고 싶었답니다. 후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 오세요, 지휘관 각하. 후후훗, 지휘관 각하의 얼굴을 뵙게 되어, 오늘 하루도 기분이 좋네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"휴우.. 여기 우편 가지고 왔습니다, 지휘관 각하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/mail_ex.ogg"},"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"잡담을 나누자는 거군요. …죄, 죄송합니다! 역시 이번엔 급한 용무신 거 맞죠?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/touch_ex.ogg"},"터치2_ex":{"voiceline":"저, 적어도 장소를 바꿔서… 읏///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"싸우는 건 좋아하지 않지만… 이건 다 모두를 지키기 위해서니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['퀸 엘리자베스'] :  로열 나이트로서 여왕 폐하를 지키겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/couple_encourage1.ogg"},{"voiceline":"['USS'] :  부, 부딪히지 않을 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205110/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"피곤하시면 우선은 좀 쉬는 게 어떠세요? 지휘관 각하의 휴식 시간은 제가 확실히 지켜드릴 테니, 안심하시길.","voicelink":"https://raw.githubusercontent.com/Fernand