[{"클뜯 id":103280,"클뜯 함순이 id":10328,"함순이 이름":"피츠버그","한글 함순이 + 스킨 이름":"피츠버그","영문 함순이 + 스킨 이름":"Pittsburgh","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103280/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103280/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103280/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103280/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103280/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103280/shipyard.png","설명":"볼티모어급 중순양함 - 피츠버그","자기소개":{"voiceline":"이글 유니온 소속 볼티모어급 중순양함 피츠버그야. 「맥키스포트」라는 시시한 별명이 붙었는데…… 궁금하면 내 이야기랑 같이 천천히 들려줄게. 장소는… 일단 내 방으로 하면 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/profile.ogg"},"메인1":{"voiceline":"지휘관? 그렇게 가만히 보고만 있으면 즐거워? 따로 하고 싶은 게 있으면 하면 되잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/main1.ogg"},"메인2":{"voiceline":"파일이 어디 갔는지 맞혀봐. 물론 내 옷 안에는 없어… 후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/main2.ogg"},"메인3":{"voiceline":"「맥키스포트」… 그건 어디서 들었어? 놀리면 혼내줄 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/main3.ogg"},"전투개시":{"voiceline":"지휘관과 보내는 시간을 방해하지 마~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/battle.ogg"},"상세확인":{"voiceline":"검사라… 목덜미만 아니면 어디든 상관없어, 어디부터 시작해야 할지 잘 모르겠으면… 내가 시범을 보여줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/detail.ogg"},"드랍 설명":{"voiceline":"볼티모어급 중순양함 - 피츠버그","voicelink":null},"의뢰 완료":{"voiceline":"응? 의뢰팀이 돌아왔어? 어떻게 할까? 일단은 여기서 끝낼까? 우후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/expedition.ogg"},"실망":{"voiceline":"지휘관이 이런 사람일 줄이야. 시시하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/feeling1.ogg"},"낯섦":{"voiceline":"후후♪ 나, 지휘관이 좀 더 재밌어졌으면 좋겠어~ 농담이야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/feeling2.ogg"},"호감":{"voiceline":"이 주스는 내가 좋아하는 맛인데… 어떤 맛인지 지휘관, 맞춰 볼래? 다 마셨는데 어떻게 맞추냐고? 글쎄, 어떻게 할까…… 아직 입술이나 혀에는… 남아있을지도 모르지? 후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 관찰만 할 때는 지나지 않았어? 지금부터는 맹목적인 열애 페이즈로 돌입해야 하는 거 아니야? 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/feeling4.ogg"},"사랑":{"voiceline":"딱히 취한 건 아니야. 그저 사랑이나 욕망 같은 게 너무 강해서, 몸이 뜨거워져서…… 지휘관이야말로 주스도 안 마셨으면서 왜 그렇게 뜨거운 거야? …응? 왜 그런 건데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/feeling5.ogg"},"터치3":{"voiceline":"흠? 지금 날 부추기는 거야? 후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관~! 어서 와~! …응? 하나도 안 취했어~ 딱 주스 한 잔 마신 것뿐인데 어떻게 취해? …얼굴이 뜨겁다고? 어라, 그러면 다른 곳도 만져서 확인해 보는 건…… 여긴? 여기도 뜨거…워?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/home.ogg"},"hp 경고":{"voiceline":"갑자기 목덜미가 저려오네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 일 시작하기 전에 옷매무새 가다듬는 것 좀 도와줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/login.ogg"},"실패":{"voiceline":"분명 태풍이 원인일 거야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/lose.ogg"},"우편":{"voiceline":"지휘관, 당신 앞으로 온 우편이야, 아…… 아니, 아무것도 아니야. 종이가 아니라 몸에 써서 보내면 어떨까 싶어서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/mail.ogg"},"임무":{"voiceline":"시시한 임무는 후딱 해치워버려. 나중에 진짜 재밌는 게 뭔지 보여줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/mission.ogg"},"임무완료":{"voiceline":"임무 완료 보상에 딱히 관심은 없지만…… 지휘관이 내게 주는 보상에는 관심이 굉~장히 많아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/mission_complete.ogg"},"서약":{"voiceline":"어머, 이걸 나에게? 지휘관… 이게 뭘 의미하는지 알고는 있어? 후후후, 앞으로는 내 욕망을 계속 충족시키고, 영원히 내게서 도망칠 수 없다는 거야♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/propose.ogg"},"스킬":{"voiceline":"바이퍼에게도 뒤지지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/skill.ogg"},"터치1":{"voiceline":"응? 그걸로 만족한 거야? 지~ 휘~ 관~♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/touch.ogg"},"터치2":{"voiceline":"지휘관, 좀 더 특별한 테크닉 하나 알려줘도 될까? 우리 둘 다 기분이 좋아질 거야♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/touch2.ogg"},"입수시":{"voiceline":"드디어 만났네, 지휘관. 나는 중순양함인 피츠버그…… 아, 내 정신도 참. 그러고 보니 인사 선물을 가져오는 걸 깜빡했네. 그 대신…… 뭐든 좋으니까 부탁 하나 들어줄게. 뭐든 괜찮으니까 말해봐~ 후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/unlock.ogg"},"강화성공":{"voiceline":"의장이 더 잘 맞는 것 같은데? 검사 좀 부탁할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/upgrade.ogg"},"vote":null,"승리":{"voiceline":"너무 쉽게 이겨서 조금 시시하네. 있잖아, 지휘관. 더 재밌는 거 하지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"응, 그래그래. 바로 그 눈이야♪ 계속 나만을 바라봐 줘♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"몸뿐만 아니라 마음까지 지휘관의 사랑으로 가득 차는 이 느낌… 마음에 들어. 지휘관, 앞으로도 날 가득 채워줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"사랑의 터치……? 그럼, 나도 지휘관 머리 쓰다듬게 해줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어서 와! 지휘관! 있잖아, 이 이상한 주스 한번 마셔볼래? 후후후… 괜찮아~ 이상한 「맛」은 안 넣었으니까~ 아니면…… (작은 목소리로) 내 「맛」, 넣어줬으면 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 드디어 왔네. 보고 싶었어~ 조금만 더 기다리게 했으면 못 참을 뻔했어… 후후후♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"겨우 이걸로는 날 만족시킬 수 없어. ……잘 알잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/touch_ex.ogg"},"터치2_ex":{"voiceline":"으음♥ 아주 능숙해…… 이제 한 사람 몫은 다 하네, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":{"voiceline":"조금 알려준 것뿐인데 피츠버그가 강해졌다고? 후후후, 역시 지휘관이야. 내 몸 구석구석까지 다 아는 사람다워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/upgrade_ex.ogg"},"승리_ex":null,"함대 특수대사":[{"voiceline":"['볼티모어'] :  평소처럼 멋있네, 우후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/couple_encourage1.ogg"},{"voiceline":"['브레머튼'] :  늘 그렇게 베스트 컨디션을 유지해 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/couple_encourage2.ogg"}],"메인4":{"voiceline":"가슴 부분에 있는 단추? 아~ 당연히 노린 거지. 후후……♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103280/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"있잖아, 내가 도와줄 건 없어? 지루한 업무는 빨리 처리하고 재밌는 걸 빨리 하고 싶어♪","v