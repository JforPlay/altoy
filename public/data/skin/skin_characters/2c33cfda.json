[{"클뜯 id":206010,"클뜯 함순이 id":20601,"함순이 이름":"허미즈","한글 함순이 + 스킨 이름":"허미즈","영문 함순이 + 스킨 이름":"Hermes","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206010/shipyard.png","설명":"초대 허미즈급 항공모함·허미즈 (HMS Hermes)","자기소개":{"voiceline":"나는 허미즈. 세계에서 두 번째로 건조된 항공모함이며, 또한 사쿠라 엠파이어에게 격침당한 유일한 로열 네이비의 항공모함이지. 그때는 어쩔 수 없었지만… 언젠가, 세계 최초의 그 녀석과 한번 듀얼해보고 싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/profile.ogg"},"메인1":{"voiceline":"내 소원은, 그 호쇼와 한번 승부해보는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/main1.ogg"},"메인2":{"voiceline":"카드에도 항공기에도 혼이 깃들어있어. 나의 턴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/main2.ogg"},"메인3":{"voiceline":"승리만이 아니라, 나의 힘으로, 모두의 미래에 '에가오 (미소)'를…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/main3.ogg"},"전투개시":{"voiceline":"함대를 믿고 있는 한, 언젠가 함대는 내게 대답해줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/battle.ogg"},"상세확인":{"voiceline":"데이터가 전부는 아냐. 제대로 활용해야 비로소 힘이 되는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/detail.ogg"},"드랍 설명":{"voiceline":"초대 허미즈급 항공모함·허미즈 (HMS Hermes)","voicelink":null},"의뢰 완료":{"voiceline":"일시중지다! 의뢰에 나갔던 동료들이 돌아왔어. 우선 그녀들의 성과를 보러 가자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/expedition.ogg"},"실망":{"voiceline":"지휘관이 어둠의 듀얼리스트로 타락해버렸다는 건가… 그렇다면, 쓰러뜨릴 수밖에 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/feeling1.ogg"},"낯섦":{"voiceline":"왜 그래 지휘관, 듀얼에 흥미가 있는 건가? 자, 모르더라도 괜찮아. 처음부터 가르쳐 줄게! 우선은, 기합이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/feeling2.ogg"},"호감":{"voiceline":"듀얼 외에 다른 취미? …생각해본 적은 없지만, 지휘관이 가르쳐주겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/feeling3.ogg"},"기쁨":{"voiceline":"HUN☆ 이 지휘관 캐리커처를 프로텍터로 삼겠다고 정했어. 이걸로 지휘관이랑 항상 함께야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 듀얼리스트의 반려가 되려면, 듀얼의 길은 더욱 펼쳐지게 돼. 다만, 그건 서로를 손바닥 들여다보듯 꿰고 있어야 한다는 게 전제되어야 해… 우린 이 조건을 이미 클리어했다고 생각한다만… 그러니까… 되어… 보겠어? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"Gotcha! 뜨거운 듀얼이었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"돌아왔나. 즐거운 듀얼을 하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/login.ogg"},"실패":{"voiceline":"난 서렌더 따윈 하지 않아! 나의 턴… HA☆NA★SE! (이거 놔!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 편지다. 도전장이려나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/mail.ogg"},"임무":{"voiceline":"미션이란 곧, 챌린지라고 할 수 있지. 지휘관, 더 높은 곳을 향하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/mission.ogg"},"임무완료":{"voiceline":"보너스, 듀얼 만큼이나 좋은 울림이다. 열어보자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/mission_complete.ogg"},"서약":{"voiceline":"이 감각은…! 나와 지휘관의 유대가 새로운 미래를 열고, 빛을 비추는 길이 되리니─── 이제부터는 우리들의 턴이다! 자, 드로우DAAAAA!!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/propose.ogg"},"스킬":{"voiceline":"나의 턴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/skill.ogg"},"터치1":{"voiceline":"뭐지? 듀얼이라도 하자는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/touch.ogg"},"터치2":{"voiceline":"음… 지휘관이 그렇게까지 흥미가 있다면, 한번 이길 때마다 한번 만지게 해준다는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/touch2.ogg"},"입수시":{"voiceline":"영광을 카드에, 혼을 듀얼에… 가 아니라, 비행갑판에! 나는 허미즈. 지휘관, 명령을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/unlock.ogg"},"강화성공":{"voiceline":"지금의 난, 덱과 좀 더 이어졌어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"한데 모인 별이 하나가 될 때, 우리의 유대가 새로운 미래를 밝히니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"N","ex_chat_status":0},{"클뜯 id":206019,"클뜯 함순이 id":20601,"함순이 이름":"허미즈","한글 함순이 + 스킨 이름":"허미즈·改","영문 함순이 + 스킨 이름":"Hermes (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206019/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206019/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206019/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206019/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206019/shipyard.png","설명":"영광이 모여 하나가 될 때, 새로운 인연이 미래를 비출거야! 극한을 초월한 바람은 밝게 빛나는 길이 될거야! 허미즈, 개조 완료! ","자기소개":null,"메인1":{"voiceline":"호쇼...... 그녀는 강하지, 지휘관. 난 그녀로부터 \"부드러움\"이라는 이름의 강함을 배웠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/main1.ogg"},"메인2":{"voiceline":"심령, 강력한 무기도 커다란 약점이야. 어디에 있든지 이 점을 잊어선 안돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/main2.ogg"},"메인3":{"voiceline":"센토가 가르쳐준 이것도 맛 보여줄게. 흐흠, 내게도 전투만이 전부가 아니라는 걸 보여주는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/main3.ogg"},"전투개시":{"voiceline":"함재고, Gate Open！","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/battle.ogg"},"상세확인":{"voiceline":"진정한 승부가에 대해 말하자면, 그 무엇에도 우연이란 것은 없어. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/detail.ogg"},"드랍 설명":{"voiceline":"영광이 모여 하나가 될 때, 새로운 인연이 미래를 비출거야! 극한을 초월한 바람은 밝게 빛나는 길이 될거야! 허미즈, 개조 완료!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":{"voiceline":"나의 승리 방정식은 겨우 이정도만이 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/hp_warning.ogg"},"로그인":{"voiceline":"기다렸어. 카드... 아니, 그 거칠게 날뛰는 혼이 당신이 돌아온 걸 알려줬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/login.ogg"},"실패":{"voiceline":"불패는 단지 환상에 불과해, 지휘관......만약 여기서 낙담한다면, 내 지휘관이 될 자격 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/lose.ogg"},"우편":{"voiceline":"우편물에 보이면서 보이지 않는 것이 쌓여 있어, 그건 바로——우정이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"바람이 분다... 지휘관, 내 선미파 꽉 잡아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/touch.ogg"},"터치2":null,"입수시":{"voiceline":"영광이 모여 하나가 될 때, 새로운 인연이 미래를 비출거야! 극한을 초월한 바람은 밝게 빛나는 길이 될거야! 허미즈, 개조 완료!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"소위 증오란 것은, 얼마나 쌓이던지 일격에 허물어져 버리곤 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206019/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"개조","상점 id":0,"상점 카테고리 id":9997,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"N","ex_chat_status":0}]