aw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/main1.ogg"},"메인2":{"voiceline":"새로운 의상도 잘 어울린다고? 후훗, 이 의상은 모두에게 받은 새해 선물이야. 조금 개성을 더해서…… 왜 양말이 한 쪽뿐이냐고? 그, 그건 주문을 메모하려고 그런 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/main2.ogg"},"메인3":{"voiceline":"응? 요리가 너무 많다고? …음, 평소에는 열심히 절약하지만 오늘은 과감하게 갈 거야! 춘절은 특별한 날이니까 대충대충 할 수는 없다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"으앗! 다바오, 너도 좀 도와! 거기 문어 좀 잡아줘! …아. 지휘관, 새해 복 많이 받아! 요리 준비가 덜 됐는데…… 도와준다고? 후훗, 괜찮아! 오늘은 나랑 핑하이가 맛있는 걸 맛 보여 줄게♪","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 애들이 막 돌아왔네. 자, 단란하게 연회를 즐기자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"딱 좋을 때 돌아왔네! 방금 막 만든 빠오즈가 있으니까, 배가 고프면 먼저 먹고 있어도 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세……가 아니라, 지휘관! 잘 돌아왔어! 오늘도 일해? 그럼, 얼른 해치우고 새해 음식 먹으러 와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/login.ogg"},"실패":null,"우편":{"voiceline":"지휘관, 우편이 왔어. 시기가 시기이니만큼 대부분 새해 인사겠지. 확실히 답장해야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/mail.ogg"},"임무":{"voiceline":"응? 새로운 임무? 지휘관, 어떻게 할래? 지금 할 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/mission.ogg"},"임무완료":{"voiceline":"임무 보상은 전부 회수했어! 음…… 이건 춘절 요리에 추가해도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502027/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"꺅! 자, 잠깐! 그릇이 떨어지잖아! ……정말, 갑자기 껴안으면 어떡해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/a