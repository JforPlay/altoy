[{"클뜯 id":101450,"클뜯 함순이 id":10145,"함순이 이름":"알렌 M. 섬너","한글 함순이 + 스킨 이름":"알렌 M. 섬너","영문 함순이 + 스킨 이름":"Allen M. Sumner","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101450/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101450/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101450/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101450/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101450/shipyard.png","설명":"알렌 M. 섬너급 구축함—알렌 M. 섬너, 현호 DD-692","자기소개":{"voiceline":"알렌 M. 섬너급은 플레처급의 개량형이야. 수량으로는 비교할 수 없지만, 화력이나 대공은 한 수 위지! 그때 활약한 이글 유니온의 최강 구축함이라고 해도 과언이 아닐 정도라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/profile.ogg"},"메인1":{"voiceline":"네 사무실 테이블 너무 밋밋하다. 반짝이는 스티커 같은 거 붙여보는게 어때? 헤헷, 이런 거 추천할게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/main1.ogg"},"메인2":{"voiceline":"플레처는 정말 자매들을 걱정하는구나… 나? 굳이 얘기하자면… 나는 자유파야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/main2.ogg"},"메인3":{"voiceline":"지휘관의 일은 이런 거구나… 이것들을 배우면, 나도 지휘관이 될 수 있는 거야? 헤헤, 농담~ 어때, 좀 편안해진 것 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/main3.ogg"},"전투개시":{"voiceline":"좋아, 출발하자~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/battle.ogg"},"상세확인":{"voiceline":"지휘관, 넌 애교 부리는 쪽이 좋아, 아니면 애교 부리는 걸 받는 쪽이 좋아? 그냥 궁금해서~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/detail.ogg"},"드랍 설명":{"voiceline":"알렌 M. 섬너급 구축함—알렌 M. 섬너, 현호 DD-692","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어! 물자 분류 태그는 내가 스티커로 대체했어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/expedition.ogg"},"실망":{"voiceline":"됐어 됐어, 기분 안 좋으면 와서 어리광 피워도 돼~ 누나의 따뜻함 품을 빌려줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/feeling1.ogg"},"낯섦":{"voiceline":"으흠, 함장 상태 퍼펙트! 다음번 출격도 너희들에게 맡길게~ 헤헷~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/feeling2.ogg"},"호감":{"voiceline":"후~ 오늘 훈련 순조롭게 완료! 다음은 휴식 시간... 엇, 지휘관, 잡았다! 이 별 스티커는 나랑 같이 수고해준 너한테 줄게——이마에 붙이면 돼~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/feeling3.ogg"},"기쁨":{"voiceline":"다음번 휴일 때 무슨 계획 없지? 확실하지? 좋아, 그날은 내가 찜했어! 내가 방에서 게임기랑 다 준비해놓고 기다릴게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/feeling4.ogg"},"사랑":{"voiceline":"Zzz… 음, 지휘관? 깜박 잠들어버렸네 에헤헤… 그러니까, 나 좀 소파까지 업어다 줘~ 부·탁·이·야~ 에이, 우리가 어떤 사이인데, 이 정도 스킨십은 정상 아니야~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/feeling5.ogg"},"터치3":{"voiceline":"흐음~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/headtouch.ogg"},"모항귀환":{"voiceline":"오! 복귀 환영해! 소파에 자리 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/home.ogg"},"hp 경고":{"voiceline":"판도가 굳었어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/hp_warning.ogg"},"로그인":{"voiceline":"잠 덜 깬 모습 좀 봐… 후! 후! 어때, 정신 좀 들었지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/login.ogg"},"실패":{"voiceline":"너무 방심했나, 니어 미스라서 다행이야… 반성할게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/lose.ogg"},"우편":{"voiceline":"새로운 우편이야! … 나중에 본다고? 그럼 \"읽지 않음\" 태그 붙여놓을게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/mail.ogg"},"임무":{"voiceline":"난 매정한 임무 알리미~ 임무 있어, 임무, 얼른 완성해, 얼른~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/mission.ogg"},"임무완료":{"voiceline":"임무 완성! … 아니, 나랑 아무 상관 없는 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/mission_complete.ogg"},"서약":{"voiceline":"이건 대체 내가 지휘관을 공략한 건지, 지휘관이 날 공략한 건지... 아, 모르겠다, 결과가 해피엔딩이면 됐어! 에헤헤~ 사랑해, 지휘관~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/propose.ogg"},"스킬":{"voiceline":"한 번 신나게 놀아볼까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/skill.ogg"},"터치1":{"voiceline":"왜? 나한테 애교 부릴려고? 해봐 해봐~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/touch.ogg"},"터치2":{"voiceline":"헷, 피했지롱, 또 피했지롱~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/touch2.ogg"},"입수시":{"voiceline":"이글 유니온 신형 구축함, 알렌 M. 섬너가 바로 나야! 알렌이라고 부르면 돼. 잘 부탁해, 지휘관~ 듣기로는 모항은 음식도 맛있고 생활도 아주 편리하다는데, 정말 사실이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/unlock.ogg"},"강화성공":{"voiceline":"오~옷! 슬슬 몸 좀 움직여 볼까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에이, 이거 뭐 간단하잖아~ 돌아가서 별 하나 더 붙여야지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/win_mvp.ogg"},"전투개시_ex":{"voiceline":"가자, 힘내~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/battle_ex.ogg"},"상세확인_ex":{"voiceline":"애교 부려 달라고~? 그럼 얼마든지~ 에헤헤","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"!! 와악, 지휘관? 읏, 잠들었던 건가…? 하~암, 오늘은 정말 땡땡이 치고 싶다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"임무? 나도 도와줄게. 얼른 끝내버리자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/mission_ex.ogg"},"임무완료_ex":{"voiceline":"난 매정한 임무 보상 알리미~ 빨리 보상 수령해, 보상 수령해, 수령, 빨리~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"나와 지휘관의 승리야! 아하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['쿠퍼'] : 검은 고양이다! … 헤헤, 농담이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/couple_encourage1.ogg"},{"voiceline":"['라피'] : 라피? 음, 살짝 좀 다르네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/couple_encourage2.ogg"},{"voiceline":"['마블헤드', '아스토리아', '브레머튼'] : 오, 이 새로운 스티커 엄청 귀엽지 않아~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/couple_encourage3.ogg"},{"voiceline":"['롱 아일랜드'] : 유령씨의 긴 소매를 새로운 트렌드로~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/couple_encourage4.ogg"}],"메인4":{"voiceline":"지휘관, 너 방금 졸았네, 맞지? 잘못을 인정하는 착한 사람이 되라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"내 도움이 필요하다고? 뭐 그렇게 어렵게 얘기해~ 비서함한테는 \"너한테 맡긴다\" 한 마디면 되는데… 됐어, 나한테 맡겨~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101450/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"