[{"클뜯 id":105150,"클뜯 함순이 id":10515,"함순이 이름":"인디애나","한글 함순이 + 스킨 이름":"인디애나","영문 함순이 + 스킨 이름":"Indiana","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105150/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105150/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105150/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105150/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105150/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105150/shipyard.png","설명":"사우스다코타급 전함 - 인디애나","자기소개":{"voiceline":"이글 유니온 사우스다코타급 전함인 인디애나다. 자기소개는 이 정도면 되겠지. 지휘관은 내가 모든 적을 박살 낼 거라는 것만 기억하면 돼. 다시 말해, 나와 함께면 누구에게도 무시당하지 않는다는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/profile.ogg"},"메인1":{"voiceline":"동화 속 용사를 모방하기만 하는 건 용기라고 할 수 없지. 그건 단지 터무니없는 무모함에 불과해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/main1.ogg"},"메인2":{"voiceline":"지휘관, 점심시간이다! 자, 스테이크와 과일 샐러드, 프로틴에 케일을 섞은 믹스 쉐이크도 준비했으니, 건강하고 영양도 만점이라고! …얼굴빛이 왜 그렇게 어두워?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/main2.ogg"},"메인3":{"voiceline":"책략? 아, 책략이 전투에서 우위를 점하게 해준다는 건 잘 알아. 하지만 적에게 정면으로 맞서는 편이 더 흥분되고, 이겼을 때의 성취감도 더 크지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/main3.ogg"},"전투개시":{"voiceline":"인디애나의 힘을 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/battle.ogg"},"상세확인":{"voiceline":"모항에는 의외로 트레이닝 시설이 충실하군! 지휘관, 나랑 같이 운동하러 갈래? 근육 성장은 물론이고 머리를 맑게 하는 데도 도움이 된다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/detail.ogg"},"드랍 설명":{"voiceline":"사우스다코타급 전함 - 인디애나","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아온 모양이군. 여기까지 오면서 얼마나 멋진 전투를 했을까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/expedition.ogg"},"실망":{"voiceline":"음… 지휘관은 내게 머리를 쓰게 하는 몇 안 되는 녀석이라고 생각했는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/feeling1.ogg"},"낯섦":{"voiceline":"모항에 있는 구축함이나 잠수함들은 나를 보면 입을 닫아버리거나, 안색이 안 좋아지던데… 내가 무슨 이상한 짓이라도 저지른 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/feeling2.ogg"},"호감":{"voiceline":"두뇌를 쓰는 전술 지휘뿐만 아니라, 근육을 능숙하게 다루는 보디빌딩의 재능까지 있다니 대단하군. 게다가 근면하기까지…… 좋아! 칭찬해 주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/feeling3.ogg"},"기쁨":{"voiceline":"(「햇빛은 대지를 껴안고, 달빛은 바다에 키스를 보내고 있어. 네 입맞춤이 없다면 자연이 아무리 아름답다고 한들 무슨 소용일까?」… 좋아, 이 정도면 되겠지. 이제 지휘관에게 줄 트레이닝 잡지에 몰래 끼워두기만 하면…)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/feeling4.ogg"},"사랑":{"voiceline":"크흠…… 지휘관, 얼마 전에 준 잡지는 다 읽어봤나? 뭐? 아직이라고?! ……아, 아니, 그 안에는 사실 내가 쓴 러브레터가…… 어쨌든 지금 당장 읽어 봐라! 한 페이지씩 넘기면서 천천히 읽으라고! 하나도 빠짐없이 말이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/feeling5.ogg"},"터치3":{"voiceline":"응? 무슨 볼일이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/headtouch.ogg"},"모항귀환":{"voiceline":"수고했다, 지휘관. 자, 프로틴을 쭉 들이켜서 근육에 영양분을 공급하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/home.ogg"},"hp 경고":{"voiceline":"아직 멀었다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/hp_warning.ogg"},"로그인":{"voiceline":"앗, 지휘관! 돌아왔나?! 혼자 이 일을 하려니 지루하기 짝이 없군…… 너는 대체 어떻게 이걸 매일 하는 거지? 이런 걸 할 바에는 차라리 백 명, 아니 천 명의 적을 상대하는 편이 낫겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/login.ogg"},"실패":{"voiceline":"괜찮아. 일시적 후퇴란 건 패배를 의미하는 게 아니야. 강해져서 다시 도전하면 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/lose.ogg"},"우편":{"voiceline":"지휘관, 네 우편이다! 앗, 내가 주문한 잡지도 도착했군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/mail.ogg"},"임무":{"voiceline":"지휘관, 임무는 확실히 처리해 둬라. 응? 내가 이런 말을 하는 게 이상하다고? 이래 봬도 시간에는 꽤 예민한 편이라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/mission.ogg"},"임무완료":{"voiceline":"임무 완료 보상인가? 어디서 보충제 랜덤박스를 판매한다고 하던데… 내 운을 믿고 한번 도전해보고 싶군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/mission_complete.ogg"},"서약":{"voiceline":"이 봉투 안에 네 대답이…? 그럼…… 자, 잠깐! 지휘관, 이건 왜 봉투에 넣은 거지?! …내 마음이 전해졌다고? 그, 그래? 그렇다면… 아무튼 반지, 지금 꼈다! 너도 멍하니 있지 말고 빨리 다음 단계로 넘어가라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/propose.ogg"},"스킬":{"voiceline":"박살내 주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/skill.ogg"},"터치1":{"voiceline":"응? 전투 임무인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/touch.ogg"},"터치2":{"voiceline":"다른 곳은 탄탄한데, 여기만 부드럽다니…… 그, 그게 무슨 어처구니없는 소리냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/touch2.ogg"},"입수시":{"voiceline":"사우스다코타급 전함 인디애나, 바로 지금 모항에 도착! ……뭐? 그렇게 격식 차릴 거 없다고? 그럼 다시…… 여어, 안녕! 지휘관! 만나서 반갑다! 이제부터는 내가 승리를 안겨주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/unlock.ogg"},"강화성공":{"voiceline":"하압! 힘이 강해지는 게 느껴져!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/upgrade.ogg"},"vote":null,"승리":{"voiceline":"간단하군. 다음에는 좀 더 강한 상대로 부탁하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔군. 이렇게 순조롭게 진행된 건 네 현명한 지휘 덕분이겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/expedition_ex.ogg"},"사랑_ex":{"voiceline":"러브레터를 일일이 잡지에 끼워둘 필요는 없다고…… 무, 물론 직접 건네주는 편이 더 효율적이라는 건 나도 잘 알아! 하지만! 아무리 우리의 관계가 발전해도 부끄러운 건 여전히 부끄럽다고…!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"머리를 쓰다듬는 게 정말 좋은 모양이군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"잘 왔다. 프로틴에 웨이트 트레이닝 효율을 올려주는 영양제도 넣어뒀어. 어서 마셔!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"돌아왔군. 서류는 다 정리해 뒀다. 지루하지만 너를 위해서라고 생각하니 어떻게든 버텨지더군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"오, 임무가 완료된 건가? 역시 내가 첫눈에 반한 지휘관답게 업무 처리가 아주 능숙하군! 잘했다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"응? 뭐 도와줄 거라도 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/touch_ex.ogg"},"터치2_ex":{"voiceline":"네, 네 녀석! …그 정도로도 아직 만족 못 한 거냐…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['엔터프라이즈'] :  오! 이번에는 같이 싸우겠군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"큭… 어제는 너와 이런저런 걸 너무 많이 했더니 제대로 서기가 힘들군… 음? 오늘은 그만 돌아가서 쉬라고? 안 돼! 오늘은 같이 외출하기로 약속했잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"서류 마무리가 완벽하다고? 당연하지! 이래 봬도 강의에서는 언제나 만점을 따냈었다고! …그 놀란 눈은 뭐냐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105150/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":105151,"클뜯 함순이 id":10515,"함순이 이름":"인디애나","한글 함순이 + 스킨 이름":"하이 눈 어레스트","영문 함순이 + 스킨 이름":"High Noon Arrest","스킨 타입":"Wild West","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105151/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105151/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105151/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105151/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105151/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105151/shipyard.png","설명":"지휘관, 여기 있었군. 여기는 무슨 일이냐고? 아, 옥상에서 바로 내려오는 편이 직선거리라 가장 빠를 것 같았거든. 그래서 천장을 뚫어서 내려오기로 했지. 강도 녀석들은 내가 다 처리했으니, 안심하고 내게 맡겨라.","자기소개":null,"메인1":{"voiceline":"힘만으로는 강도를 잡을 수 없지. 어떻게 진입해서 녀석들을 붙잡을 것인지에 대한 대략적인 계획도 필요한 법이다. 현장에서의 임기응변은…… 하하하, 현장에서 직접 생각해 내야 임기응변이겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/main1.ogg"},"메인2":{"voiceline":"요란스레 칼을 휘두르다가 내 총알 한 방에 쓰러지는 게 우스꽝스럽다고? 하하하, 이 거리면 내 쪽이 더 유리하지. 세상이 많이 발전했지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/main2.ogg"},"메인3":{"voiceline":"늦더라도 반드시 찾아오는 것이 정의라고 하지만, 나는 늦는 건 좋아하지 않아. 그래, 늦어버린 정의에게도 이 녀석을 한 방 박아 넣어주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"드디어 이 강도 사건도 해결됐군. 술집 변상은 녀석들에게 맡기고…… 후후, 지휘관. 상금을 받을 준비는 됐나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 여기 있었군. 여기는 무슨 일이냐고? 아, 옥상에서 바로 내려오는 편이 직선거리라 가장 빠를 것 같았거든. 그래서 천장을 뚫어서 내려오기로 했지. 강도 녀석들은 내가 다 처리했으니, 안심하고 내게 맡겨라.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이런 삶이 피곤하면, 언젠가는 꼭 알차고 안정적인 생활을 꾸리자. ……크흠, 왜냐하면 내 버팀목이 되어주고, 내가 있을 곳을 만들어 준 건 바로 너니까…… 어쨌든 넌 내게 가장 소중한 사람이야! 알았으면 됐어! 계속 말하게 만들지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/feeling5.ogg"},"터치3":{"voiceline":"모자를 쓰고 있으니까 너무 만지지는 마라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/headtouch.ogg"},"모항귀환":{"voiceline":"일은 마무리하고 왔나? 자, 소고기 육포다. 단백질도 보충할 수 있고, 체력도 금방 회복될 거야. 한 입 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 조심해라. 건물이 낡아서 위험하니까, 발을 헛디뎌서 떨어지진 말라고. 아직 돈을 회수해서 은행에 돌려주지 못했으니까 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/login.ogg"},"실패":null,"우편":{"voiceline":"이 사방에 날아다니는 건…… 아. 지휘관, 여기 있군. 네 앞으로 온 우편이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/mail.ogg"},"임무":null,"임무완료":{"voiceline":"다 해치웠나? 잘했다, 지휘관! 축하하는 의미로 한잔하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"리볼버에 관심 있나? 후후, 역시 내 오랜 단짝답군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/touch.ogg"},"터치2":{"voiceline":"윽… 언제까지 만질 셈이냐! 아직 밖이라고……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/touch2.ogg"},"입수시":{"voiceline":"지휘관, 여기 있었군. 여기는 무슨 일이냐고? 아, 옥상에서 바로 내려오는 편이 직선거리라 가장 빠를 것 같았거든. 그래서 천장을 뚫어서 내려오기로 했지. 강도 녀석들은 내가 다 처리했으니, 안심하고 내게 맡겨라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"겨우 그 실력으로 강도질이냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105151/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"웨스턴","상점 id":71034,"상점 카테고리 id":25,"스킨 태그":"쁘띠모션, 배경","입수 영상":"X","재화":980,"기간":"한정 (2025/09/11)","진영":"USS","레어도":"SSR","ex_chat_status":0}]