[{"클뜯 id":302100,"클뜯 함순이 id":30210,"함순이 이름":"모가미","한글 함순이 + 스킨 이름":"모가미","영문 함순이 + 스킨 이름":"Mogami","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302100/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302100/shipyard.png","설명":"모가미급 중형 순양함 1번함 모가미","자기소개":{"voiceline":"나는 모가미급 네임쉽 전함모가미라고 한다...말이야 그렇지, 미드웨이섬과 레이터만에서 미쿠마와 나치을(를)저 모양으로 만들어서 네임쉽 전함의 자격은 없지만 말이야. 나치와(과) 충돌한 후 나도...하여간, 나한테 일을 맡기는건 상관없지만 큰 기대는 하지 않는게 좋을거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/profile.ogg"},"메인1":{"voiceline":"미쿠마지금은 뭘 해야 할지 모르겠어...하지만 쟤는 나랑 달라서 걱정할 필요 없을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/main1.ogg"},"메인2":{"voiceline":"정말 내가 비서를 해도 괜찮겠어? 나보다 훨씬 나은 사람들이 많이 있잖아?열심히 할거야, 도망 칠 생각은 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/main2.ogg"},"메인3":{"voiceline":"나치을(를) 본받아서 좀 더 밝아질 수 있도록 연습을...앗, 이런...생각이 입으로 나왔네...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/main3.ogg"},"전투개시":{"voiceline":"싸우고 싶지 않지만...지기도 싫어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/battle.ogg"},"상세확인":{"voiceline":"말을 안 할 때가 좀 멋있는 것 같다고?...너만 그렇게 생각하는 걸거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/detail.ogg"},"드랍 설명":{"voiceline":"모가미급 중형 순양함 1번함 모가미","voicelink":null},"의뢰 완료":{"voiceline":"의뢰에서 돌아오는 아이들 마중 나가게? 난 안 갈래, 괜한 충돌은 피해야...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/expedition.ogg"},"실망":{"voiceline":"어쨌든, 나같은 재수 옴붙은 사람도 이런 지휘관을 만날 수 있었으니...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/feeling1.ogg"},"낯섦":{"voiceline":"나같이 운 나쁜 사람이랑 왕래를 하고 싶어하다니, 너 정말 호기심이 왕성하구나. 뭐, 그냥 대화라면...괜찮겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/feeling2.ogg"},"호감":{"voiceline":"내 뿔 이야기 하니까 말인데...신경이 쓰이기는 하지만 이마에 자라 있으니 꽤나 눈에 띄잖아. 아무래도 인파 속에서 사람들이 이 뿔에 주목하는게 적응이 안되더라고...하...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/feeling3.ogg"},"기쁨":{"voiceline":"...나도 나치랑 미쿠마가 날 원망하지 않는다는 건 알아. 하지만 그래서 내 스스로를 더 용서할 수가 없어...후, 하지만 너랑 같이 있으면서 마음이 많이 편해졌어...뿔이 귀엽다고?!!!......바, 바보...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/feeling4.ogg"},"사랑":{"voiceline":"그게...지휘관...만약에...정말 만약에 말이야...괜찮다면...내...뿔 쓰다듬어 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"다들 무사하게 돌아왔으니, 잘 된거죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/home.ogg"},"hp 경고":{"voiceline":"내 나쁜 운이 모두를 해친거야...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/hp_warning.ogg"},"로그인":{"voiceline":"잘 돌아왔어. 응? 더 열정적으로? 그건 힘들겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/login.ogg"},"실패":{"voiceline":"내가 이정도인가...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/lose.ogg"},"우편":{"voiceline":"새로운 메일을 가져왔어. 여기 두면 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/mail.ogg"},"임무":{"voiceline":"임무 정리가 끝났어...이정도는 식은 죽 먹기지, 아마","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/mission.ogg"},"임무완료":{"voiceline":"임무 보상은 내가 가지러 갈게. 계속 일 하고 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/mission_complete.ogg"},"서약":{"voiceline":"나같은 사람을 선택하다니...정말 후회 안하겠어? 응, 알겠어. 이제부터 나도 너와 함께 앞으로 나아갈 수 있는 사람이 되기 위해 노력할게...어쨌든, 자, 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/propose.ogg"},"스킬":{"voiceline":"이번에는 실패하지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/skill.ogg"},"터치1":{"voiceline":"말 안해도 열심히 일 할거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/touch.ogg"},"터치2":{"voiceline":"응?!!!지, 지휘관, 나같은 사람한테 관심이...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/touch2.ogg"},"입수시":{"voiceline":"모가미, 착임했어. 난 신경쓰지 말고 그냥 내버려둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/unlock.ogg"},"강화성공":{"voiceline":"고마워...뭐, 왜, 내가 고맙다고 하는게 이상해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"나는 최고라고...뭐 불만 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['미쿠마'] : 미쿠마, 그래도 미안해...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/couple_encourage1.ogg"},{"voiceline":"['나치'] : 나치, 미안...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302100/couple_encourage2.ogg"},{"voiceline":"['후소'] : 후소언니, 끝나고 나서