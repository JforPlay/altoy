[{"클뜯 id":103120,"클뜯 함순이 id":10312,"함순이 이름":"뉴올리언스","한글 함순이 + 스킨 이름":"뉴올리언스","영문 함순이 + 스킨 이름":"New Orleans","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103120/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103120/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103120/shipyard.png","설명":"뉴올리언스급 중순양함——뉴올리언스, 현호 CA-32","자기소개":{"voiceline":"저는 뉴올리언스급의 네임쉽 뉴올리언스입니다. 언제나 이글 유니온의 일원으로 싸워왔어요. 무서운 일들을 겪었지만, 결국은 운좋게 버텨냈어요. 현재는… 저를 친한 함대의 일원으로 대해주시면 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/profile.ogg"},"메인1":{"voiceline":"골똘히 생각하는 것은 좋지만, 생각하다가 피곤함에 쓰러지시면 안됩니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/main1.ogg"},"메인2":{"voiceline":"함장에 추진 엔진을 더할 수 있다면… 크흠, 아니에요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/main2.ogg"},"메인3":{"voiceline":"뉴올리언스급 자매함들은 성격이 각자 다르지만, 모두 좋은 아이들이랍니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/main3.ogg"},"전투개시":{"voiceline":"승리의 영광은 우리의 것…！","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/battle.ogg"},"상세확인":{"voiceline":"함장을 체크해 주신다고요? 그럼 부탁드리겠습니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/detail.ogg"},"드랍 설명":{"voiceline":"뉴올리언스급 중순양함——뉴올리언스, 현호 CA-32","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 마친 동료가 돌아온 것 같네요. 지휘관님, 그들을 어떻게 챙겨줄지 생각하셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/expedition.ogg"},"실망":{"voiceline":"정말 어린 아이 같네요, 지휘관님…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/feeling1.ogg"},"낯섦":{"voiceline":"장비는 신체의 연장이니 잘 관리하지 않으면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/feeling2.ogg"},"호감":{"voiceline":"평상시의 오락 활동이요? 특별한 건 없는 것 같아요… 자매들과 수다떨기, 낚시, 잠자기… 같은 것 밖에는.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 기대고 있을 때, 오히려 일종의 안도감이 들어요… 후후, 좀 이상하지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/feeling4.ogg"},"사랑":{"voiceline":"어려운 일로 도움이 필요할 때도, 털어놓고 싶은 고민이 있을 때도, 제가 늘 곁에 있답니다. 지휘관님~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/feeling5.ogg"},"터치3":{"voiceline":"자매함들 조차도 이렇게 만져본 적은 없다구요. 헤헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 출격하신 동안 모항의 업무를 모두 정리했습니다. 확인해 주셔야할 내용들은 여기 있습니다. 살펴봐 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/home.ogg"},"hp 경고":{"voiceline":"맞지만 않는다면…. 별일 없습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/hp_warning.ogg"},"로그인":{"voiceline":"어서 오세요, 지휘관님. 뉴올리언스, 오늘도 성심성의껏 지휘관님을 위해 일하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/login.ogg"},"실패":{"voiceline":"신념이나 힘에만 의존하는 것으로는 안 돼요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/lose.ogg"},"우편":{"voiceline":"새로운 우편이 있습니다. \"우편 확인\"이라고 \"업무 목록\"에 적어둘게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/mail.ogg"},"임무":{"voiceline":"새로운 임무를 아직 완료하지 못했어요. 지휘관님, 제가 도와드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/mission.ogg"},"임무완료":{"voiceline":"임무 보상 점검을 끝냈습니다. 살펴봐 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/mission_complete.ogg"},"서약":{"voiceline":"이건 저에 대한 인정인가요? 아니면… 저에게 더 많이 의지하고 싶으신 건가요? 후훗… 어느 쪽이든, 지휘관님이 저에 대해 기대하고 있는 게 있다면, 뉴올리언스는 영원히 지휘관님 곁에 있을 거랍니다——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/propose.ogg"},"스킬":{"voiceline":"조준… 발사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/skill.ogg"},"터치1":{"voiceline":"스킨쉽이든지, 힘겨루기든지, 지휘관님을 안심시켜 드릴 수만 있다면 무엇이든 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/touch.ogg"},"터치2":{"voiceline":"후후후, 진지하게 힘을 겨룬다면, 지휘관님은 절 못 이기실 걸요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/touch2.ogg"},"입수시":{"voiceline":"중순양함, 뉴올리언스, 인사드립니다. 후훗, 저를 찾으셨으니, 훈장도 물론 빠져선 안되겠죠~ 그건 그렇고… 제가 처리해야 할 긴급 임무 같은 게 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/unlock.ogg"},"강화성공":{"voiceline":"저라면 이 힘을 잘 발휘할 수 있을 거라구요? 절 믿어주셔서 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"작전이란, 항상 상대방보다 몇 걸음 더 먼저 생각해야 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아스토리아'] : 좋은 본보기가 되어야죠, \"언니\"~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/couple_encourage1.ogg"},{"voiceline":"['퀸시'] : 너무 무리하지 마세요. 제가 도와줄게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/couple_encourage2.ogg"},{"voiceline":"['빈센스'] : 기운 내요~！","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/couple_encourage3.ogg"},{"voiceline":"['미니애폴리스'] : 미니, 사냥감의 반격을 조심해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/couple_encourage4.ogg"},{"voiceline":"['샌프란시스코'] : 지나치게 느긋해서는 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103120/couple_encourage5.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":103121,"클뜯 함순이 id":10312,"함순이 이름":"뉴올리언스","한글 함순이 + 스킨 이름":"만취하여 잔을 비우는 밤","영문 함순이 + 스킨 이름":"Evening Agricole","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103121/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103121/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103121/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103121/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103121/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103121/shipyard.png","설명":"지휘관님의 영광과 승리를 위해 건배~ 하하, 오늘밤은 뭔가 엄청 마시고 싶더라구요. 지휘관님께서 괜찮으시다면, 저랑 좀 더 있어 주시죠?","자기소개":null,"메인1":{"voiceline":"고마워요, 재블린. 이걸 위치타에게 전해 주세요. 좋은 거랍니다, 후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/main1.ogg"},"메인2":{"voiceline":"그런데… 왜 샌프란시스코는 지휘관님을 \"푸딩\"이라고 부르는 건가요? 지휘관님은…… 맛있어 보이는 것도 아닌데? 하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/main2.ogg"},"메인3":{"voiceline":"렉싱턴은 좋은 친구예요. 하지만 그녀의 동생은 꽤 상대하기 벅차네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"인형처럼 보이는 게 있는데, 눈에서 붉은 빛이 반짝이는 것 같아요…… 음…… 역시 너무 많이 마신 걸까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님의 영광과 승리를 위해 건배~ 하하, 오늘밤은 뭔가 엄청 마시고 싶더라구요. 지휘관님께서 괜찮으시다면, 저랑 좀 더 있어 주시죠?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"어서 오세요~ TV를 보면서 마시고 있었는데, 좀 취하는 것 같네요… 하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/home.ogg"},"hp 경고":null,"로그인":null,"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이상한 걸 숨겨두거나 하지 않았으니까, 마음 놓으세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/touch.ogg"},"터치2":{"voiceline":"지휘관님은 의외로… 어리광 피울 때가 많으시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/touch2.ogg"},"입수시":{"voiceline":"지휘관님의 영광과 승리를 위해 건배~ 하하, 오늘밤은 뭔가 엄청 마시고 싶더라구요. 지휘관님께서 괜찮으시다면, 저랑 좀 더 있어 주시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"후후, 술이 더욱 맛있어졌네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103121/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_e