[{"클뜯 id":608030,"클뜯 함순이 id":60803,"함순이 이름":"마조레 바라카","한글 함순이 + 스킨 이름":"마조레 바라카","영문 함순이 + 스킨 이름":"Maggiore Baracca","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/608030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/608030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/608030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/608030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/608030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/608030/shipyard.png","설명":"굴리엘모 마르코니급 잠수함 - 마조레 바라카","자기소개":{"voiceline":"마조레 바라카야. 아주 조~금 자극적인 걸 좋아하지만, 위험하지는 않을 정도로 즐기고 있으니까 걱정할 필요는 없어. 그렇지, 요즘은 지휘관한테 혼나고 싶어서 장난을 치고 있어. 왜냐하면 그게 더 흥분되니까. 그래도 선은 잘 지킬 테니까, 그 발끈하는 얼굴… 더 많이 보여 줘♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/profile.ogg"},"메인1":{"voiceline":"♪~~ 어디 갔었냐고? 여기 천장으로 올라갈 수 있는 틈이 있는데, 여기 있으면 집무실이 다 내려다보이거든. 같이 볼래? …응? 싫어? 그럼 나 혼자만의 일등석으로 간직해야겠다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/main1.ogg"},"메인2":{"voiceline":"오늘 임무, 너무 평범한 거 아니야? 더 짜릿한 거 없나…? 예를 들면 훈련할 때 어뢰 사선을 일부러 빗나가게 쏴서…… 훈련 계획은 없다고? 음… 그렇긴 하네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/main2.ogg"},"메인3":{"voiceline":"지휘관, 업무 서류를 다시 분류했어. 예전 분류 순서에서 조금 달라졌는데…… 어머, 날 혼내줄 이유가 생겨서 신나지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/main3.ogg"},"전투개시":{"voiceline":"기함? 갑자기 사라질 수도, 나타날 수도 있는 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/battle.ogg"},"상세확인":{"voiceline":"있잖아, 지휘관. 모항에 있는 「절대 들어가면 안 되는」 비밀 구역이나, 벽을 기어 올라가야 도달할 수 있는 건물의 정상 같은 데… 같이 가보지 않을래? 응, 내가 있으니까 다칠 걱정은 안 해도 돼♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/detail.ogg"},"드랍 설명":{"voiceline":"굴리엘모 마르코니급 잠수함 - 마조레 바라카","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어. 지휘관, 동료들을 마중하러 나가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/expedition.ogg"},"실망":{"voiceline":"실수해도 화를 안 내네…… 좀 실망스러운걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/feeling1.ogg"},"낯섦":{"voiceline":"어머, 지휘관은 내 「장난」에 별 반응이 없네. 그럼 더 과감하게 저질러 볼까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/feeling2.ogg"},"호감":{"voiceline":"지휘관, 요즘 들어 점점 더 재밌어지네. 혹시 내가 뭘 원하는지 알아채기 시작한 거야? 후후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/feeling3.ogg"},"기쁨":{"voiceline":"요즘은 지휘관한테 혼날 때뿐만 아니라, 웃는 얼굴을 보여줄 때도…… 후후후, 이렇게 두근거리는 느낌은… 처음이야♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/feeling4.ogg"},"사랑":{"voiceline":"지휘관이랑 같이 있으면 자극적인 일이 없어도 두근거리네…… 그래도 역시 장난치거나 놀려주고 싶어. 후후후, 왜냐하면 날 귀여워해 주는 게 너무 좋은걸♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/feeling5.ogg"},"터치3":{"voiceline":"아…? 조금 실망스럽…… 아니, 칭찬해 줘서 고마워! 뭐… 그래……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/headtouch.ogg"},"모항귀환":{"voiceline":"있잖아, 지휘관. 지난번에 내가 작전대로 안 움직였잖아? 그러니까…… 결과적으로 괜찮았으니까, 벌은 생략하겠다고? 그래……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/home.ogg"},"hp 경고":{"voiceline":"이번에야말로 정말로 돌아올 수 없는 함선이…… 에이, 설마♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/hp_warning.ogg"},"로그인":{"voiceline":"어머, 지휘관. 빨리 왔네. 후훗, 지휘관이 없을 때 서류를 이렇게 「정리」해 주려고 했는데…… 들켰으니 어쩔 수 없이 벌을 받아야겠네♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/login.ogg"},"실패":{"voiceline":"호, 혹시 지휘관한테 벌받으려나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/lose.ogg"},"우편":{"voiceline":"지휘관, 우편을 가지고 왔어. 후후후, 이상한 짓은 아무것도 안 했어. 그래, 아·무·것·도♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있는 것 같네. 처리 시간에 제한을 좀 걸어보는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/mission.ogg"},"임무완료":{"voiceline":"무사히 임무가 완료된 모양이네. 그래서 보상은…… 어디 숨겨야 벌을 내려주려나…? ♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/mission_complete.ogg"},"서약":{"voiceline":"어머, 이번에는 진심이야? 어휴~ 진짜 잡혀버렸네. 혼내면서 이런 말을 꺼내다니, 너무한 거 아니야? 여기서 내가 싫다고 하면…… 더 엄하게 대해주려나…? 하나만 고르기 어려운데… 좋아, 받아줄게♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/propose.ogg"},"스킬":{"voiceline":"위기 단계를 더 끌어 올려야 해…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/skill.ogg"},"터치1":{"voiceline":"지휘관…… 이 정도로는 한참은 부족해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/touch.ogg"},"터치2":{"voiceline":"읏…… 지휘관도 참, 대담하네…… 어머, 지금 벌을 내려주는 거야? 그럼 계속해 줘…♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/touch2.ogg"},"입수시":{"voiceline":"지휘관, Ciao~ 나는 마조레 바라카야. 바라카라고 부르면 돼. 후후, 너랑은 즐겁게 잘 지낼 수 있을 것 같네♪ 친하게 지내자구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/unlock.ogg"},"강화성공":{"voiceline":"후후후, 누구는 이제 큰일 났네. …어머, 당연히 적들 말하는 거지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후, 그냥 감으로 싸우는 편이 더 효율적이라고 내가 그랬지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/608030/win_m