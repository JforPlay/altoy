[{"클뜯 id":406020,"클뜯 함순이 id":40602,"함순이 이름":"엘베","한글 함순이 + 스킨 이름":"엘베","영문 함순이 + 스킨 이름":"Elbe","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/406020/shipyard.png","설명":"야드급 항공모함—엘베","자기소개":{"voiceline":"메탈 블러드 소속, 개장 항공모함인 엘베에요! 그 전쟁에서는 사쿠라 엠파이어로 싸운 자매 함선과 마찬가지로, 나중에 항공모함으로 개장되어 대활약을 선보……이지 못했어요! 여, 역시 거짓말은 나쁜 거니까요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/profile.ogg"},"메인1":{"voiceline":"지휘관~ 지금 펜 찾고 있었죠? 후후후, 사실은 제가 여기에 감춰뒀답니다! ……어제 잊어버린 건데 찾아줘서 고맙다니…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/main1.ogg"},"메인2":{"voiceline":"히요와 준요를 다음 다과회에 초대하려고……. 어머, 안된다구요? 왜죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/main2.ogg"},"메인3":{"voiceline":"이 하, 하등 생물, 당장 이 엘베님 앞에서 사라져…… 역시 지휘관에게 그런 심한 말은 못하겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/main3.ogg"},"전투개시":{"voiceline":"패배를 안겨드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/battle.ogg"},"상세확인":{"voiceline":"흥, 이런 기본적인 예의범절도 모르시다니, 야만스러운 지휘관이라 난감하네요. 제가 좋은 집안에서 자란 것 같다구요……? 아니에요! 전 나쁜 아이라구요! 나・쁜・아・이!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/detail.ogg"},"드랍 설명":{"voiceline":"야드급 항공모함—엘베","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔네요. 지휘관은 저를 맘대로 부릴 수 있을만한 사람은 아닌 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/expedition.ogg"},"실망":{"voiceline":"정말 하등한 생물이군요, 지휘관은.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/feeling1.ogg"},"낯섦":{"voiceline":"후후후, 지휘관을 어떻게 주무를지…… 기대되서 참을 수가 없네요. 메탈 블러드의 방식을 잘 지켜보시라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/feeling2.ogg"},"호감":{"voiceline":"이런 일을 지휘관에게 휙 던져버리면, 지휘관은 곤란해할까요……. 그래요, 무척 곤란해할 거예요! 저, 정말 지휘관을 난처하게 만들어도 괜찮아요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/feeling3.ogg"},"기쁨":{"voiceline":"엘베는 나쁜 아이니까, 지휘관을 점점 더 곤란하게 만들 거예요! 자, 각오해두세요♪ ……오, 오늘은 바쁘니까 곤란하게 만들지 말라구요? 으…… 알겠어요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/feeling4.ogg"},"사랑":{"voiceline":"오늘은 만족할 때까지 지휘관을 곤란하게 만들 거예요! 진짜 만족하는 쪽은 누구냐니……. 그, 그야 지휘관…… 아니아니! 엘베가! 만족할 때까지! 지휘관과 함께 있고 싶다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/feeling5.ogg"},"터치3":{"voiceline":"바, 바보 같은 사람…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/headtouch.ogg"},"모항귀환":{"voiceline":"돌아오셨군요! 흥, 수고하셨으니 이거라도 드세요! 어때요? ……마, 맛이 어떻냐고 물어본 건 아니라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/home.ogg"},"hp 경고":{"voiceline":"지, 지금부터라구요……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이에요, 지휘관. 오늘은 어디로 출격할 거죠? 어서 알려줘요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/login.ogg"},"실패":{"voiceline":"분해요! 지휘관! 지휘관~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/lose.ogg"},"우편":{"voiceline":"우편이네요. 언제 읽으실 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/mail.ogg"},"임무":{"voiceline":"어머~ 임무 완수를 못해서 반성문을 쓰고 계시다니♪ 열심히 그 머리를 굴려보세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/mission.ogg"},"임무완료":{"voiceline":"여, 여기, 임무 보상이에요! (작은 목소리로) 일부러 보고 늦게한 건 아니에요……. 반성문 쓰게 해주실 거에요?! 신난다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/mission_complete.ogg"},"서약":{"voiceline":"앗…… 이, 이건 맹세의 반지인가요?! 서, 설마 지금 지휘관, 엘베에게 고백을……. 기, 기죽지 마세요! 거절 안 해요! 거절하는 거 아니라구요! 엘베도 지휘관이 좋아요! 너무 좋아한다구요~!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/propose.ogg"},"스킬":{"voiceline":"벌이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/skill.ogg"},"터치1":{"voiceline":"맘대로 만지면 안 돼요♪ 자, 제게 먼저 허락을 구해야죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/touch.ogg"},"터치2":{"voiceline":"뭐뭐뭐뭐뭐하시는 거예요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/touch2.ogg"},"입수시":{"voiceline":"저는 야드급 항공모함, 엘베입니다. 당신이 바로 이 함대의 지휘관인가요? 흠, 승리를 가져온 저에게 먼저 인사를 시키시다니 정말 보통이 아니시군요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/unlock.ogg"},"강화성공":{"voiceline":"흐흠~! 또 강해졌어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"무릎 꿇어라! 라구요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"가끔 생각하는 건데, 지휘관이 커피를 내려주는 건 이상하지 않나요? 제가 아무리 나쁜 아이라고 해도, 그래도 지휘관은 제 상사시고……. 그게…… 그렇다고 설탕 빼시면 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/406020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":