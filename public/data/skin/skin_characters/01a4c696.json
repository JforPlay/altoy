voiceline/403036/main2.ogg"},"메인3":{"voiceline":"이 \"터치다운\"은 다른 용도로도 쓸 수 있지 않을까? 예를 들면 이렇게… 지휘관 위에 올라타서… 후후, 아하하하하♪ 얼굴이 새빨개졌네. 이거 내가 점수 하나 낸 거 맞지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"생각보다 격렬한 스포츠네… 움직이기 편한 옷으로 막 갈아입었는데, 벌써 이렇게 흠뻑… 지휘관, 뭐 좋은 아이디어 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/detail.ogg"},"드랍 설명":{"voiceline":"하아… 하아… 쿼터백 프린츠 오이겐, 이걸로 한 점 냈어. 설마 내가 돌격하게 될 줄이야… 지휘관, 물이랑 수건 좀 가져다 줄래? 땀 때문에 몸이 좀 끈적끈적해…","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 끝났다고? 지난번에 부탁한 스포츠 음료도 왔으려나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"아까부터 뚫어져라 보는데… 혹시 지휘관, 같이 트레이닝하자고 초대받는 게 목적이었어? 그럼… 앞으로는 이렇게… 더 많이 \"터치다운\"을 같이 연습…하자구♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"하아… 으음~ 어서 와, 지휘관. 사실 나도 트레이닝을 마친지 얼마 안 되서, 온몸이 땀으로 끈적끈적해… 우후후, 있잖아… 상쾌하게 같이 샤워라도 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"후우… 지휘관, 왔구나. 그나저나 출전할 때 구호는 \"Mutig(용기), Stark(힘), Siegesklar(승리)!\"로 해도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/login.ogg"},"실패":null,"우편":{"voiceline":"왜 이럴 때…… 누가 보낸 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/mail.ogg"},"임무":{"voiceline":"흐음… 아직 완료하지 않은 트레이닝이 있나 보네? 나도 같이 확인하는 편이 좋으려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/mission.ogg"},"임무완료":{"voiceline":"우후후, 시합 보상만큼 많지는 않지만, 임무 보상도 잊지 말고 꼭 받아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"마사지? 뭐, 나는 괜찮은데. 지휘관은 내가 땀으로 푹 젖었는데 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/touch.ogg"},"터치2":{"voiceline":"지휘관… 아직 시합 중이야. 적어도 쉬는 시간까지는 참아야지♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/touch2.ogg"},"입수시":{"voiceline":"하아… 하아… 쿼터백 프린츠 오이겐, 이걸로 한 점 냈어. 설마 내가 돌격하게 될 줄이야… 지휘관, 물이랑 수건 좀 가져다 줄래? 땀 때문에 몸이 좀 끈적끈적해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403036/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"스포츠","상점 id":70996,"상점 카테고리 id":13,"스킨 태그":"배경, 쁘띠모션","입수 영상":"X","재화":980,"기간":"한정 (2025/04/02)","진영":"KMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":403037,"클뜯 함순이 id":40303,"함순이 이름":"프린츠 오이겐","한글 함순이 + 스킨 이름":"취기와 밀당 사이","영문 함순이 + 스킨 이름":"Between Tipsiness and a Wager","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403037/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403037/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403037/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403037/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403037/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403037/shipyard.png","설명":"지휘관, 꽤 즐거워 보이네? 후후, 다음엔 어떤 재미있는 모습을 보여주려나…… 나? 신경 쓰지 마. 취한 네 민낯을 실컷 구경할 테니까♪","자기소개":null,"메인1":{"voiceline":"흐음? 지휘관은 전혀 취하지 않은 것 같네…… 슬슬 네 진심을 보여줄래? ♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/main1.ogg"},"메인2":{"voiceline":"여기 분위기, 나쁘지 않지? 게다가…… 둘뿐이니까 몸을 사릴 필요도 없잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/main2.ogg"},"메인3":{"voiceline":"여러 술을 섞어 마시면 금방 취한다고들 하는데…… 시험할 생각은 접어두도록 해. 후훗, 서로에게 기분 좋게 취한 모습만 보여주자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관이 이렇게 술이 셀 줄은 솔직히 몰랐어…… 아니, 나는 그저 지휘관만의 바니걸이야. 우후후, 그건 그렇고… 한 잔 더 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 꽤 즐거워 보이네? 후후, 다음엔 어떤 재미있는 모습을 보여주려나…… 나? 신경 쓰지 마. 취한 네 민낯을 실컷 구경할 테니까♪","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"Es ist interessant(흥미로워)…… 후후후, 너처럼 앞뒤가 똑같은 사람은 드물거든. 자, 이쪽으로 와. 좀 더 깊게 「관찰」하게 해줘……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/feeling5.ogg"},"터치3":{"voiceline":"주의를 돌리려고? ……후훗, 그렇게 쉽게 넘어갈 줄 알았다면 큰 오산이라구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔네? 그럼 계속해 볼까. 위스키를 몇 종류 골라뒀어. ……자, 첫 잔은 어떤 걸로 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"예전에…… 내가 취한 모습, 본 적 있지? 그러니까 이번에는 내가 관찰할 차례야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"어느새 이렇게 가까워졌네…… 후후, 이 거리, 관찰하기에 딱 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/touch.ogg"},"터치2":{"voiceline":"드디어 진정한 자신을 보여줄 마음이 생긴 거야? Nicht schlecht(나쁘지 않네)……♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/touch2.ogg"},"입수시":{"voiceline":"지휘관, 꽤 즐거워 보이네? 후후, 다음엔 어떤 재미있는 모습을 보여주려나…… 나? 신경 쓰지 마. 취한 네 민낯을 실컷 구경할 테니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"축하하는 의미로 한 병 딸까? 전부 마셔줄 거지? 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403037/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"카니발","상점 id":71275,"상점 카테고리 id":16,"스킨 태그":"L2D+, 배경","입수 영상":"O","재화":1260,"기간":"한정 (2026/01/21)","진영":"KMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":403038,"클뜯 함순이 id":40303,"함순이 이름":"프린츠 오이겐","한글 함순이 + 스킨 이름":"운명의 교향곡","영문 함순이 + 스킨 이름":"Symphonic Fate","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403038/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403038/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403038/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403038/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403038/shipyard.png","설명":"당신과 만난 게 운명이라면, 이 운명에 감사해야겠지…앞으로도 기대할게, 우후훗","자기소개":null,"메인1":{"voiceline":"하아……힘이 안 들어가…지휘관에게 키스