[{"클뜯 id":502080,"클뜯 함순이 id":50208,"함순이 이름":"하이치","한글 함순이 + 스킨 이름":"하이치","영문 함순이 + 스킨 이름":"Hai Chi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502080/shipyard.png","설명":"하이티엔급 방호순양함—하이치","자기소개":{"voiceline":"하이티엔급 방호순양함 2번함인 하이치야. 성격도 취미도, 하이티엔 언니랑은 완전 달라. 언니는 서재에서 책 읽는 걸 좋아하지만, 나는 밖을 돌아다니거나 여행을 하는게 더 좋아! \"만권의 독서는 만리의 여행길에 미치지 못한다\"고 하잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/profile.ogg"},"메인1":{"voiceline":"지휘관, 이스트 글림의 경극에 관심 있어? 으흠! 그럼~ 어디 한 판 보여 드리리다~ 어느 것을 보고 싶은 지~ 알려 주시게나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/main1.ogg"},"메인2":{"voiceline":"소극적인 언니와는 다르게, 난 느낀 그대로를 솔직하게 말해야 직성이 풀려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/main2.ogg"},"메인3":{"voiceline":"\"군자의 복수는 10년이 지나도 늦지 않다\"는 이스트 글림의 속담이 있지만, 내 생각은 달라! 다른 사람을 괴롭히는 나쁜 녀석들을 가만히 두면, 아주 머리 끝까지 기어 올라올 걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/main3.ogg"},"전투개시":{"voiceline":"전군 출진! \"일망타진\"이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/battle.ogg"},"상세확인":{"voiceline":"지휘관도 고양이 좋아해? 고양이는 엄청 똑똑한 거 알아? 뭘 골라야 할 지 잘 모를 때 고양이한테 맡기면 의외로 잘 풀릴지도 몰라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/detail.ogg"},"드랍 설명":{"voiceline":"하이티엔급 방호순양함—하이치","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조 동료들이 돌아온 모양이야! 간식도 준비해뒀어! \"군량 보충은 승리의 지름길\"이니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/expedition.ogg"},"실망":{"voiceline":"흥, 네가 한 짓…… 다 기억해 뒀다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/feeling1.ogg"},"낯섦":{"voiceline":"이번 여행에서 하이티엔 언니한테 줄 선물은 뭘로 할까……. 맞아! 역시 평소처럼 맛있는 음식이 좋겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/feeling2.ogg"},"호감":{"voiceline":"인생에서 어려운 결단을 내려야 할 순간이 오면, 이 창의 움직임처럼, 흐르는 구름과 강물처럼 일망타진하면 돼! ……흡! 하압!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 이스트 글림에는 \"휴식은 곧 회복\"이라는 말이 있어. 적당히 휴식을 취해줘야 능률이 올라가는 법이야! 말 나온 김에…… 나랑 바로 여행이라도 갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/feeling4.ogg"},"사랑":{"voiceline":"생각하는 걸 그대로 내뱉는 성격이라, 혹시 나도 모르는 새에 상처를 준 적이 있으면 미안해……! 뭐, 지휘관이랑은 하루 이틀 알고 지낸 사이도 아니고, 이미 익숙해졌겠지만. 에헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/feeling5.ogg"},"터치3":{"voiceline":"지휘관, 내 이마에 있는 머리 장식 잘 어울려? 아, 건드리면 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 고생 많았어! 이번엔 먼곳까지 다녀온 거야? 뭐 재밌는 일이라도 있었어? 없었어? 빨리 알려줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/home.ogg"},"hp 경고":{"voiceline":"큭……. 얕잡아 보지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/hp_warning.ogg"},"로그인":{"voiceline":"지휘관~ \"학문은 근면함으로 조예가 깊어지고 게으름으로 뒤떨어진다.\"고 해. 지휘관, 오늘도 힘내자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/login.ogg"},"실패":{"voiceline":"으으…… 기억해두겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/lose.ogg"},"우편":{"voiceline":"지휘관, 파발마로부터 연락이…… 자, 우편이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/mail.ogg"},"임무":{"voiceline":"새로운 임무야! 원양 항해는 내게 맡겨둬!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/mission.ogg"},"임무완료":{"voiceline":"임무 완료야! 휴식 시간에 경극 감상 한 편 어떠신지~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/mission_complete.ogg"},"서약":{"voiceline":"와아! 이걸 나한테? 헤헤헷, 걱정 붙들어 매! 오늘 선택은 절대 후회하지 않게 해줄 테니까! 가사 노동이라면 누구에게도 지지 않을 자신이 있다구, 나! 좋았어! 그럼 이렇게 됐으니, 우선은 효율적으로 \"허니문\" 짐 정리부터 시작하도록 할까?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/propose.ogg"},"스킬":{"voiceline":"하압! 낙화유수의 형벌을 받아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/skill.ogg"},"터치1":{"voiceline":"지휘관! 무슨 일 있으면 사양 말고 말해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/touch.ogg"},"터치2":{"voiceline":"지휘관, 하이티엔 언니한테 다 이를 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관? 얘기 많이 들었어~ 아, 소개를 깜빡할 뻔했네! 나는 하이티엔급 순양함 하이치야. 경극과 여행을 좋아해…… 우선 이런 건 둘째칠게, 어차피 지휘관은 곧 나를 알게 될 거니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/unlock.ogg"},"강화성공":{"voiceline":"\"전투 직전에 칼을 갈면, 무뎌도 빛은 난다\"고 했지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"내가 나서면 막을 수 있는 적은 아무도 없지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"그래서 오늘은 어디 갔었어? 지휘관이 보고 들은 걸 들을