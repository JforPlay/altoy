[{"클뜯 id":905030,"클뜯 함순이 id":90503,"함순이 이름":"가스코뉴(μ장비)","한글 함순이 + 스킨 이름":"가스코뉴(μ장비)","영문 함순이 + 스킨 이름":"Gascogne μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/905030/shipyard.png","설명":"가스코뉴, 모듈 변경 완료. 명령 변경: 모든 이들에게 노래를——주인의 소망대로.","자기소개":{"voiceline":"본 형태는 가스코뉴를 위한 특별 프로토콜. 전투 적응 및 가창 활동을 위해 특수한 패러미터 조정과 개량을 진행. 각종 패러미터의 참고 가치 없음. 가스코뉴에 관한 참고 사항은 표준 전투 모드를 참조.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/profile.ogg"},"메인1":{"voiceline":"데이터 베이스에 노래로 세상을 구한다는 기록에 대한 논리적 검증 실시. 가스코뉴의 최종 목표에 해당한다고 판단.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/main1.ogg"},"메인2":{"voiceline":"가스코뉴, 노래에 ‘감정’을 싣는 행위의 의미를 판단할 수 없다. 진정으로 사람을 감동시키는 것은 ‘감정’을 담은 노래. 주인, 가스코뉴의 노래를 평가해주기를 희망.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/main2.ogg"},"메인3":{"voiceline":"가스코뉴, 감정 모듈로 인해 실제 속성과 홍보 자료의 ‘쿨계’ 사이에 차이가 발생.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/main3.ogg"},"전투개시":{"voiceline":"작전 프로토콜——코드명: 아이돌, 가동.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/battle.ogg"},"상세확인":{"voiceline":"질문. 주인이 좋아하는 노래는 어떤 것인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/detail.ogg"},"드랍 설명":{"voiceline":"가스코뉴, 모듈 변경 완료. 명령 변경: 모든 이들에게 노래를——주인의 소망대로.","voicelink":null},"의뢰 완료":{"voiceline":"가스코뉴, 항구에서 돌아온 의뢰조를 위한 공연을 할 것을 제안.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/expedition.ogg"},"실망":{"voiceline":"가스코뉴의 능력 향상에 주인의 능력이 부족하다고 판단. 자가 육성 모드 가동. 주인, 가스코뉴에게 간섭하지 말 것을 부탁한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/feeling1.ogg"},"낯섦":{"voiceline":"가스코뉴, 이미 아이돌 관련 자료를 전부 숙지. 아이돌이라는 직업에 관한 학습을 완료. 아이돌은 노래로 전쟁을 멈출 수 있는 강력한 힘을 가진 존재.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/feeling2.ogg"},"호감":{"voiceline":"스테이지 위에서 ‘감정’에 큰 기복이 생기는 것을 감지했다. 주인, 이것은 무슨 현상인가? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/feeling3.ogg"},"기쁨":{"voiceline":"아이돌 활동에는 확실한 전략적 의미가 존재. 오늘의 작전 임무 종료 후 아이돌 활동을 계속 수행할 것을 신청한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/feeling4.ogg"},"사랑":{"voiceline":"가스코뉴, ‘아이돌’의 정의에 관한 학습을 완료. ‘감정’ 개방 및 자신의 기능에 조정이 필요하다고 판단. 주인, ‘잘 부탁드립니다.’","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"레슨 완료를 확인. 결과 확인을 요청한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/home.ogg"},"hp 경고":{"voiceline":"전투 프로토콜 교체 완료.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/hp_warning.ogg"},"로그인":{"voiceline":"보컬, 댄스, 비주얼—— 주인, 가스코뉴의 오늘 스케쥴 설정을 요청한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/login.ogg"},"실패":{"voiceline":"주인. 작전 프로토콜 즉시 중지, 표준 전투 모드를 요청한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/lose.ogg"},"우편":{"voiceline":"주인, 새로운 카메라 테스트 요청이 확인. 참여 여부 결정을 부탁. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/mail.ogg"},"임무":{"voiceline":"촬영, 공연, 라디오. 가스코뉴의 오늘 스케쥴 설정을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/mission.ogg"},"임무완료":{"voiceline":"보고. 아이돌 활동으로 가스코뉴의 아이돌 능력이 상승. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/mission_complete.ogg"},"서약":{"voiceline":"아이돌이란 내일을 위한 희망, 바라지 않는 미소, 청춘과 열정——전투 외에도 의미 있는 일이 많음을 이해. 감사합니다. 친애하는 주인님. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/propose.ogg"},"스킬":{"voiceline":"모두 가스코뉴의 노래를 들어봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/skill.ogg"},"터치1":{"voiceline":"가스코뉴, 오늘의 레슨을 수행 중.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/touch.ogg"},"터치2":{"voiceline":"경고. 아이돌에게 과도한 스킨십은 불필요. 고의적인 접촉은 ‘성희롱’으로 간주될 가능성 높음.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/touch2.ogg"},"입수시":{"voiceline":"가스코뉴, 모듈 변경 완료. 명령 변경: 모든 이들에게 노래를——주인의 소망대로.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/unlock.ogg"},"강화성공":{"voiceline":"현 프로토콜 강화는 아이돌 활동에 도움이 되지 않는 것으로 판단.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"새로운 작전 프로토콜, 효과 있음을 확인. 가스코뉴, 전장에서 계속 노래하겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"질문, 주인은 가스코뉴의 라이브를 좋아하십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"가스코뉴, 돌아온 의뢰조에게 노래를 불러주어도 괜찮겠습니까…？","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/905030/expedition_ex.ogg"},"사랑_ex":{"voiceline":"가스코뉴, ‘아이돌’의 정의에 관한 학습을 완료. 무대에서 빛나기 위해, 감정을 담은 ‘노래’를 모두에게 전달하기 위해, 가스코뉴의 모든 기능을 이용하기로 결정. 주인, ‘고맙습니다.’","voiceli