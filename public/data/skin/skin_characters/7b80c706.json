[{"클뜯 id":9713010,"클뜯 함순이 id":971301,"함순이 이름":"에레버스·META","한글 함순이 + 스킨 이름":"에레버스·META","영문 함순이 + 스킨 이름":"Erebus META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9713010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9713010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9713010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9713010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9713010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9713010/shipyard.png","설명":"에레버스, 당신의 부름을 받고 이곳으로 왔어. ……안심해. 이건 악몽이 아니라 운명이 내린 연민이야. 자, 어서 계약을 맺고 어둠의 동반자가 되도록 해.","자기소개":{"voiceline":"옛 전투'로 깊은 상처를 입었지만, 엘리자베스 님께서 포기하지 않으셨기에 이런 모습으로나마 계속 싸울 수 있었어… 그래서 난 엘리자베스 님처럼 동료들에게 할 수 있는 모든 걸 다 해주고 싶어. 응.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/profile.ogg"},"메인1":{"voiceline":"…내가 더 선배 같다고? 이런 모습이 되기 전부터 엘리자베스 님과 함께 어깨를 나란히 하고 싸워왔으니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/main1.ogg"},"메인2":{"voiceline":"모항은 좋은 곳이네. 머리를 텅 비우고 하루 종일 잔디밭에 누워 햇볕을 쬐기도 하고… 이게 바로 '집'이라는 건가? 그리운 말이네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/main2.ogg"},"메인3":{"voiceline":"'로맨스'라… 글쎄, 조마조마하고 두근거리는 악몽 같은 상황에서 사랑을 고백하는 거 아닐까? …너무 좀 소녀 느낌인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/main3.ogg"},"전투개시":{"voiceline":"암흑을 비추는 무수한 별들이여――","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/battle.ogg"},"상세확인":{"voiceline":"해결사'? 그래, 동료들에게는 그렇게 불리고 있었어. 항상 난 마지막에 전장에 나섰으니까…… 착각하지 마, 지휘관. 지금 무거운 이야기 하는 거 아니니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/detail.ogg"},"드랍 설명":{"voiceline":"에레버스호 모니터함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"동료들이 모두 무사히 돌아왔어… 이젠 안심할 수 있겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/expedition.ogg"},"실망":{"voiceline":"지휘관… 너무 바빠서 머리가 어떻게 된 건…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/feeling1.ogg"},"낯섦":{"voiceline":"뭐랄까, 나랑 지휘관은 닮은 것 같다는 생각이 들어. …그래, 항상 남의 뒷바라지만 한다는 점에서 말이야. …아니, 딱히 귀찮지는 않아. 오히려 이건 내 일상 같은 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/feeling2.ogg"},"호감":{"voiceline":"지휘관, 일이란 건 원래 끝이 없어. 그러니까 하루하루를 소홀히 해서는 안 돼. 동료들과 보내는 시간은 소중하고 무엇과도 바꿀 수 없으니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/feeling3.ogg"},"기쁨":{"voiceline":"커피 내릴게. …졸음을 깨서 머리를 맑게 하고 싶다고? 음… 그러려면 커피보다는 귀신의 집이 더 좋을 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/feeling4.ogg"},"사랑":{"voiceline":"…설마 정말 여기―― '에레버스'의 어둠의 영역으로 찾아올 줄이야. 여긴 귀신의 집, 업무의 지루함을 해소하기에는 딱 좋은 장소지. 지휘관, 따라와. 맑은 정신으로 악몽 속을 산책하는 것도 꽤 낭만적이거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/feeling5.ogg"},"터치3":{"voiceline":"……기분 좋아. 응.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 평화로운 세계로 돌아온 걸 환영해. 이 멋진 순간을 마음껏 누려.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/home.ogg"},"hp 경고":{"voiceline":"망자는 지금, 격앙되어 있어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/hp_warning.ogg"},"로그인":{"voiceline":"……어서 와, 지휘관. 자는 얼굴이 귀엽더라. 책상에 엎드려 있지 않았더라면 더 좋았을 텐데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/login.ogg"},"실패":{"voiceline":"어둠은 머지않아 돌아올 거야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/lose.ogg"},"우편":{"voiceline":"우편은… 멋진 추억과 간절한 바람이 담겨 있는 것… 그러니까 가볍게 여기지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/mail.ogg"},"임무":{"voiceline":"새로운 임무야… 괜찮아. 머나먼 세상에서 온 의뢰는 아니니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/mission.ogg"},"임무완료":{"voiceline":"보상 확인하는 거 잊지 마. 받아 놓고 괜히 손해 보지 말고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/mission_complete.ogg"},"서약":{"voiceline":"여기서 약속을 주고받는 거구나… 응, 당신 마음은 잘 알고 있어. 그럼… 지휘관, 어둠이 지켜보는 가운데 우리의 맹세를…… 당신이 빛이 내리쬐는 곳에 있는 한, 그림자는 늘 당신 곁에……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/propose.ogg"},"스킬":{"voiceline":"안식을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/skill.ogg"},"터치1":{"voiceline":"어깨에 힘 빼도 돼. 나는 계속 여기 있을 테니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/touch.ogg"},"터치2":{"voiceline":"…유체 이탈할 정도의 '특별 서비스', 시도해 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/touch2.ogg"},"입수시":{"voiceline":"에레버스, 당신의 부름을 받고 이곳으로 왔어. ……안심해. 이건 악몽이 아니라 운명이 내린 연민이야. 자, 어서 계약을 맺고 어둠의 동반자가 되도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/unlock.ogg"},"강화성공":{"voiceline":"더 강한 힘… 더 순수한 어둠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"계약에 따라 그 영혼은 내가 거둘게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9713010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex"