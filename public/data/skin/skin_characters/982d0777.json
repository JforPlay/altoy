raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101472/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101472/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101472/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101472/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101472/shipyard.png","설명":"여긴 닌자 수련 장면 촬영에 딱 어울리는 곳이네요…… 으흠! 지휘관님께 인술을 하나 보여드리죠! ……자, 잘 지켜봐 주세요…! 변신술! 얍!","자기소개":null,"메인1":{"voiceline":"곰돌이 홀로그램은 아직 완성이 안 돼서…… 지금은 불러낼 수 없어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/main1.ogg"},"메인2":{"voiceline":"변화술…… 소환술…… 수둔…… 토둔…… 그냥 버튼 하나면 되는데, 왜 굳이 소리 내서 말해야 하는 걸까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/main2.ogg"},"메인3":{"voiceline":"……이 의상이요? 이카즈치랑 이나즈마가 추천해준 프로 닌자 복장이에요…… 조금 부끄럽긴 해도…… 꽤 닌자 같지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"「혹독한 수련 끝에, 닌자 모리슨은 중요한 전투에서 역경을 딛고 자신의 가치를 증명해냈다……」 ――아, 지휘관님. 대본을 읽고 있었어요…… 인술 시범… 계속해서 보여드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/detail.ogg"},"드랍 설명":{"voiceline":"여긴 닌자 수련 장면 촬영에 딱 어울리는 곳이네요…… 으흠! 지휘관님께 인술을 하나 보여드리죠! ……자, 잘 지켜봐 주세요…! 변신술! 얍!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"사실…… 변화술로 나오는 「조금 다른 모리슨」은 제가 생각한 거예요…… 「갭」이 있으면 설렌다는 말을 들어서…… 으음… 지휘관님…… 어, 어떠세요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/feeling5.ogg"},"터치3":{"voiceline":"후우…… 이 침착한 분위기…… 확실히…… 마음을 수련하기에는…… 딱 좋은 환경이네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/headtouch.ogg"},"모항귀환":{"voiceline":"「어서 오시지요, 지휘관공. 닌자 모리슨, 언제든 명령만 주시면……」 으아…… 너무 부끄러워요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"뜻은 마음을 따르고, 그림자는 뜻을 따른다…… 음, 다음은 뭐더라…… 천변만화…… 변화무쌍……? 어라…? 아무 일도 안 일어나네…… 아! 드론 배터리가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이 인술 시뮬레이터는 소브라지텔니가 개발한 거고, 드론은 파고가 제공해줬어요…… 다들 정말 대단해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/touch.ogg"},"터치2":{"voiceline":"꺄악……! 그, 그건…… 인술이 아니에요……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/touch2.ogg"},"입수시":{"voiceline":"여긴 닌자 수련 장면 촬영에 딱 어울리는 곳이네요…… 으흠! 지휘관님께 인술을 하나 보여드리죠! ……자, 잘 지켜봐 주세요…! 변신술! 얍!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101472/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"닌자의 성","상점 id":71213,"상점 카테고리 id":28,"스킨 태그":"중파 일러, 배경","입수 영상":"O","재화":930,"기간":"한정 (2025/10/15)","진영":"USS","레어도":"SR","ex_chat_status":0}]