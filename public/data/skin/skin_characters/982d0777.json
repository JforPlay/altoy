[{"클뜯 id":101470,"클뜯 함순이 id":10147,"함순이 이름":"모리슨","한글 함순이 + 스킨 이름":"모리슨","영문 함순이 + 스킨 이름":"Morrison","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101470/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101470/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101470/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101470/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101470/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101470/shipyard.png","설명":"플레처급 구축함—모리슨, 현호 DD-560","자기소개":{"voiceline":"저는 평범한 플레처급의 일원이에요. 동료들과 함께 사쿠라 엠파이어의 잠수함을 격침시키기도 했고, 지원 작전에도 참여했었어요... 지휘관님, 제 도움이 필요하다면 아마... 괜찮을 거에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/profile.ogg"},"메인1":{"voiceline":"메탈 블러드의 장비... 연구할 수 있는 샘플이 있으면 좋겠네요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/main1.ogg"},"메인2":{"voiceline":"아, 네! ...에, 지휘관님. 방금 부르지 않았나요? 죄송해요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/main2.ogg"},"메인3":{"voiceline":"오늘은 맑네요. 하지만 맑은 것이 꼭 좋은 날씨라고는 할 수 없어요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/main3.ogg"},"전투개시":{"voiceline":"또, 또 싸우는 건가요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/battle.ogg"},"상세확인":{"voiceline":"곰돌이는 모리슨의 동료에요. 이거 봐요, 오른손에—— 아, 지휘관님을 조준하면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함—모리슨, 현호 DD-560","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료에요. 저기, 일손이 필요하시다면 지금 마침 한가한데...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/expedition.ogg"},"실망":{"voiceline":"역시, 전 여기에 맞지 않는군요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 저기... 볼 일이... 됐어요. 아, 아니에요. 마음에 담아두지 마세요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 곰돌이에게 관심이 있나요? 저기, 제가 좀 소개시켜 드릴까요...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 시간 있으신가요? 사실 요즘 곰돌이를 개조하고 싶은데 아이디어가 떠오르지 않아서요... 괜찮으시다면 저기, 같이 생각해 주실래요...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 모리슨이 도움이 되었을까요? 폐를 끼치진 않았겠죠...? 매번 지휘관님의 확신에 찬 대답을 들을 때마다 안심이 돼요... 고마워요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/feeling5.ogg"},"터치3":{"voiceline":"곰돌이...? 지휘관님, 곰돌이가 고의로 방해한 건 아닐 거에요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 저기... 이게 도움이 될 지는 모르겠지만... (서류를 건넨다)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/home.ogg"},"hp 경고":{"voiceline":"곰돌아, 지켜줘...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 저기, 일단 방해하지 않을게요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/login.ogg"},"실패":{"voiceline":"아파요... 으... 모항으로 돌아가고 싶어요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/lose.ogg"},"우편":{"voiceline":"곰돌아, 우편을 지휘관님에게 전해줘...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/mail.ogg"},"임무":{"voiceline":"지휘관님, 임무에 도움이 필요하시다면 혹시 제가...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/mission.ogg"},"임무완료":{"voiceline":"임무를 완료하셨나요? 아, 당분간은 제가 필요 없으려나요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/mission_complete.ogg"},"서약":{"voiceline":"후... 예전에 이런 상황을 대비해서 특별 훈련을 했으니까 괜찮아, 모리슨, 넌 할 수 있어... 지휘관님, 저기, 준비 됐어요! 그러니까, 이제... 부, 부탁할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/propose.ogg"},"스킬":{"voiceline":"도, 도움이 필요하신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/skill.ogg"},"터치1":{"voiceline":"곰돌이도 지휘관님이랑 인사해도 되나요? 일단 평범하게 손인사를... 때, 때리면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/touch.ogg"},"터치2":{"voiceline":"아, 곰돌이가 폭주했어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/touch2.ogg"},"입수시":{"voiceline":"휴, 무사히 도착했다… 저기, 당신이 지휘관님이시죠? 전 플레처급 모리슨이라고 해요. 맞아요, 동급 함선이 아주 많은 그 플레처급이에요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/unlock.ogg"},"강화성공":{"voiceline":"나, 나를 위해서 이렇게 하지 않아도 돼...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이제 숨을 돌릴 수 있겠죠...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/win_mvp.ogg"},"전투개시_ex":{"voiceline":"곰돌이, 에너지 충전 개시...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/battle_ex.ogg"},"상세확인_ex":{"voiceline":"이렇게 코팅하면 곰돌이도 바다속에서 움직일 수 있어... 음, 속도가 느린 것 같네... 지휘관, 조금 봐줄 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰 완료야. 저기, 지휘관... 같이 모두를 마중하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관, 수고했어. 작전 보고서는 맡겨줘...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 저기... 오늘도 계속 여기에 있을 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"임무 완료야? 조금 쉬자...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"도, 도움이 필요하다면... 나에게 맡겨줘도 되는데...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/touch_ex.ogg"},"터치2_ex":{"voiceline":"미, 미안해. 곰돌이가 조금 민감해서... 나를 보호하려고 그런 거야...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"얼른 곰돌이를 돌봐줘야지... 응, 느낌이 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['프린스턴'] : 호, 호위... 힘낼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"nil","voicelink":null},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"버밍햄, 이 임무는 곰돌이와 지휘관이 도와주면 안 될까...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"지, 지휘관. 불렀어...? 응! 나에게 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101470/main2_ex.ogg"},"메인3_ex":{"voiceline":"오늘은 맑네. 사실 맑은 날도 나쁘지 않은 것 같아... 응!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/vo