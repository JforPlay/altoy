},"실망":{"voiceline":"이제 사탕 안 줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/feeling1.ogg"},"낯섦":{"voiceline":"자매들한테 순서를 뺏기는 느낌… 뭐, 괜찮지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/feeling2.ogg"},"호감":{"voiceline":"지휘관 말야, 저번에 받은 사탕 엄청 맛있었는데, 어디서 샀어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/feeling3.ogg"},"기쁨":{"voiceline":"사탕을 만드는 것도 재밌어! ……지휘관, 내가 만든 사탕, 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/feeling4.ogg"},"사랑":{"voiceline":"막 만든 수제 사탕이야. 있잖아 지휘관, 받아줘♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지, 지휘관! 적들한테 사탕 뺏어왔어? …없어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"나의 감이 맞다면, 지휘관의 사탕은…… 엥, 없다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/login.ogg"},"실패":{"voiceline":"내 사탕이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/lose.ogg"},"우편":{"voiceline":"새로 온 우편이네! ……사탕은 건강에 좋지 않다는 광고는 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/mail.ogg"},"임무":{"voiceline":"\"사탕 먹을 때가 아니야!\" 라니, 그런 말 안 하거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/mission.ogg"},"임무완료":{"voiceline":"콜롬방가라 때의 일을 조금은 만회했을지도? …와그작와그작","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/mission_complete.ogg"},"서약":{"voiceline":"에, 오늘부터 내가 지휘관의 가장 소중한 사탕이라고? ……그러니까, 그럼 날 항상 와그작 와그작 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/propose.ogg"},"스킬":{"voiceline":"사탕 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/skill.ogg"},"터치1":{"voiceline":"와그작와그작…… 응? 왜?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/touch.ogg"},"터치2":{"voiceline":"흥! 다음에 이런 짓 하면, 앞으로 내 방에서 사탕 안 먹여 줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/touch2.ogg"},"입수시":{"voiceline":"플레쳐급 구축함 래드포드야. 지휘관, 사탕 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/unlock.ogg"},"강화성공":{"voiceline":"괜찮아! 충치 같은 거 없으니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리의 맛…… 으음, 사탕이 더 달콤한 걸~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101290/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":101291,"클뜯 함순이 id":10129,"함순이 이름":"래드포드","한글 함순이 + 스킨 이름":"Candy Magic！","영문 함순이 + 스킨 이름":"Sweet Magic!","스킨 타입":"Halloween","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101291/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101291/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101291/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLa