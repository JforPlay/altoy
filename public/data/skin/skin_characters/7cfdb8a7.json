[{"클뜯 id":907010,"클뜯 함순이 id":90701,"함순이 이름":"조프르","한글 함순이 + 스킨 이름":"조프르","영문 함순이 + 스킨 이름":"Joffre","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907010/shipyard.png","설명":"조프르급 항공모함 - 조프르","자기소개":{"voiceline":"항공모함 조프르입니다. 그 대전에서 메탈 블러드의 항공모함에 대항하기 위해 건조되기 시작했지만, 우여곡절로 진수를 이루지 못한 채, 몇 번이고 기공과 중지를 반복하는 운명을 맞이했습니다….이것도 분명 제게 주어진 시련이겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/profile.ogg"},"메인1":{"voiceline":"죄를 판결하는 자로서, 어떤 의미에서는 저도 모든 것을 미워하고 있지요. 인간은 누구나 태어났을 때부터 죄인이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/main1.ogg"},"메인2":{"voiceline":"손을 놓고 계시네요? 당신의 책무는 아직 끝나지 않은 것 같습니다만…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/main2.ogg"},"메인3":{"voiceline":"당신 행동의 옳고 그름을 판가름하려는 게 아닙니다. 당신이라는 존재 그 자체를 판결하는 것이 제 책무니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/main3.ogg"},"전투개시":{"voiceline":"성좌를 대신하여 제재를 내리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/battle.ogg"},"상세확인":{"voiceline":"죄를 지은 존재에게 판결을 내리는 것… 그것이 제 존재의 의미입니다. 당신이 판결을 받지 않아도 될 존재인지 어떤지, 결론을 내는 건 아직 시기상조겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/detail.ogg"},"드랍 설명":{"voiceline":"조프르급 항공모함 - 조프르","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔습니다. 아이리스의 뜻대로….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/expedition.ogg"},"실망":{"voiceline":"당신 상대로 '그런' 업무를 보라고 시키지 마세요. 다른 사람들이 슬퍼할 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/feeling1.ogg"},"낯섦":{"voiceline":"이 모항에서는 판결을 내리는 것이 아니라, '전투'만 잘 수행하면 되는 거군요. 안심하세요. 당신께서 걱정할만한 일은 저지르지 않을 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/feeling2.ogg"},"호감":{"voiceline":"전투'만이 아니라, 다른 동료들과 사이좋게 지내라구요? 알겠습니다. 모항을 이끄는 당신께서 그렇게 말씀하신다면, 그렇게 하도록 하지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/feeling3.ogg"},"기쁨":{"voiceline":"사이좋게 지내는 것만이 아니라, 더 재미있는 걸 하라…구요? 제게 있어서 재미있는 일이라면 물론 '그런' 업무도…. 농담이에요. 방금 당신 반응, 무척 재밌던데요, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/feeling4.ogg"},"사랑":{"voiceline":"빙 둘러 말할 생각은 없습니다. 다음 쉬는 날에 같이 데이트라도 어떠세요? 제 권유에 따르지 않으신다면, 그때는…. 후후후, 어떻게 하면 절 즐겁게 해줄지 잘 생각하세요, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"당신의 전투 결과를 아이리스 대신 판가름해 드리죠. …수고 많으셨습니다. 멋진 승리였습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/home.ogg"},"hp 경고":{"voiceline":"날개가 꺽이지 않는 한…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/hp_warning.ogg"},"로그인":{"voiceline":"아침 기도는 끝나셨나요? …아, 죄송합니다. 당신께 그런 걸 요구하는 건 무리겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/login.ogg"},"실패":{"voiceline":"…이건 패배라는 이름의 시련에 지나지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/lose.ogg"},"우편":{"voiceline":"아무래도 새로운 우편이 온 것 같군요. 확인하도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/mail.ogg"},"임무":{"voiceline":"임무입니다. 당신의 진척 상황에 따라 저도 판결을 내리지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/mission.ogg"},"임무완료":{"voiceline":"임무 보상입니다. 너무 욕심 내지 말고 받으시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/mission_complete.ogg"},"서약":{"voiceline":"아이리스의 이름 아래, 당신과 영원한 서약을 맺겠습니다. …이걸로 전 당신을 판결할 수 있는 자격을 잃었지만, 뭐 괜찮겠지요. 대신 손에 넣은, 당신을 사랑할 수 있는 이 자격… 듬뿍 활용해 드리지요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/propose.ogg"},"스킬":{"voiceline":"당신은… 유죄…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/skill.ogg"},"터치1":{"voiceline":"무슨 일이시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/touch.ogg"},"터치2":{"voiceline":"…판결을 받으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/touch2.ogg"},"입수시":{"voiceline":"아이리스의 신탁으로 취임하게 된 항공모함 조프르입니다. 당신이 이 모항의 지휘관이시군요. 후후훗, 당신께도 아이리스의 가호가 있기를….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/unlock.ogg"},"강화성공":{"voiceline":"아이리스의 바람대로….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"참회할 시간입니다. 연명할 생각은 접으세요. 바로 잔해를 드러내고 승리의 주춧돌이 되도록 해드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/win_mvp.ogg"},"전투개시_ex":{"voiceline":"신의 천벌을 받으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/battle_ex.ogg"},"상세확인_ex":{"voiceline":"'사랑의 비적'이 어떤 건지 관심 있으세요? 물론 보여드리고 말고요…. 당신이 이해하기 쉬운 말로 표현하자면, '데이트'라고 하면 되려나요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"안심하세요. 제 판결을 받을 필요도 없이, 당신의 전투는 멋진 전