7012/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907012/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907012/shipyard.png","설명":"개운하신가요? 신성한 의식은 아니지만, 이 탕으로 당신을 치유할 수 있다면, 아이리스도 기뻐하겠지요. 아직 부족하시다구요? 그럼… 함께 다시 들어가시겠어요?","자기소개":null,"메인1":{"voiceline":"날개 걱정은 마시길. 기적에서 비롯된 신성함의 상징은 물줄기가 아니라 믿는 마음으로 정화됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/main1.ogg"},"메인2":{"voiceline":"제가 여기 있는 한, 당신은 '엿보기'의 대죄를 범하지 않겠죠. 실은 이런 감시보다는 스스로 자제하길 바랐습니다만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/main2.ogg"},"메인3":{"voiceline":"무더운 산속보다는 혹한의 땅에 있는 온천이 더 고맙게 느껴진다, 라… 네, 약점을 파고드는 향락이 몇 배는 더 무서운 법이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"즐겁냐고요? 네, 즐겁습니다. 힐링하는 것도, 이 다음에 적을 토벌할 상상을 하는 것도. 당신은 어떤가요? 즐거우신지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/detail.ogg"},"드랍 설명":{"voiceline":"개운하신가요? 신성한 의식은 아니지만, 이 탕으로 당신을 치유할 수 있다면, 아이리스도 기뻐하겠지요. 아직 부족하시다구요? 그럼… 함께 다시 들어가시겠어요?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔습니다. 위로품으로 온천지의 기념품을 가지고 가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"본의 아니게 저도 맨살을 드러내야겠군요. 성좌의 규율과 마찬가지로, 입욕 예절도 어길 수는 없는 노릇이라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요. 일단은 몸을 깨끗하게 한 후에 업무에 복귀하는 게 좋겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/login.ogg"},"실패":null,"우편":{"voiceline":"갈리소니에르가 새로운 우편을 전해주러 온 것 같군요. …우편만 가지고 오면 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"휴우…… 좋은 온천으로 인도해준 아이리스에 감사를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/touch.ogg"},"터치2":{"voiceline":"후후후. 좋은 온천만으로는 만족이 안 되시는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/touch2.ogg"},"입수시":{"voiceline":"개운하신가요? 신성한 의식은 아니지만, 이 탕으로 당신을 치유할 수 있다면, 아이리스도 기뻐하겠지요. 아직 부족하시다구요? 그럼… 함께 다시 들어가시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"따뜻해진 것 같네요. 다행입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907012/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"온천 타임","상점 id":70836,"상점 카테고리 id":22,"스킨 태그":"배경, 쁘띠모션","입수 영상":"X","재화":980,"기간":"한정 (2025/05/07)","진영":"MNF","레어도":"SSR","ex_chat_status":0},{"클뜯 id":907013,"클뜯 함순이 id":90701,"함순이 이름":"조프르","한글 함순이 + 스킨 이름":"축복의 시작 스퍼트","영문 함순이 + 스킨 이름":"Blessings' First Flight","스킨 타입":"Race Queen","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907013/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907013/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907013/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907013/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/907013/shipyard.png","설명":"지휘관, 경기 준비는 끝나셨나요? 부디 이 차량이… 그리고 지휘관, 당신 자신도 최상의 컨디션이기를……","자기소개":null,"메인1":{"voiceline":"개인 기록을 경신하신 모양이군요. 축하드립니다. 이 좋은 성적도 모두 아이리스의 가호 덕분이겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/main1.ogg"},"메인2":{"voiceline":"후우… 앞유리에 김을 서리게 하는 건 이 정도로 하지요. 그렇죠, 이렇게… 당신에게 「사랑」의 축복이 있기를…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/main2.ogg"},"메인3":{"voiceline":"동료들의 경기 분위기를 띄워주려고 하시는 건 칭찬받아 마땅한 마음가짐입니다. 모쪼록 안전에는 유의하시길… 조프르도 그렇다고요? 후후후, 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/main3.ogg"},"전투개시":{"voiceline":"모든 불의로부터 이 바다를 정화하리라……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/battle.ogg"},"상세확인":{"voiceline":"규칙을 위반하면 이렇게 앞유리에서 조프르의 심판이 내려질 겁니다… 후후후, 깜짝 놀라셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 경기 준비는 끝나셨나요? 부디 이 차량이… 그리고 지휘관, 당신 자신도 최상의 컨디션이기를……","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아온 모양이군요. 잠시만 기다리라고 전하고 오지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/expedition.ogg"},"실망":{"voiceline":"「운전에 방해된다, 전투 천사」…라고 말씀하시려는 건가요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/feeling1.ogg"},"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"조프르의 「응원」으로 도리어 경기에 집중할 수 없을 것 같다고요? …안심하시길. 성좌의 전투 천사로서 제가 책임지고 집중을 방해하는 「죄」로부터 해방시켜 드리죠. 자, 지휘관… 이쪽으로…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"일단 피트로 들어가서 차량을 정비하는 편이 좋겠군요. 사람이든 사물이든, 계속 무리하면 언젠가 불행이 찾아오는 법입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요, 지휘관. 다음 경기가 시작되기 전에 일단 차량 상태를 확인하는 편이 어떤가요? 저도 협력하지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무가… 네, 뒤로 미뤄도 괜찮습니다. 조프르가 그렇게 「판결」을 내렸으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"설마 유리가 있다는 걸 잊으신 건…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/touch.ogg"},"터치2":{"voiceline":"……윽. 조프르의 정화는 불필요하리라 봅니다만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/touch2.ogg"},"입수시":{"voiceline":"지휘관, 경기 준비는 끝나셨나요? 부디 이 차량이… 그리고 지휘관, 당신 자신도 최상의 컨디션이기를……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"이 승리가 지휘관의 다음 승리의 초석이 되기를……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/907013/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"극속광열","상점 id":71031,"상점 카테고리 id":14,"스킨 태그":"L2D","입수 영상":"X","재화":1100,"기간":"한정 (2025/04/02)","진영":"MNF","레어도":"SSR","ex_chat_status":0}]