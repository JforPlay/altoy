d":319013,"클뜯 함순이 id":31901,"함순이 이름":"카시노","한글 함순이 + 스킨 이름":"꽃피는 러블리 스트링스","영문 함순이 + 스킨 이름":"Robust Floral Strings","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319013/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319013/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319013/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319013/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319013/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319013/shipyard.png","설명":"♪~ 지휘관님, 이러면 되나요? 음~ 역시 급하게 준비한 거라 잘 안 되네요… 배운 대로 연주하는데 왜 미묘하게 음이 어긋나는 걸까요…","자기소개":null,"메인1":{"voiceline":"후우… 하아… 어렵게 생각하지 말고 연습대로만 하면 괜찮아… 좋아, 카시노. 분명 괜찮을 거야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/main1.ogg"},"메인2":{"voiceline":"그러고 보니 이 세트는 '연회석' 스타일이네요~ 우후훗, 지휘관님을 초대하는 거라 좀 신경을 쓴 모양이에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/main2.ogg"},"메인3":{"voiceline":"좀 더우신가요…? 호, 혹시 카시노가 방을 덥게 만든 건… 아마 조명이나 분위기 때문…일 거라구요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관님이 악기에 대해 잘 아셔서 다행이에요~ 카시노는 연주 자세가 자꾸 햇갈려서, 아무리 노력해도 완벽하게 연주할 수 없어서…… 자, 자세 문제가 아니라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/detail.ogg"},"드랍 설명":{"voiceline":"♪~ 지휘관님, 이러면 되나요? 음~ 역시 급하게 준비한 거라 잘 안 되네요… 배운 대로 연주하는데 왜 미묘하게 음이 어긋나는 걸까요…","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아온 것 같군요. 음… 저기 아이들도 불러서 같이 리허설해도 될까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"우으……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/headtouch.ogg"},"모항귀환":{"voiceline":"♪~ 북은 허벅지에 올리고, 목 부분은 왼손으로 잡고 채는 오른손…… 응? 지휘관님? 카시노 얼굴에 뭐라도 묻었나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"♪~ 카시노의 연주, 어때요? 에헤헷, 사실 예전보다 나아진 것 같기도 하고, 아닌 것 같기도 하고… 대체 뭐가 잘못된 걸까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/login.ogg"},"실패":{"voiceline":"앗?! 옷자락을 밟아버렸어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/lose.ogg"},"우편":{"voiceline":"간식에 편지가…? 아, 지휘관님 앞으로 온 우편이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님께서 시범을 보여주신다구요…? 꼭 좀 부탁드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/touch.ogg"},"터치2":{"voiceline":"요, 용서해 주세요… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/touch2.ogg"},"입수시":{"voiceline":"♪~ 지휘관님, 이러면 되나요? 음~ 역시 급하게 준비한 거라 잘 안 되네요… 배운 대로 연주하는데 왜 미묘하게 음이 어긋나는 걸까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"지휘관님, 방금 건 완벽했죠?! …저, 전투 말씀이신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319013/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70899,"상점 카테고리 id":7,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1080,"기간":"상시","진영":"IJN","레어도":"SR","ex_chat_status":0},{"클뜯 id":319014,"클뜯 함순이 id":31901,"함순이 이름":"카시노","한글 함순이 + 스킨 이름":"프레시 & 스위트!","영문 함순이 + 스킨 이름":"Fresh and Sweet","스킨 타입":"Dreamland Park","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319014/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319014/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319014/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319014/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319014/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/319014/shipyard.png","설명":"어, 어서 오세요… 목욕 후에 우유를 마시면 좋다던데, 수영 후 우유는 어떠신가요…? 우읏… 이 모습… 정말 괜찮나요? 지휘관님 얼굴… 많이 뜨거워진 것 같은데…","자기소개":null,"메인1":{"voiceline":"지휘관님, 한 차례 논 다음에는 어떤 걸 마시고 싶으세요? 네? 카시노 거면 뭐든 다 좋다니… 으아아아아!////","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/main1.ogg"},"메인2":{"voiceline":"주, 주문받았습니다~! 음… 차가운 거 한 병, 액상 시럽 하나에 카시노의 사랑을 조금 담아서… 응? 지휘관님…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/main2.ogg"},"메인3":{"voiceline":"하아… 하아… 이렇게 계속 서 있으니까 꽤 힘드네요… 아뇨, 부끄럽거나 더운 게 아니라, 이 팻말… 꽤 무겁고… 게, 게다가 카시노의…… 아, 아무것도 아니에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/main3.ogg"},"전투개시":{"voiceline":"부, 부끄럽지만……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/battle.ogg"},"상세확인":{"voiceline":"가판대가 많이 있어서 이것저것 먹고 다니면 배가 꽉 차겠네요… 그럼 또 운동하면 괜찮다…고요? 그, 그렇죠…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/detail.ogg"},"드랍 설명":{"voiceline":"어, 어서 오세요… 목욕 후에 우유를 마시면 좋다던데, 수영 후 우유는 어떠신가요…? 우읏… 이 모습… 정말 괜찮나요? 지휘관님 얼굴… 많이 뜨거워진 것 같은데…","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어요! 아… 이 모습으로 마중 나가는 건 좀 어렵겠네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"카시노도 모항 유원지를 즐겼으면 한다…고요? 괜찮아요. 카시노는 여기서 동료들과 함께 지휘관님을 모시는 것만으로도 충분히 즐거워요! 게다가… 음… 이런 모습이라… 저, 적어도 지휘관님이랑 단둘이 있을 때… 알았죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/feeling5.ogg"},"터치3":{"voiceline":"휴우… 조금 침착해지네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 어서 오세요. 괜찮으시면 우유 어떠세요? 아침에 들여온 갓 짠 것도 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"괘, 괜찮으시면 한 병 어떠세요? …감사합니다! 아, 지휘관님은 늘 동료들을 돌봐주고 계시니, 돈 같은 건 안 주셔도 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/login.ogg"},"실패":null,"우편":{"voiceline":"새로운 우편…? 후우… 이 모습으로는 운반 작업도 어렵겠네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/mail.ogg"},"임무":{"voiceline":"지휘관님, 저기… 아직 완료되지 않은 임무가 있는데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었습니다. 보상 확인은… 카, 카시노는 여기서 기다리고 있을게요… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"주, 주문은 뭐로 하시겠어요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/touch.ogg"},"터치2":{"voiceline":"카, 카시노가 어떻게 해드리면… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/319014/touch2.ogg"},"입수