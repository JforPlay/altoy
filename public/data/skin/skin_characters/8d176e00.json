[{"클뜯 id":301660,"클뜯 함순이 id":30166,"함순이 이름":"아라시오","한글 함순이 + 스킨 이름":"아라시오","영문 함순이 + 스킨 이름":"Arashio","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301660/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301660/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301660/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301660/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301660/shipyard.png","설명":"아사시오급 구축함 4번함 - 아라시오 ","자기소개":{"voiceline":"저는 아사시오급 4번함, 아라시오입니다. 오오시오와 미치시오, 그리고 아사시오와 함께 제8 구축함대에 소속됐었습니다. 이번에는 꼭…… 모두와 함께한다면 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/profile.ogg"},"메인1":{"voiceline":"아사시오와는 옛날부터 쭉 함께였어요. 맞아요, 잘 때도 함께였죠. 아사시오, 자고 있을 때는 무척 조용하답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/main1.ogg"},"메인2":{"voiceline":"혹시 모두를 따라잡지 못해 뒤쳐진다 해도, 버려지지는 않을 거라고 믿고 있어요…… 그러니까, 여기가 제게 가장 소중한 보금자리에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/main2.ogg"},"메인3":{"voiceline":"차를 내렸습니다. 천천히 드세요. 제 솜씨, 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/main3.ogg"},"전투개시":{"voiceline":"다들, 되도록 다치지 않도록 해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/battle.ogg"},"상세확인":{"voiceline":"날고 있는 비행기를 보면, 조금 침울해져요…… 뭐, 그래도 이제는 옛날 일이에요. 그보다 지금 중요한 건, 웃는 얼굴을 잃지 않는 것이겠죠, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/detail.ogg"},"드랍 설명":{"voiceline":"아사시오급 구축함 4번함 - 아라시오","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰팀 모두가 돌아온 모양이에요. 어서 마중 나가볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/expedition.ogg"},"실망":{"voiceline":"아사시오? 그래그래, 무서울 거 없어요…… 지휘관님, 먼저 실례하겠습니다. 아사시오의 곁에 있어 줘야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님에 대해서 좀 더 알고 싶네요. 후훗, 먼저 어디부터 시작할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/feeling2.ogg"},"호감":{"voiceline":"또 나쁜 꿈을 꾸셨나요? 괜찮아요. 다 잘될 거예요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/feeling3.ogg"},"기쁨":{"voiceline":"잡담하다 보니 벌써 시간이 이렇게…… 정말 즐거웠어요! 지휘관님, 계속 앉아계셔서 어깨 결리지는 않으신가요? 주물러 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/feeling4.ogg"},"사랑":{"voiceline":"오늘은 둘 뿐이네요. 아까부터 가슴이 두근거려서…… 지휘관님, 아주 잠깐만, 가슴에 기대도 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고하셨습니다. 무릎베개 해드릴 테니 잠깐 쉬지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/home.ogg"},"hp 경고":{"voiceline":"이럴 때는 침착하게 가도록 하죠. 아라시오는 괜찮습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/hp_warning.ogg"},"로그인":{"voiceline":"제 옷차림, 이상하지 않나요? 지휘관님을 맞이할 때는 역시 미소가 제일이죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/login.ogg"},"실패":{"voiceline":"신경 쓰실 필요 없습니다. 다음엔 이길 수 있을 테니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/lose.ogg"},"우편":{"voiceline":"우편이 왔네요. 지휘관님, 어서 확인하러 가볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있네요. 지휘관님, 저도 돕겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐습니다. 지휘관님도 수고하셨어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 부끄러운 말씀이라 드리기 어렵지만, 들어주셨으면 하는 것이 있습니다…… 그러니까…… 앞으로도, 전 지휘관님을 보살펴드리겠습니다. 지휘관님의 곁이야말로, 제가 유일하게 의지할 수 있는 곳이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/propose.ogg"},"스킬":{"voiceline":"제가 모두를 지켜드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/skill.ogg"},"터치1":{"voiceline":"음…… 모두가 뿔뿔이 흩어진 이유에 대해서는 되도록 생각하지 않으려 해요. 게다가 이렇게 다시 만났으니, 이대로 즐겁게 지내도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/touch.ogg"},"터치2":{"voiceline":"꺄악~~! 이건, 어른이 되기 위해 필요한 일, 인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/touch2.ogg"},"입수시":{"voiceline":"구축함 아라시오, 지휘관님의 함대에 합류하겠습니다. 여기 있는 모두, 제가 정성껏 보살펴주겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/unlock.ogg"},"강화성공":{"voiceline":"이젠 다칠 일이 좀 더 줄겠네요. 감사합니다, 지휘관님","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어머, 제가 MVP인가요…… 으응~ 이런 것도 나쁘지 않을지도 모르겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['아사시오', '오오시오', '미치시오'] : 제8 구축대의 모두들, 잘 따라와주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301660/couple_encourage1.ogg"},{"voiceline":"['아사시오'] : 아사시오, 곁에 꼭 붙어있으니까, 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Ferna