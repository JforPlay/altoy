[{"클뜯 id":107300,"클뜯 함순이 id":10730,"함순이 이름":"샌 재신토","한글 함순이 + 스킨 이름":"샌 재신토","영문 함순이 + 스킨 이름":"San Jacinto","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107300/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107300/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107300/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107300/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107300/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107300/shipyard.png","설명":"인디펜던스급 경항공모함—샌 재신토, 현호 CVL-30","자기소개":{"voiceline":"인디펜던스급 항공모함 샌 재신토랍니다. 그 대전 도중에 진수해서 싸우며 젊은 매가 나는 것을 지켜보았죠…… 사실은 전 세계 여러 곳을 더 여행하고 싶었답니다. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/profile.ogg"},"메인1":{"voiceline":"조금 심박수가 상승해서… 지휘관님께서 잠깐 들어봐 주셨으면 하는데…… 후후후, 부끄러우신가 봐요~ 지휘관님~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/main1.ogg"},"메인2":{"voiceline":"핀백… 네, 그 아이에게는 여러모로 신세를 졌고, 앞으로는 지휘관님께도 여러모로 신세를 질 것 같네요. 우후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/main2.ogg"},"메인3":{"voiceline":"비행기를 돌보는 것도, 동료들을 돌보는 것도 자신 있답니다. 후후후, 어쩌면 지휘관님을 돌봐드리는 것도 자신 있을지도…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/main3.ogg"},"전투개시":{"voiceline":"적의 진형이 빈틈투성이네요~ 후후후","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/battle.ogg"},"상세확인":{"voiceline":"업무는 순조롭게 진행 중인가요? 작전은요? 후후후, 잘하고 계신 것 같네요… 그런 말씀 하셔도 정말 괜찮아요~? 그러다 걱정해 주는 애가 또 하나 줄어들지도 몰라요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/detail.ogg"},"드랍 설명":{"voiceline":"인디펜던스급 경항공모함 - 샌 재신토 CVL-30","voicelink":null},"의뢰 완료":{"voiceline":"이럴 때 할 말은, 임무 완료…겠죠? 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/expedition.ogg"},"실망":{"voiceline":"지휘관님, 일부러 이러시는 거 맞죠~? 앗, 지, 진심이셨나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님께서 모두를 돌봐주고 계신다고 하던데, 지휘관님은 누가 돌봐주고 있나요? 그런 사람이 없다면 제가… 뭐, 쓸데없는 걱정이려나요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/feeling2.ogg"},"호감":{"voiceline":"오늘 업무가 아직 꽤 남아있네요… 지휘관님, 제가 도와드릴까요? 그 대신… 끝나면 같이 외출하는 거예요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/feeling3.ogg"},"기쁨":{"voiceline":"어머, 지휘관님. 옷 여기에 뭐가 묻었네요. 깨끗하게 해드릴까요? …네, 지금 여기서요. 그래서 말인데 지휘관님, 우선은 좀 벗어주시겠어요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/feeling4.ogg"},"사랑":{"voiceline":"후후, 오늘은 지휘관님 방에 찾아갈게요~ 왜냐니, 지휘관님을 돌봐드리려고 그러는 거죠. 지금까지 잘해주신 거에 대한 보답의 의미는 물론, 그것 말고도…… 앗, 지휘관님. 이렇게 서서 이야기하는 것도 좀 그러니 우선은 여기 침대 좀 빌릴게요~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/feeling5.ogg"},"터치3":{"voiceline":"머리가 엉망이 되는 걸요? 그래도 만지실 건가요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 피곤하신 것 같네요… 이럴 땐 소파로 옮겨서 눕혀 드리는 편이—— 어머나~ 혼자서도 잘 걸으시네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/home.ogg"},"hp 경고":{"voiceline":"정말 지휘관님께 폐를 끼치고 말았네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/hp_warning.ogg"},"로그인":{"voiceline":"오늘의 당직은 저네요~ 지휘관님, 혹시 무슨 로맨틱한 전개라도 기대하신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/login.ogg"},"실패":{"voiceline":"졌네요~ 어떻게 할까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/lose.ogg"},"우편":{"voiceline":"새 우편이 왔어요. 좋은 소식이면 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/mail.ogg"},"임무":{"voiceline":"지휘관님~ 계속 게으름 피우면 임무가 영원히 끝나지 않을 거예요. 뭐, 그것도 재미있을 것 같긴 하지만~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/mission.ogg"},"임무완료":{"voiceline":"보상은 이게 전부인가요? 조금 더 받을 수 있도록 해군부에 신청해 보는 건 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/mission_complete.ogg"},"서약":{"voiceline":"서약을 나누는 의식, 그리고 그것을 기념하는 증명… 고집이 느껴질 정도로 심혈을 기울인 느낌이네요~ 지휘관님, 저도 고집 하나 부려도 될까요? 후후, 눈을 감고 얼굴을 가까이하고… 입술을 꼭 대주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/propose.ogg"},"스킬":{"voiceline":"편안히 잠드세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/skill.ogg"},"터치1":{"voiceline":"지휘관님, 책상에 있는 콜라 마셔도 되나요? 이미 조금 마셨다구요? 그럼, 잘 마실게요~ 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/touch.ogg"},"터치2":{"voiceline":"한창 그럴 때이시긴 하죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/touch2.ogg"},"입수시":{"voiceline":"이름이요? 그런 걸 모르는 사람한테 쉽게 알려줄 리 없잖아요~ 후훗, 방금 건 농담이에요♪ 저는 샌 재신토, 인디펜던스급 항공모함 중 한 척으로 오늘부터 신세를 지게 되었답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/unlock.ogg"},"강화성공":{"voiceline":"후후, 조금 성장한 것 같네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/upgrade.ogg"},"vote":null,"승리":{"voiceline":"엥? 벌써 끝난 건가요? 뭐, 끝났으면 상관없기는 한데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"작전도 순조롭고, 업무도 척척 진행되고 있네요… 흠, 이러시면 저… 지휘관님 걱정을 못 하게 되잖아요~ …후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"응? 전 지금 소중한 사람을 기다리는 중이랍니다. 뭐, 이미 지금 제 눈앞까지 오긴 했지만요. 후후후, 그럼 갈까요? 데이트하는 거예요, 데이트♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관님, 여기 수건이에요♪ 뭐냐니 당연히 땀 닦는 거죠. 아니면 설마 지휘관님, 다른 기대라도 하고 계신 건가요? 후후, 그럼 이다음에 지휘관님의 기대에 부응해 드릴까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"당직이라… 지휘관님이랑 단둘이서 있을 수 있다니 오히려 이득이죠~ 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"업무를 척척 처리하는 지휘관님, 너무 멋져요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관님, 마실 거라도 가져다드릴까요? 후후, 그럼 열어둘게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/touch_ex.ogg"},"터치2_ex":{"voiceline":"제가 그렇게 매력적인가요~? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"지휘관님~ 이겼답니다~ 그나저나 평소처럼 포상을 기대해도 될까요? 응? 평·소·처·럼·요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['인디펜던스', '프린스턴', '랭글리Ⅱ', '바탄'] :  자, 공격 위치에 서서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"바탄이 추천해 준 베개? 다음에 지휘관님도 시험해 보시겠어요? 음~ 하지만 헬캣 인형을 베개라고 해도 될지는…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107300/main5_ex.ogg"},"메인6_ex":{"voiceline"