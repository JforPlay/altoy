do2603/AzurLane/main/audio/voiceline/703013/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"앗?! 후우…… 이런 옷을 입고 있는데 스킨십을 하면 놀라는 게 당연하지! ……알았으니까 내 신발이나 주워줘! 그러면 이번 한 번만 봐줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703013/touch.ogg"},"터치2":{"voiceline":"이거 보자 보자 하니까… 이런 옷차림이라도 따끔한 맛은 보여줄 수 있거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703013/touch2.ogg"},"입수시":{"voiceline":"모습은 이래도 경계를 푼 건 아니야. 잠깐이라도 눈을 떼면, 바로 달까지 도망가 버릴지도 몰라. 후후…… 물론 너도 데리고 갈 거야. 널 독려하고 이끄는 게 내 역할이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703013/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":71223,"상점 카테고리 id":3,"스킨 태그":"쁘띠모션, 배경","입수 영상":"O","재화":980,"기간":"한정 (2025/10/15)","진영":"SN","레어도":"SSR","ex_chat_status":0}]