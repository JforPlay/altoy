[{"클뜯 id":703010,"클뜯 함순이 id":70301,"함순이 이름":"탈린","한글 함순이 + 스킨 이름":"탈린","영문 함순이 + 스킨 이름":"Tallinn","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703010/shipyard.png","설명":"중순양함—탈린","자기소개":{"voiceline":"나는 메탈 블러드의 중순양함 뤄초우를 개조한 노스 유니온의 중순양함 탈린이야. 그 유명한 전쟁에 \"페트로파블롭스크\"라는 이름으로 참가한 적도 있지. 마지막까지 힘을 다하진 못했지만… 아무튼 네 지휘력을 기대하고 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/profile.ogg"},"메인1":{"voiceline":"일에 집중하도록 해… 휴식? 대답할 힘이 있으면 더 일하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/main1.ogg"},"메인2":{"voiceline":"타슈켄트와 무르만스크… 어떻게 저렇게 남들이랑 잘 섞이는 걸까…… 아무것도 아니야. 일에 집중해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/main2.ogg"},"메인3":{"voiceline":"일이 끝나면 맥주 한잔 마시고 싶네…보드카? 음, 역시 사양할게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/main3.ogg"},"전투개시":{"voiceline":"바보! 쓸데없는 저항은 그만둬!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/battle.ogg"},"상세확인":{"voiceline":"부포대가 되더라도, 화포가 겨우 몇 개만 남더라도, 싸울 수만 있다면 끝까지 싸워야만 해. 그것이 우리의 책무와 사명이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/detail.ogg"},"드랍 설명":{"voiceline":"중순양함—탈린","voicelink":null},"의뢰 완료":{"voiceline":"지금 네가 할 일은 위탁에서 돌아온 모두를 위로하는 일이야. 잘 해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/expedition.ogg"},"실망":{"voiceline":"지시를 하기 전에 잘 생각해보라고. 이런 것도 되지 않는 지휘관 곁에서 일하고 싶지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/feeling1.ogg"},"낯섦":{"voiceline":"나를 거느릴 생각이라면 먼저 귀감을 보이도록 해. 그렇지 않으면 내게도 다 생각이 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/feeling2.ogg"},"호감":{"voiceline":"내게 혼나고 싶지 않으면 알아서 잘 해! 너… 설마 내게 혼나는 걸 즐기고 있는 건 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/feeling3.ogg"},"기쁨":{"voiceline":"너, 정말로 내가 하는 말을 다 들어 주는 건 아니겠지. 후훗, 후훗, 후훗…이런 걸 좋아한다면 좀 더 확실하게 해줄까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/feeling4.ogg"},"사랑":{"voiceline":"비서함의 말이라면 전부 듣는다니, 지휘관으로서 정말 괜찮은 거야?… 네가 지휘관으로 있을 수 있도록 내가 여러 가지 지시를 내려 줄게. 나도 요즘은 이런 게 점점 즐거워 지고 있거든.후후훗","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/feeling5.ogg"},"터치3":{"voiceline":"뭣…?! 함부로 머리 만지지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/headtouch.ogg"},"모항귀환":{"voiceline":"잘한 것 같은데. 다음에도 분발해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/home.ogg"},"hp 경고":{"voiceline":"웁… 상대는 괴물…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/hp_warning.ogg"},"로그인":{"voiceline":"지각할 뻔했잖아. 그렇게 내게 혼나고 싶은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/login.ogg"},"실패":{"voiceline":"……앗, 이런 작은 실수 때문에…!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/lose.ogg"},"우편":{"voiceline":"여기 편지가 있어. 누가 보낸 걸까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/mail.ogg"},"임무":{"voiceline":"임무를 완료하는 것은 지켜야만 하는 책임——메탈 블러드에서든 노스 유니온에서든 모두 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/mission.ogg"},"임무완료":{"voiceline":"저기, 어서 임무 보상을 확인해야 할 거야.동료들을 계속 기다리게 해선 안 된다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/mission_complete.ogg"},"서약":{"voiceline":"착하지, 어서 이곳에 서명하도록 해. 이후의 일은 모두 내게 맡겨. 반지를 끼고 맹세의 입맞춤…(속삭임) 내 입술을 빼앗은 기분이 어때?후후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/propose.ogg"},"스킬":{"voiceline":"모든 주포, 계속 사격하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/skill.ogg"},"터치1":{"voiceline":"무슨 일이지? 비서함이라고 잡다한 업무까지 시키려 하면 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/touch.ogg"},"터치2":{"voiceline":"……읏!? 감히 이런 짓을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/touch2.ogg"},"입수시":{"voiceline":"노스 유니온의 중순양함, 탈린이야. 나한테 명령을 하달하기 전에, 먼저 머리를 써서 잘 한 번 생각해 보는 게 좋을걸. 네가 지휘관이라고 해서 맹목적으로 명령에 따르지는 않을 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/unlock.ogg"},"강화성공":{"voiceline":"할 수 있는 걸 다 한 것뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼어. 흥, 훈련대로 하면 이기는건 당연한 거 아니겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"이 정도 전적으로 모두를 만족시킬 수 있을 거라고 생각하는 건 아니겠지? 그래, 듣기 싫으면 다음부터 더 열심히 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"제때 왔네. 노력하면 잘 할 수 있잖아. 후후훗~","voicelink":"https://raw.githubusercontent.com/Fernando26