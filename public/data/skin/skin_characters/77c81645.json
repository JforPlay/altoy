[{"클뜯 id":501040,"클뜯 함순이 id":50104,"함순이 이름":"타이위안","한글 함순이 + 스킨 이름":"타이위안","영문 함순이 + 스킨 이름":"Tai Yuan","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501040/shipyard.png","설명":"안샨급 구축함 - 타이위안 ","자기소개":{"voiceline":"이스트 글림 안샨급 구축함, '사천왕'의 막내, 타이위안이에요. 예전에는 '지린'으로도 불렸어요. 우리 '사천왕'은 이스트 글림 해군에 몇십 년이나 공헌했어요. 이 책…… 「핵물리 가설」은 아주 재밌으니까 언니들도 읽어봤으면 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/profile.ogg"},"메인1":{"voiceline":"노, 녹스? 별로 만나고 싶지 않은데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/main1.ogg"},"메인2":{"voiceline":"안샨 언니 힘들어 보여…… 저, 언제쯤이면 도움이 될 수 있을까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/main2.ogg"},"메인3":{"voiceline":"지금 읽고 있는 책은 「유양잡조」라고 해요. 창춘 언니에게 받았어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/main3.ogg"},"전투개시":{"voiceline":"시, 실전이군요… 노력하지 않으면…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/battle.ogg"},"상세확인":{"voiceline":"아까 '레인보우 프로젝트'가 뭐냐고 푸슌 언니가 물어봤습니다만, 지휘관님도 알고 싶으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/detail.ogg"},"드랍 설명":{"voiceline":"안샨급 구축함 - 타이위안","voicelink":null},"의뢰 완료":{"voiceline":"아, 누군가 돌아왔다. 안샨 언니, 저는 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/expedition.ogg"},"실망":{"voiceline":"안샨 언니, 저, 저 조금 무서워요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/feeling1.ogg"},"낯섦":{"voiceline":"지, 지휘관님인가요? 죄송해요, 창춘 언니가 불러서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/feeling2.ogg"},"호감":{"voiceline":"지휘관님은 언니들 말고 처음으로 만든 친구니까요… 그, 그러니까 푸슌 언니의 미사일에는 절대 타지 말아주세요!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님은 여기 계셨군요. 응? 산책이 아니에요. 그게, 지휘관님의 얼굴을 보고 싶어서, 저기……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/feeling4.ogg"},"사랑":{"voiceline":"지휘관님…… 저, 아직 미숙하지만, 더 노력할 테니까, 그러니까… 기다려 주실래요…? 제가 언니들을 넘어설 때까지…… 정말인가요! 다행이다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"드디어 안심할 수 있겠네요. …그, 저기, 푸슌 언니, 어딜 데려가는 거야!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/home.ogg"},"hp 경고":{"voiceline":"으으으, 어, 어떡하지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/hp_warning.ogg"},"로그인":{"voiceline":"네? 지휘관님입니까… 죄송해요, 독서에 열중해서… 벌써 이런 시간인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/login.ogg"},"실패":{"voiceline":"여, 역시 저는 아직 멀었네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/lose.ogg"},"우편":{"voiceline":"지, 지휘관님, 새로운 우편이에요. 푸슌 언니와는 관계없을까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/mail.ogg"},"임무":{"voiceline":"임무…… 어려워 보이네요… 괜찮나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/mission.ogg"},"임무완료":{"voiceline":"이, 이걸로 저도 성장한 걸까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 감사합니다…… 저, 아직 못 미더운 부분이 있지만…… 앞으로는 더욱더 의지해 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/propose.ogg"},"스킬":{"voiceline":"현천후토의 현무, 우리에게 가호를…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/skill.ogg"},"터치1":{"voiceline":"지휘관님은 어떤 책을 좋아하나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/touch.ogg"},"터치2":{"voiceline":"아으!? 지, 지휘관님… 이 이상은……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/touch2.ogg"},"입수시":{"voiceline":"구, 구축함 타이위안 착임했습니다… 지휘관님, 언니들을 못 보셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/unlock.ogg"},"강화성공":{"voiceline":"우왓… 역시 조금 무서워요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"네에! 이걸로 된 건가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['안샨'] : 안샨 언니에게 도움이 되도록 노력하지 않으면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/couple_encourage1.ogg"},{"voiceline":"['푸슌'] : 푸슌 언니, 너무 앞으로 나갔어요…… 꺅!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501040/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":501041,"클뜯 함순이 id":50104,"함순이 이름":"타이위안","한글 함순이 + 스킨 이름":"봄을 깨우는 검은 거북이","영문 함순이 + 스킨 이름":"The Golden Dragon's Festivities","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501041/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501041/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501041/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501041/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501041/shipyard.png","설명":"\"안샨급 모두를 대신해 지휘관님, 그리고 모항의 여러분께 축하 말씀 드립……\" …아으, 직접 만든 옷인데도, 여, 역시 부끄럽네요… 어, 어울리나요? 가, 감사합니다…… ","자기소개":null,"메인1":{"voiceline":"푸슌 언니, 포, 폭죽을 해체하는 건 위험해요…… 아, 새로운 실험인가요??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/main1.ogg"},"메인2":{"voiceline":"올해의 대련은… 저기, 지휘관님도 같이 생각해 주실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/main2.ogg"},"메인3":{"voiceline":"창춘 언니, 모처럼 춘절이니까, 방에 틀어박히지 말구‥‥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관님은 알고 계시나요? 이스트 글림에는 '연수'라는 괴수에 대한 전설이 있어요. 매년 춘절에는 모두 대련을 장식하거나, 폭죽을 터트리거나 해서 연수를 쫓아내요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/detail.ogg"},"드랍 설명":{"voiceline":"\"안샨급 모두를 대신해 지휘관님, 그리고 모항의 여러분께 축하 말씀 드립……\" …아으, 직접 만든 옷인데도, 여, 역시 부끄럽네요… 어, 어울리나요? 가, 감사합니다……","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"춘절에는 친한 사람들이 모여 함께 단란하게 보내요. 올해는 언니들 말고 지휘관님도 참가해 주셨으면 하는데… 안될까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"아, 지휘관님, 어서 오세요. …저기, 지금 등롱을 만들고 있어요…… 나중에 장식하는 거 도와주실 수 있으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"춘절만 되면, 푸슌 언니는 기분이 엄청 업 되네요… 저와 창춘 언니를 끌고 이리 갔다, 저리 갔다 하고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이 옷은 직접 만들었어요. 언니들이 다 귀엽다고 말해줬어요. 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/touch.ogg"},"터치2":{"voiceline":"아으… 지, 지휘관님, 자꾸 그러시면 이 아이가 화낼 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/touch2.ogg"},"입수시":{"voiceline":"\"안샨급 모두를 대신해 지휘관님, 그리고 모항의 여러분에게 축하의 말씀을 드립……\" …아으, 직접 만든 옷인데도, 여, 역시 부끄러워요… 어, 어울리나요? 가, 감사합니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501041/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70148,"상점 카테고리 id":3,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1080,"기간":"상시","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":501042,"클뜯 함순이 id":50104,"함순이 이름":"타이위안","한글 함순이 + 스킨 이름":"두근두근 곁잠","영문 함순이 + 스킨 이름":"Two Hearts, One Cushion","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501042/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501042/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501042/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501042/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501042/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/501042/shipyard.png","설명":"지휘관님도 딩안 씨의 초대로 이 인체 공학 쿠션을 체험하러 오셨나요? 그럼, 옆자리를 비워드릴게요… 영차… 자, 지휘관님도 앉으세요…!","자기소개":null,"메인1":{"voiceline":"베개나 쿠션으로 쓸 수 있어서 일석이조인 디자인이네요. 지휘관님도 어서 시험해 보세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501042/main1.ogg"},"메인2":{"voiceline":"지휘관님, 최근에 『침중기』라는 책을 읽었어요. 신기한 꿈을 꾸게 해주는 베개에 대한 이야기인데…… 스토리가 궁금하다고요? 그럼, 제가 들려드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501042/main2.ogg"},"메인3":{"voiceline":"이 잠옷이랑 머리띠는 직접 만든 거예요♪ 아… 가까이에서 자세히 보고 싶으시다고요? …아, 알겠어요! …아뇨, 조금 두근거린 것뿐이에요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501042/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"부드러운 정도도 적절하고, 지지력도 좋고, 크기도 딱 좋네요… 음… 체험 후기라고 하기에는 너무 두루뭉술한가요? 지휘관님 생각은 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501042/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님도 딩안 씨의 초대로 이 인체 공학 쿠션을 체험하러 오셨나요? 그럼, 옆자리를 비워드릴게요… 영차… 자, 지휘관님도 앉으세요…!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님에게 가까이 다가갈수록… 가슴이 두근거리고 몸도 뜨거워져서 이상해질 것 같아요… 정상적인 반응이니 걱정할 거 없다…고요? 그, 그렇군요… 마음이 놓여요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501042/feeling5.ogg"},"터치3":{"voiceline":"지휘관님, 타이위안은 아직 안 졸려요. 조금 더 이야기를 나눠요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/501042/headtouch.ogg"},"모항귀환":{"voiceline":"피곤하세요? 그러시면 이 기회에 푹 쉬다가 가세요…… 아, 저기… 지휘관님, 너무 가까이 오신 것 같은데…","voicelink":"http