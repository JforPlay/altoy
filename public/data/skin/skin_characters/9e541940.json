[{"클뜯 id":10800090,"클뜯 함순이 id":1080009,"함순이 이름":"공주","한글 함순이 + 스킨 이름":"공주","영문 함순이 + 스킨 이름":"Princess Hime","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800090/shipyard.png","설명":"앗! 들켰네…. 뭐 어때. 개인적인 시간인데 어떤 차림을 하고 술을 마시든 뭔 상관이야? …뭐야? 술로 달아오른 누님의 피부가 그렇게 궁금해?","자기소개":{"voiceline":"나는 용을 다스리는… 아니, 방금 건 못 들은 걸로! 너무 딱딱하게 대하는 건 싫으니까, 신비로운 공주님 정도로 생각해 주지 않을래? 미스터리한 느낌이라 괜찮은 것 같은데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/profile.ogg"},"메인1":{"voiceline":"저기 지휘관, 한가하면 차라도 한 잔 어때? 아니, 처음 보는 음료 같은 게 많아서 재밌어서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/main1.ogg"},"메인2":{"voiceline":"여기 애들은 참 대단해. 혼자서 저런 괴물들과 싸우다니… 용이랑 비교하면 어느 쪽이 더 강하려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/main2.ogg"},"메인3":{"voiceline":"아… 측근들이 지켜보질 않으니 왠지 해이해지는 것 같은… 아! 지휘관, 방금 건 못 본 걸로 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/main3.ogg"},"전투개시":{"voiceline":"모두들! 긍지를 가지고 적을 섬멸하라! 전군 돌격!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/battle.ogg"},"상세확인":{"voiceline":"무슨 연유로 내가 이 세상에 온 건지… 이것 또한 인연이 빚어낸 결과일까? …또 그 녀석에게서 멀어지고 말다니…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/detail.ogg"},"드랍 설명":{"voiceline":"어머? 여긴… 아, 음… 제게 무엇을 구하시는지요, 사람의 아이여… 아, 이런 건 필요 없다고? 아하하… 잘 부탁해, 이국 사람. 내 이름은… 음, 편하게 공주라고 불러줘.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 사람들이 돌아왔네. 마중은 윗사람으로서 다해야 할 책무라고. 자, 어서 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/expedition.ogg"},"실망":{"voiceline":"한 마디 조언하지. 사람의 마음을 헤아리는 것도 중요하다는 걸 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/feeling1.ogg"},"낯섦":{"voiceline":"처음 보는 음식에 음료… 가슴이 뜨거워지는 이야기… 굉장히 멋진 곳이네, 여기.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/feeling2.ogg"},"호감":{"voiceline":"여기 사람들은 내 신분이 어떻든 신경 쓰지 않고 자연스럽게 대해줘… 그렇지만 그게 그 녀석을 생각나게 해…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 무슨 일이야? 그렇게 쳐다보고… 아하~ 이 공주님의 미모에 빠진 모양이로군?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/feeling4.ogg"},"사랑":{"voiceline":"음~ 나는 말이야. 공주라는 지위에 오른 입장 때문인지 이런 건 익숙하지 않아서 어떻게 해야 할지 잘 모르겠는데… 그런 부분은 알아서 좀 헤아려주셨으면 하는데…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/feeling5.ogg"},"터치3":{"voiceline":"음~ 그렇게 함부로 스킨십을 하면 측근들이 소란을 피울 것 같은데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와~ 피곤하지? 먼지 털고 편히 쉬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/home.ogg"},"hp 경고":{"voiceline":"이럴 때… 그 분들이라면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관. 잘 잤어? 그래, 잘했어. 매일 충분히 수면을 취하는 건 중요하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/login.ogg"},"실패":{"voiceline":"아야야야… 지금은 일단 물러나겠습니다! 전군, 뒤로 돌아! 구보, 시자악~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/lose.ogg"},"우편":{"voiceline":"지휘관, 당신 앞으로 서한이 온 것 같던데… 확인해 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/mail.ogg"},"임무":{"voiceline":"지휘관, 업무가 남아있는데 돌아다니는 건… 좋지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/mission.ogg"},"임무완료":{"voiceline":"업무가 끝났네. 수고했어. 잊지 말고 꼭 대가도 받도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/mission_complete.ogg"},"서약":{"voiceline":"당신의 이야기는 끝없는 흥미로 가득하고, 함께 보내는 시간 또한 즐거워. …그 배려에 진심으로 감사하다는 말을 하고 싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/propose.ogg"},"스킬":{"voiceline":"이 몸에 깃든 힘, 지금이야말로 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/skill.ogg"},"터치1":{"voiceline":"어이쿠, 맘대로 건드리면 곤란하거든요~ 이래 보여도 귀한 몸이시라…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/touch.ogg"},"터치2":{"voiceline":"내게 손을 대면 근위 녀석들이 무슨 짓을 할지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/touch2.ogg"},"입수시":{"voiceline":"어머? 여긴… 아, 음… 제게 무엇을 구하시는지요, 사람의 아이여… 아, 이런 건 필요 없다고? 아하하… 잘 부탁해, 이국 사람. 내 이름은… 음, 편하게 공주라고 불러줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/unlock.ogg"},"강화성공":{"voiceline":"새로운 힘을 부여받는다는 건 바로 이런 느낌이로군…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"오! 이겼다! 전투에 자신 있는 편은 아니지만, 하면 되기는 하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/win_mvp.ogg"},"전투개시_ex":{"voiceline":"함성을 높여라! 우리의 힘을 적에게 보여줘라! 출격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/battle_ex.ogg"},"상세확인_ex":{"voiceline":"시대를 막론하고 사람들은 초현실적인 힘을 다루는 사람들을 신이라 부르며 숭상하고 두려워했지… 신은 신 나름대로 힘들 것 같지만 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"당신과는 진정한 인연을 맺었다고 생각해. 그렇지만 우린 진정한 의미에서 \"사는 세상이 달라\". 바꿀 수 없는 일이라고는 하지만, 과거만 돌아볼 게 아니라 미래를 내다봐야겠지…...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"안녕, 지휘관! 오늘도 만나서 기뻐! …정말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"아직 업무가 남아 있잖아! 아직 할 일이 남았으니까 게으름 피우면 안 돼~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/mission_ex.ogg"},"임무완료_ex":{"voiceline":"수고했어! 차 내려줄 테니까 이쪽으로 와서 잠깐 쉬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"너무 상냥하게 해주지 마. …나중에 생각날 테니까…...","voicelink":null},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"잘 했어. 조금이라도 당신에게 힘이 될 수 있어서 기뻐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['아스카가와 치세'] :  그 힘… 치세, 당신에게도 용을 다루는 힘이?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/couple_encourage1.ogg"},{"voiceline":"['신죠 아카네'] :  아카네… 당신은 대체……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/couple_encourage2.ogg"},{"voiceline":"['2대'] : 2대 씨, 당신도 우리와 함께 싸워 주시는군요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800090/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"