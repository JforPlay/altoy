[{"클뜯 id":502040,"클뜯 함순이 id":50204,"함순이 이름":"잉 루이","한글 함순이 + 스킨 이름":"잉 루이","영문 함순이 + 스킨 이름":"Ying Swei","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502040/shipyard.png","설명":"차오 호급 방호 순양함—잉 루이","자기소개":{"voiceline":"저는 차오 호급 방호 순양함 2호함——잉 루이. 차오 호의 동생이죠. 또 말씀드리고 싶은 건, 만약 저와 언니가 말싸움을 하는 걸 보시면 놀라지 마세요. 그건 사랑 표현이니까요. 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/profile.ogg"},"메인1":{"voiceline":"차오 호가 체면치레하는 일은 모두 저에게 맡겼어요. 저는 개의치 않지만, 단지 이렇게 된다면 기대하던 \"언니\" 지위에 대한 희망은 점점 멀어지지 않을까요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/main1.ogg"},"메인2":{"voiceline":"지휘관님, 이건 잉 루이로부터의 알림이에요——이미 넋을 놓고 계신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/main2.ogg"},"메인3":{"voiceline":"지휘관님은 서화에 관심이 있으세요? 만약 시간이 있으시면, 제가 가르쳐 드릴게요. 자기 자랑하는 것처럼 들리지만, 이 방면에 좀 능숙하거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/main3.ogg"},"전투개시":{"voiceline":"반드시 악을 제거한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/battle.ogg"},"상세확인":{"voiceline":"엄격히 말해, 시간상으로 제가 확실히 언니라고요... 하지만 차오 호가 그렇게 \"언니\"가 되고 싶다면 양보해 줄 거예요. 사실 \"동생\"이 되면 좋은 점도 꽤 있으니까요~ 히히.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/detail.ogg"},"드랍 설명":{"voiceline":"차오 호급 방호 순양함—잉 루이","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어요. 분주히 뛰어다니는 모든 동료를 위로하는 것을 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/expedition.ogg"},"실망":{"voiceline":"...... 잉 루이는 지휘관님께 드릴 말씀이 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/feeling1.ogg"},"낯섦":{"voiceline":"차오 호는 아마 춤 연습을 하지 않을까요. 지휘관님, 아니면... 우리 같이 한번 보러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/feeling2.ogg"},"호감":{"voiceline":"차오 호가 지휘관님께 제가 가사를 하라며 다그쳤다고 고자질했죠? 차오 호의 말은 곧이곧대로 믿어선 안 돼요. 전 단지 이유를 만들며 집안일을 회피하는 언니에게 현실을 마주하라고 말한 것뿐이라고요. 하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/feeling3.ogg"},"기쁨":{"voiceline":"최근, 지휘관님 곁에 있을 때면, 뭔가 불안한 기분이에요... 짚이는 점이 있긴 하지만......아, 죄송해요. 그냥 혼잣말 한 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/feeling4.ogg"},"사랑":{"voiceline":"하고 싶은 말은 많은데, 지휘관님을 보면 무슨 말을 해야 할지... 역시 필묵으로 제 감정을 전해야겠어요. 지휘관님은 비웃지 말아 주세요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/feeling5.ogg"},"터치3":{"voiceline":"머리카락을 헝클어 놓으면 일주일 동안 머리를 빗겨주는 벌을 줄 거에요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 어서 오세요. 이번 여정 중에 잉 루이에게 하고 싶은 말이 많았죠? 먼저 편안히 쉬세요. 나중에 또 얘기해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/home.ogg"},"hp 경고":{"voiceline":"우리는 절대 여기서 물러설 수 없어...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/hp_warning.ogg"},"로그인":{"voiceline":"근면 성실한 지휘관님, 오늘도 제시간에 오셨군요. 지휘관님... 정말 게으름 피우고 싶지 않으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/login.ogg"},"실패":{"voiceline":"제 힘으로는 아직 적을 막기에 역부족인가요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/lose.ogg"},"우편":{"voiceline":"새로운 우편이에요... 인쇄된 차가운 문자는 역시 손으로 쓴 글씨보다 인간미가 없군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/mail.ogg"},"임무":{"voiceline":"지휘관님, 새로운 임무가 있어요. 이럴 때 차오 호는 엄마처럼 일하라고 다그치지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/mission.ogg"},"임무완료":{"voiceline":"임무 완료입니다. 그럼 이제 맛있는 음식을 먹고 따뜻한 목욕물에 몸을 담근 후 수면하세요! 정말 그럴 수 있다면 얼마나 행복할까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/mission_complete.ogg"},"서약":{"voiceline":"흐르는 빠른 세월, 흰 종이에 남은 검은 글자만이 유일한 세월의 흔적. 이건 제가 소중히 적은 편지입니다. 지금 이 순간, 편지는 물론 제 모든 것을 담아 전합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/propose.ogg"},"스킬":{"voiceline":"단청불변!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/skill.ogg"},"터치1":{"voiceline":"피곤하시면 일찍 휴식하세요. 과로로 몸을 망치면 득보다 실이 많답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/touch.ogg"},"터치2":{"voiceline":"지금은 큰 소리로 \"무례\"하다고 외치기 가장 좋은 순간이에요. 지휘관님이 제게 잘해주신다면, 한번 봐 드릴 수도 있긴 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 안녕하세요. 저는 차오 호급 순양함의 언니, 잉 루이입니다... 차오 호는 자기가 언니라고 했어요? 흠, 물론 지휘관님은 속아 넘어가지 않을 테죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/unlock.ogg"},"강화성공":{"voiceline":"중요한 것을 보호하기 위해서, 자신의 힘을 기르지 않으면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리의 선언은 돌아가서 다시 얘기하시죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관과 서로의 마음을 확인한 지금, 오히려 여유를 찾은 느낌이에요. 