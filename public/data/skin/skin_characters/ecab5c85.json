rcontent.com/Fernando2603/AzurLane/main/images/skin/502042/shipyard.png","설명":"지휘관님, 새해 복 많이 받으시길. 잉 루이는 차오 호와 함께 올해 춘련을 준비하고 있어요. 그리고 지금 상황은… 일단 '인터벌'이라고 해둘까요? 후후후, 지휘관님은 아무것도 안 하셔도 괜찮아요. 거기서 어떻게 진행되는지만 봐주시면 된답니다♪","자기소개":null,"메인1":{"voiceline":"차오 호? 왜 그러시죠? 아직도 못 찾은 건가요? ……장난? 대체 그게 무슨 말씀이신지? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/main1.ogg"},"메인2":{"voiceline":"춘련을 적을 먹물이 다 떨어졌네요. 저기, 지휘관님. 먹을 가는 것 좀 도와주실 수 있으실까요? 지금은 조금 바빠서… 네, 나중에 차 내려드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/main2.ogg"},"메인3":{"voiceline":"아카시가 준 아이템은 편리하네요. 심부름을 시킬 수 있는 특제 만쥬 로봇 말고도 폭죽을 쏘는 아이에 사자춤을 추는 아이까지…… 푸슌네도 분명 마음에 들어할 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"춘련은 하이티엔에게 맡기고, 적는 건 제가, 장식하는 건 차오 호가 각각 담당하고 있어요. …뭐, 단순한 육체 노동이니, 차오 호에겐 무척이나 쉬운 일이겠죠. 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 새해 복 많이 받으시길. 잉 루이는 차오 호와 함께 올해 춘련을 준비하고 있어요. 그리고 지금 상황은… 일단 '인터벌'이라고 해둘까요? 후후후, 지휘관님은 아무것도 안 하셔도 괜찮아요. 거기서 어떻게 진행되는지만 봐주시면 된답니다♪","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"장난친 거, 차오 호에게 제대로 사과하고 왔어요. 그런데 지휘관님, 이 단란한 시간 뒤에……부끄럽지만 지휘관님과 단둘이 있을 때만 말씀 드릴 수 있는, 꼭 들어주셨으면 하는 말이 있는데…… 네, 선수를 친 거에 대한 사과는 다음에 또 하기로… 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"음~ 다리가 좀 피곤한 것 같네요…. 아, 지휘관님. 개선하시자마자 죄송하지만, 조금만 도와주실 수 있으실까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"속담에 '빠름은 적절한 시기만 못하다'라는 말이 있죠. 모처럼 여기 오셨으니 잠깐 앉으시는 게 어때요? 저희는 아무쪼록 개의치 마시구요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/login.ogg"},"실패":null,"우편":{"voiceline":"지휘관님 앞으로 온 우편이 있네요. 지금은 바빠서 죄송하지만… 책상 위에 둘게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"차오 호에게 장난을 치고 싶다구요? 네, 살살 부탁드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/touch.ogg"},"터치2":{"voiceline":"지휘관님, 차오 호도 여기에 있다구요. 이런 취미가 있으신 줄은 생각도 못했네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 새해 복 많이 받으시길. 잉 루이는 차오 호와 함께 올해 춘련을 준비하고 있어요. 그리고 지금 상황은… 일단 '인터벌'이라고 해둘까요? 후후후, 지휘관님은 아무것도 안 하셔도 괜찮아요. 거기서 어떻게 진행되는지만 봐주시면 된답니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502042/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70810,"상점 카테고리 id":3,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1080,"기간":"상시","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502043,"클뜯 함순이 id":50204,"함순이 이름":"잉 루이","한글 함순이 + 스킨 이름":"푸른 물결과 맑은 여름","영문 함순이 + 스킨 이름":"Blue Waves, Limpid Summer","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502043/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502043/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502043/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502043/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502043/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502043/shipyard.png","설명":"후후후, 지휘관님이셨군요. 좋은 타이밍에 오셨네요~ 잠깐 여유나 좀 즐겨 볼까 하던 참인데…… 후후, 모처럼이니 같이 수영장에서 쉬는 건 어떠세요?","자기소개":null,"메인1":{"voiceline":"지휘관님. 이 백조 튜브, 너무 귀엽지 않나요? 마음에 드시면…… 여기 앉으셔도 된답니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/main1.ogg"},"메인2":{"voiceline":"음? 지휘관님…… 아까부터 잉 루이를 뚫어져라 보고 계시네요. 지휘관님은 이런 시원한 차림을 좋아하시는 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/main2.ogg"},"메인3":{"voiceline":"햇살, 수영장, 그리고 지휘관님…… 이 느긋한 시간이 영원했으면 좋겠네요. 저, 이대로 쭉…… 으흠, 지금은 붓도 먹도 없으… 이 마음을 어떻게 표현해야 할지……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이 수영복은 차오 호와 함께 고른 거랍니다. 몸매가 돋보…… 으흠, 아무것도 아니에요. 지휘관님, 마음에 드세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/detail.ogg"},"드랍 설명":{"voiceline":"후후후, 지휘관님이셨군요. 좋은 타이밍에 오셨네요~ 잠깐 여유나 좀 즐겨 볼까 하던 참인데…… 후후, 모처럼이니 같이 수영장에서 쉬는 건 어떠세요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님, 수면 위에 우리 모습이 비치고 있어요. ……후후, 좀 더 가까이 와주시겠어요? 지휘관님과 함께 있는 이 모습을 마음 깊이 새기고 싶어서요. 그리고…… 지휘관님의 눈에 비친 사람이 과연 잉 루이뿐인지, 확인해 보고 싶거든요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/feeling5.ogg"},"터치3":{"voiceline":"아…… 지휘관님, 머리카락이 젖어버렸잖아요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/headtouch.ogg"},"모항귀환":{"voiceline":"후우… 돌아오셨군요. 피곤하신 것 같은데. 이걸 타고 물 위를 떠다니며 여유로운 시간을 보내는 건 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 어서 오세요. 혹시 오늘 다른 일정 있으세요? 후후, 마침 한가하시면… 이 잉 루이가 물놀이에 동행해 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"후후…… 이렇게 잔물결과 지휘관님을 바라보고 있으니…… 왠지 모르게 멍해지는 느낌이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/touch.ogg"},"터치2":{"voiceline":"남들 몰래 이런 짓을 하면, 위험한 일이 벌어질지도…… 아, 수영장에 빠질지도 모른다는 뜻이랍니다♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/touch2.ogg"},"입수시":{"voiceline":"후후후, 지휘관님이셨군요. 좋은 타이밍에 오셨네요~ 잠깐 여유나 좀 즐겨 볼까 하던 참인데…… 후후, 모처럼이니 같이 수영장에서 쉬는 건 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502043/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"수영복","상점 id":71143,"상점 카테고리 id":6,"스킨 태그":"쁘띠모션, 배경","입수 영상":"O","재화":880,"기간":"한정 (2025/06/25)","진영":"ROC","레어도":"SR","ex_chat_status":0},{"클뜯 id":502049,"클뜯 함순이 id":50204,"함순이 이름":"잉 루이","한글 함순이 + 스킨 이름":null,"영문 함순이 + 스킨 이름":"Ying Swei (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502049/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502049/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502049/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502049/icon.png","쥬스타 아이콘 일러":"h