[{"클뜯 id":705070,"클뜯 함순이 id":70507,"함순이 이름":"세바스토폴","한글 함순이 + 스킨 이름":"세바스토폴","영문 함순이 + 스킨 이름":"Sevastopol","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705070/shipyard.png","설명":"강구트급 전함 - 세바스토폴","자기소개":{"voiceline":"노스 유니온의 노급 전함, 그리고 흑해 함대의 기함인 세바스토폴이야. 후훗! 그래, 나야말로 혁명의 선봉이자, 몇 번을 공격당해도 결코 쓰러지지 않는 강철같은 의지의 현신이지. 알겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/profile.ogg"},"메인1":{"voiceline":"자, 지휘관 동지. 같이 마시…… 설마, 동지. 노스 유니온의 격식을 모른다고 하는 건 아니겠지? …보드카를 잘 못 마신다고? 그런 건 변명이 안돼. 자, 여기 와인도 있다구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/main1.ogg"},"메인2":{"voiceline":"함재기? 올테면 오라고 해. 나, 세바스토폴을 쓰러트릴 자신이 있다면 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/main2.ogg"},"메인3":{"voiceline":"혁명에 귀천은 없어. 후후후, 아무리 지휘관이라도 나와 뜻이 같다면 동지야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/main3.ogg"},"전투개시":{"voiceline":"당하기 싫으면 나오지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/battle.ogg"},"상세확인":{"voiceline":"동지여, 잘 왔어. 아무래도 내 революция(혁명)에 대해 알고 싶은 모양이네? 후훗, 굳이 물어볼 필요 없어. 동지에 대해서라면 훤히 다 아니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/detail.ogg"},"드랍 설명":{"voiceline":"강구트급 전함 - 세바스토폴","voicelink":null},"의뢰 완료":{"voiceline":"물자 수송은… 특히 전쟁터로 수송하는 건 어렵지. 의뢰팀의 노고에 감사해야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/expedition.ogg"},"실망":{"voiceline":"하인 근성은 좋다고 쳐도, 혁명에 대한 이해는 너무 부족한 것 같네….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/feeling1.ogg"},"낯섦":{"voiceline":"사실 지휘관 정도는 한 주먹 거리지만, 같은 뜻을 가진 동지로서 지금은 평등하게 대해줄게. 후훗, 기뻐하도록 해. 당신은 노스 유니온의 강철 물결에 휩쓸리지 않고, 그 일원이 된 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/feeling2.ogg"},"호감":{"voiceline":"전투광 녀석들은 동지에 대해 어떻게 평가할지 모르겠지만, 뭐 그럭저럭 괜찮은 술친구는 될 수 있을 거야. 후훗, 앞으로도 자만하지 말고 정진하라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/feeling3.ogg"},"기쁨":{"voiceline":"…캬아. 뭐야, 아직 잔을 반도 안 비웠잖아…. 후후, 후후후후… 이거 이제 보니까 내가 취하기만 기다리고 있는 거네…. 저런, 안타깝게 됐어…. 난 취해도… 후우… 필름은 안 끊긴다고….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/feeling4.ogg"},"사랑":{"voiceline":"…캬아. 지휘관 동지, 난 당신이 좋아. 사랑해. 내가 이기면 당신의 영원한 반쪽으로서 마지막 전투에 함께 가줄게…. 봐봐, 나 아직 안 취했어~ 이제 슬슬… 패배를 인정하는 게 어때♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/feeling5.ogg"},"터치3":{"voiceline":"?! 마, 만지지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/headtouch.ogg"},"모항귀환":{"voiceline":"동지의 개선을 축하하는 의미로… 자, 이 보드카로 건배하자♪ …(꿀꺽꿀꺽) …쿨럭, 쿨럭! 괘, 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/home.ogg"},"hp 경고":{"voiceline":"윽…! 술도 안 마셨는데…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이야, 지휘관 동지. 오늘의 적은 누군지… 자! 어서 가리켜 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/login.ogg"},"실패":{"voiceline":"침몰하지 않는 한 몇 번이고 다시 일어설 거야! 그게 바로 혁명이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/lose.ogg"},"우편":{"voiceline":"지휘관 동지, 당신 앞으로 온 우편이야. 답장할 거면 빨리 해. 너무 오래 상대방을 기다리게 하지 말라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/mail.ogg"},"임무":{"voiceline":"새 임무야. 자, 뒤풀이 자리에서의 보드카를 기대하면서 힘내.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/mission.ogg"},"임무완료":{"voiceline":"아하하하하! 혁명이 한 걸음 더 나아갔어! …너, 너무 많이 마시지 않는 편이 좋겠지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/mission_complete.ogg"},"서약":{"voiceline":"……응? 여긴… 윽, 너무 많이 마셨나……. 지휘관 동지?! 이 반지…… 내가 지휘관 동지한테 빼앗아서 맘대로 손에 꼈다고?! 그, 그게 말이 돼…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/propose.ogg"},"스킬":{"voiceline":"혁명에 축복을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/skill.ogg"},"터치1":{"voiceline":"내 동지니까 말이지, 친히 악수를 해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/touch.ogg"},"터치2":{"voiceline":"지휘관 동지…… 대체 무슨 생각이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/touch2.ogg"},"입수시":{"voiceline":"아하하하! 네가 지휘관 동지구나. 난 노스 유니온 소속 전함인 세바스토폴. 혁명은 다과회에서 찾을 수 있는 게 아니지. 날 그냥 평범한 마드모아젤이라고 깔본다면 큰 오산일걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/unlock.ogg"},"강화성공":{"voiceline":"혁명적인 강화네. 아하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아하하하! 혁명을 저지하는 어리석은 자에게 기다리는 운명은 타도뿐이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"어머, 지휘관 동지. 아무래도 다과회라는 명목의 술자리에 초대해줬으면 하고 날 찾아온 모양이네? 물론, 이미 초대장은 집무실 서랍 속에 넣어뒀지만♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"마시라고 맥주 좀 가지고 왔어. 흥, 내가 무슨 강구트도 아니고, 보드카만 마시면 질리잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"안녕, 지휘관 동지. 혁명은 겉만 번지르르한 게 아니야. 오늘도 다들 전장에 데려가 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"뭐든 물어봐. 동지로서 할 수 있는 건 다 해줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/touch_ex.ogg"},"터치2_ex":{"voiceline":"지, 지휘관 동지…… 방금 건 무슨 생각으로?///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['강구트'] :  윽… 보드카 냄새……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/couple_encourage1.ogg"},{"voiceline":"['아르한겔스크'] :  예의? 너무 신경 쓰지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/couple_encourage2.ogg"},{"voiceline":"['미카사', '아브로라'] :  잘난 척 구는 것 좀 적당히 해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"뭐야~? 나한테 뭘 배우고 싶은 얼굴을 하고 있네? 좋아♪ 노급 전함이자 훈련함인 이 세바스토폴님이 친히 가르쳐줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/main5_ex.ogg"},"메인6_ex":{"voiceline":"혁명에 끝이란 없어. 당신도 계속 내 지휘관 동지야. 그러니까 안심하라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"업무 중에 취하면 정말 꼴불견이겠지. 그러니까, 알겠어? 내가 취하기 전에 말리라구! …그럼, 건배~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705070/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SR","ex_chat_status":1},{"클뜯 id":705071,"클뜯 함순이 id":70507,"함순이 이름":"세바스토폴","한글 함순이 + 스킨 이름":"알딸딸한 정도가 아니야…?!","영문 함순이 + 스킨 이름":"More than a Little Drunk","스킨 타입":"Hot Springs","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705071/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705071/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705071/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705071/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705071/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/705071/shipyard.png","설명":"후우…… 여긴… 지휘관 동지? 어머, 이런 시간에 별일이네. 난… 후, 후후후후후… 너무 취해서 먼저 들어갔다고 하면, 역시 믿기 어렵겠지…?","자기소개":null,"메인1":{"voiceline":"(저, 절대 말 못해…. 강구트가 먹인 술 때문에 필름이 끊겨서, 정신이 드니 온천에 혼자 들어와 있었다고…! 으으윽…!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/main1.ogg"},"메인2":{"voiceline":"보로실로프? 걔는 걱정할 필요 없을걸? 근성으로 버티고 있는 건지는 모르겠지만, 절대 현기증이 안 나는 체질인 것 같던데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/main2.ogg"},"메인3":{"voiceline":"목욕 후의 즐거움은…… 나 대신 동지가 즐겨줄래? 나는 좀… 머리가…… 으윽…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"그러고 보니 이 옷은 언제 갈아입었냐고…. 다, 당연히 탕에 들어가려면 걸맞은 모습을 해야지! 봐, 여기 띠 같은 것도 잘 매고 있잖아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/detail.ogg"},"드랍 설명":{"voiceline":"후우…… 여긴… 지휘관 동지? 어머, 이런 시간에 별일이네. 난… 후, 후후후후후… 너무 취해서 먼저 들어갔다고 하면, 역시 믿기 어렵겠지…?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아온 것 같네. 우리 다음에는 의뢰팀이 들어갈 차례인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"(그나저나 정말 괜찮은 탕이네…. 지휘관이 올 때까지 너무 기분이 좋아서 취한 줄도 몰랐다니….)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"이제야 온 거야? 후훗, 지휘관 동지랑 함께면 나, 다시 들어가도 딱히 나쁠 거 없는데…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새 임무…… 뒤풀이 자리 술은 보드카가 아니라 와인이어도 괜찮다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"(기분 좋은 바람… 아, 맞다! 멋진 척 해서 술 취한 걸 얼버무리면…) ……에취?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/touch.ogg"},"터치2":{"voiceline":"축축해? …후후후, 그건 말이지. 탕에 들어갔으니까 당연한 거 아니야…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/touch2.ogg"},"입수시":{"voiceline":"후우…… 여긴… 지휘관 동지? 어머, 이런 시간에 별일이네. 난… 후, 후후후후후… 너무 취해서 먼저 들어갔다고 하면, 역시 믿기 어렵겠지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/705071/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_