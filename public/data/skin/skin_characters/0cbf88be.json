oicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/expedition.ogg"},"실망":{"voiceline":"사실 우린 잘 안 맞는 건지도 모르겠네…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/feeling1.ogg"},"낯섦":{"voiceline":"별로 대화하는 걸 좋아하지 않는 나였지만, 조금은 변한 것 같아. 뭐, 이건 이거대로 이야깃거리를 만들어내는 게 힘들지만…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/feeling2.ogg"},"호감":{"voiceline":"지휘관, 오늘은 그… 그러니까… 업무는 괜찮아? 아, 딱히 감독하려고 그러는 건 아니고, 그냥 인사말이었는데…. 이야깃거리 만들기에 실패한 건가….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/feeling3.ogg"},"기쁨":{"voiceline":"일부러 이야깃거리를 고를 거 없이, 그냥 편하게 이야기하면 된다고? 알았어, 해볼게. 그러니까… 아, 미안. 나, 왜, 왠지 지휘관 얼굴을 보니까 갑자기 긴장돼서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/feeling4.ogg"},"사랑":{"voiceline":"잠깐 같이 있어 달라… 아무 말 없이 그냥 곁에 있기만 하면 된다고? 그러면 이야깃거리에 무리하게 신경 안 써도 괜찮을 거라고……. 알았어. 내가 곁에 함께 있어줄게. 지휘관이 만족할 때까지 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"다들 무사히 귀환한 걸 확인했어. 지휘관, 고생 많았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/home.ogg"},"hp 경고":{"voiceline":"낙관적인 상황은 아니네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘 훈련도 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/login.ogg"},"실패":{"voiceline":"미안, 이럴 리가 없는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/lose.ogg"},"우편":{"voiceline":"지휘관에게 온 우편. 응……. 책상 위에 두면 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103260/mail.ogg"},"임무":{"voiceline":"새로운 임무? 도와줄까?","voicelink":"https://raw.githubuserco