ttps://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801028/battle.ogg"},"상세확인":{"voiceline":"식장을 둘러싼 많은 꽃… 왠지 보고만 있어도 가슴이 뭉클하네요. 에헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801028/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 드디어 맞이한 이 맑은 날… 정말 꿈만 같아요…. 저, 너무 행복해서…. 이럼 안 되지, 안 돼… 오늘은 울지 않겠다고 결심했는걸…! 견습 기사 포르뱅, 앞으로 평생 지휘관님 곁에서 분발하도록 하겠습니다!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어요. 물론 마중 나갈 때는 저도 같이 데려가 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801028/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"아직 꿈을 꾸는 듯 실감이 잘 안 나요…. 분명 앞으로 서로 의지해가면서 무게를 더해가겠죠. 지금 여기서 다시 한번 맹세할게요. …지휘관님, 당신 곁에서 검을 휘두르며, 영원히 곁을 떠나지 않을 것임을….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801028/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"흥… 어서 오세요. 정말… 다음에 또 이런 일이 있을 때는 저도 꼭 같이 데려가 주기로 약속하셔야 해요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801028/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 좋은 아침이에요. 그… 아직은 조금 부끄럽지만, 우선은 업무 보좌부터 시작하도록 하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801028/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"르 마르스? …앗?! 지휘관님?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801028/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 드디어 맞이한 이 맑은 날… 정말 꿈만 같아요…. 저, 너무 행복해서…. 이럼 안 되지, 안 돼… 오늘은 울지 않겠다고 결심했는걸…! 견습 기사 포르뱅, 앞으로 평생 지휘관님 곁에서 분발하도록 하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/801028/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":nul