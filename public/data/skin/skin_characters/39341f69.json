[{"클뜯 id":103040,"클뜯 함순이 id":10304,"함순이 이름":"시카고","한글 함순이 + 스킨 이름":"시카고","영문 함순이 + 스킨 이름":"Chicago","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103040/shipyard.png","설명":"노샘프턴급 중순양함·시카고 (CA-29)","자기소개":{"voiceline":"누나는 노샘프턴급 4번함 시카고야. 운이 별로 안 좋고 전과도 대단하진 않지만, 지휘관 군을 위해서 노력할테니까, 누나를 소중하게 다뤄줘~ 츄우♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/profile.ogg"},"메인1":{"voiceline":"여자는 시카고의 바람처럼 자주 변하는 거야, 지휘관 군♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/main1.ogg"},"메인2":{"voiceline":"이 거리이기에 둘만의 이야기가 가능한 거라구♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/main2.ogg"},"메인3":{"voiceline":"어깨가 뭉쳤네, 누나가 풀어줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/main3.ogg"},"전투개시":{"voiceline":"좋은 바람이네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/battle.ogg"},"상세확인":{"voiceline":"딱딱한 숫자하고 눈싸움하지 말고… 좀 더 부드러운 거 보지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/detail.ogg"},"드랍 설명":{"voiceline":"노샘프턴급 중순양함·시카고 (CA-29)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관 군, 의뢰하러 간 아이들이 돌아온 것 같아. 그 전에 잠깐 누나하고 좋은 거 하지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/expedition.ogg"},"실망":{"voiceline":"지휘관 군, 여자의 마음에 관한 공부가 더 필요하겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/feeling1.ogg"},"낯섦":{"voiceline":"지휘관 군, 밤은 길어. 누나와 어른의 게임이라도 하지 않을래? …농담이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/feeling2.ogg"},"호감":{"voiceline":"누나에게 벅찬 사람은 꽤 많지만, 지휘관 군은 괴짜구나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/feeling3.ogg"},"기쁨":{"voiceline":"최근 겸손해졌다고? 그렇지. 왜냐하면, 태어나서 처음으로 시선을 빼앗고 싶은 사람이 생겨버렸는걸. 노력해야지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/feeling4.ogg"},"사랑":{"voiceline":"어머, 안색이 안 좋잖니. 피로가 쌓여버린걸까…… 자아, 누나가 밥 만들어줄게. 누나에게도 책임, 있으니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어. 누나의 가슴으로 달래줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"방치 플레이에도 정도가 있단다. 지휘관 군~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/login.ogg"},"실패":{"voiceline":"어머나, 옷이 찢어져 버렸잖아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/lose.ogg"},"우편":{"voiceline":"새로운 메일이야. 여·기·있·어♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/mail.ogg"},"임무":{"voiceline":"새로운 임무를 정리했어 ……누나도, 가끔은 제대로 일하는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/mission.ogg"},"임무완료":{"voiceline":"보너스야. 지휘관 군은 언제나 착실히 하고 있구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/mission_complete.ogg"},"서약":{"voiceline":"지휘관 군에게 이걸 받기 위해 누난 상당히 참았다구? 받았으니 더는 참지 않아도 괜찮지? 그럼…… 마음의 준비를 해 둬, 절대 놓치지 않을 테니까♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103040/propose.ogg"},"스킬":{"voicelin