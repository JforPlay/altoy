[{"클뜯 id":203040,"클뜯 함순이 id":20304,"함순이 이름":"서포크","한글 함순이 + 스킨 이름":"서포크","영문 함순이 + 스킨 이름":"Suffolk","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203040/shipyard.png","설명":"켄트급 중순양함·서포크 (HMS Suffolk)","자기소개":{"voiceline":"켄트급 5번함 서포크입니다. 이래보여도 해야 할 때는 똑바로 한답니다? 덴마크 해전에서도 굉장한 역할을 했다구요! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/profile.ogg"},"메인1":{"voiceline":"예전에도 이렇게 여기저기 바라보다 전과를 손에 넣었거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/main1.ogg"},"메인2":{"voiceline":"지휘관 씨, 구름 씨를 함께 관찰하지 않겠습니까? 재미있는 것이 가득하답니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/main2.ogg"},"메인3":{"voiceline":"이래 봬도, 상당히 많은 곳에 갔던 적이 있다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/main3.ogg"},"전투개시":{"voiceline":"적 씨, 강한 듯해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/battle.ogg"},"상세확인":{"voiceline":"근대화 개수 전과 후의 수치는 전혀 다르다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/detail.ogg"},"드랍 설명":{"voiceline":"켄트급 중순양함·서포크 (HMS Suffolk)","voicelink":null},"의뢰 완료":{"voiceline":"저 구름 씨, 마시멜로 같아요…… 응? 어라라? 지휘관 씨, 의뢰 팀이 돌아왔어요! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/expedition.ogg"},"실망":{"voiceline":"……하늘은 푸르답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/feeling1.ogg"},"낯섦":{"voiceline":"응응. 원양 정찰하기 좋은 날씨~ 지휘관도 함께하지 않겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/feeling2.ogg"},"호감":{"voiceline":"정찰은 중요해요! 에, 땡땡이? 아, 아니에요! 구름 씨를 관찰하고 있던 것뿐이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/feeling3.ogg"},"기쁨":{"voiceline":"언니들은 모두 강하니까 서포크는 언니들의 도움이 될 수 있다면 기쁘답니다~? 에? 서포크도 노력하고 있다구요? 에헤헤, 칭찬받아 버렸어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/feeling4.ogg"},"사랑":{"voiceline":"다른 사람에게 칭찬받아도 기쁘지만, 지휘관 씨에게 도움이 돼서 칭찬받으면 더욱 더 기뻐져요. 어째설까…… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 씨 수고하셨습니다. 차라도 한 잔 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"아, 지휘관 씨 어서 오세요. 저 말인가요? 지금 구름 씨를 관찰하고 있었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/login.ogg"},"실패":{"voiceline":"으으으… 좀 더 집중할 수 있다면 좋았을 텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/lose.ogg"},"우편":{"voiceline":"지휘관 씨…… 어라? 무슨 말을 하려고 했더라…… 아, 그랬어요! 새로운 편지예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/mail.ogg"},"임무":{"voiceline":"날씨, 좋네요…… 어랏? 지휘관 씨, 새로운 미션이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/mission.ogg"},"임무완료":{"voiceline":"지휘관 씨도 멍하다가 미션 보너스를 잊어버렸던 거에요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/mission_complete.ogg"},"서약":{"voiceline":"훗훗후~ 지휘관은 드~디어 서포크의 천연스러움 속에 숨은 매력을 알아차리셨네요! 이제부터 당당하게 땡땡…… 에에엣! 안 돼…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/propose.ogg"},"스킬":{"voiceline":"어랏? 예쁜 갈매기 씨가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/skill.ogg"},"터치1":{"voiceline":"……………………흐에, 지휘관 씨?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/touch.ogg"},"터치2":{"voiceline":"……앗! 지휘관 씨! 있으면 있다고 말로 해주세요오~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/touch2.ogg"},"입수시":{"voiceline":"으에? 여기는 어디인 거야… 저기, 실례합니다…… 앗, 당신이 지휘관 씨인가요? 다행이다… 저는 서포크라고 합니다. 겨우 찾아냈어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/unlock.ogg"},"강화성공":{"voiceline":"이것으로 망설여도 자신을 지킬 수 있어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"얼라? 그 구름 씨는…… 에에에, 이겼던건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0},{"클뜯 id":203049,"클뜯 함순이 id":20304,"함순이 이름":"서포크","한글 함순이 + 스킨 이름":"서포크·改","영문 함순이 + 스킨 이름":"Suffolk (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203049/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203049/chibi.png","아이콘 일러":"https://raw.githubuser