[{"클뜯 id":301720,"클뜯 함순이 id":30172,"함순이 이름":"우라나미","한글 함순이 + 스킨 이름":"우라나미","영문 함순이 + 스킨 이름":"Uranami","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301720/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301720/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301720/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301720/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301720/shipyard.png","설명":"에, 우라나미가 왜 여기에? …… 응? 우라나미를 데리러 온 거야? 그럼 따라가줄게. 잘 부탁해——","자기소개":{"voiceline":"특I형… 음, 특II형 인가… 응, 아니야. 그 중간 어디에 속하는 구축함… 우라나미야. 제19 구축대의 동료들과 같이 참전했지. 응… 여기서 질문. 우라나미는 대체 무슨 형이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/profile.ogg"},"메인1":{"voiceline":"이 종이, 뒷장이 비어있어. 가져가서 그림 그리면 되겠다. 슥삭슥삭~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/main1.ogg"},"메인2":{"voiceline":"동료는 구하고 적은 무찌른다, 이게 우라나미의 신조야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/main2.ogg"},"메인3":{"voiceline":"우라나미는 귀여운걸 좋아하지만… 내가 좋아하는 걸 말할 때마다 다들 왜 이상한 표정을 짓는 걸까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/main3.ogg"},"전투개시":{"voiceline":"하늘과 바다는… 모두 파랗네—","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/battle.ogg"},"상세확인":{"voiceline":"키누의 가면이 귀엽다고 생각해서 한번 빌려달라고 했는데… 거절당했어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/detail.ogg"},"드랍 설명":{"voiceline":"특Ⅰ형 구축함 10번함 우라나미","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어. 그렇구나… 지휘관, 이미 알고 있었네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/expedition.ogg"},"실망":{"voiceline":"재미 없어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/feeling1.ogg"},"낯섦":{"voiceline":"우라나미는 귀여운 물건 모으는 것을 좋아해. 지휘관, 다음 번에 우라나미 콜렉션을 구경시켜 줄게. 얼린 도롱뇽이라던가, 근육 만쥬라던가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/feeling2.ogg"},"호감":{"voiceline":"커다란 지휘냥이 폭신폭신… 아니… 울퉁불퉁… 근육… 귀여워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 재미있는 걸 많이 알고 있는 모양이네… 요괴에 관 한 이야기, 해줄 수 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/feeling4.ogg"},"사랑":{"voiceline":"지휘관과 같이 있을 때면 물 만난 물고기, 벌꿀 앞의 꿀벌이 된 것 같아. 두근두근 가슴이 막 콩닥콩닥 거려서 펑! 하고 터질 것 같아… 응. 이런 느낌인 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 다녀왔쥬… 만쥬를 한번 따라해봤어… 응…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/home.ogg"},"hp 경고":{"voiceline":"무서워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/hp_warning.ogg"},"로그인":{"voiceline":"우라나미, 여기서 놀 건데… 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/login.ogg"},"실패":{"voiceline":"얼른 돌아가자. 누군가 또 사라지는 건 싫어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/lose.ogg"},"우편":{"voiceline":"편지 비행기… 슈웅… 떨어졌다——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/mail.ogg"},"임무":{"voiceline":"임무가 잔뜩 도착했어——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/mission.ogg"},"임무완료":{"voiceline":"임무 한가득을 끝내니 또 한가득이 더…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301720/mission_complete.ogg"}