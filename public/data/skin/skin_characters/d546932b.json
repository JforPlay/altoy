link":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관네 집무실은 겉으로 보기엔 엄청 깨끗하네. 설마 찬장 문을 열면 서류가 막 후두둑…… 떨어지지는 않네. 역시 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관! 여기는 식당 메뉴도 진짜 엄청나네! 처음 들어보는 요리도 있고…… 사진 찍어서 SNS에 올리면 떡상각일텐데 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SSSS","레어도":"SR","ex_chat_status":1},{"클뜯 id":10800031,"클뜯 함순이 id":1080003,"함순이 이름":"핫스","한글 함순이 + 스킨 이름":"모항 인터뷰 방송 중!","영문 함순이 + 스킨 이름":"Seaside Scoop!","스킨 타입":"Casual","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800031/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800031/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800031/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800031/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800031/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800031/shipyard.png","설명":"핫스가 왔어. 오늘은 야간의 모항을 구경해보고 싶어. 그리고 여긴 이번 특별 게스트…… 지휘관——! …… 어이, 빨리 카메라 화면으로 들어와!","자기소개":null,"메인1":{"voiceline":"다음이 마지막인가. 끝나면 둘이서 데이트라도……. 당연히 농담이지, 뭘 그렇게 부끄러워 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/main1.ogg"},"메인2":{"voiceline":"(역시 밤이라 좀 춥네. 조금만 더 두껍게 입고 올걸……) 응? 겉옷 빌려주게? 캬, 배려심이 좋네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/main2.ogg"},"메인3":{"voiceline":"평소보다 키가 커 보인다고? 에이, 기분 탓……. 야, 잠깐, 신발 보지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"하아…… 편집 작업하는 거 지치네. 지휘관, 잠깐 차 한 잔 하고 올까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/detail.ogg"},"드랍 설명":{"voiceline":"핫스가 왔어. 오늘은 야간의 모항을 구경해보고 싶어. 그리고 여긴 이번 특별 게스트…… 지휘관——! …… 어이, 빨리 카메라 화면으로 들어와!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"이 다음에는 요즘 핫하다는 이 카페를 가볼까, 아니면 대박 조짐이 보이는 이 레스토랑으로 할까……. 아, 지휘관. 너도 좀 생각하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"겨우 도착했네. 그럼, 오늘 촬영 순서에 대해 설명할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"야야, 아까부터 너무 아래쪽만 보는 거 아니냐. 대체 뭐가 신경쓰여서 그러는 건지, 어디 한 번 말씀해 보셔, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/touch.ogg"},"터치2":{"voiceline":"으아, 잠깐. 방송 중이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/touch2.ogg"},"입수시":{"voiceline":"핫스가 왔어. 오늘은 야간의 모항을 구경해보고 싶어. 그리고 여긴 이번 특별 게스트…… 지휘관——! …… 어이, 빨리 카메라 화면으로 들어와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800031/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메