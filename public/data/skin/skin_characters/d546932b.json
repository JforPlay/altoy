[{"클뜯 id":10800030,"클뜯 함순이 id":1080003,"함순이 이름":"핫스","한글 함순이 + 스킨 이름":"핫스","영문 함순이 + 스킨 이름":"Hass","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800030/shipyard.png","설명":"안녕, 핫스라고 해. 갑자기 이상한 곳으로 와버린 것 같네…… 하지만 재밌으니까 신경 쓰지 않을래. 그런데, 여기서 동영상 촬영해도 오케이야?","자기소개":{"voiceline":"본직은 여고딩, 지금은 경순양함으로 뛰고 있는 핫스입니당~ 원래 살던 곳에서는 동영상 스트리밍같은 것도 했었어. 여기도 그런거 있어? 괜찮은 스트리머 있으면 좀 알려줘봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/profile.ogg"},"메인1":{"voiceline":"와, 여기 괜찮은 곳 많은데? 사진 찍다가 시간 다 가겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/main1.ogg"},"메인2":{"voiceline":"나미코랑 릿카 씨가 늦네. 안뜰에서 모이자고 분명 그랬는데……. 뭐, 익숙하지 않은 곳이니 어쩔 수 없나. 영상이라도 보면서 기다려야겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/main2.ogg"},"메인3":{"voiceline":"헤에, 이 고양이 같은 녀석, 지휘냥이라고 하는구나. 귀엽네……. 게다가 엄청 부드러워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/main3.ogg"},"전투개시":{"voiceline":"몰래 동영상 찍으면 안 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/battle.ogg"},"상세확인":{"voiceline":"엥, 나에 대해 더 알고 싶다고? 음, 그럼 일단, 도너츠라도 좀 사와봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/detail.ogg"},"드랍 설명":{"voiceline":"안녕, 핫스라고 해. 갑자기 이상한 곳으로 와버린 것 같네…… 하지만 재밌으니까 신경 쓰지 않을래. 그런데, 여기서 동영상 촬영해도 오케이야?","voicelink":null},"의뢰 완료":{"voiceline":"다들 수고했어. 혹시 뭐 재밌는 일은 없었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/expedition.ogg"},"실망":{"voiceline":"아……. 너 말야, 이제보니 꽤나 거시기한 사람이었구나…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 여긴 카페 같은 거 없어? 달달한 디저트가 좀 땡겨서. 오, 데려다 주게? 신난다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/feeling2.ogg"},"호감":{"voiceline":"야, 아까부터 왜 그렇게 쳐다봐……. 응? 왜 계속 마스크를 끼고 있냐고? 뭐, 사정이 좀 있어서 말이지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/feeling3.ogg"},"기쁨":{"voiceline":"저기요, 지휘관님~? 어젯밤, 여자랑 단 둘이서 뭘 하신 거죠? ……뭐? 잘못 본 거라고? 아니아니아니, 똑똑히 봤거든? 자자, 솔직하게 털어놓으라고~ (히죽히죽)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/feeling4.ogg"},"사랑":{"voiceline":"이곳도 이제 꽤 익숙해졌네. 아니, 솔직히 처음에는 어떻게 해야 하나 싶었는데, 이래저래 지금 생활도 꽤 즐기고 있더라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/feeling5.ogg"},"터치3":{"voiceline":"응? 할 말 있으면 직접 말로 하라고~ (부비적부비적)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/headtouch.ogg"},"모항귀환":{"voiceline":"오, 어서 와. 안 그래도 지금 딱 지휘관에게 보여 주려던 영상이 있었는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/home.ogg"},"hp 경고":{"voiceline":"승부는 지금부터…… 라고 할 타이밍인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/hp_warning.ogg"},"로그인":{"voiceline":"오, 왔다 왔어. 그럼, 오늘도 시작해보자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/login.ogg"},"실패":{"voiceline":"자, 잠깐! 이렇게 셀 줄은 몰랐어! 와, 여고딩 상대로 봐주지도 않고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/lose.ogg"},"우편":{"voiceline":"지휘관, 우편 왔던데? 빨리 안 열어보면 다른 우편에 파묻혀버린다고~.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/mail.ogg"},"임무":{"voiceline":"엥, 아직 일할 거 남았잖아. 우선은 해야할 걸 먼저 하자고……. 놀고 싶은 마음은 이해하지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/mission.ogg"},"임무완료":{"voiceline":"일이 끝나면 뭘 엄청 받네. 부럽습니다요~ 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/mission_complete.ogg"},"서약":{"voiceline":"네가 이 세상에 대해 이것저것 알려준 덕분에 오늘까지 별일없이 잘 지냈네. 뭐, 기대에 부응할 수 있도록 앞으로도 열심히 할 테니까…… 계속 잘 부탁한다고, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/propose.ogg"},"스킬":{"voiceline":"촬영 준비도 완벽해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/skill.ogg"},"터치1":{"voiceline":"오, 지휘관. 지금 아주 쪼~금 한가한데, 모항에 숨겨진 명소 같은 거 있으면 좀 데리고 가줘라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/touch.ogg"},"터치2":{"voiceline":"아, 여보세요. 거기 경찰이죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/touch2.ogg"},"입수시":{"voiceline":"안녕, 핫스라고 해. 갑자기 이상한 곳으로 와버린 것 같네…… 하지만 재밌으니까 신경 쓰지 않을래. 그런데, 여기서 동영상 촬영해도 오케이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/unlock.ogg"},"강화성공":{"voiceline":"헤에, 이게 레벨업이라는 거야? 확실히 뭔가 강해진 것 같은 느낌이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"뭐, 나한테 걸리면 이 정돈 누워서 떡 먹기지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/win_mvp.ogg"},"전투개시_ex":{"voiceline":"다들 날 따르라! 막 이래.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800030/battle_ex.ogg"},"상