[{"클뜯 id":303170,"클뜯 함순이 id":30317,"함순이 이름":"스즈야","한글 함순이 + 스킨 이름":"스즈야","영문 함순이 + 스킨 이름":"Suzuya","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303170/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303170/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303170/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303170/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303170/shipyard.png","설명":"모가미급 중순양함 3번함—스즈야","자기소개":{"voiceline":"저는 모가미형 3번함 스즈야입니다. 과거 제 7함대의 일원으로, 모가미 언니들과 함께 전투했었죠. 마지막 전투에서 아쉬움을 남겼지만... 이번 새로운 전장에서는 새로운 힘으로 새로운 동료들과 함께 싸울거에요. 잘 부탁드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/profile.ogg"},"메인1":{"voiceline":"지휘관의 시선... 아, 아닙니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/main1.ogg"},"메인2":{"voiceline":"쿠마노, 모가미 언니를 귀찮게 하면 안돼요. 미쿠마 언니 또 속쓰려해요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/main2.ogg"},"메인3":{"voiceline":"저희가 \"스즈야형\"이라는 말이있지만, 저희는 그래도 \"모가미형\"이 듣기 편해요. 모두 예전부터 함께 해왔으니까요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/main3.ogg"},"전투개시":{"voiceline":"이번엔... 절대 피하지 않을거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/battle.ogg"},"상세확인":{"voiceline":"지휘관님? 아, 다음 수업 내용을 예습 중이에요. 저는 신경쓰지 말고 계속 업무 보시면 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/detail.ogg"},"드랍 설명":{"voiceline":"모가미급 중순양함 3번함—스즈야","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 항구에 돌아왔어요. 같이 나가서 맞이해줘요. 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/expedition.ogg"},"실망":{"voiceline":"모가미 언니는 자신을 과소평가해요. 근데 지휘관님은, 다른 사람들이 과소평가하는듯하네요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/feeling1.ogg"},"낯섦":{"voiceline":"저희 모가미형을 알고 싶나요? 네, 제가 지휘관님께一一설명해드릴 수 있어요. 어떤 걸 알고 싶으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/feeling2.ogg"},"호감":{"voiceline":"지휘관님은 스즈야 자체에 관심이 있나요? 들려드린다고 하는 것은 물론 문제 없는데...... 정말 설명만으로 괜찮으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/feeling3.ogg"},"기쁨":{"voiceline":"... 숨기는 건 소용없어요. 스즈야는 이미 지휘관님의 생각을 알고 있다구요. 지휘관님도 자신에게 솔직해져보세요...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/feeling4.ogg"},"사랑":{"voiceline":"하하... 지휘관님의 시선은 이랬군요... 지금이라면, 분명하게 말할 수 있을 것 같아요. 스즈야는 줄곧 지휘관님을 흠모해왔어요...... !?(작게) 으음... 말하고나니까 조금... 오그라드네...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"쌓은 경험을 되짚어보고 다음 전투에 이용하는 것은 매우 중요해요. 우선 보고 확인부터 할 수 있을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/home.ogg"},"hp 경고":{"voiceline":"겨우 이 정도... 전 철수하지 않을 겁니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/hp_warning.ogg"},"로그인":{"voiceline":"환영합니다. 지휘관님. 오늘은 어떤 업무부터 시작할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/login.ogg"},"실패":{"voiceline":"음... 어쩔 수 없네요.......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/lose.ogg"},"우편":{"voiceline":"우편이 왔어요. 이건... 지휘관님에게 온 우편... 이군요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/mail.ogg"},"임무":{"voiceline":"임무의 진행 상태를 정리했어요, 확인해보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 왔어요. 정말 기쁘군요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/mission_complete.ogg"},"서약":{"voiceline":"(작게) 지휘관님, 의식이 끝나면...... 뭘 해야하는지 알고 계시죠? 안심하세요. 스즈야가 그 어떤 사람보다 지휘관님을 잘 대해줄 테니까요... 알았죠? 달링♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/propose.ogg"},"스킬":{"voiceline":"제대로 해주겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/skill.ogg"},"터치1":{"voiceline":"지휘관님... 방금 절 몰래 보셨나요? 다 안다구요...? 방금 분명히 지휘관님의 시선이 느껴졌는데... 맞죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/touch.ogg"},"터치2":{"voiceline":"음... 지휘관님 처음부터 이럴 생각이였죠... 스즈야는 아주 잘 알고 있답니다. 그럼요. 이보다 더 잘 알고 있을 수가 없죠.....하하하♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/touch2.ogg"},"입수시":{"voiceline":"모가미급 중순양함 스즈야, 착임했습니다. 지휘관님, 오늘부터 잘 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/unlock.ogg"},"강화성공":{"voiceline":"전투력이 강화되었어요. 너무 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/upgrade.ogg"},"vote":null,"승리":{"voiceline":"모두 축하——엇? 스즈야가 MVP인가요...? 가, 감사합니다...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['모가미'] : 모가미 언니의 괴로움을 저는 이해할 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303170/couple_encourage1.ogg"},{"voiceline":"['아카기', '아타고', '준요'] : 설마 저도......? 아니, 전 아니에요......","voicelink":"h