e/202260/expedition.ogg"},"실망":{"voiceline":"지휘관님, 제가 메이드 업무를 정상 완료할 수 있도록, 제 주변 3미터 내 구역으로 접근하지 말아주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 힘드시면 휴식하세요. 다신 절 위해 번거로운 일을 늘리지마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 침대 시트 색깔은 흰색으로 할까요...아니면 녹색? 제 눈과 같은 색이요? 그, 그렇군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/feeling3.ogg"},"기쁨":{"voiceline":"저의 평소 차림이요? 지휘관님 제가 무엇을 입든 보기 좋다고 하지 않으셨나요? 그럼 스스로 상상해보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/feeling4.ogg"},"사랑":{"voiceline":"침대도 준비했고, 이불도 널었었는데. 지휘관님은 어젯밤 밤새 업무를 보셨죠... 아니에요, 전혀 화 안났어요. 열심히 일하는 것도 아주 좋죠, 안그래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고 많으셨습니다. 편히 쉬세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/home.ogg"},"hp 경고":{"voiceline":"아, 아직 버틸 수 있어요…! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/hp_warning.ogg"},"로그인":{"voiceline":"돌아오신 것을 환영합니다. 차는 이미 준비해뒀어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/login.ogg"},"실패":{"voiceline":"검토가 필요해요......다음 번엔 지지 않을 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/lose.ogg"},"우편":{"voiceline":"새로운 우편이 있어요. 제가 지휘관님 대신 가져올게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/mail.ogg"},"임무":{"voiceline":"새로운 임무를 받았어요. 꼭 보셔야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202260/mission.ogg"},"임무완료":{"voiceline":"임무 보상은 제가 우선 보관할게요.","voicelink":"https://r