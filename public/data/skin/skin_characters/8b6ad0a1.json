[{"클뜯 id":102210,"클뜯 함순이 id":10221,"함순이 이름":"꼬마 샌디에이고","한글 함순이 + 스킨 이름":"꼬마 샌디에이고","영문 함순이 + 스킨 이름":"Li'l Sandy","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102210/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102210/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102210/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102210/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102210/shipyard.png","설명":"애틀랜타급 경순양함 - 샌디에이고 (CL-53) ","자기소개":{"voiceline":"애틀랜타급 3번함, 샌디에이고야! 장래 희망은 함대에서 제일 빛나는☆슈퍼 스타가 되는 것!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/profile.ogg"},"메인1":{"voiceline":"모르는 게 있으면 물어볼 것! 이라는 말을 들었는데, 뭘 물어봐야 하는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/main1.ogg"},"메인2":{"voiceline":"으으으음……나의 대단함을 모두가 깨닫게 만들 방법은 없을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/main2.ogg"},"메인3":{"voiceline":"에에엣! 지휘관, 계속 여기 앉아있기만 하면 지루하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/main3.ogg"},"전투개시":{"voiceline":"바다를 향해, 전진하라아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/battle.ogg"},"상세확인":{"voiceline":"하늘에는 비행기 뿐만 아니라, 구름이랑 별도 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/detail.ogg"},"드랍 설명":{"voiceline":"애틀랜타급 경순양함 - 샌디에이고 (CL-53)","voicelink":null},"의뢰 완료":{"voiceline":"……………?! 지휘관, 누가 돌아왔다고 샌디에이고의 직감이 가르쳐 줬어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/expedition.ogg"},"실망":{"voiceline":"지휘관, 괜찮아! 샌디에이고 보다 바보인건 당신 탓이 아니니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/feeling1.ogg"},"낯섦":{"voiceline":"잘 모르겠는 일은 전부 잊어버릴 수 있다면 매일이 행복할 텐데! 지휘관, 그렇게 생각하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/feeling2.ogg"},"호감":{"voiceline":"잊을 수 없는 문제가 있다면 어떻게 하지? ……아! 알겠다! 지휘관에게 물어보면 되겠구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/feeling3.ogg"},"기쁨":{"voiceline":"어떤 어려운 문제라도 답을 알고 있다니……혹시 지휘관은 여기서 제일 똑똑한 사람인 거야!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/feeling4.ogg"},"사랑":{"voiceline":"잘 모르겠는 일이 있어도 지휘관이 있어 준다면 괜찮을 거야! 응응, 뭐든지 다 알고 있는 지휘관, 너무 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관! 지금 그건 숨바꼭질이었던 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/home.ogg"},"hp 경고":{"voiceline":"어째서 다들 심각한 표정을 하고 있는 거야??","voicelink":null},"로그인":{"voiceline":"여! 지휘관! 여기 잔뜩 있는 종이를 이용해서 누가 만든 종이비행기가 제일 멀리 가는지 시합하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/login.ogg"},"실패":{"voiceline":"에엣? 저쪽은 모항으로 돌아가는 방향 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/lose.ogg"},"우편":{"voiceline":"지휘관에겐 항상 메일이 와 있네! 다음번엔 나도 써 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/mail.ogg"},"임무":{"voiceline":"내가 단번에 임무를 정리해 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/mission.ogg"},"임무완료":{"voiceline":"보상이 엄청 많아! 어때? 내가 꽤 도움이 되었지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/mission_complete.ogg"},"서약":{"voiceline":"이 반짝반짝한 건 뭐야~? 아, 이렇게 손가락에 끼우는 거야? 오오, 예쁘다! 그럼 계속 끼고 있을게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/propose.ogg"},"스킬":{"voiceline":"알았어! 곧 갈게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/skill.ogg"},"터치1":{"voiceline":"좋아! 이번엔 내가 술래야! 지금 10까지 셀 테니까…으음, 1, 2, 5, 10!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/touch.ogg"},"터치2":{"voiceline":"지휘관은 바보야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/touch2.ogg"},"입수시":{"voiceline":"샌디에이고, 등☆장! 아차! 호잇!흐흥, 세상에 하나밖에 없는 이 등장법! 역시 내가 제일 똑똑하다니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/unlock.ogg"},"강화성공":{"voiceline":"엣, 이게 진짜 도움이 되는 거야??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/upgrade.ogg"},"vote":null,"승리":{"voiceline":"봤어?! 지금 그거 봤냐구?! 내가 MVP야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['애틀란타'] : 애틀랜타 언니! 이쪽이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/couple_encourage1.ogg"},{"voiceline":"['샌디에이고'] : 둘이 함께라면, 최☆강!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102210/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0}]