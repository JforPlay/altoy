[{"클뜯 id":202130,"클뜯 함순이 id":20213,"함순이 이름":"아레투사","한글 함순이 + 스킨 이름":"아레투사","영문 함순이 + 스킨 이름":"Arethusa","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202130/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202130/shipyard.png","설명":"아레투사급 경순양함·아레투사 (HMS Arethusa)","자기소개":{"voiceline":"나는 아레투사급 조약형 순양함── 아레투사야. 세계 최초의 수직 장갑 설계를 구현해낸 조약형 순양함이라고! ──흥! 굉장하다는 둥, 지극히 당연하잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/profile.ogg"},"메인1":{"voiceline":"우군이라도, 아군에게 위협이 될 수 있다면 용서하지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/main1.ogg"},"메인2":{"voiceline":"…날 내팽개쳐두고선… 외, 외롭지 않거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/main2.ogg"},"메인3":{"voiceline":"흥! 지휘관은 못 써먹을 사람이니까, 항상 내가 보살피게 되는 거잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/main3.ogg"},"전투개시":{"voiceline":"잘 들어! 이건 자존심이 걸린 싸움이야! 제대로 하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/battle.ogg"},"상세확인":{"voiceline":"…바보! 여자아이를 빤히 쳐다보는 건 실례라고 배우지 않았어!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/detail.ogg"},"드랍 설명":{"voiceline":"아레투사급 경순양함·아레투사 (HMS Arethusa)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 나간 팀이 돌아왔어. 빨리 성과를 체크해오란 말야, 이 바보야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/expedition.ogg"},"실망":{"voiceline":"너 같은 지휘관은 역시 인정 못 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/feeling1.ogg"},"낯섦":{"voiceline":"너 같은 지휘관은 인정하지 않겠어! 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/feeling2.ogg"},"호감":{"voiceline":"우쭐거리지 마! 여기 오면 맛있는 케이크가 있어서 오는 것뿐이니까! 널 인정하기엔 아직 한참 멀었으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/feeling3.ogg"},"기쁨":{"voiceline":"너 좋은 점도 있구나… 흥! 조금 다시 봤을 뿐이야! 할 일은 아직 많이 있다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/feeling4.ogg"},"사랑":{"voiceline":"저… 그… 수고했… 아무것도 아냐! 나 지금 기분 좋으니까, 과자 만들어 줬으니까, 빨리 먹으라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"일하는 건 굼뜬 주제에, 복귀하는 것 하난 빠르네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 제대로 안 하면 화낼 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/login.ogg"},"실패":{"voiceline":"큭… 나… 여기서 쓰러질 수는…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/lose.ogg"},"우편":{"voiceline":"네 편지니까 빨리 가져가. …딱히 누구한테서 온 건지 신경 쓰이는 건 아니니까! 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/mail.ogg"},"임무":{"voiceline":"이 바보야! 그만 자! 새 임무라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/mission.ogg"},"임무완료":{"voiceline":"너한텐 썩 괜찮은 보너스 아냐? 빨리 가져가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/mission_complete.ogg"},"서약":{"voiceline":"바보, 형식에 너무 집착하고 있잖아! 이런 거… 전부터 쭉…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/propose.ogg"},"스킬":{"voiceline":"꾸준히 계속해나간다면…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/skill.ogg"},"터치1":{"voiceline":"따, 딱히 너 같은 바보가 만져주는 거 좋아하는 거 아니거든! …네가 쓸쓸해 하니까 불쌍해서 만지게 해줄 뿐이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/touch.ogg"},"터치2":{"voiceline":"꺄앗! 변태! 치한! 꼴불견이야! 한 번 나가 죽었다가 와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/touch2.ogg"},"입수시":{"voiceline":"이 아레투사가 온 이상, 안심해도 괜찮아. 오히려 지휘관, 내 발목을 잡지 말아줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 내 발목을 잡지 말란 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥! 칭찬해도 인정해주지 않을 거니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202130/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0}]