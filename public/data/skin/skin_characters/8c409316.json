[{"클뜯 id":101240,"클뜯 함순이 id":10124,"함순이 이름":"심즈","한글 함순이 + 스킨 이름":"심즈","영문 함순이 + 스킨 이름":"Sims","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101240/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101240/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101240/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101240/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101240/shipyard.png","설명":"심즈급 구축함·심즈 (DD-409)","자기소개":{"voiceline":"심즈급의 네임 쉽은 바로 나야. 지휘관 있잖아~ 산호해 같은 얘기는 하지 마, 그걸 들으면 무심코 다른 사람을 괴롭히고 싶어지거든~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/profile.ogg"},"메인1":{"voiceline":"그거 알아? 내 여동생 중에 모리스라는 애가 가장 괴롭히는 맛이 있다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/main1.ogg"},"메인2":{"voiceline":"그럼 지휘관, 한번 찾아봐. 내가 준비해놓은 서프라이즈가 과연 몇 개나 있을까~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/main2.ogg"},"메인3":{"voiceline":"자, 나랑 같이 포즈~ 걸렸다! 간질간질 공격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/main3.ogg"},"전투개시":{"voiceline":"적당히 해치워 버릴까나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/battle.ogg"},"상세확인":{"voiceline":"지휘관 있잖아~ 아무리 뚫어지게 봐도 능력치는 안 오른다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/detail.ogg"},"드랍 설명":{"voiceline":"심즈급 구축함·심즈 (DD-409)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료까지 앞으로 5분~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/expedition.ogg"},"실망":{"voiceline":"아, 지금 정리 중이야. 이제 지휘관 안 건들 거라구. 기뻐?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/feeling1.ogg"},"낯섦":{"voiceline":"뭐─야, 지휘관, 나한테 한눈에 반했어? 나 가벼운 남자는 싫다구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/feeling2.ogg"},"호감":{"voiceline":"최근 말야, 지휘관, 내가 장난쳐도 화 안 내게 됐는데, 뭔가 외롭잖… 응? 우쭐해진 거 아니거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/feeling3.ogg"},"기쁨":{"voiceline":"정말 뭐야, 뺨 잡아당기고…… 억지웃음은 안 돼? ……바─보, 진짜로 웃고 있는 것도 못 알아보는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/feeling4.ogg"},"사랑":{"voiceline":"자, 지휘관, 동전을 던져서~ 겉 부분이 나오면 심즈를 좋아한다고 말해~ 어느 쪽이든 겉 부분? 아차─ 들켜버렸네─ (데헷) ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관. 있잖아, 나 지금 목욕하러 갈 건데, 같이 어때~ 힛힛힛~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 와, 지휘관…… 칠판지우개? 글쎄? 내가 올려둔 거 아닌데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/login.ogg"},"실패":{"voiceline":"돌아가서 지휘관이랑 놀아주는 게 더 낫겠는걸…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/lose.ogg"},"우편":{"voiceline":"앗, 러브레터다! …아 미안, 잘못 봤네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/mail.ogg"},"임무":{"voiceline":"다음 의뢰 완료까지 앞으로 5분이야~ 힛힛힛","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/mission.ogg"},"임무완료":{"voiceline":"어라~ 미션 보너스가 있구나~ 모르고 버릴 뻔 했어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101240/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 뭐야? ……눈을 감아보라고? 하항~ 설마 평소의 장난에 대한 복수란 거야? 좋아~ 어차피 바보 지휘관 따위…… 어, 어라…… 이건……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voicel