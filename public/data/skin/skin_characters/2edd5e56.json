[{"클뜯 id":9707080,"클뜯 함순이 id":970708,"함순이 이름":"요크타운·META","한글 함순이 + 스킨 이름":"요크타운·META","영문 함순이 + 스킨 이름":"Yorktown META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707080/shipyard.png","설명":"……만나서 반가워요. 아니, 오랜만일까요? 지휘관님, 그대로 저를 지켜봐 주세요. 이 평온한 시간을 더 느끼고 싶어요……","자기소개":{"voiceline":"……「META」 요크타운, 관측하는 자이자, 관측되는 존재죠. 존재와 소멸의 균형을 유지하는 자로, 정해진 자리도 없고 세상의 이치에 얽매이지도 않아요. 저는…… 그저 저일 뿐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/profile.ogg"},"메인1":{"voiceline":"……이글이 아까부터 날개를 비비고 있네요. 혹시 배가 고픈 걸까요? 네……? 그냥 스킨십이라고요? 그렇군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/main1.ogg"},"메인2":{"voiceline":"……보고 관측함으로써 존재한다. 모든 것은 관측을 통해서만 가치가 부여되는 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/main2.ogg"},"메인3":{"voiceline":"……네, 전부 기억하고 있어요. 마음이 닿을 때마다 지어 주신 그 미소, 목숨과도 맞바꿀 수 있는 그 감정… 단 한 번도 잊은 적 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/main3.ogg"},"전투개시":{"voiceline":"……너희는 내 관측을 방해했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/battle.ogg"},"상세확인":{"voiceline":"……왜 관측을 계속하냐고요? 그러지 않으면 아주 중요한 무언가가 사라져 버리니까요. 더 자세히 설명할 수도 있지만… 목적보다 과정이 중요할 때도 있답니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/detail.ogg"},"드랍 설명":{"voiceline":"요크타운급 항공모함 요크타운<color=#92fc63>(1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"……의뢰팀이 돌아왔다고 이글이 말하네요. 네, 지금은 이 아이가 저 대신 모두를 보고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/expedition.ogg"},"실망":{"voiceline":"……그만하세요, 지휘관님. 당신에게 보여지는 건 제게 있어서… 무척 중요한 일이니까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/feeling1.ogg"},"낯섦":{"voiceline":"……이글이 지휘관님을 아주 좋아하는 것 같네요. 역시 저보다는 지휘관님 쪽이 이 아이의 주인으로 잘 어울리는 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/feeling2.ogg"},"호감":{"voiceline":"……이 세상에는 저보다 가치 있는 관측 대상이 수없이 많을 텐데, 당신은 늘 시선을 제게 향하시죠. 그 마음… 이해해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/feeling3.ogg"},"기쁨":{"voiceline":"……지휘관님, 미소를 더 많이 보여주세요. 관측상으로는 아무런 의미가 없을지 몰라도, 그래도 저는…… 충만해지니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/feeling4.ogg"},"사랑":{"voiceline":"……지휘관님, 약속할게요. 더는 슬픈 이별 같은 건 오지 않을 거라고요. 늘 제가 당신 곁에 있을게요. 어떤 모습으로든……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/feeling5.ogg"},"터치3":{"voiceline":"……제 상태를 확인하시는 건가요? 걱정하지 마세요. 관측이 이어지는 한, 계속해서 존재할 테니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/headtouch.ogg"},"모항귀환":{"voiceline":"……정해진 시간에 귀환을 마치셨군요. 모두 제가 관측한 궤적 그대로 움직이고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/home.ogg"},"hp 경고":{"voiceline":"……관측을 계속해야 해, 마지막 순간까지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/hp_warning.ogg"},"로그인":{"voiceline":"……좋은 아침이에요, 지휘관님. 지금 당신을 바라보고 있어요… 아무런 문제 없답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/login.ogg"},"실패":{"voiceline":"……이것이 바로 패배.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/lose.ogg"},"우편":{"voiceline":"……우편에 아주 중요한 정보가 적혀 있어요. 꼭 확인하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/mail.ogg"},"임무":{"voiceline":"……새로운 임무가 왔어요. 지휘관님께는 무척 중요한 것들이겠지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/mission.ogg"},"임무완료":{"voiceline":"……임무 보상이 모두 도착했어요. 이것 말고 도와드릴 건 없나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/mission_complete.ogg"},"서약":{"voiceline":"……굳이 이런 것까지 안 해도, 우리 운명은 이미 깊이 이어져 있어요. 그래도 고백을 받은 이상, 저도 제대로 답해야겠죠. 앞으로 무슨 일이 일어나도, 저 자신을 잃더라도, 제 대답은 영원히… 변하지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/propose.ogg"},"스킬":{"voiceline":"……방해되는 자는 제거하겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/skill.ogg"},"터치1":{"voiceline":"……지휘관님, 계속 제 관측 범위 안에 있어 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/touch.ogg"},"터치2":{"voiceline":"……후우, 저… 알고 있어요…… 잘 알고 있어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/touch2.ogg"},"입수시":{"voiceline":"……처음 뵙겠습니다. 아니, 어쩌면 오랜만이겠네요. 지휘관님, 그대로 저를 바라봐 주세요. 이 고요한 시간을 조금 더 느끼고 싶어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/unlock.ogg"},"강화성공":{"voiceline":"……저를 더 바라봐 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"……이것이 바로 승리.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀