[{"클뜯 id":401110,"클뜯 함순이 id":40111,"함순이 이름":"Z11","한글 함순이 + 스킨 이름":"Z11","영문 함순이 + 스킨 이름":"Z11","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401110/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401110/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401110/shipyard.png","설명":"1934A형 구축함 - Z11","자기소개":{"voiceline":"메탈 블러드의 Z11 「베른트 폰 아르님」이에요… 지, 지휘는 날 집무실에 배치하도록 해! 게임 친구로도, 청소 담당으로도 쓸만하거든! 바, 밖에 나가는 게 싫어서 그러는 건 절대 아니야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/profile.ogg"},"메인1":{"voiceline":"지휘관님… 지휘관님…… 이제 집에 가도 되나요…? 죄송해요… 도와드리고 싶다고 한 건 저인데, 이젠 방에 돌아가서 틀어박히고 싶어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/main1.ogg"},"메인2":{"voiceline":"내 오늘 코디, 어때? 엄청 스페셜한 느낌이지? ……대, 대답에 왜 그렇게 시간이 오래 걸리는 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/main2.ogg"},"메인3":{"voiceline":"언젠가 매일매일 게임만 하면서 살 수 있는 날이 오면 좋을 텐데…… 지휘관님도 그렇게 생각하시죠? 그러면 둘이 같이 아침부터 밤까지 계속…… 으아! 죄송해요! 제가 또 망상을……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/main3.ogg"},"전투개시":{"voiceline":"어? 어……? 제가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/battle.ogg"},"상세확인":{"voiceline":"으아아… 햇빛이 강해서 녹을 것 같아… 끈적한 초콜릿이 되어버리면 지휘관님께 도움이 될 수 없겠죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/detail.ogg"},"드랍 설명":{"voiceline":"1934A형 구축함-Z11","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔다고요……? 아아… 계속 밖에 있으려면 힘들겠어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/expedition.ogg"},"실망":{"voiceline":"머, 먼저 실례할게요… 아하하하…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/feeling1.ogg"},"낯섦":{"voiceline":"하, 하, 하나도 긴장 안 했거든?! 봐! 이 천 번은 연습한 미소를 보라고…! 그, 그렇다고 너무 뚫어져라 보지는 말고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/feeling2.ogg"},"호감":{"voiceline":"이제야…… 이제야 지휘관님 곁에서도 편하게 심호흡할 수 있겠어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/feeling3.ogg"},"기쁨":{"voiceline":"만약 내가 갑자기 정신을 잃으면 넘어지지 않게 부축해 줬으면 해요… 물론 죽고 싶어질 정도로 창피하겠지만, 그래도 어차피 죽을 거면 지휘관님 품에서…… 아니, 그런 의미가 아니라…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/feeling4.ogg"},"사랑":{"voiceline":"이제 지휘관님이랑 같이 있어도 긴장이 안 되는 줄 알았는데, 왜 또 요즘은 두근거리고 숨도 가빠지고…… 왜? 어째서…? 지휘관님은 왜 그런지 아시겠어요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/feeling5.ogg"},"터치3":{"voiceline":"히이익!! 여, 열심히 일할게요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/headtouch.ogg"},"모항귀환":{"voiceline":"지, 지휘~ 어서 와~ ……저 제대로 일하는 중이에요. 조, 조금 시간은 더 걸릴 것 같지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/home.ogg"},"hp 경고":{"voiceline":"바, 방금 건 빈혈 증상……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이야, 지휘! 벌써 업무 시작하게~? 어, 어, 업무라든가 그…… 저, 마음의 준비는 이미 했어요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/login.ogg"},"실패":{"voiceline":"흑…… 이래서 밖에 나가기 싫다니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/lose.ogg"},"우편":{"voiceline":"우편을 정리했어요…… 나… 자, 잘했지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/mail.ogg"},"임무":{"voiceline":"지휘! 어서 임무를 처리하지 않으면~ ……뭐, 딱히 무슨 일이 일어나는 건 아니지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/mission.ogg"},"임무완료":{"voiceline":"이, 임무가 무사히 완료되었나요? 저… 지휘관님께 도움이 되었겠죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/mission_complete.ogg"},"서약":{"voiceline":"자, 장난이라는 것쯤은 저도 알아요…… 이런 전개… 이미 본 적 있다고요… 꿈에서도 일어나지 않을 일이 현실에서 일어날 리가… 저, 정말이라고요…?! 아아, 아아아…… 심장이 터지겠어… 너무 행복해서 죽을 것 같아……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/propose.ogg"},"스킬":{"voiceline":"날 괴롭히는 건 다 사라져버려…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/skill.ogg"},"터치1":{"voiceline":"꺄아악?! 왜, 왜, 왜, 왜 그러시죠…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/touch.ogg"},"터치2":{"voiceline":"이…… 이러다가는 나… 녹아버리겠어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/touch2.ogg"},"입수시":{"voiceline":"안녀엉~♪ 나는 메탈 블러드의 Z11 「베른트 폰 아르님」이야! 잘 부탁해, 지휘! ……아, 아하하하. 인사는 이렇게 씩씩하게 해야 좋은 인상을 줄 수 있겠죠?! …네? 너, 너무 단순하다고요…? 죄송합니다!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/unlock.ogg"},"강화성공":{"voiceline":"가, 강해졌나요? 정말로…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"하아… 하아… 나, 아직 살아있는 건가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"일은 힘들지만… 열심히 해볼게요…! 지휘관님을 위해서……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401110/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"