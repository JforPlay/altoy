[{"클뜯 id":9703040,"클뜯 함순이 id":970304,"함순이 이름":"위치타·META","한글 함순이 + 스킨 이름":"위치타·META","영문 함순이 + 스킨 이름":"Wichita META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703040/shipyard.png","설명":"지휘관인가? 좋아, 너라면 안심이군. 어서 전장에 데려가 줘. 절대 실망시키지는 않을 테니!","자기소개":{"voiceline":"「위치타」… 네가 아는 그 위치타라고 생각하면 된다! 내가 전장에 선다는 건 승리를 의미하지! 굳이 적 따위는 언급할 가치도 없다! 자, 지휘관. 어서 날 전장으로 데려가라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/profile.ogg"},"메인1":{"voiceline":"전투? 전투에 끝이란 없다. 그래, 승리의 그 너머에 이르기까지 한 발의 포탄으로 정리되지 않는 건 없다! 만약 있다고 해도, 한 발 더 날리면 그만이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/main1.ogg"},"메인2":{"voiceline":"일단 전장에 발을 들이면, 더는 되돌릴 수 없지. 지휘관, 무엇을 위해 싸우고 있는지 잊지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/main2.ogg"},"메인3":{"voiceline":"흉터는 곧 전사의 훈장이지. 지휘관, 아픔이 느껴지는 건 살아있다는 증거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/main3.ogg"},"전투개시":{"voiceline":"전속력으로 나를 따라와라! 파이어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/battle.ogg"},"상세확인":{"voiceline":"이 힘은 요행이 아니라 합당한 대가를 치르고 얻은 거다. 그러니 제대로 쓰지 않으면 손해겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/detail.ogg"},"드랍 설명":{"voiceline":"지휘관인가? 좋아, 너라면 안심이군. 어서 전장에 데려가 줘. 절대 실망시키지는 않을 테니!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었다고? 오, 쓸만한 걸 많이 가지고 왔군. 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/expedition.ogg"},"실망":{"voiceline":"너… 정말 이대로도 문제없을 것 같나…? 절대 아니지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/feeling1.ogg"},"낯섦":{"voiceline":"꿈? 모르겠군. 내게는 전투가 전부다. 그거 말고 다른 거? 생각하지 않기로 했다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/feeling2.ogg"},"호감":{"voiceline":"그러고 보니 이 채찍과는 꽤 오랜 시간을 함께했군. 만약 언젠가 내가 사라지면, 그때는 네가 이 채찍의 주인이 되어줘라. 좀 길기는 하지만, 지도를 가리키는 데는 문제가 없을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/feeling3.ogg"},"기쁨":{"voiceline":"뭘 망설이는 거지… 예전에는 아무렇지도 않았는데… 음? 지휘관? 아, 아니… 아무것도 아니다. 그저 죽음이 두려워지기 시작했다는 걸 깨달았을 뿐… 뭐? …자신을 더 소중히 여기라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/feeling4.ogg"},"사랑":{"voiceline":"너 때문에 삶에 대한 집착이 생겼다. 그래… 내가 일찍 떠나면 혼자 남겨질 널 생각하니, 도저히 견딜 수가 없어서 말이다. 그러니 앞으로는 조심하마. 너와 조금이라도, 더 오래 함께 있을 수 있도록 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/feeling5.ogg"},"터치3":{"voiceline":"이건 보너스인가? 좋아, 받아 주고 말고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/headtouch.ogg"},"모항귀환":{"voiceline":"정말이지, 최고로 호쾌한 전투였다. 지휘관, 지금은 푹 쉬어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/home.ogg"},"hp 경고":{"voiceline":"아직이다! 아직 쓰러지지 않았다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/hp_warning.ogg"},"로그인":{"voiceline":"돌아왔군. 이제 다음은 어디로 가서 누굴 처분하면 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/login.ogg"},"실패":{"voiceline":"먼저 물러가라. 나머지는 내 쪽에서 어떻게든 해볼 테니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/lose.ogg"},"우편":{"voiceline":"지휘관, 네 앞으로 온 우편이군. 어서 내용물을 확인하도록 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/mail.ogg"},"임무":{"voiceline":"새로운 임무에서 내 힘이 필요한 게 있다면 뭐든 말해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/mission.ogg"},"임무완료":{"voiceline":"임무 완료로군. 수고했다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/mission_complete.ogg"},"서약":{"voiceline":"지휘관과 부하의 관계가 아니라, 서로 사랑하는 관계로…? 이러면 마음껏 싸울 수가 없잖은가. 이런 교활한… 좋다, 해 주마. 너는 내가 닻을 내릴 장소이자, 돌아가야 할 항구다. 네가 살아 있는 한, 계속 곁에 있어 주마. 세상이 끝날 때까지 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/propose.ogg"},"스킬":{"voiceline":"타오르는 재가 되어 가라앉아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/skill.ogg"},"터치1":{"voiceline":"몸을 움직이고 싶다면 어울려 주마… 다만 그 책임은 네가 져야겠지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/touch.ogg"},"터치2":{"voiceline":"정말 너란 놈은 배짱이 두둑하군… 각오해라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/touch2.ogg"},"입수시":{"voiceline":"지휘관인가? 좋아, 너라면 안심이군. 어서 전장에 데려가 줘. 절대 실망시키지는 않을 테니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/unlock.ogg"},"강화성공":{"voiceline":"더… 더 많은 힘을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"이 정도로는 아직 부족해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex