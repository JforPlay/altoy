[{"클뜯 id":9705010,"클뜯 함순이 id":970501,"함순이 이름":"후소·META","한글 함순이 + 스킨 이름":"후소·META","영문 함순이 + 스킨 이름":"Fusou META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9705010/shipyard.png","설명":"전함·후소, 방황하는 영혼을 달래러 왔습니다... 지휘관님, 찾고 계신 것이 축복인가요, 아니면 구원인가요?","자기소개":{"voiceline":"전 과거의 좌절과 불행을 이미 깨끗이 잊었습니다. 저에게는, 방황하는 영혼들을 위로하고 올바른 곳으로 가게 하는 것이 지금 당장 할 일입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/profile.ogg"},"메인1":{"voiceline":"지휘관님, 고향이 그리우십니까? 지휘관님의 마음 속에, 걱정하는 사람이 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/main1.ogg"},"메인2":{"voiceline":"저희 각자의 업무를 마치기 전에는, 우선 서로 방해하지 말아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/main2.ogg"},"메인3":{"voiceline":"전 항상 신명님께 기도를 드릴 거예요. 저와 야마시로를 따르는 액운이 영원히 사라질 때까지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/main3.ogg"},"전투개시":{"voiceline":"이렇게 해야만 사악함을 정화시킬 수 있는 건가요…… 좋습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/battle.ogg"},"상세확인":{"voiceline":"분쟁이 생명을 데려갔군요... 신명님께서 당신들을 안식으로 이끄시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/detail.ogg"},"드랍 설명":{"voiceline":"후소호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"이렇게 많은 동료들이 지휘관님을 위해 노력하기를 바라니, 그들을 소중히 여겨야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/expedition.ogg"},"실망":{"voiceline":"일이 이렇게 되다니, 저도 이제 지휘관님을 위해서는 아무것도 할 수 없습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 무슨 용무가 있으십니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 절 걱정하고 계신가요? 관심 감사합니다. 전 매일 신명님께 축복과 보우를 기도 드릴 거예요——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/feeling3.ogg"},"기쁨":{"voiceline":"회개, 탄식... 너무 많은 생명이 너무 많은 생명이 만족을 얻지 못하고 안타깝게 떠나갔습니다. 지휘관님이 인생의 사진첩을 펴보았을 때, 웃으며 \"만족스럽다\"는 말을 할 수 있었으면 좋겠습니다...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/feeling4.ogg"},"사랑":{"voiceline":"과거에 저는 무엇 때문에 기도문을 읊고, 왜 방황하는 영혼을 이끌었는지를 잊고 신에게 기도만 드렸습니다. 지금은, 지휘관님, 그리고 모두의 미소 띈 얼굴에서 새로운 이유를 찾은 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 몸을 아끼지 않는다면 오래갈 수 없습니다. 자신의 몸을 소중히 여기세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/home.ogg"},"hp 경고":{"voiceline":"그렇게 많은 기도를 드렸는데... 아직 부족한가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 여기서 오래 기다렸답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/login.ogg"},"실패":{"voiceline":"풀지 못 할 저주… 좋습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/lose.ogg"},"우편":{"voiceline":"새로운 우편이 있습니다. 지휘관님, 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/mail.ogg"},"임무":{"voiceline":"임무…… 사소한 일이긴 하지만, 그래도 순조롭게 해내시길 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/mission.ogg"},"임무완료":{"voiceline":"임무를 손조롭게 완료했어요. 보아하니, 저희의 기도가 신명님이 계신 곳까지 전해진 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/mission_complete.ogg"},"서약":{"voiceline":"이게 지휘관님의 강렬한 소원이라면... 좋습니다. 승낙할게요. 이렇게 하는 것이 결국 화가 될지 복이 될지는 모르겠지만... 지휘관님을 위해 언제나 기도하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/propose.ogg"},"스킬":{"voiceline":"편히 쉬세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/skill.ogg"},"터치1":{"voiceline":"지휘관님을 위해 기도할게요. 신명님께서도 들어주시길 바래요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/touch.ogg"},"터치2":{"voiceline":"지휘관님? 혹시 이상한 것에 빙의되신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/touch2.ogg"},"입수시":{"voiceline":"전함·후소, 방황하는 영혼을 달래러 왔습니다... 지휘관님, 찾고 계신 것이 축복인가요, 아니면 구원인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/unlock.ogg"},"강화성공":{"voiceline":"아직 수많은 재앙에 시달리는 영혼들이 신명님의 구원을 기다리고 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"소란한 바다에서 벗어나 다시 깨어나지 않을 좋은 꿈을 꾸길…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9705010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메