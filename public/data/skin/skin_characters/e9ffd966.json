[{"클뜯 id":317020,"클뜯 함순이 id":31702,"함순이 이름":"이404","한글 함순이 + 스킨 이름":"이404","영문 함순이 + 스킨 이름":"I-404","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317020/shipyard.png","설명":"이400형 대형 잠수 항공모함 - 이404","자기소개":{"voiceline":"나는 이404, 사쿠라 엠파이어 소속 대형 잠수 항공모함이자, 세계에서 가장 크고 화려한 잠수함. 그리고 수룡과 함께 춤추는 군함이야! 미완성된 함선이기에 「최강」이지. 우후후, 이의 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/profile.ogg"},"메인1":{"voiceline":"오늘 구름… 해저의 모래 무늬랑 닮았네…… 아하, 알겠다. 바다가 날 부르고 있는 거야! 자, 일 끝나면 바로 잠항하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/main1.ogg"},"메인2":{"voiceline":"쿵… 쿵쿵…… 이 소리…… 근처에 신악무(神楽舞)를 연습하는 사람이라도 있는 건가? 지휘관! 우리도 가보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/main2.ogg"},"메인3":{"voiceline":"…푸핫! 역시 잠항이 최고야! …한참이나 날 찾고 있었다고? 음… 아하하… 미안~ 시간이 가는 줄 몰랐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/main3.ogg"},"전투개시":{"voiceline":"내가 리드하라고? 그럼, 화려하게 보여주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/battle.ogg"},"상세확인":{"voiceline":"자, 정식으로 소개할게. 여긴 내 수룡 의장인 코타마야. 화려하게 승리를 거둘 수 있는 건 이 아이 덕이기도 해. …뭐? 화려한 춤은 당연히 내 실력이고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/detail.ogg"},"드랍 설명":{"voiceline":"이400형 대형 잠수 항공모함 - 이404","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 애들이 돌아왔어. 수확이 꽤 화려한 것 같은데… 응? 감응 능력이 엄청나다고? 에이, 아니야. 잠수하다가 우연히 본 거야. 내 실력은 겨우 이런 게 아니라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/expedition.ogg"},"실망":{"voiceline":"몰래 이동해서 몰래 잠수…… 안 들킬 거야, 안 들켜……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/feeling1.ogg"},"낯섦":{"voiceline":"자… 잠깐! 지금 손에 들고 있는 거…… 최고급 성게 아니야?! 후후후, 역시 지휘관을 따라오길 잘했어! 최고야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/feeling2.ogg"},"호감":{"voiceline":"지휘관이랑 잠수하면 정말 재밌어. …그나저나 방금 바닷속에서 눈치챈 건데, 정어리 떼가 나타났을 때, 몰래 날 보고 있었지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/feeling3.ogg"},"기쁨":{"voiceline":"사쿠라 엠파이어의 기예는 「간격」이 중요해. 손끝을 멈추는 찰나의 모습에도, 호흡을 가다듬는 순간에도 수천 가지의 뜻과 마음이 담겨있지. 내 춤에 대해 더 알고 싶으면, 우선 내 스텝부터 따라와 봐! 자, 지휘관! 같이 춤추자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/feeling4.ogg"},"사랑":{"voiceline":"음…… 내 생각에는 말이지, 「좋아한다」는 감정이야말로 가장 화려한 기적 아닐까? 깊은 바다에서 아름다운 산호를 찾아냈을 때, 고개를 돌리니 네가 있었던 그 순간… 그 때 느낀 두근거림… 같은 거 말이야. ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/feeling5.ogg"},"터치3":{"voiceline":"으읏?! 음…… 성게 요리 먹는 중에는 갑자기 건드리지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/headtouch.ogg"},"모항귀환":{"voiceline":"꽤 화려한 전투던데? …그걸 어떻게 아느냐고? 그야 물론… 바닷속 1등석에서 전부 지켜봐서 그런 거지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/home.ogg"},"hp 경고":{"voiceline":"피로 물든 전투야말로 가장 화려하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/hp_warning.ogg"},"로그인":{"voiceline":"흠~ 벌써 일하려고? 바다가 이렇게 유리처럼 맑고 아름답고, 바닷바람도 잔잔한데…… 있잖아, 일정에 있는 「정례」를 「잠항」으로 바꾸는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/login.ogg"},"실패":{"voiceline":"이런 식으로 바다에 가라 앉고 싶었던 건 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/lose.ogg"},"우편":{"voiceline":"우편이 도착했어. 이대로 방치하면 내가 이 우편인지 뭔지를 아주 화려하게 장악해버릴 줄 알아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/mail.ogg"},"임무":{"voiceline":"임무가 아직 남아있나 봐? 흐음, 난 잠항하러 다녀올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/mission.ogg"},"임무완료":{"voiceline":"날 찾았다고? 후훗, 수중에 있는 비밀 루트로 먼저 와 있었지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/mission_complete.ogg"},"서약":{"voiceline":"……후훗, 아직도 모르겠어? 이런 반지가 없어도 이미 넌 내 것이야. 그래도 마침 좋은 기회가 왔으니까, 확실히 알아둬. 네 몸 전부에는 나란 존재가 확실히 새겨져 있다는 걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/propose.ogg"},"스킬":{"voiceline":"그 몸, 끝없는 심연까지 꿰뚫리리라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/skill.ogg"},"터치1":{"voiceline":"잠수할까, 춤출까…? 둘 다 하지 뭐! 뭐, 뭘 고르든 당장 움직여야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/touch.ogg"},"터치2":{"voiceline":"……우후후, 무슨 생각 하는지 뻔히 다 보여. 그래, 날 정복하고 싶으면, 자기 손으로 직접 해야할걸♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/touch2.ogg"},"입수시":{"voiceline":"사쿠라 엠파이어 소속 잠수함인 이404야. 네 부름에 응해 이렇게 먼바다에서 만나러 와준 거야. 흥, 환호하도록 해! 화려하게 파도를 헤치는 위용을 마음껏 감상하게 해줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/unlock.ogg"},"강화성공":{"voiceline":"어머…… 여기서 더 강하고 화려해질 수 있다니…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"화려하게 적을 멸했어. 코타마도 즐거웠던 모양이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"출렁이는 수중의 무대야말로 내 화려한 길에 가장 어울리지. 그래, 내친 김에 물회오리를 어떻게 만드는지도 보여줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"내 보물, 가장 화려한 소유물…… 지금 이 순간은 우리 둘만의 시간이야. 자, 한 곡 춤춰 보자!복잡한 스텝 같은 건 필요 없어…… 이대로 서로의 심장 소리에 따라 멋지고도 화려한 리듬을 느끼는 거야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"음…… 오늘 성게도 신선해서 맛있어! 너한테도 먹여줄 테니까, 자, 아~ 해 봐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"오늘도 전투에서 화려하게 이겼어. …그러니까 지금부터는 시간을 나랑 이 바다에 맡겨두도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"왔네~ 자, 오늘은 어디서부터 나한테 공략 당하고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"뭐? 이제 막 잠수하고 왔는데, 또 가고 싶다고? ……좋아, 얼마든지 같이 가줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/touch_ex.ogg"},"터치2_ex":{"voiceline":"너한테 몇 번이나 「창피한 꼴」을 당했는데, 그걸 다 참아버리다니…… 후후후, 이거 좀 위험한 거 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['시만토'] : 용신님, 함께 춤추자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/couple_encourage1.ogg"}],"메인4":{"voiceline":"바닷속에서 본 가장 화려한 곳이라면…… 흥, 비밀이야. 궁금하면 나랑 바다를 위한 시간을 따로 마련하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"어머, 물고기들이 이렇게 많이 네 곁을 맴돌고 있네. 뭐, 네가 내 거라서 이렇게 열정적으로 다가가는 거겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/main5_ex.ogg"},"메인6_ex":{"voiceline":"새로 만든 춤이야, 한 번 감상해 봐♪ 어때? 너무 화려해서 말도 안 나오지? ……그렇게 가만히 있지만 말고 뭐라고 말 좀 해. 봐, 코타마도 마음에 든다잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/main6_ex.ogg"},"메인7_ex":{"voiceline":"왜 그렇게 찡그린 얼굴이야? 무슨 일 있어? 일 때문에? 아니면 배고파서 그래? 성게 요리라도 사줄까? 엄청 비싸고 화려한 걸로 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/main7_ex.ogg"},"메인8_ex":{"voiceline":"후훗, 다음 춤은…… 오직 너 하나만을 위한 거야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317020/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"UR","ex_chat_status":1},{"클뜯 id":317021,"클뜯 함순이 id":31702,"함순이 이름":"이404","한글 함순이 + 스킨 이름":"화려한 붉은 실의 춤사위","영문 함순이 + 스킨 이름":"Dance of Crimson Strings","스킨 타입":"Ninja Castle","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317021/shipyard.png","설명":"지휘관! 어서 도와줘…… 화려하게 이 저택을 정복할 생각이었는데, 함정에 빠지다니… 정말 최악이야…!","자기소개":null,"메인1":{"voiceline":"이 구속 장치… 정말 거슬려…! 혀를 안 깨물려고 낀 거긴 한데, 말도 제대로 못 하겠잖아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/main1.ogg"},"메인2":{"voiceline":"끈을 다루는 건 파도를 다루는 것보다 훨씬 쉬워♪ 봐, 이렇게 하면… 자유자재로 움직일 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/main2.ogg"},"메인3":{"voiceline":"이런 위험한 장치가 저택 안에 있다니, 아무리 봐도 수상해…… 그나저나 지휘관. 내가 이렇게까지 화려하게 매달려 있는데, 슬슬 보상으로 성게라도 먹여줘야 하는 거 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관이랑 같은 팀을 맺으면, 분명 화려하게 돌파할 수 있을 거야! 놀라서 소리를 지르지 않으려고 이것도 챙겨왔…… 잠깐?! 함정이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/detail.ogg"},"드랍 설명":{"voiceline":"지휘관! 어서 도와줘…… 화려하게 이 저택을 정복할 생각이었는데, 함정에 빠지다니… 정말 최악이야…!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지금 내가 그냥 당하는 입장… 같아 보이지? 이런 상황에서도 내 심장은 이렇게 외치고 있어. 지금, 여기서, 널 내 것으로 만들어 주겠다고…… 유령의 집 정복? 흥, 그런 건 이제 뒷전이야♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/feeling5.ogg"},"터치3":{"voiceline":"기분 좋아…… 츄릅…… 아, 아니야! 이건……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/headtouch.ogg"},"모항귀환":{"voiceline":"자, 지휘관. 유령의 집 공략, 계속할 거야? …좋았어♪ 그럼 어서 날 여기서 내려줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"꽤 재밌는 끈이네. 이렇게 격하게 움직여도 아무렇지…… 앗?! 하마터면 얼굴이 바닥에 닿을 뻔했잖아…! 잠깐, 너! 갑자기 끈을 잡아 당기면 어떻게 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 내 화려한 끈의 춤… 잘 지켜봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/touch.ogg"},"터치2":{"voiceline":"유령의 집보다 날 먼저 공략하겠다고……? 잠깐! 농담하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317021/touch2.ogg"},"입수시":{"voicel