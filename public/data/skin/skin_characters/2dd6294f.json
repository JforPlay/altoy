[{"클뜯 id":205050,"클뜯 함순이 id":20505,"함순이 이름":"킹 조지 5세","한글 함순이 + 스킨 이름":"킹 조지 5세","영문 함순이 + 스킨 이름":"King George V","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205050/shipyard.png","설명":"킹 조지 V급 전함 - 킹 조지 5세(HMS King George V) ","자기소개":{"voiceline":"내가 바로 킹 조지 5세급의 네임쉽 전함이다. 본토 함대의 기함을 담당하고 있으며, 수많은 작전에 참가하여 그 유명한 비스마르크와의 대전도 치루었지. 하지만, 그 때는 충분히 싸워보지 못했으니 혹시 가능하다면 한번 더 그녀와 겨뤄보고 싶은데……더 알고 싶은 게 있다면 말해보도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/profile.ogg"},"메인1":{"voiceline":"지휘관, 당신이 있어야 이 함대도 존재한다. 방심하지 말도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/main1.ogg"},"메인2":{"voiceline":"웨일즈와 그 일행인가. 사실은 내 품으로 달려와 '언니' '언니' 라고 불러줬으면 좋겠는데…내 그런 모습도 괜찮지 않겠는가,","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/main2.ogg"},"메인3":{"voiceline":"나에게 있어 폐하 이상으로 모시는 보람이 있는 분은 존재하지 않는다. 지휘관, 무슨 말인지 알겠는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/main3.ogg"},"전투개시":{"voiceline":"우리의 위명을 여기에도 떨쳐 보이도록 할까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/battle.ogg"},"상세확인":{"voiceline":"로열에서의 나의 위치가 신경쓰인다고? 흠……그렇군, 예를 들자면 \"기사단장\" 이라고 하는 것이 제일 적절하겠군. 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/detail.ogg"},"드랍 설명":{"voiceline":"킹 조지 V급 전함 - 킹 조지 5세(HMS King George V)","voicelink":null},"의뢰 완료":{"voiceline":"부두에 움직임이……? 아아, 의뢰팀이 돌아와 준 모양이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/expedition.ogg"},"실망":{"voiceline":"심지가 있거나, 요리를 준비해주는 아이를 선호하는데 말이지. 지휘관, 당신은 어느 쪽도 아닌 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/feeling1.ogg"},"낯섦":{"voiceline":"그러고보니 지휘관, 요리는 할 줄 아는가? 흠, 이래뵈도 나는 내 위장을 만족시키기 위해 노력하고 있거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/feeling2.ogg"},"호감":{"voiceline":"후후, 지휘관, 어떤가? 이 몸의 요리실력에 감탄했나? 자아, 마음껏 먹도록 해. 그대가 먹는 모습을 보면 나도 기쁘거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 당신도 요리 연습을 시작한 건가? 흐음, 그것 참 반가운 일이야……나를 위해서 만들어 준 요리를 먹는 게 기대되는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/feeling4.ogg"},"사랑":{"voiceline":"식사와 전투는 내가 가장 즐기는 두 가지 일……뭐어, 전투는 혼자서도 할 수 있지만, 저녁 식사를 혼자 즐기는 건 쓸쓸하고 힘든 일이야. 같이 즐겨주는 당신과 만날 수 있었던 건 정말 기쁜 일이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 전투는 즐거웠는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/home.ogg"},"hp 경고":{"voiceline":"훗, 재미있군…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 저녁 식사는 마쳤는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/login.ogg"},"실패":{"voiceline":"그렇게 침울해지지 마라. 승패라는 것은 한 번의 전투로 정해지는 것이 아니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/lose.ogg"},"우편":{"voiceline":"편지……흐음, 도전장인가, 아니면 러브레터인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/mail.ogg"},"임무":{"voiceline":"임무 말인가. 좀 더 도전하는 보람이 있으면 좋겠는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/mission.ogg"},"임무완료":{"voiceline":"임무를 수행한 후의 저녁 식사가 제일 맛있지. 그렇게 생각하지 않나? 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/mission_complete.ogg"},"서약":{"voiceline":"\"마음을 사로잡기 전에, 먼저 위장을 사로잡아라\" 라는 말도 있지만, 이건 위장을 넘어서서 단번에 내 마음까지 사로잡았군. 지휘관, 앞으로도 계속 요리를 만들어 주지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/propose.ogg"},"스킬":{"voiceline":"지지 않는 태양의 위세는 결코 빛이 바래지 않나니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/skill.ogg"},"터치1":{"voiceline":"이 과자의 산은 뭐냐고? 배부르게 먹지 않으면 전투에 만전을 기할 수 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/touch.ogg"},"터치2":{"voiceline":"호오? 지휘관이 이렇게까지 대담한 사람이라고는 미처 생각하지 못했군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/touch2.ogg"},"입수시":{"voiceline":"여기가 새로운 전장인가. 후후, 좀이 쑤시는군…… 그렇다면, 당신이 내 지휘관인가. 내 이름은 킹 조지 5세다. 잘 활용해보도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/unlock.ogg"},"강화성공":{"voiceline":"음……갑자기 폭식을 하고 싶어지는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"결코 방심은 하지 않는다. 승리도, 제군들의 안전도 전부 확보하겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['프린스 오브 웨일즈'] : 웨일즈, 갑자기 사라지지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/couple_encourage1.ogg"},{"voiceline":"['듀크 오브 요크'] : 함께 적진을 갈라놓도록 할까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/couple_encourage2.ogg"}],"메인4":{"voiceline":"로열의 요리는 괴식 뿐이라고? 흐음, 나무만 보고 숲을 보지 못한다니 탐탁치 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205050/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":205051,"클뜯 함순이 id":20505,"함순이 이름":"킹 조지 5세","한글 함순이 + 스킨 이름":"온순한 장미","영문 함순이 + 스킨 이름":"Rose's Regalia","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205051/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205051/shipyard.png","설명":"지휘관, 기다리게 했군. 드레스를 입는 건 자주 있는 일이 아니다보니 조금 시간이 걸렸지만…… 음, 출발하도록 할까. 오늘의 주인공은 당신이다. 아하하하. ","자기소개":null,"메인1":{"voiceline":".....음, 드레스를 입으면 이미지를 유지해야 하니까 마음대로 음식을 맛 볼 수 없다니, 까다롭군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/main1.ogg"},"메인2":{"voiceline":"지난날의 노고는 바로 이렇게 활기찬 밤을 위해서였다, 지휘관, 맘껏 즐겨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/main2.ogg"},"메인3":{"voiceline":"엇? 요크와 웨일즈가 또 말다툼 중이라고......? 흐흠, 지휘관, 실례할게. 모처럼의 파티인데, 우리 자매도 단결해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/main3.ogg"},"전투개시":{"voiceline":"너희들은 아무래도 눈치가 너무 없구나!","voicelink":null},"상세확인":{"voiceline":"음...? 옷이 너무 타이트한 것 같군. 지휘관, 등 뒤에 지퍼 좀 느슨하게 해줄 수 있겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 기다리게 했군. 드레스를 입는 건 자주 있는 일이 아니다보니 조금 시간이 걸렸지만…… 음, 출발하도록 할까. 오늘의 주인공은 당신이다. 아하하하.","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 이 의뢰가 끝나면 잠시 쉬어. 모든 사람이 파티를 즐길 자격이 있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"내가 아무리 빛을 발해도 모든 영광은 그대에게 돌아간다. 이것은 당신이 나의 지휘관이기 때문이 아니라, 바로 당신은 당신이기 때문이다. 그러니, 가슴을 펴라, 나의 사랑. 넌 날 가질만 하고, 눈앞의 모든 것을 가질만 해.","voicelink":null},"터치3":null,"모항귀환":{"voiceline":"지휘관, 파티에 서둘러 가지 않으면 음식들이 다 식겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"내 손을 잡아줘, 지휘관. 난 아직 이런 드레스를 입고 걷는 것이 그리 익숙하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/login.ogg"},"실패":null,"우편":{"voiceline":"무도회 요청? 후훗, 지휘관, 나도 같이 가지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/mail.ogg"},"임무":{"voiceline":"파티 중 임무라...... 정말 어처구니없군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/mission.ogg"},"임무완료":{"voiceline":"이 보상들로 파티를 장식하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"폐하 쪽은...... 벨파스트와 후드가 있으니 문제 없을 거야, 지휘관, 우리 마음껏 파티를 즐기자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205051/touch.ogg"},"터치2":null,"입수시":{"voiceline":"지휘관, 기다리게 했군. 드레스를 입는 건 자주 있는 일이 아니다보니 조금 시간이 걸렸지만…… 음, 출발하도록 할까. 오늘의 주인공은 당신이다. 아하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/