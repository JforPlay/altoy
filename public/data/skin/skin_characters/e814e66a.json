[{"클뜯 id":401210,"클뜯 함순이 id":40121,"함순이 이름":"Z21","한글 함순이 + 스킨 이름":"Z21","영문 함순이 + 스킨 이름":"Wilhelm Heidkamp (Z21)","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401210/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401210/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401210/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401210/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401210/shipyard.png","설명":"1939년형 구축함 - Z21 빌헬름 하이드캄프","자기소개":{"voiceline":"메탈 블러드 해군 Z클래스 구축함 1936년형, 빌헬름 하이드캄프야. 베저위붕 작전의 나르비크 작전의 기함으로 참가, 하디에게 격침당했지만……다음엔 절대로 지지 않을 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/profile.ogg"},"메인1":{"voiceline":"나를 기함으로 한 이상, 각오해두라고! ……따, 딱히 걱정 같은 건 안 했으니까 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/main1.ogg"},"메인2":{"voiceline":"딱히 당신을 좋아하는 게 아니야! 비서함이니까 별수 없이 어울려주는 것뿐! 착각하지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/main2.ogg"},"메인3":{"voiceline":"피곤하면…따, 딱히 무릎 베게 해줘도 좋은데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/main3.ogg"},"전투개시":{"voiceline":"모두, 힘내자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/battle.ogg"},"상세확인":{"voiceline":"내 얼굴에 뭔가 묻었어? 뚫어지게 보지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/detail.ogg"},"드랍 설명":{"voiceline":"1939년형 구축함 - Z21 빌헬름 하이드캄프","voicelink":null},"의뢰 완료":{"voiceline":"모두 수고했어~! 계속 모항에 틀어박혀 있는 누군가는 딱히 수고한 것도 없지만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/expedition.ogg"},"실망":{"voiceline":"지금 기분이 굉장히 안 좋으니까, 가까이 오지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/feeling1.ogg"},"낯섦":{"voiceline":"난 모두를 지키기 위해 싸우고 있어! …다, 당신은 안 지켜줄 테니까 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/feeling2.ogg"},"호감":{"voiceline":"좋아하는 거? 왜 알려줘야 하지? …그, 그러고 보니 어제 먹은 마카롱은 꽤 괜찮았어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/feeling3.ogg"},"기쁨":{"voiceline":"딱히 뒤에 붙어있는 게 아니까 말야! 우연히 가는 길이 같았던 거라고! 어디 가냐고? ……그, 그걸 왜 당신한테 알려줘야 하는데?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 뭐 나한테 해야 할 말 없어? 에……없어? 정말이지…바보바보바보~!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수……수고했어……흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 와 지휘관! ……에? 따, 딱히 걱정한 건 아니니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/login.ogg"},"실패":{"voiceline":"큭……기, 기억해두라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/lose.ogg"},"우편":{"voiceline":"당신에게 온 우편……내가 열어 보라고?! 그, 그럼… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/mail.ogg"},"임무":{"voiceline":"아직 일하러 안 간 거야? ……나와 있는 편이 좋다고? 이, 일부러 그런 말 하는 거지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/mission.ogg"},"임무완료":{"voiceline":"조, 조금은 칭찬해주지! 업무! 업무를 잘해준 상이니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/mission_complete.ogg"},"서약":{"voiceline":"굳이 나에게 준다고 하면, 나……감사히 받아주도록 하지! 그, 그치만 딱히 승낙한 건 아니…아아아! 알았어! 스, 승낙해 줄 테니까아~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/propose.ogg"},"스킬":{"voiceline":"전투 같은 거, 좀 대충해도 되잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/skill.ogg"},"터치1":{"voiceline":"만지기 전에 말하라고 했잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/touch.ogg"},"터치2":{"voiceline":"꺄악! 뭐, 뭐하는 거야?! 다음에 또 이러면 진짜 화낼 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/touch2.ogg"},"입수시":{"voiceline":"나는 나르비크 해전의 Z클래스 구축함의 기함을 맡은 빌헬름 하이드캄프야! 지, 지금까지 고생했으니까, 당신을 따라가기로 했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/unlock.ogg"},"강화성공":{"voiceline":"고맙……단 말 따위 아, 안 했다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/upgrade.ogg"},"vote":null,"승리":{"voiceline":"뭐, 당신 덕이기도 하니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401210/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"N","ex_chat_status":0}]