니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701102/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"키예프랑 같이 스케이트 타볼래? …지휘관은 피곤할 테니까 우선은 푹 쉬어. 응… 그러는 편이 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701102/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관이 연습하는 동안 서류를 정리해 뒀어. 지휘관이 업무할 필요가 없어지면, 그만큼 키예프가 지휘관을 독점할 수 있어… 그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701102/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"…아직 무서워? 자, 키예프 손 잡아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701102/touch.ogg"},"터치2":{"voiceline":"위험해! …휴우, 지휘관… 조심해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701102/touch2.ogg"},"입수시":{"voiceline":"초보자인 지휘관을 위해 내가 시범을 보여줄게. …왠지 지휘관이 옆에 있으니까 평소보다 잘 되는 것 같아. 키예프, 잘 하고 있어? 괜찮…은 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701102/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"적을 모두 물리쳤어. 지휘관 말대로 싸우는 키예프… 응, 이러면 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701102/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"댄스","상점 id":0,"상점 카테고리 id":21,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":0}]