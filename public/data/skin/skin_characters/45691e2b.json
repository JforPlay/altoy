[{"클뜯 id":701100,"클뜯 함순이 id":70110,"함순이 이름":"키예프","한글 함순이 + 스킨 이름":"키예프","영문 함순이 + 스킨 이름":"Kiev","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701100/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701100/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/701100/shipyard.png","설명":"48형 구축함—키예프","자기소개":{"voiceline":"계획에 있던 프로젝트48형 구축함, 키예프야. 그 대전에서는 여러가지 사정이 있어서 태어나지 못했어……. 키예프의 첫 지휘관 동지, 만나서 다행이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/profile.ogg"},"메인1":{"voiceline":"하아, 하아… 이렇게……. 지휘관 동지? 걱정 마. 키예프, 창문에 글자를 쓰고 싶어서…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/main1.ogg"},"메인2":{"voiceline":"지휘관 동지를 다치게 하는 적은 용서 못 해. 지휘관 동지를 지원하고 지휘관 동지를 지키는 일도 마찬가지구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/main2.ogg"},"메인3":{"voiceline":"키예프, 꽃이나 식물을 키우는 건 자신 없지만, 선인장이라면 괜찮아……. 내, 내버려두어도 잘 사니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/main3.ogg"},"전투개시":{"voiceline":"아무리 차가운 얼음이라도 깰 수 있어……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/battle.ogg"},"상세확인":{"voiceline":"지휘관 동지, 한가해? 그럼… 키예프랑 이야기… 하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/detail.ogg"},"드랍 설명":{"voiceline":"48형 구축함—키예프","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아왔어. …왁자지껄 즐거워보여서, 키예프… 부러워…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/expedition.ogg"},"실망":{"voiceline":"키예프가 지휘관 동지를 슬프게 한 거야? 키예프가 사라지면 지휘관 동지, 괜찮아져?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/feeling1.ogg"},"낯섦":{"voiceline":"지휘관 동지, 키예프가 차가워? 다가가기 힘들어? 그래 보여? 어떻게 해야 그렇게 안 보일지, 잘 모르겠어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/feeling2.ogg"},"호감":{"voiceline":"키예프와 대화하는 동료, 늘었어……. 지휘관 동지가 그렇게 해줬다고? 그렇구나… 키예프랑 이야기해 보라고……. 고마워. 이렇게 말하면 되는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/feeling3.ogg"},"기쁨":{"voiceline":"키예프, 지휘관 동지 덕분에 친구가 많이 생겼어. 그래도… 지휘관 동지가 첫 번째고, 가장 특별해. 키예프, 지휘관 동지랑 더 같이 있고 싶어. 그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/feeling4.ogg"},"사랑":{"voiceline":"지휘관 동지가 곁에 없을 때, 지휘관 동지를 만날 수 없을 때, 여기가… 괴롭고 아프고 허전해서……. 키예프, 지휘관 동지 곁에 계속 있고 싶어. …그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/feeling5.ogg"},"터치3":{"voiceline":"쓰담쓰담, 기분 좋아……. 더 쓰다듬어줘. …그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관 동지! …아 …그게, 무사한 건 알지만 조금이라도 더 빨리 만나고 싶어서… 그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/home.ogg"},"hp 경고":{"voiceline":"지휘관 동지를 위해서라면……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 동지, 그게, 저기… 다음에도 이렇게 집무실 앞에서 지휘관 동지가 오길 기다려도, 될까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/login.ogg"},"실패":{"voiceline":"동료를 내버려두고 도망칠 수는… 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/lose.ogg"},"우편":{"voiceline":"지휘관 동지, 우편이야. 중요한 우편인 것 같으니까… 넘겨줘도 괜찮겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/mail.ogg"},"임무":{"voiceline":"임무, 어려워 보여……. 지휘관 동지 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/mission.ogg"},"임무완료":{"voiceline":"임무 보상을 받는 건 키예프가… 그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/mission_complete.ogg"},"서약":{"voiceline":"좋아하는 사람이랑 서약을 맺게 됐어. 그게 너무 기쁘고, 행복하고, 따뜻해서… 눈처럼 녹아 흘러 내려서, 질척질척해져서……. 지휘관 동지, 키예프, 이대로 계속… 그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/propose.ogg"},"스킬":{"voiceline":"제멋대로 굴게 내버려둘 수 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/skill.ogg"},"터치1":{"voiceline":"키예프, 조금 더 가까이 가고 싶어. ……그래도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/touch.ogg"},"터치2":{"voiceline":"가슴이, 열이 나는 것 같아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/touch2.ogg"},"입수시":{"voiceline":"노스 유니온, 프로젝트 48형 구축함 키예프야. 오늘부터 지휘관 동지의 여러 업무를 지원할 예정이야……. 바, 방금 건 공식적인 인사야……. 이 정도면 됐지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/unlock.ogg"},"강화성공":{"voiceline":"화력 강화, 장비 개수, 잊으면 안 돼. …그렇지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"적은 모두 쓰러트렸어. 지휘관 동지… 이제 된 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/win_mvp.ogg"},"전투개시_ex":{"voiceline":"전투라… 이렇게 하면, 됐겠지!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관 동지, 한가해? 키예프도… 얘기나 나눌 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰 나갔던 동료들이 돌아왔어. 그녀들이 항행할 때 재미있었던 일을 들었는데…… 지휘관 동지, 듣고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/expedition_ex.ogg"},"사랑_ex":{"voiceline":"키예프는 지휘관 동지 마음 속의 첫 번째이자, 지휘관 동지 주변 모든 사람 중에 첫 번째인 그 유일한 사람이 되고 싶어…… 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관 동지, 키예프의 곁으로 돌아왔구나… 후, 키예프도 같아. 이렇게 있는 게 좋아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관 동지가 얼마나 늦던 키예프는 여기서 지휘관 동지를 기다릴 거야. 그래도… 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/login_ex.ogg"},"실패_ex":{"voiceline":"지휘관 동지, 키예프의 곁을 절대 벗어나지 마. 키예프가 보호해 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/lose_ex.ogg"},"우편_ex":null,"임무_ex":{"voiceline":"임무는…… 지휘관 동지와 함께라면 어려울 거 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 보상…… 지휘관 동지가 받으러 갈 거야? 그럼 키예프도 같이 갈래. 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"（//////）","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['타슈켄트'] : 지휘관 동지를 위해 싸워줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"키예프는 선인장을 좋아하지만, 선인장이 되고 싶지는 않아… 가만히 내버려둬도 잘 자랄 수 있다면, 정말로 내버려지는 거 아니야…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/701100/main