null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"와!? 가, 갑자기 들어올리면 어쩌잔 거야!? 망토를 밟은 뻔했다고…? 고, 고고, 고마워……(작은 목소리)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201011/touch.ogg"},"터치2":{"voiceline":"지휘관, 조금만 참아줘~ 오늘은 기분이 좋으니까, 그렇게까지 아프게는 하지 않을게~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201011/touch2.ogg"},"입수시":{"voiceline":"파티에는 오케스트라가 빠질 수 없지! 자~ 봐봐, 로열 네이비 구축함들로 편성된, 이 몸이 리더를 맡고 있는 교향악단이 흥을 책임져주지! 그럼 처음은… 아아아앗! 망토를 밟아버렸어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201011/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"다들, 좀 더 힘내자! 파티가 우리들을 기다리고 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201011/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70102,"상점 카테고리 id":7,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"HMS","레어도":"R","ex_chat_status":0},{"클뜯 id":201019,"클뜯 함순이 id":20101,"함순이 이름":"아마존","한글 함순이 + 스킨 이름":"아마존·改","영문 함순이 + 스킨 이름":"Amazon (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201019/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201019/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201019/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201019/qicon.png","깔끔한 일러":"https://raw.git