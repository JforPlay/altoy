[{"클뜯 id":201010,"클뜯 함순이 id":20101,"함순이 이름":"아마존","한글 함순이 + 스킨 이름":"아마존","영문 함순이 + 스킨 이름":"Amazon","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201010/shipyard.png","설명":"A급 실험 구축함·아마존 (D39)","자기소개":{"voiceline":"알겠어? 함대의 향도는 중요한 일이야. 그리고 이 내가 이 영광스러운 사명을 담당하는 고참이지! ……꼬맹이 같다고!? 잘도 그런 소릴… 운동장 돌기 열 바퀴다아앗!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/profile.ogg"},"메인1":{"voiceline":"언제나 도움이 될 수 있는 건 아니지만, 막상 때가 되면 그럭저럭하는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/main1.ogg"},"메인2":{"voiceline":"바보 같은 동생들… 언제쯤 되어야 마음을 놓을 수 있을까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/main2.ogg"},"메인3":{"voiceline":"뭔가 모르는 게 있는 거야? 가르쳐줄 테니까, 고맙게 생각하라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/main3.ogg"},"전투개시":{"voiceline":"흥! 어쩔 수 없지, 내가 직접 본보기를 보여주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/battle.ogg"},"상세확인":{"voiceline":"뭐, 오늘은 기분도 좋으니까… 제대로 배려해줄까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/detail.ogg"},"드랍 설명":{"voiceline":"A급 실험 구축함·아마존 (D39)","voicelink":null},"의뢰 완료":{"voiceline":"슬슬 의뢰의 시간을 스스로 기억하는 게 어때!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/expedition.ogg"},"실망":{"voiceline":"우주 제일 음란 색골 변태 자식!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/feeling1.ogg"},"낯섦":{"voiceline":"마침 할 일이 없을 뿐이야, 네가 너무 외롭고 불쌍해 보이니까 말 걸어 준 것 뿐이라구! 오해하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/feeling2.ogg"},"호감":{"voiceline":"이렇게 보여도 어른이니까! ──그러니까 머리 만지지 마! 껴안아서 올리지 마! ──진짜 화났어! 정말 화났다고! 우, 우씨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/feeling3.ogg"},"기쁨":{"voiceline":"네, 네가 다른 여자에게 손대는 것을 막기 위한 위대한 희생이야! ──에에에, 나라서 좋다고!? 잠까, 읏!……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/feeling4.ogg"},"사랑":{"voiceline":"어, 어쩔 수 없잖아. 그렇게나 나를 좋아하면 쓰다듬 정도는 예외로서 허락해줄게! 차, 착각하지 말라고! 쓰다듬을 수 있는 것은 너만이야! 너뿐이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"그렇게 노력했으니… 무, 무릎 베개정도라면… 해 주지 못할 것도 없다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어이, 지휘관! 나가고 싶지만, 오늘은 동행할 사람이 없어. 네가 따라와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/login.ogg"},"실패":{"voiceline":"가, 가끔은 실패하는 일도 있어! …시끄러워 시끄러워 시끄러~워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/lose.ogg"},"우편":{"voiceline":"편지 가져와 줬으니까, 감사하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/mail.ogg"},"임무":{"voiceline":"미션이 끝나지 않은 것은, 게으름 피웠단 이야기야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/mission.ogg"},"임무완료":{"voiceline":"임무를 완료하면 보너스를 수취해야지. 나 참, 이렇게나 걱정하게 만들고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/mission_complete.ogg"},"서약":{"voiceline":"이 행동의 의미를 알고 있겠지! ……그, 그래? 그러면 받아줄게…… 착각하지 말아줘! 이건 네가 아니라 함대를 위해서야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/propose.ogg"},"스킬":{"voiceline":"나를 얕보지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/skill.ogg"},"터치1":{"voiceline":"너, 너란 놈은… 어째서 그런 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/touch.ogg"},"터치2":{"voiceline":"꺗! …이, 코피만 흘리는 발정 난 변태 자식!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/touch2.ogg"},"입수시":{"voiceline":"A급 실험 구축함, 아마존이야. 너 같은 바보 녀석은 상대 하고 싶지 않지만… 어쩔 수 없지, 돌봐주도록 하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/unlock.ogg"},"강화성공":{"voiceline":"「앗, 내가 키웠다~」 같은 눈으로 보지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"꽤 하지? …따, 딱히 칭찬받고 싶은 게 아냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0},{"클뜯 id":201011,"클뜯 함순이 id":20101,"함순이 이름":"아마존","한글 함순이 + 스킨 이름":"리틀 오케스트라","영문 함순이 + 스킨 이름":"Little Orchestra","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/image