main/audio/voiceline/205013/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"매점에가서 사탕을 사달라고? 흐흥, 여왕도 서민들의 입맛을 알아야 하다니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205013/touch.ogg"},"터치2":null,"입수시":{"voiceline":"흐흥, 보아라~ 이게 바로 아카시가 새로 제작한 옷! 어때? 나의 우아한 제복의 자태에 경배하시지! 하인~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205013/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"흐흐흥, 승리는 당연한 거지! 난 그 자칭 정신적 리더라는 녀석이랑은 달라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205013/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"학교","상점 id":0,"상점 카테고리 id":4,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":205014,"클뜯 함순이 id":20501,"함순이 이름":"퀸 엘리자베스","한글 함순이 + 스킨 이름":"금운의 프리미엄 로열","영문 함순이 + 스킨 이름":"Crown Jewel of the Royal Navy","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205014/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205014/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205014/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205014/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205014/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205014/shipyard.png","설명":"이스트 글림에서는 \"세뱃돈\"을 준다고? 이야말로 로열 퀸의 위엄을 선보일 좋은 기회잖아!... 뭘 보고 있어! 좋아하지만 말고 어서 가서 알리라고!","자기소개":null,"메인1":{"voiceline":"하인, 어서 이스트 글림의 차를 가져오너라! 에든버러의 홍차와 맛을 비교해 봐야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/main1.ogg"},"메인2":{"voiceline":"흥, 감히 나의 재력을 의심해? 다음번 로열의 연회에서 똑똑히 보여주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/main2.ogg"},"메인3":{"voiceline":"신년에 선물을 드리는 시기가 지방에 따라 다른 거야? 흥, 됐어, 네가 열심히 일만 하면, 선물 따위 내가 언제든지 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/main3.ogg"},"전투개시":{"voiceline":"나를 위해 싸워라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/battle.ogg"},"상세확인":{"voiceline":"\"금운이라는 허황된 물건에 현혹되지 말자. 돈을 벌 방법은 얼마든지 있으니까.\" ...... 맞는 말이야. 전쟁은 너무 싫어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/detail.ogg"},"드랍 설명":{"voiceline":"이스트 글림에서는 \"세뱃돈\"을 준다고? 이야말로 로열 퀸의 위엄을 선보일 좋은 기회잖아!... 뭘 보고 있어! 좋아하지만 말고 어서 가서 알리라고!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"잘하잖아, 보상으로 세뱃돈을 주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/home.ogg"},"hp 경고":null,"로그인":null,"실패":null,"우편":{"voiceline":"어서 우편을 확인해! ... 그 세뱃돈 봉투가 아니라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"세뱃돈을 허하노라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/touch.ogg"},"터치2":{"voiceline":"이 하인이 어딜 만지는 거야! 지갑을 잃어버리도록 저주해 버릴 테다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205014/touch2.ogg"},"입수시":{"voiceline":"이스트 글림에서는 \"세뱃돈\"을 준다고? 이야말로 로열 퀸의 위엄을 선보일 좋은 기회잖아!... 뭘 보고 있어! 좋아하