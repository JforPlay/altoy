ink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"내게 찬사를 바치는 걸 허락해줄게! ……어서 칭찬하는 말을 늘어놓으라고, 하인!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205011/detail.ogg"},"드랍 설명":{"voiceline":"흐흥~ 감사히 생각하도록, 하인! 오늘은 특별히 내 파트너로 파티에 참가하는 걸 허락해 주지! ……따, 딱히 좋아서 널 고른 건 아니니까 말야! 적당히…그래, 그냥 아무나 적당히 고른 거라구! 알겠어?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":null,"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"흐, 흥! …모처럼 준비한 파티니까, 그 무례함은 관대히 봐주도록 하지. 내 아량에 감사하도록! 하인!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205011/touch.ogg"},"터치2":{"voiceline":"워, 워스파이트! 15inch포로 이 발칙한 하인에게 사형을 내리도록! 사, 사형이다아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205011/touch2.ogg"},"입수시":{"voiceline":"흐흥~ 감사히 생각하도록, 하인! 오늘은 특별히 내 파트너로 파티에 참가하는 걸 허락해 주지! ……따, 딱히 좋아서 널 고른 건 아니니까 말야! 적당히…그래, 그냥 아무나 적당히 고른 거라구! 알겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70098,"상점 카테고리 id":7,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":205012,"클뜯 함순이 id":20501,"함순이 이름":"퀸 엘리자베스","한글 함순이 + 스킨 이름":"A Night At The Stage","영문 함순이 + 스킨 이름":"One Night of the Queen","스킨 타입":"Sh