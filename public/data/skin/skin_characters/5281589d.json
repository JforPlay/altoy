[{"클뜯 id":205010,"클뜯 함순이 id":20501,"함순이 이름":"퀸 엘리자베스","한글 함순이 + 스킨 이름":"퀸 엘리자베스","영문 함순이 + 스킨 이름":"Queen Elizabeth","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205010/shipyard.png","설명":"퀸 엘리자베스급 전함·퀸 엘리자베스 (HMS Queen Elizabeth)","자기소개":{"voiceline":"로열 네이비 초노급 기함이야, 내 이름을 뼈에 새겨두도록 하렴!\n전투 결과? 그런 거는 하인들한테 맡겨, 나는 보는 것만으로 괜찮으니까! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/profile.ogg"},"메인1":{"voiceline":"작다는 건 고귀하다는 증거야, 알겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/main1.ogg"},"메인2":{"voiceline":"부딪혔다고? 나한테 길을 안 열어줘서야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/main2.ogg"},"메인3":{"voiceline":"배 만지지 마, 실례야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/main3.ogg"},"전투개시":{"voiceline":"초노급 전함의 위력을 보아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/battle.ogg"},"상세확인":{"voiceline":"이 서민! 누가 훔쳐봐도 된다고 했어? 아, 아직 준비 안 됐으니깐 말야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/detail.ogg"},"드랍 설명":{"voiceline":"퀸 엘리자베스급 전함·퀸 엘리자베스 (HMS Queen Elizabeth)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰에 갔던 하인들이 돌아왔어. 재밌는 헌상물이 있나 보고 와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/expedition.ogg"},"실망":{"voiceline":"이 도움 안 되는 하인 같으니! 잘라버리겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/feeling1.ogg"},"낯섦":{"voiceline":"이 엘리자베스 님을 위해서 열심히 노력하렴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/feeling2.ogg"},"호감":{"voiceline":"여기 분위기가 마음에 들어서 조금만 여기 앉아있는 거야! 착각하지 말아 줄래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/feeling3.ogg"},"기쁨":{"voiceline":"흐, 흥! 너도 조금은 도움이 될 때도 있으니까, 특별히 로열 네이비 친위대의 대장으로 임명해주겠어! 내가 부르면 곧장 오는 거야! 알겠어? 곧장! 속공으로! 최속으로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/feeling4.ogg"},"사랑":{"voiceline":"너 말야, 일은 부하한테 맡기면 되는 거 아냐? 내 남편이 될 사람이 내 곁에 있어주지 않는다니, 말이 된다고 생각해? 외, 외로워져 버리잖아… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"좋은 일 처리야. 특별히 조금 쉬게 해주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/home.ogg"},"hp 경고":{"voiceline":"뭘 멍하니 있는 거야! 빨리 가란 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/hp_warning.ogg"},"로그인":{"voiceline":"뭐냐구, 나를 이렇게나 기다리게 하다니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/login.ogg"},"실패":{"voiceline":"이게 무슨! 이 엘리자베스 님에게 모욕을 주다니! 기억해두도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/lose.ogg"},"우편":{"voiceline":"편지 내용 따위엔 관심 없어… 우으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/mail.ogg"},"임무":{"voiceline":"빨리 미션을 끝내라구! 서민 주제에 게으름 부리지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/mission.ogg"},"임무완료":{"voiceline":"무릎을 꿇고 미션의 은상을 받으렴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/mission_complete.ogg"},"서약":{"voiceline":"드디어 나한테 왔구나. 이 바보 하인, 얼마나 나를 기다리게 할 셈이야! ……하지만 그 노력을 봐서… 여기 와서, 내 손을 잡는 걸 허가할게! 자! 이제부턴 내가 따라가도록 할 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/propose.ogg"},"스킬":{"voiceline":"여왕님 앞에서 무릎 꿇으렴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/skill.ogg"},"터치1":{"voiceline":"내 고귀한 몸에 손대지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/touch.ogg"},"터치2":{"voiceline":"자, 잠깐… 바보 자식, 뭐 하는 거야!! 사, 사형시켜버릴 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관? 나를 지도한다니 10만년은 일러! 그래도 뭐, 찬스 정도는 주도록 하지… 오늘부터 너는 나의 충실한 하인이 되는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/unlock.ogg"},"강화성공":{"voiceline":"강해질 필요따윈 없어! ── 뭐어… 네가 애써 강하게 만들어 주겠다고 한다면야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"Piece of cake! 내가 하는 일에 틀린 것은 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['워스파이트'] : 워스파이트, 빨리 저 놈들을 해치워버려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/couple_encourage1.ogg"},{"voiceline":"['ROC'] : 이것이야말로 나에게 어울리는 함대야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205010/couple_encourage2.ogg"},{"voiceline":"['HMS'] : 로열 네이비의 전사들이여, 영광을 위해 싸우렴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voicelin