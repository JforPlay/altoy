m/Fernando2603/AzurLane/main/audio/voiceline/205012/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"오퍼가 들어왔다고? 좋, 좋아. 서민들의 목소리에 귀 기울이는 것도 여왕이 할 일이지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205012/mission.ogg"},"임무완료":{"voiceline":"임무 보상에 너를 위한 선물이 있어! 감사히 받도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205012/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"앵콜? 후후, 얼마든지 해주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205012/touch.ogg"},"터치2":{"voiceline":"하인, 어디를 만지는 거야! 가둬버리겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205012/touch2.ogg"},"입수시":{"voiceline":"이게 바로 나에게 걸맞는 무대지! 자, 절대 눈을 떼지 말도록 해! 나를 위해서 모든 열정을 불태우렴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205012/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"제군들, 모두에게 이 승리를 알리도록!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205012/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"Live","상점 id":70439,"상점 카테고리 id":11,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":800,"기간":"상시","진영":"HMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":205013,"클뜯 함순이 id":20501,"함순이 이름":"퀸 엘리자베스","한글 함순이 + 스킨 이름":"여왕의 학원 명령","영문 함순이 + 스킨 이름":"Queen of the Campus","스킨 타입":"School Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205013/painting.png","확대 일러":"https://raw.githubus