[{"클뜯 id":201160,"클뜯 함순이 id":20116,"함순이 이름":"하디","한글 함순이 + 스킨 이름":"하디","영문 함순이 + 스킨 이름":"Hardy","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201160/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201160/shipyard.png","설명":"H급 구축함 - 하디(H87) ","자기소개":{"voiceline":"로열 네이비 H급의 향도함, 하디입니다. 나르비크 해전에서는 메탈 블러드의 항구를 급습하여 큰 타격을 입혔습니다만, 그 후에는 적의 지원군 탓에…… 그때, 좀 더 시간이 있었다면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/profile.ogg"},"메인1":{"voiceline":"집무실 공기 참 좋네, 후우…… 와앗!? 따, 딱히 졸았던 건 아니에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/main1.ogg"},"메인2":{"voiceline":"향도함입니다만, 그렇다고 다른 자매함보다 지위가 높은 것은 아닙니다. 모두의 신뢰 덕택입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/main2.ogg"},"메인3":{"voiceline":"헌터, 내 케이크 먹은 거 당신이죠?! ……죄, 죄송합니다! 각하, 지금 시끄러우셨죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/main3.ogg"},"전투개시":{"voiceline":"분발하세요! 적에게 틈을 보여서는 안 됩니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/battle.ogg"},"상세확인":{"voiceline":"기술은 반복된 연습을 통해 몸에 익혀야 합니다. 각하는 물론 알고 계시겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/detail.ogg"},"드랍 설명":{"voiceline":"H급 구축함 - 하디(H87)","voicelink":null},"의뢰 완료":{"voiceline":"정상으로서 부하에게 명령할 권리가 있다는 것은, 부하들의 노력을 소중히 할 의무도 있다는 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/expedition.ogg"},"실망":{"voiceline":"칠칠치 못한 사람은 질색입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/feeling1.ogg"},"낯섦":{"voiceline":"…읏! 가, 각하셨습니까… 죄송합니다. 익숙하지 않은 기척이 가까이 와서 무심코… 크흠! 언제라도 경계를 풀지 않는 것이 제 방식입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/feeling2.ogg"},"호감":{"voiceline":"다과회… 말입니까? 모처럼 권유해주셨는데 죄송합니다. 실은 아직 훈련이 끝나지 않아서…… 그, 그런데, 케이크 하나만 가져다주실 수 있을까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/feeling3.ogg"},"기쁨":{"voiceline":"무리한 신중함은 나쁜 결과를 가져올 수도 있다…… 과연, 일리 있군요. 기억해 두겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/feeling4.ogg"},"사랑":{"voiceline":"각하, 기척을 지우고 살금살금 접근해도 소용없습니다. 이제 각하의 분위기는 전부…… 꺅!? 대, 대체 왜 뻔뻔하게 껴안는 겁니까!? …아하하하, 간지러워, 간지럽다니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"각하? 방금 전투에서는 반성할 점이 있었죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/home.ogg"},"hp 경고":{"voiceline":"여기선 버텨내야 해……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/hp_warning.ogg"},"로그인":{"voiceline":"조금 늦었군요. 각하, 어서 업무를 시작해 주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/login.ogg"},"실패":{"voiceline":"이곳에 머무르지 말고, 어서 퇴각해 주십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/lose.ogg"},"우편":{"voiceline":"각하? 항상 제가 우편을 가져다 드릴 거라고 생각하지는 말아 주십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/mail.ogg"},"임무":{"voiceline":"각하, 서류 작업이 끝나는 대로 임무를 수행하도록 합시다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/mission.ogg"},"임무완료":{"voiceline":"각하, 보십시오! 보수가 이렇게나 잔~뜩!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/mission_complete.ogg"},"서약":{"voiceline":"저도 알고 있습니다! 제가 가끔 지나치게 신중하다고 말씀하고 싶으신 거군요! 그러면 저도…… 각하야말로, 가끔 너무 느슨합니다! 앞으로는 제가 확실히 지켜봐 드릴 테니, 가, 각오해 주십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/propose.ogg"},"스킬":{"voiceline":"빈틈은 주지 않습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/skill.ogg"},"터치1":{"voiceline":"꺅!? ……각하? 갑자기 만지지 말아 주십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/touch.ogg"},"터치2":{"voiceline":"레이피어는 장식용입니다만, 찔리면 꽤 아프다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/touch2.ogg"},"입수시":{"voiceline":"만나서 영광입니다, 지휘관 각하. 로열 네이비 소속, 구축함 하디, 착임했습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/unlock.ogg"},"강화성공":{"voiceline":"후우, 강화에는 성공했지만, 그렇다고 훈련 빈도를 줄여선 안 되겠죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"다들, 이겼다고 해서 긴장을 풀어서는 안 됩니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['워스파이트'] : 워스파이트 님, 드디어 이번에는 함께하는군요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/couple_encourage1.ogg"},{"voiceline":"['퀸 엘리자베스'] : 이 영광을 폐하께!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201160/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,