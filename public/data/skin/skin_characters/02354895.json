[{"클뜯 id":202070,"클뜯 함순이 id":20207,"함순이 이름":"사우스햄튼","한글 함순이 + 스킨 이름":"사우스햄튼","영문 함순이 + 스킨 이름":"Southampton","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202070/shipyard.png","설명":"사우스햄튼급 경순양함-사우스햄튼(C83) ","자기소개":{"voiceline":"저는 사우스햄튼이라고 명명된 함선이에요. 그리고 저는 자매 중 유일하게 평화로운 퇴역을 하지 못했죠. 그 때 운이 조금만 더 좋았더라면...흑흑, 더이상 괴로운 과거는 생각하고싶지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/profile.ogg"},"메인1":{"voiceline":"지휘관님, 집무실에 고전적인 축음기 한 대 들여놓으시죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/main1.ogg"},"메인2":{"voiceline":"메이드는 매일 이래저래 바빠서...전 못해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/main2.ogg"},"메인3":{"voiceline":"의장병이요? 무책임한 말 그만하세요! 저는 조지 5세 폐하 휘하의 황실 기사라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/main3.ogg"},"전투개시":{"voiceline":"잠깐만요, 다들 서두르지말아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/battle.ogg"},"상세확인":{"voiceline":"역시 메이드복 보다는 기사도 복장이 낫네요. 여러모로 편하고~ 지휘관님도 한번 입어보세요! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/detail.ogg"},"드랍 설명":{"voiceline":"사우스햄튼급 경순양함-사우스햄튼(C83)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀을 맞으러 가실건가요? 그럼...맞이하고 나서 돌아와서 쉬세요~히히","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/expedition.ogg"},"실망":{"voiceline":"지휘관님, 너무 몰아붙이면 오히려 역효과가 날 수도 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 오늘도 함대를 위해 동분서주하시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 그렇게까지 스스로를 몰아붙일 필요가 있을까요? 예를 들면...메이드대 자매들한테 좀 도와달라고 하는건 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/feeling3.ogg"},"기쁨":{"voiceline":"사실, 모든 일을 그렇게 완벽하게 할 필요는 없어요. 좀 더 쉽게하고, 좀 더 내키는대로 하고, 좀 더 즐겁게 사는 것도 좋잖아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/feeling4.ogg"},"사랑":{"voiceline":"즐거워지는 방법을 모르시겠다면 제가 가르쳐드릴게요! 응? 뭘 할거냐고요? 생각 좀 해볼게요! 히히!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님 집무실은 정말 크네요. 여기서 빈둥거리는 것도 좋겠어요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/home.ogg"},"hp 경고":{"voiceline":"으아아! 이, 이번엔 아무 일 없어야해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/hp_warning.ogg"},"로그인":{"voiceline":"오! 지휘관님, 오늘 일을 빨리 끝낼 수 있도록 같이 화이팅 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/login.ogg"},"실패":{"voiceline":"아야! 아파라! 어, 어서 퇴각하죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/lose.ogg"},"우편":{"voiceline":"이번에는 또 어디서 온 편지일까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/mail.ogg"},"임무":{"voiceline":"임무...는 기한이 아직 남았으니, 좀 있다가 해도 되겠...죠? 헤헤...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 왔어요. 그렇게 급한 일은 아니긴 한데, 그래도 받는거 잊으시면 안돼요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/mission_complete.ogg"},"서약":{"voiceline":"서약이란건 상당히 장중한 의식이기는 하지만, 그래도 걱정 마세요. 너무 많은 구속을 하지는 않을테니까요! 단 한가지 바라는 건...제가 지휘관님이 보고싶을 때 바로 달려와 주시기만 하면 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/propose.ogg"},"스킬":{"voiceline":"나서야 할 때는 나선다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/skill.ogg"},"터치1":{"voiceline":"정신이 없으시다고요? 그럼 잠깐 주무시는게 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/touch.ogg"},"터치2":{"voiceline":"저, 전 메이드가 아니에요!...아, 이게 아니지! 메이드한테도 이러시면 안되죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 주...아니지! 지휘관님! 저는 사우스햄튼입니다! 필요한 것이 있으시면 얼마든지 분부하세요~그리고...여기 여가 시간에 차를 마시면서 음악을 감상할 수 있는 곳이 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/unlock.ogg"},"강화성공":{"voiceline":"저 강해졌어요! 그렇다고 임무가 많이 바뀌지는 않았으면 좋겠네요. 히히~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"조건이 갖춰지면 당연히 승리하게 되어있어요! 오예~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['뉴캐슬'] : 뉴캐슬 언니, 언니가 타주신 홍차가 마시고싶어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/couple_encourage1.ogg"},{"voiceline":"['노샘프턴'] : 너는 노스 (north), 나는 사우스(south)니까 우리 친구할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202070/couple_encoura