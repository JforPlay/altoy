/audio/voiceline/202078/main1.ogg"},"메인2":{"voiceline":"제가 만든 요리가 맛있었다구요? 신난다! 셰필드가 가르쳐줘서, 솜씨를 발휘해서 만들어 본 거예요. 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/main2.ogg"},"메인3":{"voiceline":"쉿, 지휘관님. 이쪽이에요! 에헤헤, 여기면 셰필드네한테 들키지 않고 땡땡이… 크흠, 잠깐 쉴 수 있다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/main3.ogg"},"전투개시":{"voiceline":"이래 봬도 기사대의 일원이라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/battle.ogg"},"상세확인":{"voiceline":"이렇게 빙글 돌면, 리본 때문에 어쩌면 나비로 보이는 거 아닐까…. 지휘관님? 저기, 지휘관님? 왜 그러시… 넋을 잃었다니, 제 모습에 넋을 잃었다는 의민가요…??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/detail.ogg"},"드랍 설명":{"voiceline":"로열 나이트 사우스햄튼, 웨딩복 차림으로 화려하게 등장! 아, 지휘관님. 설마 긴장하신 거예요? 그럼, 어서~ 에헤헤(주물주물). 어때요? 어깨 힘이 좀 빠지셨나요?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀을 마중나갈 차례네요. 뉴캐슬처럼 훌쩍 다녀올까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님이 오늘을 편하게 보낼 수 있는 방법은 바로, 저랑 데이트하는 것! 에헤헤, 이걸로 확실히 아셨겠죠? …지금 일이 끝난 다음에요? 어쩔 수 없네요! 저도 도와드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오늘도 출격하시느라 수고하셨어요, 지휘관님. 따뜻한 홍차에, 제가 고른 음악을 들으면서 피로를 달래주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요! 주인… 아, 아니지! 그럼, 지휘관님? 이러면 바꾼 보람이 없는데…. 여, 여보! 음… 내가 이렇게 부르면 위화감 같은 거 느껴지지 않으려나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무… 벌써 마감 직전이라구요?! 뒤로 미루는 건 무리겠죠…. 흑….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202078/mission.ogg"},"임무완료":null,"