[{"클뜯 id":10100020,"클뜯 함순이 id":1010002,"함순이 이름":"느와르","한글 함순이 + 스킨 이름":"느와르","영문 함순이 + 스킨 이름":"Noire","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100020/shipyard.png","설명":"당신이 지휘관? 흐음, 뭐 좋아. 나는 느와르. 라스테이션의 수호여신이야. 내가 왔으니 안심해줘.","자기소개":{"voiceline":"라스테이션의 여신, 느와르야. 이 세계에서도 친구가 잔뜩 생길까… 그, 그것보다! 지금의 전황을 가르쳐줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/profile.ogg"},"메인1":{"voiceline":"점검은 게을리하지 않고 있지? 장비도 물론이지만, 그 아이들에게 동기 부여하는 것도 승패와 연관되니까 주의하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/main1.ogg"},"메인2":{"voiceline":"이 아이들의 의상, 꽤 귀여운 게 많네. 벼, 별로 입어보고 싶다든지 그런 의미가 아니니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/main2.ogg"},"메인3":{"voiceline":"흥~흐흐흐흥~♪흥~흥~흐흥♪ 히히……다, 당신 언제부터 여기 있었던 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/main3.ogg"},"전투개시":{"voiceline":"내 진짜 실력, 보여줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/battle.ogg"},"상세확인":{"voiceline":"자, 잠깐! 어딜 보는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/detail.ogg"},"드랍 설명":{"voiceline":"당신이 지휘관? 흐음, 뭐 좋아. 나는 느와르. 라스테이션의 수호여신이야. 내가 왔으니 안심해줘.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 끝난 모양이야. 잘 됐다, 모두 무사한 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/expedition.ogg"},"실망":{"voiceline":"빨리 내 시야에서 사라져주지 않으려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/feeling1.ogg"},"낯섦":{"voiceline":"앗, 마침 좋을 때 왔네. 지금부터 점심 먹으러 갈 건데, 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/feeling2.ogg"},"호감":{"voiceline":"다음에 내 친구가 지휘관과 함께 점심을 먹고 싶다고 했었는데, 괜찮지? 물론 나도 같이 갈 거야. 당신이 우쭐해져서 이상한 짓을 하지 않도록 지켜봐야 하기도 하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/feeling3.ogg"},"기쁨":{"voiceline":"상담? 딱히 내가 아니어도 괜찮지 않아? 누구였더라, 저번에 즐겁게 얘기하던 아이한테 부탁해보는 게 어때? 용건은 그것뿐이야? 그럼, 수고해. ……나, 정말 바보라니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/feeling4.ogg"},"사랑":{"voiceline":"저기… 나, 당신과 함께 있으면 가슴이 터질 것만 같아. 당신은 날 어떻게 생각해? …아냐, 역시 됐어. 답은 알고 있으니까…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어. 휴식도 훌륭한 훈련의 하나라고 생각해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/home.ogg"},"hp 경고":{"voiceline":"괜찮아, 문제없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/hp_warning.ogg"},"로그인":{"voiceline":"꽤나 여유로운 귀환이네, 오늘도 할 일이 가득 있으니까 정신 바짝 차리라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/login.ogg"},"실패":{"voiceline":"나는 이 패배를 평생 잊지 않아. 그렇기 때문에 더욱 강해지는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/lose.ogg"},"우편":{"voiceline":"우편이 온 모양이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/mail.ogg"},"임무":{"voiceline":"부지런히 임무를 체크해두세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/mission.ogg"},"임무완료":{"voiceline":"못 쓰는 보너스면 내가 위에 말해둘게","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/mission_complete.ogg"},"서약":{"voiceline":"엣?! 몰래카메라 같은 거 아니지…? 거짓말, 분명 미움받고 있을 거라 생각했어…… 근데 뭐야 그 얼굴은. 오케이란 거야! 그 정도는 눈치채라고 이 바보!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/propose.ogg"},"스킬":{"voiceline":"여기는 내게 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/skill.ogg"},"터치1":{"voiceline":"느왓……어딜 만지는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/touch.ogg"},"터치2":{"voiceline":"다, 당신…… 적당히 하지 않으면 화낼 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관? 흐음, 뭐 좋아. 나는 느와르. 라스테이션의 수호여신이야. 내가 왔으니 안심해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/unlock.ogg"},"강화성공":{"voiceline":"더 위를 노리는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥, 이 정도는 여유지. 나는 이 정도로는 만족하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['넵튠(콜라보)'] : 잠깐 넵튠! 너무 딴죽 걸지 않도록 주의해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/couple_encourage1.ogg"},{"voiceline":"['넵튠(콜라보)', '블랑', '벨(콜라보)'] : 각오는 되어있겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100020/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex"