[{"클뜯 id":305010,"클뜯 함순이 id":30501,"함순이 이름":"후소","한글 함순이 + 스킨 이름":"후소","영문 함순이 + 스킨 이름":"Fusou","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305010/shipyard.png","설명":"후소형 전함 1번함·후소","자기소개":{"voiceline":"사쿠라 엠파이어의 첫 초노급 전함, 후소이옵니다. 태생적인 재난을 떨쳐내기 위해, 여동생과 함께 나날이 신들께 기도를 올리고, 재난에 지지 않도록 정진해왔답니다. 레이테만의 그 비극만큼은 두 번 다시 일어나게 두지 않겠어요. 아무쪼록 지휘관 나리께서도 도와주시면 감사하겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/profile.ogg"},"메인1":{"voiceline":"불행한 운명은 노력으로 바꿀 수 있지요. 신들에게 기도를 드림과 동시에, 자신의 단련도 게을리해선 안 된답니다…… 전 그렇게 생각하여요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/main1.ogg"},"메인2":{"voiceline":"야마시로만 별일 없이 자라주기만 한다면 만족한답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/main2.ogg"},"메인3":{"voiceline":"이 주포는 화력에 특화된 거라서, 발포하면 항상 몸이 흔들려버리어요… 좀 곤란하답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/main3.ogg"},"전투개시":{"voiceline":"가로막는 자에게 용서는 없습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 같이 차라도 어떠시온지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/detail.ogg"},"드랍 설명":{"voiceline":"후소형 전함 1번함·후소","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조 애들이 돌아왔어요. 함께 맞이하러 가시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/expedition.ogg"},"실망":{"voiceline":"지휘관님은 재앙신의 화신입니까……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님은 사쿠라 엠파이어의 신들에게 흥미가 있으신지요? 우후후, 흥미가 없으셔도 괜찮아요. 저, 지휘관 나리의 몫도 함께 신들에게 기도드리고 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/feeling2.ogg"},"호감":{"voiceline":"지휘관님은 요즘 지치신 것 같아요… 과한 업무는 몸을 망친답니다. 지친 몸을 풀어드릴 테니까 이쪽으로 오셔요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/feeling3.ogg"},"기쁨":{"voiceline":"카구라 말인가요? 그건 신께 바치는 춤이옵니다만…… 그렇네요. 허면 지휘관님을 위해서 무녀 연무를 한 번 피로할까요. 다른 사람들이 보면 창피하오니, 부디 두 사람의 비밀로 하고, 은밀하게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/feeling4.ogg"},"사랑":{"voiceline":"알고 계신가요? 실은 사쿠라 엠파이어의 무녀들은 신을 모시는 몸이긴 하오나, 정사에 관한 제한은 딱히 없사와요. 오히려 신사의 대를 이을 분을 찾기 위해, 남편을 찾는데 힘쓰는 경우도…… 지휘관님…… 어찌 생각하셔요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 수고하셨어요. 후소가 있는 곳에서 편안히 쉬시지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/home.ogg"},"hp 경고":{"voiceline":"신이시시여, 저희를 지켜주소서……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 어서 오세요. 한 번 점쳐보는 건 어떠신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/login.ogg"},"실패":{"voiceline":"이건…… 탄약고가 또 저주를 받았나요? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/lose.ogg"},"우편":{"voiceline":"새로운 서신이어요. 지휘관님, 확인을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/mail.ogg"},"임무":{"voiceline":"새로운 임무가 내려왔습니다. 확인하시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/mission.ogg"},"임무완료":{"voiceline":"보수를 방치하는 건 좋지 않답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/mission_complete.ogg"},"서약":{"voiceline":"높은 산봉우리 위의, 같은 뿌리에서 돋은 소나무에 견주는 영원한 동백에 맹세코, 가문 드넓게, 가명 드높게, 더욱더 번창할 수 있기를 감히 아룁니다. ──이걸로 저와 지휘관님은 일심동체…… 부족한 몸이옵니다만, 부디 잘 부탁드리어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/propose.ogg"},"스킬":{"voiceline":"불제하시어, 정화하소서!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/skill.ogg"},"터치1":{"voiceline":"지휘관님. 이쪽으로 와주시어요. 귀 청소를 해드리겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/touch.ogg"},"터치2":{"voiceline":"저기, 이건…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/touch2.ogg"},"입수시":{"voiceline":"처음 뵙겠습니다. 당신은 지휘관님이시죠? 네, 후소는 계속 여기서 기다리고 있었습니다. 이것도 무언가의 인도겠지요. 부디 앞으로 잘 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/unlock.ogg"},"강화성공":{"voiceline":"이걸로 더 힘이 될 수 있사와요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"그대들의 영혼에 고향의 안식이 있기를…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_