[{"클뜯 id":101390,"클뜯 함순이 id":10139,"함순이 이름":"멀라니","한글 함순이 + 스킨 이름":"멀라니","영문 함순이 + 스킨 이름":"Mullany","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101390/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101390/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101390/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101390/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101390/shipyard.png","설명":"플레처급 구축함 - 멀라니 (DD-528) ","자기소개":{"voiceline":"플레처급은 대가족이니까, 나에 대해 몰라도 괜찮아. 그 대전에 참가했던 때는 여러 위기도 있었지만, 전부 무사히 극복했어. 그 뒤엔 이스트 글림에 갔었지. 조금 어른스럽게 보이는 건 그 때문… 일까나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/profile.ogg"},"메인1":{"voiceline":"음… 레시피 대로 만들었는데 왜 이렇게 된 걸까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/main1.ogg"},"메인2":{"voiceline":"지휘관, 완급 조절은 중요한 거야. 게으름 피우는 것도, 너무 노력하는 것도, 둘 다 안 좋으니까 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/main2.ogg"},"메인3":{"voiceline":"지휘관, 힘내. 자신이 최고라고 믿는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/main3.ogg"},"전투개시":{"voiceline":"오늘도 지휘관을 위해 노력할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/battle.ogg"},"상세확인":{"voiceline":"지휘관, 내 도움이 필요하면 언제든지 불러줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함 - 멀라니 (DD-528)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰가 완료됐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/expedition.ogg"},"실망":{"voiceline":"싫은 사람을 위해 요리를 만드는 건 이렇게 기분이 나쁘구나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/feeling1.ogg"},"낯섦":{"voiceline":"지휘관은 어떤 취미를 갖고 있어? 나는 요리가 좋아. 가끔 이상한 걸 만들어 버리긴 하지만, 대체로 맛있다구! 응!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/feeling2.ogg"},"호감":{"voiceline":"이상한 걸 만들지만 않으면 완벽한데…라고? 아니, 난 이런 서프라이즈도 중요하다고 생각해. 미안해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 규칙적으로 생활하고 있어? 혼자서 안 된다면 내가 도와줘도 되는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/feeling4.ogg"},"사랑":{"voiceline":"민폐만 끼쳐서 미안하다고? 아냐, 괜찮아. 나는 제일 소중한 사람의 도움이 될 수 있어서 엄청나게 기쁘니까! 앞으로도 나에게 기대라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/feeling5.ogg"},"터치3":{"voiceline":"아이 취급당하는 건… 조금 이상한 느낌이네… 아하하하","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 수고했어. 간식은 챙겨뒀어. 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/home.ogg"},"hp 경고":{"voiceline":"아, 아차……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/hp_warning.ogg"},"로그인":{"voiceline":"지휘관은 밥 먹었어? 내가 간단한 거라도 좀 만들어 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/login.ogg"},"실패":{"voiceline":"지휘관, 미안해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이야. 확인을 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/mail.ogg"},"임무":{"voiceline":"열심히 임무를 해내보자고, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/mission.ogg"},"임무완료":{"voiceline":"임무 보수인가…… 나도 상으로 지휘관에게 뭔가 만들어 주는 게 좋을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 내가 계속 밥을 만들어 줘도 될까…? 앗, 이상한 요리는 너무 만들지 말아 달라고…? 아, 아하하하… 노, 노력할게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/propose.ogg"},"스킬":{"voiceline":"간다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/skill.ogg"},"터치1":{"voiceline":"응? 부엌에서 나는 연기? 아, 아하하하… 뭐, 뭘까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/touch.ogg"},"터치2":{"voiceline":"지, 지휘관은 역시 야한 거에 흥미가 있구나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/touch2.ogg"},"입수시":{"voiceline":"지휘관, 만나서 반가워. 플레처급의 멀라니야. 이제부턴 모항에서 같이 지낼 테니까, 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/unlock.ogg"},"강화성공":{"voiceline":"아, 새로운 레시피가 생각났다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/upgrade.ogg"},"vote":null,"승리":{"voiceline":"내가 일등? 음… 나, 지휘관에게 도움이 됐다면 그걸로 기뻐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101390/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":0},{"클뜯 id":101392,"클뜯 함순이 id":10139,"함순이 이름":"멀라니","한글 함순이 + 스킨 이름":"칭양의 요리 특훈","영문 함순이 + 스킨 이름":"Eastern Etiquette","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101392/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101392/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101392/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101392/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101392/shipyard.png","설명":"왜 그래 지휘관? 이상한 거라도 본 듯한 눈으로……아아, 이 옷은 이스트 글림에서 교류학습할 때 받은 건데……어, 어때……나한테…어울려? ","자기소개":null,"메인1":{"voiceline":"조금 거리감이 느껴진다구? 으음… 조금 상처받네…… 난 언제나 곁에 있잖아.","voicelink":null},"메인2":{"voiceline":"이스트 글림에도 맛있는 요리가 잔뜩 있었어. 지휘관, 다음에 한 번 만들어 줄까?","voicelink":null},"메인3":{"voiceline":"지휘관은 매화꽃 좋아해? 난 좋아해.","voicelink":null},"전투개시":null,"상세확인":{"voiceline":"이스트 글림에서 공부하면서 그 긴 역사와 문화를 접한 덕분에, 예전보다 조금은 차분해진 느낌이지만, 그렇게까지 변하진 않았다구? 안 믿어져? 요리를 보면 알아주려나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101392/detail.ogg"},"드랍 설명":{"voiceline":"왜 그래 지휘관? 이상한 거라도 본 듯한 눈으로……아아, 이 옷은 이스트 글림에서 교류학습할 때 받은 건데……어, 어때……나한테…어울려?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"여러 사람을 위해 요리를 만들 땐, 기분도 여러 가지로 변하곤 해. 지휘관에게 만들어준 때는…… 두근두근거리는 느낌일까나. 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101392/feeling5.ogg"},"터치3":{"voiceline":"지휘관은 이 머리모양에… 흥미 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101392/headtouch.ogg"},"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"샤오룽바오라도 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101392/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"오늘 할 일은 오늘 끝낸다'…지휘관, 그렇게 하는 편이 좋을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101392/mission.o