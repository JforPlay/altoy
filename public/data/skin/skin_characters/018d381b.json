[{"클뜯 id":105120,"클뜯 함순이 id":10512,"함순이 이름":"노스캐롤라이나","한글 함순이 + 스킨 이름":"노스캐롤라이나","영문 함순이 + 스킨 이름":"North Carolina","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105120/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105120/shipyard.png","설명":"노스캐롤라이나급 전함 노스캐롤라이나 (BB-55)","자기소개":{"voiceline":"저는 노스캐롤라이나급의 1번함, 유니온 전함의 장녀라고도 할 수 있지요. 특별히 좋아하는 것도 없고 싫어하는 것도 없지만… 그러고 보니 참여한 전투에서 주목할 만한 전과가 없었군요… 좀 곤란하네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/profile.ogg"},"메인1":{"voiceline":"안에는 뭘 입고 있냐고요? 대단한 건 아니예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/main1.ogg"},"메인2":{"voiceline":"생각해보면 정말 다양한 곳에 갔었네요. 수많은 풍경도, 수많은 이별도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/main2.ogg"},"메인3":{"voiceline":"가끔은 워싱턴의 활발함이 조금 부럽기도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/main3.ogg"},"전투개시":{"voiceline":"방심하지 말고 긴장하지 말고, 승리를 목표로 하자고요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/battle.ogg"},"상세확인":{"voiceline":"그렇게 보고 계시니 부끄럽네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/detail.ogg"},"드랍 설명":{"voiceline":"노스캐롤라이나급 전함 노스캐롤라이나 (BB-55)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료 시간이네. 슬슬 돌아올 것 같은데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/expedition.ogg"},"실망":{"voiceline":"지휘관, 이젠 화낼 거예요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/feeling1.ogg"},"낯섦":{"voiceline":"절 기억해 주시다니, 지휘관도 꽤 하네요~ 자랑은 아니지만 저, 존재감이 희미한 거엔 조금 자신이 있었거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/feeling2.ogg"},"호감":{"voiceline":"외모라면, 함대 아이들 모두 귀엽답니다. 게다가 모두 개성이 있죠. 뭐 솔직히 말하면, 조금 질투가 날 것 같기도.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/feeling3.ogg"},"기쁨":{"voiceline":"평범해도 상관없다고 생각했었지만, 지휘관을 만나고 나서 조금 자신을 바꿔보려고 생각하기 시작했어요. …자매들이 모두 개성적이니까요~ 음, 지휘관, 바니 걸 같은 건 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 끝나고 나면 뭔가 가볍게 먹을까요? 사실 저는 쇼핑을 하러 가고 싶어요. 지휘관도 사고 싶은 것이 있으면 함께 어때요? 그리고… 음 그러니까, 공원에서 산책은 어떨까요? 당신과 함께라면 어디든지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어머, 잠깐 그대로 그대로 있어 봐요, 지금 옷깃을 고쳐드릴게요… 됐다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/home.ogg"},"hp 경고":{"voiceline":"모두, 버텨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/hp_warning.ogg"},"로그인":{"voiceline":"어서 오세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/login.ogg"},"실패":{"voiceline":"그렇게 쉽게 되진 않는군요… 다음은 좀 더 노력하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/lose.ogg"},"우편":{"voiceline":"새로운 메시지가 왔어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/mail.ogg"},"임무":{"voiceline":"미션을 내버려 둬서는 안 된답니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/mission.ogg"},"임무완료":{"voiceline":"미션 보너스가 도착했네요. 받으러 가지 않을래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/mission_complete.ogg"},"서약":{"voiceline":"이것은 확실히 보답하지 않으면 안 되겠네요… 음… 그런데 지휘관, 바니 걸 좋아하세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/propose.ogg"},"스킬":{"voiceline":"어떤 때라도 방심하면 안 된답니다","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/skill.ogg"},"터치1":{"voiceline":"제가 도움이 될만한 일은 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/touch.ogg"},"터치2":{"voiceline":"이러시면 안 되는 거 알죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/touch2.ogg"},"입수시":{"voiceline":"노스캐롤라이나. 명령을 내려주세요. 다른 자매들에 비하면 조금 수수하지만, 뭐 개성이 없는 것도 개성입니다. 후훗. 어쨌든 잘 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/unlock.ogg"},"강화성공":{"voiceline":"그럼 이 언니도 조금 힘내도록 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관도 칭찬해주시면 기쁠 거에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":105121,"클뜯 함순이 id":10512,"함순이 이름":"노스캐롤라이나","한글 함순이 + 스킨 이름":"비밀의 환복 연습?","영문 함순이 + 스킨 이름":"The Heart's Desire","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105121/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105121/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105121/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105121/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105121/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105121/shipyard.png","설명":"아? 지휘관님, 이건 단지... 아, 옷 갈아입기 연습을 하는 것 뿐입니다...! 아 참... 그런데, 지휘관님은 \"바니걸 애호가\"시겠죠... 그렇죠?","자기소개":null,"메인1":{"voiceline":"후~ 정신이 말끔해지고 자유로움이 느껴지는 것 같아요~ 아, 그런 걸 말하는 건 아니에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/main1.ogg"},"메인2":{"voiceline":"워싱턴이 자연스러운 웃음을 지었다고요? 그 아이는 눈빛이 가끔 엄청 매서워서 쉽게 오해할 수 있어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/main2.ogg"},"메인3":{"voiceline":"바니걸에 확실히 어느 정도 흥미가 있긴 하지만, 누군가에게 바니걸에 대해 배우는 건 역시 좀 부끄럽네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"평상시에 계속 이렇게 입고 있지 않냐고요? 그건… 지휘관님 맘대로 생각하세요~ 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/detail.ogg"},"드랍 설명":{"voiceline":"아? 지휘관님, 이건 단지... 아, 옷 갈아입기 연습을 하는 것 뿐입니다...! 아 참... 그런데, 지휘관님은 \"바니걸 애호가\"시겠죠... 그렇죠?","voicelink":null},"의뢰 완료":{"voiceline":"이 옷차림으로 나가서 의뢰조 동료들을 크게 놀래켜 줘 볼까요? 후후, 농담이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님, 이따가 시간 되시나요? 같이 외출할 수 있는지… 안심하세요, 절대 이렇게 나가진 않을 거니까요. 평상시대로 입을 거에요. 지휘관님의 관심 감사해요, 후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/feeling5.ogg"},"터치3":{"voiceline":"역시 \"귀\"가 없으니 바니걸이라고 칭할 수 없겠네요. 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/headtouch.ogg"},"모항귀환":{"voiceline":"리본 좀 정리해주실 수 있나요? 음, 이건 좀 너무 가까운데… 아, 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요~ 도움이 필요한 일이 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"지휘관님 역시 이게 좋으시죠? 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/touch2.ogg"},"입수시":{"voiceline":"아? 지휘관님, 이건 단지... 아, 옷 갈아입기 연습을 하는 것 뿐입니다...! 아 참... 그런데, 지휘관님은 \"바니걸 애호가\"시겠죠... 그렇죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"승리하기 위해선 개성이 아니라 모두가 단결하여 협력해야 하죠~ 후훗~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105121/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"카니발","상점 id":70583,"상점 카테고리 id":16,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1180,"기간":"한정 (2025/04/02)","진영":"USS","레어도":"SSR","ex_chat_status":0}]