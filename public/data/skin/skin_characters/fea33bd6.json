[{"클뜯 id":307150,"클뜯 함순이 id":30715,"함순이 이름":"아마기(항공모함)","한글 함순이 + 스킨 이름":"아마기(항공모함)","영문 함순이 + 스킨 이름":"Amagi(CV)","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307150/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307150/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307150/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307150/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307150/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307150/shipyard.png","설명":"항공모함-아마기","자기소개":{"voiceline":"허약했던 몸을 고쳐서, 이렇게 다시 맑은 하늘 아래에서 바다를 누빌 수 있을 거라고는 생각도 못 했습니다. 지휘관님, 그리고 포기하지 않은 동료들에게 한 번 더 진심으로 감사를…… 아마기가 다시 돌아왔습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/profile.ogg"},"메인1":{"voiceline":"지휘관님, 「함재기」라고 불리는 이 아이들이 정말 전투의 추세를 좌우하는 존재가 되었군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/main1.ogg"},"메인2":{"voiceline":"지휘관님, 고민이 하나 있는데…… 제가 아카기 곁에 있는 시간이 너무 적은 것 같지 않습니까? 이 시간은 어떻게 보충해야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/main2.ogg"},"메인3":{"voiceline":"…아, 약상자가 비었군요. 슬슬 보충을 해둬야… 지휘관님? 아뇨, 여기에는 영양보충제 밖에는 없습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/main3.ogg"},"전투개시":{"voiceline":"각각 계획대로 싸워 지휘관님께 승리를…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/battle.ogg"},"상세확인":{"voiceline":"지휘관님께서는 시간이 흐른 지금도 여전히 「모두 다치지 않는」 계책을 구하고 계신 건가요? 후후… 잘 알고 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/detail.ogg"},"드랍 설명":{"voiceline":"항공모함-아마기","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰가 완료되었습니다. 동료들이 있는 창고로 같이 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/expedition.ogg"},"실망":{"voiceline":"시간의 흐름에 따라 사람도 변하는군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님, 사실 저… 동료들과 어떻게 마주하고, 지금 환경에는 또 어떻게 적응할지 막막했답니다. 하지만 지휘관님을 만나자마자 깨달았죠. 제가 망설이고 걱정했던 건 그저 기우에 지나지 않았다고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 다음에 출진하실 때는 부디 이 아마기도 같이 데려가 주세요. 그저 뒤에서 지휘관님의 귀환을 기다리는 것이 아니라, 다른 동료들과 마찬가지로 전장에서도 지휘관님 곁에 설 수 있게 해주셨으면 합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/feeling3.ogg"},"기쁨":{"voiceline":"아마기에게 있어서 지휘관님은 만병통치약이면서, 때로는 몸을 파멸시키는 극약이 되기도 한답니다…… 후후후, 설령 독이라고 할지라도, 아마기는 기꺼이 마시겠지만요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/feeling4.ogg"},"사랑":{"voiceline":"「세월의 유구한 흐름처럼, 연모의 감정 또한 영원토록 멈추지 않으리」 ……후후후, 지휘관님. 아마기가 무슨 말을 하는지 짐작이 가시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/feeling5.ogg"},"터치3":{"voiceline":"지휘관님의 손… 늠름해졌네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 개선을 축하드립니다. 후후, 아마기와 지휘관님의 마음이 통하는 것, 그것이 바로 이어지는 승리의 비결이라 할 수 있겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/home.ogg"},"hp 경고":{"voiceline":"후후… 더 「효과적」인 계책으로 전환할 때가 왔군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 어서 오세요. 오늘 작전에 대해서는 이미 계책을 짜뒀습니다. 부디 검토해 주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/login.ogg"},"실패":{"voiceline":"형세가 불리하군요. 지휘관님, 일단은 공격을 멈추시고, 태세를 정비한 뒤 다시 도전하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/lose.ogg"},"우편":{"voiceline":"지휘관님, 우편이 도착했습니다. 함재기로 책상 위에 전달했으니, 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/mail.ogg"},"임무":{"voiceline":"후후후, 다음 임무에 대해서는 이미 대책을 준비해 뒀습니다. 지휘관님, 확인 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/mission.ogg"},"임무완료":{"voiceline":"이 보상은 모두 지휘관님께서 이룰 대업의 초석이 되겠죠. …좀 더 받을 수 있도록 계책을 짜둬야겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/mission_complete.ogg"},"서약":{"voiceline":"아마기는 이제 예전처럼 연약한 몸이 아니고, 지휘관님 또한… 예전의 그 미숙한 지휘관님이 아니시지요. ……다시는 지휘관님 곁을 떠나지 않겠다고 맹세하겠습니다. 세상의 혼란은 아직도 계속되고 있으니… 지휘관님, 앞으로도 같이 노력해 나가요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/propose.ogg"},"스킬":{"voiceline":"그럼 어디, 날아볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/skill.ogg"},"터치1":{"voiceline":"지휘관님, 피곤하시면 아마기의 꼬리를 베개삼아 잠깐 쉬는 건 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/touch.ogg"},"터치2":{"voiceline":"지휘관님, 지금은 참으시는 편이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/touch2.ogg"},"입수시":{"voiceline":"항공모함 아마기가 다시 인사드립니다. 세월이 흘러 이 천지도 적지 않는 변화를 이룬 것 같고… 지휘관님, 이번에는 어떤 적을 상대하면 될까요? 후후, 아마기의 몸은 이제 괜찮습니다. 부디 걱정하지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/unlock.ogg"},"강화성공":{"voiceline":"이 힘… 잘 활용하도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 승리는 다음 승리의 초석이 될 테죠. 훌륭한 지휘였습니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"세월이 흘러도 지휘관님은 여전히 그대로라는 것… 그게 아마기가 돌아왔을 때 들은 가장 기쁜 소식이었답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"「하늘을 비추는 밝은 달은 저녁에도 사라지지 않지만, 눈으로는 보여도 가까이할 길이 없네」 ……하지만 아마기라는 이름의 달은 이미 소중한 사람 곁에 머물러 있지요. 안 그래요, 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 맛있게 드세요. 새로 받은 찻잎으로 우린 청차랍니다. 업무를 시작하시기 전에 한잔하시는 게 어떤가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"정말, 지휘관님도 참… 애처럼 신나서…… 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/touch_ex.ogg"},"터치2_ex":{"voiceline":"후후후… 아마기의 몸이 건강해져서 지휘관님도 대담해지신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['카가'] : 늘 신세만 지네요, 카가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/couple_encourage1.ogg"},{"voiceline":"['아카기'] : 아카기, 같이 지휘관님께 승리를 안겨드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/couple_encourage2.ogg"},{"voiceline":"['미카사'] :  대선배가 아직 고군분투하고 계시니, 아마기도 열심히 해야겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/couple_encourage3.ogg"},{"voiceline":"['나가토'] : 나가토 님도 변하셨군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/couple_encourage4.ogg"},{"voiceline":"['즈이카쿠', '류호'] : 아카기의 후배들도 실력자들이 많네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/couple_encourage5.ogg"}],"메인4":{"voiceline":"얼마 전에 카가가 병문안을 와줬습니다. 순양전함에서 항공모함으로, 시대의 흐름을 타고 앞으로… 후후, 저도 뒤처지지 않도록 더욱 정진해야겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관님, 일이 산더미처럼 쌓여 있을 때야말로 적절히 휴식을 취하면서 일해야 합니다. 그러니 지금은 쉬셔야 해요. 이 점에 대해서는 한발도 물러설 생각 없으니 그렇게 아세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/main5_ex.ogg"},"메인6_ex":{"voiceline":"이번 대국에서는 지휘관님의 군세 쪽이 한 수 위인 듯하군요… 후후후, 지휘관님. 이번에는 봐 드리지 않았답니다. 이미 아마기를 뛰어넘는 존재가 되신 건…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/main6_ex.ogg"},"메인7_ex":{"voiceline":"경단에 양갱에 벌꿀 케이크… 오늘은 어떤 걸로 할지 고민이네요… 지휘관님, 지혜를 좀 빌려주실 수 있으실까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/main7_ex.ogg"},"메인8_ex":{"voiceline":"지휘관님, 잠시 후에 아마기와 모항을 둘러보러 가지 않으시겠어요? 지휘관님이 계신 모항에 어떤 새로운 변화가 있었는지 보고 싶어서요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307150/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"UR","ex_chat_status":1},{"클뜯 id":307151,"클뜯 함순이 id":30715,"함순이 이름":"아마기(항공모함)","한글 함순이 + 스킨 이름":"옥좌 위에 핀 꽃","영문 함순이 + 스킨 이름":"Throne of Fallen Petals","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307151/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307151/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307151/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307151/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307151/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307151/shipyard.png","설명":"지휘관님, 어서 오세요. 기다렸답니다. 크흠, 후후… 꿈의 성에 오신 걸 환영합니다. 이 옥좌는 저와… 그리고 당신을 위한 것이기도 해요.","자기소개":null,"메인1":{"voiceline":"응? 여기 온 후부터는 매일 날씨가 맑은 것 같다고요? 후후후, 알아채셨군요. 역시 여기 계셔도 지휘관님은 여전히 예리하시네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/main1.ogg"},"메인2":{"voiceline":"「외로운 성주와 길을 잃은 방문자의 만남」――동화를 만들기에 딱 좋은 주제 아닌가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/main2.ogg"},"메인3":{"voiceline":"꿈속 환상의 유원지라면 한 번쯤은 마음껏 날뛰어도 괜찮겠죠. …후후후, 지휘관님. 아마기와 함께 여기 있는 과자를 전부 먹어보는 건 어떠세요? 우선은 양갱부터…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관님, 이 성에는 아직 알려지지 않은 흥미로운 비밀이 많답니다. 혹시 괜찮으시면, 그걸 찾으러 떠나는 모험에 이 아마기도 함께해도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/detail.ogg"},"드랍 설명":{"voiceline":"지휘관님, 어서 오세요. 기다렸답니다. 크흠, 후후… 꿈의 성에 오신 걸 환영합니다. 이 옥좌는 저와… 그리고 당신을 위한 것이기도 해요.","voicelink":null},"의뢰 완료":{"voiceline":"어쩌면 의뢰팀에서 서프라이즈가 준비되어 있을지도…… 지휘관님, 같이 확인하러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이 환상의 성에 있는 건 아마기와 지휘관님 두 사람뿐… 어깨의 무거운 짐은 내리고, 마음껏 원하는 바를 펼치면서… 아마기와 함께 이 찰나의 안식과 기쁨을 즐기시길…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/feeling5.ogg"},"터치3":{"voiceline":"어머…? 지휘관님… 혹시 지루하신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/headtouch.ogg"},"모항귀환":{"voiceline":"아마기의 예상대로 승리를 거두고 돌아오셨군요. 축하연 준비가 끝났으니, 괜찮으시면 저와 함께 연회장으로 가시죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 아마기의 성에 잘 오셨습니다. 근심은 잊고 마음 가는 대로 편하게 머물다 가세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/login.ogg"},"실패":null,"우편":{"voiceline":"지휘관님, 우편입니다. 아…… 괜찮으시면 이대로 함께 옥좌에서 확인해 주셨으면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/mail.ogg"},"임무":{"voiceline":"새로운 임무로군요. 걱정하실 거 없어요. 아마기도 함께할 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 걱정할 필요 없습니다. 임무는 모두 완수했으니, 여기서 느긋하게 쉴 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"응? 지휘관님께서 어떤 마음이신지 아마기, 왠지 알 것 같아요. 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/touch.ogg"},"터치2":{"voiceline":"으음…… 지휘관님…… 아마기, 더는 참지 않아도… 되는 거겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/touch2.ogg"},"입수시":{"voiceline":"지휘관님, 어서 오세요. 기다렸답니다. 크흠, 후후… 꿈의 성에 오신 걸 환영합니다. 이 옥좌는 저와… 그리고 당신을 위한 것이기도 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"열리지 않는 방의 열쇠는 아마기가 전부 가지고 있답니다. 계속 탐색하고 싶으시면 아마기의 소원을 들어주셔야 해요. ……소원 하나에 열쇠 하나, 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307151/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":71044,"상점 카테고리 id":7,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1180,"기간":"한정 (2025/10/15)","진영":"IJN","레어도":"UR","ex_chat_status":0},{"클뜯 id":307158,"클뜯 함순이 id":30715,"함순이 이름":"아마기(항공모함)","한글 함순이 + 스킨 이름":"물빛 달의 화촉","영문 함순이 + 스킨 이름":"Moonlit Blossom on Placid Seas","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307158/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307158/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307158/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307158/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307158/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307158/shipyard.png","설명":"「기쁠 때나, 슬플 때나, 건강할 때나, 병들었을 때도……」 ——지휘관님? 후후, 무슨 흉조 같은 건 아니랍니다. 이제 더 이상 「당신의 아마기」는 그런 것들에 마음 쓰지 않아요.","자기소개":null,"메인1":{"voiceline":"지휘관님, 마침 좋은 타이밍이니, 잠시 휴식을 취하시고 모든 일은 아마기에게 맡겨주세요. 이 또한 「내조지공」으로서 지휘관님께 보답하는 길이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/main1.ogg"},"메인2":{"voiceline":"다음 수는……휴우, 역시 지휘관님께는 당해낼 수가 없네요. 오늘도 많은 걸 배웠어요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/main2.ogg"},"메인3":{"voiceline":"(꼬르륵~) 이런… 지휘관님의 저녁 식사를 고민하다가 배가…… 죄송합니다. 또 이런 부끄러운 모습을……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관님께서 변하지 않으시더라도 아마기는 바뀌고 싶어요. 지휘관님 곁에 머무를 자격을 갖출 수 있도록, 모두를 오랫동안 지킬 수 있도록… 조금씩, 자신을 바꾸고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/detail.ogg"},"드랍 설명":{"voiceline":"「기쁠 때나, 슬플 때나, 건강할 때나, 병들었을 때도……」 ——지휘관님? 후후, 무슨 흉조 같은 건 아니랍니다. 이제 더 이상 「당신의 아마기」는 그런 것들에 마음 쓰지 않아요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"봄 꽃, 여름 비, 가을 단풍, 겨울의 눈…… 미래로 향하는 먼 길을 함께 걸으며, 함께 사계절을 보낼 수 있다면, 이 아마기… 그 무엇보다 행복할 거예요. 지휘관님, 늘 곁에서 함께할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/feeling5.ogg"},"터치3":{"voiceline":"어머나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/headtouch.ogg"},"모항귀환":{"voiceline":"귀환은 당연한 일이니, 그렇게 축하할 필요는 없다…고요? 후후, 그럼 지휘관님께서 무사하신 걸 축하하도록 하죠. 아마기에게는 그쪽이야말로 훨씬 더 기쁜 일이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요, 지휘관님. 후후, 그럼 아마기가 오늘 드실 잔을…… 네, 눈치채신 것처럼 며칠 전에 함께 고른 그 찻잎이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님, 아마기를 이끌어주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/touch.ogg"},"터치2":{"voiceline":"지휘관님도 참… 짓궂으셔라…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/touch2.ogg"},"입수시":{"voiceline":"「기쁠 때나, 슬플 때나, 건강할 때나, 병들었을 때도……」 ——지휘관님? 후후, 무슨 흉조 같은 건 아니랍니다. 이제 더 이상 「당신의 아마기」는 그런 것들에 마음 쓰지 않아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"훌륭한 지휘였어요. 이제 이 승리를 발판 삼아, 다음 승리로 이어 나가요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307158/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"일상 업무에 전투, 모두를 돌보는 일까지…… 감히 한 말씀 드리자면, 지휘관님… 지금은 아마기의 건강을 걱정하기보다는 자기 몸부터 챙기셔야 하지 않을까요…?","voicelink":"https: