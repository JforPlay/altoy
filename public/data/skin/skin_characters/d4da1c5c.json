[{"클뜯 id":101090,"클뜯 함순이 id":10109,"함순이 이름":"플레처","한글 함순이 + 스킨 이름":"플레처","영문 함순이 + 스킨 이름":"Fletcher","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101090/shipyard.png","설명":"플레처급 구축함·플레처 (DD-445)","자기소개":{"voiceline":"플레처급 구축함, 175자매의 장녀인, 플레처예요─! 구축함대의 주력으로서, 여러 전투에 참여했답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/profile.ogg"},"메인1":{"voiceline":"저번에 저를 가장했던 가짜에게, 여동생은 저희 자매함 전원의 이름을 말하도록 시켰어요. 그랬더니 상대 쪽이 무너져버렸지 뭐예요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/main1.ogg"},"메인2":{"voiceline":"여동생들을 볼 때마다… 저희 가족이 혹시 토끼가 아닐까 하는 생각이 들어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/main2.ogg"},"메인3":{"voiceline":"지휘관 씨? 정말이지… 또 다른 여동생들 생각하고 계셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/main3.ogg"},"전투개시":{"voiceline":"상대는 고작 몇 척일 뿐이에요~ 머릿수로 밀어붙이도록 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/battle.ogg"},"상세확인":{"voiceline":"저, 꽤 빠르니까 아마도 피탄당하거나 하진 않을 거랍니다? 에… 뭐 조금 정도 피탄당하더라도 괜찮…으려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함·플레처 (DD-445)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 완료했어요. 다음 할 일은… 음, 여동생들 수와 비슷할 만큼 산더미처럼 쌓여있네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/expedition.ogg"},"실망":{"voiceline":"죄, 죄송해요. 여동생들을 보살펴야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/feeling1.ogg"},"낯섦":{"voiceline":"후… 여동생들을 보살피지 않으면 안 되니까, 다른 걸 생각하고 있을 시간이 잘 나지 않게 되네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/feeling2.ogg"},"호감":{"voiceline":"지휘관 씨, 죄송해요. 잠시 도와주세요── 감사드려요. 역시 지휘관 씨는 힘이 좋네요… 조금 부러워요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/feeling3.ogg"},"기쁨":{"voiceline":"이렇게나 많은 자매함들 중에서, 지휘관 씨는… 어떤 아이가 가장 마음에 드시나요?\n…저, 저도 포함해서요… (소곤)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/feeling4.ogg"},"사랑":{"voiceline":"네? 여동생들을 보살피는 걸 도와주신다고요? 그, 그래도, 여동생이 너무 많아서 저도 가끔 곤란하다구요? 정말, 정말로 괜찮으신가요? 그럼… 잠시… 생각 좀 해봐도 될까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"다녀왔어요~ 어라? 제가 없는 사이에 또 여동생이 늘어나 버렸나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 씨, 오늘은 저를 쉽게 알아보실 수 있으셨나요? 여동생들과는 다르답니다~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/login.ogg"},"실패":{"voiceline":"우으… 심술쟁이… 여동생들에게 들키면 그냥 넘어가진 못할 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/lose.ogg"},"우편":{"voiceline":"지휘관 씨는 언제나 누구한테서 편지를 받고 계신 건가요? 조금 신경쓰여요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/mail.ogg"},"임무":{"voiceline":"또 여동생들과 함께 임무를 수행할 수 있겠어요. 지휘관 씨, 명령을 내려주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/mission.ogg"},"임무완료":{"voiceline":"보너스, 여동생들 전원의 몫만큼 있으려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/mission_complete.ogg"},"서약":{"voiceline":"가족 말인가요… 여동생은 잔뜩 있지만, 그래도 역시 지휘관 씨는 특별하답니다♪… 후훗♪ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/propose.ogg"},"스킬":{"voiceline":"여동생들아, 내게 힘을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/skill.ogg"},"터치1":{"voiceline":"여동생들도 분명 이런 거 마음에 든다고 생각할 거예요── 네? 그렇게 많이 만지면 손이 아프시다고요?…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/touch.ogg"},"터치2":{"voiceline":"지, 지휘관 씨 그만둬주세요! 여동생들이 봤다가는…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/touch2.ogg"},"입수시":{"voiceline":"네? 어디선가 만났, 었나요? 어머… 그런가요… 사실 이 세상에는, 저와 닮은 소녀가 100명 이상 있답니다~ 잘 부탁드려요, 지휘관 씨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/unlock.ogg"},"강화성공":{"voiceline":"이걸로 좀 더 여동생을 보살펴줄 수 있겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"별을 15개 모으면, 어떤 소원이라도 딱 하나 이루어준다고 해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0}]