[{"클뜯 id":102010,"클뜯 함순이 id":10201,"함순이 이름":"오마하","한글 함순이 + 스킨 이름":"오마하","영문 함순이 + 스킨 이름":"Omaha","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102010/shipyard.png","설명":"오마하급 경순양함·오마하 (CL-4)","자기소개":{"voiceline":"에헴! 오마하 등장! 전전 대전 후에 태어났지만 선발함으로서 정보를 가득 가지고 돌아갔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/profile.ogg"},"메인1":{"voiceline":"아아… 배고파졌다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/main1.ogg"},"메인2":{"voiceline":"지휘관은 간식 안 먹는 거야? 재미없는 인생이네─","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/main2.ogg"},"메인3":{"voiceline":"지휘관은 배고파졌어? 뭔가 기운이 없다는 얼굴 하고 있어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/main3.ogg"},"전투개시":{"voiceline":"배 채운 나는 무적이니까! 너덜너덜해질 때까지 돌려보내지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/battle.ogg"},"상세확인":{"voiceline":"지휘관! 배, 배는 안 나왔다고── 아아! 보지마아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/detail.ogg"},"드랍 설명":{"voiceline":"오마하급 경순양함·오마하 (CL-4)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관 여기 보면 안 돼~ 의뢰 보수로 간식이 붙어 있으면 나라도 노력한다고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/expedition.ogg"},"실망":{"voiceline":"먹을 거? 오마하는 가지고 있으니까, 지휘관에게 폐를 끼치지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/feeling1.ogg"},"낯섦":{"voiceline":"끄응? ──오마하는 밥할 줄 아는 사람이 취향이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/feeling2.ogg"},"호감":{"voiceline":"끄으…… 조, 조금 살집이 있는 편이 귀여운걸! 지휘관도 그렇게 생각하지!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/feeling3.ogg"},"기쁨":{"voiceline":"다이어트 할까…… 뭐야! 좋아하는 사람을 위해서 다이어트 하는 건 평범하잖아! 그리고, 딱히 살찐 거 아니거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/feeling4.ogg"},"사랑":{"voiceline":"오마하가 다이어트에 실패하면 그건 분명 지휘관 탓이야! 책임져! 어떻게 지냐고? 그, 그거야 물론… 오마하를 평생 길러줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관! 밥으로 할 거야? 밥으로 할래? 아니면~ 밥할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 씨~오늘은 오마하에게 맡길 재미있는 일 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/login.ogg"},"실패":{"voiceline":"아와왓! 한가득 먹고 나서 다시 돌려주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/lose.ogg"},"우편":{"voiceline":"편지다! 어제 지른 간식이 도착한 걸까나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/mail.ogg"},"임무":{"voiceline":"흐에? 임무? 이 감자칩 다 먹고 나서…… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/mission.ogg"},"임무완료":{"voiceline":"이 우수한 오마하 님에게 포상으로 간식을~! …다이어트 따윈 내일 해도 되는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/mission_complete.ogg"},"서약":{"voiceline":"에헤헤. 벌써 정해진 거지? 지휘관은 요리 담당에, 오마하는…… 오마하는 집안일! 응응! 밥도 먹을 수 있고 다이어트도 할 수 있어! 오마하 현명해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/propose.ogg"},"스킬":{"voiceline":"큰일났다! 간식이 섞였어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/skill.ogg"},"터치1":{"voiceline":"믓…… 배가 나온다? No! 미식가를 추구하는 길은 절대 포기하지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/touch.ogg"},"터치2":{"voiceline":"살쪘는지 확인한다~ 가 아니잖아! 이 에로 지휘관~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/touch2.ogg"},"입수시":{"voiceline":"오마하급 경순양함 오마하야! 안녕, 지휘관~ 실은 나, 함대의 고참이거든~ 흐흥~ 그런데, 만난 기념으로 뭔가 축하 선물이라든가 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/unlock.ogg"},"강화성공":{"voiceline":"강해졌지만, 또 배고파졌네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"예이! 내 무기로 뚫지 못할 장갑은 없도다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"N","ex_chat_status":0}]