[{"클뜯 id":9706010,"클뜯 함순이 id":970601,"함순이 이름":"히요·META","한글 함순이 + 스킨 이름":"히요·META","영문 함순이 + 스킨 이름":"Hiyou META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706010/shipyard.png","설명":"흐하하하하, 이 항공모함 히요를 아군으로 들이다니, 너도 꽤 하는 녀석이로군. 그래서? 이 다음에 쓰러트릴 적은 어디있지?","자기소개":{"voiceline":"히요급 항공모함 히요다. 히요급은 경항공모함으로 분류되지만, 정규 항공모함으로 취급해도 상관 없다. 걱정 마라, 실망은 시키지 않겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/profile.ogg"},"메인1":{"voiceline":"준요 말인가? ……지금은 괜찮다. 내가 걱정할 만한 소식은 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/main1.ogg"},"메인2":{"voiceline":"공격은 최대의 방어다. 당하기 전에 해치우라는 거지. 지휘관도 같은 생각이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/main2.ogg"},"메인3":{"voiceline":"계속 서류 작업만 하면 실력이 녹슨다. 지휘관, 다음 출격 일정은 언제지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/main3.ogg"},"전투개시":{"voiceline":"좋아, 이대로 적진을 휘저어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/battle.ogg"},"상세확인":{"voiceline":"가만히 있을 순 없어……! 지휘관! 세이렌이 출몰했다는 정보는 없나?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/detail.ogg"},"드랍 설명":{"voiceline":"히요호 항공모함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 완료한 건가? 어디 보자……. 꽤 물자를 잘 받아온 모양이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/expedition.ogg"},"실망":{"voiceline":"이런 나약한 자가 지휘관이라니…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/feeling1.ogg"},"낯섦":{"voiceline":"적을 모두 쓰러트려 살아남을 뿐, 전장이란 이토록 간단한 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/feeling2.ogg"},"호감":{"voiceline":"붕대? ……아니, 이 정도로는 전투에 지장을 주지 않는다. 걱정하지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관은 모두를 이끌고 방향을 제시한다. 나는 방해되는 자를 제거한다. 그래야 한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 하고 싶은 걸 하면서, 목표로 착실히 나아가면 된다. 나는 그 곁에서 함께 싸울 수 있는 것만으로도 충분하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/feeling5.ogg"},"터치3":{"voiceline":"몇 초 후에 지휘관이 어떻게 될지는 장담 못하겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/headtouch.ogg"},"모항귀환":{"voiceline":"돌아온 건가. 좋아, 다음 출격에 대해 이야기를 나누자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/home.ogg"},"hp 경고":{"voiceline":"이런 것쯤은…… 상처 축에도 못 낀다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/hp_warning.ogg"},"로그인":{"voiceline":"더는 기다릴 수 없다! 지휘관, 출항 준비는 끝났다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/login.ogg"},"실패":{"voiceline":"이럴 순 없다! 다음에는 네놈들 모두 마구 베주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/lose.ogg"},"우편":{"voiceline":"자, 지휘관에게 온 편지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/mail.ogg"},"임무":{"voiceline":"임무다. 세이렌에 관한 거라면 맡겨두라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/mission.ogg"},"임무완료":{"voiceline":"좋아, 임무 완료다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/mission_complete.ogg"},"서약":{"voiceline":"지휘관이 건네는 나와의 약속……이라. 후훗, 하하하하……. 아니, 이건 기쁘다기보단, 어떻게 대답을 해야 할지 모르겠군. ……그래, 적을 쓰러트리는 것으로 답을 대신하는 건 어떻나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/propose.ogg"},"스킬":{"voiceline":"아하하하하! 멸해주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/skill.ogg"},"터치1":{"voiceline":"세이렌 관련 정보가 들어왔나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/touch.ogg"},"터치2":{"voiceline":"이 장갑이 별로 화려하지 않다는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/touch2.ogg"},"입수시":{"voiceline":"흐하하하하, 이 항공모함 히요를 아군으로 들이다니, 너도 꽤 하는 녀석이로군. 그래서? 이 다음에 쓰러트릴 적은 어디있지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/unlock.ogg"},"강화성공":{"voiceline":"준비 운동으로 딱 좋은 적 어디 없나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후후, 괜찮은 전투였다고 말해주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"META