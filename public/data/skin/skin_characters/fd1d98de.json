[{"클뜯 id":103250,"클뜯 함순이 id":10325,"함순이 이름":"볼티모어(μ장비)","한글 함순이 + 스킨 이름":"볼티모어(μ장비)","영문 함순이 + 스킨 이름":"Baltimore μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103250/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103250/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103250/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103250/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103250/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103250/shipyard.png","설명":"이글 유니온 중순양함, 볼티모어다. 아, 이번에는 작전함 뿐만 아니라 \"아이돌\"의 신분으로 왔지. 후후, 기왕 시작했으니 최선을 다 해보자고! 그러면 지휘관의 응원 부탁해.","자기소개":{"voiceline":"나는 중순양함 볼티모어, μ장비 테스트의 일환으로 현재 아이돌 활동 중이지. 온 힘을 다해서 모두를 위해 최고의 공연을 선보이겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/profile.ogg"},"메인1":{"voiceline":"아이돌 활동으로 바빠서 외부 활동은 거의 손을 놓았네. 지휘관, 나 대신 상황을 봐줄 수 있겠어? 고마워! 후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/main1.ogg"},"메인2":{"voiceline":"이 안무… 로열의 아가씨들에게는 부담이 좀 크겠는데… 지휘관은 어떻게 생각해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/main2.ogg"},"메인3":{"voiceline":"큐, 큐트 노선은 나에게는 조금…… 싫, 싫은 건 아니지만 만약 지휘관이 그쪽을 좋아한다면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/main3.ogg"},"전투개시":{"voiceline":"난 단지 지나가는 아이돌이다… 역시 조금 이상한 것 같아, 하하. 됐어, 가자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/battle.ogg"},"상세확인":{"voiceline":"먼저 이렇게… 그리고 이렇게…! 후…… 아, 신곡 안무를 짜는 중이야. 나 말고 다른 멤버들의 무대 퍼포먼스도 생각해야 하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/detail.ogg"},"드랍 설명":{"voiceline":"이글 유니온 중순양함, 볼티모어다. 아, 이번에는 작전함 뿐만 아니라 \"아이돌\"의 신분으로 왔지. 후후, 기왕 시작했으니 최선을 다 해보자고! 그러면 지휘관의 응원 부탁해.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료야. 지휘관, 동료들을 마중하러 갈 때 공연을 하면 어떨까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/expedition.ogg"},"실망":{"voiceline":"이렇게 자신을 윽박질러선 모두를 이끌 수 없어. 조금 긴장을 풀도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/feeling1.ogg"},"낯섦":{"voiceline":"지휘관이 짜준 스케쥴대로 움직일게. 지금까지랑 별로 달라지는 것도 없네. 하하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/feeling2.ogg"},"호감":{"voiceline":"지휘관, 이 의상 어때? 어머, 여기에 스위치… 역, 역시 이렇게 하는 게 더 귀여워 보이겠지…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/feeling3.ogg"},"기쁨":{"voiceline":"\"응원 고마워~! \" …브레머튼이 말한 것처럼 약간 위화감이 있네… 지휘관, 내가 다른 멤버들이랑 안 맞는 것은 아니겠지? 난 정말 귀여워질 수 있는 걸까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/feeling4.ogg"},"사랑":{"voiceline":"지휘관을 보고 있을 때 가장 귀엽다고? 그, 그런가… 어쨌든 조금은 방향을 잡은 것 같아! 미안, 지휘관. 스테이지에서 좀 더 빛날 수 있게 같이 특훈을 해줄 수 있을까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔나. 무대는 역시 관객이 있어야 빛나지. 모두가 안전하게 돌아와서 우리의 공연을 봐줬으면 좋겠어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/home.ogg"},"hp 경고":{"voiceline":"이정도로는 나를 멈출 수 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘은 뭘 해야하지? 평상시처럼 스케쥴 계획은 맡겨둘게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/login.ogg"},"실패":{"voiceline":"리허설을 다시 해야 하는 것 아닌지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/lose.ogg"},"우편":{"voiceline":"고마워, 다이도. 큰 도움이 됐어. 지휘관, 우편이 왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/mail.ogg"},"임무":{"voiceline":"임무인가… 우리가 아이돌 활동으로 바쁠 때에도 지휘관은 계속 임무를 처리해야 하는 군… 정말 수고가 많아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 도착했어. 작은 기관은 알바코어에게 정리하도록 말해뒀으니 걱정하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 모두와 함께 최고로 멋지고, 최고로 빛나는 무대에 서겠다고 약속할게! 그리고… 지휘관이 나를, 지휘관에게 있어서 가장 귀여운 나를 봐줬으면 좋겠어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/propose.ogg"},"스킬":{"voiceline":"우리의 노래를 온 사방에!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/skill.ogg"},"터치1":{"voiceline":"시그니처 동작은 이렇게 하는 게 좋을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/touch.ogg"},"터치2":{"voiceline":"아?! 뭐 하는 거지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/touch2.ogg"},"입수시":{"voiceline":"이글 유니온 중순양함, 볼티모어다. 아, 이번에는 작전함 뿐만 아니라 \"아이돌\"의 신분으로 왔지. 후후, 기왕 시작했으니 최선을 다 해보자고! 그러면 지휘관의 응원 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/unlock.ogg"},"강화성공":{"voiceline":"덕분에 살았어~ 다음 무대를 기대해도 좋아! 아마도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/upgrade.ogg"},"vote":null,"승리":{"voiceline":"나를 선택한 것을 후회하지 않게 해주겠다고 했잖아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103250/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함