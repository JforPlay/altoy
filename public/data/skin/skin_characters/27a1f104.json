[{"클뜯 id":408070,"클뜯 함순이 id":40807,"함순이 이름":"U-522","한글 함순이 + 스킨 이름":"U-522","영문 함순이 + 스킨 이름":"U-522","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408070/shipyard.png","설명":"메탈 블러드 IXC형 잠수정U-522 ","자기소개":{"voiceline":"저는 IXC급 원양 잠수정 U-522입니다. 영광스러운 제 2잠수정 함대에 소속되어 있습니다. 장거리 무역 통상 파괴 작전이 제 주특기지만 반잠수함 호위함을 상대하는건 역시 좀 아파요~어쨌든 제 활약을 기대해 주세요~ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/profile.ogg"},"메인1":{"voiceline":"이 \"꼬리\"는 장식이 아니라고? 함장이랑 연결하고 제어하는건 다 그거에 달렸어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/main1.ogg"},"메인2":{"voiceline":"지휘관, 내 전투하는 모습을 잘 감상해 봐~헤헤","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/main2.ogg"},"메인3":{"voiceline":"나한테 습격당한 적들이 바다 위에서 허둥지둥 하는 모습 좀 봐, 정말 웃겨~하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/main3.ogg"},"전투개시":{"voiceline":"어? 왔다~ 여러분, 또 \"만찬\"의 시간이 왔어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/battle.ogg"},"상세확인":{"voiceline":"흐흠~지휘관님, 방금 또 저 훔쳐봤죠? 이미 다 알고 있었거든요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/detail.ogg"},"드랍 설명":{"voiceline":"메탈 블러드 IXC형 잠수정U-522","voicelink":null},"의뢰 완료":{"voiceline":"어? 의뢰팀이 무사 귀환했네요~ 뭔가 재밌는 수확이 없었는지 어서 가봐요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/expedition.ogg"},"실망":{"voiceline":"정말 능력 없는 지휘관이라니까요~근데...무능력한 지휘관도...좀 귀여운 듯도 하고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/feeling1.ogg"},"낯섦":{"voiceline":"즐거운 원양 사냥이 하고 싶은데 좋은 조수가 없으면 안돼요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/feeling2.ogg"},"호감":{"voiceline":"으흠? 꽤 하시네요~우리 앞으로 꽤나 괜찮은 신뢰 관계를 쌓을 수 있겠는걸요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 제 앞에서는 꾀 부리셔도 소용 없답니다? 지휘관님이 무슨 생각을 하셔도 십중팔구 다 알 수 있다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/feeling4.ogg"},"사랑":{"voiceline":"우린 좀 더 서로를 알 필요가 있을 것 같아요~그렇지 않나요? 지.휘.관.님?하하하하! 지휘관님 얼굴이 잘 익은 사과같아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오~ 지휘관님 돌아오셨군요. 제 쇠고기 통조림 좀 드셔보실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/home.ogg"},"hp 경고":{"voiceline":"상대편 꽤나 수완이 좋네요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님을 다시 만날 수 있어서 기뻐요, 오늘은 심심하지 않겠네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/login.ogg"},"실패":{"voiceline":"아, 조용히 하려 했는데 실수가...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/lose.ogg"},"우편":{"voiceline":"지휘관님, 사령부에서 온 연락입니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/mail.ogg"},"임무":{"voiceline":"새로운 임무가 왔어요. 재미있는 사냥 임무가 있을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 이번 임무 보상은 꽤 많아요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/mission_complete.ogg"},"서약":{"voiceline":"이렇게 쉽게 마음을 들키다니...지휘관의 앞날이 정말 걱정이라니까~하지만 괜찮아, 앞으로 내가 쭉 곁에 있어줄 테니까 마음껏 의지하라고~ 히힛~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/propose.ogg"},"스킬":{"voiceline":"피어나라, 승리의 번개(Blitz)!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/skill.ogg"},"터치1":{"voiceline":"저랑 즐거운 수중 숨바꼭질 할래요? 최후의 승자는 당연히 제가 되겠죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/touch.ogg"},"터치2":{"voiceline":"꼬리는 안돼요! 민감하다고요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/touch2.ogg"},"입수시":{"voiceline":"흐음~? 당신이 이곳의 지휘관인가요? 전 메탈 블러드 소속의 원양 잠수함 U-522랍니다. 이 항구에서 재미있는 일이 있으려나요? 정말 기대되네요, 헤헷","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/unlock.ogg"},"강화성공":{"voiceline":"sehr gut!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이렇게 끝난다니, 너무 약하잖아요~아직 덜 놀았는데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0}]