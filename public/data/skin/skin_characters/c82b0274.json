[{"클뜯 id":703020,"클뜯 함순이 id":70302,"함순이 이름":"쿠르스크","한글 함순이 + 스킨 이름":"쿠르스크","영문 함순이 + 스킨 이름":"Kursk","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703020/shipyard.png","설명":"중순양함 - 쿠르스크","자기소개":{"voiceline":"머나먼 북쪽 설원의 사냥꾼 쿠르스크다……. 너무 짧다고? 흥, 귀찮게 하는군. ……무리지어 다니는 건 선호하지 않는다. 사이좋게 지내려면 거리를 두는 게 좋을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/profile.ogg"},"메인1":{"voiceline":"고독은 사냥꾼의 천성, 연약한 사냥감들만이 무리지어 다니지. 사냥꾼인 내가 혼자인 것도 바로 그래서다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/main1.ogg"},"메인2":{"voiceline":"'전술' 말인가? 번잡스러울뿐이다……. 나는 직감으로 움직인다. 그까짓 것에 얽매일 수는 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/main2.ogg"},"메인3":{"voiceline":"눈인가, 내가 좋아하는 날씨다. 발자국을 더 쉽게 숨길 수 있도록 해주지. ……그래, 바로 매복을 하기 위해서다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/main3.ogg"},"전투개시":{"voiceline":"쿠르스크, 행동 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/battle.ogg"},"상세확인":{"voiceline":"단독 행동에는 익숙하다. 눈이 없는 모항에서도 내 행적은 감출 수 있다……. 내가 마음만 먹는다면 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 - 쿠르스크","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 무사히 완료됐군. 소란스러운 뒤풀이는 너만 가면 되겠지. 나는 패스하마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/expedition.ogg"},"실망":{"voiceline":"떨어져라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/feeling1.ogg"},"낯섦":{"voiceline":"칼날은 갈지 않으면 무뎌지지. ……지금도 때때로 설원으로 돌아가 예전처럼 사냥을 하고는 한다. 칼날뿐만 아니라 송곳니도, 스스로 자신을 갈고 닦기 위해서다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/feeling2.ogg"},"호감":{"voiceline":"한 마리 늑대라고 하기 보다는 무리를 짓지 않도록 신경 쓰고 있달까. 냉철함, 그리고 잔혹함이야말로 내 행동 수칙인 이상, 겁쟁이나 나약한 자와 무리 짓지 않는 것이 그들을 위한 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/feeling3.ogg"},"기쁨":{"voiceline":"차갑다는 말을 자주 듣는다만…… 사소한 감정 변화에는 그다지 신경을 쓰지 않는 주의다. 서로 그런 사소한 것에 얽매여봤자 시간 낭비겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/feeling4.ogg"},"사랑":{"voiceline":"고독에는 익숙할 터인데, 너와 함께 있을 때는 이상하게도 무리를 지어 모일 때의 혐오감이 느껴지지 않는군. 나는…… 생각지도 않게 네 영향을 받은 거겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/feeling5.ogg"},"터치3":{"voiceline":"친한척 굴기는……. 이해할 수 없는 녀석이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/headtouch.ogg"},"모항귀환":{"voiceline":"아, 너로군. ……이겼나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/home.ogg"},"hp 경고":{"voiceline":"생사의 갈림길에서 방황하는 즐거움…. 더 보여줘라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이다. …외출 전에 메모라도 남겨둘 셈이였다만, 그래도 이렇게 두목인 네게 직접 말 해두는 편이 좋겠다는 생각이 들어서 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/login.ogg"},"실패":{"voiceline":"크윽…… 내 Охота(사냥)은 여기서 끝나지 않는다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/lose.ogg"},"우편":{"voiceline":"네 앞으로 온 우편은 책상에 뒀다. 내용물에는 관심없다. 네가 직접 확인해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/mail.ogg"},"임무":{"voiceline":"새 임무에 내 도움이 필요하다고……? 그럼, 넌 쉬어라. 공동 작업은 익숙하지 않으니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 온 모양이군. 확인해 둬라. 네 고생에 걸맞은 평가이자 포상이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/mission_complete.ogg"},"서약":{"voiceline":"……진심인가? 고독한 설원을 달리는 늑대인 나를…… 후후후, 네가 나를 길들일 생각이라면, 어디 그 솜씨 좀 봐야겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/propose.ogg"},"스킬":{"voiceline":"찢어주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/skill.ogg"},"터치1":{"voiceline":"급한 볼일인가? ……너만 괜찮다면, 내게 맡기도록 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/touch.ogg"},"터치2":{"voiceline":"뭐하는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/touch2.ogg"},"입수시":{"voiceline":"네가 여기 두목인가? 좋다. 그렇다고 내 행동을 구속할 생각은 접어둬라. 내 가치는 머지않아 스스로 증명해 보이마. 그게 다다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/unlock.ogg"},"강화성공":{"voiceline":"힘이 가득 차오르는 이 기쁨…… 중독될 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"휴우…… 화약 연기, 그리고 승리. 즐겁군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"날 보러 온 건가? 음, 네게 발자취를 감출 필요는 없겠군. …나도 네가 보고 싶던 참이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":{"voiceline":"꼭 해야 겠다면…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"킁킁. 전장의 화약 연기 냄새……. 피 냄새는 안 나는 것 같군. 다치지 않아서 다행이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 와라. 오늘은 어디로 갈 텐가? 우선은… 일부터? 뭐, 좋지. 여기서 기다려주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"새로운 임무다. 나도 협력하마. ……내 방식대로 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 완료다. 흠, 호흡이 점점 잘 맞는 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"여기 있다. 난 눈치 보는 건 서투르다. 부탁이 있으면 직접 말해줬으면 좋겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/touch_ex.ogg"},"터치2_ex":{"voiceline":"누가 사냥꾼이고 누가 사냥감인지 가르쳐줘야겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['론'] :  위험한 냄새…… 재미있는 녀석이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/couple_encourage1.ogg"},{"voiceline":"['미니애폴리스', '헌터'] :  사냥꾼만 모여선 사냥감이 모자라고 말겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"노스 유니온의 술자리? 술을 못 마시는 건 아니지만, 그저…… 뭐, 됐다. 네 체면 살려주는 셈 치고 나가주마. 말문이 막혔을 땐 알아서 잘 부탁한다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/main5_ex.ogg"},"메인6_ex":{"voiceline":"지금도 기억 속 하얀 설원과 산골짜기가 그립군. …너만 괜찮다면, 다음에 둘이 같이 보러 가자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"내게는 내 나름의 방식이 있다. …필요하다면 네 지휘를 따르마. 네 판단을 믿으니까 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703020/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":703021,"클뜯 함순이 id":70302,"함순이 이름":"쿠르스크","한글 함순이 + 스킨 이름":"수증기 속의 고독한 늑대","영문 함순이 + 스킨 이름":"Lone Wolf Amid the Steam","스킨 타입":"Hot Springs","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703021/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703021/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/703021/shipyard.png","설명":"뜨거운 탕인가? 조금 신선하군. 네 자리는 비워뒀으니 어서 이쪽으로……. 아직도 옷 안 벗고 뭐하는 거지?","자기소개":null,"메인1":{"voiceline":"온천 애호가가 제일 많은 건 사쿠라 엠파이어지. 같이 온천에 몸을 담그는 게 싫지는 않다만, 너도 알잖는가…… 난 무리 짓는 게 영 서툴러서 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/main1.ogg"},"메인2":{"voiceline":"차가운 공기를 덮고 있는 하얀 김…… 앞을 내다볼 수 없는 이곳은 절호의 매복 장소라고 할 수 있겠지. ……후후, 걱정 마라. 내가 여기 있으니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/main2.ogg"},"메인3":{"voiceline":"온도는 어떤가? 아직 미지근하다면 이 의장으로 좀 더 온도를 올려주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/main3.ogg"},"전투개시":{"voiceline":"이대로 나가도 문제 없다! 쿠르스크, 행동개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/battle.ogg"},"상세확인":{"voiceline":"……춥지 않냐고? 딱히 아무렇지도 않다. 온천은 커녕 빙하에 뛰어들어도 아무렇지 않다만……. 너야말로 온천에 들어갔다고 밤바람에 방심 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/detail.ogg"},"드랍 설명":{"voiceline":"뜨거운 탕인가? 조금 신선하군. 네 자리는 비워뒀으니 어서 이쪽으로……. 아직도 옷 안 벗고 뭐하는 거지?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"어디 갔다 온 건가? …너무 오래 들어가 있으면 현기증 날까봐 그런 건가? 괜찮다. 현기증이 나면 내가 안고 돌아가면 될 일이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"흠…… 기분 좋군. 지휘관, 거기서 멍하니 서서 뭐하는 건가? 어서 들어와라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/login.ogg"},"실패":{"voiceline":"온기에 너무 빠져있었던 탓인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/lose.ogg"},"우편":{"voiceline":"우편은 물기가 없는 곳에 두고 왔다. 중요한 서류를 젖게 할 수는 없으니 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/mail.ogg"},"임무":{"voiceline":"새로운 임무가 온 것 같군. ……확인하고 오자. 쉬는 건 조금 뒤로 미뤄도 되겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"다른 사람과 붙어 있는 건 질색이다. ……너라면 아마 괜찮겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/touch.ogg"},"터치2":{"voiceline":"좀 더 가까이 붙어보지 않겠나? …후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/touch2.ogg"},"입수시":{"voiceline":"뜨거운 탕인가? 조금 신선하군. 네 자리는 비워뒀으니 어서 이쪽으로……. 아직도 옷 안 벗고 뭐하는 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703021/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"h