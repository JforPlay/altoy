usercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703022/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"할 말이 있으면 그 자리에서 직접 말하는 편이다만…… 그래, 네가 정 그렇다면…… 중순양함 쿠르스크, 지금 혼자 이스트 글림의 드레스 차림으로 집무실에 있는데… 지휘관, 이제 뭘 하면 되지?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"새로운 방법을 취하는 것도 재미있군. 다만 이제부터가 시작이다. 누가 사냥감이고 누가 사냥꾼인지…… 그 대답은 곧 알게 되겠지. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703022/feeling5.ogg"},"터치3":{"voiceline":"……머리를 쓰다듬고 싶으면 직접 말해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703022/headtouch.ogg"},"모항귀환":{"voiceline":"음, 목소리는 어디가 다친 것 같지는 않군… 이기고 지는 것보다 네가 무사한 편이 더 기쁘다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703022/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 와라. 이다음 뒤풀이 인원에서 나는 빼도 된다. …그래, 내가 신경 쓰이면 이렇게 전화로 확인하면 될 일이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703022/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"말이나 행동이나 모두 솔직한 편이 바람직하지. 하고 싶은 게 있다면 직접 내게 말해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703022/touch.ogg"},"터치2":{"voiceline":"호오, 포즈를 바꿔 달라고? …상관없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703022/touch2.ogg"},"입수시":{"voiceline":"할 말이 있으면 그 자리에서 직접 말하는 편이다만…… 그래, 네가 정 그렇다면…… 중순양함 쿠르스크, 지금 혼자 이스트 글림의 드레스 차림으로 집무실에 있는데… 지휘관, 이제 뭘 하면 되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/703022/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":nul