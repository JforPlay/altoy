[{"클뜯 id":10700040,"클뜯 함순이 id":1070004,"함순이 이름":"미우라 아즈사","한글 함순이 + 스킨 이름":"미우라 아즈사","영문 함순이 + 스킨 이름":"Azusa Miura","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700040/shipyard.png","설명":"처음 뵙겠습니다, 미우라 아즈사라고 해요~ 음, 모항... 그리고 함선? 저기... 궁금한데 있는데... 여긴 대체 뭐하는 곳이죠?","자기소개":{"voiceline":"미우라 아즈사라고 합니다. 전문대를 졸업한 후, 인연이 닿아 아이돌이 되었습니다. 어, 아이돌을 지망하게 된 계기…… 말인가요? 그렇네요…… 누군가가 찾아주길 바래서…… 라고 할까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/profile.ogg"},"메인1":{"voiceline":"요전에 구축함 애들이 졸라대는 통에 같이 놀아준 적이 있어요. 후후후. 다들 정말 착한 애들 뿐이더라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/main1.ogg"},"메인2":{"voiceline":"전 길 외우는 게 서툴러서 자주 길을 잃어버려요. 모항 안에서도 벌써 몇 번이나 길을 잃어버려서…… 부끄러운 얘기네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/main2.ogg"},"메인3":{"voiceline":"모항 식당에는 온갖 요리가 나오네요. 전부 맛있어 보여서…… 자기도 모르게 과식해버릴 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/main3.ogg"},"전투개시":{"voiceline":"경쟁하는 건 그다지 익숙하지 아니지만…… 열심히 할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/battle.ogg"},"상세확인":{"voiceline":"저와 얘기하고 싶으시다…… 고요? 물론 괜찮다마다요. 앉아서 천천히 얘기해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/detail.ogg"},"드랍 설명":{"voiceline":"처음 뵙겠습니다, 미우라 아즈사라고 해요~ 음, 모항... 그리고 함선? 저기... 궁금한데 있는데... 여긴 대체 뭐하는 곳이죠?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 임무 나가셨던 분들이 돌아오신 모양이에요. 여러분, 수고하셨어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/expedition.ogg"},"실망":{"voiceline":"죄송해요…… 무슨 말을 해야 할지 모르겠어서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/feeling1.ogg"},"낯섦":{"voiceline":"지휘관 씨, 왜 그러시나요? ……어머? 제가 흘린 손수건 주워주셨군요. 고마워요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/feeling2.ogg"},"호감":{"voiceline":"안녕하세요, 지휘관 씨. 산책하고 있던 참인데, 길을 잃어버려서…… 숙소로 돌아가는 길은 어디인가요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/feeling3.ogg"},"기쁨":{"voiceline":"아, 지휘관 씨. 마침 잘 오셨어요…… 시간이 남아서 요리를 좀 했는데, 너무 많이 만들어버렸어요. 괜찮으시다면 드시지 않겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/feeling4.ogg"},"사랑":{"voiceline":"항상 길 안내만 맡겨서 죄송해요~ ……모항 안에서 길을 잃어버렸을 때 지휘관 씨를 보면 안심이 돼서, 그만…… 후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/feeling5.ogg"},"터치3":{"voiceline":"어머어머~ 고민거리라도 있나요, 지휘관 씨? 저로 괜찮으시다면 얘기 들어드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 지휘관씨. 휴식 겸 차와 다과는 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/home.ogg"},"hp 경고":{"voiceline":"스스로 정한 일을 해내기 전까진……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/hp_warning.ogg"},"로그인":{"voiceline":"안녕하세요, 지휘관 씨. 오늘도 힘차게 일하자구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/login.ogg"},"실패":{"voiceline":"여러분, 괜찮으신가요……? 어서 안전한 곳으로 돌아가죠……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/lose.ogg"},"우편":{"voiceline":"새로운 편지가 도착했네요. 가져다드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/mail.ogg"},"임무":{"voiceline":"어머어머, 아직 일이 남아있네요. 조금씩 끝내볼까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/mission.ogg"},"임무완료":{"voiceline":"후훗, 일이 전부 끝났네요. 고생하셨어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/mission_complete.ogg"},"서약":{"voiceline":"이곳에서 지휘관 씨와 여러분과 만난 건…… 운명인지 어떤지는 모르겠지만, 이 인연을 소중히 간직하고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/propose.ogg"},"스킬":{"voiceline":"이 노래도 마음껏 즐겨주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/skill.ogg"},"터치1":{"voiceline":"오늘의 운세는…… 아, 지휘관 씨도 점 보실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/touch.ogg"},"터치2":{"voiceline":"꺅! 지휘관 씨, 대체 무슨……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/touch2.ogg"},"입수시":{"voiceline":"처음 뵙겠습니다, 미우라 아즈사라고 해요~ 음, 모항... 그리고 함선? 저기... 궁금한데 있는데... 여긴 대체 뭐하는 곳이죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/unlock.ogg"},"강화성공":{"voiceline":"이렇게 성장할 수 있던 것도 지휘관 씨 덕분이네요. 고마워요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"끝났네요~ 여러분, 다친 데는 없나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/win_mvp.ogg"},"전투개시_ex":{"voiceline":"여러분과 함께라면 망설이지 않고 나아갈 수 있겠네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/battle_ex.ogg"},"상세확인_ex":{"voiceline":"안녕하세요, 지휘관 씨. 잠시 휴식하는 건 어떠세요? 지금 차를 끓일게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"이곳에서 제가 잘 지낼 수 있었던 건 지휘관 씨 덕분이죠. 맹하게 굴던 저를 항상 곁에서 도와주셔서, 정말 감사드려요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"바쁘신 통에 피곤하실지도 모르지만, 오늘 하루도 함께 힘내죠, 지휘관씨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"지휘관 씨, 조금만 더 하면 업무 끝이에요. 저도 같이 도와드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/mission_ex.ogg"},"임무완료_ex":{"voiceline":"고생하셨어요, 지휘관 씨. 무사히 끝나서 다행이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"지, 지휘관 씨. 어딜 만지시는 건가요…… 정말.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이겨서 다행이네요~♪ 이것도 여러분 덕분이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['아키즈키 리츠코'] : 어머~ 여긴 또 어딘지~ 리츠코 씨~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/couple_encourage1.ogg"},{"voiceline":"['키사라기 치하야'] : 치하야, 같이 힘내자","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/couple_encourage2.ogg"},{"voiceline":"['미나세 이오리'] : 어머~? 이오리, 기다려~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"매점에서 파는 맛있어 보이는 치즈…… 그걸 식빵 위에 얹어서 토스트로 만들면…… 아, 아니, 체형 유지를 위해서라도 참아야겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700040/main5_ex.ogg"},"메인6_ex":{"voice