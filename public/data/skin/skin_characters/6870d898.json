[{"클뜯 id":408090,"클뜯 함순이 id":40809,"함순이 이름":"U-96","한글 함순이 + 스킨 이름":"U-96","영문 함순이 + 스킨 이름":"U-96","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408090/shipyard.png","설명":"메탈 블러드 VIIC형 잠수함 U-96 ","자기소개":{"voiceline":"나는 메탈 블러드의 VIIC형 잠수함, 제7잠수함 편대의 U96이야. 전투 중 11번의 순찰에서 적지 않은 전과를 취득했다고 할 수 있지. 비록 마지막엔 혐오하는 비행기에게 망신을 당했어도...... 흐흥, 안심해. \"에이스\"의 실력은, 실망시키지 않을테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/profile.ogg"},"메인1":{"voiceline":"눈에 보이는 위협보다 잠복해 있는 알 수 없는 것들이 더 두렵게 하지. 맞아, 마치 우리 잠수함처럼——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/main1.ogg"},"메인2":{"voiceline":"잠항과 기다림은 우리 잠수함의 주종목이야. 하지만 앞으로 기회가 있다면, 계속 해수면 위에서 여유롭게 항행할 수 있기를 바라지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/main2.ogg"},"메인3":{"voiceline":"\"오크리프 순찰대\"라... 아주 영광스러운 명성이지, 사실 우리는 울프팩으로서 목표물을 끊임없이 사냥할 뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/main3.ogg"},"전투개시":{"voiceline":"새로운 사냥을 시작하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/battle.ogg"},"상세확인":{"voiceline":"뭐야? U보트의 출격 전 늠름한 모습에 반한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/detail.ogg"},"드랍 설명":{"voiceline":"메탈 블러드 VIIC형 잠수함 U-96","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어. 적은 우리 같은 이런 \"울프팩\"은 없는 것 같네. 정말 잘 됐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/expedition.ogg"},"실망":{"voiceline":"너 같은 사람은 바다에 상어밥으로 던져 버리는 게 딱인데. 농담이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/feeling1.ogg"},"낯섦":{"voiceline":"잠수함 작전은 사실 대부분의 시간 동안 엄청 지루해. 그래서 모두 어떻게 즐거움을 찾는지 잘 알고 있지. 만약 심심하면, 항구의 잠수함 동료들을 찾아서 놀도록 해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/feeling2.ogg"},"호감":{"voiceline":"왜? 잠수함 전투 체험에 관심 있어? 그럼 다음에 우리랑 같이 출전해 볼래? ...... 아, 지휘관은 우리처럼 이렇게 길게 잠수 못하지. 그러면, 우선 잠수 기술을 연습해봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/feeling3.ogg"},"기쁨":{"voiceline":"생각해봤는데, 수면 위에서 순항하면 지휘관을 태울 수 있는 거지? 안심해, 수면 위라도 내 항행 기술은 완벽하니까! 너를 떨어뜨리거나 갑자기 아래로 잠수하거나 하진 않을게~ 아니면, 지금 가서 체험해볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/feeling4.ogg"},"사랑":{"voiceline":"지금 생각하기엔, 기회가 된다면 너랑 같이 하면서, 이 바다를 한가롭게 누비면 좋을 것 같아. 아 참, 그때가 오면, 네가 우리의 이야기를 소설로 써봐! 영화로 만들 수 있다면 가장 좋고! ...... 음, 생각해보니깐 조금 부끄러운 것 같기도 하고... 그냥 우리 둘의 기억으로 삼자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 잠깐 지도 좀——읏차... 됐어, 내가 표시한 이 몇 군데가 매복 공격하기 좋은 곳이야. 다음 계획에 고려해 보는게 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/home.ogg"},"hp 경고":{"voiceline":"웬만하면 그만하지...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/hp_warning.ogg"},"로그인":{"voiceline":"엄청 일찍 왔잖아? 지각한 지휘관은 얼마나 당황스러워하는지 보고 싶었는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/login.ogg"},"실패":{"voiceline":"됐어, 다음에 다시 돌아오지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/lose.ogg"},"우편":{"voiceline":"우편함, 처리 안 하면 조만간 꽉 찰 텐데? 그때 되면 내가 말 안 했다고 하지 마......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/mail.ogg"},"임무":{"voiceline":"뭐? 아직 미완성한 임무를 발견하지 못한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/mission.ogg"},"임무완료":{"voiceline":"뭐? 내가 임무 보상을 받아서 네 앞에 가져다 줘야해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/mission_complete.ogg"},"서약":{"voiceline":"우왓!? 지휘관에게 선제공격을 당해버렸네... 아니야, 나도 아직 반격의 기회가... 지휘관, 눈 감아!——(쪽) 흐흥, 어때, 나에게 \"격침\" 당한 느낌이 들어~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/propose.ogg"},"스킬":{"voiceline":"Jetzt(지금이야)!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/skill.ogg"},"터치1":{"voiceline":"왜, 나한테 바라는 거 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/touch.ogg"},"터치2":{"voiceline":"뭐야? 여기에 그렇게나 관심이 있던 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/touch2.ogg"},"입수시":{"voiceline":"VIIC형 잠수함 U-96이다. 과거 「Vorwärts」의 일원 중 한 명이었지. 흐흥, 똑똑히 봐둬, 지휘관. 내가 전과를 아주 많이 가져다줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/unlock.ogg"},"강화성공":{"voiceline":"다음 번 출격이 아주 기대되는 걸, 헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에이스의 패기를 조금은 알았겠지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/win_mvp.ogg"},"전투개시_ex":{"voiceline":"확실하게 섬멸하자...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/battle_ex.ogg"},"상세확인_ex":{"voiceline":"♪～... 뭐야? 계속 이렇게 날 쳐다본 거 아니었어? 왜 긴장을 하고 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관, 지도 줄게——아, 틀렸다, 이게 아니야... 응? 이건가, 저번에 데이트 장소 찾아봤었는데...——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오, 왔구나. 나를 이렇게 일찍부터 불러낼 수 있는 사람도, 오직 너 뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"우편함, 보기 귀찮으면 내가 확인해버릴게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/mail_ex.ogg"},"임무_ex":null,"임무완료_ex":{"voiceline":"임무 보상 가져왔어, 괜찮아, 내가 도와주고 싶었을 뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"너의 부탁이라면, 난 뭐든지 들어줄 거라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/touch_ex.ogg"},"터치2_ex":{"voiceline":"어... 음......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"말했지? 너한테 훨씬 더 많은 전과를 챙겨준다고~ 쪽~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['U-81', 'U-47', 'U-557', 'U-556', 'U-73', 'U-101', 'U-522', 'U-110'] : \"울프팩\"으로부터 벗어날 수 있는 사냥감은 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"상대가 잠복해 있는 미지의 상황에서도 등을 맡길 수 있는 파트너가 있다면 두려워할 게 없지. 맞아, 모항의 동료들이 바로 그래.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/main1_ex.ogg"},"메인5_ex":{"voiceline":"커피와 럼주의 혼합 음료 안에 레몬과 후추를 더하면...... 이거 마셔 보고 싶어? 못 마시는 게 정상인 건데......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"아하하하, Z2이 또 Z1 녀석에 대해 투덜거렸어. 너도 하고 싶은 말 있으면 맘대로 해. 난 신경 안 써.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408090/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"nil","voicelink":null},"메인3_ex":{"voiceline":"nil","voicelink":null},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":408091,"클뜯 함순이 id":40809,"함순이 이름":"U-96","한글 함순이 + 스킨 이름":"비밀의 게임 시간","영문 함순이 + 스킨 이름":"Secret Gaming Session","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408091/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408091/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408091/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408091/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408091/shipyard.png","설명":"마침 잘 왔어, 난 방금 막 ‘전투’를 한 판 치렀거든. 결과...? 당연히 내가 이겼지. 왜? 너도 나랑 한 판 하고 싶어? ","자기소개":null,"메인1":{"voiceline":"나를 이기고 싶으면 몇 년은 더 연습해라, 일출지국의 무사, 하하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408091/main1.ogg"},"메인2":{"voiceline":"음... 잠깐만, 뭔가 이상한 소리가 들렸는데, 설마 U-81들이 숨바꼭질하다가 또 몰래 내 방에 들어온 건 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408091/main2.ogg"},"메인3":{"voiceline":"난 \"이스트 글림 자매\"를 좋아해, 뭐랄까, 노력하는 아이들은 싫어하지 않게 만들거든, 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408091/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이렇게 입으면 엄청 편해, 활동하기도 편하고. 어차피 내 방이잖아. 게다가, 너가 봐도 별 상관 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audi