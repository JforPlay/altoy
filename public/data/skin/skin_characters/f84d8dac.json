[{"클뜯 id":407040,"클뜯 함순이 id":40704,"함순이 이름":"프리츠 루메이","한글 함순이 + 스킨 이름":"프리츠 루메이","영문 함순이 + 스킨 이름":"Fritz Rumey","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407040/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407040/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407040/shipyard.png","설명":"대형항공순양함(Grossflugzeugkreuzer)A II형 - 프리츠 루메이","자기소개":{"voiceline":"압도적인 화력과 우세를 점할 수 있는 항공 전력을 겸비하고 있어서, 적에게 포위당해도 함재기의 힘을 빌리지 않고 물리칠 수 있지. 그것이 바로 내 설계 이념이다. 다들 헛소리라고 여기겠지만, 지금 내가 존재하는 것 자체가 그 증명이 될 테지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/profile.ogg"},"메인1":{"voiceline":"지휘관은 무엇을 위해 싸우지? …굳이 대답할 필요는 없어. 마음속에 대답을 두고 있다면, 그걸로 충분해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/main1.ogg"},"메인2":{"voiceline":"홀로 작전을 수행할 때도 있다. 위험하긴 하지만, 리스크에 걸맞은 성과를 올릴 수 있지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/main2.ogg"},"메인3":{"voiceline":"전투 기록을 정리해 두면 회고하기가 쉬워지지. 내가 작업한 건 나중에 귀공의 명의로 부하들에게 배부하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/main3.ogg"},"전투개시":{"voiceline":"적을 섬멸하면서 전진하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/battle.ogg"},"상세확인":{"voiceline":"승리는 입담만으로는 얻을 수 없고, 성공도 망상만으로는 이룰 수 없는 법이지. 지휘관, 무엇이든 차근차근히 해라. 그것이야말로 가장 빠른 지름길이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/detail.ogg"},"드랍 설명":{"voiceline":"대형 항공 순양함(Grossflugzeugkreuzer)A II형-프리츠 루메이","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐군. 지휘관, 보고서 작성을 시작하는 편이 좋겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/expedition.ogg"},"실망":{"voiceline":"이렇게 방종하다니, 군인으로서 부끄러운 줄 알아라. 일어서라! 스스로를 구원할 수 있는 건 오로지 자신뿐이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 정점에 서라. 그리하면 그 누구도 시야를 가리지 않는 곳에서 가장 아름다운 풍경을 감상할 수 있을 테니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/feeling2.ogg"},"호감":{"voiceline":"지휘관, 휴식 시간이다. 당장 하고 있는 작업을 멈춰라. 그저 무작정 일하는 시간만 늘리면 효율이 반감될 뿐이다. 귀공은 지금… 휴식이 필요하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/feeling3.ogg"},"기쁨":{"voiceline":"오늘 장기 연습에서 보여준 귀공의 전술은 여러모로 볼거리가 많았다만… 아군의 피해를 걱정한 나머지 시간 초과로 패배한 것은 참으로 개탄스럽더군. 아니… 우책이라고 비난할 생각은 없다. 내가 그 전술을 개선해 볼 테니, 다음에는 입장을 바꾸어서 싸워보자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/feeling4.ogg"},"사랑":{"voiceline":"지난 상황을 역추론해서 이번 연습에서 자신만의 대응책을 내놓다니…… 귀공의 전술은 가히 위협적이라고 하지 않을 수 없겠군. 훌륭한 결과다. 이 감각을 마음에 새겨라. 그리고… 귀공의 다음 활약을 기대하고 있다는 것, 잊지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/feeling5.ogg"},"터치3":{"voiceline":"지휘관, 무슨 일인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 간단히 휴식을 마친 후에 방금 전투를 돌아보도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/home.ogg"},"hp 경고":{"voiceline":"내가 전황을 바꾸리라…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/hp_warning.ogg"},"로그인":{"voiceline":"지휘관으로서 시간을 엄수하는 건 기본 중의 기본에 불과하지. 타인에게 귀감이 될 수 있도록 더욱 일찍 도착했으면 좋겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/login.ogg"},"실패":{"voiceline":"작전 실패로군. 다들 질서를 유지하면서 후퇴해라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/lose.ogg"},"우편":{"voiceline":"지휘관, 정보의 시효성은 늦지 않게 확인해야 확보할 수 있는 법이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/mail.ogg"},"임무":{"voiceline":"새로운 임무 목표가 통달 되었군. 지휘관, 실행 계획 기안을 부탁하마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/mission.ogg"},"임무완료":{"voiceline":"시간대로 처리했군. 수고했다, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/mission_complete.ogg"},"서약":{"voiceline":"나를 이곳으로 유인한 목적은 이미 알고 있지. 그 맹세, 기꺼이 받아들이마. 귀공이라면… 말로 하기 어려운 감정을 내가 많이 품고 있다는 것쯤은 이미 알고 있을 테지. 자, 반지를 끼워라. 그리고 이 떨림이야말로 내 대답이라는 걸 알아라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/propose.ogg"},"스킬":{"voiceline":"전진! 전진하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/skill.ogg"},"터치1":{"voiceline":"지휘관, 지금은 쉴 여유가 없다. 정신 차려라! 아직 일이 끝나지 않았다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/touch.ogg"},"터치2":{"voiceline":"지휘관, 자중해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/touch2.ogg"},"입수시":{"voiceline":"지휘관, Guten Tag(안녕). 나는 루메이라고 한다. 귀공도 이미 내 자료는 읽었겠지. 그러니 긴말할 거 없이…… 어서 다음 작전 계획이 뭔지 상세히 털어놓아 봐라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/unlock.ogg"},"강화성공":{"voiceline":"Gut(좋아).","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 정도는 지극히 평범한 승리일 뿐. 지휘관, 자만하지 말고 계속 분발해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관, 사적인 자리에서는 그렇게 딱딱하게 굴 거 없다. 지금은 쉬는 시간이니까 업무 이야기는 나중에 하자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰가 완료되었군. 지휘관, 같이 의뢰 보고서를 확인하자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/expedition_ex.ogg"},"사랑_ex":{"voiceline":"다음 훈련 말인가? 이제 막 업무를 끝낸 참이니, 그건 또 다음에…… 하아, 귀공이 피로로 쓰러지는 건 내가 바라는 바가 아니다. 모두 내게 맡기고 지금 당장 쉬어라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"? 무슨 일인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관, 지금 귀공은 휴식이 필요한 상태다. 회고는 내게 맡겨라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 커피는 이미 준비해 뒀다. 그래, 일찍 집무실에 도착하면 더 여유로운 상태에서 업무를 시작할 수 있겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"지휘관, 새로 온 우편은 「미처리」 쪽으로 분류해 뒀다. 정보를 확인한 후에 첨부 파일을 받는 거 잊지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/mail_ex.ogg"},"임무_ex":{"voiceline":"새로운 임무 목표가 통달되었군. 지휘관, 같이 집행 계획을 기안하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관, 눈앞의 업무를 두려워하지 마. 손을 움직이면서, 내가 그 도전에 함께한다는 사실을 잊지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/touch_ex.ogg"},"터치2_ex":{"voiceline":"지휘관…… 아직 업무 중이다. 자중해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"얼마 전에 이야기한 전술은 효과적이더군. …지휘관, 경험을 계속 쌓아야 다음 전투에 대처할 수 있는 법이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['그라프 체펠린'] :  적에게 동등한 파멸을! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/couple_encourage1.ogg"},{"voiceline":"['페터 슈트라서'] :  시간이 아깝군. 속전속결이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/couple_encourage2.ogg"},{"voiceline":"['비스마르크', '비스마르크 Zwei'] :  함께 싸울 수 있어 영광이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/couple_encourage3.ogg"}],"메인4":{"voiceline":"지휘관. 여기, 작전 계획의 최종안이다. 그래, 만전을 기하기 위해서라도 최종 확인을 거를 수는 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"내가 싸우는 이유? 지휘관. 나, 프리츠 루메이는 메탈 블러드의 동료들과 귀공을 위해 싸우고 있다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/main5_ex.ogg"},"메인6_ex":{"voiceline":"다음 작전의 리스크 평가를 해봤다. 지휘관, 확인하고 문제 없으면 다음에 출격하는 동료들에게 나눠주도록 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/main6_ex.ogg"},"메인7_ex":{"voiceline":"혹시 고민되는 일이 있다면 공사 불문하고 내게 털어놔라. 둘이서 생각하면 해결법도 분명 찾아낼 수 있을 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407040/main7_ex.ogg"},"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"UR","ex_chat_status":1},{"클뜯 id":407041,"클뜯 함순이 id":40704,"함순이 이름":"프리츠 루메이","한글 함순이 + 스킨 이름":"Schwarzes Kaninchen","영문 함순이 + 스킨 이름":"Schwarzes Kaninchen","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407041/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407041/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407041/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407041/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407041/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407041/shipyard.png","설명":"……? 귀공이로군. 내 모습을 보고 놀랐나? 흠…… 미안하군. 가게의 규율 단속에 대해 고민하던 중이었다. 아무튼 지휘관… 어서 오세요. (반짝)","자기소개":null,"메인1":{"voiceline":"동료들에게 겁을 주고 있다고? 흠…… 가게의 점장으로서 강경한 태도를 보여서 지휘관을 대접하는 규율을 바로잡으려는 것뿐… 나는 전혀 개의치 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/main1.ogg"},"메인2":{"voiceline":"비스마르크 공이 노하우를 전수해 준 덕분에 일이 한결 편해졌다. 돌아가면 감사 인사를 전해야겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/main2.ogg"},"메인3":{"voiceline":"주방에서는 음식을 몰래 먹지 않나, 지휘관이 안 온다고 멋대로 퇴근하질 않나…… 겁도 없이 그런 비행을 저지르다니. 슬슬 엄격한 규율로 다스릴 필요가 있겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"나는 이 가게의 점장… 즉 「보스 토끼」다. 귀공이 훌륭한 서비스를 받을 수 있도록 기강을…… 편하게 해도 된다고? 그럴 수는 없다! 귀공을 위한 거니 더욱 세세한 부분까지 신경 써야 한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/detail.ogg"},"드랍 설명":{"voiceline":"……? 귀공이로군. 내 모습을 보고 놀랐나? 흠…… 미안하군. 가게의 규율 단속에 대해 고민하던 중이었다. 아무튼 지휘관… 어서 오세요. (반짝)","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"설마 귀공에게 무리하지 마라, 차근차근하라는 말을 듣게 될 줄은 꿈에도 몰랐군. 뭐, 좋다. 참고하마. ……뭐? 내가 쉴 수 있게 망을 봐주겠다고? 그러면 여기에는 귀공과 나 둘만…… 크흠, 아무것도 아니다! 그래… 쉬자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/feeling5.ogg"},"터치3":{"voiceline":"귀가 토끼 느낌이 안 난다고? 흠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 우리 가게의 서비스를 마음껏 만끽하길 바란다. 물론 귀공의 반응은 세세히 기록해 둘 셈이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오픈하고 마감할 때는 잊지 말고 타임카드를 꼭 찍어라. 지각, 조퇴는 절대 금지다. ……아, 지휘관. 귀공에게 한 말은 아니니 오해 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"또 임무인가? 이번에는 특별히 도와주마. 그러니 귀공도 꾸물대지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"지휘관, 귀공의 용기는 높게 평가한다만……! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/touch2.ogg"},"입수시":{"voiceline":"……? 귀공이로군. 내 모습을 보고 놀랐나? 흠…… 미안하군. 가게의 규율 단속에 대해 고민하던 중이었다. 아무튼 지휘관… 어서 오세요. (반짝)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"귀공은 이 가게의 유일하고도 귀중한 손님이니 천천히 쉬다 가라. 서류 작업이든 전투든, 집무와 휴식의 균형을 잘 잡는 것이 중요하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407041/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"카니발","상점 id":71078,"상점 카테고리 id":16,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1180,"기간":"한정 (2026/01/21)","진영":"KMS","레어도":"UR","ex_chat_status":0}]