celink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/feeling1.ogg"},"낯섦":{"voiceline":"존재감이 없는 것도 좋은 점이 있어요. 많은 귀찮은 일을 피할 수 있거든요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/feeling2.ogg"},"호감":{"voiceline":"함대 사람들은 다들 사이가 좋네요...후훗...—응? 아, 아무것도 아니에요. 저는 혼자 두시면 돼요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/feeling3.ogg"},"기쁨":{"voiceline":"가끔 마음 속 이야기가 저도 모르게 입으로 나오는 거니까...너, 너무 신경쓰지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 요즘 찾아오지 않아서 죄송해요...그게...요즘 저와 지휘관님이 함께 하는 장면이 멈추지 않고 계속 머리를 맴돌아서...너무 창피해요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오늘 전투...는 꽤 순조로웠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/home.ogg"},"hp 경고":{"voiceline":"보, 보는 눈이 너무 많은 것 같은데...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/hp_warning.ogg"},"로그인":{"voiceline":"어! 지휘관님, 인사 안해주셔도 되는데...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/login.ogg"},"실패":{"voiceline":"조용히 철수하죠...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/lose.ogg"},"우편":{"voiceline":"우편은 잘 읽어보셔야죠...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/mail.ogg"},"임무":{"voiceline":"지휘관님, 이건...임무 지시서...죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/mission.ogg"},"임무완료":{"voiceline":"...하! 큰일이네, 임무 보상을 점검 하다가 나도 모르게 망상에 빠져서는...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/308050/mission_complete.ogg"},"서약":{"voiceline":"이건..