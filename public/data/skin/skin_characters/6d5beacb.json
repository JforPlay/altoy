[{"클뜯 id":102350,"클뜯 함순이 id":10235,"함순이 이름":"패서디나","한글 함순이 + 스킨 이름":"패서디나","영문 함순이 + 스킨 이름":"Pasadena","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102350/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102350/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102350/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102350/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102350/shipyard.png","설명":"클리블랜드급 경순양함 - 패서디나","자기소개":{"voiceline":"자기소개? 이글 유니온 소속 경순양함, 패서디나야. 후훗, 아직 가르쳐 줄 게 많은데, 뭐부터 알고 싶어? 취미? 엄청 많지~ 그래도 제일 좋아하는 건 역시 모두 함께 페스티벌을 즐기는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/profile.ogg"},"메인1":{"voiceline":"드디어 대망의 아이스크림 데이야… 어떤 페스티벌을 열면 좋을까? 응? 아이스크림 데이가 뭐냐고? 하하, 이 아이스크림 줄 테니까, 같이 보러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/main1.ogg"},"메인2":{"voiceline":"저기 지휘관, 작업 시작한 지 꽤 됐으니까, 기분 전환 겸 하우스 뮤직이라도 틀지 않을래? 그리고 신나게 흔들면서 내가 준비한 서프라이즈를 보러 가는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/main2.ogg"},"메인3":{"voiceline":"지휘관, 아래 스탬프 판 봤지? 스탬프를 다 모으면 숨겨진 선물을 받을 수 있으니까 같이 해보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/main3.ogg"},"전투개시":{"voiceline":"안녕, 다들ー! 페스티벌 시간이야ー!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/battle.ogg"},"상세확인":{"voiceline":"저기 지휘관, 지금 엄청난 아이디어가 떠올랐어! 모항에서 뮤직 페스티벌을 여는 건 어때? 분명 다들 즐겁게 해줄 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/detail.ogg"},"드랍 설명":{"voiceline":"클리블랜드급 경순양함 - 패서디나","voicelink":null},"의뢰 완료":{"voiceline":"의뢰도 무사히 끝났고, 페스티벌 준비도 OK야! 지휘관, 같이 보러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/expedition.ogg"},"실망":{"voiceline":"내가 준비한 페스티벌은 별로야? 그럼 엄청 화려한 서프라이즈는 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/feeling1.ogg"},"낯섦":{"voiceline":"페스티벌에서 다들 웃고 있어! 자! 지휘관, 여기까지 분위기를 만들어 줬으니까, 지금은 웃는 얼굴을 보여줘야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/feeling2.ogg"},"호감":{"voiceline":"있잖아! 에헤헤, 엄청 귀여운 커플 머리 장식이 있길래, 지휘관한테 잘 어울릴 것 같아서 샀어~! 그걸 달고, 나랑 투샷 찍을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 아~ 해봐. 아…… 어때? 이 케이크 맛있지? 후훗, 마음에 들어 할 줄 알았어! 지휘관에 대해 점점 더 잘 알게 되는 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/feeling4.ogg"},"사랑":{"voiceline":"지휘관~ 이거 봐! 맞아! 셀카봉이야! 사실 「패서디나랑 지휘관의 하루」라는 주제로 영상을 찍으려고 했거든! 둘만의 즐거운 시간을 기록해서, 반짝이는 추억으로 만들자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/feeling5.ogg"},"터치3":{"voiceline":"아하, 그렇구나. 지휘관은 기쁠때 이렇게 감정을 표현한다는 거지? 그럼 나도…… 통통! 쓰담쓰담~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 사실 작게 페스티벌을 준비했어! 남은 참가자는 지휘관 하나뿐이야! 같이 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/home.ogg"},"hp 경고":{"voiceline":"이 정도로는 못 막아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘 내가 어떤 서프라이즈를 준비했을지 맞춰 볼래? 짜잔! 정답은~~~ 페스티벌 분위기로 집무실을 바꿔 놨지롱♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/login.ogg"},"실패":{"voiceline":"으아아?! 이건 서프라이즈가 아니라 쇼크잖아!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/lose.ogg"},"우편":{"voiceline":"지휘관, 어쩌면 새 우편에 내가 준비한 서프라이즈가 있을지도? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/mail.ogg"},"임무":{"voiceline":"서프라이즈로 만들 만한 임무는 있어? 있으면 나한테 맡겨 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/mission.ogg"},"임무완료":{"voiceline":"후훗ー, 임무 보상을 받을 때면 페스티벌을 즐길 때처럼 기쁘더라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/mission_complete.ogg"},"서약":{"voiceline":"이, 이게 지휘관이 준비한 서프라이즈야?! 에헤헤, 이런 걸 좋아하는구나♪ 정했어! 오늘을 우리 둘의 「사랑의 기념일」로 만들자! 이제부터는 매년 성대하게 페스티벌을 준비해서, 신나게 축하할 거야ー!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/propose.ogg"},"스킬":{"voiceline":"화려한 페스티벌을 즐겨 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/skill.ogg"},"터치1":{"voiceline":"하아~ 머리를 푸니까 시원해ー! 지휘관, 이어서 계속하자♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/touch.ogg"},"터치2":{"voiceline":"오호라~ 지휘관은 이런 서프라이즈를 더 좋아하는구나♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/touch2.ogg"},"입수시":{"voiceline":"짜잔! 패서디나의 스페셜 데뷔 서프라이즈! 마음에 들어? ……아하하♪ 지휘관의 칭찬, 잘 받았어♪ 서프라이즈 작전 대성공!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/unlock.ogg"},"강화성공":{"voiceline":"오오오! 신나게 즐겨 보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/upgrade.ogg"},"vote":null,"승리":{"voiceline":"페스티벌을 열고 싶어지는 대승리네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관! 이제부터 매 주말은 「위크엔드 페스티벌」로 정했어! ……왜냐면 주말은 보통 쉬는 날인데, 지휘관은 맨날 몰래 일하잖아? 그러니까 나랑 같이 페스티벌을 즐기자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 어서 이리로 와! 눈 감아! 응응, 이대로 눈을 감은 채로 내 지시를 기다려 줘…… 셋, 둘, 하나ーー쪽. 아하하, 지휘관, 이런 서프라이즈는 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"지휘관도 여기에 헤어핀을 다는 게 좋을 것 같아? 좋아~ 나도 다는 편이 좋을 것 같더라♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"짜자잔! 지휘관, 출격 보너스 패키지 획득한 거 축하해! 서프라이즈는 이미 준비해뒀으니까 같이 받으러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오! 또 지휘관이랑 만났다! 오늘도 서프라이즈가 가득한 하루네! …응? 나는 지휘관만 만나면 하루 종일 해피해져♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"꼬리 액세서리도 귀엽지! 후훗, 그냥 만져 보지 그래? 부드러울걸♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/touch_ex.ogg"},"터치2_ex":{"voiceline":"지휘관, 움직이지 마~ 다음은 내가 「서프라이즈」를 해 줄 테니까♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['산타페'] : 뮤직 페스티벌을 준비할 테니까 홍보 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"아! 그거, 페스티벌을 위한 공연 목록이야! 지휘관도 관심 있어 보이네… 혹시 무대에 올라와 줄 거야?! 그럼 돋보일 만한 무대를 준비해야겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/main5_ex.ogg"},"메인6_ex":{"voiceline":"펜에 붙어 있는 하트 스티커? 그거, 내가 붙인 건데? 사적인 물건에 서로 표시를 붙여서 마음을 전한다고들 하잖아! 자, 다음은 지휘관 차례야! 제일 특별한 곳에 붙여 봐♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관, 반짝거리는 액세서리를 샀는데… 어디에 달까? 옷깃? 가슴? 그리고 은색이랑 금색 중에는 뭐가 좋아? 둘 다 마음에 들어서 고민이야! …맞다! 지휘관이랑 커플룩으로 하면 어떨까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102350/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SR","ex_chat_status":1},{"클뜯 id":102351,"클뜯 함순이 id":10235,"함순이 이름":"패서디나","한글 함순이 + 스킨 이름":"서프라이징 게임","영문 함순이 + 스킨 이름":"Surprising Game","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102351/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102351/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102351/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102351/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102351/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102351/shipyard.png","설명":"Surprise! 어때? 나의 스페셜 승부 복장! 지휘관이랑 게임 대결을 펼치려고 특별히 준비했어~. 아하하♪ 자, 「야옹야옹 페스 버서스」, 시작!","자기소개":null,"메인1":{"voiceline":"겨우 버텼네! 받아랏! 30배 실드 리플렉트! 간다아♪ …어라? 갑자기 반응 속도가 빨라졌다고? 후훗, 이 승부용 안대를 걸친 이상 나는 달인이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/main1.ogg"},"메인2":{"voiceline":"으음… 「마스크를 쓰고 고양이 울음소리 흉내 내기」 카드를 뽑아버렸네… 그럼ーー냐, 냥냥~♥ 아, 얼굴 안 보여서 다행이다///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/main2.ogg"},"메인3":{"voiceline":"져버렸어~…… 카드는――「발톱 자국: 이긴 사람이 원하는 곳에 고양이 발톱 자국 옮기기」… 무슨 뜻이지~? (팡) 꺄악!? 지, 지휘관?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"벌써 대결이 끝난 후의 서프라이즈가 기다려져? 아하하♪ 벌칙용 서프라이즈 카드를 잔뜩 준비했지! 내용도 전ー부 달라♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/detail.ogg"},"드랍 설명":{"voiceline":"Surprise! 어때? 나의 스페셜 승부 복장! 지휘관이랑 게임 대결을 펼치려고 특별히 준비했어~. 아하하♪ 자, 「야옹야옹 페스 버서스」, 시작!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이건… 시크릿 스테이지?! 아니, 나랑 지휘관만의 이스터 에그지! 지휘관이랑 같이 있으면 평범한 날도 서프라이즈가 가ー득해! 쪽. 후후후, 이건 두근두근 서프라이즈야♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/feeling5.ogg"},"터치3":{"voiceline":"응? 서프라이즈 터치♪ 냐냐냐~ 냥냥♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 어서 와~. 아까 그 대결 이어서 할래? 피곤하면 내가 준비한 서프라이즈 서비스도 있다구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"후훗, 지휘관도 참. 완전 신났네. 패서디나를 이기고 싶어서 안달 난 느낌? 후훗, 체감 기기는 준비돼 있으니까, 이제 승부야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"으앗! 장외 전술은 반칙이야! 반칙! 아하하, 그대로 되갚아 줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/touch.ogg"},"터치2":{"voiceline":"꺄악!? 지, 지휘관…… 설마 그 카드를 뽑다니! 으읏… 아직 안 끝났어……? 서프라이즈치곤… 너무 길잖아아……♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/touch2.ogg"},"입수시":{"voiceline":"Surprise! 어때? 나의 스페셜 승부 복장! 지휘관이랑 게임 대결을 펼치려고 특별히 준비했어~. 아하하♪ 자, 「야옹야옹 페스 버서스」, 시작!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102351/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,