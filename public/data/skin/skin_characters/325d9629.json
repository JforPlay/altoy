[{"클뜯 id":105070,"클뜯 함순이 id":10507,"함순이 이름":"테네시","한글 함순이 + 스킨 이름":"테네시","영문 함순이 + 스킨 이름":"Tennessee","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105070/shipyard.png","설명":"테네시급 전함·테네시 (BB-43)","자기소개":{"voiceline":"나는 신형 전함 테네시다. 전투에 있어서는, 흘수선 방어와 함체 장갑의 최신화를 거쳤고, 아울러 개량된 사격관제장치로 실전 능력을 강화했다. 지휘관, 명령을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/profile.ogg"},"메인1":{"voiceline":"지휘관! 출격하지 않는다면, 나는 여동생을 데리고 새로운 해역을 공략하러 가겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/main1.ogg"},"메인2":{"voiceline":"어째서 그렇게 한가할 수 있는 것이지, 전혀 이해할 수가 없군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/main2.ogg"},"메인3":{"voiceline":"스타일을 보다 좋게 할 비결이라고? …농담은 그만두지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/main3.ogg"},"전투개시":{"voiceline":"지옥 끝까지 쫓아가라! 우리의 모습을 상대의 두 눈에 똑똑히 새겨줘라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/battle.ogg"},"상세확인":{"voiceline":"원하는 만큼 봐도 좋다. 단, 본업을 잊지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/detail.ogg"},"드랍 설명":{"voiceline":"테네시급 전함·테네시 (BB-43)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 팀이 귀환했나? 어디, 내가 바람직한 원정 방법을 알려주지. (포탑을 꺼낸다)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/expedition.ogg"},"실망":{"voiceline":"너란 녀석은…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/feeling1.ogg"},"낯섦":{"voiceline":"좌우명은, '약육강식'이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/feeling2.ogg"},"호감":{"voiceline":"지휘관, 너는 아직 너무 약하다. 나와 함께 트레이닝을 하자. 책임지고 어엿한 지휘관으로 만들어주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/feeling3.ogg"},"기쁨":{"voiceline":"지금의 너는 제 몫을 다하는 사람이 되었구나. 음? 뭐, 안심해라. 내가 쭉 네 곁에 있어 주마. 트레이닝을 할 가치가 없어지는 것을 바라진 않으니까 말이지. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/feeling4.ogg"},"사랑":{"voiceline":"오랫동안 같이 있어서 그런 건지, 네 페이스에도 익숙해졌군. 하지만, 이렇게… 하루 종일 방에 틀어박혀 있는 것은 역시 적응이 안 되는군─── 내게 무슨 일이 생기면 제대로 책임을 지게 하겠어. 설마 거절할 생각은 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"다음 출격은 언제인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 준비해라. 곧 출항한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/login.ogg"},"실패":{"voiceline":"하, 그렇다! 이것이야말로 내가 원하는 적이다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 편지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/mail.ogg"},"임무":{"voiceline":"미션 정도는 빨리해두는 것이 좋다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/mission.ogg"},"임무완료":{"voiceline":"보너스가 내려왔다고, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/mission_complete.ogg"},"서약":{"voiceline":"이걸 받아들이면, 너에게 모든 것을 맡긴다는 말이 되는 건가? 좋다. 단, 한 가지만 약속해줘. 상처 입을 것을 두려워하여 나를 전장에 내보내지 않는다는 말은, 그것만은 하지 말아라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/propose.ogg"},"스킬":{"voiceline":"진정한 화력이 무엇인지 잘 보아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/skill.ogg"},"터치1":{"voiceline":"음… 귀여운 건 어울리지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/touch.ogg"},"터치2":{"voiceline":"윽… 나는 「공략 대상」이 아니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관인가? 흠… 소질은 있어 보이는군. 이래야지 나도 보람이 있다. 아! 그러고 보니, 자기소개가 아직이었군. 나는 테네시다. 기억했나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/unlock.ogg"},"강화성공":{"voiceline":"플러스알파 정도지만… 나쁘지 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이런 전투도 지루하진 않군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0}]