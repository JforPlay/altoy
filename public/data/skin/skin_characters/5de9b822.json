[{"클뜯 id":11300010,"클뜯 함순이 id":1130001,"함순이 이름":"유미아 리스펠트","한글 함순이 + 스킨 이름":"유미아 리스펠트","영문 함순이 + 스킨 이름":"Yumia Liessfeldt","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300010/shipyard.png","설명":"어라? 여긴 어디지? 유스테라도, 알라디스도 아니야… 저, 저기… 실례합니다. 누구신지는 모르지만, 이 세계에 대해 알려 주시겠어요? 아, 저는 유미아… 유미아 리스펠트라고 합니다. 연금술사고… 음… 연금술이라는 건 아시나요?","자기소개":{"voiceline":"유미아 리스펠트라고 해요. 연금술사죠. 연금술을 사용하는 것에 대해 다들 다양한 생각을 가지고 있지만…… 어떻게 사용하는 것이 올바른지 각자 생각해서 판단하는 게 중요하다고 늘 생각하고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/profile.ogg"},"메인1":{"voiceline":"적과의 전투에 도움이 되는 도구를 여러모로 생각하고 있는데… 어떤 능력이 효과적인지 아직 연구를 더 해야 할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/main1.ogg"},"메인2":{"voiceline":"음? 이 노란 새…? 그리고 고양이 같은 아이들…… 뭔가 귀여워~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/main2.ogg"},"메인3":{"voiceline":"예전에 만들었던 추적 장치 같은 건 여기에서도 도움이 될 것 같은 같은데, 만들려고 해도 재료가… 좋아, 여기에는 어떤 재료가 있는지 물어봐야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/main3.ogg"},"전투개시":{"voiceline":"준비는… 이미 끝났어!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/battle.ogg"},"상세확인":{"voiceline":"원래 있던 세상에서는 물건을 만드는 것 말고 마물 퇴치 같은 것도 했는데, 여기에서 해야 하는 것과는 조금 다른…가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/detail.ogg"},"드랍 설명":{"voiceline":"어라? 여긴 어디지? 유스테라도, 알라디스도 아니야… 저, 저기… 실례합니다. 누구신지는 모르지만, 이 세계에 대해 알려 주시겠어요? 아, 저는 유미아… 유미아 리스펠트라고 합니다. 연금술사고… 음… 연금술이라는 건 아시나요?","voicelink":null},"의뢰 완료":{"voiceline":"조사대 여러분이 귀환했어요. 무엇을 찾아 왔을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/expedition.ogg"},"실망":{"voiceline":"아, 잠시만요. 준비를 한 후에 해도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/feeling1.ogg"},"낯섦":{"voiceline":"좋아, 오늘도 열심히 일해야지. 제 연금술이 도움이 되도록 열심히 할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/feeling2.ogg"},"호감":{"voiceline":"아, 지휘관님! 지금 시간 있으세요? 뒷산에 모험하러 가고 싶은데, 괜찮으시면 같이 가주셨으면 해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/feeling3.ogg"},"기쁨":{"voiceline":"으음… 「세기의 대발견」이나 「경악스러운 진실」같은 건… 필요없다고요? 음… 지휘관님을 기쁘게 해드리고 싶은데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/feeling4.ogg"},"사랑":{"voiceline":"연금술 같은 건 여러분 입장에서는 미지의 애매한 기술인데, 그런 제 이야기를 믿어주셔서… 그리고 받아들여 주셔서, 지휘관님… 정말 감사합니다. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/feeling5.ogg"},"터치3":{"voiceline":"아, 역시 신경 쓰이세요? 연금술에 쓰는 도구는 다들 신기해 하죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 오늘 성과는 어땠나요? 뭐, 지휘관님이시니까 대성공하셨겠지만요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/home.ogg"},"hp 경고":{"voiceline":"아직… 싸울 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관님! 오늘도 잘 부탁드립니다. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/login.ogg"},"실패":{"voiceline":"아… 조금만 더 하면 됐는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/lose.ogg"},"우편":{"voiceline":"우편이 왔어요. 급한 용건일까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/mail.ogg"},"임무":{"voiceline":"아직 일이 남아 있는 것 같은데요… 보고하는 것이 좋을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/mission.ogg"},"임무완료":{"voiceline":"와! 벌써 끝내신 건가요? 분명 방금 시작하셨었죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/mission_complete.ogg"},"서약":{"voiceline":"아, 음… 왠지 굉장히 두근거려요. 아, 아하하… 연금술에서 새로운 조합법을 생각해 냈을 때와는 또 다른 가슴의 울림이 느껴져요… 다른 사람한테는 비밀이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/propose.ogg"},"스킬":null,"터치1":{"voiceline":"역시 신경 쓰이세요? 제 소지품… 총이나 구두 같은 건 별 차이 없는 것 같은데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/touch.ogg"},"터치2":{"voiceline":"정말, 도구가 망가지면 화낼 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/touch2.ogg"},"입수시":{"voiceline":"어라? 여긴 어디지? 유스테라도, 알라디스도 아니야… 저, 저기… 실례합니다. 누구신지는 모르지만, 이 세계에 대해 알려 주시겠어요? 아, 저는 유미아… 유미아 리스펠트라고 합니다. 연금술사고… 음… 연금술이라는 건 아시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/unlock.ogg"},"강화성공":{"voiceline":"조금 더 지식이 풍부해진 것 같은 느낌이 들어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아, 잘됐어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/win_mvp.ogg"},"전투개시_ex":{"voiceline":"모두 힘을 합쳐서 이겨내요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/battle_ex.ogg"},"상세확인_ex":{"voiceline":"연금술사의 공방은 아틀리에라고 불리는데, 그럼 슬슬 모항은 내 아틀리에…라고 불러도 괜찮으려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"이렇게 지휘관님 옆에서 제가 가진 힘, 『연금술』로 도움을 드리고 있다니…… 이 시간이 너무 영광스럽고 자랑스러워요. 앞으로도 당신께 힘이 될 수 있다면 좋겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"좋은 아침이에요, 지휘관님! 오늘은 함께 하실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"지휘관님, 아직 일이 남아 있어요. 도와드릴 테니 열심히 해봐요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/mission_ex.ogg"},"임무완료_ex":{"voiceline":"아, 끝났네요. 그럼 쉴까요. 같이… 말이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"아무리 지휘관님이시라도 해도 되는 일과 안 되는 일은 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이걸로 끝! 다들 무사해서 다행이야","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['니나 프리드'] : 너무 앞으로 나오지 말아주세요, 니나 씨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/couple_encourage1.ogg"},{"voiceline":"['레이냐'] : 레이냐, 하나, 둘, 셋! 하면 가는거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관님의 이야기는 도움이 되고 재미있어요. 거기에 새로운 연금술 아이디어까지…! 또 이야기를 많이 들려 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/main5_ex.ogg"},"메인6_ex":{"voiceline":"이곳은 굉장히 다양한 일을 할 수 있는 곳… 그렇기에 연금술을 사용해서 재미있는 걸 더 많이 할 수 있을 것 같은… 그런 마음이 솟구쳐 올라요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"연금술은 제 나름 생각해서 배운 거예요… 네, 주변의 사람에게 폐를 끼치고 싶지 않았거든요. 여기서 모두에게 도움이 되고 있으니 쓸모없지는 않았던 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300010/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":113,"레어도":"SSR","ex_chat_status":1},{"클뜯 id":11300011,"클뜯 함순이 id":1130001,"함순이 이름":"유미아 리스펠트","한글 함순이 + 스킨 이름":"우리집 파티시에 씨","영문 함순이 + 스킨 이름":"Everyone's Favorite Patissier","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300011/shipyard.png","설명":"아, 네. 잠깐만 더 기다려 주시겠어요? 조금 있으면 다 구워져요. 음~ 좋은 냄새! 이건 분명 최고의 걸작이 될 거예요. 그러고 보니 디저트 만들기는 연금술과 의외로 비슷한 점이 있는 것 같아요.","자기소개":null,"메인1":{"voiceline":"중얼중얼… 재료를 조금 더 다양하게… 재료를 조합하는 타이밍도… 아하, 물에 따라 반죽의 성질이 달라지네…… 아! 지휘관님. 죄송해요. 방금 뭐라고 하셨죠……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300011/main1.ogg"},"메인2":{"voiceline":"완제품을 「이미지」하는 게 중요한 거였네요. 연금술도 요리도 말이죠. 물론 모두에게 전하고 싶은 「마음」도 중요하지만요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300011/main2.ogg"},