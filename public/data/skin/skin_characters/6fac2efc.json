[{"클뜯 id":10900050,"클뜯 함순이 id":1090005,"함순이 이름":"세리 글로스","한글 함순이 + 스킨 이름":"세리 글로스","영문 함순이 + 스킨 이름":"Serri Glaus","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900050/shipyard.png","설명":"오렌족 세리야. 지금은 항공모함인 것 같아. 그런데, 여기에 씨앗 있어……?","자기소개":{"voiceline":"오렌족, 녹우씨족인 세리 글로스야. 무언가를 찾아 여행을 하는 도중에 이곳으로 떨어졌어. …뭘 찾고 있었냐고? 식물의 씨앗이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/profile.ogg"},"메인1":{"voiceline":"저 아이들, '지휘냥'이라고 하는구나. 나도 예전에 작은 동물을 키운 적이 있어. 그래서 저런 생물은 귀엽다고 생각해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main1.ogg"},"메인2":{"voiceline":"고기에 곁들이는 채소…. 아니, 싫어하는 건 아니야. 내가 평소에 채소를 먹지 않는 일족 출신이기는 하지만, 비전의 약초를 사용한 특제 스무디는 마셔본 적이 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main2.ogg"},"메인3":{"voiceline":"모항 뒷산에는 녹음이 무성하네. 저기에 씨앗은 없으려나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main3.ogg"},"전투개시":{"voiceline":"적이야. 단숨에 해치우자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/battle.ogg"},"상세확인":{"voiceline":"계속 여행을 한 탓에, 내 방이 있다는 게 이상한 느낌이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/detail.ogg"},"드랍 설명":{"voiceline":"오렌족 세리야. 지금은 항공모함인 것 같아. 그런데, 여기에 씨앗 있어……?","voicelink":null},"의뢰 완료":{"voiceline":"동료들이 돌아온 모양이네. 마중 안 나가도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/expedition.ogg"},"실망":{"voiceline":"계속 여기에만 머물러 있을 수는 없는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/feeling1.ogg"},"낯섦":{"voiceline":"……지휘관. 지금은 씨앗을 찾고 있었어. 여기엔 없을 수도 있지만, 혹시 모르니까. 그래… 도와줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/feeling2.ogg"},"호감":{"voiceline":"언젠가는 그 세계를 본래의 아름다운 녹음으로 가득한 모습으로…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/feeling3.ogg"},"기쁨":{"voiceline":"모항 주변은 거의 다 찾아봤어. 그 외에 식물이 있을 만한 곳… 지휘관, 알고 있어? 그럼 다음에 데려다 주지않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/feeling4.ogg"},"사랑":{"voiceline":"당신은 이 세상에서 날 여러 번 도와줬어. 그리고 같이 씨앗을 찾아줬지. 그런 당신의 진지한 마음, 내 마음에 잘 전해졌어. 고마워, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/feeling5.ogg"},"터치3":{"voiceline":"무슨 일이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔구나. 고생했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/home.ogg"},"hp 경고":{"voiceline":"포기하지 않겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/hp_warning.ogg"},"로그인":{"voiceline":"왔구나. 오늘은 뭘 할 생각이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/login.ogg"},"실패":{"voiceline":"여기서 멈출 수는 없어….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/lose.ogg"},"우편":{"voiceline":"우편이 왔어. 누가 보낸 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/mail.ogg"},"임무":{"voiceline":"남아 있는 임무가 있는 것 같아. 먼저 처리하는 편이 좋을 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/mission.ogg"},"임무완료":{"voiceline":"보상이 도착했어. 식물이 있으면 나한테도 보여줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/mission_complete.ogg"},"서약":{"voiceline":"나는 아직 무언가를 찾는 여행 중이야. 그렇지만 이 세계에서 내 버팀목이 되어준 당신을 위해, 조금 더 이곳에 머무르고 싶어. 그러니 지휘관, 앞으로도 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/propose.ogg"},"스킬":{"voiceline":"내가 할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/skill.ogg"},"터치1":{"voiceline":"피부가 깨끗한 이유? 그런 걸 물어봤자, 딱히 뭘 하는 건 없어. 짐작이 가는 거라면…. 매일 마시는, 일족의 비전 약초를 사용한 특제 스무디 정도려나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/touch.ogg"},"터치2":{"voiceline":"……뭐하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/touch2.ogg"},"입수시":{"voiceline":"오렌족 세리야. 지금은 항공모함인 것 같아. 그런데, 여기에 씨앗 있어……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/unlock.ogg"},"강화성공":{"voiceline":"나도 아직 더 성장할 수 있을 것 같네. 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"문제 없이 끝났어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/win_mvp.ogg"},"전투개시_ex":{"voiceline":"오고 있어. 다들 조심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/battle_ex.ogg"},"상세확인_ex":{"voiceline":"왜 그래, 지휘관? …내 방에 다른 사람을 들이는 날이 올 줄은 꿈에도 생각 못 했어. 사양 말고 어서 들어와.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"그 씨앗도 내가 찾고 있는 식물은 아니야. 그렇지만 지휘관이 찾아준 거니까… 소중하게 키워볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"좋은 아침…. 오늘은 어디로 가려나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"남아있는 임무가 있는 것 같아…. 어서 끝내버리자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/mission_ex.ogg"},"임무완료_ex":{"voiceline":"보상이 도착했어. 식물은 없는지 확인해 줬으면 하는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"…어쩔 도리가 없는 사람이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이것도 당신 덕분….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['릴라 디자이어스'] :  나도 멈추지 않아, 릴라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/couple_encourage1.ogg"},{"voiceline":"['파트리샤 아벨하임'] :  파트리샤, 비밀은 지켜줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/couple_encourage2.ogg"},{"voiceline":"['클라우디아 발렌츠'] :  클라우디아, 혹시 희귀한 식물 없었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/couple_encourage3.ogg"}],"메인4":{"voiceline":"이 식물, 쑥이라고 하는구나. 내가 찾고 있는 것과는 다르지만, 부상에 효과가 있을 것 같아…. 응? 쑥에 대한 노래가 있다고? 그렇구나, 꼭 들어보고 싶네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"내가 몇살이냐고? 지휘관, 여자에게 나이를 묻는 건 좀 아닌 것 같아. 그렇지만 뭐… 오렌족은 인간보다 장수한다는 것만 말해둘게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main6_ex.ogg"},"메인7_ex":{"voiceline":"지휘관, 오늘은 일이 많네. 내가 도와줄 거 없어? 지금까지에 대한 감사의 표시로 힘이 되고 싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main7_ex.ogg"},"메인8_ex":{"voiceline":"못다한 꿈을 쫒는 도중이지만, 이런 순간이 있어도 나쁠 건 아니다 싶네….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"유다치, 이건…. '모항에서 먹을 수 있는 추천 고기 요리 리스트'? 대단해…. 참고하도록 할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"저 토끼 소녀랑은 씨앗을 찾을 때 자주 마주쳐. 대부분 지금처럼 낮잠을 자고 있기는 한데… 깨워주는 편이 나으려나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main9_ex.ogg"},"메인10_ex":{"voiceline":"하나즈키는 이 세상의 꽃에 대해 잘 알고 있을 것 같네. 혹시 강한 힘을 가진 꽃에 대한 소문을 들은 적은…… 그렇구나, 고마워. 그나저나 거기에 장식한 건… 꽃꽂이라고 하는구나. 굉장히 예뻐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10900050/main10_ex.ogg"},"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"RYZA","레어도":"SR","ex_chat_status":1},{"클뜯 id":10900051,"클뜯 함순이 id":1090005,"함순이 이름":"세리 글로스","한글 함순이 + 스킨 이름":"별이 빛나는 밤의 요정","영문 함순이 + 스킨 이름":"Fairy Dreamer Beneath the Starry Sky","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900051/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10900051/shipyard.png","설명":"아름다운 녹음에, 맑은 물. 모항에 이렇게 아름다운 곳이