[{"클뜯 id":201290,"클뜯 함순이 id":20129,"함순이 이름":"에코","한글 함순이 + 스킨 이름":"에코","영문 함순이 + 스킨 이름":"Echo","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201290/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201290/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201290/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201290/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201290/shipyard.png","설명":"E급 구축함 - 에코 (H23) ","자기소개":{"voiceline":"로열 네이비, E클래스 구축함인 에코에요. 후드 씨, 웨일즈 씨와 함께 덴마크 해협 해전에 참가해서, 전투 후에 웨일즈 씨를 항구에 무사히 모셔다 드렸답니다~ 에헤헤, 추억은 중요한 거에요! 그리고, 에코는 에든버러 씨를 정말 좋아해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/profile.ogg"},"메인1":{"voiceline":"에든버러 씨와 약속했거든요~ 아무리 멀리 가더라도, 가끔은 모항에 돌아오기로요! ♪~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/main1.ogg"},"메인2":{"voiceline":"E클래스의 동료들도, 다른 아이들도, 모두 함께 놀다 보면 금방 친구가 될 수 있으니까 안심하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/main2.ogg"},"메인3":{"voiceline":"지휘관 씨에게는 에코가 있어요! 에코와 하이파이브를 하면 의욕이 생길 지도 몰라요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/main3.ogg"},"전투개시":{"voiceline":"돌겨! 에헤헤, 에코, 기함 같나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/battle.ogg"},"상세확인":{"voiceline":"웨일즈 씨가, 몸집이 작아도 잠재력이 있는 경우가 있다고 했어요! 에헤헤, 무슨 뜻인지는 잘 모르겠지만, 에코를 칭찬해 준 거죠? ♪~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/detail.ogg"},"드랍 설명":{"voiceline":"E급 구축함 - 에코 (H23)","voicelink":null},"의뢰 완료":{"voiceline":"♪~ 의뢰를 보냈던 동료들이 돌아왔어요! 지휘관 씨, 맛있는 걸 가지고 오지 않았는지 보러 가요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/expedition.ogg"},"실망":{"voiceline":"다들 지휘관 씨가 폐인이 되었다고 하던데, 폐인이 뭔가요…? 으음…아무튼 에코는 지휘관 씨가 좋은 사람이 될 수 있도록 열심히 할게요~ 일단은 에코에게 제대로 인사하기부터 시작이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/feeling1.ogg"},"낯섦":{"voiceline":"지휘관 씨, 정신차리세요. 에코처럼 웃는 얼굴로 활기차게~ 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/feeling2.ogg"},"호감":{"voiceline":"지휘관 씨, 이 정도로 약한 소리를 하면 안 돼요. 좀 더 몸을 단련해야겠네요~ 자아, 에코랑 같이 모항을 한 바퀴 돌도록 해요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/feeling3.ogg"},"기쁨":{"voiceline":"에코가 쿠키를 만들었어요~ 지휘관 씨도 드셔보세요! …엣, 너무 달았나요…? 에헤헤, 이게 \"에코의 맛\" 이라고 후드 씨가 그랬어요!♪~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/feeling4.ogg"},"사랑":{"voiceline":"지휘관 씨와 함께, 어딘가 먼 곳으로 떠나고 싶어요……하암…에코, 잠들어 버렸었나봐요…에? 같이 가도 되나요? 다행이다! 다음에 꼭 같이 가요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"♪~ 에코와 함께 과자라도 먹지 않을래요?......배가 고프지 않다구요? 그럼……에코가 먹는 모습을 봐 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/home.ogg"},"hp 경고":{"voiceline":"좀 더 버텨야지……에딘버러 씨가 반드시 에코를 구하러 와 줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/hp_warning.ogg"},"로그인":{"voiceline":"♪～아, 지휘관 씨! 에헤헤, 돌아오셨네요! 에코, 엄청 쓸쓸했다구요? 빨리 같이 놀아요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/login.ogg"},"실패":{"voiceline":"우우……너무 괴롭히지 마……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/lose.ogg"},"우편":{"voiceline":"♪~ 메일이에요~ 맛있는 간식이 들어있을 지도 몰라요~ 에헤헤","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/mail.ogg"},"임무":{"voiceline":"지휘관 씨, 같이 임무를 수행해요! 게으름피우면 안 돼요~ 흐흥, 사실 에코는 어어어어엄청 신뢰할 수 있다고 생각하지 않으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/mission.ogg"},"임무완료":{"voiceline":"♪~ 임무를 완료했어요! 지휘관 씨, 보상은 에코가 가져올게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/mission_complete.ogg"},"서약":{"voiceline":"♪~ 여기에선 뭘 하는 건가요? 잘 모르겠어요…… 그럼, 사탕을 주면 마지막까지 지휘관 씨를 따라갈게요! 응응, 지금 아~ 하고 입을 벌릴 테니까, 지휘관 씨, 사탕 주세요! 아~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/propose.ogg"},"스킬":{"voiceline":"간다아-! 에코의 힘을 보여주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/skill.ogg"},"터치1":{"voiceline":"지휘관 씨, 공주님 안기를 해 주세요! 에코는 꽤 가볍다구요! 하하하하! 지휘관 씨, 간지러워요오~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/touch.ogg"},"터치2":{"voiceline":"…? 후드 씨가, 여기는 마음대로 만지게 두면 안 된다고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/touch2.ogg"},"입수시":{"voiceline":"♪～지휘관 씨! 에코, 착임 했습니다! ……후후후~ 제대로 잘 착임 했으니까, 상을 주세요♪ 에헤헤! 에코는 사탕을 정말 좋아해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/unlock.ogg"},"강화성공":{"voiceline":"에헤헤, 강해졌는지 어떤지는 잘 모르겠지만, 지휘관 씨에게는 감사하고 있어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/upgrade.ogg"},"vote":null,"승리":{"voiceline":"♪~어머나, 에코가 MVP? 에헤헤, 그러니까 잘했다는 뜻인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201290/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null