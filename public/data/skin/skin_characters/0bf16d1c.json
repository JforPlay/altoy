[{"클뜯 id":102180,"클뜯 함순이 id":10218,"함순이 이름":"콩코드","한글 함순이 + 스킨 이름":"콩코드","영문 함순이 + 스킨 이름":"Concord","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102180/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102180/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102180/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102180/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102180/shipyard.png","설명":"오마하급 경순양함 콩코드 (CL-10) ","자기소개":{"voiceline":"이글 유니온의 오마하급 경순양함, 콩코드야. 장비 개조 나름대로 꽤 받았었으니까, 그럭저럭 도움이 되지 않을까? 아마도~ 후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/profile.ogg"},"메인1":{"voiceline":"너무 걸었더니 피곤해……지휘관, 한가하면 나한테 발 마사지라도 해줘도 되는데 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/main1.ogg"},"메인2":{"voiceline":"내 이름을 따온 그 마을, 늘 보러 가고 싶다고 생각했거든~ 다음에 기회가 되면 같이 안 가볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/main2.ogg"},"메인3":{"voiceline":"나, 실은 꽤 남들 잘 돌봐주는 편이거든♪ 그렇게 안 보인다고? 후후후, 더욱 서로에 대해 알아가야 할 필요가 있다 이거겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/main3.ogg"},"전투개시":{"voiceline":"흐~흐흠~ 어떻게 귀여워해줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/battle.ogg"},"상세확인":{"voiceline":"힘내 지휘관, 열심히 일해준 상으로 사탕을 줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/detail.ogg"},"드랍 설명":{"voiceline":"오마하급 경순양함 콩코드 (CL-10)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔어~ 새로나온 아이스크림 같은 거 안 갖고 왔으려나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/expedition.ogg"},"실망":{"voiceline":"안 피곤하니까 발 만지는 건 그만둬. 걷어 차버린다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/feeling1.ogg"},"낯섦":{"voiceline":"아, 지휘관! 이 디저트를 갖고…그래그래! 그대로 들고 따라와~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/feeling2.ogg"},"호감":{"voiceline":"에~ 이대로 조금만 더 나랑 어울려줘도 좋잖아~ 정말이지, 멍하니 있지 말고 제대로 여기 보라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/feeling3.ogg"},"기쁨":{"voiceline":"당분이 부족한 지휘관에게 상으로 줄 초콜렛을 위해, 콩코드를 어떻게 즐겁게 해주려나~? 기대되네♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/feeling4.ogg"},"사랑":{"voiceline":"나 말야 실은 굉장히 스윗한 여자애라구. 조금 보여줄까~ 자, 얼굴을 여기 대고……(쪽!) 어때? 달달하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오, 드디어 돌아와줬네♪ 이거, 새로나온 아이스크림인데 먹을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/home.ogg"},"hp 경고":{"voiceline":"으음, 너무 앞으로 나가지 않는 편이 좋으려나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/hp_warning.ogg"},"로그인":{"voiceline":"지휘관이랑 또 만났네♪ 맛있는 사탕, 가져왔어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/login.ogg"},"실패":{"voiceline":"대실패네……이제 더는 못하겠어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/lose.ogg"},"우편":{"voiceline":"새로운 우편이야~ 새로 나온 디저트의 입고소식이려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/mail.ogg"},"임무":{"voiceline":"임무가 아직 남아 있는데? 그렇게 발을 빤히 쳐다보는 건 그만두라구~ 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/mission.ogg"},"임무완료":{"voiceline":"빨리 보수를 받으러 가지 않으면, 내가 대신 가줄게~ 내가 전부 챙겨버리겠지만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/mission_complete.ogg"},"서약":{"voiceline":"후후, 지휘관과 이제야 여기까지 오게 되었네~ 앞으로도 마사지 잘 부탁해♪ 대신 달달한 나를 듬뿍 맛보게 해줄 테니까, 기대해줘♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/propose.ogg"},"스킬":{"voiceline":"날 너무 깔보지 말라고~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/skill.ogg"},"터치1":{"voiceline":"응? 지휘관도 단 게 좋아? 못참겠다 부탁한다면 조금은 나눠줄 수 있는데 말야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/touch.ogg"},"터치2":{"voiceline":"지휘관, 다음에 만지면 걷어 차줄 거다~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/touch2.ogg"},"입수시":{"voiceline":"경순양함 콩코드, 착임했어~♪ 사탕이랑 아이스크림은 마이 페이버릿~ 흐음? 지휘관은 남의 발을 그렇게 쳐다보는 게 좋은 거야? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/unlock.ogg"},"강화성공":{"voiceline":"스위티~~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후♪ MVP도 그렇게 대단한 건 아니네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['오마하', '롤리', '리치몬드', '멤피스'] : 후후, 같이 싸우게 되다니 드문 일이네. 해보자고~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102180/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R",