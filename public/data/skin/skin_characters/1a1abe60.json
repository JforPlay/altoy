[{"클뜯 id":199020,"클뜯 함순이 id":19902,"함순이 이름":"조지아","한글 함순이 + 스킨 이름":"조지아","영문 함순이 + 스킨 이름":"Georgia","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199020/shipyard.png","설명":"전함 - 조지아 ","자기소개":{"voiceline":"유니온의 전함 조지아다. 좀 알고지낸 그 아이에 비하면, 내 주포 쪽이 구경이 크지. 그래, 이 주포로 눈앞을 가로막는 모든 적을 쓸어버리는 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/profile.ogg"},"메인1":{"voiceline":"내게는 꿈이 있다. 그건, 언젠가 이 바다에서 화약 연기가 가라지고, 모든 인류가 평화롭게 살아간다는 꿈이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/main1.ogg"},"메인2":{"voiceline":"역시 콜라는 최고의 음료지? 앗, 지휘관은 산소 콜라 못 마시는…거 아니었나……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/main2.ogg"},"메인3":{"voiceline":"기회만 있다면 여러 나라를 가보고 싶군. 사쿠라 엠파이어, 이스트 글림, 로열 네이비…… 흠, 아예 세계 일주해버리는 것도 좋겠는걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/main3.ogg"},"전투개시":{"voiceline":"이번엔 어떤 상대지? 괜히 기대하게 해놓고 실망시키지는 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/battle.ogg"},"상세확인":{"voiceline":"장비의 정기적 검사와 정비는 중요하지. 지휘관도 도와줄 텐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/detail.ogg"},"드랍 설명":{"voiceline":"전함 - 조지아","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔군. 그래, 산소 콜라도 가져다주자. 부하를 치하하는 건 상관의 의무니까 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/expedition.ogg"},"실망":{"voiceline":"지휘관은 이 힘을 손에 넣기에는 적합하지 않은 모양이군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/feeling1.ogg"},"낯섦":{"voiceline":"복숭아는 좋다. 맛있는 데다 영양가도 듬뿍 들어있지. 지휘관도 하나 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/feeling2.ogg"},"호감":{"voiceline":"출격, 전투는 확실히 피가 끓는다만, 가끔은 긴장을 푸는 것도 중요하다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/feeling3.ogg"},"기쁨":{"voiceline":"다음에 여행할 때 함께 가는 건 어떤가? 네가 있다면, 분명 재밌는 여행이 되겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/feeling4.ogg"},"사랑":{"voiceline":"유니온에서 출발해서… 로열과 아이리스, 그리고 이스트 글림으로…… 아, 언젠가 떠날 세계 일주 여행 계획을 짜고 있는 거다. 설마, 가지 않는다고 하진 않겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/feeling5.ogg"},"터치3":{"voiceline":"조지아 빔! …은 무슨, 그냥 장식이라고! 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/headtouch.ogg"},"모항귀환":{"voiceline":"오, 출격 수고했다. 기분 전환으로 시원한 콜라라도 마시지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/home.ogg"},"hp 경고":{"voiceline":"큭… 장갑 손상이라고!? 배로 갚아주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/hp_warning.ogg"},"로그인":{"voiceline":"호오, 딱 좋은 타이밍에 왔군. 준비 운동을 끝낸 참이다. 그럼, 연습인가? 아니면 출격인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/login.ogg"},"실패":{"voiceline":"퇴각할 수밖에… 없는 건가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/lose.ogg"},"우편":{"voiceline":"지휘관, 네 앞으로 온 우편이다. 괜찮다면 봉투에 붙은 우표는 넘겨줄 수 없겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/mail.ogg"},"임무":{"voiceline":"임무인가… 전투 임무라면 참 좋겠는데. 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/mission.ogg"},"임무완료":{"voiceline":"보고서를 제출하지 않으면 임무를 완료했다고 할 수 없다. 지휘관, 확인을 잊지 말도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/mission_complete.ogg"},"서약":{"voiceline":"크흠… 지휘관이 정면으로 대쉬해올 거라고는 생각 못 했군… 아니, 나로서는 세계 일주 여행이 예상보다 빨리 시작될 것 같아서 기쁘다고. 하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/propose.ogg"},"스킬":{"voiceline":"이 거포의 굉음으로 너희들의 최후를 연주해주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/skill.ogg"},"터치1":{"voiceline":"하항~ 지휘관도 이 주포가 아름답다고 생각하나? 마음껏 감상하도록~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/touch.ogg"},"터치2":{"voiceline":"하항~ 보아하니 지휘관, 스스로 시험 사격의 표적이 되고 싶나 보군……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/touch2.ogg"},"입수시":{"voiceline":"유니온 소속 조지아다. 안심해라, 이 대포로 네게 승리를 가져다주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/unlock.ogg"},"강화성공":{"voiceline":"다음 전투에서 내 힘을 보여주도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어떤 장갑이라도… 이 거포로 꿰뚫을 뿐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"