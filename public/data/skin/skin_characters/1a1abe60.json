2603/AzurLane/main/audio/voiceline/199022/main2.ogg"},"메인3":{"voiceline":"여름이 아직 가지 않았으니 ‘세계 해변 여행’을 계획해 보는 것도 괜찮아보이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199022/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이 까만 보일은 시애틀이 골라준거야. 그 녀석, 평소에는 건성건성 같아 보이지만 의외로 이런 재주가 있단 말이지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199022/detail.ogg"},"드랍 설명":{"voiceline":"으흥, 햇살도 바닷 바람도 딱 좋은걸. 좋아, 함께 여름을 즐겨보자고! 지휘관도 엄청 기대되지?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"응, 출격 수고했어. 아이스크림 먹을래? 여기 또 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199022/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오? 마침 잘 왔어. 파라솔을 펴려고 하는데 좀 도와줘, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199022/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관의 ‘눈을 어디에 둬야 할 지 모르겠다’라는 표정을 보는 것도 생각보다 재밌네. 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199022/touch.ogg"},"터치2":{"voiceline":"허~? 바다에 오니 지휘관의 마음도 좀 풀렸나보지. 약간의 ‘자극’이 필요한가? 예를 들면, 이 파라솔이라거나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199022/touch2.ogg"},"입수시":{"voiceline":"으흥, 햇살도 바닷 바람도 딱 좋은걸. 좋아, 함께 여름을 즐겨보자고! 지휘관도 엄청 기대되지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199022/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex