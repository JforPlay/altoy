[{"클뜯 id":10700010,"클뜯 함순이 id":1070001,"함순이 이름":"아마미 하루카","한글 함순이 + 스킨 이름":"아마미 하루카","영문 함순이 + 스킨 이름":"Haruka Amami","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700010/shipyard.png","설명":"안녕하세요, 지휘관님! 전 아이돌 아마미 하루카! 모항의 모두에게 꿈을 전달해주기 위해서 최선을 다할 거에요, 잘 부탁드려요!","자기소개":{"voiceline":"아마미 하루카입니다! 어렸을 때부터 노래 부르는 걸 좋아해서, 아이돌이 되는 게 꿈이었습니다. 힘든 일도 많았지만, 모두와 함께 앞으로도 성장할 수 있다면 좋겠습니다! 에헤헤……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/profile.ogg"},"메인1":{"voiceline":"저 작은 고양이 같은 애들… '지휘냥'이라고 했던가요? 동물 좋아하는 히비키가 보면 엄청 좋아할 것 같아요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/main1.ogg"},"메인2":{"voiceline":"여기에도 아이돌이 있군요! 다들 엄청 예쁘고 귀여워서…… 언젠가 함께 무대에 서고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/main2.ogg"},"메인3":{"voiceline":"전에 악역을 연기한 적이 있었는데, 엄청 재밌었어요! 의외로 푹 빠져버렸어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/main3.ogg"},"전투개시":{"voiceline":"그럼, 슬슬 가보죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/battle.ogg"},"상세확인":{"voiceline":"저에 대해 알고 싶으시다고요……? 그게…… 그럼, 뭔가 얘기라도 하실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/detail.ogg"},"드랍 설명":{"voiceline":"안녕하세요, 지휘관님! 전 아이돌 아마미 하루카! 모항의 모두에게 꿈을 전달해주기 위해서 최선을 다할 거에요, 잘 부탁드려요!","voicelink":null},"의뢰 완료":{"voiceline":"다들 심부름 고생했어~! 무사히 돌아와 줘서 다행이야~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/expedition.ogg"},"실망":{"voiceline":"앗, 죄송해요…… 대본 보느라…… 무슨 일 있으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/feeling1.ogg"},"낯섦":{"voiceline":"저, 어렸을 적부터 노래 부르는 게 정말 좋았어요. 다 함께 노래 부르는 거 엄청 즐겁죠♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/feeling2.ogg"},"호감":{"voiceline":"아야야야…… 앗, 지휘관님, 안녕하세요. 복도에서 살짝 넘어져 버려서요. 어, 반창고…… 고맙습니다, 지휘관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/feeling3.ogg"},"기쁨":{"voiceline":"오늘 자율 연습은 이쯤 할까나~ ……어라, 지휘관님도 휴식 중이신가요? 괜찮으시다면 같이 쉬러 가실래요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님! 오늘은 쿠키 가져왔어요! 제법 잘 구워져서, 지휘관도 드셔주셨으면 해서…… 하나 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/feeling5.ogg"},"터치3":{"voiceline":"리본이 어울린다고요……? 에헤헤, 감사합니다♪ 에헤헤…… 트레이드 마크예요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/headtouch.ogg"},"모항귀환":{"voiceline":"수고하셨습니다, 지휘관님! 과자 만들어 왔는데, 괜찮으시다면 쉬실 때 드셔주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/home.ogg"},"hp 경고":{"voiceline":"무대는 이제 막 시작한 참이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/hp_warning.ogg"},"로그인":{"voiceline":"안녕하세요, 지휘관님! 오늘도 열심히 일하자구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/login.ogg"},"실패":{"voiceline":"우으, 넘어져서 죄송해요…… 다음에는 실수하지 않도록 노력할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/lose.ogg"},"우편":{"voiceline":"지휘관님, 우편이 도착한 것 같아요! 새로운 일일까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/mail.ogg"},"임무":{"voiceline":"아직 일이 남아있는 것 같아요. 제가 해드릴 수 있는 일이 있다면 말씀해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/mission.ogg"},"임무완료":{"voiceline":"업무 완료♪ 고생하셨어요, 지휘관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/mission_complete.ogg"},"서약":{"voiceline":"모두와 지휘관님 덕분에, 전 이곳에서 웃으며 힘낼 수 있었어요. 그러니까, 보답으로 모두에게 미소를 잔뜩 전해주고 싶어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/propose.ogg"},"스킬":{"voiceline":"팬 여러분에게 미소를 전하겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/skill.ogg"},"터치1":{"voiceline":"왜 그러세요, 지휘관님? 아, 뭔가 도와드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/touch.ogg"},"터치2":{"voiceline":"꺄악! 가, 갑자기 뭐 하시는 거예요!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 지휘관님! 전 아이돌 아마미 하루카! 모항의 모두에게 꿈을 전달해주기 위해서 최선을 다할 거에요, 잘 부탁드려요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/unlock.ogg"},"강화성공":{"voiceline":"아이돌로서, 더더욱 빛나겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼어요~! 모두들, 고마워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/win_mvp.ogg"},"전투개시_ex":{"voiceline":"좋~아, 기합 넣고 가보죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관님, 수고하셨…… 엇, 꺄아아악!(우당탕) ……아야야야야. 에헤헤, 또 저질러버렸네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"그러고 보니,