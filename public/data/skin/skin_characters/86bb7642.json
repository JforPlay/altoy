[{"클뜯 id":102240,"클뜯 함순이 id":10224,"함순이 이름":"클리블랜드(μ장비)","한글 함순이 + 스킨 이름":"클리블랜드(μ장비)","영문 함순이 + 스킨 이름":"Cleveland μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102240/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102240/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102240/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102240/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102240/shipyard.png","설명":"경순양함 클리블랜드, 도착! 사실 이런 건 익숙하지 않지만 하기로 한 이상 자연스럽게 모두와 맞춰갈 수 있겠지! 지휘관, 응원 부탁해!","자기소개":{"voiceline":"경순양함 클리블랜드야. 지난 해전에서는 동생들과…… 응, 동생들과 함께 활약했지! 이제 특수 장비를 갖추고 노래로 싸워보이겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/profile.ogg"},"메인1":{"voiceline":"헤헤~ 내 폭발적인 페이스에 따라올 수 있을까? 장난이야~ 다운즈 녀석, 꽤 재미있는 말을 하잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/main1.ogg"},"메인2":{"voiceline":"모두의 앞에서 노래를 할 기회는 꽤 있었기 때문에 별로 긴장되지 않아. 헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/main2.ogg"},"메인3":{"voiceline":"몬트필리어, 덴버. 너희들 그 옷은 대체 뭐야?! 부끄럽잖아! 버밍햄도 그런 거 휘두르지 않아도 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/main3.ogg"},"전투개시":{"voiceline":"라이트 온! 전투 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/battle.ogg"},"상세확인":{"voiceline":"스테이지에서 가장 중요한 것은 자신감! 자신이 빛난다고 생각해야 성공할 수 있어! 응응, 방금 엄청 멋있는 말을 한 것 같은데! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/detail.ogg"},"드랍 설명":{"voiceline":"경순양함 클리블랜드, 도착! 사실 이런 건 익숙하지 않지만 하기로 한 이상 자연스럽게 모두와 맞춰갈 수 있겠지! 지휘관, 응원 부탁해!","voicelink":null},"의뢰 완료":{"voiceline":"군사 의뢰 완료! 지휘관, 모두의 스케쥴은 제대로 관리해야 한다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/expedition.ogg"},"실망":{"voiceline":"미안. 이쪽이 너무 바빠서 지휘관을 신경 쓸 시간이 없어. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/feeling1.ogg"},"낯섦":{"voiceline":"나는 함대의 아이돌, 클리블랜드! 지휘관, 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/feeling2.ogg"},"호감":{"voiceline":"분재가 취미라고 하면 너무 노숙해 보이지 않을까… 어떡하지… 아아, 이런 일을 어떻게 아냐고! 지휘관, 자기 소개는 어떻게 써야 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/feeling3.ogg"},"기쁨":{"voiceline":"컬럼비아 녀석, 이런 일에는 가장 익숙한 것 같아서 찾아갔더니 절반은 헛소리였고… 지휘관이 있어서 정말 다행이야! 아니었다면 부끄러운 일을 얼마나 저질렀을지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/feeling4.ogg"},"사랑":{"voiceline":"후… 지휘관에게 정말 많은 도움을 받았어… 애초에 나는 이런 건 잘 몰라서, 이렇게 무대 위에서 스포트라이트를 받는 건 생각도 안 했거든… 지휘관, 역시 우리의 상성은 최고야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격 수고했어! 휴게실이 비어있지? 지휘실이 너무 멀면 거기서 쉬어도 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/home.ogg"},"hp 경고":{"voiceline":"끝까지 때려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/hp_warning.ogg"},"로그인":{"voiceline":"모두들 즐거운 건가! … 응, 이 느낌이면 충분해! … 아, 지휘관. 헤헤, 혼자서 연습하고 있었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/login.ogg"},"실패":{"voiceline":"컬럼비아 일행에게 이런 모습을 보여줄 수는 없는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/lose.ogg"},"우편":{"voiceline":"새로운 우편이다! 그러니까 내 앞이 아니라, 전부 지휘관에게 온 거야! 정말이지! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/mail.ogg"},"임무":{"voiceline":"오퍼… 아니 임무야! 어서 해치우자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 후… 슬슬 오퍼를 어떻게 해야 할지 생각해야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/mission_complete.ogg"},"서약":{"voiceline":"어디의 아이돌은 연애 금지라고 하던데, 우리는 괜찮겠지! 지휘관, 앞으로도 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/propose.ogg"},"스킬":{"voiceline":"하이텐션으로 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/skill.ogg"},"터치1":{"voiceline":"악수회의 연습도 해야 해. 지휘관, 도와주지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/touch.ogg"},"터치2":{"voiceline":"지휘관?! 지금의 나는 아이돌이라고……! 설, 설정 상……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/touch2.ogg"},"입수시":{"voiceline":"경순양함 클리블랜드, 도착! 사실 이런 건 익숙하지 않지만 하기로 한 이상 자연스럽게 모두와 맞춰갈 수 있겠지! 지휘관, 응원 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/unlock.ogg"},"강화성공":{"voiceline":"이게 바로 레슨의 성과!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/upgrade.ogg"},"vote":null,"승리":{"voiceline":"좋아 다음 상대는 누구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102240/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null