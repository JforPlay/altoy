[{"클뜯 id":207010,"클뜯 함순이 id":20701,"함순이 이름":"이글","한글 함순이 + 스킨 이름":"이글","영문 함순이 + 스킨 이름":"Eagle","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207010/shipyard.png","설명":"항공모함-이글","자기소개":{"voiceline":"전투함으로 개조한 항공모함으로 한때 로열 네이비의 해상 항공전에 큰 경험을 제공한 적이 있고 최전선에서 싸우다가 마지막에는 해상으로 돌아갔어. 로열 네이비 전사에게는 괜찮은 결말인 셈이지. 다만 기습당한 것은 항상 풀리지가 않아...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/profile.ogg"},"메인1":{"voiceline":"오늘의 메뉴는…과일 샐러드, 야채 샐러드, 저칼로리 건강식이라…음, 아주 완벽해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/main1.ogg"},"메인2":{"voiceline":"이 노트의 내용이 궁금한가? 포기하기를 바라네. 당신이 노트안의 내용을 보게 된다면, 입을 막을 수밖에 없으니까…농담이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/main2.ogg"},"메인3":{"voiceline":"이전에 모항에서 메탈 블러드의 잠수함들을 만났었는데… 난 인사 방식도 생각 못했는데 그녀들은 놀란 토끼처럼 도망치더라구. 으… 그녀들과 접촉하는 방식을 반성해봐야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/main3.ogg"},"전투개시":{"voiceline":"전쟁이라… 하하. 살짝 흥분되는데!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/battle.ogg"},"상세확인":{"voiceline":"내가 있기 전 옛날에 많은 로열 네이비들 역시 '이글'이란 이름을 부여받았지. 나 이후로도 책임감과 사명감이 가득한 이 이름에 부끄럽지 않기를 바라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/detail.ogg"},"드랍 설명":{"voiceline":"항공모함-이글","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 임무가 끝났네. 이 간식들을 가져가서 모두를 위로해줘. 나? 난 됐어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/expedition.ogg"},"실망":{"voiceline":"당신의 지금 모습이 정말 당신에게 많은 것을 쏟아부은 모두에게 떳떳한가? 잘 반성해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/feeling1.ogg"},"낯섦":{"voiceline":"가끔 사람들에게 사나워 보여 가까이 다가가기 어렵게 한다는 말을 듣지만, 나 스스로는 내가 함께 지내기 좋은 사람이라고 생각해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/feeling2.ogg"},"호감":{"voiceline":"로열 네이비는 다과회와 디저트 모임이 매우 많아. 늘 안가면 무리에 잘 안맞는것 같고, 가서 아무것도 안먹는 것도 이상한 것 같고… 내려놓고 먹어버려? 무, 무슨 농담을 하는 거야! 그것들 모두 칼로리인데!... 아… 크흠… 별, 별거 아냐. 추태를 좀 보였네. 미안.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/feeling3.ogg"},"기쁨":{"voiceline":"이상하네… 분명 요즘 내가 저칼로리 식단을 유지하고, 매일 운동도 하는데 왜 기록된 체중은 거의 변화가 없는 것 같지? 설마 전투함 개조 때문인가… 그저 이런 운명을 받아들일 수밖에 없는거야…!? 이건 불공평해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/feeling4.ogg"},"사랑":{"voiceline":"지금의 지휘관은 나에게 이미 분리할 수 없는 부분이야. 내가 어떻게 변하든…아니, 일이 이렇게 됐으니 나도 다시는 변하지 않을 생각이야. 지휘관, 당신에게는 내가 분리할 수 없는 존재야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"오늘의 체중도 아무 변화가 없…앗! 크흐흠! 지휘관, 내 예상보다 빨리 돌아왔는데? 암, 암튼 앞으로의 계획을 보자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/home.ogg"},"hp 경고":{"voiceline":"로열 네이비의 전사가 어찌 이런 사소한 어려움 때문에 물러설까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/hp_warning.ogg"},"로그인":{"voiceline":"음, 아주 좋아! 정확한 시간에 온 걸로 봐서 아주 책임감 있는 지휘관이라는 것을 알겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/login.ogg"},"실패":{"voiceline":"쳇, 계속된 작전은 손해을 초래하지… 돌아가서 정비하자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/lose.ogg"},"우편":{"voiceline":"당신의 우편물이야. 제때 확인하는것 잊지 말도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/mail.ogg"},"임무":{"voiceline":"지휘관, 임무가 더 남았어. 서둘러 완료해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/mission.ogg"},"임무완료":{"voiceline":"아주 좋아. 이게 바로 우수한 지휘관이 가져야 할 모습이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/mission_complete.ogg"},"서약":{"voiceline":"비록 내가 한때 그 강을 넘을 수 없었더라도 당신이 어려움에 처한다면 온갖 어려움을 넘어 당신 곁으로 갈거야. 이건 로열 네이비의 전사로서 지휘관에 대한 약속일 뿐만 아니라 한 소녀와 소중한 사람과의 약속이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/propose.ogg"},"스킬":{"voiceline":"잡았다! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/skill.ogg"},"터치1":{"voiceline":"무슨 일이야? 만약 회식이라면 … 나 대신 참석할 수 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/touch.ogg"},"터치2":{"voiceline":"알겠다. 예의 수업은 당신같은 사람을 위해 만들어진거네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/touch2.ogg"},"입수시":{"voiceline":"나는 로열 네이비의 항공모함 이글이라고 해. 영광스러운 로열 네이비의 전사로서 함대를 위해 내 모든 능력을 바칠 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/unlock.ogg"},"강화성공":{"voiceline":"강화는… 체중 같은 데는 영향이 없겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"적에 대한 자비는 동료에 대한 책임감이 없는 것이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"이렇게 된김에 체중에 관해서는 고민할 만한 가치가 없을 것 같네. 어찌 됐든 지휘관은 예전처럼 날 대할 것이라는 것을 내가 아니까. 결국 지금 우리는 서로를 떨어질 수 없어. 맞지, 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"오늘도 모든 것이 평소처럼…응? 지휘관도 무사히 돌아왔네. 응, 여기도 모두 정상이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 언젠가 피곤함을 느낀다면 잠시 쉬어. 늦게 와도 괜찮으니까. 미리 나에게 이야기만 해주면 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"무슨 일이야? 만일 회식이라면…윽…지휘관이 함께라면 나도 마음이 좀 놓일거야…나와 함께 갈 수 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/touch_ex.ogg"},"터치2_ex":{"voiceline":"그렇게 보지마! 사실 살은 별로 없… 뭐, 뭐하는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":{"voiceline":"느낌이 괜찮아. 고마워. 지휘관을 위해서 아무리 좁은 항로라도 전력을 다해 뚫을거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/upgrade_ex.ogg"},"승리_ex":null,"함대 특수대사":[{"voiceline":"['일러스트리어스'] : 이번은 우리가 함께 싸우게 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/couple_encourage1.ogg"},{"voiceline":"['됭케르크'] : 윽…난 당신의 유혹에 넘어가지 않을거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"사실 일단 습관되면 저칼로리 식단도 엄청 맛있어. 기회가 있으면 한번 함께 시도해봐, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"만일 지휘관이라면 이 안의 기록을 보여줄 수 없는건 아니지...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/main2_ex.ogg"},"메인3_ex":{"voiceline":"요즘 다른 아이들과도 잘 인사할 수 있게 됐어. 후후…지휘관과 오래 지내서인지 나도 부드러워진 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207010/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":1},{"클뜯 id":207011,"클뜯 함순이 id":20701,"함순이 이름":"이글","한글 함순이 + 스킨 이름":"인턴 의사 이글","영문 함순이 + 스킨 이름":"Eagle's Clinic","스킨 타입":"Hospital Series","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207011/shipyard.png","설명":"임무를 받았으니, 최선을 다해 해내겠다. 지금의 나는 로열의 전사일 뿐 아니라, 모항 병원의 인턴 의사다. 몸에 어떤 이상이 있는 것 같다면, 언제든 나를 찾아 와라, 지휘관.","자기소개":null,"메인1":{"voiceline":"내가 건강 식단을 연구했는데 지휘관이 테스트 해봐. 신체 상황을 효과적으로 개선할 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207011/main1.ogg"},"메인2":{"voiceline":"죽을 뻔한 자와 부상자를 구하고, 생명에 대한 책임을 져야해. 의사도 책임감과 사명감이 충만한 직업이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207011/main2.ogg"},"메인3":{"voiceline":"지휘관, 주사가 두려워? 내가 주사 놓는 스킬을 특별히 연습했지. 안 아플거야. 다음 번에 시도해봐. 아! 당연히 그럴 일이 없는 것이 가장 좋지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207011/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이번 모항 병원 특별 훈련을 위해서 아주 많은 준비를 했지! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207011/detail.ogg"},"드랍 설명":{"voiceline":"임무를 받았으니, 최선을 다해 해내겠다. 지금의 나는 로열의 전사일 뿐 아니라, 모항 병원의 인턴 의사다. 몸에 어떤 이상이 있는 것 같다면, 언제든 나를 찾아 와라, 지휘관. ","voi