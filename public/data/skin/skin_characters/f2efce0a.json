[{"클뜯 id":9706020,"클뜯 함순이 id":970602,"함순이 이름":"준요·META","한글 함순이 + 스킨 이름":"준요·META","영문 함순이 + 스킨 이름":"Junyou META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706020/shipyard.png","설명":"준요…예요. 지휘관, 지시할 것이 있으면 말해…주세요.","자기소개":{"voiceline":"저의 무엇이 알고 싶으신 건지 잘 모르겠지만…… 과거에 관한 거라면 실망하실 거예요…. 알려 드릴 수 있는 게 아무것도 없으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/profile.ogg"},"메인1":{"voiceline":"히요는…… 여전히 전투를 좋아하는군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/main1.ogg"},"메인2":{"voiceline":"집중해야 해, 집중……. 아, 그냥 영감을 얻기 위한 거긴 하지만 방해는 하지 말아주셨으면 해요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/main2.ogg"},"메인3":{"voiceline":"이 식의 함재기는… 세이렌과 싸우기 위한 무기예요. 제 식을 움직일 수 있는 건 오로지 저뿐… 다른 사람은 못 만져요…. 네, 절대로….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/main3.ogg"},"전투개시":{"voiceline":"갑니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/battle.ogg"},"상세확인":{"voiceline":"만약… 만약에 저와 지휘관이 아주 예전부터 아는 사이라고 하면… 아, 아무것도 아니에요. 잊어주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/detail.ogg"},"드랍 설명":{"voiceline":"준요호 항공모함 <color=#92fc63>(해당 META 캐릭터 보유 중일 시, 보상은 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어요. 동료들 배웅은 제가 대신 가도 괜찮을까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/expedition.ogg"},"실망":{"voiceline":"저도 다 컸어요. 소꿉친구에 대한 동경 같은 건….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/feeling1.ogg"},"낯섦":{"voiceline":"아, 그게…… 죄, 죄송해요…. 일부러 쳐다보려고 한 건 아닌데…. '만약에'…같은 걸 생각하다 보니….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/feeling2.ogg"},"호감":{"voiceline":"지휘관은 '소꿉친구'에 대해서 어떻게… 아, 이야기나 픽션 속에 등장하는 거 말인데… 어떻게 생각하세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/feeling3.ogg"},"기쁨":{"voiceline":"만약… 만약에… 혹시 저와 지휘관이 훨씬 더 예전에 만났었더라면… 지, 지금 상황도 여러모로 달라졌을 수도 있겠…죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/feeling4.ogg"},"사랑":{"voiceline":"진짜 '소꿉친구'는 아니지만, 이젠 아무래도 상관없어요. 왜냐면… 여러 가지를 극복한 우리는 이야기 속 '소꿉친구'보다 더 대단하니까!! …그렇게 생각하지 않으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/feeling5.ogg"},"터치3":{"voiceline":"읏……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/headtouch.ogg"},"모항귀환":{"voiceline":"응. 무사히 돌아와서… 다행이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/home.ogg"},"hp 경고":{"voiceline":"정면에서 돌격하는 건 무모해……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/hp_warning.ogg"},"로그인":{"voiceline":"오셨군요. 업무 보러 오신 건가요? 방해는 하지 않겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/login.ogg"},"실패":{"voiceline":"이미 각오했어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 온 우편이에요. 어서 확인하도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706020/mail.ogg"},"임무":{"voiceline":