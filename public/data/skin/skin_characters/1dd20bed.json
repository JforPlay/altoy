gg"},"실망":{"voiceline":"아아앗, 지휘관.....안되겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/feeling1.ogg"},"낯섦":{"voiceline":"하츠하루 언니, 더 자신 있게 해, 할 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/feeling2.ogg"},"호감":{"voiceline":"지휘관과 친구가 될 수 있다니, 너어무 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/feeling3.ogg"},"기쁨":{"voiceline":"그, 그게, 지휘관, 어떤 여자를 좋아해......? 앗, 다른 뜻은 없어... 응, 없다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/feeling4.ogg"},"사랑":{"voiceline":"히힛, 매번 몰래몰래 볼 때마다 나를 보고 있네......엇, 나 혼자 착각에 빠진 건 아니겠.....지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어.....아, 잠깐, 꼬리만 빤히 쳐다보지마——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 좋은 아침.....아얏! 그렇게 행복 가득한 얼굴로 내 꼬리를 안고 눕지마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/login.ogg"},"실패":{"voiceline":"우와.......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/lose.ogg"},"우편":{"voiceline":"그, 그건, 누가 보낸거야? 설마——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무가 나타났어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/mission.ogg"},"임무완료":{"voiceline":"지휘관, 우리의 여정은 아직 멀었어, 끝나지 않았다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301230/mission_complete.ogg"},"서약":{"voiceline":"지금까지 함께할 수 있어서, 정말 좋았어......우웅.....안 울어. 그냥.....그냥 행복이 눈에서 넘친거야......오늘부터 와카바가 훨씬 더 힘낼게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLan