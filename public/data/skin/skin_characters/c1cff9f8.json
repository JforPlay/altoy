[{"클뜯 id":601030,"클뜯 함순이 id":60103,"함순이 이름":"빈첸초 조베르티","한글 함순이 + 스킨 이름":"빈첸초 조베르티","영문 함순이 + 스킨 이름":"Vincenzo Gioberti","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601030/shipyard.png","설명":"알프레도 오리아니급 구축함—빈첸초 조베르티","자기소개":{"voiceline":"난 알프레도 오리아니급 구축함 2번함, 빈첸초 조베르티야. 멋진 순양함들과 함께 했었지.임무도 많이 참여하고——뭐? 자료랑 안 맞아? 음... 내, 내가 완공이 좀 늦긴 했지만... 진수는 엄청 빨랐어. 한치의 거짓도 없는 언니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/profile.ogg"},"메인1":{"voiceline":"시, 시몬 여기 없지...? 크, 크흠... 무서워 하는 건 아니야. 그, 그냥 조심스러운 생각에...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/main1.ogg"},"메인2":{"voiceline":"와! 정말이지, 업무 시간에 갑자기 귀신 얼굴하고 놀래키지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/main2.ogg"},"메인3":{"voiceline":"지휘관, 간식 먹을래? 티라미수 추천할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/main3.ogg"},"전투개시":{"voiceline":"절대 지휘관을 실망시키지 않을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/battle.ogg"},"상세확인":{"voiceline":"응? 조베트티의 도움이 필요해? 헤헤, 언니인 나에게 어려울 건 없어! 뭐든지 말해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/detail.ogg"},"드랍 설명":{"voiceline":"알프레도 오리아니급 구축함—빈첸초 조베르티","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/expedition.ogg"},"실망":{"voiceline":"역시... 이미 어떤 약도 소용 없겠어... 지휘관......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/feeling1.ogg"},"낯섦":{"voiceline":"음... 난 언제 베네토 언니처럼 홀로설 수 있을까...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/feeling2.ogg"},"호감":{"voiceline":"내 고향? 리보르노야. 사르데냐 제국 서쪽 해안에 있는 예쁜 고성이지. 기회가 되면 같이 가보자, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/feeling3.ogg"},"기쁨":{"voiceline":"당황한 모습이 귀엽다고? 당황한 적도 별로 없는데!? 네가 시도때도 없이 날 놀리니까... 하, 하지만, 귀엽다는 말을... 싫지 않네...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/feeling4.ogg"},"사랑":{"voiceline":"만약, 나랑 지휘관이 다른 신분으로 만났더라면... 예를 들어 같은 반 친구 같은... 그럼, 평범하고 낭만적인 경험이 있을 수 있을까? ... 그, 그냥 상상일 뿐이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/feeling5.ogg"},"터치3":{"voiceline":"나, 난 이미 머리 만져주면 좋아할 나이는 지났어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/headtouch.ogg"},"모항귀환":{"voiceline":"돌아온 이들을 안아준다면 더 언니 같으려나...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/home.ogg"},"hp 경고":{"voiceline":"여, 연막 엄호!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/hp_warning.ogg"},"로그인":{"voiceline":"오늘도 바빠? 지휘관, 힘내! ... 참, 나, 나도 가서 준비해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/login.ogg"},"실패":{"voiceline":"음... 나, 난 쉽게 실망하지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/lose.ogg"},"우편":{"voiceline":"우편 가져왔어, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/mail.ogg"},"임무":{"voiceline":"에, 새로운 임무가 있어? 아, 아직 준비 덜 됐는데...! 내, 내께 아니었구나...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/mission.ogg"},"임무완료":{"voiceline":"임무 끝났어, 히히... 어떤 보상이 있을려나~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/mission_complete.ogg"},"서약":{"voiceline":"조, 조베르티를 서약의 대상으로 선택한다고? 음... 안돼안돼, 진정해, 조베르티! 이럴 때는 우아하면서 침착하게 받아들여야 한다고! ...... 크흠, 그럼, 지, 지휘관 반지 끼워줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/propose.ogg"},"스킬":{"voiceline":"제대로 한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/skill.ogg"},"터치1":{"voiceline":"에? 나, 나 무슨 어울리지 않는 행동을 한 거 아니지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/touch.ogg"},"터치2":{"voiceline":"우왓, 지휘관, 정말 형편없네...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/touch2.ogg"},"입수시":{"voiceline":"난 사르데냐 엠파이어의 빈첸초 조베르티야——응? 이름이 너무 길어서 기억하기 어렵다고...? 그럼 GB는 어때, 조베르티의 약자야. 까먹지마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/unlock.ogg"},"강화성공":{"voiceline":"으흠, 성숙한 언니에 한 발 더 가까워졌군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"예~ 손쉬운 승리!... 크, 크흠... 이건 당연할 결과니까, 자랑스러워할거 없어——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['카라비니에레'] : 조금 풀어져도 괜찮다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601030/couple_encourage1.ogg"},{"voiceline":"['워스파이트'] : 와아!? 후... 이번엔 동료구나......","voicelink":"http