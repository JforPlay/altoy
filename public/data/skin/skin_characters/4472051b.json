[{"클뜯 id":9600100,"클뜯 함순이 id":960010,"함순이 이름":"포츠머스 어드벤처","한글 함순이 + 스킨 이름":"포츠머스 어드벤처","영문 함순이 + 스킨 이름":"Portsmouth Adventure","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600100/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600100/shipyard.png","설명":"범선 - 포츠머스 어드벤처","자기소개":{"voiceline":"나에 대해 알려달라고? 당당히 물어보는 모습이 갸륵하니 다 알려줘버릴까~ 난 속이 뒤틀린 녀석보다는 지휘관처럼 솔직한 사람이 더 좋거든! ……언제 알려줄 거냐고? 다음에 시간날 때 마실 거랑 먹을 거 잔뜩 들고 천천히 알려줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/profile.ogg"},"메인1":{"voiceline":"이거나 먹어라~! 냐하하하! 허벅지에 끼어서 숨도 못 쉬겠지! 내 새로운 굳히기 기술, 대단해…… 어, 어라? 지휘관 눈에 초점이…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/main1.ogg"},"메인2":{"voiceline":"으아아아! 비서함 업무따위 때려치고 말 거야! ! (꿀꺽꿀꺽) …너, 어떻게 이런 걸 매일매일… (꿀꺽꿀꺽) …불쌍해~ 에휴, 내가 귀여워해줄게~ 으헤헤헤♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/main2.ogg"},"메인3":{"voiceline":"이건 말이지, 내가 엄청 고생해서 손에 넣은 굉장히 비싸고 맛있는 술이야! 나부터 먼저 한입~ (꿀꺽꿀꺽) …크하아! ! 왜 이렇게 셔! 값어치는 하는 것 같은데… 내 취향은 아니야! 이건 지휘관한테 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/main3.ogg"},"전투개시":{"voiceline":"으하하! 바다를 가르는 힘을 보여주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/battle.ogg"},"상세확인":{"voiceline":"보물! 술! 맛있는 거! 아무리 많아도 모자라! …그런 날 만족시켜주고, 같은 길을 걸어주는 사람은 없을 거라 생각했지만… 어쩌면 지휘관이 그런 사람일지도 몰라! 나랑 같이 욕망을 위해 끝없는 모험을 떠나지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 포츠머스 어드벤처","voicelink":null},"의뢰 완료":{"voiceline":"오! 의뢰팀이 돌아왔네! 어서 습격하자! …아. 아군이라고? 그렇지! 나도 참 그걸 다 까먹네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/expedition.ogg"},"실망":{"voiceline":"지휘관, 자꾸 이런 식이면 나랑 바다 못 나간다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/feeling1.ogg"},"낯섦":{"voiceline":"흐아아암~ 너무 한가해~ 힘겨루기 하자! 지휘관이 이기면 금화 한 상자 줄게! …뭐? 내 손에 있는 병의 내용물이 더 궁금하다고? 그건 안 돼~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/feeling2.ogg"},"호감":{"voiceline":"안녕, 지휘관~ 나한테 비서함 시켜주지 않을래? 요즘 들어 지휘관이랑 더 많이 같이 있고 싶어져서… 비서함은 서류 업무를 많이 처리해야 한다고……? 으으…… 으으윽…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/feeling3.ogg"},"기쁨":{"voiceline":"내 몸에 붙어 있는 검고 끈적거리는 건 뭐냐고? 이건 내 비약이야, 비약♪ 발라도 좋고, 먹어도 좋아. 엄청난 효과를 가지고 있는 대단한 비약이라구~ 그러고 보니 지휘관, 얼마 전에 허리가 아프다고 했었지? 등에 바르고 내친김에 밟아서 마사지도 해줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/feeling4.ogg"},"사랑":{"voiceline":"단 하나뿐인 소중한 동료와의 유대감을 키우기 위해 오늘은 지휘관 방에 숙박하기로 결정♪ 아, 그렇지. 내가 잠버릇이 좀 나빠서 지휘관을 「끼우고」…… (꼬르륵) 갑자기 출출하네~ 이 근처에서 맛있는 거나 먹으면서 한잔 할까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/feeling5.ogg"},"터치3":{"voiceline":"응? 이 모자는 내 힘의 상징이야! 가지고 싶으면 꾸준히 노력하라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/headtouch.ogg"},"모항귀환":{"voiceline":"안녕~ 지휘관~ 돌아왔구나! 밝은 얼굴을 보니 소득이 꽤 짭짤했던 모양이네~? 나도 검품하는 거 도와줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/home.ogg"},"hp 경고":{"voiceline":"야! 화낸다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/hp_warning.ogg"},"로그인":{"voiceline":"「출발! 포츠랑 지휘관~♪ 황금이 가득한 그곳으로~♪」 …다음에 외출할 때 테마곡은 이걸로 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/login.ogg"},"실패":{"voiceline":"내게 돌아오는 몫이 줄어들 때랑 비슷할 정도로 분해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/lose.ogg"},"우편":{"voiceline":"우편…… 글자가 너무 많으면 식욕에 악영향을 끼치니까 네가 알아서 해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/mail.ogg"},"임무":{"voiceline":"아직 안 끝낸 임무가 있지? 자, 침략과 정복의 길에서는 게으름을 피우면 안 된다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/mission.ogg"},"임무완료":{"voiceline":"임무 끝났어? 뭐, 나는 딱히 한 게 없으니 보상은 네가 다 가져가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/mission_complete.ogg"},"서약":{"voiceline":"응? 이건? 잘 모르겠지만 친하다는 증표 같은 거지? 그럼 낄게~ 음, 뭔가 기분이 굉장히 좋은데! 그래서 다음에는 뭘 하면 돼? 네 부탁이라면 뭐든 다 할게! 우린 바다를 함께 달리는 동료니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/propose.ogg"},"스킬":{"voiceline":"바다에서는 내게 맞설 적이 없다구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/skill.ogg"},"터치1":{"voiceline":"수, 술 별로 많이 안 마셨어~ 으헤헤헤♥ ……지휘관도 한 잔 어때 ♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/touch.ogg"},"터치2":{"voiceline":"갑자기 친밀감을 어필하는 거야? 그럼 나도 해봐야지♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/touch2.ogg"},"입수시":{"voiceline":"안녕~ 네가 그 유명한 지휘관 맞지? …꽤 유능해 보이네. 그나저나 이 다음엔 어디로 갈 거야? 너는 물론이고 이 세상의 모든 보물을 손에 넣을 생각이거든. 냐하하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/unlock.ogg"},"강화성공":{"voiceline":"아하하하, 나는 이미 충분히 강한데~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"돈이 될만한 건 몽땅 내놔~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지, 지휘관! 하나 물어볼 게 있는데… 얼마 전에 그건… 사랑하는 사람끼리 하는 거라며? ……그, 그러니까 지휘관은 날 좋아하고… 나도 지휘관을…… 무, 무슨 말인지 알지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"으헤헤헤♥ 내가 소중히 모셔둔 이 독주, 어때? 몸이 뜨겁다고? 당연하지~ 내가 얼마나 먹였는데~ 헤헤헤… 지휘관은 이제… 내 「욕망」을 채워주는 수밖에 없어~♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"내 모자가 쓰고 싶으면 써도 상관없는데…… 뭐? 내 머리를 쓰다듬고 싶었던 것뿐이라고? ?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"안녕, 지휘관! 뭔가 굉장히 순조롭지 않아? 뭐? 내 얼굴이 새빨갛다고? ……너, 너무 많이 마셔서 그런 거야! 응!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"「출발! 포츠랑 지휘관~♪ 황금이 가득한 그곳으로~♪」 …으, 으악! 창피해! 노래 부를 때 그렇게 뚫어져라 쳐다보는 건 금지야! 금지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"꺅?! …요즘 지, 지휘관이 만지면…… 이, 이상해질 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/touch_ex.ogg"},"터치2_ex":{"voiceline":"지, 지휘관. 아직 업무 시간이니까 못 참겠다고 지휘관을 덮치지는…… 아니야! 그런 의미가 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['팬시'] : 얌마, 팬시! 무서우니까 이상한 소리 내지 마! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/couple_encourage1.ogg"},{"voiceline":"['아미티'] : 친하다는 건… 그런 뜻이야? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/couple_encourage2.ogg"},{"voiceline":"['돌핀'] : 해적이 날뛸 시간이다! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"(예전에는 안 그랬는데, 지금은 지휘관 곁에만 있어도 가슴이 두근거려… 으으으, 도저히 못 참겠어……!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/main5_ex.ogg"},"메인6_ex":{"voiceline":"병에 뭐가 들어있는지 궁금하다고 했지? 자! 내가 가진 것 중에 가장 독한 술이야! 마셔볼래? …뭐? 그럴 용기는 없다고? 윽… 마셔! 마시라고! 취해서 내 것이 되라고…! !","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"뭐? 내 굳히기 기술의 파해법을 알아냈으니 한 번 더 도전하겠다고? …아니, 아무래도 그건…! 으… 뭐, 그런 게 좋다면야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600100/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"MOT","레어도":"SR","ex_chat_status":1},{"클뜯 id":9600101,"클뜯 함순이 id":960010,"함순이 이름":"포츠머스 어드벤처","한글 함순이 + 스킨 이름":"서프라이즈 어드벤처","영문 함순이 + 스킨 이름":"Adventurous Surprise","스킨 타입":"Halloween","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600101/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600101/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600101/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600101/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600101/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600101/shipyard.png","설명":"잠깐, 지휘관?! 왜 이렇게 빨리 온 거야?! 이, 이건 딱히 「포츠머스가 특별히 준비한 서프라이즈 이벤트」가 아니라구!","자기소개":null,"메인1":{"voiceline":"함정 아이디어가 꽤 괜찮다고? 고마…워…? …이게 아니지! 대체 언제쯤 날 도와줄 생각이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/main1.ogg"},"메인2":{"voiceline":"자, 잡아당길 거면 우선 발쪽부터 당겨줘. 안 되면 허리… 머, 머리는 최후의 수단으로 미뤄줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/main2.ogg"},"메인3":{"voiceline":"으으… 지휘관, 날 도와줄 생각이 있기는 해? 설마 이대로 방치해 둘 생각은 아니지?! 이러면 같이 바다에 못 나간다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"으윽… 이걸로 지휘관을 못 움직이게 해서 장난치려고 했는데, 실수로 넘어지는 바람에… 서, 설마 최고의 파트너에게 장난을 치려고 해서 천벌이…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/detail.ogg"},"드랍 설명":{"voiceline":"잠깐, 지휘관?! 왜 이렇게 빨리 온 거야?! 이, 이건 딱히 「포츠머스가 특별히 준비한 서프라이즈 이벤트」가 아니라구!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔다고? 그래도 이 상태로는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"으으… 지휘관. 날 여기서 탈출시켜주면 나한테 하고 싶은 거 다 하게 해줄게! …뭐? 지금도 마음만 먹으면 다 할 수 있다고…? 그건 그렇네…… 자, 잠깐! 기다리라고…! !","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/feeling5.ogg"},"터치3":{"voiceline":"뿌, 뿔 엄청 무섭지? …그렇다고 잡으면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/headtouch.ogg"},"모항귀환":{"voiceline":"으으… 움직일 수가 없어… 지휘관을 붙잡아 두기 위한 함정인데…… 아, 아하하하~ 지휘관, 언제 왔어…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지금은 노래할 기분이 아니야! 뭐? 기분이 풀릴 때까지 기다릴 거라고…? 그것보다 빨리 도와주는 편이 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600101/login.ogg"},"실패":null,"우편":{"voiceline":"이 상황에서 우편을 확인한다고? …그럼 지휘관도 나처럼 들러붙지 않게 조심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/