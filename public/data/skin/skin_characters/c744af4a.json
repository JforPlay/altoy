[{"클뜯 id":408120,"클뜯 함순이 id":40812,"함순이 이름":"U-1206","한글 함순이 + 스킨 이름":"U-1206","영문 함순이 + 스킨 이름":"U-1206","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408120/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408120/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/408120/shipyard.png","설명":"메탈 블러드 VIIC형 잠수함 U-1206","자기소개":{"voiceline":"메탈 블러드의 울프팩을 아는구나! 나도 그중의 일원이었어! 여, 여러가지 사정이 있긴 했지만……. 으아아, 지금 건 안 들은 걸로 해줘! 어쨌든! 울프팩의 일원인 내 활약을 기대하라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/profile.ogg"},"메인1":{"voiceline":"지휘관, 이 버튼 눌러도 돼? ……안 돼? 그럼 이건? ……그것도 안 돼? 으으, 재미없어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/main1.ogg"},"메인2":{"voiceline":"아, 문 열어주고 올게! ……네네~ 누구세요? 엥? 아무도 없네? 잘못 들었나…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/main2.ogg"},"메인3":{"voiceline":"자료 프린트 임무, 완료! ……아, 앞하고 뒤가 바뀌었네?! 이, 이건…… 설명서 좀 찾아보고 올게…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/main3.ogg"},"전투개시":{"voiceline":"내 차례야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/battle.ogg"},"상세확인":{"voiceline":"\"슈퍼 파워풀 에어컨 사용 설명서\"라……. 음~ 그냥 이 빨간 버튼만 누르면 되는 거 아니야? 으아아앗, 깜짝이야! 지휘관, 이거 어떻게 꺼?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/detail.ogg"},"드랍 설명":{"voiceline":"메탈 블러드 VIIC형 잠수함 U-1206","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조 애들이 돌아왔어! 마중갔다 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/expedition.ogg"},"실망":{"voiceline":"내 용서를 바란다면 성의를 보이라고, 지휘관! 우선은…… 그래, 우선은 지휘관의 평판을 개선하는 것부터 시작하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/feeling1.ogg"},"낯섦":{"voiceline":"사용 설명서…… 너무 어렵잖아……. 그래도 내 직감만 있으면 이런 것쯤은 문제 없어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/feeling2.ogg"},"호감":{"voiceline":"누르기만 하면, 하루 업무가 다 끝나는 버튼이 있으면 참 좋겠다. 그럼 내가 매일 지휘관을 위해 눌러줄……. 아, 안 돼! 그렇게 욕심 부리면! 하루에 딱 한 번만 눌러줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 다음에 한가해지면 같이 놀러가자고 한 약속, 기억하지? 기억 안 난다구? 으윽…… 아니야! 분명히 약속했어! 그러니까, 응? 나랑 놀자! 바다에서 서핑할 수 있는 재밌는 곳에 데려다 줄 테니까~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/feeling4.ogg"},"사랑":{"voiceline":"지휘관! 계속 찰싹 붙어 있어도 돼? 음, 같이 일 끝내고, 밥 먹고, 수영한 다음에 낮잠 자고…… 어때? 좋다구?! 신난다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/feeling5.ogg"},"터치3":{"voiceline":"이마는 버튼이 아니라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 돌아왔네! 으음, 누르기만 하면 집무실 문이 자동으로 열리는 버튼 같은 거, 여기 있으면 참 좋을텐데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/home.ogg"},"hp 경고":{"voiceline":"아야야얏! 그만 좀 맞춰!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/hp_warning.ogg"},"로그인":{"voiceline":"어서와, 지휘관! 오늘은 뭐할 거야? 나, 지금이라면 엄청 열심히 할 수 있을 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/login.ogg"},"실패":{"voiceline":"으아앗?! 일단은 이 버튼을 눌러서 긴급 부상~!! ……혹시 누가 보진 않았겠지??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/lose.ogg"},"우편":{"voiceline":"우편이 새로 왔어! 지금 열어봐야…… 아, 이거 지휘관이 먼저 봐야하는 거였나…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/mail.ogg"},"임무":{"voiceline":"으아, 임무가 이렇게나……. 지휘관하고 더 많이 놀 수 있게 오늘은 내가 도와줄게! 파이팅!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/mission.ogg"},"임무완료":{"voiceline":"지휘관! 임무 다 끝났다며?! 에헤헤, 그럼 나랑 놀아줄 시간도 생겼겠네?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/mission_complete.ogg"},"서약":{"voiceline":"에헤헤~ 나, 지금 말이야, 너무 기뻐서 머릿속이 완전 백지 상태야! 금방이라도 지휘관 품에 픽하고 쓰러져 버릴 것 같아! 그러니까 내 말은, 엄~청 행복하다구! 에헤헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/propose.ogg"},"스킬":{"voiceline":"어뢰 발사~! ……착각했다, 여기였어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/skill.ogg"},"터치1":{"voiceline":"지휘관, 한가해졌어? 그럼 나랑 놀자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/touch.ogg"},"터치2":{"voiceline":"응~? 지휘관, 지금 이상한 생각했지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/touch2.ogg"},"입수시":{"voiceline":"어이! 거기 지휘관! 잠깐만! …… 너 하마터면 날 깜박할 뻔했다고! 난 메탈 블러드 잠수함 U-1206, 오늘부터 네 모항 소속이야! 나를 잘 기억해둬!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/unlock.ogg"},"강화성공":{"voiceline":"직감 UP! UP!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다! 어라? 1위 했는데 상품 같은 것도 없는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"에어컨 조작은…… 빨간 버튼이 아니라 이 파란 버튼을……. 엣취! 으아, 일냈다……. 생각하기 전에 그냥 빨간 버튼을 눌러버렸어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/aud