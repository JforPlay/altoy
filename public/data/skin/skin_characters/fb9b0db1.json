[{"클뜯 id":9600060,"클뜯 함순이 id":960006,"함순이 이름":"어드벤처 갤리","한글 함순이 + 스킨 이름":"어드벤처 갤리","영문 함순이 + 스킨 이름":"Adventure Galley","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600060/shipyard.png","설명":"범선 - 어드벤처 갤리","자기소개":{"voiceline":"지휘관이라면 조금이나마 내 함력에 대해 알고 있겠지. 해적과 함께 행동한 적은 있지만, 똑같이 취급하진 말아줘. 어쨌든 나는 그렇다고 단 한 번도 인정한 적 없으니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/profile.ogg"},"메인1":{"voiceline":"아, 노려봐서 미안해. 계속 주변 사람들을 눈으로 살피는 게 버릇이 돼서… 딱히 지휘관만 주시하고 있는 건 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/main1.ogg"},"메인2":{"voiceline":"여기에서는 내가 걱정할 만한 일은 일어나지 않을 거라고? …그렇게 단언하다니, 기대되기 시작하는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/main2.ogg"},"메인3":{"voiceline":"해적과 같이 행동한 적은 있지만, 서로 맺고 있는 건 신뢰가 아니라 이익 관계뿐이야. 지휘관이 이끄는 함대와는 전혀 다르다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/main3.ogg"},"전투개시":{"voiceline":"이 아이언 클로로 모든 것을 빼앗아 주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/battle.ogg"},"상세확인":{"voiceline":"쇠사슬 말이야? …예전에 속아서 배신당한 기억처럼 날 휘감아, 다른 사람을 믿으면 안 된다고 속삭여 줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 어드벤처 갤리","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네. 전리품 점검할 때는 신경 써서 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/expedition.ogg"},"실망":{"voiceline":"황금보다 소중한 '신뢰'를 당신이 배신할 줄이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/feeling1.ogg"},"낯섦":{"voiceline":"나와 연관이 있는 보물은 아직 잠든 채로 있어… 뭐, 그것도 어차피 임시방편일 뿐이라 언젠가는 안심하고 보관할 수 있는 곳으로 옮겨야 하는데…… 그 장소가 어쩌면 이 모항이 될지도 모르겠네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/feeling2.ogg"},"호감":{"voiceline":"모항으로 돌아가서 부두에 닻을 내릴 때, 집으로 돌아온 것처럼 안심이 돼. 지휘관이 여기서 기다리고 있어서… 그럴지도 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/feeling3.ogg"},"기쁨":{"voiceline":"진짜 신뢰할 수 있는 건 오로지 자신뿐…… 얼마 전까지는 계속 그렇게 생각해 왔어. 그렇지만 지휘관이 내 생각을 바꿔줬지. 신뢰할 수 있는 사람이 있다는 게 얼마나 좋은 일인지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/feeling4.ogg"},"사랑":{"voiceline":"다른 곳에 있는 보물을 여기로 옮겨서 모항에 우리만의 비밀 보물창고를 만들까 생각 중이야. 그래도 괜찮겠냐고? 지휘관 눈이 닿는 곳에 있는데, 뭐가 걱정이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/feeling5.ogg"},"터치3":{"voiceline":"무, 무슨 짓을…? 우으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/headtouch.ogg"},"모항귀환":{"voiceline":"드디어 돌아왔네, 지휘관. 도중에 음모에 빠지거나 하지는 않았지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/home.ogg"},"hp 경고":{"voiceline":"목줄이 걸리게 두진 않겠어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/hp_warning.ogg"},"로그인":{"voiceline":"돌아왔네. 자, 오늘 스케줄이야. 웬만하면 다른 사람에게 알려지지 않도록 해. 좋은 일 없을 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/login.ogg"},"실패":{"voiceline":"어디서부터 잘못된 거지…? 설마, 또 배신당한 건가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/lose.ogg"},"우편":{"voiceline":"새로 온 우편은 빨리 확인하는 편이 좋아. 그리고 정보는 누군가의 귀에 흘러 들어가지 않도록 주의해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/mail.ogg"},"임무":{"voiceline":"새로운 임무야. 신뢰할 수 있는 동료들과 함께 처리하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어. 전리품은 합법적인 수입이라고 할 수 있겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/mission_complete.ogg"},"서약":{"voiceline":"이건 내가 지금까지 손에 넣은 보물 중에서도 가장 소중한 거야. 답례로 내 몸과 마음, 그리고…… 내 모든 '신뢰'를 당신에게 줄게. 잘 받아서 꼭 안전한 장소에 보관하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/propose.ogg"},"스킬":{"voiceline":"야망도 황금도 모두 바다 밑에 묻히는 게 가장 잘 어울려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/skill.ogg"},"터치1":{"voiceline":"내게 뭘 원하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/touch.ogg"},"터치2":{"voiceline":"흐음…… 보물보다 내 쪽에 관심이 더 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/touch2.ogg"},"입수시":{"voiceline":"어드벤처 갤리야. 그것 말고 할 말은 딱히 없어. 뭐, 이 모항에서 신세 지고 있는 몸이고, 일단은 사이좋게 지내자고. 캡틴? …아니지. 지휘관…이라고 했지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/unlock.ogg"},"강화성공":{"voiceline":"보물을 지킬 화력이 또 한 단계 강해졌네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"내 보물에 손 댈 생각을 하다니, 주제도 모르는 녀석 같으니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔어. 꽤 수확이 푸짐하네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/expedition_ex.ogg"},"사랑_ex":{"voiceline":"그렇게나 소중히 해온 내 보물들을 둘러봐도, 지휘관과 비교하니 아무 가치도 없는 느낌이더라. 그렇지만 그건 딱히 보물의 가치가 떨어진 게 아니라, 지휘관에 비하면 하찮게 보일 뿐인 거겠지…… 그럼, 내 최고의 보물은 어디에 숨기는 게 좋으려나… 에헤헷♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"후후후… 조금만 더 이대로 있어도 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"휴우… 무사히 돌아왔네. 이제 드디어 안심할 수 있겠어… 걱정 끼치기 싫으면 다음부터는 나도 같이 데리고 가줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 와, 오늘 스케줄이야. 신뢰할 수 있는 동료와… 나도 데리고 가줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"당신이 원하는 거라면 뭐든 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/touch_ex.ogg"},"터치2_ex":{"voiceline":"욕심이 참 많네… 그럼 나를 마음껏 탐닉하도록 해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['로열 포춘'] :  누가 가장 빨리 보물을 약탈하는지 겨뤄보자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/couple_encourage1.ogg"},{"voiceline":"['메리 셀러스트', '위다'] :  너무 가까이 오진 말아줘……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"내 시야에 지휘관이 없으면 왠지 안절부절못하겠네… 아, 딱히 지휘관이 뒤에서 무슨 짓을 할까 걱정되는 게 아니라, 지휘관의 안전이 걱정돼서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/main5_ex.ogg"},"메인6_ex":{"voiceline":"항구에 이렇게 오래 머무르는 건 처음이야… 아마도 난 앞으로도 계속 이 모항에서 지내며, 계속 당신 곁에 있겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지금부터 내 숨겨둔 보물을 확인하러 갈 건데, 같이 가줄래? 내가 가장 '신뢰'하는 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600060/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"MOT","레어도":"SR","ex_chat_status":1},{"클뜯 id":9600061,"클뜯 함순이 id":960006,"함순이 이름":"어드벤처 갤리","한글 함순이 + 스킨 이름":"붉은 달의 카니발","영문 함순이 + 스킨 이름":"Carnival Under the Blood Moon","스킨 타입":"Halloween","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600061/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600061/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600061/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600061/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600061/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600061/shipyard.png","설명":"\"아하하하! 주인님… 드디어 찾았네! 자, 디너 준비는 끝났으니 나를 따라…… 식사할 기분이 아니라고? 모처럼 싱싱한 걸 손질해 뒀는데…\" ――지휘관? 왜 뒷걸음질 치는 거야…?","자기소개":null,"메인1":{"voiceline":"이 세트, 분위기 내기에는 최고네. 으흠, 그럼… \"아아, 드디어 찾았어!\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/main1.ogg"},"메인2":{"voiceline":"\"어떻게 하면 주인님의 사랑을 독차지할 수 있을까? 아하♪ 주인님 주변에 있는 방해물을 모조리 이 칼로 잘게 다져주면… 후후, 후후후♪\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/main2.ogg"},"메인3":{"voiceline":"\"미안해, 주인님. 식재료들의 비명이 너무 시끄러워서 좀 조용히 만들고 올게… 아, 궁금하다고 보면 절대 안 돼~\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"\"아하하하! 주인님… 드디어 찾았네! 자, 디너 준비는 끝났으니 나를 따라…… 식사할 기분이 아니라고? 모처럼 싱싱한 걸 손질해 뒀는데…\" ――지휘관? 왜 뒷걸음질 치는 거야…?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"\"주인님과 계속 함께하고 싶은데… 대체 어떻게 해야… 그래! 서로를 탐닉하면…… 후후후후♪\" ――컷! 방금 거 어땠어? 응? 전부 연기였던 건 아니었는데? 조금은 내 본심도… 서로를 탐닉하자는 대사는? 다, 당연히 그냥 대사일 뿐이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/feeling5.ogg"},"터치3":{"voiceline":"갑자기 무슨 짓이야! 모처럼 괜찮은 느낌이었는데…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/headtouch.ogg"},"모항귀환":{"voiceline":"\"어서 와, 주인님! 주인님이 돌아오는 걸 목이 빠지게 기다리면서 계속 이걸 갈고 있었어… 스윽 스윽… 스윽 스윽…\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"\"어서 와, 주인님! 오늘도 맛있는 고기로 가득한 디너를 준비했어. 모자라면 바로… 조달해 줄까?\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/login.ogg"},"실패":null,"우편":{"voiceline":"\"우편? 이 이름은… 다음 사냥감인…\" ……이 아니라, 중요한 우편일 지도 모르니까 빨리 확인해 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"\"어머, 주인님. 다른 부탁할 일이라도?\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/touch.ogg"},"터치2":{"voiceline":"\"이런 모습으로 변해도 여전히 사랑해 주는구나… 후후후…\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/touch2.ogg"},"입수시":{"voiceline":"\"아하하하! 주인님… 드디어 찾았네! 자, 디너 준비는 끝났으니 나를 따라…… 식사할 기분이 아니라고? 모처럼 싱싱한 걸 손질해 뒀는데…\" ――지휘관? 왜 뒷걸음질 치는 거야…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600061/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고