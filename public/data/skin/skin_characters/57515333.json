[{"클뜯 id":499070,"클뜯 함순이 id":49907,"함순이 이름":"프린츠 루프레히트","한글 함순이 + 스킨 이름":"프린츠 루프레히트","영문 함순이 + 스킨 이름":"Prinz Rupprecht","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499070/shipyard.png","설명":"순양전함 - 프린츠 루프레히트","자기소개":{"voiceline":"메탈 블러드 소속 특별 계획함, 프린츠 루프레히트야. 난 내가 내키는 대로 할 거야. 흥, 난 강하고 대단하니까, 내 맘대로 하는 게 당연하잖아? 당신 명령을 따르는 게 아니라, 고맙게도 들어주고 있는 것 뿐이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/profile.ogg"},"메인1":{"voiceline":"다과회? 왜 내가 그런 거에 참여해야 하는데? 당신이야말로 다른 애들 말고 나랑 더 시간을 많이 보내라구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/main1.ogg"},"메인2":{"voiceline":"…앗, 맛있는 캔디네…. 구축함 애들이 줬어. 당신한텐 안 줄 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/main2.ogg"},"메인3":{"voiceline":"이런 간단한 업무도 못하는 거야? 그런 주제에 잘도 지휘관이라고 하고 다니네…. 내가 대신 하는 편이 낫겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/main3.ogg"},"전투개시":{"voiceline":"승리는 내 것이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/battle.ogg"},"상세확인":{"voiceline":"의장 조정은 이렇게…. 아아, 날뛰지 마! 내 명령 좀 들어! 정말…. 당신도 보고만 있지 말고 도우라고! 당연한 거잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/detail.ogg"},"드랍 설명":{"voiceline":"순양전함 - 프린츠 루프레히트","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네. 조공은 어떤게 있으려나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/expedition.ogg"},"실망":{"voiceline":"어디로든지 좀 사라져 있어. 거슬리니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/feeling1.ogg"},"낯섦":{"voiceline":"감사하게 여겨. 당신같은 피라미를 내가 몸소 참아가며 지휘관이라고 불러주고 있으니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/feeling2.ogg"},"호감":{"voiceline":"흐음, 아주 조금 관심이 생겼어. 나름 열심히 하는 것 같고. 뭐, 내가 지휘관이라고 불러주는 사람이니까 당연한 거지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/feeling3.ogg"},"기쁨":{"voiceline":"당신은 다른 사람의 것이 아니라, 나 프린츠 루프레히트 거야. 당연하잖아. 왜냐면 내가 몸소 당신을 '지휘관'이라고 인정해주고 있으니까. 아님 뭐 불만이라도 있어? 처음부터 당신한테 거부권 같은 건 없었거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/feeling4.ogg"},"사랑":{"voiceline":"내 것이 되라'고…? 피라미 인간 주제에 어딜 기어올라? 당신이 내 것인 거거든? 어디! 누가! 뭐라고 해도! 당신은 내 거라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/feeling5.ogg"},"터치3":{"voiceline":"메롱이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔네. 조금은 지휘관다운 구석도 있잖아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/home.ogg"},"hp 경고":{"voiceline":"나는 최강인데…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/hp_warning.ogg"},"로그인":{"voiceline":"느려터졌어! 날 기다리게 하다니, 이게 무슨 짓이야?! 역시 지휘관 그만두게 해줬음 하는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/login.ogg"},"실패":{"voiceline":"이걸로 한방 먹여줬단 생각이라면 큰 오산이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/lose.ogg"},"우편":{"voiceline":"우편이네… 딱히 나랑은 관계 없는 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/mail.ogg"},"임무":{"voiceline":"임무네… 맘대로 하던가 해. 나랑은 관계 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/mission.ogg"},"임무완료":{"voiceline":"임무 보상… 내가 받아야지♪ 아니, 목록 뿐이잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/mission_complete.ogg"},"서약":{"voiceline":"결혼? 무슨 소리야? 이건 당신이 일방적으로 내게 '서약을 나눴으면 한다'고 해서 한 행동이고, 물론 동의하든 거부하든 선택은 내 마음대로… 어떻게 했으면 좋겠는지, 한 번 더 큰소리로 외쳐! 도망치지 말고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/propose.ogg"},"스킬":{"voiceline":"하하하하! 박살내주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/skill.ogg"},"터치1":{"voiceline":"뭐 재밌는 거라도 보고 있어? 어서 넘겨. 나도 보고 싶다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/touch.ogg"},"터치2":{"voiceline":"꺅?! 만지지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/touch2.ogg"},"입수시":{"voiceline":"흐음, 지휘관을 자칭하는 게 당신이란 말이지…. 흥! 지휘관이면 어쩔 건데! 그 직위, 내가 접수해주지! 어서 물러나라구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/unlock.ogg"},"강화성공":{"voiceline":"당연한 거 아니야? 나는 최강이니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"MVP는 나! 너무 당연해서 기쁘지도 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/win_mvp.ogg"},"전투개시_ex":{"voiceline":"아하하! 해치워 버려, 너희들!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/battle_ex.ogg"},"상세확인_ex":{"voiceline":"이런 것도 못 나르고, 당신 너무 허약한 거 아니야? ……후후후, 그런 점이 귀여운 거지만♪ 자, 잠깐, 어딜 도망가! 내가 잘못했으니까, 끝까지 같이 있어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔어♪ …어서 마중 안 나가고 뭐해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/expedition_ex.ogg"},"사랑_ex":{"voiceline":"당신은 내 거니까, 당연히 내가 말하는 건 뭐든 들어줄 거지? 지휘관이라고 불러주고 있고, 반지도 받아 줬고, 게다가 이렇게 데이트에도 어울려 주고 있으니까 말이야! 자, 어서 내 손을 잡으라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"동료들을 위로해주러 간다구? ……어서 다녀오도록 해. 당신은 내 소유물이니까, 맘대로 다른 데 가진 말라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"마중을 다 나오고, 매너는 있네. 자리로 돌아가서 계속 업무에 집중하라구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"임무 보상이야. 뭐, 당신 건 내 거나 다름 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"왜 그래? …사람 불러놓고 무시할 셈이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/touch_ex.ogg"},"터치2_ex":{"voiceline":"에, 에엣?!/////","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"바로 내가 MVP야♪ …날 보라구. …당신 말하는 거잖아! 잘 보고 칭찬하란 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['도이칠란트', '프리드리히 데어 그로세'] :  저 녀석은 내 거라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"비스마르크의 기재 보관소나 좀 뒤져볼까. …그럼 안 돼? 당신, 누구 편이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/main5_ex.ogg"},"메인6_ex":{"voiceline":"오늘도 수고 많았어. 이젠 그만 쉬어도 돼. ……방금 건 그냥 혼잣말한 거야. 딱히 당신 따윈……. 그래! 당신은 내 거니까, 내가 쉬면 당신도……. 윽, 지금 당장 업무 멈추지 못해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"다른 애들이 여는 다과회에 가는 것보다, 당신이 다과회를 열어서 날 대접하란 말이야. 내가 비서함 따윌 해주고 있는데, 이 정도는 당연한 거 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499070/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":499071,"클뜯 함순이 id":49907,"함순이 이름":"프린츠 루프레히트","한글 함순이 + 스킨 이름":"드래곤의 용문 오르기?","영문 함순이 + 스킨 이름":"The Gate Dragon's Advent","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499071/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499071/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499071/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499071/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499071/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499071/shipyard.png","설명":"헤에, 이게 이스트 글림의 '춘절'이라는 거구나~ 아직 겨울인데, 봄 축하는 왜 하는 거래? 게다가 지휘관까지 이렇게 대대적인 준비에 어울려서… 으아?! 바, 방금 그거 뭐야?!","자기소개":null,"메인1":{"voiceline":"에기르가 말한 하늘을 나는 사자라도 보러 갈까? …내가 하늘을 난다고 하면 나는 거야! 너도 같이 보러 가는 거지! 당연한 거잖아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/main1.ogg"},"메인2":{"voiceline":"세뱃돈? 평소에 모항 운영한다는 사람이 자기 주머니 사정은 빠듯한 거야? …응? 나 준다고? 됐어! 메롱이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/main2.ogg"},"메인3":{"voiceline":"항상 날 무시하기만 하는 바보, 이거나 먹어라! 하하하! 폭죽에 놀라서 도망이나 치라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"넌 내 거니까 네가 열심히 준비한 것도 다 내 거야! 냠냠… 이건… 탕후루? 새콤달콤하고 꽤 맛있잖아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/detail.ogg"},"드랍 설명":{"voiceline":"헤에, 이게 이스트 글림의 '춘절'이라는 거구나~ 아직 겨울인데, 봄 축하는 왜 하는 거래? 게다가 지휘관까지 이렇게 대대적인 준비에 어울려서… 으아?! 바, 방금 그거 뭐야?!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"넌 내 거니까, 네겐 당연히 날 즐겁게 해줄 의무가 있어! 그래! 피래미 같은 인간, 루프레히트 님께 신춘의 모항을 안내해! 손을 잡고 내 앞에서 걸어! 그게 네 역할이잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"우리 모항인데 대체 이게 어떻게 된 일인지 잘 모르겠어…. 지휘관도 없고, 오지 말걸……. 으아?! 지, 지휘관?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"춘절'에는 잉어를 장식하고, 그 잉어가 용으로 변해… 하나도 이해가 안 가. 애당초 잉어가 어떻게 용이 된다는 거… 으아?! 이, 이게 무슨 일이야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/login.ogg"},"실패":{"voiceline":"지, 진 거야? 내가? 거짓말…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/lose.ogg"},"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관 녀석, 어디로 사라진 거지…. 으앗?! 부, 부르지도 않았는데 갑자기 말 걸지 말라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/touch.ogg"},"터치2":{"voiceline":"내, 내 모습이 어디가 어때서! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/touch2.ogg"},"입수시":{"voiceline":"헤에, 이게 이스트 글림의 '춘절'이라는 거구나~ 아직 겨울인데, 봄 축하는 왜 하는 거래? 게다가 지휘관까지 이렇게 대대적인 준비에 어울려서… 으아?! 바, 방금 그거 뭐야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499071/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"흥, 이겨줬다구! MVP를 따냈으니 당연히 보상이 있겠지?!","voicelink":"https://raw.g