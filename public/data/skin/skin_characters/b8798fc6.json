[{"클뜯 id":301910,"클뜯 함순이 id":30191,"함순이 이름":"스즈나미","한글 함순이 + 스킨 이름":"스즈나미","영문 함순이 + 스킨 이름":"Suzunami","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301910/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301910/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301910/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301910/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301910/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301910/shipyard.png","설명":"유구모급 구축함-스즈나미","자기소개":{"voiceline":"사쿠라 엠파이어 유구모급 10번함 스즈나미야. 그 대전에서는 전선에서 분발했지만, 딱히 이렇다 할 전과는 없었어. 앞으로는 열심히 노력해서 지휘관이랑 협력해서 적을 무찌르고… 다른 함선들이랑도 사이좋게… 지낼게…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/profile.ogg"},"메인1":{"voiceline":"눈으로 만든 곰이야. 가지고 싶으면 줄게. 여기 두고… 응, 스즈나미 대신 지휘관을 감시하게 해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/main1.ogg"},"메인2":{"voiceline":"음… 딸기빙수, 지휘관도 먹어 볼래? ……맛있어? 에헤헤… 아, 스즈나미, 지금 웃은 거 아니야. 잘못 본 거…야… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/main2.ogg"},"메인3":{"voiceline":"고양이… 스즈나미만 보면 도망가는데, 지휘관한테는 자기 발로 다가가고…… 하나도 안 부러워… 정말…이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/main3.ogg"},"전투개시":{"voiceline":"이렇게 모두 함께 출격하다니… 임무는 확실히 처리할 테니까 걱정하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/battle.ogg"},"상세확인":{"voiceline":"스즈나미에게 다가가기 힘들어서 계속 쳐다보고 있는 거야…? 응? 그냥 다가갈 타이밍을 재고 있는 것뿐이라고…? 딱히 싫은 건 아니지만… 익숙해지는 데 시간이 좀… 걸려……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/detail.ogg"},"드랍 설명":{"voiceline":"유구모급 구축함-스즈나미","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰팀이 돌아왔어. …스즈나미도 같이 마중하러 가자고? 응, 갈래.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/expedition.ogg"},"실망":{"voiceline":"미안, 지휘관. 역시 거리를 두는 편이 좋겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 쉬는 날에 동물원에 같이 가줄래? 지휘관이 있으면 동물들도 스즈나미를 피하지 않을 거야. 왜냐하면 지휘관은 따뜻…하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/feeling2.ogg"},"호감":{"voiceline":"응…? 스즈나미가 웃었…다고? 지휘관을 생각한 것뿐인데…… 그, 그런 눈으로 보지 마… 익숙하지 않아… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/feeling3.ogg"},"기쁨":{"voiceline":"스즈나미는 요즘 지휘관 옆에 있으면 심장이 두근두근 쿵쿵거려…… 긴장한 것도 아닌데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/feeling4.ogg"},"사랑":{"voiceline":"왜 다들 지휘관을 그렇게 좋아하는지 알 것 같아…… 스즈나미도 요즘 계속 곁에 있고 싶은데… 그러면 좀 곤란하지…? 아니면, 그냥 옆에 앉아버릴래… 왜냐하면 지휘관은 정말… 따뜻하거든… 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/feeling5.ogg"},"터치3":{"voiceline":"음…… 지휘관 손, 따뜻해서… 익숙해지지가 않네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 어서 와. 스즈나미가 차를 내려놨어. ……너무 차갑다고? 응, 얼음도 많이 넣었는데… 잘못 만든 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/home.ogg"},"hp 경고":{"voiceline":"불기운이……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘 업무 내용은 여기 정리해 뒀어. …응, 잘못 본 거 아니야. 많은 게 맞아. 그러니까 어서 시작해…… 스즈나미도 도와줄 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/login.ogg"},"실패":{"voiceline":"의장에 불이…… 어서 후퇴하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/lose.ogg"},"우편":{"voiceline":"지휘관, 우편을 전부 가지고 왔어. 스즈나미도 지휘관한테 편지… 써도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/mail.ogg"},"임무":{"voiceline":"지휘관, 아직 못 끝낸 임무를 여기서 더 늘리면 안 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/mission.ogg"},"임무완료":{"voiceline":"지휘관, 고생 많았어. 임무 보상은 확인했으니까, 잠깐 쉬어… 알았지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/mission_complete.ogg"},"서약":{"voiceline":"지휘관…… 이런 느낌, 스즈나미… 처음이야…… 정말, 정말 행복해…… 앞으로 매일매일 이렇게 행복해도… 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/propose.ogg"},"스킬":{"voiceline":"얼어붙어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/skill.ogg"},"터치1":{"voiceline":"……작은 동물들이랑 친해지는 방법, 스즈나미한테 알려줄래…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/touch.ogg"},"터치2":{"voiceline":"――?! 스, 스즈나미는 이런 스킨십… 익숙하지… 않아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/touch2.ogg"},"입수시":{"voiceline":"안녕, 지휘관. 사쿠라 엠파이어 소속 구축함, 유구모급 10번함 스즈나미야. 저기…… 잘 부탁…해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/unlock.ogg"},"강화성공":{"voiceline":"음, 강하게 만들어 줘서 고맙게 생각해. 일도 인간관계도… 더 열심히 해볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관, 이겼어. …스즈나미랑 동료들의 협력, 괜찮았…어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관, 스즈나미랑 같이 있어도 괜찮아? 스즈나미랑만 너무 오래 있으면 다들 가까이 오기 힘들어할 텐데…… 그렇지 않다고? 그럼… 다행이지만… 에헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301910/detail_e