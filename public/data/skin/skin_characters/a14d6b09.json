[{"클뜯 id":103160,"클뜯 함순이 id":10316,"함순이 이름":"볼티모어","한글 함순이 + 스킨 이름":"볼티모어","영문 함순이 + 스킨 이름":"Baltimore","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103160/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103160/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103160/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103160/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103160/shipyard.png","설명":"볼티모어급 중순양함-볼티모어,CA-68 ","자기소개":{"voiceline":"나는 볼티모어급의 네임쉽, 볼티모어. 해군조약의 제한을 받지 않고 건조된 1급 중순양함이기 때문에 당시의 최첨단 장비를 가지고 있었어. 이 함대에서 자유와 정의를 위해 활약할 수 있게 해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/profile.ogg"},"메인1":{"voiceline":"맡겨진 일은 열심히 할게. 지휘관의 부하라면 이정도 쯤은 아무것도 아니지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/main1.ogg"},"메인2":{"voiceline":"퀸시?! 기억과는 다른데… 다른 함선이 같은 이름을 썼다고 해도 이상하지 않은걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/main2.ogg"},"메인3":{"voiceline":"폭력만으로는 모든 분쟁을 해결할 수 없어. 지휘관, 내가 굳이 일깨워 주지 않아도 되겠지만 이 점을 잊지 말아줬으면 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/main3.ogg"},"전투개시":{"voiceline":"전함, 포메이션 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/battle.ogg"},"상세확인":{"voiceline":"할 수 있는 것, 해야 하는 것, 실제로 하는 것. 모두 취사선택이 필요해. 그러니 지휘관은 자신이 제일 잘 하는 일에 집중하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/detail.ogg"},"드랍 설명":{"voiceline":"볼티모어급 중순양함-볼티모어,CA-68","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료야, 지휘관. 마침 움직이고 싶었던 참이니 다음 번 의뢰에는 나를 보내줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/expedition.ogg"},"실망":{"voiceline":"지휘관, 좀 더 너그러워지는 것이 좋겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/feeling1.ogg"},"낯섦":{"voiceline":"마음 속에 정의가 있다면 입 밖으로 내지 않아도 나쁜 길을 걷지 않지. 지휘관도 계속 바른 길을 걷길 바라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/feeling2.ogg"},"호감":{"voiceline":"틀에 박힌 말은 하지 않아도 돼. 내가 뭘 더 해야하지? 지휘관이 괜찮다면 뭐든지 도와줄 수 있어. 그러니까 얼마든지 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/feeling3.ogg"},"기쁨":{"voiceline":"같이 쇼핑가자고? 알았어. 이런 사소한 건 얼마든지 맡겨줘. 그리고 나간 김에 데이트를… 물론… 잠, 잠깐만! \"데이트\"… 데이트?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/feeling4.ogg"},"사랑":{"voiceline":"어떡하지… 이런 자리는 역시 익숙하지 않아… 조금 더 여자답게 행동해야 하나… 아, 아냐. 역시 이건 내 문제니까! 정말이지, 지휘관 옆에 있으면 항상 허둥지둥이라니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 다친 데는 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/home.ogg"},"hp 경고":{"voiceline":"당황하지 말고 집중해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/hp_warning.ogg"},"로그인":{"voiceline":"자 지휘관, 일을 시작하도록 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/login.ogg"},"실패":{"voiceline":"정의로운 길에는 어려움이 따르는 법……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/lose.ogg"},"우편":{"voiceline":"지휘관, 연락이 왔어. 조금 더 자세히 확인 해 봐야 할 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/mail.ogg"},"임무":{"voiceline":"임무인가…… 좋아, 먼저 일람표부터 확인하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 도착했어. 개조와 수리에 쓸 수 있는 자금이 있으면 좋을텐데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/mission_complete.ogg"},"서약":{"voiceline":"응, 앞으로 지휘관과 함께 동고동락하고 영원한 사랑을 맹세할게… 그, 그리고 반지를 낀 다음엔 뭘 해야… 왜? 뭘 한다고? 아, 아아아아…////","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/propose.ogg"},"스킬":{"voiceline":"거리는 충분해… 섬멸 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/skill.ogg"},"터치1":{"voiceline":"산소 콜라를 가져다 준건가? 고마워…… 하~ 역시 이게 최고지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/touch.ogg"},"터치2":{"voiceline":"아?!…… 방금 그건 못 들은 걸로 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/touch2.ogg"},"입수시":{"voiceline":"내 도움이 필요한가? 나는 볼티모어. 그저 지나가던 중순양함이지… 하하, 장난이야… 볼티모어, 도착했다. 앞으로 잘 부탁해, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/unlock.ogg"},"강화성공":{"voiceline":"좋아, 점점 잘 맞고 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/upgrade.ogg"},"vote":null,"승리":{"voiceline":"너희들의 힘은 옳은 길에 써야해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관, 이렇게 많은 서류를 반나절 만에 다 처리한 거야? 와아⋯ 역시 대단해. 나도 더 열심히 해야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"후우⋯ 지휘관, 미안. 조금 피곤해서 그러는데, 기대도 될까? ⋯⋯응? 요즘 들어 내가 좀 느슨해진 것 같다고? 그, 그야… 지휘관이랑은 이제…… 그런 사이니까⋯! 그런 말을 들으니까 괜히 또 긴장되잖아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"마음껏 쓰다듬어도 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관, 잠깐 좀 보자…… 좋아! 다치진 않았네. 다음에 나갈 땐 나도 데려가 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"자, 지휘관. 일 시작하자! 정신 바짝 차려! 나도 같이할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"으…… 역시 커피는 나랑 안 맞아. 지휘관이 가지고 가. 난 역시 산소콜라가…… 크아~ 역시 이게 최고지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/touch_ex.ogg"},"터치2_ex":{"voiceline":"꺅?!…… 이, 이건 아직도 익숙하지가 않네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['위치타'] : 위치타, 너무 진심으론 하지 마. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/couple_encourage1.ogg"},{"voiceline":"['클리블랜드'] : 우리 둘, 잘 맞는 것 같은 느낌인데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관, 오늘은 날씨도 좋으니… 운동도 할 겸 잠깐 기분 전환하는 건 어때? 집무실에만 있으면 건강에 안 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/main5_ex.ogg"},"메인6_ex":{"voiceline":"브레머튼이 괜찮은 가게를 몇 군데 추천해 줬는데… 음, 같이 가볼래? 아, 지금은 힘들 것 같으면…… 테이크아웃이라도 해올까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관이 하고 싶은 거면 뭐든 같이 해줄게. 너의……으으, 역시 말로 하긴 어렵네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103160/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":n