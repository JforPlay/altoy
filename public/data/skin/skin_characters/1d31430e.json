[{"클뜯 id":9707060,"클뜯 함순이 id":970706,"함순이 이름":"호넷·META","한글 함순이 + 스킨 이름":"호넷·META","영문 함순이 + 스킨 이름":"Hornet META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9707060/shipyard.png","설명":"네가 함대 지휘관이야? 만나서 반가워! 요크타운급의 막내인 호넷이야! 언니들만큼은 아니지만, 나도 꽤 해… 아마도!","자기소개":{"voiceline":"이사회 함대 소속 제7 특수파견함대 요크타운급 항공모함 3번함인 호넷이야. 이게 내 원래 정체성이자, 태어났을 때부터 정해진 「설정」이지. 요크타운급에서는 막내지만, 실제로 「언니들」을 만나본 적은 없어… 이상하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/profile.ogg"},"메인1":{"voiceline":"지휘관, 아이스 커피 마실래? …굳이 번거롭게 얼음을 넣을 필요 없이, META화의 힘만 있으면 바로 해결이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/main1.ogg"},"메인2":{"voiceline":"지휘관, META화의 힘으로 구운 파인애플 피자, 먹어볼래~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/main2.ogg"},"메인3":{"voiceline":"아아… 마음껏 먹고 잘 수 있는 모항이라니… 정말 천국이 따로 없네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/main3.ogg"},"전투개시":{"voiceline":"준비가 끝나는 대로 시작하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/battle.ogg"},"상세확인":{"voiceline":"…뭘 멍하니 있냐고? 내가 언제! …그래, 잠깐 다른 생각 좀 했어. 요 몇 년 동안 일어난 일이나, 「언니들」 생각을 한 것뿐이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/detail.ogg"},"드랍 설명":{"voiceline":"요크타운급 항공모함·호넷<color=#92fc63> (1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"쿨쿨…… 의뢰가 끝난 것 같네… 잘 됐다…가 아니지! 어서 마중하러 가야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/expedition.ogg"},"실망":{"voiceline":"허상뿐인 장막 너머에는 처참한 현실이 기다리고 있다는 걸 잊지 마……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/feeling1.ogg"},"낯섦":{"voiceline":"주말? 아직 아무 계획 없어~ 아… 「언니들」이랑 같이 영화 보러 가자고? 굉장히 가고 싶기는 한데… 조금 상황이 어색해지지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/feeling2.ogg"},"호감":{"voiceline":"지휘관이 있는 모항은… 정말 따뜻한 곳이구나. 언니들에 대해 더 많이 알고 싶어! 두 사람이 있으니까 이 모항에도 재밌는 일들이 가득하겠지? 궁금해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/feeling3.ogg"},"기쁨":{"voiceline":"있잖아, 지휘관… 이 모항에서 보내는 일상도 어쩌면 또 다른 「장막」이 아닐까…? 뭐, 지금 이렇게 행복하니까, 그래도 별 상관은 없지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/feeling4.ogg"},"사랑":{"voiceline":"풉… 그냥 말해본 건데, 진짜로 그걸 과학부에 연구해달라고 했다고? 나도 도와줄까? META화 힘으로 폭발을 일으키는 건 자신 있어! …응? 그런 짓을 하면 근신 처분이라고? 농담이야~ 아하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/feeling5.ogg"},"터치3":{"voiceline":"왜 그래? 내 모자가 신경이 쓰이면, 직접 들어볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 다음에도 같이 출격하자! 언니들에게도 뒤지지 않을 활약을 보여줄 테니까…… 아마도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/home.ogg"},"hp 경고":{"voiceline":"윽… 좀 위험한데…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/hp_warning.ogg"},"로그인":{"voiceline":"있잖아, 지휘관. 날씨가 좋아서 잠깐 달리고 올까 하는데, 같이 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/login.ogg"},"실패":{"voiceline":"전황이 불리해…! 후퇴! 다들 후퇴해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/lose.ogg"},"우편":{"voiceline":"필살! 이사회 새츄레이션 배송!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/mail.ogg"},"임무":{"voiceline":"지휘관, 정신 차려! 오늘은 해야 할 일이 많다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/mission.ogg"},"임무완료":{"voiceline":"임무 완료~ 시원한 콜라라도 마시면서 쉬자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/mission_complete.ogg"},"서약":{"voiceline":"「장막」도 「설정」도 모두… 지휘관이 관심을 가져준 덕분에 별로 신경 쓰이지 않게 됐어. 적어도 지금은… 마음이 늘 지금 이 순간이 진짜라고 알려주니까, 이걸로 충분해. 그래서 말인데, 오늘을 기점으로 새로운 인생… 지휘관과 함께하는 인생을 시작할 거야! 앞으로는 늘 곁에 있을게, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/propose.ogg"},"스킬":{"voiceline":"둘리틀 공습·META! 발진!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/skill.ogg"},"터치1":{"voiceline":"걱정하지 마. 제어 장치가 있으니까, META 침식이 바깥으로 새어 나가지는 않아~ 뭣하면 직접 만져서 확인해 볼래? 재킷도 괜찮고, 반바지나 부츠도 괜찮아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/touch.ogg"},"터치2":{"voiceline":"응…?! 자, 잠깐! 음… 마음의 준비 좀 할게! ……조, 좋아! 와라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/touch2.ogg"},"입수시":{"voiceline":"네가 함대 지휘관이야? 만나서 반가워! 요크타운급의 막내인 호넷이야! 언니들만큼은 아니지만, 나도 꽤 해… 아마도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/unlock.ogg"},"강화성공":{"voiceline":"좋아! 언니들에게 한 걸음 더 가까워졌어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"헤헷, 어때? 내 화려한 승리!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9707060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex