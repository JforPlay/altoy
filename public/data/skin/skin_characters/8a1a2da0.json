[{"클뜯 id":802030,"클뜯 함순이 id":80203,"함순이 이름":"기샹","한글 함순이 + 스킨 이름":"기샹","영문 함순이 + 스킨 이름":"Guichen","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/802030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/802030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/802030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/802030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/802030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/802030/shipyard.png","설명":"드 그라스급 경순양함 - 기샹","자기소개":{"voiceline":"드 그라스급 경순양함 기샹이야. 보다시피 미건조함이라 함력 하나 없는 평범한 마녀야. 대단한 걸 해주진 못하겠지만, 살 공간을 마련해 준만큼 열심히 해볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/profile.ogg"},"메인1":{"voiceline":"아이리스 출신이라고 다들 신앙심이 깊은 건 아니야. 그렇게 생각하는 걸 분명… '고정관념'이라고 하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/main1.ogg"},"메인2":{"voiceline":"사무일보단 '마법' 쪽이 더 자신 있어. 주문을 걸거나, 신비로운 약을 만들거나, 빗자루를 타고 하늘을 날거나…… 어머, 믿어 주는구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/main2.ogg"},"메인3":{"voiceline":"기도든 주문이든 그걸로 만족감을 느낀다면 엉터리라고 할 수 없어. 오히려 진심으로 믿기 때문에 사람들은 기적을 낳고는 하지…… 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/main3.ogg"},"전투개시":{"voiceline":"어쩔 수 없네~ 잠깐만이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/battle.ogg"},"상세확인":{"voiceline":"뛰어난 기술은 '마법'으로도 보이지만, 고귀한 인간의 기적 또한 '비적'으로 다뤄지고는 하지. 하늘이 아닌 인간의 위업, 너무 멋지지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/detail.ogg"},"드랍 설명":{"voiceline":"드 그라스급 경순양함 - 기샹","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 애들이 허브를 가지고 와 주기도 하나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/expedition.ogg"},"실망":{"voiceline":"괜찮아, 지휘관이라면 이 정도는 금방 만회할 수 있잖아…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/feeling1.ogg"},"낯섦":{"voiceline":"아이리스 리브레의 마녀…라고 하면 좀 어폐가 있겠네. 나는 어디까지나 함선이고, 지휘관에게는 부하 중 하나에 지나지 않으니까. 우후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/feeling2.ogg"},"호감":{"voiceline":"방에 이상한 솥이 있다는 소문…? 뭐, 분명히 허브를 졸이려고 가져다 둔 솥이 있기는 한데… 어떤 게 소문으로 퍼진 거지? 솥에 든 것 때문일까… 아니면 기샹 때문인 걸까… 후후후, 궁금해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/feeling3.ogg"},"기쁨":{"voiceline":"마녀의 방에 온 걸 환영해. 생각보다 평범하다고? 그야 그렇지. 지휘관은 날 마녀라기보단 동료 중 하나로 대해주잖아. 혹시 마녀다운 모습을 보여줬으면 한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/feeling4.ogg"},"사랑":{"voiceline":"지휘관도 알다시피 마녀는 '기적'을 만든다기보다 '마음'을 어지럽히는 게 특기야. 그래, 지금부터 사랑의 '마법'이 어떤 건지, 그 진수의 일부를 지휘관에게 보여줄게. 지휘관의 마음을 빼앗아서 말이야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어. 전과보다 뭐 재밌는 발견 같은 건 없었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/home.ogg"},"hp 경고":{"voiceline":"이건 좀 난감한데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/hp_warning.ogg"},"로그인":{"voiceline":"업무에 열심이네. 나도 그 정도로 '마법' 연구에 힘을 쏟으면 좋겠지만 말이지. 우후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/login.ogg"},"실패":{"voiceline":"진심으로 하면 들키니까, 이 정도만 할게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/lose.ogg"},"우편":{"voiceline":"아직 확인하지 않은 우편이 있어. 설마 아껴서 읽으려는 거야? 대체 왜?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/mail.ogg"},"임무":{"voiceline":"미완료된 임무가 있어. 방치해두면 어느샌가 사라져 버리는 것도 있는데, 진짜 괜찮아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/mission.ogg"},"임무완료":{"voiceline":"아직 미수령한 보상이 있어. 그래도 방치하면 진짜 도망갈걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/mission_complete.ogg"},"서약":{"voiceline":"응? 몸이 안 움직인다고? 우후후, 왜일까? 이 상태가 오래가진 않으니까 빨리 내 말대로 해줘. 자, 기샹이 준비한 지휘관과의 커플 반지, 어서 껴봐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/propose.ogg"},"스킬":{"voiceline":"마법일까, 함포일까? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/skill.ogg"},"터치1":{"voiceline":"고민 있어? 나라도 괜찮다면 딱히 상관없지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/touch.ogg"},"터치2":{"voiceline":"그러고 보니 마녀가 사람을 습격한다는 전설도 있었지… 관심 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/touch2.ogg"},"입수시":{"voiceline":"경순양함 기샹이야. 당신에게 하늘의 가호가 깃들기를… 뭐, 내가 그렇게 말해봤자 별 소용은 없겠지만. 후후후. 난 아이리스 리브레 소속의 보잘것없는 마녀야. 지휘관, 앞으로 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/unlock.ogg"},"강화성공":{"voiceline":"주문보다는 효과적일 것 같네, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어머, 내가 1위? 이렇게 너무 나만 봐주면, 주변에서 질투할 텐데♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"사랑의 '마법'이라고 알아? 그건 말이지… 사랑하는 사람을 위해서라면 뭐든 할 수 있는 기적을 말하는 거야. 우후후, 지휘관도 그런 멋진 '마법'을 쓸 수 있어. 나를 사랑해 주기만 하면… 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀 애들이 슬슬 돌아올 시간이네. 재료 보충하기 딱 좋은 타이밍이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/expedition_ex.ogg"},"사랑_ex":{"voiceline":"수상한 마법으로 속수무책으로 몸의 자유를 빼앗기고 마녀에게 몸을 농락당하는 불쌍한 지휘관…… 흔히 볼 수 있을 것 같은 설정이지? 우후후, 그럼 지휘관이 움직이지 못하는 동안 이것저것 시험해 봐도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"항상 난 지휘관이 돌아오기만을 기다려. 전과뿐 아니라 흥미로운 이야기도 많이 가지고 와 주잖아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘은 왠지 평소보다 컨디션이 좋다고? …글쎄? 왜 그럴까? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"연애 상담이 필요한 거라고 생각할게~ 우후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/touch_ex.ogg"},"터치2_ex":{"voiceline":"덮쳐 달라고? 나는 어느 쪽이든 상관없는데♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"지휘관의 든든한 지원 덕에 얻은 1위야. 딱히 내 '마법'의 힘 덕분만은 아니라구, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['아우구스트 폰 파르제팔'] :  어디 실력 한번 볼까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/couple_encourage1.ogg"},{"voiceline":"['에레버스', '베아른', '로피니아트르'] :  나도 좀 진심으로 가볼까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"신뢰는 중요하지만 맹신하는 건 좋지 않아. 아무리 나라도 '상처 입은 사람이 바르면 상처가 아무는' 약은 만들 수 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/802030/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_