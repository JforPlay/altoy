[{"클뜯 id":101340,"클뜯 함순이 id":10134,"함순이 이름":"헤이즐우드","한글 함순이 + 스킨 이름":"헤이즐우드","영문 함순이 + 스킨 이름":"Hazelwood","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101340/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101340/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101340/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101340/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101340/shipyard.png","설명":"플레처급 구축함 – 헤이즐우드(DD-531)","자기소개":{"voiceline":"나, 그 대전에선 모두와 함께 여기저기서 활약해서, 꽤 '경험이 풍부' 한 편이었어! 그 다음에, '예비 전투기 지휘함' 을 담당했었지! '전투기 지휘함' 이 뭐냐고? 에에, 으음…항공모함 언니들이 놔둔 함재기에게 방향을 알려주는 거였던가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/profile.ogg"},"메인1":{"voiceline":"선탠 자국은 열심히 운동한다는 증거니까 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/main1.ogg"},"메인2":{"voiceline":"부시 언니, 멍하니 있지 말고 밖에 나가자아~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/main2.ogg"},"메인3":{"voiceline":"모항에서 운동회같은 걸 할 수 있으면 좋을 텐데……나, 자매함 중에선 제일 빠를 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/main3.ogg"},"전투개시":{"voiceline":"좋아~! 다 함께 가자~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/battle.ogg"},"상세확인":{"voiceline":"후하~ 기분 좋아! 오늘도 햇살이 따뜻하네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/detail.ogg"},"드랍 설명":{"voiceline":"따라잡았다! 헤헤, 나는 플래처급의 헤이즐우드야, 잘 부탁해!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었다고? 지금 마중 나갔다 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/expedition.ogg"},"실망":{"voiceline":"다들, 지휘관에게 가까이 안 가는 게 좋다는데……왜 그러지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/feeling1.ogg"},"낯섦":{"voiceline":"이 함대에도 달리는 걸 좋아하는 아이가 있구나. 그니까 다음에 그 아이들이랑 시합이라도 하자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/feeling2.ogg"},"호감":{"voiceline":"햇빛을 쐬면 굉장히 안심이 돼! 지휘관도 같이 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/feeling3.ogg"},"기쁨":{"voiceline":"오늘은 햇님이 안 나오네……흐흠! 지휘관이랑 찰싹 달라붙어 있으면 전혀 우울하지 않은 걸! 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/feeling4.ogg"},"사랑":{"voiceline":"찾았다 지휘관~! 흐흐흥~♪……달라 붙으면 지휘관이 곤란해 한다고? 그치만 기분 좋은걸……조금만이라면 괜찮다고? 아싸~! 흐흐흥~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"피곤해? 내가 좀 풀어줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/home.ogg"},"hp 경고":{"voiceline":"무, 무섭지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/hp_warning.ogg"},"로그인":{"voiceline":"나이스 타이밍~ 난 준비운동 다 끝났어~ 같이 나가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/login.ogg"},"실패":{"voiceline":"더 이상은 무리야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/lose.ogg"},"우편":{"voiceline":"어때? 나, 편지 가져오는 속도는 최고라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/mail.ogg"},"임무":{"voiceline":"모두가 함께 있으면, 아무리 임무가 많더라도 무섭지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/mission.ogg"},"임무완료":{"voiceline":"오오! 또 임무를 하나 완료했어! 지휘관, 굉장해~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101340/mission_complete.ogg"},"서약":{"voice