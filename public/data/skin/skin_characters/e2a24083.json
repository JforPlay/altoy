[{"클뜯 id":403010,"클뜯 함순이 id":40301,"함순이 이름":"아드미럴 히퍼","한글 함순이 + 스킨 이름":"아드미럴 히퍼","영문 함순이 + 스킨 이름":"Admiral Hipper","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403010/shipyard.png","설명":"아드미랄 히퍼급 중순양함 - 아드미랄 히퍼","자기소개":{"voiceline":"과학의 나라의 중순양함, 아드미랄 히퍼야. 이름은 불패의 제독 '프란츠 폰 히퍼' 에서 따온 거야. 다양한 전투에 참가해 전력을 다했지만! 뭐? 바렌츠 해? 그건 쿠메츠 제독이 당신보다 좀 더 바보 같아서 그랬던 것뿐이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/profile.ogg"},"메인1":{"voiceline":"블뤼허, 이번에야 말로 반드시 지켜줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/main1.ogg"},"메인2":{"voiceline":"설마 당신 같은 허접이, 이 나와 순양함의 지휘기술을 겨룰 수 있다 생각해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/main2.ogg"},"메인3":{"voiceline":"하아? 슈바인스학세랑 맥주 준비는 아직이야? …몇 인분이냐고? 이 바보야! 네 뇌는 폼으로 달고 다니는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/main3.ogg"},"전투개시":{"voiceline":"이런 거, 유틀란트 해에 비하면 애들 장난하는 정도지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/battle.ogg"},"상세확인":{"voiceline":"이 바보야, 뭘 보는 거야! 빨리 내 방에서 나가라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/detail.ogg"},"드랍 설명":{"voiceline":"아드미랄 히퍼급 중순양함 - 아드미랄 히퍼","voicelink":null},"의뢰 완료":{"voiceline":"이 얼간아! 뭘 잊었는지 아직도 생각이 안 나는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/expedition.ogg"},"실망":{"voiceline":"이 쓰레기가! 내 눈 앞에 나타나지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/feeling1.ogg"},"낯섦":{"voiceline":"하아? 이런 것도 제대로 못 하다니, 너 바보야? 잠깐 나한테 줘봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/feeling2.ogg"},"호감":{"voiceline":"하아?! 내가 걱정된다고? 너 같은 바보한테 걱정받아도 전혀 안 기쁘다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/feeling3.ogg"},"기쁨":{"voiceline":"하?! 누가 널 좋아하게 된다는 거야! 오이겐 녀석이 너랑 밥 먹고 싶다 그래서 따라가는 거라고! 이 바보야! 착각하지 말라고!! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/feeling4.ogg"},"사랑":{"voiceline":"하?! 누가 널 사랑한다는 거야! 나, 나는 출격해서 어쩌다 보니 주운 걸 규정대로 상관에게 넘겨준 것뿐이라고! 하!? 반지?! 그따위 걸 누가 한다는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"바보야! 돌아왔는데 왜 만나러 안 오는 거야! 하아? 누가 너 따위를 걱정한다는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"얼간아, 이제 일어났냐? 하아? 뭘 히죽히죽 거리고 있어! 모항을 산책하다 우연히 본 것뿐이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/login.ogg"},"실패":{"voiceline":"이 무슨 굴욕적인…! 분하다…!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/lose.ogg"},"우편":{"voiceline":"얼간아! 새 편지가 와 있는데 눈치 못 챈 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/mail.ogg"},"임무":{"voiceline":"바보야! 한창 임무 중에 한눈파는 거 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/mission.ogg"},"임무완료":{"voiceline":"바보야! 임무가 완료되면 보수를 받아오라고! 뭘 내 앞에서 자랑하고 앉아있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/mission_complete.ogg"},"서약":{"voiceline":"하?! 왜 이런 걸 하지 않으면 안되는 건데! …뭐, 뭐 좋아, 모처럼 오늘은 기분도 좋으니 끼워주어도…죽을 때까지 날 돌봐주겠다고? 흥! 그런 건 당연하잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/propose.ogg"},"스킬":{"voiceline":"하아? 누가 저항해도 좋다 그랬어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/skill.ogg"},"터치1":{"voiceline":"하아? 만지는 걸 허락한 기억은 없는데 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/touch.ogg"},"터치2":{"voiceline":"하아?!?! 이런 허접바보멍청이얼간아!! 죽어버려! 킬만 앞바다에 가라앉아버려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/touch2.ogg"},"입수시":{"voiceline":"하아? 당신이 지휘관? 이런 어디서 굴러먹던 개뼈다귀 같은 놈한테도 지휘관을 시켜준다니, 전황이 이제 그 정도로 절박해진 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/unlock.ogg"},"강화성공":{"voiceline":"하아?! 이 내가 감동이라도 할 거라 생각하는 거야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥! 뭐 오늘만 칭찬하는 걸 허락해주도록 할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['프린츠 오이겐'] : 오이겐! 누가 빨래판 츤데레라는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/couple_encourage1.ogg"},{"voiceline":"['글로우웜'] : 글로우웜, 해치워버리라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403010/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0},{"클뜯 id":403012,"클뜯 함순이 id":40301,"함순이 이름":"아드미럴 히퍼","한글 함순이 + 스킨 이름":"햇빛 아래의 온천 거리","영문 함순이 + 스킨 이름":"Sunshine by the Hot Spring","스킨 타입":"Summer Fest","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403012/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403012/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403012/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403012/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403012/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403012/shipyard.png","설명":"어, 어때? 이 기모노… 잘 어울려? …그, 그래? 어울리는 거야 당연히 잘 알지! 당신이 칭찬해봤자 딱히… 따, 딱히 아무렇지도 않다고!","자기소개":null,"메인1":{"voiceline":"이 기모노는 유명한 거라고 하던데, 염색의 농도를 자유자재로 다루는 장인의 기술… 정말 대단하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/main1.ogg"},"메인2":{"voiceline":"온천에 몸을 담근 후에 쐬는 바람은 상쾌하지. 달아오른 몸을 적당히 식혀줘서 좋아. 당신도 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/main2.ogg"},"메인3":{"voiceline":"흥! 오이겐은 '온천 데이트해서 좋겠네'라고 놀렸지만, 난 딱히 신경 안 써! 그 대신, 나중에 온천 다녀온 거 엄청 자랑해서 복수해 줄 거야. 온천, 진짜 기분 좋더라~하고 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/main3.ogg"},"전투개시":{"voiceline":"덕분에 땀 좀 흘리겠네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/battle.ogg"},"상세확인":{"voiceline":"아까부터 묘하게 시선이 느껴지는데…. …저, 적당히 좀 쳐다봐! …뭐?!?! 보다가 넋을 잃었다니… 갑자기 무슨 소리를 하는 거야, 이 바보!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/detail.ogg"},"드랍 설명":{"voiceline":"어, 어때? 이 기모노… 잘 어울려? …그, 그래? 어울리는 거야 당연히 잘 알지! 당신이 칭찬해봤자 딱히… 따, 딱히 아무렇지도 않다고!","voicelink":null},"의뢰 완료":{"voiceline":"월 까먹었는지 아직도 모르겠어? …아니야! 내가 가보고 싶은 가게 말하는 게 아니라, 의뢰 말이야, 의뢰!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"말해두지만, 여긴 내가 오고 싶어서 온 게 아니라, 평소에 업무로 피곤한 당신에게 주는 포상이야. …뭐? 히퍼도 즐거워 보인다고? 따, 딱히 당신이랑은 상관없잖아?! 내게도 당신과 함께 온천 거리를 즐길 권리 정도는 있다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"휴, 돌아왔네. 식사를 마치고 온천에 다시 들어가자. 당신도 지쳤을 테고, 보고 있던 나도 지쳤으니까 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘은 어느 온천 가볼래? 많이 돌아다녀서, 오이겐네에게 들려줄 이야깃거리를 많이 만들고 싶어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/login.ogg"},"실패":{"voiceline":"이런 걸 이야깃거리로 삼을 순 없다고…. 윽…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/lose.ogg"},"우편":{"voiceline":"우편이 와 있어. 아, 이 엽서 예쁘네. …어서 내용을 확인해 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/mail.ogg"},"임무":{"voiceline":"가고 싶은 곳이 있더라도 지금은 임무에 집중해야지! 나도 참고 있는 거 몰라?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/mission.ogg"},"임무완료":{"voiceline":"아, 네네~ 임무가 완료됐네~ 잘됐네. …어서 우리 보상이나 받으라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"뭐야?! 갑자기 그렇게 손을 잡으면 깜짝 놀라잖아! 적어도 한 마디라도 건넨 다음에 하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/touch.ogg"},"터치2":{"voiceline":"그렇지? 당신도 이 무늬가… 앗?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/touch2.ogg"},"입수시":{"voiceline":"어, 어때? 이 기모노… 잘 어울려? …그, 그래? 어울리는 거야 당연히 잘 알지! 당신이 칭찬해봤자 딱히… 따, 딱히 아무렇지도 않다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/unlock.ogg"},"강화성공":{"voiceline":"이 정돈 당연한 거 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼어. 흥, 오늘 정도는 당신 덕분이라고 특별히 말해주지 뭐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403012/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"여름 축제","상점 id":70693,"상점 카테고리 id":10,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":0}]