[{"클뜯 id":299040,"클뜯 함순이 id":29904,"함순이 이름":"드레이크","한글 함순이 + 스킨 이름":"드레이크","영문 함순이 + 스킨 이름":"Drake","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/299040/shipyard.png","설명":"중순양함-—드레이크 ","자기소개":{"voiceline":"나는 로열 네이비의 중순양함, 드레이크야. 어쩌면 내가 낯설지도 모르겠지만, 괜찮아. 앞으로 있을 전투에 내 9.2인치 포가 충분히 강렬한 인상을 남길 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/profile.ogg"},"메인1":{"voiceline":"함선을 무장시키는 것은 장갑, 포, 어뢰이고 사람을 무장시키는 것은 담력과 식견, 학식이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/main1.ogg"},"메인2":{"voiceline":"예절을 싫어하지도 않고, 어느 정도 예의 차리는 것도 반대는 하지 않지만 허례허식은 자제하는 게 좋겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/main2.ogg"},"메인3":{"voiceline":"잘 짜인 사과즙보다 이슬에 젖은 사과가 더 매력적이야. 너도 그렇게 생각하지!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/main3.ogg"},"전투개시":{"voiceline":"후후후, 제대로 놀아볼까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/battle.ogg"},"상세확인":{"voiceline":"위대한 일에는 모두 시작점이 있지, 하지만 끝까지 해내야만 진정한 영광을 누릴 수 있어——그러니까 계속 노력하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/detail.ogg"},"드랍 설명":{"voiceline":"중순양함-—드레이크","voicelink":null},"의뢰 완료":{"voiceline":"역시 의뢰를 하는 것보다 적에게서 빼앗아 오는 게 더 짜릿한데… 아, 별 거 아냐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/expedition.ogg"},"실망":{"voiceline":"몇 번 정도는 마음에 담아두지 않겠지만, 계속 이렇게 나오면 나도 봐주지는 않겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/feeling1.ogg"},"낯섦":{"voiceline":"전장에서는 수단에 얽매일 필요가 없어. 꼼수를 쓰든, 정면으로 돌파하든 정의를 말할 자격은 최후의 승자에게 있거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/feeling2.ogg"},"호감":{"voiceline":"너도 모험에 관심이 있어? 잘 됐다. 마침 파트너가 필요한 참이었어. 말해봐. 바다 속에 있을 황금을 찾고 싶어? 아니면 먼 곳의 신비한 나라에 가보고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/feeling3.ogg"},"기쁨":{"voiceline":"음… 같이 모험하는 것도 좋지만, 요즘 다니는 곳은 너무 가깝지 않았나? 모항 아니면 근해였으니까…… 솔직히 조금 따분해. 다음 번에는 좀 더 먼 곳으로 데려가 주겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/feeling4.ogg"},"사랑":{"voiceline":"그렇구나. 너는 여행의 종착지보다 함께한 동료를 더 신경 쓰는구나. 그러니까, 나와 함께라면 어딜 가든 상관 없다는 거네! 그렇지, 아하하… 응? 잠시만, 이건 그러니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"작전 수고했어. 마침 포도를 준비했는데, 먹을래? …자 그럼 잘 받아! 히얍!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/home.ogg"},"hp 경고":{"voiceline":"쯧, 잔재주를 부리긴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/hp_warning.ogg"},"로그인":{"voiceline":"왔구나. 오늘은 뭐 부터 할까? 작전 연구도 좋고, 출격해도 괜찮다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/login.ogg"},"실패":{"voiceline":"오늘의 굴욕은 잊지 않겠어… 두고 보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/lose.ogg"},"우편":{"voiceline":"우편이야. 혹시 보물같은 소식이 섞여 있지 않을까? 하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/mail.ogg"},"임무":{"voiceline":"얌전히 임무를 수행하는 건 내 스타일이 아니지만, 음… 일단 보수를 확인해볼까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/mission.ogg"},"임무완료":{"voiceline":"임무 보수가 적지는 않지만, 위에서 주는 보상은 조금 부족한 거 아닐까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/mission_complete.ogg"},"서약":{"voiceline":"이상하지 않아? '정복당한' 것도 아니고, '못마땅'한 것도 아니고, 단순히 '수치'스러운 이 상황…… 전부 너 때문이야. 이건 나 같지 않다고. 하지만 나도 이런게 싫지는 않아… 응, 그래. 이해할 수 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/propose.ogg"},"스킬":{"voiceline":"날 원망하지는 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/skill.ogg"},"터치1":{"voiceline":"나는 직설적인 사람이 좋아. 그러니까 할 말이 있으면 해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/touch.ogg"},"터치2":{"voiceline":"호오~? 간이 꽤 크잖아~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관이지? 괜찮아 보이는걸~ 로열 네이비 중순양함 드레이크, 지금부터 너의 휘하로 들어간다! 먼저 하나 묻지, 출격 허가는 이미 준비 되었겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/unlock.ogg"},"강화성공":{"voiceline":"포관이 더 기분 좋은 소리를 내는 것 같아. 하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리는 언제나 즐겁네, 하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"그러니까, 이게 사랑하고 사랑 받는 느낌이구나? 상대를 빼앗거나 가지고 있는 것이 아니라 조금 긴장되네. 하지만 안심이 되기도 해… 참 신기하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/299040/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"대낮부터 뭘 하는 거야, 정말…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/au