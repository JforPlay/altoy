ne/102020/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 어른은 업무 중에 집중하지 않으면 안 된다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/feeling2.ogg"},"호감":{"voiceline":"롤리에 대해 알고 싶습니까? 응…… 이런 이야기를 하는 것은 지휘관이 처음입니다. 조금 기뻐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 요새 우쭐해지셨네요…… 하아…… 롤리에게도 책임이 있습니다만 좋아하는 사람을 너무 무르게 대한 것 같네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/feeling4.ogg"},"사랑":{"voiceline":"사적으로 선생님이라 부르는 것은 조금 이상하지만… 정말이지 뭘 기대하고 계신 겁니까? 지휘관도 정말 어린애 같네요… 개인 지도가 필요하신 건가요? (안경을 올린다)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 조금 전에는 잘 하셨습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"안녕하세요, 지휘관. 롤리는 계속 기다리고 있었다구요? 네, 슬슬 훈련 시간이네요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/login.ogg"},"실패":{"voiceline":"후우…… 위험했습니다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/lose.ogg"},"우편":{"voiceline":"새로운 편지는 정리했습니다. 확인해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/mail.ogg"},"임무":{"voiceline":"지휘관, 완료하지 않은 임무를 잊지 말아주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/mission.ogg"},"임무완료":{"voiceline":"보너스의 수령은 잊으시면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/mission_complete.ogg"},"서약":{"voiceline":"학생에게 이런 소중한 것을 받다니…… 이래서는 선생님 실격이네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102020/propose.ogg"},"스킬":{"voiceline":"교과서적인 움직임을 보여드리죠.","voicelink":"https://raw.githu