[{"클뜯 id":206070,"클뜯 함순이 id":20607,"함순이 이름":"알비온","한글 함순이 + 스킨 이름":"알비온","영문 함순이 + 스킨 이름":"Albion","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206070/shipyard.png","설명":"센토급 경항공모함 - 알비온","자기소개":{"voiceline":"로열 네이비 소속 경항공모함 알비온입니다. 센토 선배와 마찬가지로 대전 후에 건조되어, 그전에 만들어진 항공모함과는 다른 방법으로 운용되었죠. 이 함대 선배님들 밑에서 열심히 성장할 테니 지켜봐 주세요, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/profile.ogg"},"메인1":{"voiceline":"기분 전환이라면 역시 센토 선배와 함께하는 산림욕을 빼놓을 수 없죠. 특히 뒷산의 숲은 바람이 상쾌하답니다, 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/main1.ogg"},"메인2":{"voiceline":"동형함은 각자 다른 병장으로 운용하고 있어서, 전투 방식도 어쩌면 별 참고가 되지 않을지도 몰라요. 그래도 선배의 마음가짐을 배우는 것만으로도 큰 공부랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/main2.ogg"},"메인3":{"voiceline":"그레이 고스트…? 엔터프라이즈 선배와 똑같은 별명이기도 하고, 그렇게 거창한 건…… 지, 지휘관께서 괜찮으시다면 그렇게 부르셔도 상관 없긴 합니다만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/main3.ogg"},"전투개시":{"voiceline":"대담하게, 충실하게, 순조롭게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/battle.ogg"},"상세확인":{"voiceline":"제 겉모습이요? 센토 선배와는 달리 환상 속 존재의 이름은 아니지만, 굳이 말하자면 옛 전설상 이런 모습을 한 생물이 살았다고 일컬어지는 땅이 바로…… 아, 제가 말이 너무 길었나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/detail.ogg"},"드랍 설명":{"voiceline":"센토급 경항공모함 - 알비온","voicelink":null},"의뢰 완료":{"voiceline":"바람의 속삭임… 의뢰팀 동료들이 돌아왔군요. 마중 나갈 채비가 끝나시면 말씀 주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/expedition.ogg"},"실망":{"voiceline":"지휘관을 대하는 알비온의 태도… 대체 어떤 부분이 잘못된 걸까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/feeling1.ogg"},"낯섦":{"voiceline":"후배로서 선배님들의 전투, 그리고 지휘관의 함대 운영을 배워야 합니다. 기술부터 마음가짐, 함대에서의 행동거지도 포함해서 배울 점이 많으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/feeling2.ogg"},"호감":{"voiceline":"음… 구축함 선배님들은 혹시 다르게 불러야 하나요…? 그리고 특별계획함 분들도… 선배라는 점은 같지만, 어떻게 해야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 선배, 이 서류는 어디에 두면 될까요? 앗, 역시 좀 어색하긴 하네요… 지휘관께 선배라니 경의가 부족한 느낌이고, 게다가 왠지 위화감도 느껴지네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/feeling4.ogg"},"사랑":{"voiceline":"지휘관을 부르는 호칭은 음… 지휘관님? 선배님이라고 하면 좀 더 격의 없는 느낌이 있네요. 휴우, 지휘관과 더 가까워지고 싶은데 첫 단계인 호칭에서 막히다니… 일단은 다른 접근 방식을 시도해보는 편이 좋을 것 같네요. 우선은 데이트라던가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 수고 많으셨어요. 알비온이 뭐라도 도와드릴 수 있는 부분이 있다면 말씀해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/home.ogg"},"hp 경고":{"voiceline":"내가 열심히 하지 않으면 모두에게 폐를 끼치게 돼…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/hp_warning.ogg"},"로그인":{"voiceline":"경항공모함 알비온, 지휘관의 지시를 기다리고 있습니다. 언제든 말씀하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/login.ogg"},"실패":{"voiceline":"이럴 수가… 내가 바보같이 군 탓에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/lose.ogg"},"우편":{"voiceline":"새로운 우편이 온 것 같네요… 확인해보시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/mail.ogg"},"임무":{"voiceline":"같이 임무를 완수하러 가요. 함선들은 이렇게 지휘관 곁에서 성장한답니다. 네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/mission.ogg"},"임무완료":{"voiceline":"완수한 임무 보상이 도착한 것 같네요. 이건… 받기 전에 수신처가 잘못되지는 않았는지 확인하는 편이 좋겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/mission_complete.ogg"},"서약":{"voiceline":"서약… 반지? 저, 저, 지휘관께 반지를 조른 적은 단 한 번도…… 알비온이 좋아서 반지를 주는 거라구요? 네, 넵! 응! 그렇죠! 알비온이 너무 둔해서 지휘관의 마음을 헤아리지 못해 죄송해요. 에헤헤, 고마…워요♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/propose.ogg"},"스킬":{"voiceline":"선배님들, 지켜봐주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/skill.ogg"},"터치1":{"voiceline":"아, 네. 의장궁 말고도 볼일이 있으시다면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/touch.ogg"},"터치2":{"voiceline":"부, 부끄러워요…… 아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/touch2.ogg"},"입수시":{"voiceline":"경항공모함 센토급의 자매함, 알비온입니다. 앞으로 함대의 후배로서 잘 배우도록 하겠습니다——아, 지휘관도 포함해서 모두 저의 선배랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/unlock.ogg"},"강화성공":{"voiceline":"강화에 성공했습니다. 지휘관, 다음에 승차감은 어떤지 시험해보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 승리는 순백의 알비온의 것입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"센토 선배는 다른 선배님들을 보고 따라할 때가 많은데, 저는 어느 쪽이냐면 이론적으로 공부를 하는 타입이에요. 네, 지휘관처럼 두뇌 노동을 잘 한답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"지휘관, 의뢰팀이 귀환하고 있어요~ 후후후, 바람의 속삭임이 아니라 알비온의 속삭임이랍니다. 마음에 드시나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/expedition_ex.ogg"},"사랑_ex":{"voiceline":"지휘관, 알비온을 부르셨나요? 아뇨, 딱히 말로 안 하셔도 다 알아요. 지휘관과 연결되어 있는 마음, 지휘관의 생각이 담긴 바람의 속삭임이…… 아, 죄, 죄송해요. 저 혼자 들떠서… 저어… 잘 부탁 드립…니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"고생 많으셨습니다. 지휘관, 회고는…… 제게 맡기신다구요? 네, 부디 제게 맡겨주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"센토 선배처럼 비서함을… 아, 지휘관. 오늘 지시를 내려주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"호기심이 왕성한 지휘관께 어울려드리죠. 자, 알비온의 손을 잡으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/touch_ex.ogg"},"터치2_ex":{"voiceline":"네, 알비온과 지휘관은 마음이 이어져 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"휴우… 선배님들을 창피하게 하지 않기 위해서는 역시 평소에 노력을 게을리 하지 않는 것이 중요하죠. 순백의 알비온, 지휘관과 선배님들께 승리를.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['허미즈'] : 허미즈 선배, 뒤를 따르겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/couple_encourage1.ogg"},{"voiceline":"['센토'] : 센토 선배, 너무 무리하진 마세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"엔터프라이즈 선배는 정말 못하는 게 없는 사람이네요… 알비온이 더 나은 부분이라면 요리나 가사, 센토 선배처럼 숲에서의…… 어, 어머…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관, 괜찮으시다면 즐겨 읽으시는 책을 알려주시겠어요? 함대 동료들과 마찬가지로 선배인 지휘관에 대한 공부랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/main6_ex.ogg"},"메인7_ex":{"voiceline":"비서함 업무도 익숙해지니 자신이 생겨요. 이제 남은 건 업무에 어떻게 임할 것인가… 역시 지휘관의 업무를 분담하는 것부터…… 네, 그렇게 가볼게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/main7_ex.ogg"},"메인8_ex":null,"메인4_ex":{"voiceline":"저만의 전투 방식을 다른 아이들에게도 전수해줄 수 있다면, 함께 또 다른 전술을 실현할 수 있겠죠… 선배라고 불리고 싶다는 생각은 안 해요. 아마두요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206070/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":206071,"클뜯 함순이 id":20607,"함순이 이름":"알비온","한글 함순이 + 스킨 이름":"은빛 달 아래의 요정","영문 함순이 + 스킨 이름":"Silvermoon Faerie Princess","스킨 타입":"Halloween","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206071/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206071/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206071/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206071/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206071/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/206071/shipyard.png","설명":"아, 그… 그렇게 빤히 쳐다보시면… 아, 일단은 야행종 코스튬이라서요. 그… 지휘관? 일단은… 무릎을 꿇어주시겠어요?","자기소개":null,"메인1":{"voiceline":"요정인지, 흡혈귀인지, 아니면 서큐버스라고 해야 할지… 으음, 알비온의 정체성은 어떻게 되는 걸까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/main1.ogg"},"메인2":{"voiceline":"뱀파이어 선배에게 이것저것 배우는 것도 좋지만, 이런 모습으로 밖을 쏘다니는 건… 아, 지휘관께서 동행해주시면 괜찮을 거 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/main2.ogg"},"메인3":{"voiceline":"지휘관께 지시를 내리는 건 쉽지 않네요… 아무래도 역시 지휘관께서 알비온에게 이것저것 시키시는 편이 좋겠어요. 뭐든 괜찮다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"부, 부끄러운 모습을 보여드렸네요… 지휘관만 괜찮으시다면, 좀 더 역할에 몰입해드릴 수도 있어요. 그러면 저도 분발해서 지휘관을 짓밟고… 어디까지나 이건 역할일 뿐이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/detail.ogg"},"드랍 설명":{"voiceline":"아, 그… 그렇게 빤히 쳐다보시면… 아, 일단은 야행종 코스튬이라서요. 그… 지휘관? 일단은… 무릎을 꿇어주시겠어요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관, 알비온의 종이 되어 계속 알비온을 섬기세요. 그러면 알비온이… 에헤헤, 지휘관을 계속 계속 돌봐드릴게요. 요정이나 흡혈귀나 모두 오래 산다는 건, 계속 함께 있을 수 있다는 거나 마찬가지니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"전투 결과가 훌륭하네요. 아, 이럴 땐 거만한 태도로 말하는 편이 좋으려나요…? 그러니까… 그럭저럭이었네…요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘밤이야말로 지휘관을 내 종으로 삼고 말겠어요… 죄송하지만 지휘관, 그렇게 부탁드려도 될까요? (꾸벅)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"조금 조이는 부분이 있어서… 아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/touch.ogg"},"터치2":{"voiceline":"매혹되면 이렇게 되는군요. 기억해 둬야… 꺅///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/206071/touch2.ogg"},"입수시":{"voiceline":"아, 그… 그렇게 빤히 쳐다보시면… 아, 일단은 야행종 코스튬이라서요. 그… 지휘관? 일단은… 무릎을 꿇어주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando260