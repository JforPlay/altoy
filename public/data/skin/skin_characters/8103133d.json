[{"클뜯 id":307110,"클뜯 함순이 id":30711,"함순이 이름":"다이호(μ장비)","한글 함순이 + 스킨 이름":"다이호(μ장비)","영문 함순이 + 스킨 이름":"Taihou μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307110/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307110/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307110/shipyard.png","설명":"이 옷, 그리고 이 무대…… 후후, 후후후후…… 지휘관님의 마음은 결국 다이호의 차지랍니다… 아아, 지휘관님~ 다이호의 노래를 끝까지 들어주세요♡","자기소개":{"voiceline":"사쿠라 엠파이어의 기갑 항공모함 다이호, \"μ장비\" 테스트에 참여합니다… 후후후♡ 지휘관님이 원하신다면 다이호는 언제든 이 몸을 바칠 준비가 되어있답니다~ 물론 목숨까지도요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/profile.ogg"},"메인1":{"voiceline":"쯧, 춤이라는 것이 이렇게 어려울 줄이야… 지휘관님께 최고의 모습을 보여드리기 위해서는 제대로 레슨을 받아야겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/main1.ogg"},"메인2":{"voiceline":"메탈 블러드의 그 사람… \"치유계\"를 밀다니… 아무리 봐도… 전부 거짓말이겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/main2.ogg"},"메인3":{"voiceline":"지휘관님♡ 다이호의 레슨을 보러 오시다니… 다이호, 갑자기 의욕이 넘치는 것 같네요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/main3.ogg"},"전투개시":{"voiceline":"다이호의 매력에 푹 빠지도록 하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/battle.ogg"},"상세확인":{"voiceline":"원래는 솔로로 데뷔하고 싶었지만, 아이돌로서 공부해야 할 것도 많고 지휘관님의 부탁도 있었기 때문에… 그럼 일단 참아볼까요… 후후후♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/detail.ogg"},"드랍 설명":{"voiceline":"이 옷, 그리고 이 무대…… 후후, 후후후후…… 지휘관님의 마음은 결국 다이호의 차지랍니다… 아아, 지휘관님~ 다이호의 노래를 끝까지 들어주세요♡","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰조의 마중을 부탁드려도 될까요? …이글 유니온의 그 아가씨라면 분명히 어디에 숨어있다 놀래킬 것 같아서 말이죠…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/expedition.ogg"},"실망":{"voiceline":"설마 다이호가 아이돌에 어울리지 않는 건가요…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/feeling1.ogg"},"낯섦":{"voiceline":"지휘관님 외의 사람들 앞에서 춤추고 노래를 해야 하다니…… 아, 아니, 다이호가 아이돌을 하는 것은…… 어쨌든 지휘관님 때문이니까, 다시 말해서 아이돌 활동을 하는 것도 전부 지휘관님을 위해서예요! 이렇게 생각하면 아무런 문제가 없지요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/feeling2.ogg"},"호감":{"voiceline":"지휘관님♡ 다이호, 레슨을 너무 열심히 받아서 온 몸에 근육통이 생겼답니다~ 기숙사까지 데려다주실 수…… 아니, 지휘관님 방에서 쉬었다 가도록 해요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님♡ 다이호의 굿즈랍니다~ 판매하고 있는 것이 아니라 모.두. 지휘관님을 위해 특별히 만든 \"한정판\"이지요… 어떤 특.별.한 점이 있는지 궁금하지 않으신가요? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/feeling4.ogg"},"사랑":{"voiceline":"무대 위에서 빛나는 것 따위 다이호에게는 아무런 감흥도 없어요. 하지만 지휘관님께서 다이호의 그런 모습을 보고 싶다고 하신다면… 후후후♪ 그렇다면 다이호도 지휘관님을 위해서 뭐든지 해낼 거랍니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/feeling5.ogg"},"터치3":{"voiceline":"지, 지휘관님?! 아아, 다이호를 어린아이 취급하시다니… 후후♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님♡ 다이호의 레슨 성과를 보시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/home.ogg"},"hp 경고":{"voiceline":"지휘관님이 보고 계셔…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님~ 다이호는 오늘 무엇을 해야 하나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/login.ogg"},"실패":{"voiceline":"쯧, 벌레 따위가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/lose.ogg"},"우편":{"voiceline":"팬레터…? 지휘관님 말고 다른 사람을 신경 쓸 이유가 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/mail.ogg"},"임무":{"voiceline":"지휘관님을 위해서라면 다이호는 어떤 오퍼를 보내더라도 전혀 개의치… 아니, 기꺼이 하겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/mission.ogg"},"임무완료":{"voiceline":"후후후…… 다이호도 조금 발전했군요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/mission_complete.ogg"},"서약":{"voiceline":"지휘관님, 다이호의 새로운 무대를 어떻게 생각하세요? 이 의상은요? 그리고… 지휘관님이 지겹다고 하실 때까지 다이호는 계속, 계속 무대에서 가장 아름답게 빛날 거랍니다~ 아하하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/propose.ogg"},"스킬":{"voiceline":"벌레는 빠르게 박멸해야지요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/skill.ogg"},"터치1":{"voiceline":"후후♪ 이 자세는 역시 지휘관님에게도 매력적으로 느껴지겠지요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/touch.ogg"},"터치2":{"voiceline":"후후후, 가십 기사 같은 건 신경 쓸 필요 없답니다♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/touch2.ogg"},"입수시":{"voiceline":"이 옷, 그리고 이 무대…… 후후, 후후후후…… 지휘관님의 마음은 결국 다이호의 차지랍니다… 아아, 지휘관님~ 다이호의 노래를 끝까지 들어주세요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/unlock.ogg"},"강화성공":{"voiceline":"어서 지휘관님께 특훈의 성과를 보여드리고 싶네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"아하하하, 다이호의 사랑 앞에 굴복하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사