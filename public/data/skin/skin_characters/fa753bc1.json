[{"클뜯 id":903010,"클뜯 함순이 id":90301,"함순이 이름":"포슈","한글 함순이 + 스킨 이름":"포슈","영문 함순이 + 스킨 이름":"Foch","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903010/shipyard.png","설명":"비시아 성좌 쉬프랑급 중순양함—포슈","자기소개":{"voiceline":"나는 포슈, 쉬프랑급의 3번함이지만 동급 자매함들과는 크게 차이가 나. 심지어 그냥 \"포슈\"급이라고 해도 무리가 아니라고! 내가 잘하는 것은 아주 많아. 특별히 언급하진 않을게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/profile.ogg"},"메인1":{"voiceline":"대수롭지 않게 여기면 안 돼! \"이건 평화가 아니라, 기나긴 휴전이다\"… 하하, 전략가 같은 느낌이 들지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/main1.ogg"},"메인2":{"voiceline":"규칙적인 작업과 휴식은 업무의 고효율을 보장하지. 너무 자주 밤새면 안 돼, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/main2.ogg"},"메인3":{"voiceline":"알제리? 고양이 한 마리만 안겨다주면 이어지는 대화는 아주 쉬워질 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/main3.ogg"},"전투개시":{"voiceline":"정복의 의지가 있어야만 승리할 수 있지! 포슈, 출격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/battle.ogg"},"상세확인":{"voiceline":"지휘관, 나랑 뭐 좀 해줄 수 있어?…이 사과를 머리 위에 올려놔, 그리고…엣, 도망가지 마! 그냥 장난친 것뿐이라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/detail.ogg"},"드랍 설명":{"voiceline":"비시아 성좌 쉬프랑급 중순양함—포슈","voicelink":null},"의뢰 완료":{"voiceline":"새로운 물자가 도착했어. 지휘관, 직접 검사해볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/expedition.ogg"},"실망":{"voiceline":"이런 의지로는 모두를 데리고 승리를 얻지 못해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/feeling1.ogg"},"낯섦":{"voiceline":"백발백중의 포슈식 비도!… 이럴 수 있다면 좋을텐데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/feeling2.ogg"},"호감":{"voiceline":"내 앞에서 그렇게 진지할 필요 없어! 좀 더 편안하게 있어도 된다고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 또 밤새 야근했어? 아, 끼니도 제때 안 먹고! 이러면 안 돼!… 좋아, 앞으로 누나가 널 감독하겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 오늘 포슈랑 같이 저녁 식사해야 해! 에이, 내가 감독하겠다고 말했잖아~ 지휘관 막 거절하는 그런 무정한 사람은 아니겠지, 그렇지~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/feeling5.ogg"},"터치3":{"voiceline":"음… 너 때문에 머리 스타일이 망가졌잖아!… 하하, 농담이야, 나 화 안 났어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/headtouch.ogg"},"모항귀환":{"voiceline":"드디어 돌아왔구나, 지휘관! 업무 때문에 식사 시간을 잊어서는 안 돼! 정말로 시간을 낼 수 없다면, 내가 사전에 미리 맛있는 걸 준비해 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/home.ogg"},"hp 경고":{"voiceline":"두려워하지 마! 포슈가 여기 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 처리해야 할 서류들 정리해서 테이블에 뒀어… 그렇게 풀 죽어 있지 마, 내가 도와줄 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/login.ogg"},"실패":{"voiceline":"이 정도의 강화로는 역시 안 되나 봐…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/lose.ogg"},"우편":{"voiceline":"새로운 우편이 왔어! 먼저 열어봐 줄까~ 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/mail.ogg"},"임무":{"voiceline":"우수한 지휘관의 덕목 중 하나——제때 임무를 완성하는 것. 지휘관, 분발해야겠는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/mission.ogg"},"임무완료":{"voiceline":"임부 보상은 내가 대신 가져왔어. 나한테 신세진 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/mission_complete.ogg"},"서약":{"voiceline":"사실, 조금 긴장되기 시작했어…… 하지만 지휘관을 보면 이전의 불안함은 뒷전으로 밀려나버려~ 음, 내 대답은 \"승낙\"이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/propose.ogg"},"스킬":{"voiceline":"도망갈 생각은 하지 마, 주포 발사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/skill.ogg"},"터치1":{"voiceline":"곤란한 일이 생겼어? 누나한테 얘기해, 누나가 도울 방법을 생각해 볼게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/touch.ogg"},"터치2":{"voiceline":"우왓!? 이, 이렇게 애교를 부린다고!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/touch2.ogg"},"입수시":{"voiceline":"안녕~ 네가 바로 지휘관이지? 난 쉬프랑급의 포슈라고 해~ 난 전략 방면에 대한 지식이 아주 풍부해. 도움이 될 수 있으면 좋겠어~ 잘 부탁할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/unlock.ogg"},"강화성공":{"voiceline":"좀 더 많이 해줘도 돼~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"어때? 이게 바로 \"포슈급\"의 실력이라고! 맘껏 내게 의지해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":{"voiceline":"새로운 물자가 도착했어. 내가 이미 검사했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903010/expedition_ex.ogg"},"사랑_ex":{"voiceline":"지휘관, 이제 뭐할 거야? 히히, 별 거 아니고, 그냥 너랑 같이 저녁 먹고 싶어서. 이유는… 특별한 이유랄 것도 없는데? 하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/a