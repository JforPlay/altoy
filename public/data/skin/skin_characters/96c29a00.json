[{"클뜯 id":401200,"클뜯 함순이 id":40120,"함순이 이름":"Z20","한글 함순이 + 스킨 이름":"Z20","영문 함순이 + 스킨 이름":"Karl Galster (Z20)","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401200/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401200/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401200/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401200/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401200/shipyard.png","설명":"1936년형 구축함 - Z20 카를 칼스터","자기소개":{"voiceline":"난 메탈 블러드 해군 Z 클래스 구축함 1936년형 카를 갈스터. 동형함 중 유일하게 전쟁에서 살아남은 함선으로, 북쪽에 있는 나라로 넘어가서는 이름을 '프로치니' 로 바꿨어. 자매들과는 달리 혼자만 오래 사는 것도 꽤 힘들었지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/profile.ogg"},"메인1":{"voiceline":"지휘관, 달릴 때 호흡하는 법을 알려줄까? 전진할 때도 도망칠 때도 쓸 수 있다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/main1.ogg"},"메인2":{"voiceline":"기분만 좋으면, 어느 곳이든 다 좋은 곳이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/main2.ogg"},"메인3":{"voiceline":"'프로치니'? 아하하…그 이름은 부르기 없기야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/main3.ogg"},"전투개시":{"voiceline":"내가 기함? 좋아, 모두 따라와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/battle.ogg"},"상세확인":{"voiceline":"아픈 거 고민되는 거, 퓨~웅하고 날아가 버려랏~! 어때? 지휘관, 기운 나지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/detail.ogg"},"드랍 설명":{"voiceline":"1936년형 구축함 - Z20 카를 칼스터","voicelink":null},"의뢰 완료":{"voiceline":"흐흥~ 누군가가 돌아온 거 같은데? 마중 나가러 갈까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/expedition.ogg"},"실망":{"voiceline":"지휘관을 보면 피로가 확 몰려온다니까…잠깐 쉬러 갈게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/feeling1.ogg"},"낯섦":{"voiceline":"계속 달리다 보면, 고민도 괴로움도 전부 사라진다고. 그러니까 지휘관, 고민이 있을 때는 나한테 와도 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/feeling2.ogg"},"호감":{"voiceline":"왜 그래? 고민이 있다고? 마라톤이라도 하면 분명 상쾌해질 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/feeling3.ogg"},"기쁨":{"voiceline":"마음이란 건 말로 표현하지 않으면 남에게 전달되지 않을 때도 있는 거라고. 있잖아, 지휘관이라면 그정도는 알겠지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 벽창호……그래 그래, 그렇게 쌓아두지 않아도 되니까… 난 지휘관을 좋아한다구. 그래서, 지휘관은 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고해쪄! 어디 가서 릴렉스 하자구~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 나랑 같이 달리기 안 할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/login.ogg"},"실패":{"voiceline":"앗차~ 우연히 컨디션이 안 좋았을 뿐이야! 우연히~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/lose.ogg"},"우편":{"voiceline":"지휘관의 우편…아…이런 거 내가 열어보면 안 좋겠지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/mail.ogg"},"임무":{"voiceline":"임무 나가기 전에 달성 기념 파티 준비도 해놓자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/mission.ogg"},"임무완료":{"voiceline":"임무가 끝나면 달리기 대회! 이번엔 꼭 1등 할 거야~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/mission_complete.ogg"},"서약":{"voiceline":"그러고보니, 동방에는 첫날밤에 신랑 신부가 술잔을 주고받는 전통이 있다는데 말야… 아하하, 그렇게 부끄러워하지 않아도 된다니까~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/propose.ogg"},"스킬":{"voiceline":"전투 중에도, 웃는 얼굴이어야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/skill.ogg"},"터치1":{"voiceline":"응? 지휘관, 나랑 같이 잠깐 뛸래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/touch.ogg"},"터치2":{"voiceline":"후후후, 나 몸매 괜찮지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/touch2.ogg"},"입수시":{"voiceline":"카를 갈스터 참전! 지휘관, 내 부대 배치 파티는 어디야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/unlock.ogg"},"강화성공":{"voiceline":"아하하! 상쾌한 기분~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/upgrade.ogg"},"vote":null,"승리":{"voiceline":"하핫~식은 죽 먹기지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401200/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"N","ex_chat_status":0}]