ernando2603/AzurLane/main/audio/voiceline/205022/detail.ogg"},"드랍 설명":{"voiceline":"가장 좋은 기기 설비들이 모두 여기에 있군. 앞으로는 내 퍼포먼스로 폐하의 매력을 한층 더 돋보이게 하면…… 로열의 무대를 보여주도록 하지!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"오늘의 스케쥴은 맡겨두겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205022/login.ogg"},"실패":{"voiceline":"만약 조금 더 빨랐더라면…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205022/lose.ogg"},"우편":null,"임무":{"voiceline":"이 오퍼… 일러스트리어스 일행에게 더 알맞지 않을까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205022/mission.ogg"},"임무완료":{"voiceline":"임무 보상이다. 체자레가 가져다 줬을 줄이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205022/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"기기 장비 조정에 도움이 필요한가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205022/touch.ogg"},"터치2":{"voiceline":"…경비대를 불러야 하나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205022/touch2.ogg"},"입수시":{"voiceline":"가장 좋은 기기 설비들이 모두 여기에 있군. 앞으로는 내 퍼포먼스로 폐하의 매력을 한층 더 돋보이게 하면…… 로열의 무대를 보여주도록 하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205022/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"(작은 소리) 너무 과했던 거 아닐까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205022/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"Live","상점 id":70438,"상점 카테고리 id":11,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":900,"기간":"상시","진영":"HMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":205023,"클뜯 함순이 id":20502,"함순이 이름":"워스파이트","한글 함순이 + 스킨 이름":"올드 레이디의 수박 자르기","영문 함순이 + 스킨 이름":"The Grand Old Lady Sunders All","스킨 타입":"Ninja Castle","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205023/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205023/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205023/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205023/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205023/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205023/shipyard.png","설명":"합! 흠… 깔끔하게 반으로 잘렸네. 사쿠라 엠파이어의 수박 자르기 기술… 생각보다는 마스터하기 쉬운데…… 지휘관, 마침 잘 왔어. 이 수박들, 다들 먹을 수 있게 나누어 주지 않을래?","자기소개":null,"메인1":{"voiceline":"……사쿠라 엠파이어에는 눈을 가리고 수박을 쪼갠다고? 흠, 다시 하는 건 상관 없는데…… 처음 몇 번 정도는 표적이 빗나갈지도 모르겠네. ……그냥 이대로 하는 편이 좋겠다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/main1.ogg"},"메인2":{"voiceline":"동료들에게 가져다 줄 때 폐하 몫은 이게 씨가 적으니까, 이걸로 부탁할게. 아, 그리고 가능하면 씨를 빼줬으면 하는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/main2.ogg"},"메인3":{"voiceline":"누가 더 깔끔하게 수박을 쪼개는지 나랑 겨뤄볼래? 후후, 안 그래도 지휘관이 얼마나 검을 잘 다루는지 궁금했었거든♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"주위에 있는 대나무랑 볏짚? 음, 일단 실전을 치르기 전에 시험 삼아 잘라뒀어. 목검은 평소 다루는 무기와는 느낌이 전혀 다르니까. 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/detail.ogg"},"드랍 설명":{"voiceline":"합! 흠… 깔끔하게 반으로 잘렸네. 사쿠라 엠파이어의 수박 자르기 기술… 생각보다는 마스터하기 쉬운데…… 지휘관, 마침 잘 왔어. 이 수박들, 다들 먹을 수 있게 나누어 주지 않을래?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"사실은 이렇게 같이 수박을 쪼개는 것 보다는 축제에 가서 즐기고 싶지만…… 이것도 나쁘지 않네. 내 곁에는 네가 있고, 네 곁에는 내가 있고… 둘이 함께 이렇게 모두를 위해 무언가를 하는 편이 우리 각자의 역할에 딱 맞달까? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어. 전투의 기운을 가지고 다들 있는 곳으로 가긴 좀 그렇지? 우선은 이 수박한테라도 발산하고 가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"좋아, 지휘관이 먹을 것도 잘라 줄게. 하아압…… 응? 그렇게 무시무시하게 할 필요는 없다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"흠! 후우…… 좋아, 다음 수박 좀 올려줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/touch.ogg"},"터치2":{"voiceline":"? 뭘 하려는 거야……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/touch2.ogg"},"입수시":{"voiceline":"합! 흠… 깔끔하게 반으로 잘렸네. 사쿠라 엠파이어의 수박 자르기 기술… 생각보다는 마스터하기 쉬운데…… 지휘관, 마침 잘 왔어. 이 수박들, 다들 먹을 수 있게 나누어 주지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"이 차림 또한 전투를 위해 차려입은 것… 얕보면 곤란하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205023/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_