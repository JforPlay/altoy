[{"클뜯 id":205020,"클뜯 함순이 id":20502,"함순이 이름":"워스파이트","한글 함순이 + 스킨 이름":"워스파이트","영문 함순이 + 스킨 이름":"Warspite","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205020/shipyard.png","설명":"퀸 엘리자베스급 전함·워스파이트 (HMS Warspite)","자기소개":{"voiceline":"퀸 엘리자베스급 고속전함 워스파이트. 이동 목표에 대한 최장거리 가격 명중 기록을 갖고 있어. 절체절명의 출격을 몇 번이고 기적적으로 생환해 보였지── 이 모든 건 분명 내 운명이라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/profile.ogg"},"메인1":{"voiceline":"지휘관의 명령은 절대적이야. 최우선으로 대응해야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/main1.ogg"},"메인2":{"voiceline":"올드·레이디는 스커트를 입지 않으면 더 빨리 달릴 수 있어, 시험해볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/main2.ogg"},"메인3":{"voiceline":"이 이상 나를 놀리면, 15인치 포탄을 먹여줄 테다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/main3.ogg"},"전투개시":{"voiceline":"지휘관의 적은 절대로 놓치지 않는다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/battle.ogg"},"상세확인":{"voiceline":"데이터에 현혹되지 마. 승리를 이끌어낼 조건은 그 외에도 잔뜩 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/detail.ogg"},"드랍 설명":{"voiceline":"퀸 엘리자베스급 전함·워스파이트 (HMS Warspite)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰인가. 그립구나. 나도 예전엔 뛰어다니던 시기가 있었지. 가자. 노력해준 그녀들은 마중받아야 마땅해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/expedition.ogg"},"실망":{"voiceline":"친한 척은 그만둬주지 않겠나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 로열 네이비의 역사가 알고 싶어? 나를 따르던 장군들의 얘기를 해줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/feeling2.ogg"},"호감":{"voiceline":"귀족 기질이 없다고? 확실히 후드 같은 애들과는 달리 명색만…… 가, 가슴 얘기는 그만둬줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/feeling3.ogg"},"기쁨":{"voiceline":"뭐라고 할까…… 나, 자매 중에서는 나이가 많은 편인데, 스타일이 그…… 나이에 안 맞게 젊은 애들과 겨룰 수도 없고, 적어도 당신 앞에서는 매력적으로 보이고 싶은데…… 어떻게 하면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/feeling4.ogg"},"사랑":{"voiceline":"그래,좋아. 나는 워스파이트. 전쟁을 혐오하는 자야. 흥! 하지만 나에게서 지휘관을 뺏으려고 하는 녀석은 그 전에 이 대포를 똑똑히 보게 해주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"후우~ 엄청난 살기였어. 그래도 이렇게 귀환했으니 느긋하게 쉬어볼까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/home.ogg"},"hp 경고":{"voiceline":"전투의 고통도 이 정도인가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/hp_warning.ogg"},"로그인":{"voiceline":"이 워스파이트, 제아무리 멀리 도망친 적이라도 해치워 보이겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/login.ogg"},"실패":{"voiceline":"대미지 컨트롤이 작동하지 않아!? 조타 장치도 제어 불능이라고!? 잠깐! 이런 중요한 때에!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이 왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/mail.ogg"},"임무":{"voiceline":"새 임무를 받는 대로 출진하겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/mission.ogg"},"임무완료":{"voiceline":"미션에는 보너스가 있으니, 그걸 잊지 말도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/mission_complete.ogg"},"서약":{"voiceline":"드디어 이날이 왔는가. 나의 노력은 헛되지 않았어…… 후우…… 그럼 지휘관, 가볼까. 준비는 돼 있어. Officers, draw swords!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/propose.ogg"},"스킬":{"voiceline":"Belli dura despicio!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/skill.ogg"},"터치1":{"voiceline":"이런 스킨쉽은… 싫지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/touch.ogg"},"터치2":{"voiceline":"알겠어? 나는 절대로 그런, 그…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/touch2.ogg"},"입수시":{"voiceline":"만나서 반가워, 나는 워스파이트. 움직이는 목표에 대한 최장거리 사격 명중 기록을 갖고 있지… 의외라고? 생각한 것보다 작다고? 아무래도 얘기를 좀 할 필요가 있겠네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/unlock.ogg"},"강화성공":{"voiceline":"전장이여, 내가 간다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"한계에 굴복해선 안 돼. 불침함의 이름은 장식이 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['그리들리', '모리'] : 올드·레이디와 속도 경주인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/couple_encourage1.ogg"},{"voiceline":"['엔터프라이즈'] : 천하무쌍? 하아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/couple_encourage2.ogg"},{"voiceline":"['후드'] : 우아함은 전장에 어울리지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/couple_encourage3.ogg"},{"voiceline":"['퀸 엘리자베스'] : 폐하, 제 활약을 기대해주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/couple_encourage4.ogg"},{"voiceline":"['넬슨', '로드니'] : 후배님들, 따라오도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/couple_encourage5.ogg"},{"voiceline":"['밸리언트'] : 너무 무리하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205020/couple_encourage6.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":205021,"클뜯 함순이 id":20502,"함순이 이름":"워스파이트","한글 함순이 + 스킨 이름":"전사의 크리스마스 선물","영문 함순이 + 스킨 이름":"Christmas Warrior","스킨 타입":"Christmas","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205021/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205021/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205021/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205021/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205021/shipyard.png","설명":"올해는 내가 로열 네이비 아이들에게 선물을 보내줄 차례인가. 흠, 이 크리스마스트리 장식을 다 하면 가보도록 할까! ","자기소개":null,"메인1":{"voiceline":"지휘관도 선물이 받고 싶은 거야…? 뭐어, 받고 싶다면 딱히 못 줄 것도 없는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/main1.ogg"},"메인2":{"voiceline":"음… 폐하께 드릴 선물은 뭐가 좋을까. 너무 비싼 것도 안 되고 너무 싼 것도 안 돼. 너무 특이한 것도 안 좋고 너무 평범한 것도 싫증 내실 거야… 대체 어떻게 해야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/main2.ogg"},"메인3":{"voiceline":"응? 산타라면 굴뚝으로 들어가는 게 당연하잖아. …이, 이상한 사람 취급 당한다구!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"폐하의 집무실 문에 장식할 화환…… 응응, 벨이 알려준 조개 화환이 좋겠어! 지휘관, 빨리 조개 주우러 출발하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/detail.ogg"},"드랍 설명":{"voiceline":"올해는 내가 로열 네이비 아이들에게 선물을 보내줄 차례인가. 흠, 이 크리스마스트리 장식을 다 하면 가보도록 할까!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관, 미안해. 크리스마스인데 별로 낭만적으로 못 보내서…… 그래도 괜찮다, 라고. 흥. 당신은 항상 그렇다니까. 그럼… 적어도 성야의 종이 울리는 동안만이라도, 둘이서 느긋하게 즐기게 해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"흐, 흠, 돌아온 이상 '또 다른 전장'이라도 향해볼까나. ……여기 있는 선물 전부 나눠주는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"전사에게도 휴식은 필요해. 명절에는 그렇게 예민하게 굴지 말라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"지휘관, 임무하는 김에 이 선물 좀 저 애한테 전해줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 크리스마스 트리 장식하는 거 도와줘. 저기엔 손이 닿지 않…… 기, 기다려! 누가 안아 올려도 된다고 했어!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/touch.ogg"},"터치2":null,"입수시":{"voiceline":"올해는 내가 로열 네이비 애들에게 선물을 보내줄 차례인가. 흠, 이 크리스마스트리 장식을 다 하면 가보도록 할까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205021/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":n