[{"클뜯 id":105140,"클뜯 함순이 id":10514,"함순이 이름":"사우스다코타","한글 함순이 + 스킨 이름":"사우스다코타","영문 함순이 + 스킨 이름":"South Dakota","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105140/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105140/shipyard.png","설명":"사우스다코타급 전함·사우스다코타 (BB-57)","자기소개":{"voiceline":"유니온의 전함 사우스다코타다. 전장에서는 나한테서 떨어지지 않았으면 좋겠군. 지휘관은 내가 지킨다──최강의 방패? 허명에 가치 따윈 없다. 힘이 된다면 거기에 의의가 있지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/profile.ogg"},"메인1":{"voiceline":"어둠 속에서 갈고닦은 내 의지, 두려워할 건 아무것도 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/main1.ogg"},"메인2":{"voiceline":"확실히 지휘관의 도움이 됐다면, 공적 정도는 다른 사람한테 줘도 상관없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/main2.ogg"},"메인3":{"voiceline":"지휘관에게 적대하는 자는, 누구라 한들 적이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/main3.ogg"},"전투개시":{"voiceline":"전력으로 덤벼라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/battle.ogg"},"상세확인":{"voiceline":"사우스다코타, 언제든 명령을 기다리고 있다. 지휘관","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/detail.ogg"},"드랍 설명":{"voiceline":"사우스다코타급 전함·사우스다코타 (BB-57)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰함대가 돌아왔다…… 필요하다면 나도 움직이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/expedition.ogg"},"실망":{"voiceline":"……명령에는 따른다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/feeling1.ogg"},"낯섦":{"voiceline":"네 의지는 내가 갈 곳이다. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/feeling2.ogg"},"호감":{"voiceline":"지휘관의 목표를 실현하기 위해 태어났다. 그것 말고 아무런 가치도 없지.──스커트? 그런 훌렁훌렁거리는 옷을 입어본 적 없다만","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/feeling3.ogg"},"기쁨":{"voiceline":"전투가 아닌 삶의 방식 말인가? 난…… 어떻게 해야 할지 모르겠다. 지금까지 이렇게 지내왔으니까…… 지휘관이 알려주겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/feeling4.ogg"},"사랑":{"voiceline":"이게 지휘관이 봐온 풍경, 인가…… 삶의 방식은 스스로 정해야 한다고 했다만…… 이번엔 내 사명이 아니라 지휘관의 미소를 위해 싸우겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"좋은 전투다. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/home.ogg"},"hp 경고":{"voiceline":"봐주진 않겠다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 명령을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/login.ogg"},"실패":{"voiceline":"지휘관, 면목이 없군…… 정말 굴욕적인 기분이다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/lose.ogg"},"우편":{"voiceline":"새로운 편지다. 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/mail.ogg"},"임무":{"voiceline":"지휘관. 임무를 완료하는 걸 잊지 말았으면 좋겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/mission.ogg"},"임무완료":{"voiceline":"지휘관, 미션 보너스가 도착했다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/mission_complete.ogg"},"서약":{"voiceline":"지휘관이 곁에 있으면 마음이 따뜻해진다. 지휘관의 목표가 내 투지를 불태운다. 지휘관의 말을 듣는 것만으로 기쁘다…… 일찍이 이 방패를 바쳤지만, 앞으로는…… 마음도 지휘관에게 바치겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/propose.ogg"},"스킬":{"voiceline":"여기까지다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/skill.ogg"},"터치1":{"voiceline":"언제든지 행동할 수 있다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/touch.ogg"},"터치2":{"voiceline":"이것이 지휘관이 하고 싶은 일이라면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/touch2.ogg"},"입수시":{"voiceline":"난 사우스다코타. 지휘관의 방패가 되어 그 어떤 포화 속이라도 지켜내주지. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/unlock.ogg"},"강화성공":{"voiceline":"이 방패가 더 강고해졌다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/upgrade.ogg"},"vote":null,"승리":{"voiceline":"국지적인 승리는 기뻐할 값어치가 없다, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['테네시'] : 등 뒤는 나에게 맡겨라! 계속 쏴라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/couple_encourage1.ogg"},{"voiceline":"['베스탈'] : 미안, 또 너에게 실망을 안겨버렸다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/couple_encourage2.ogg"},{"voiceline":"['엔터프라이즈', '베스탈'] : 엔터프라이즈, 승부다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105140/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_e