[{"클뜯 id":103020,"클뜯 함순이 id":10302,"함순이 이름":"솔트레이크시티","한글 함순이 + 스킨 이름":"솔트레이크시티","영문 함순이 + 스킨 이름":"Salt Lake City","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/103020/shipyard.png","설명":"펜사콜라급 중순양함·솔트레이크시티 (CA-25)","자기소개":{"voiceline":"나는 펜사콜라급 중순양함 2번함 솔트레이크시티. 맞아, 진짜배기 중순양함이야. 조약 덕분에 장갑이 얇지만, 화력은 떨어지지 않아. 뭐, 장갑도 태평양전쟁에서 수많은 싸움에 참가하고 참가해서 끝까지 살아남았으니까 딱히 신경 쓸 일도 아니었으려나. 애투섬 해전? 그건 운도 실력 중 하나라고? …아니 딱히 변명은 아니거든? 아니면 지휘관은 나도 라피 수준으로 껴입는 게 좋다는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/profile.ogg"},"메인1":{"voiceline":"지휘관이 맥주병이라면 헤엄치는 거 가르쳐줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/main1.ogg"},"메인2":{"voiceline":"키스카섬 포격? 아하하… 뭐 그건 그것대로 새롭지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/main2.ogg"},"메인3":{"voiceline":"엔터프라이즈 언니는 너무 근엄하니까 지휘관은 따라 하지 않는 편이 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/main3.ogg"},"전투개시":{"voiceline":"저쪽은 아군이 아니야. 전 포문 발사 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/battle.ogg"},"상세확인":{"voiceline":"바다에 떠 있는 것만으로도 가끔은 좋은 일이 생기네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/detail.ogg"},"드랍 설명":{"voiceline":"펜사콜라급 중순양함·솔트레이크시티 (CA-25)","voicelink":null},"의뢰 완료":{"voiceline":"후~. 그 애들, 이런 푹푹 찌는 날에 의뢰하러 갔던 거구나. 그리고 의뢰를 달성했고. 대단해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/expedition.ogg"},"실망":{"voiceline":"지휘관의 눈, 조금 기분 나쁠지도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/feeling1.ogg"},"낯섦":{"voiceline":"헬레나, 레이더에서 뭔가 재미있는 걸 찾아주지 않을래? 어…… 저건 샌디에이고? 좋아, 같이 물놀이하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/feeling2.ogg"},"호감":{"voiceline":"지휘관, 모래사장에서 누워만 있으면 재미없다구. 비치발리볼은 어때? 썬탠? 괜찮아, 펜사콜라 언니가 자외선 차단제를 발라줬으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관. 피곤하면 내 허벅지에서 쉬어도 돼. 괜찮아, 장난치지 않을 테니까~ 에… 난 줄곧 상냥했거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/feeling4.ogg"},"사랑":{"voiceline":"어서 와 지휘관! 지금 세탁물 다 말린 참이야. 책이나 널브러져 있던 것도 정리했으니까. 어때? 이걸로 훨씬 깨끗해졌지? 그럼 저녁은…… 에? 왜 여기까지 와서 하냐고? 그야 당연히── 장래를 위한 준비야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/feeling5.ogg"},"터치3":{"voiceline":"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/headtouch.ogg"},"모항귀환":{"voiceline":"아차~ 피부 타버렸다…베스탈 미안, 스파 부탁해도 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 함께 헤엄치러 갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/login.ogg"},"실패":{"voiceline":"우와아아! 철갑탄이 다 떨어졌다…… 아, 진짜!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/lose.ogg"},"우편":{"voiceline":"새로운 편지야? 어라? 러브 레터? …흠, 쓰레기통은 어디 있더라?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/mail.ogg"},"임무":{"voiceline":"임무는 됐으니까 파티하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/mission.ogg"},"임무완료":{"voiceline":"이것으로 파티에 갈 수 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 약속해. 이제부터는 매일 내 취미에 함께 어울려줘── 서핑도, 비치발리볼도, 또… 스쿠버 다이빙? 물론, 당신이 즐거워하는 것들도 전부 어울려줄게♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/propose.ogg"},"스킬":{"voiceline":"공격이야말로 최고의 방어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/skill.ogg"},"터치1":{"voiceline":"어, 지휘관이잖아. 펜사콜라 언니라고 생각했어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/touch.ogg"},"터치2":{"voiceline":"이봐, 펜사콜라 언니랑 똑같은 짓 하지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/touch2.ogg"},"입수시":{"voiceline":"지휘관. 나는 중순양함·솔트레이크시티! 노출이 많다고? 뭐, 체중 조절은 의식하는 게 당연하잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/unlock.ogg"},"강화성공":{"voiceline":"아메리칸 걸도 에스테틱에 신경 써야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이번에는 운이, 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/103020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"N","ex_chat_status":0}]