[{"클뜯 id":10700030,"클뜯 함순이 id":1070003,"함순이 이름":"미나세 이오리","한글 함순이 + 스킨 이름":"미나세 이오리","영문 함순이 + 스킨 이름":"Iori Minase","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700030/shipyard.png","설명":"안녕~! 난 미나세 이오리라고 해! 만나서 반가워~! ... 응? 무리할 필요 없다고...? 잠깐, 너 지금 무슨 뜻이야!","자기소개":{"voiceline":"미나세 이오리야! 노리는 것은 물론! 톱 아이돌이야♪ 일시적이라고는 해도, 이 슈퍼 아이돌 이오리와 함께 지내는 것에 감사하도록 해. 니히힛♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/profile.ogg"},"메인1":{"voiceline":"이 집무실 제법 괜찮은데. 내 방에 비하면 아직 멀었지만","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/main1.ogg"},"메인2":{"voiceline":"모항에 있는 애들이 말한 '만쥬'는 저 둥그런 새들 말하는 거였구나. 과자인 줄 알았네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/main2.ogg"},"메인3":{"voiceline":"당신, 쉴 틈 있어? 눈앞에 산더미처럼 쌓인 일감이 안 보이는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/main3.ogg"},"전투개시":{"voiceline":"내 상대가 감당할 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/battle.ogg"},"상세확인":{"voiceline":"내 방에 들어가 보고 싶다구? 잠깐, 멋대로 들어오지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/detail.ogg"},"드랍 설명":{"voiceline":"안녕~! 난 미나세 이오리라고 해! 만나서 반가워~! ... 응? 무리할 필요 없다고...? 잠깐, 너 지금 무슨 뜻이야!","voicelink":null},"의뢰 완료":{"voiceline":"어라, 의뢰팀이 돌아온 모양이네. 이오리님께서 친히 마중 나가주실까나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/expedition.ogg"},"실망":{"voiceline":"어머. 당신, 있었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/feeling1.ogg"},"낯섦":{"voiceline":"목말라…… 어, 그 오렌지 쥬스, 나한테 주는 거야? 게다가 과즙 100%잖아! 당신도 제법 센스가 있네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/feeling2.ogg"},"호감":{"voiceline":"나한테는 어렸을 때부터 쭉 함께였던 친구가 있어. 그치, 우사야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/feeling3.ogg"},"기쁨":{"voiceline":"무대에서 좀 더 빛나려면 어떡해야 할까……? 노래를 더 연습할까? 퍼포먼스를 더 화려하게? ……그래, 모처럼이니 당신 의견도 들어줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/feeling4.ogg"},"사랑":{"voiceline":"여기 경치도 참 좋은걸. …엇, 꺄악! 당신, 있으면 있다고 말해! ……뭐, 좋아. 당신도 여기 와서 앉지 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/feeling5.ogg"},"터치3":{"voiceline":"꺅! ……잠깐, 갑자기 건드리지 말아 줄래!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/headtouch.ogg"},"모항귀환":{"voiceline":"어머, 돌아왔어? 마침 잘됐어. 티타임에 어울려줘야겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/home.ogg"},"hp 경고":{"voiceline":"이 정도는 아무것도 아냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/hp_warning.ogg"},"로그인":{"voiceline":"안녕…… 아니, 뭐야, 그 칠칠찮은 얼굴은. 잠이 덜 깬 건 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/login.ogg"},"실패":{"voiceline":"이 내가……? 더 연습해서, 다음엔 절대 지지 않을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/lose.ogg"},"우편":{"voiceline":"우편이 왔어. 일부러 알려줬으니까, 얼른 확인해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/mail.ogg"},"임무":{"voiceline":"아직도 일이 남아있다구? 얼른 끝내버려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/mission.ogg"},"임무완료":{"voiceline":"겨우 끝났네. 이 정도는 당연히 해내야 하지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/mission_complete.ogg"},"서약":{"voiceline":"당신도 나에 대해 이해하기 시작한 모양이네. 앞으로도 이오리님의 후광에서 눈을 떼지 마. 안 그럼 혼날 줄 알아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/propose.ogg"},"스킬":{"voiceline":"날 똑똑히 보도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/skill.ogg"},"터치1":{"voiceline":"무슨 볼일 있어? 멍하니 있지 말고 뭔가 말하라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/touch.ogg"},"터치2":{"voiceline":"꺅! ……갑자기 어딜 만지는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/touch2.ogg"},"입수시":{"voiceline":"안녕~! 난 미나세 이오리라고 해! 만나서 반가워~! ... 응? 무리할 필요 없다고...? 잠깐, 너 지금 무슨 뜻이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/unlock.ogg"},"강화성공":{"voiceline":"꽤 좋은 느낌이잖아. 내 감사를 받을 자격이 있겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 정도로 내 상대가 되려 하다니, 무르다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/win_mvp.ogg"},"전투개시_ex":{"voiceline":"이오리의 빛나는 모습을 보여줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/battle_ex.ogg"},"상세확인_ex":{"voiceline":"당신, 또 온 거야? ……어쩔 수 없네, 지쳐보이니까, 특별히 방에서 쉬다 가게해줄 게. 감사하도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"자, 당당히 가슴을 펴. 이오리가 이곳에서도 빛날 수 있었던 건, 당신 덕분이기도 하니까. ……앞으로도 잘 부탁해, 지휘관! 니히힛♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"이제야 왔네? 날 기다리게 하다니, 배짱도 좋잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"아직도 안 끝난 거야? 그…… 조금이라면 도와줄 수도 있는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/mission_ex.ogg"},"임무완료_ex":{"voiceline":"일 다 끝났구나. 뭐, 가끔은 칭찬도 해줄까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"뭣… 뭐 하는 거야, 이 변태! 왕변태!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이게 바로 이오리의 실력이야! 니히힛♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['후타미 아미'] : 아미, 장난은 그만해! 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/couple_encourage1.ogg"},{"voiceline":"['후타미 마미'] : 이 정도는 당연하지! 니히힛♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/couple_encourage2.ogg"},{"voiceline":"['미우라 아즈사'] : 아즈사, 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"모항의 식당에선 본 적도 없는 전 세계의 요리가 나오는구나. 왠지 여러 나라를 한꺼번에 여행한 기분이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/main5_ex.ogg"},"메인6_ex":{"voiceline":"오렌지 쥬스 마시고 싶다~♪ ……잠깐, 당신, 됐으니까 잠자코 따라와!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"이 이오리를 따분하게 만들다니! 잠깐, 졸지 말고 내 말 상대가 되라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700030/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IMAS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":10700031,"클뜯 함순이 id":1070003,"함순이 이름":"미나세 이오리","한글 함순이 + 스킨 이름":"비밀의 저녁","영문 함순이 + 스킨 이름":"A Little Evening Secret","스킨 타입":"Summer Fest","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700031/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700031/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700031/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700031/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700031/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10700031/shipyard.png","설명":"그네에 비누방울…… 조금 어린애 같은 기분도 들지만, 가끔은 이런 것도 괜찮네.","자기소개":null,"메인1":{"voiceline":"이렇게 당신과 시간을 보내는 것도 꽤 나쁘지 않네. 다음은 뭐할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700031/main1.ogg"},"메인2":{"voiceline":"바캉스에 왔으니 역시 이곳 명물을 먹어봐야지. 당신, 제대로 조사해뒀겠지!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700031/main2.ogg"},"메인3":{"voiceline":"잠깐, 바캉스라고 너무 풀어진 거 아냐? 낮잠 같은 거 자지 말고, 같이 바다 보러 따라 오라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700031/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"좀 더 큰 비누방울을 만들려면…… 천천히…… 조심조심…… 엇, 꺄악! 당신, 있으면 말 하라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10700031/detail.ogg"},"드랍 설명":{"voiceline":"그네에 비누방울…… 조