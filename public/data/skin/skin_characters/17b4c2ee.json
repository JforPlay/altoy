[{"클뜯 id":499040,"클뜯 함순이 id":49904,"함순이 이름":"오딘","한글 함순이 + 스킨 이름":"오딘","영문 함순이 + 스킨 이름":"Odin","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499040/shipyard.png","설명":"전투 순양함——오딘 ","자기소개":{"voiceline":"나는 오딘, 메탈 블러드의 구상에만 존재했던 함선이다. 하지만 지금은… 운명이 너와 나를 만나게 해주었으니, 너를 보좌해서 그 목적을 실현하는 것이 나의 사명이겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/profile.ogg"},"메인1":{"voiceline":"샤른호르스트급…… 기회가 된다면 대화를 나눠보고 싶군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/main1.ogg"},"메인2":{"voiceline":"계획이 변화를 따라가지 못할 때도 있다. 지휘관, 반드시 심사숙고 하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/main2.ogg"},"메인3":{"voiceline":"네가 보지 못한 것이 있을 수 있으니 남탓은 적당히 하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/main3.ogg"},"전투개시":{"voiceline":"아직 도망갈 수 있다——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/battle.ogg"},"상세확인":{"voiceline":"이상하군, 왜 모항의 녀석들은 이렇게 느긋하게 있을 수 있는 거지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/detail.ogg"},"드랍 설명":{"voiceline":"전투 순양함——오딘","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔다. 좋아, 계획은 아주 순조로워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/expedition.ogg"},"실망":{"voiceline":"실망이라기 보다는 너같은 녀석이 어떻게 지휘관이 되었는지 궁금하군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/feeling1.ogg"},"낯섦":{"voiceline":"실력? 확실히 이름만으로는 증명하기 어려운 것이지. 하지만 걱정 마. 시간이 지나면 네 걱정이 쓸데없었다는 것을 알게 될테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/feeling2.ogg"},"호감":{"voiceline":"죽은 전우를 위해 슬퍼하는 건가? 하지만 슬퍼하기만 한다면 전쟁에서는 이길 수 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/feeling3.ogg"},"기쁨":{"voiceline":"일이건 전투건 우리의 합은 점점 더 좋아지고 있군. 하지만 계속 이렇게 가다간 계속 지휘관에게 의존해버리고 말텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/feeling4.ogg"},"사랑":{"voiceline":"한 사람에게 너무 의존하는 것은 좋은 일이 아니지. 과도했다가는 전쟁을 그르치고, 심지어 판단에도 영향을 줘서 계획에 지장이 생겨. 이상하다. 내가 왜 이런 말을 하고 있는지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"전쟁은 숨 쉴 시간을 주지 않아, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/home.ogg"},"hp 경고":{"voiceline":"응급 방안 실행 준비…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/hp_warning.ogg"},"로그인":{"voiceline":"돌아왔나, 지휘관. 이제 뭘 할 계획이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/login.ogg"},"실패":{"voiceline":"이럴 수가…… 내 계획에 오차는 없었을 텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/lose.ogg"},"우편":{"voiceline":"우편이다. 새로운 정보인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/mail.ogg"},"임무":{"voiceline":"임무가 있다, 지휘관. 미루는 것은 현명한 선택이 아니지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/mission.ogg"},"임무완료":{"voiceline":"임무 완료. 다음 임무에 착수하도록 하자, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/mission_complete.ogg"},"서약":{"voiceline":"알겠다. 계속 너의 곁에 있겠다. 그러니…… 잠시만, 설마 이건…… 말, 말했던 것과 다르지 않나? 싫은 것은 아니지만 아직 마음의 준비가…… 어쨌든, 나, 나에게 생각할 시간을 줘——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/propose.ogg"},"스킬":{"voiceline":"돌아갈 길은 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/skill.ogg"},"터치1":{"voiceline":"응? 계획이 바뀌었나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/touch.ogg"},"터치2":{"voiceline":"이 뒤는 군사 법정에서 듣도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/touch2.ogg"},"입수시":{"voiceline":"나를 깨운 것이 너인가…? 메탈 블러드의 전함, 오딘. 너를 위해 싸우겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/unlock.ogg"},"강화성공":{"voiceline":"실력이 향상되면 계획의 불안 요소가 줄어든다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이번 승리는, 처음부터 내가 떼어 놓은 당상이었다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"모두가 느긋하게 있을 수 있는 것은 지휘관에 대한 믿음에서 비롯된 것이지. 응, 드디어 이해할 수 있게 되었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"솔직히 말하면, 갑작스러운 행동 때문에 머리가 하얗게 됐지만…… 다시 냉정을 되찾았어. 그래, 어떤 상황에서도 나는 너와 함께할 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"우리는 기계가 아니니 피곤하면 쉬도록 해. 내가 대신 해주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"다녀왔나, 지휘관. 다음 임무 계획을 같이 세우도록 할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"윽! 갑자기 습격하다니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":{"voiceline":"nil","voicelink":null},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"나는 변화가 싫지만, 가끔은 나에게 변화를 요구할 때도 있더군. 하지만 우리의 맹세는 변하지 않으니 걱정하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/main2_ex.ogg"},"메인3_ex":{"voiceline":"실수 때문에 화가 났나? 용서할 수 있는 것은 용서해. 사소한 실수로는 계획이 틀어지지 않으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499040/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":499041,"클뜯 함순이 id":49904,"함순이 이름":"오딘","한글 함순이 + 스킨 이름":"휘호창설","영문 함순이 + 스킨 이름":"Black Strokes upon Blank Snow","스킨 타입":"New Year Kimono","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499041/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499041/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499041/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499041/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/499041/shipyard.png","설명":"이런 \"예술적 취미\"와는 인연이 없을 것 같던 나에게, 이렇게 마음껏 글을 쓸 기회가 생기다니... 어때,  동방의 예술이라고 해도, 내 이름을 꺾을만한 위력은 없지 않아?","자기소개":null,"메인1":{"voiceline":"그나이제나우, 데이터만 가지고는 예술의 재미를 경험할 수 없어. 이 점에 대해서는 오히려 샤른호르스트에게 잘 배워볼 만해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499041/main1.ogg"},"메인2":{"voiceline":"티르피츠, 비스마르크 어디 갔는지 알아? 아, 아냐, 네가 알고 있다니까 마음이 놓이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499041/main2.ogg"},"메인3":{"voiceline":"눈과 매화...인가? 눈에 익은 풍경은 아니지만, 확신한다. 눈 앞의 이 아름다운 풍경은, 반드시 내 기억 속에 영원히 존재할 거라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499041/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이상해, 왜 항구에 사람들이 모두 홀가분한 모습이지... 내가 평소에 너무 긴장... 하는 건가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499041/detail.ogg"},"드랍 설명":{"voiceline":"이런 \"예술적 취미\"와는 인연이 없을 것 같던 나에게, 이렇게 마음껏 글을 쓸 기회가 생기다니... 어때,  동방의 예술이라고 해도, 내 이름을 꺾을만한 위력은 없지 않아?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"전력을 다해 어떤 일에 뛰어드는 것이, 바로 전투다——전쟁터에서나 활력을 쏟아붓거나 종이에나 필묵을 뿌리는 것도, 모두 마찬가지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499041/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"복귀를 환영한다, 지휘관. 쉬는 날은 취미생활을 맘껏 즐겨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499041/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"사람이 정신 집중하고 있을 때 방해하지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499041/touch2.ogg"},"입수시":{"voiceline":"이런 \"예술적 취미\"와는 인연이 없을 것 같던 나에게, 이렇게 마음껏 글을 쓸 기회가 생기다니... 어때,  동방의 예술이라고 해도, 내 이름을 꺾을만한 위력은 없지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/499041/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_e