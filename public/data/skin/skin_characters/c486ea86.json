[{"클뜯 id":9701090,"클뜯 함순이 id":970109,"함순이 이름":"유다치·META","한글 함순이 + 스킨 이름":"유다치·META","영문 함순이 + 스킨 이름":"Yuudachi META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9701090/shipyard.png","설명":"네가 지휘관이야? 유다치야! 시라츠유급 중 하나로 보면 돼…… 그나저나 여기 밥은 나와? 나온다고?! 그럼, 문제 없지!","자기소개":{"voiceline":"유다치? 아니면 유다치·META? 마음껏 먹을 수 있게만 해주면, 뭐라고 불러도 상관없어! 원하면 누구든 두들겨 패주지! ……떠드니까 갑자기 배고프네. 먹을 건? 먹을 거 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/profile.ogg"},"메인1":{"voiceline":"싸우는 이유? 딱히 없는데… 굳이 말하자면… 재밌으니까? 맛있으니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/main1.ogg"},"메인2":{"voiceline":"환영회? 재미 없을 것 같고, 귀찮으니까 안 갈래. ……맛있는 게 나온다고?! 갈래! 갈래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/main2.ogg"},"메인3":{"voiceline":"집무실 밖에 뭔가 재밌어 보이는 게…… 응?! 지휘관이 가지고 있는 거… 초콜릿이지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/main3.ogg"},"전투개시":{"voiceline":"후훗, 마음껏 사냥해 주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/battle.ogg"},"상세확인":{"voiceline":"음…… 쿨쿨…… 드르렁…… 쿨쿨, 아……? 지휘관! 밥 먹을 시간이야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/detail.ogg"},"드랍 설명":{"voiceline":"시라츠유급 구축함 4번함·유다치<color=#92fc63>(1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"우와! 의뢰가 끝난 건가? 이번엔 어떤 음식을 들고 왔으려나~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/expedition.ogg"},"실망":{"voiceline":"배…… 고파…… 소시지…… 햄…… 미트파이…… 스테이크…… 어디 있어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/feeling1.ogg"},"낯섦":{"voiceline":"먹을 거 찾으러 가려던 중인데, 지휘관도 같이 갈래? ……어제 가져다 준 고기? 그건 어제 다 먹었지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/feeling2.ogg"},"호감":{"voiceline":"밥 먹으니까 졸려…… 음… 그래도 밖에 싸우러 가고 싶긴 하네…… 아니면 공원에 나비나 잡으러 갈까? ……못 정하겠어! 지휘관이 정해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/feeling3.ogg"},"기쁨":{"voiceline":"왜지…… 이 맛있는 고기, 혼자서 다 먹을 생각이었는데…… 왜 지휘관이 먹을 몫을 남겨두고 싶은 거지……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 유다치한테 잘해줘서… 조금은 맘에 드네! 응… 오늘 배부르게 먹고 나면, 특별히 머리를 쓰다듬을 수 있게 해줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/feeling5.ogg"},"터치3":{"voiceline":"……만지지 마! 간지럽다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관! 어서 와! 킁킁…… 음? 유다치한테 줄 간식은 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/home.ogg"},"hp 경고":{"voiceline":"……잘난 척 하지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/hp_warning.ogg"},"로그인":{"voiceline":"고기랑 간식이랑 다 준다고?! 좋아! 누굴 혼내주면 되는지 말만 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/login.ogg"},"실패":{"voiceline":"……후퇴? 지금 무시하는 거냐?! 이거 놔! 유다치는 아직 더 싸울 수 있다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이 왔어! 킁킁…… 윽, 맛없을 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/mail.ogg"},"임무":{"voiceline":"새 임무…? 에이, 귀찮은데…… 보상으로 고기 두 접시?! 유다치한테 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/mission.ogg"},"임무완료":{"voiceline":"냠냠…… 음…… 지휘관, 임무 보상…… 맛있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/mission_complete.ogg"},"서약":{"voiceline":"서약 반지……? 지휘관… 애도 아니고, 이게 뭘 뜻하는지는 유다치도 잘 안다고…… 그러니까 지휘관은 유다치한테 계속 맛있는 걸 주고, 유다치는 지휘관을 위해 계속 싸워주면 되는 거잖아? 이런 건 당연히 기꺼이 해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/propose.ogg"},"스킬":{"voiceline":"산산조각으로 찢어 주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/skill.ogg"},"터치1":{"voiceline":"아침 먹고 나면 점심, 점심 다음엔 간식 시간, 간식 시간이 끝나면 저녁, 그 다음엔 야식…… 모항은 정말 좋은 곳이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/touch.ogg"},"터치2":{"voiceline":"……지휘관! 확 깨물어 버린다! 앙!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/touch2.ogg"},"입수시":{"voiceline":"네가 지휘관이야? 유다치야! 시라츠유급 중 하나로 보면 돼…… 그나저나 여기 밥은 나와? 나온다고?! 그럼, 문제 없지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/unlock.ogg"},"강화성공":{"voiceline":"지휘관, 지금 유다치는 굉장히 무언가 먹고 싶고, 밖에서 마음껏 날뛰고 싶은 상태야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흥, 겨우 이 정도야? 다음엔 더 재밌는 녀석이 나왔으면 좋겠네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9701090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null