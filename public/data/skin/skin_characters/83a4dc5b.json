[{"클뜯 id":10400010,"클뜯 함순이 id":1040001,"함순이 이름":"키즈나 아이","한글 함순이 + 스킨 이름":"키즈나 아이","영문 함순이 + 스킨 이름":"Kizuna AI","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400010/shipyard.png","설명":"안녕하세요! 키즈나 아이입니다! 당신이 그 소문의 지휘관님인가요? 앞으로 잘 부탁드릴게요! ","자기소개":{"voiceline":"안녕하세요! 키즈나 아이입니다! 설마 방송했던 벽람항로의 세계에 와버리다니… 뭐, 여기서도 '좋아하는 걸 하면서 살아간다'는 유튜버 정신으로, 평소처럼 열심히 하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/profile.ogg"},"메인1":{"voiceline":"라피쨩 귀여워~! 츤데레! 심술꾸러기네! 같이 놀자~ 꼬옥~ 안게 해줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/main1.ogg"},"메인2":{"voiceline":"부린쨩, 기다려~ 조금만! 조금 한계돌파하는 것뿐이니까!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/main2.ogg"},"메인3":{"voiceline":"저는 온 세상의 사람들과 교류하고 싶어서 유튜버 활동을 하고 있는데요, 지휘관님은 왜 그 일을 하려고 생각하셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/main3.ogg"},"전투개시":{"voiceline":"이번에야말로, 인텔리전트한 슈퍼 AI의 힘을 보여줄 때…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/battle.ogg"},"상세확인":{"voiceline":"앗, 지휘관님! 채널 구독하러 오셨나요? 엥, 그냥 보러 왔다구요?모처럼이니까 구독하고 가시죠! 자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/detail.ogg"},"드랍 설명":{"voiceline":"안녕하세요! 키즈나 아이입니다! 당신이 그 소문의 지휘관님인가요? 앞으로 잘 부탁드릴게요!","voicelink":null},"의뢰 완료":{"voiceline":"앗, 의뢰에 갔던 아이들이 돌아온 것 같아요! 궁디 팡팡해주고 올게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/expedition.ogg"},"실망":{"voiceline":"뽀큐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/feeling1.ogg"},"낯섦":{"voiceline":"모처럼 여기까지 왔으니까, 영상이라도 만들어야겠다! 앗, 지휘관님 딱 좋은 타이밍! 잠깐 도와주실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/feeling2.ogg"},"호감":{"voiceline":"여기서 효과음을 넣고, 자막을 추가해서… 오오, 지휘관님은 배우는 게 빠르시네요. 이런 상태로 계속 더 좋은 영상 제작을 위해 노력해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 왜 그러시나요? 새로운 기획을 생각해 봤다고요? 흠흠…… 오~! 괜찮은데요, 이거! 지휘관님도 혹시, 천재세요!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님과 함께라면 더욱 좋은 걸 만들 수 있을 것 같아요! 이래저래 길게 볼 사이가 될 것 같고요… 이렇게 된 거 차라리 저하고 유튜버로 데뷔하지 않으실래요!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님 수고하셨습니다! 쉬고 나서 촬영 도와주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/home.ogg"},"hp 경고":{"voiceline":"싫어싫어싫어싫어! 아카시쨩, 도와줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관님 어서 오세요! 방금 새로운 영상을 올렸어요. 해역 돌면서 봐주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/login.ogg"},"실패":{"voiceline":"아! 지금 거 무효! 다음이 진짜니까!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/lose.ogg"},"우편":{"voiceline":"우편이 도착했어요! 어쩌면, 제게 온 의뢰일지도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/mail.ogg"},"임무":{"voiceline":"지휘관님, 새로운 임무에요. 저도 도와드릴 테니까 같이 힘내죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/mission.ogg"},"임무완료":{"voiceline":"보너스, 보너스~♪ 자금은 소중하니까요! 바로 받으러 가죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/mission_complete.ogg"},"서약":{"voiceline":"이걸로 계약 완료네요! 이제 지휘관님이 없는 일상 같은 건 생각도 못하겠어요. 계속 계~~~속 지지해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/propose.ogg"},"스킬":{"voiceline":"아이땅 비~~~임!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/skill.ogg"},"터치1":{"voiceline":"지휘관님, 험한 말은 하지 않겠어요. 저의 표코표코 머리띠를 벗기려는 건 그만둬주세요. 이 모항이 어떻게 돼도 모른다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/touch.ogg"},"터치2":{"voiceline":"유감입니다만, 지휘관님이 만지고 있는 건 제가 아니라 화면이라니까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/touch2.ogg"},"입수시":{"voiceline":"안녕하세요! 키즈나 아이입니다! 당신이 그 소문의 지휘관님인가요? 앞으로 잘 부탁드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/unlock.ogg"},"강화성공":{"voiceline":"인스톨 완료! 전투 플러그인 추가, 파워 업!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이 인텔리전트한 슈퍼 AI에게 걸리면 식은 죽 먹기죠~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['키즈나 아이·Elegant', '키즈나 아이·Anniversary', '키즈나 아이·SuperGamer'] :  AI니까 분신도 할 수 있어요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/couple_encourage1.ogg"},{"voiceline":"['샌디에이고'] : 샌디에이고쨩! 드디어 같이 출연할 수 있게 됐네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400010/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"AI (kizuna)","레어도":"SR","ex_chat_status":0},{"클뜯 id":10400011,"클뜯 함순이 id":1040001,"함순이 이름":"키즈나 아이","한글 함순이 + 스킨 이름":"Sakura Festival","영문 함순이 + 스킨 이름":"Festive Kizuna AI","스킨 타입":"Summer Fest","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400011/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10400011/shipyard.png","설명":"사쿠라 엠파이어의 의상은 운치가 있어서 좋네요! 지휘관님, 모처럼의 축제니까 여기저기 돌아다녀 봐요! 앗, 물론 영상도 찍어요♪ ","자기소개":null,"메인1":{"voiceline":"와~ 사과 사탕 맛있겠다~! 어차피 전 못 먹지만요…… 응? 여기선 먹을 수 있을지도?? 잠깐, 유다치쨩 벌써 먹고 있어!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/main1.ogg"},"메인2":{"voiceline":"모처럼 사쿠라 엠파이어의 옷을 입고 있으니까 동물 귀도 붙여볼까~! 벤슨쨩, 잠깐 그 귀 좀 빌려줘~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/main2.ogg"},"메인3":{"voiceline":"그건 그렇고 유카타는 움직이기 불편하네요, 나막신도 걷기 불편하고… 그래! 프린쨩, 유카타를 입고도 잘 싸우는 방법 좀 가르쳐줘~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/main3.ogg"},"전투개시":{"voiceline":"포격 축제의 시작이다~! 불꽃 발사!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/battle.ogg"},"상세확인":{"voiceline":"유카타 참 좋네요! 저는 버츄얼이니까 더위 같은 건 못 느낄텐데도, 왠지 시원한 기분이 들어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/detail.ogg"},"드랍 설명":{"voiceline":"사쿠라 엠파이어의 의상은 운치가 있어서 좋네요! 지휘관님, 모처럼의 축제니까 여기저기 돌아다녀 봐요! 앗, 물론 영상도 찍어요♪","voicelink":null},"의뢰 완료":{"voiceline":"조금 더 축제를 즐기고 싶지만…… 슬슬 의뢰팀이 돌아올 시간이네요, 마중하러 갈까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"수고하셨어요~! 조금 쉬고 나서 이즈모씨네랑 같이 춤추러 가지 않으실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/home.ogg"},"hp 경고":{"voiceline":"유카타가 흐트러져버리잖아요~!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/hp_warning.ogg"},"로그인":{"voiceline":"정말~ 지휘관님~! '미안, 기다렸어?'가 아니에요. 엄청나게 기다렸다고요! 조금만 더 늦었으면 돌아가려고 했다니까요! 정말, 얼른 축제 가죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무로 자금을 버는 것도 좋지만, 축제에 가게를 내서 한밑천 잡는 것도 좋잖아요!? 아카시쨩에게 상담해보죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어요. 이 보수로 축제를 즐겨봐요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"머리 쓰다듬어 준다고 여자아이가 기뻐할 거라 생각한다면 그건 크나큰 착각이고, 다른 애들에게는 하지 않는 게 좋을 거에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/touch.ogg"},"터치2":null,"입수시":{"voiceline":"사쿠라 엠파이어의 의상은 운치가 있어서 좋네요! 지휘관님, 모처럼의 축제니까 여기저기 돌아다녀 봐요! 앗, 물론 영상도 찍어요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10400011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":