[{"클뜯 id":203060,"클뜯 함순이 id":20306,"함순이 이름":"도셋셔","한글 함순이 + 스킨 이름":"도셋셔","영문 함순이 + 스킨 이름":"Dorsetshire","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203060/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203060/shipyard.png","설명":"노포크급 중순양함·도셋셔 (HMS Dorsetshire)\n<color=#ffde38>획득 후 건조 개방</color>","자기소개":{"voiceline":"카운티급 중순양함. 그중에서도 노포크급으로 불리는 것이 언니와 저입니다. 제일 자랑스러운 언니의 도움을 받아 비스마르크 씨를 쓰러뜨릴 수 있었던 적이 있어요. 언니와 비교하면 아직 멀었으니까 언니가 자랑할 수 있는 여동생이 되도록 노력해야죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/profile.ogg"},"메인1":{"voiceline":"언니가 세계에서 제일 귀여운 건 상식 아닌가요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/main1.ogg"},"메인2":{"voiceline":"비스마르크 씨는 친절하다고요. 언니의 정보대로 있어줘서… 다른가요??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/main2.ogg"},"메인3":{"voiceline":"언니 이야기는 사흘 밤낮으로 해도 부족하다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/main3.ogg"},"전투개시":{"voiceline":"언니에게 망신 끼치지 않도록 노력하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/battle.ogg"},"상세확인":{"voiceline":"저보다 역시 언니 쪽이 귀엽지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/detail.ogg"},"드랍 설명":{"voiceline":"노포크급 중순양함·도셋셔 (HMS Dorsetshire)\n<color=#ffde38>획득 후 건조 개방</color>","voicelink":null},"의뢰 완료":{"voiceline":"아, 의뢰 팀이 돌아왔습니다. 다음에는 저와 언니를 함께 출격시켜주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/expedition.ogg"},"실망":{"voiceline":"역시 전 언니를 따라잡으려면 멀었네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/feeling1.ogg"},"낯섦":{"voiceline":"언니는 세계의 보물, 신이 내려주신 은혜입니다. 이런 훌륭한 언니를 가지고 있다니, 저, 영광이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/feeling2.ogg"},"호감":{"voiceline":"저도 괜찮, 다고요? 지휘관은 여전히 농담을 잘 하시네요. 후후, 언니와 비교하면 저는 그저 못생긴 집오리에 지나지 않아요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/feeling3.ogg"},"기쁨":{"voiceline":"어머, 이런 제게도 지휘관은 우정 이상의 감정을 품고 있단 말인가요? 그렇다면 저 또한 똑바로 마주 봐야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/feeling4.ogg"},"사랑":{"voiceline":"설마 제게도 이런 날이 온다고는…… 이럴 때는 어떻게 대답하면 되나요? 지휘관, 가르쳐주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 수고하셨습니다~ 네, 앉아서 차라도 마셔주세요. 그런데 있죠, 언니가 말인데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/home.ogg"},"hp 경고":{"voiceline":"조금 괴로운 싸움이 될 것 같군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/hp_warning.ogg"},"로그인":{"voiceline":"어서 오시지요~ 오늘은 뭘 하실 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/login.ogg"},"실패":{"voiceline":"큿……! 아직 여기서 쓰러질 수는 없습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/lose.ogg"},"우편":{"voiceline":"지휘관, 편지가 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/mail.ogg"},"임무":{"voiceline":"미션이군요~ 언니와의 나날이 생각나네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/mission.ogg"},"임무완료":{"voiceline":"보너스입니다. 받아주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/mission_complete.ogg"},"서약":{"voiceline":"지휘관도 별나세요. 언니라는 태양에 매달릴 수밖에 없는 저에게 프로포즈 하다니. 뭐어, 이렇게 말씀드려도 저 역시 지휘관에게 끌리고 있어요. 이런 저로 괜찮다면 기쁘게 받겠어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/propose.ogg"},"스킬":{"voiceline":"언니, 제게 힘을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/skill.ogg"},"터치1":{"voiceline":"역시 지휘관도 제가 크다고 생각하고 계신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/touch.ogg"},"터치2":{"voiceline":"지휘관은 조금 이상하시네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/touch2.ogg"},"입수시":{"voiceline":"반가워요. 노포크 언니의 동생, 도셋셔예요. 언니보다 어른스러워? 어머, 무슨 농담을. 언니야말로 제가 지향하는 목표인걸요? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/unlock.ogg"},"강화성공":{"voiceline":"언니를 목표로 계속 노력하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이것으로 언니에게 한 걸음 더 다가갔습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203060/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":0}]