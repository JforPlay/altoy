e/main/audio/voiceline/207053/detail.ogg"},"드랍 설명":{"voiceline":"안녕하세요, 지휘관님. 점심시간인데 왜 교실에 남아있냐고요? 후훗, 보시다시피 오늘은 포미더블이 \"주번\"이거든요. 그러니까 지휘관님, 다음 수업 준비가 끝날 때까지 잠깐만 같이 있어주시겠어요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님, 혹시 점심시간에 다른 계획 있으세요? 포미더블은…… 딱히 없어요. 뭐, 물론 아무것도 안 해도 좋죠. 귀여운 학생 포미더블이 여기 같이 있다는 것만으로 충분하지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"아, 어서 오세요! 이건…? 포미더블에게 주는 간식이라고요? 감사합니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"으음… 으으! 휴우… 분필 자국이 잘… 안 지워져! ……지, 지휘관님?! 언제부터 계셨어요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"어머…… 어깨에 분필가루가 떨어졌나요? 아니, 마사지를 해주고 싶다고요? 가, 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/touch.ogg"},"터치2":{"voiceline":"꺅?! 무슨 짓을 하시는 거예요?! 분필가루가 떨어져서 그렇다고요? 핑계를 댈 거면 좀 제대로 된 걸 대시라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 지휘관님. 점심시간인데 왜 교실에 남아있냐고요? 후훗, 보시다시피 오늘은 포미더블이 \"주번\"이거든요. 그러니까 지휘관님, 다음 수업 준비가 끝날 때까지 잠깐만 같이 있어주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"후훗, \"최우수 주번\"이라고 불러주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"교복 차림의 포미더블과 단둘이서 교실에 있다면… 어떨 것 같아요? 후후후, 말하지 않아도 다 알아요. 아까부터 지휘관님, 포미더블만 뚫어져라 보고 계신걸요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"아, 어서 오세요! ……지휘관님 드리려고 간식으로 도시락을 준비했어요. 드시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"꺅?! 지휘관님! 어디 한번 해명해 보세요! ……\"미안해, 마이 스위트 허니\"…? 좀 억지스럽지 않나요? …뭐, 이젠 됐어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":{"voiceline":"nil","voicelink":null},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"nil","voicelink":null},"메인3_ex":{"voiceline":"지휘관님과 함께하는 이 시간… 평온해서 너무 좋네요. 후후후… 게다가 여기서는 로열 레이디답게 행동할 필요도 없잖아요. \"지휘관님, 정말 좋아해요♪\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207053/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"학교","상점 id":70995,"상점 카테고리 id":4,"스킨 태그":"L2D, 배경","입수 영상":"X","재화":1180,"기간":"한정 (2025/04/23)","진영":"HMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":207054,"클뜯 함순이 id":20705,"함순이 이름":"포미더블","한글 함순이 + 스킨 이름":"로큰 알코올","영문 함순이 + 스킨 이름":"Rockin' Encore","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207054/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207054/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207054/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207054/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207054/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207054/shipyard.png","설명":"휴우… 가위를 겨우 집었네…… 지, 지휘관님?! 왜 벌써 오신 거죠!? 어서 문을 닫고 나가주…… 아, 아니지! 리본 푸는 것 좀 도와주세요!","자기소개":null,"메인1":{"voiceline":"지휘관님, 왜 아직도 거기 계신 거죠? 어서 포미더블 곁에 와서 앉으세요. 후우, 발이 계속 묶여있어서 아파요. 지휘관님, 여기 좀 눌러주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207054/main1.ogg"},"메인2":{"voiceline":"이 곡이랑 그 곡도 준비했어요. 어떤 걸 듣고 싶은지 우선 요청부터…… 후후, 물론 장르는 모두 록이랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207054/main2.ogg"},"메인3":{"voiceline":"일렉트릭 기타를 쳐보고 싶으신가요? 그럼 이렇게 들고 손은 이쪽으로… 어휴, 지휘관님은 묶여 계신 것도 아니니 편하게 계세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207054/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"원래는 방을 조금 장식한 다음에 솔로 라이브를 들려드린 후, 지휘관님이랑…… 그럴 계획이었는데, 설마 이런 모습을 보여드릴 줄은…! 계획이 다 틀어졌어요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207054/detail.ogg"},"드랍 설명":{"voiceline":"휴우… 가위를 겨우 집었네…… 지, 지휘관님?! 왜 벌써 오신 거죠?! 어서 문을 닫고 나가주…… 아, 아니지! 리본 푸는 것 좀 도와주세요!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었네요. 지, 지휘관님은 계속 포미더블 곁에 있어 주실 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207054/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"연주를 시작할게요. 다만 그…… 지휘관님께서 보신… 포미더블의 부끄러운 모습은 다 잊어주세요! ……네? 귀여우니까 잊기 싫다고요…? 그런 입발린 말은 누구한테 배우신 거죠… 알았어요. 그렇다면 귀여운 포미더블을 영원히 기억해 주세요. 단…… 아무한테도 말씀하시면 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207054/feeling5.ogg"},"터치3":{"voiceline":"그러면 머리카락이 엉망이……네? 이미 엉망이라고요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207054/headtouch.ogg"},"모항귀환":{"voiceline":"이 고양이 좀 빨리 치워주세요! 이러다 가위에 찔리기라도 하면…… 꺅?! 거기 당기지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207054/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님! 계속 거기 서 계실 건가요?! 어서 리본 좀… 풀어주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane