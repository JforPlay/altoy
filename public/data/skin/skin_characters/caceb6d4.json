[{"클뜯 id":9704020,"클뜯 함순이 id":970402,"함순이 이름":"샤른호르스트·META","한글 함순이 + 스킨 이름":"샤른호르스트·META","영문 함순이 + 스킨 이름":"Scharnhorst META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9704020/shipyard.png","설명":"메탈 블러드 전함, 샤른호르스트다. 뛰어난 지휘관이라고 들었는데, 앞으로 너와 협력할 날이 기대되는군. 날 실망시키진 않겠지?","자기소개":{"voiceline":"난 샤른호르스트다. 전쟁터에서 용감하게 물러서지 않는 것이 나의 원칙이다. 나는 성격이 그렇게 좋진 않아, 만약 내 말이 뜻하지 않게 너를 불편하게 했다면 용서해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/profile.ogg"},"메인1":{"voiceline":"항공모함…… 정보 획득과 초원거리 전투에서 그들이 한 수 위임을 인정하지 않을 수 없겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/main1.ogg"},"메인2":{"voiceline":"몸의 상처는 나을 수 있지만 마음의 상처는 쉽게 말할 수 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/main2.ogg"},"메인3":{"voiceline":"\"못난 자매\"…… 추억 속의 호칭이군. 적의 증오와 원한은, 가장 설득력 있는 인정한다는 말 아닌가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/main3.ogg"},"전투개시":{"voiceline":"만약 적에게 심한 타격을 주지 못한다면, 그들의 소리가 너의 귓가에서 계속 맴돌 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/battle.ogg"},"상세확인":{"voiceline":"상처 하나 하나가 전쟁터에서 사신을 스치고 지나갔다는 증거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/detail.ogg"},"드랍 설명":{"voiceline":"샤른호르스트호 전함 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 맡았던 동료들이 돌아왔다. 지금 우리는 마중나갈 여유가 없으니, 다른 사람을 보내.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/expedition.ogg"},"실망":{"voiceline":"너처럼 나약한 지휘관은 함대 전체를 책임질 수 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/feeling1.ogg"},"낯섦":{"voiceline":"난 전장에서 물러서지 않는다. 그렇다고 평소에도 양보할 줄 모르는 사람은 아니니 안심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/feeling2.ogg"},"호감":{"voiceline":"이 모항에는 대련을 좋아하는 사람들도 있겠지? 나에게 몇 명 소개 좀 시켜줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/feeling3.ogg"},"기쁨":{"voiceline":"너의 모항에 온지도 어느 정도 시간이 흘렀군. 동료와 계속 대련하며 지내고 있지만, 뭔가 점점 편안해지고 있는 것 같다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/feeling4.ogg"},"사랑":{"voiceline":"여기서 나는 오랜만에 안도감을 찾았다… 이 평안이 깨질 때 무슨 일이 일어날까…? \"그런 일은 일어나지 않을 거야\"라고? 듣기에 허무맹랑한 이 말이, 네 입에서 나오니까, 좀 사실감이 있네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/feeling5.ogg"},"터치3":{"voiceline":"지금은 이럴 때가 아니라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/headtouch.ogg"},"모항귀환":{"voiceline":"격전이 막 끝났을 때가 흔히 사람들이 가장 방심하는 순간이다. 긴장을 놓지 말아라, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/home.ogg"},"hp 경고":{"voiceline":"감히 내게 도전하다니…… 후회하게 될 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/hp_warning.ogg"},"로그인":{"voiceline":"이왕 왔으니 서둘러 업무 상태로 돌입하라고. 우선 이 공문부터 같이 볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/login.ogg"},"실패":{"voiceline":"미안하지만 난 이대로 후퇴할 수 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/lose.ogg"},"우편":{"voiceline":"우편 왔어. 중요한 정보는 이미 표시해뒀고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/mail.ogg"},"임무":{"voiceline":"… 새로운 임무에 손이 부족하다고? 뭐야, 넌 내가 감당할 수 없을 거라 생각하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/mission.ogg"},"임무완료":{"voiceline":"좋은 소식을 알려주지——임무를 완료했다. 보상도 확인 끝났어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/mission_complete.ogg"},"서약":{"voiceline":"세상일은 변덕스럽지. 나는 내가 줄곧 너의 곁에서 함께할 수 있으리라고 장담할 수 없다.…… 하지만, 나는 네가 마음속으로 꿈꾸는 그 미래에 내 모든 힘을 바치고 싶다. 이 샤른호르스트는, 널 위해 무엇이든 하겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/propose.ogg"},"스킬":{"voiceline":"전장에서 자비란 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/skill.ogg"},"터치1":{"voiceline":"피곤해? 조금만 더 버텨, 잠시 후면 쉴 수 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/touch.ogg"},"터치2":{"voiceline":"저급한 취미……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드 전함, 샤른호르스트다. 뛰어난 지휘관이라고 들었는데, 앞으로 너와 협력할 날이 기대되는군. 날 실망시키진 않겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/unlock.ogg"},"강화성공":{"voiceline":"차라리 이번 기회에 시험 사격을 해보자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"날뛰고 도발하는 적들에게 있어 이는 당연한 최후다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9704020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_e