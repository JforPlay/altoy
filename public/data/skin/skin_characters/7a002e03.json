[{"클뜯 id":702050,"클뜯 함순이 id":70205,"함순이 이름":"쿠이비셰프","한글 함순이 + 스킨 이름":"쿠이비셰프","영문 함순이 + 스킨 이름":"Kuybyshev","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702050/shipyard.png","설명":"차파예프급 경순양함—쿠이비셰프","자기소개":{"voiceline":"68-k형, 차파예프급인 쿠이비셰프야. 그 대전에 참가하기도 전에 건조가 중지되어, 활약할 기회를 잃었어. 아쉽지 않다고 하면 거짓말일 테지만, 그만큼 당신에게 힘이 되었으면 해. 지휘관, 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/profile.ogg"},"메인1":{"voiceline":"음…… 괜찮아. 오늘 심사 서류 확인도 문제 없어. 늘 고생이 많네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/main1.ogg"},"메인2":{"voiceline":"후우, 후우… 이걸로 됐으려나. 지휘관, 커피야. 식기 전에 이걸로 몸을 덥히도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/main2.ogg"},"메인3":{"voiceline":"자기 자신을 믿어. 푸른 바다의 평화를 위해 당신이 한 일들은 분명 그만한 가치가 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/main3.ogg"},"전투개시":{"voiceline":"경외하라! 그리고 나를 따르라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/battle.ogg"},"상세확인":{"voiceline":"다치는 건 두렵지 않아. 내가 다쳐도, 지휘관과 동료들을 지킬 수만 있다면 그걸로 충분해. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/detail.ogg"},"드랍 설명":{"voiceline":"차파예프급 경순양함—쿠이비셰프","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 곧 돌아오겠네. 모항까지 안내해주고 올게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/expedition.ogg"},"실망":{"voiceline":"…역시 차파예프처럼 조교를 해주는 편이 적절할 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/feeling1.ogg"},"낯섦":{"voiceline":"모항의 밤은 추워. 그리고 이런 모항의 밤거리를 굳이 걸어다니는 지휘관에게는 분명 무슨 이유가 있는 거겠지. 혹시 괜찮으면… 내게도 알려줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/feeling2.ogg"},"호감":{"voiceline":"또 여기서 만났네. 괜찮아? 안 추워? 몸은 물론이고, 지휘관의 마음까지 늘 따뜻하고 건강했으면 해. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/feeling3.ogg"},"기쁨":{"voiceline":"그래그래, 착하지 착해. 아침에 눈을 떴을 때엔 다시 모항의 모두가 의지하는 지휘관으로 돌아가도록 해. 그때까진… 내 곁에 계속 있어도 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/feeling4.ogg"},"사랑":{"voiceline":"오늘 밤은 달이 아름답네. …이 마음이 따뜻해지는 느낌, 지휘관과 같이 있을 때만 느낄 수 있는 것 같아. 고민도 약점도 모두 내게 보여준 지휘관을 계속 이렇게 보고 싶어…. 후후후, 조금만 더 말이야. 지금은 나보다, 달을 더 봐 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/feeling5.ogg"},"터치3":{"voiceline":"괜찮아. 걱정해줘서 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와. 방금 전투로 좀 젖었네…. 감기 걸리기 전에 일단 옷을 갈아 입는 편이 좋겠어. 좀 도와줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/home.ogg"},"hp 경고":{"voiceline":"윽…! 버텨야 해…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/hp_warning.ogg"},"로그인":{"voiceline":"휴우… 지휘관. 좋은 아침이야. 추우면 이쪽으로 와. 내 의장으로 따뜻하게 해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/login.ogg"},"실패":{"voiceline":"나는 쓰러져도 괜찮아. 동료들만은…… 윽!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/lose.ogg"},"우편":{"voiceline":"우편이 왔어. 마음이 식기 전에 답장을 쓰자구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/mail.ogg"},"임무":{"voiceline":"미완료된 임무… 내가 도와줄 수 있는 부분이 있다면 뭐든 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/mission.ogg"},"임무완료":{"voiceline":"임무를 다 처리한 것 같네. 보르시라도 먹으면서 잠깐 쉴래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 명심해. 삶이 당신을 배신하더라도, 슬퍼하거나 화내지 말아줘. 내가 늘 당신 곁에서 눈이 멎고 하늘이 맑아질 때까지, 당신의 마음을 따뜻하게 덥혀줄 테니까…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/propose.ogg"},"스킬":{"voiceline":"녹아버려라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/skill.ogg"},"터치1":{"voiceline":"괜찮아. 나는 여기 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/touch.ogg"},"터치2":{"voiceline":"약식 처벌'이라는 말…… 들어본 적 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/touch2.ogg"},"입수시":{"voiceline":"지휘관, 만나서 반가워. 나는 노스 유니온 소속 경순양함 쿠이비셰프야. 마음을 굳게 먹고 함께 이 전쟁을 이겨내자구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/unlock.ogg"},"강화성공":{"voiceline":"다음 전투를 대비하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"훌륭하고, 마음이 훈훈해지는 승리네. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관이 우릴 보고 있다! 전함 진격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/battle_ex.ogg"},"상세확인_ex":{"voiceline":"아얏… 미안, 붕대를 감아달라고 해서… 괜찮아. 훈련은 역시 진지하게 임하는 게 좋아. 그리고 이정도는 이미 익숙해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관의 고민을 해결하고, 지휘관의 이불을 덮히는 건 모두 내 책임이지… 농담이야♪ 그런 건 책임 때문에 하는 게 아니라, 진심으로 하고 싶어서 하는 거야… 지휘관이 물어보려던 건 이런게 아니라고? 그렇구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"난 괜찮은데… 아, 그런 뜻이 아니라고? 하하… 미안, 살짝 오해했네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관, 이쪽으로 와. 드디어 돌아왔구나. 자, 뜨끈한 버섯 수프 마셔봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"휴우… 지휘관? 네가 히터 틀어준 거야? 고, 고마워…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/login_ex.ogg"},"실패_ex":{"voiceline":"…난 물러서지 않아! 우리가 최후의 방어선이니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/lose_ex.ogg"},"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"임무 보상이 좀 적네. 조사를 해봐야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"이건 믿음직한 지휘관의 구조 신호인 건가? 후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/touch_ex.ogg"},"터치2_ex":{"voiceline":"지휘관 손, 따뜻해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"분위기가 뜨겁네. 더 이상 따뜻하다는 말로 표현할 수 없겠어. 후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['차파예프'] :  앞장 설게! 차파예프!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"허리 피고! 똑바로 서! 고개 들고!… 후후, 이제 외출할 수 있겠다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/main5_ex.ogg"},"메인6_ex":{"voiceline":"후, 후…… 이런. 보온병의 차를 미리 따르는 걸 깜박했네… 아, 아무것도 아냐. 혀를 데일까봐 무서워하는 게 아니라고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"무슨 복잡한 일 있어? 내가 도와줄게… 아, 그냥 넋놓고 있던 거라고? 그랬구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702050/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"SN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":702051,"클뜯 함순이 id":70205,"함순이 이름":"쿠이비셰프","한글 함순이 + 스킨 이름":"은빛 현의 향도병","영문 함순이 + 스킨 이름":"Maestro of Sterling Strings","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702051/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/702051/shipyard.png","설명":"…이걸로 한 곡 끝. 이스트 글림의 춘절에 미력하게나마 나도 힘을 보탰어. …지휘관도 감상하러 온 거야? 그럼… 방금 곡에 대한 감상 좀 들려줄래? 후후후.","자기소개":null,"메인1":{"voiceline":"유유한 생명의 숨결을 겨울로, 찬란한 단란함의 정취를 봄으로. 이스트 글림의 음악… 잘 표현하고 있네. 귀가 행복하다는 건 바로 이런 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/main1.ogg"},"메인2":{"voiceline":"미유키, 길을 잃은 거야? 괜찮아, 우리가 숙소까지 데려다줄게. 그렇지, 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/main2.ogg"},"메인3":{"voiceline":"싸우는 걸 잊고 느긋하게 시와 음악을 즐기는 것… 오늘은 이것만 하면 된다는 거지. 지휘관도 푹 쉬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/main3.ogg"},"전투개시":{"voiceline":"정신 바짝 차려! 여긴 전장이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/battle.ogg"},"상세확인":{"voiceline":"붕대가 역시 신경 쓰이는구나. 미안해, 장식 준비할 때 조금 부딪혀서… 괜히 걱정하게 만들었나봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/detail.ogg"},"드랍 설명":{"voiceline":"…이걸로 한 곡 끝. 이스트 글림의 춘절에 미력하게나마 나도 힘을 보탰어. …지휘관도 감상하러 온 거야? 그럼… 방금 곡에 대한 감상 좀 들려줄래? 후후후.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"잠이 안 와? 따뜻한 우유를 마시고, 클래식이라도 들으면서 누우면 바로 잠이 오려나. 걱정되는데 나도 옆에 같이 있어줄까? 오늘은 가족끼리 단란하게 보내는 날이잖아? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"음악을 들으면서 여유롭게 보내자. 오늘은 그렇게 긴장할 필요 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"봄이라고는 하지만 아직 추운 시기야. 감기에 걸리지 않도록 조심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"신청곡이 있으면 말해봐. 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/touch.ogg"},"터치2":{"voiceline":"만지는 건 금지라고 하더라, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/touch2.ogg"},"입수시":{"voiceline":"…이걸로 한 곡 끝. 이스트 글림의 춘절에 미력하게나마 나도 힘을 보탰어. …지휘관도 감상하러 온 거야? 그럼… 방금 곡에 대한 감상 좀 들려줄래? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"연회에 걸맞는 승리라 다행이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/702051/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null