[{"클뜯 id":199050,"클뜯 함순이 id":19905,"함순이 이름":"할포드","한글 함순이 + 스킨 이름":"할포드","영문 함순이 + 스킨 이름":"Halford","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199050/shipyard.png","설명":"플레처급 구축함 - 할포드","자기소개":{"voiceline":"이글 유니온 소속, 플레처급 할포드야. 어두운 바다를 누비는 일족의 127번째 로드이자…… 뭐? 분명 자기소개 때는 126번째라고 했다고? 그럴 리가…… 내가 그런 하찮은 실수를…… 부, 분명 지휘관 앞이라 긴장해서 그런 걸 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/profile.ogg"},"메인1":{"voiceline":"내 의장인 「도라」는 가장 충성스러운 종복이야. 지휘관, 어서 인사해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/main1.ogg"},"메인2":{"voiceline":"우리 가족의 일원이 되면 불로불사의 몸을 손에 넣을 수 있고, 업무를 더 많이 처리할 수 있어. …노, 농담이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/main2.ogg"},"메인3":{"voiceline":"어두운 밤 속에서 살며, 빛을 동경하는… 그것이야말로 바로 우리 일족이지. 뭐, 뭐가 그렇게 웃겨! 진심으로 내 「설정」을 설명해 주는 중이잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/main3.ogg"},"전투개시":{"voiceline":"근무 시간이니… 진심으로 임해주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/battle.ogg"},"상세확인":{"voiceline":"지휘관, 그 눈… 우리 일족의 일원이 되고 싶은 모양이군. ……자, 잠깐만 기다려. 우선은 여기 서류를 모두 처리한 다음에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함 - 할포드","voicelink":null},"의뢰 완료":{"voiceline":"오늘도 의뢰팀이 열심히 업무를 처리했네. 밤이 찾아오기 전에 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/expedition.ogg"},"실망":{"voiceline":"으윽, 지휘관이 이렇게 파렴치한 녀석일 줄은 몰랐어…! 우리 일족의 일원이 되기 전에 먼저 근무 태도부터 바로잡도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/feeling1.ogg"},"낯섦":{"voiceline":"업무를 처리한 상으로 가장 맛있는 피를 나눠줄게. ……체리 주스야! 그래도 맛은 있으니까 꼭 마셔봐~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/feeling2.ogg"},"호감":{"voiceline":"일족을 가까이하는 자는 저주받는다…는 건 어디까지나 소설에나 나오는 「설정」일뿐이야. 그런 설정도 좋지만, 지휘관이 저주를 받는 건 원하지 않는달까… 저, 정말 저주를 받으면 내가 온 힘을 다해서 지켜줄게! ……그러니까 조금만 더, 가까이 와 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/feeling3.ogg"},"기쁨":{"voiceline":"더 열심히 업무를 처리하고 싸우고, 지휘관을 방해하는 자들을 모조리 해치우는 완벽한 일족의 로드가 되고야 말겠어. 그때까지는… 후후, 나를 갈구하는 그 눈을 내게서 거두지 말아줘♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/feeling4.ogg"},"사랑":{"voiceline":"후훗, 이건 내가 요즘 읽고 있는 소설이야. 일족의 상급자와 그 종복 사이에서 피어나는 로맨스… 그리고 결국은 두 사람이 맺어지는 스토리야. 그래서 말인데 지휘관, 일족의 로드에게 포옹을 받은 종복이라는 「설정」… 받아들여 주지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/feeling5.ogg"},"터치3":{"voiceline":"저주받은 힘에 삼켜지지 않도록 조심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/headtouch.ogg"},"모항귀환":{"voiceline":"내가 기대하는 지휘관은 겨우 한 번의 승리로는 들뜨지 않는 사람이야. 자, 여기 정리해 둔 업무표야. 이번에는 서류와의 전투를 시작하도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/home.ogg"},"hp 경고":{"voiceline":"이래선 업무를 처리할 수가 없잖아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 이렇게 오래 기다리게 하다니. 이렇게 업무가 많이 남았는데 어떻게 그렇게 푹 잘 수 있는 거지…? 어서 업무를 시작하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/login.ogg"},"실패":{"voiceline":"뭐?! 내, 내가 졌다고?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/lose.ogg"},"우편":{"voiceline":"지휘관, 네 앞으로 온 편지야. 읽는 거 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/mail.ogg"},"임무":{"voiceline":"지휘관, 아직 업무가 끝나지 않았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐네. 업무를 열심히 처리한 성과라면 여기 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/mission_complete.ogg"},"서약":{"voiceline":"이, 이건…… 오랫동안 함께 하자는 계약?! 그렇다면 오늘 고귀한 내가 처리할 마지막 업무는…… 그래. 네 영원한 서약에 응할게. 일족의 로드를 따르는 종복으로서 영원히 내 곁에 머물도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/propose.ogg"},"스킬":{"voiceline":"나태한 자에게 어두운 밤의 심판을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/skill.ogg"},"터치1":{"voiceline":"우산을 씌워 주려고? 후후, 그것도 일족의 일원으로서 할 일 중 하나지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/touch.ogg"},"터치2":{"voiceline":"으앗?! ……그, 그렇게 내 피를 원해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/touch2.ogg"},"입수시":{"voiceline":"내 이름은 할포드… 플레처급의 혈통을 잇는 126번째 로드이자 비범한 업무 능력을 지니고 있지. 으흠, 소문으로 많이 들은 지휘관. 우리 일족의 일원이 되고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/unlock.ogg"},"강화성공":{"voiceline":"힘이 끝없이 솟아올라…… 업무를 해야 해! 자, 어서 업무를 시작하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후후, 이것이 바로 나의 힘…… 나태한 자여, 그 눈에 똑똑히 새겨두도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"내 모습이 신경 쓰여? 후후후~ 이건 모항에서 단 한 벌밖에 존재하지 않는, 특별히 주문 제작한 일족의 테마 의상이야♪ 열심히 일한 보상으로 나 자신에게 사준 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"자, 돌아온 의뢰팀을 마중하러 나가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/expedition_ex.ogg"},"사랑_ex":{"voiceline":"이 소설의 「설정」은 어때? 마음에 들면 다음에 주문 제작으로 테마 의상을 보내줄까 하는데… 후훗, 물론 나랑 한 쌍으로 맞춰서 말이야. 어머, 종복에게 거부할 권리 따위는 없어. 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"이건 내 종복으로서의 특권이지///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"할포드의 종복, 지쳤어? 후후후, 어쩔 수 없네. ……너는 여기서 쉬고 있어. 대신 내가 업무를 처리해 줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"내 고귀한 종복이여, 업무를 시작하기 전에 요즘 읽고 있는 소설을 네게도… 『어둠의 일족이 다스리는 세상에 상위자로 환생해 워커홀릭 제국 건설』 ……제목만 들어도 재미있을 것 같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/login_ex.ogg"},"실패_ex":{"voiceline":"이, 이런 실수를…… 이런 꼴을 보이고 싶지는 않았는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/lose_ex.ogg"},"우편_ex":{"voiceline":"네 앞으로 온 우편이야. 내가 직접 읽어줘?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/mail_ex.ogg"},"임무_ex":{"voiceline":"완료하지 않은 임무는 이미 내가 다 처리했어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/mission_ex.ogg"},"임무완료_ex":{"voiceline":"업무 완료. 고생 많았어. 내 「피」로 에너지를 보충할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"또 「피」를 마시고 싶은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/touch_ex.ogg"},"터치2_ex":{"voiceline":"응?! 깨, 깨문 거야…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":{"voiceline":"종복이여, 내 되살아나는 힘이 느껴지는가? ……이럴 때는 당연히 「네」라고 대답해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/upgrade_ex.ogg"},"승리_ex":{"voiceline":"너를 위해서라면 얼마든지 계속해서 이길 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['듀크 오브 요크', '뱀파이어'] :  동족의 냄새가 나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/couple_encourage1.ogg"}],"메인4":{"voiceline":"밤뿐만 아니라 낮에도 같이 업무를 처리해 줄게. 후훗, 내 「설정」도 햇빛을 두려워하지 않는 「데이워커(Daywalker)」니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"종복이 되고 난 후부터 업무가 좀 수월해진 것 같다고? ……흐음? 어쩔 수 없네. 내가 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/main5_ex.ogg"},"메인6_ex":{"voiceline":"슬슬 마시고 싶지? 좋아, 내가 나눠 줄게. …신선한 체리를 짠 주스를 시원하게 보관해 둔 거야. 엄청 맛있어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/main6_ex.ogg"},"메인7_ex":{"voiceline":"종복, 혹시 새로 산 소설 못 봤어? ……뭐? 종복 방에 떨어져 있었다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/main7_ex.ogg"},"메인8_ex":{"voiceline":"「강한 자에게는 그만한 양의 업무가 따른다」――이건 내 좌우명이야. 그래도 괜찮아. 내가 훨씬 강하니까, 안심하고 맡기면 돼. 내가 다 처리해 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199050/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":199051,"클뜯 함순이 id":19905,"함순이 이름":"할포드","한글 함순이 + 스킨 이름":"바니 「로드」 리미티드","영문 함순이 + 스킨 이름":"A Special Day with the Bunny Lord","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199051/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199051/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199051/shipyard.png","설명":"「손님, 어서 오세요♪ 자, 이쪽으로 오세요~ 주문이든 대화든 원하시면 뭐든 함께할게요♪」 ……괜찮은 느낌이라고? 하아… 이래 봬도 이쪽은 진지하게 하고 있거든!","자기소개":null,"메인1":{"voiceline":"여기 「도라」랑 닮은 인형은 내가 준비한 거야. 어떤 상황에서든 업무를 게을리할 수는 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/main1.ogg"},"메인2":{"voiceline":"아이스 체리 주스는 없어. 그것 말고 다른 것도 다 맛있으니까, 내가 추천해 줄게.♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/main2.ogg"},"메인3":{"voiceline":"지휘관이랑 대화만 해주면 「일족의 팀 구축-특장판」을 준다고 아카시가 그랬거든. ……너무 쉬워서 오히려 걱정이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이 모습, 어울려…? 어울리면 다음 설정에 추가해서…… 흠, 특별한 날에는 토끼로 변하는 일종의 로드…는 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/detail.ogg"},"드랍 설명":{"voiceline":"「손님, 어서 오세요♪ 자, 이쪽으로 오세요~ 주문이든 대화든 원하시면 뭐든 함께할게요♪」 ……괜찮은 느낌이라고? 하아… 이래 봬도 이쪽은 진지하게 하고 있거든!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네. 잠깐 확인하고…… 아, 아니지… 지금 내 업무는 지휘관이랑 대화하는 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"이 업무의 좋은 점을 하나만 들자면, 지휘관이랑 느긋하게 이야기할 수 있다는 점이겠지. 평소에는 서로 바빠서 이렇게 느긋하게 보낼 시간이 없으니까…… 지, 지휘관에 대해 더 많이 알고 싶어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/feeling5.ogg"},"터치3":{"voiceline":"이건 금지된…… 으음… 금지된 토끼의 힘에 삼켜지지 않도록 조심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/headtouch.ogg"},"모항귀환":{"voiceline":"마실 거라도 주문할래? 내 담당은 아니지만… 원래 힘을 가진 자일 수록 할일도 많아지는 법이니까, 아무것도 안 하려니 기분이 너무 이상해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘 업무는 여기서 지휘관이랑 대화하는 거랬지. ……그나저나 정말 괜찮은 거 맞아? 일족의 로드인 나한테는 너무 쉬운데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"우리 일족은 다들 피부가 좋아. 당연한 거지♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/touch.ogg"},"터치2":{"voiceline":"응!? 이, 이건 내가 맡은 업무가 아닌데…? /// ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/touch2.ogg"},"입수시":{"voiceline":"「손님, 어서 오세요♪ 자, 이쪽으로 오세요~ 주문이든 대화든 원하시면 뭐든 함께할게요♪」 ……괜찮은 느낌이라고? 하아… 이래 봬도 이쪽은 진지하게 하고 있거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"받아, 푹신한 쿠션이야. 모처럼 느긋하게 쉬는 거니까, 업무 생각은 접어 둬. 나중에 내가 대신 처리해 줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199051/main4.ogg"},"메인1_ex":null