[{"클뜯 id":199010,"클뜯 함순이 id":19901,"함순이 이름":"시애틀","한글 함순이 + 스킨 이름":"시애틀","영문 함순이 + 스킨 이름":"Seattle","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/199010/shipyard.png","설명":"경순양함 - 시애틀 ","자기소개":{"voiceline":"이옙, 전 시애틀…… 아, 정확한 이름은 없지만, 일단 뭐 시애틀이란 느낌임다! 여튼 뭐 자잘한 건 제쳐두고! 어쨌든, 우스터급 프로토타입 중 하나로, 애틀란타급의 개량판인 저는 대공이 특기임다! 날아다니는 적은 제게 맡겨주시란 말씀!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/profile.ogg"},"메인1":{"voiceline":"지휘관님… 비서함이 달랑 혼자인 거 좀 쓸쓸하다고 생각 안하심까? 몇 명 더 불러서 같이 하는 쪽이 더 신날텐데 말임다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/main1.ogg"},"메인2":{"voiceline":"지휘관님 오늘 일 끝나면 한가하심까? 실은 소소하게나마 파티 총무 맡았는데 말임다, 지휘관님이 깜짝 참가 하는 것도 괜찮지 않슴까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/main2.ogg"},"메인3":{"voiceline":"함력상으론 실전 경험 없음이지만, 다들 가르쳐주고 있으니 금방 따라잡겠슴다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/main3.ogg"},"전투개시":{"voiceline":"좋아, 다구리다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/battle.ogg"},"상세확인":{"voiceline":"파티, 다과회, 여자 모임에 회식까지…… OK! 역시 바쁨다~ ……뭐, 이런 게 삶에 충실하다는 거니까 괜찮지만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/detail.ogg"},"드랍 설명":{"voiceline":"경순양함 - 시애틀","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰 깔끔하게 완료했슴다. 돌아온 애들한테 뭐라도 가져다 주는게 좋겠슴다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/expedition.ogg"},"실망":{"voiceline":"응? 파티? 딱히 부르려는 건 아니니, 계속 업무에 매진해주시지 말임다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/feeling1.ogg"},"낯섦":{"voiceline":"당신, 업무나 작전 타령만 하지 말고, 가끔은 쉬어주는 게 좋슴다. 일단 뭐, 좀 있다가 제가 주최하는 파티가 열리는데, 어떻슴까? 오시지 말임다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/feeling2.ogg"},"호감":{"voiceline":"저, 파티 좋아하긴 하지만 억지로 부르지는 않슴다. 뭐, 와주기만 한다면 아무리 내성적인 애라도 실컷 즐길 수 있다고 보장함다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님도 이제야 파티의 매력을 알게 된 모양임다! 그렇슴다! 모두 함께 있으면 자연스레 친해짐다! 예를 들면~ 저와 지휘관님도 이미 친구 사이 아님까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님과 저 사이니까~ 맘에 드는 애 알려주면 다리 정도는 놓아줄 수 있슴다~ 후후훙~♪ ……저 말임까? 에, 앗, 잠깐, 진짜? 저, 저저 정말로……?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 싸움도 중요하지만, 휴식도 중요하단 말임다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/home.ogg"},"hp 경고":{"voiceline":"다들, 조금만 더 힘내는 검다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 밥 먹었슴까? 아직 안 먹었으면, 잠깐 같이 어디 밥 먹으러 가는 건 어떻슴까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/login.ogg"},"실패":{"voiceline":"아니 그게, 화력이 좀 더 있었다면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/lose.ogg"},"우편":{"voiceline":"지휘관님, 새로운 우편임다! 혹시 파티 초대장?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/mail.ogg"},"임무":{"voiceline":"뉴 미션! 일손 모아서 후딱 해치우지 말임다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/mission.ogg"},"임무완료":{"voiceline":"미션 컴플리트! 근데 지휘관님, 축하할 겸 뭐 안 함니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/mission_complete.ogg"},"서약":{"voiceline":"OK, 생각 정리 끝났슴다! 뭐어, 결론부터 말하자면, 저도 지휘관님 좋아함다! 안 그럼 갑자기 마시러 가자고 부르진 않는단 말임다~ 여튼, 다시 얘기를 돌리자면… 오늘은 파티 말고 또 하나 할 게 있슴다…… 데이트말임다! 데이트!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/propose.ogg"},"스킬":{"voiceline":"전장도 후끈 달아오르게 하는 검다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/skill.ogg"},"터치1":{"voiceline":"지휘관님, 댄스 연습이라도 하지 않겠슴까? 춤 잘 추면 인기도 더 생길 건데 말임다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/touch.ogg"},"터치2":{"voiceline":"당신… 방금 일부러 그런 거면 아무리 저라도 화내지 말임다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/touch2.ogg"},"입수시":{"voiceline":"여어! 이 시애틀을 깨운 건 당신임까? ……오오~ 좋아 좋아, 처음 뵙겠슴다~ 나는 시애틀, 앞으로 잘 부탁함다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/unlock.ogg"},"강화성공":{"voiceline":"날파리도 쏴 맞출 것 같은 느낌임다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"빅토리! 돌아가면 성대하게 축하하는 게 좋겠슴다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['애틀란타', '쥬노', '샌디에이고'] : 옷, 모항에 돌아가면 제가 여는 파티에 와주지 않겠슴까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/199010/couple_encourage1.ogg"},{"voiceline":"