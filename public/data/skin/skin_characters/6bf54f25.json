[{"클뜯 id":205130,"클뜯 함순이 id":20513,"함순이 이름":"뱅가드","한글 함순이 + 스킨 이름":"뱅가드","영문 함순이 + 스킨 이름":"Vanguard","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205130/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205130/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205130/shipyard.png","설명":"전함 - 뱅가드","자기소개":{"voiceline":"그 대전에서 마지막으로 완성한 전함이자 로열 네이비의 기사인 뱅가드야. 당신의 검이 되어 이 모항에서 영광스러운 무훈을 세워 보이지. …하나 부탁할 게 있는데, 병장이 너무 낡은 거 아니냐는 말만은 참아주길 바라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/profile.ogg"},"메인1":{"voiceline":"내게 맡겨 둬라, 조지 공. 여왕 폐하와 지휘관의 명령이라면, 기꺼이 적진을 가르는 칼날이 되어 보이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main1.ogg"},"메인2":{"voiceline":"저기 있는 건 비스마르크…? 으으, 좀 거북한데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main2.ogg"},"메인3":{"voiceline":"모항 경비 이상 없음. 지휘관의 신변 경호 역시 빈틈없음! 안심해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main3.ogg"},"전투개시":{"voiceline":"자, 나와 정정당당하게 겨뤄보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/battle.ogg"},"상세확인":{"voiceline":"내 검은 충의의 칼날, 내 포화는 영광의 빛줄기! 빛나라, 로열 세이버-! …으으,부끄러워! 그래도 좀 멋있네. …지, 지휘관?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/detail.ogg"},"드랍 설명":{"voiceline":"전함 - 뱅가드","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀의 귀환이 확인됐어. 지휘관, 마중 나갈 준비 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/expedition.ogg"},"실망":{"voiceline":"하아… 못하겠으면 못 하겠다고 확실히 말하고 다른 사람한테 대신 해달라고 해. 패기도 없으면서 센 척해봤자 비참해 보일 뿐이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/feeling1.ogg"},"낯섦":{"voiceline":"그럼 지휘관, 오늘 업무는… 서류 작업 때문에 잔업…이라고? 이해는하지만, 설마 오늘 연습도 참가 못하는 건 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/feeling2.ogg"},"호감":{"voiceline":"지휘관, 근위 기사라고 해서 언제까지고 모항에 틀어박혀 있을 수만은 없어. 슬슬 출격을……. 하아, 이젠 한계야. 스트레스가 쌓여….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/feeling3.ogg"},"기쁨":{"voiceline":"뭐? 또 서류 작업? 하긴 할 건데, 슬슬 이런 작업은 끝날 때도 되지 않았어……? 무리해서까지 출격하자는 건 아니지만, 지휘관의 지시로 어떻게 좀……. 괜찮다고?! 신난다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/feeling4.ogg"},"사랑":{"voiceline":"휴~ 후련하다! 역시 지휘관! 가끔은 이런 좋은 모습도 보여주네! 후후, 이래야 근위 기사로서 모시는 보람이 있지. 자, 내 검을 주관하는 자여, 뱅가드에게 다음 명령을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/feeling5.ogg"},"터치3":{"voiceline":"무슨 볼일…이라도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관께서 귀환하셨다! 다들, 전투 회고 및 수리 보급을……. 지휘관, 여긴 내게 맡기고 잠깐 휴식 좀 취해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/home.ogg"},"hp 경고":{"voiceline":"흥, 만만치 않군…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/hp_warning.ogg"},"로그인":{"voiceline":"지휘관께서 도착하셨다! 다들, 정신 바싹 차려! …그럼, 일 좀 해볼까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/login.ogg"},"실패":{"voiceline":"흥! 두고 봐…! 아, 아무것도 아니야. 어서 다른 사람들 데리고 돌아가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/lose.ogg"},"우편":{"voiceline":"여기 새로운 우편이야. 지휘관, 확인 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/mail.ogg"},"임무":{"voiceline":"새 임무가 내려왔어. 지휘관, 처리 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/mission.ogg"},"임무완료":{"voiceline":"임무 완료. 하아, 더 빨리 눈치챘어야 했는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/mission_complete.ogg"},"서약":{"voiceline":"반지의 계약에 따라 이 뱅가드의 검, 그리고 목숨을 영원히 지휘관에게 바치겠다고 맹세하지! …휴우~ 이젠 좀 편하게 있어도 되려나? 지휘관 앞에서까지 계속 멋진 척할 필요는 없을 거 같으니 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/propose.ogg"},"스킬":{"voiceline":"기사의 검술을 보여주지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/skill.ogg"},"터치1":{"voiceline":"근위 기사로서, 지휘관의 안전과 보좌 임무를 착실히 수행하도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/touch.ogg"},"터치2":{"voiceline":"자, 자~ 이런 행동은 당장 그만두……. 윽, 박살나고 싶어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/touch2.ogg"},"입수시":{"voiceline":"로열 기사대 소속 근위 기사 뱅가드, 지금 막 착임했어! 지금부터 내 검을 귀공에게 맡기고, 귀공을 위해 내 충의를 다 바칠 것을 맹세하지! 여왕 폐하, 그리고 함선을 이끄는 지휘관에게 큰 영광이 있으라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/unlock.ogg"},"강화성공":{"voiceline":"이 검은 로열 네이비와 지휘관의 영광을 위한 것!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"해냈다! 뱅가드의 승리다! …(이 승리의 영광을 지휘관에게 바쳐야지!) …크, 큰일이야, 마음속 소리가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/win_mvp.ogg"},"전투개시_ex":{"voiceline":"왔네, 왔어! 드디어 내 차례야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/battle_ex.ogg"},"상세확인_ex":{"voiceline":"포미더블 님과는 달리 평범한 방이지? 후훗, 자고로 기사란 늘 규칙적으로 행동하고, 정리정돈도 제대로 해야… 서, 선반 틈새는 들여다보면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀이 귀환한 걸 확인했어. 어서 마중 나가자, 지휘관! 겸사겸사 같이 출격도 하고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/expedition_ex.ogg"},"사랑_ex":{"voiceline":"하아… 이런 귀찮은 업무, 지금까지 잘 처리해온 지휘관이 대단해. 그래, 이 뱅가드가 괜찮은 스트레스 해결 방법을 알려줄게. 바다로 나가서 연습하고 전투하… 데, 데이트?! 가, 가, 갑자기 무슨 말을 꺼내는 거야?! ////","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"쓰담쓰담하는 건 뭐… 딱히 상관없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"아, 왔네. 그래그래, 오늘도 어울려 줄게. 그게 기사이자 비서함으로서의 업무…가 아니라, 내가 좋아서 하는 거니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/login_ex.ogg"},"실패_ex":{"voiceline":"이기고 지는 건 그 때 운에 달렸지. 바보처럼 보이고 싶지 않으면, 다음엔 열심히 해야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/lose_ex.ogg"},"우편_ex":null,"임무_ex":{"voiceline":"새 임무가… 으엑, 이거 귀찮은 녀석이 걸렸네….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":{"voiceline":"기술명은… 부끄러우니까 역시 없는 걸로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/skill_ex.ogg"},"터치1_ex":{"voiceline":"어떤 일이든 맡겨둬. 기사의 책무에 대해서는 늘 유념하고 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/touch_ex.ogg"},"터치2_ex":{"voiceline":"이, 이쪽이 더 좋다고 하는 말에 내가 속아 넘어갈 것 같아…? ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"로열 세이버, 플래~시! …어, 어라… 적은 이제 없다고? 으아아, 방금 나… 엄청나게 부끄러운 꼴을 보인 것 같은데?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['스루가'] :  무슨 소리가 들리는 것 같은데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/couple_encourage1.ogg"},{"voiceline":"['후드'] :  후드 님, 조심하십시오!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/couple_encourage2.ogg"}],"메인4":{"voiceline":"솔직히 말해서, 로열 네이비 요리 좀 별로지 않아? 물론 각자 취향이 다르기도 하고, 로열 네이비 출신인 내가 할 말은 아닌 것 같지만…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"출격이란 곧, 내가 활약할 기회지! 영광도 중요하지만, 사실은 다들 멋진 활약을 보여서 우쭐대고 싶어 하잖아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main6_ex.ogg"},"메인7_ex":{"voiceline":"후드 님의 그 우아함… 흉내내려면 힘들겠네…. 따, 딱히 절대 못한다고 한 건 아니거든?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main7_ex.ogg"},"메인8_ex":{"voiceline":"로열 네이비의 미식 중에 아침 식사만은 인정해! 이 뱅가드가 보증할게! 원하면 내가 만들어 줄 수도 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"지휘관, 오늘 일정표는 이거다! …으아, 보고 싶은 방송이 겹치네……. 아, 아니, 아무것도 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"화려하게 적을 박살내기엔, 역시 모항 경비보다는 출격이 낫지! 이런 것 보면 빅토리어스 님과는 마음이 잘 맞는 것 같아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main9_ex.ogg"},"메인10_ex":{"voiceline":"온라인으로 주문한 물건이 도착했다고…? 아, 아니아니아니, 이건 그… 뭐 별건 아니고….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205130/main10_ex.ogg"},"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스