zurLane/main/audio/voiceline/205131/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"뱅가드의 메이드로서 활약은 흡족하신지요? 적성에 맞지 않다고는 했지만, 그래도 맡겨진 일은 성실히 하는 성격이라고. …아, 앞으로도 계속 부탁한다니… 설마 내가 고생하는 걸 즐기고 있는 건 아니겠지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"귀환하시는 지휘관께 경례! 그나저나 다음 출격 때는 당연히 날 편성에 넣어 줄 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관께서 도착하셨다! …대사가 다르다고 해도, 메이드 같은 건 내게 무리라고….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/login.ogg"},"실패":{"voiceline":"최악이야…. 그러니까 내 스타일이 아니라고 했잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/lose.ogg"},"우편":null,"임무":{"voiceline":"새로운 임무야. 대응 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"알겠습니다, 주인님. 무엇이든 명령만 내려주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/touch.ogg"},"터치2":{"voiceline":"다른 메이드대 사람이랑 비교하면, 눈을 뭉개버릴 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/touch2.ogg"},"입수시":{"voiceline":"\"뭐든 분부만 내려주십시오, 주인님\" …아까부터 생각한 건데, 이런 옷을 내게 입히다니, 상당한 악취미 아니야? 봐, 이렇게 메이드 흉내나 시키고, 내가 그런 걸 어떻게 해…. 옷은 귀여운데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"우아하고… 화려하게 두들겨 패줬지! 에헴!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205131/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":n