[{"클뜯 id":102070,"클뜯 함순이 id":10207,"함순이 이름":"쥬노","한글 함순이 + 스킨 이름":"쥬노","영문 함순이 + 스킨 이름":"Juneau","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102070/shipyard.png","설명":"애틀란타급 경순양함·쥬노 (CL-52)","자기소개":{"voiceline":"애, 애틀란타급의 쥬노입니다… 대공 능력이 높기 때문에 기동함대에 배속되었습니다만, 사실 포격 당하는 게 무서워서…… 이스피리투산투로 돌아갈 수 없었던 건 유감이었어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/profile.ogg"},"메인1":{"voiceline":"꺄! …지휘관 씨? 까, 깜짝 놀랐어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/main1.ogg"},"메인2":{"voiceline":"좀 더 용감해지고 싶어… 그렇지만 정말 어려워요오…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/main2.ogg"},"메인3":{"voiceline":"지휘관 씨, 쥬노가 폐를 끼쳤나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/main3.ogg"},"전투개시":{"voiceline":"모두… 수비에 신경 쓰고… 꺼림칙한 잠수함에 주의해줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/battle.ogg"},"상세확인":{"voiceline":"다리의… 예전 상처 말인가요? 응…… 아직도 조금 어색하지만, 모두의 발목을 잡지는 않아요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/detail.ogg"},"드랍 설명":{"voiceline":"애틀란타급 경순양함·쥬노 (CL-52)","voicelink":null},"의뢰 완료":{"voiceline":"저어… 지휘관 씨… 완료된 의뢰가 있는데요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/expedition.ogg"},"실망":{"voiceline":"오지 마! ──미안해요…… 지휘관 씨가 조금 무서워서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/feeling1.ogg"},"낯섦":{"voiceline":"쥬노는…… 악몽을 자주 꾸는데요, 왠지 얼굴이 흐릿하고 비슷한 사람 5명이, 쥬노에게 함께 가자고…… 무서워요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/feeling2.ogg"},"호감":{"voiceline":"지휘관 씨, 오늘도 함께 자도 될까요…… 지휘관 씨와 함께 자면 매우 안심이 돼요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/feeling3.ogg"},"기쁨":{"voiceline":"악몽은 이제 두렵지 않지만…… 지, 지휘관 씨와 함께 자도 괜찮을까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/feeling4.ogg"},"사랑":{"voiceline":"최근 그 5명의 사람들이 나오는 꿈을 꿨을 때…… 그 얼굴들이 뚜렷하게 보이더니, 웃는 얼굴로 축복해주고 있었어요…… 하지만, 정말 슬퍼서 울어버릴 것만 같아서(흐느껴 운다)… 쥬노는 지휘관 씨와 함께 행복해질 수 있을까요? 꿈이 아닌가요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"빨리 전쟁이 끝나지 않으려나…… 그렇게 되면 모두와 함께 어딘가로 가자…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지, 지휘관 씨… 쥬노는 계, 계속 기다리고 있었으니까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/login.ogg"},"실패":{"voiceline":"아파! …… 왼발이 움직이지 않아…… 누가, 도와줘……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/lose.ogg"},"우편":{"voiceline":"지휘관 씨…… 죄, 죄송해요…… 편지예요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/mail.ogg"},"임무":{"voiceline":"에? 임무입니까? ──호에…… 대잠 임무가 아니면 좋겠는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/mission.ogg"},"임무완료":{"voiceline":"보너스라니…… 모두와 함께 있을 수 있는 것만으로도 충분해요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/mission_complete.ogg"},"서약":{"voiceline":"……네, 지휘관 씨를 믿고 있어요…… 그 사람들에게는 지금은 행복하다고, 여러분들의 몫까지 살아가겠다고 말하고 왔어요…… 지금은…… 정말로 행복해요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/propose.ogg"},"스킬":{"voiceline":"쥬노도! 히, 힘낼 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/skill.ogg"},"터치1":{"voiceline":"사… 상냥하게 해주세요… 쥬노는 정말 민감하니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/touch.ogg"},"터치2":{"voiceline":"응……. 아으……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/touch2.ogg"},"입수시":{"voiceline":"수, 순양함…… 쥬노입니다…… 아픈 건 싫어…… 으우! 지휘관 씨도 무서워요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/unlock.ogg"},"강화성공":{"voiceline":"쥬노…… 노력하겠습니다……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후우…… 하마터면 피탄될 뻔 했어… 우우… 1위라니── 돌아가는 것만 해도 힘겨운데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":102071,"클뜯 함순이 id":10207,"함순이 이름":"쥬노","한글 함순이 + 스킨 이름":"백조의 화원으로","영문 함순이 + 스킨 이름":"In the Swan Garden","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102071/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102071/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102071/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102071/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102071/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/102071/shipyard.png","설명":"백조는 푹신푹신하고 따뜻해서 기분이 좋아요. 에헤헤, 쥬노의 드레스에 맞춰서 어울리는 리본까지 달고…. 네? 지휘관 씨, 사진 찍어 주신다구요? 폐, 폐가 되지 않는다면 부탁드릴게요…!","자기소개":null,"메인1":{"voiceline":"동물과 어울리면서 지휘관 씨의 평소보다 더 상냥한 모습을 보니, 뭐랄까, 처음에 쥬노가 무서워했던 게 거짓말처럼 느껴져요…. 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/main1.ogg"},"메인2":{"voiceline":"드레스가 어울린다고 칭찬해주셔서 감사합니다! 옷 고르는 것도 그렇고, 데이트 전 준비로 긴장하고 있다는 걸 들은 산후안이 여러모로 도와준 덕분이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/main2.ogg"},"메인3":{"voiceline":"꿈에 그리던 데이트도 하고, 지휘관 씨랑 둘이서 사진까지 찍고… 쥬노는 행복한 사람이에요…. 흐흑….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/main3.ogg"},"전투개시":{"voiceline":"이 평온한 일상이 영원히 계속되도록, 쥬노… 열심히 할게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/battle.ogg"},"상세확인":{"voiceline":"아, 저기 호수, 햇빛이 비쳐서 반짝반짝 빛나네요…! 지휘관 씨, 저쪽으로 가볼… 꺅! 흐흑, 죄송해요, 익숙하지 않은 드레스 차림이라 하마터면 넘어질 뻔했어요. 잡아주셔서 감사합니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/detail.ogg"},"드랍 설명":{"voiceline":"백조는 푹신푹신하고 따뜻해서 기분이 좋아요. 에헤헤, 쥬노의 드레스에 맞춰서 어울리는 리본까지 달고…. 네? 지휘관 씨, 사진 찍어 주신다구요? 폐, 폐가 되지 않는다면 부탁드릴게요…!","voicelink":null},"의뢰 완료":{"voiceline":"안 되지, 안 돼. 경치에 넋을 잃고 있을 때가 아니야…. 지휘관 씨, 의뢰가 완료됐어요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관 씨, 걷다가 지치셨으면 잠깐 벤치에 앉아서 쉬실래요? 다음에는 어디 갈지, 쥬노가 열심히 생각해 볼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"안쪽 경치도 멋지다고 하더라구요. 지휘관 씨… 호, 혹시 괜찮으시면, 쥬노랑 같이 사진 찍어주시면 좋겠어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"죄송해요, 지휘관 씨. 새로운 임무가 온 것 같아요…. 쥬노도 같이 열심히 할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/mission.ogg"},"임무완료":{"voiceline":"임무 보너스가 많이 들어왔어요…! 덕분에 샌디에이고들에게 선물을 사줄 수 있겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"레이스 밑단, 정말 예쁘죠…. 쥬노도 마음에 쏙 들어요 >_<","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/touch.ogg"},"터치2":{"voiceline":"꺄, 꺄앗…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/touch2.ogg"},"입수시":{"voiceline":"백조는 푹신푹신하고 따뜻해서 기분이 좋아요. 에헤헤, 쥬노의 드레스에 맞춰서 어울리는 리본까지 달고…. 네? 지휘관 씨, 사진 찍어 주신다구요? 폐, 폐가 되지 않는다면 부탁드릴게요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"에헤헤, 백조도 기뻐해주고 있네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102071/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70752,"상점 카테고리 id":7,"스킨 태그"