celink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102079/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관 씨, 오늘도 고생 많으셨어요…. 괜찮으시면 다음에는 쥬노도 데리고 가주세요…. 모두와 함께 열심히 해보고 싶어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102079/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"좋은 아침이에요, 지휘관 씨…. 쥬노가 도와드릴 게 있으면 기쁘겠어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102079/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"열심히 분발한 쥬노에게 주는 포상인가요? 감사합니다! >_<","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102079/touch.ogg"},"터치2":{"voiceline":"아… 쥬노를 사, 상냥하게 대해주세요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102079/touch2.ogg"},"입수시":{"voiceline":"개조 항목 엄청 많다… 그, 그래도 어쨌든 쥬노는 개조를 완료해냈다고요! 아직 아픈게 무섭긴 하지만… 지휘관 씨를 위해서, 용기 낼 수 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102079/unlock.ogg"},"강화성공":{"voiceline":"지휘관 씨 덕분이에요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102079/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관 씨 덕분에 얻은 1위에요! 좋긴 하지만, 무엇보다 무사히 전투가 끝나서 다행이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/102079/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"개조","상점 id":0,"상점 카테고리 id":9997,"스킨 태그":"X",