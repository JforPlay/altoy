[{"클뜯 id":201340,"클뜯 함순이 id":20134,"함순이 이름":"저비스","한글 함순이 + 스킨 이름":"저비스","영문 함순이 + 스킨 이름":"Jervis","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201340/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201340/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201340/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201340/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201340/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201340/shipyard.png","설명":"J급 구축함 - 저비스","자기소개":{"voiceline":"J급 구축함인 저비스입니다. 로열 네이비 함대로 여러 작전에 참여했었죠. 함력에 대해서는 '행운'이라는 한 단어로 정리하셔도 딱히 상관없습니다. 보통 다들 눈에 띄는 부분에만 주목하니까요. 제 말이 틀렸나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/profile.ogg"},"메인1":{"voiceline":"눈이 서류랑 너무 가깝네요. 모든 사물을 흐릿하게 보고 싶지 않으시다면, 자세를 바르게 하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/main1.ogg"},"메인2":{"voiceline":"무언가를 보살피거나 모항을 운영하거나, 결국 가장 중요한 것은 사람이겠죠. 자기 일에 열중하는 것도 좋지만, 동료를 소홀히 대하진 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/main2.ogg"},"메인3":{"voiceline":"재너스가 무슨 이상한 말을… 아니에요. 그 아이는 착한데, 다만 가끔 제멋대로 행동하는 면이 있는지라 좀 난감하다고 해야 할지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/main3.ogg"},"전투개시":{"voiceline":"싸우는 동안에도 자기 몸을 지켜야 한다는 걸 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/battle.ogg"},"상세확인":{"voiceline":"재너스만은 다치지 않았으면 해요. 그러니 그 아이를 꼭 지켜주세요. 그리고 그 아이의 친절함에 이상한 마음 품지 마시길 바라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/detail.ogg"},"드랍 설명":{"voiceline":"J급 구축함 - 저비스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었네요. 무언가를 만진 다음에는 꼭 손을 씻으세요. 지휘관님을 간병하는 상황은 피하고 싶으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/expedition.ogg"},"실망":{"voiceline":"과오를 범하고 아무렇지도 않은 사람은 도무지 이해할 수가 없어요. 그래요, 지금 지휘관님 같은 사람 말이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/feeling1.ogg"},"낯섦":{"voiceline":"네, 이걸로 됐어요. 다음부터는 조심하세요. …지휘관님, 지금 막 치료를 해드린 참인데… 어디 편찮으세요? 아니면…. 하아… 너무 한가해서 그런 것뿐이라고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/feeling2.ogg"},"호감":{"voiceline":"출격할 때 무심코 다치지 않도록 조심하시길 바라요. 그러다 쓰러지시면 제가 난처하니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 쓰러지시면, 물론 그 간병은 제가 해야겠지만… 난처한 일인데도 왠지 조금 기대를 하게 돼요. 저야말로 이상한 병에 걸린 걸까요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/feeling4.ogg"},"사랑":{"voiceline":"제가 이렇게나 욕심쟁이였을 줄이야… 이제 더는 드는 약도…. 저기, 지휘관님. 간병 상대를 좋아하게 되는 이유, 알고 계세요? …네? 제가 알려줬으면 한다니… 안 알려줄 거예요, 이 바보.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/feeling5.ogg"},"터치3":{"voiceline":"뭘 하시는 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/headtouch.ogg"},"모항귀환":{"voiceline":"어서 오세… 찰과상을 입으셨네요. 자기가 상처를 입은 것도 모르다니, 이렇게 부주의할 수가…. 지금 조치해 드릴테니 가만히 계세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/home.ogg"},"hp 경고":{"voiceline":"이 정도는 응급처치만 하면 괜찮다구요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/hp_warning.ogg"},"로그인":{"voiceline":"비서함을 너무 오래 기다리게 하는 지휘관은 좋은 지휘관이라고 할 수 없겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/login.ogg"},"실패":{"voiceline":"철수하죠. 휴우… 구조가 늦지 않아 다행입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/lose.ogg"},"우편":{"voiceline":"우편이 도착했습니다. 확인 기한을 넘기면, 확인하고 싶어도 못 하겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/mail.ogg"},"임무":{"voiceline":"쌓인 임무를 방치하는 건, 질병을 방치하는 것과 마찬가지로 이미 심해진 뒤에는 돌이킬 수 없습니다. 하아… 왜 사람들은 다들 이렇게 미루는 걸 좋아하는 걸까요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/mission.ogg"},"임무완료":{"voiceline":"임무를 완료했습니다. 최선을 다한 건지, 더 개선할 여지는 없는지 돌아보는 걸 잊지 마시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/mission_complete.ogg"},"서약":{"voiceline":"다행히 벽창호는 아닌듯한 지휘관님을 위해 받아들이도록 하죠. 당신 뒷바라지 정도는 확실하게 해낼 수 있어요. …네? '기꺼이'라니… 바, 바보! 그런 말은 나중에 몇 번이고 들려 드릴 테니까요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/propose.ogg"},"스킬":{"voiceline":"조심하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/skill.ogg"},"터치1":{"voiceline":"…손을 보여주세요. 괜찮아요, 아무것도 없네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/touch.ogg"},"터치2":{"voiceline":"설마 '일부러 그런 건 아니다'라고 하시려는 건 아니겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/touch2.ogg"},"입수시":{"voiceline":"로열 소속인 J급 구축함 저비스입니다. 부상자를 구하는 게 제 역할이죠. …무척이나 건강해 보이는 지휘관님 상대로는 제가 나설 차례가 없겠네요. 그럼 이만 실례하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/unlock.ogg"},"강화성공":{"voiceline":"다들 강해질 때, 지휘관님도 강해지고 계신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/upgrade.ogg"},"vote":null,"승리":{"voiceline":"부상자 있나요? 간단한 응급처치는 제게 맡겨주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"지휘관님도 그… 일기 같은 거 쓰거나 하세요? …재너스가 늘 일기를 쓰고 있어서, 저도 그 아이처럼 매일 느끼는 감정을 어딘가에… 절대 보여드리지 않을 거예요. 그러니 단념하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰 물자는 다 옮기셨나요? 그럼, 손을 씻읍시다. 자, 손 주세요. 알려드린 순서대로 해 드릴 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/expedition_ex.ogg"},"사랑_ex":{"voiceline":"이 다음에 잠깐 시간 좀 내주실 수 있으실까요? …아뇨, 문진 같은 게 아니라, 데…. 이, 이거면 제가 뭘 하고 싶은 건지 아시겠죠? 받아들일지 말지는 당신 마음……. 바, 바보.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"맨날 이상한 짓만….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"정말, 또 부상이나 당하고… 소독할 때 따끔해도 전 몰라요. 걱정 끼친 지휘관님이 나쁜 거니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"여자를 오래 기다리게 하는 지휘관… 좋지 않다고 생각합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/login_ex.ogg"},"실패_ex":null,"우편_ex":{"voiceline":"새로운 임무네요. 급한 용무가 없으시다면, 어서 확인하시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/mail_ex.ogg"},"임무_ex":{"voiceline":"임무가 쌓여있네요. 처리하는 거 잊지 마시고……. 하아… 이것저것 잔소리하는 게 습관이 되고 만 걸까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무는 완료하셨나요? 잘 하셨습니다. 지휘관님의 '책임감', 잘 봤습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"…바보……. ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"부상자가 없는 승리야말로 완벽한 승리라 할 수 있겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['베스탈'] :  도와드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"건강에 좋지 않은 나쁜 습관은 스스로 고쳐주세요. 저한테 들키면, 고칠 때까지 계속 지켜볼 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201340/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":201341,"클뜯 함순이 id":20134,"함순이 이름":"저비스","한글 함순이 + 스킨 이름":"바람에 휘날리며","영문 함순이 + 스킨 이름":"Fluttering in the Fair Breeze","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201341/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201341/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201341/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201341/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201341/shipyard.png","설명":"휴우… 이걸로 거의 끝났네요. 다음은… 지휘관님? 왜 여길?","자기소개":null,"메인1":{"voiceline":"재너스가 메이드대를 체험하는 중이라… 그 아이, 여러모로 분발하고 있네요. 혹시 사고라도 치면 몰래 도와주세요. …제가 그렇게 말했다고 그 아이에게 말씀하시면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/main1.ogg"},"메인2":{"voiceline":"설마 낮까지 여기 계실 생각이세요? 미리 말씀드리지만, 저, 간병 상대를 위한 식사 정도밖에 못 만들어요. 그래도 상관없으시다면, 마음대로 하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/main2.ogg"},"메인3":{"voiceline":"앗?! 바람 때문에 시트가…! 휴우, 덕분에 살았어요…. 방금 움직임이 꽤 날렵하시던걸요. 지휘관님께 이걸 감시해달라고 부탁할까 봐요. 보험으로써 말이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"메이드대에 일손이 부족해서 도와주러 온 것뿐이에요. 제 모습이요……? 메이드 일을 하는데 메이드 복장을 하는 게 이상한가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/detail.ogg"},"드랍 설명":{"voiceline":"휴우… 이걸로 거의 끝났네요. 다음은… 지휘관님? 왜 여길?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"제가 메이드라면 지휘관님께서 아프지 않을 때도 늘 돌봐드릴 수 있겠죠. …아니거든요! 당신의 메이드가 되는 건 별 관심 없다구요. 그저 상상한 것뿐…. 그래요, 아주 조금만요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"무료하신 거라면, 나머지 시트 말리는 것 좀 도와주세요. 설마 제가 일하는 걸 감시하러 오신 건 아니겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"업무를 빼먹고 어슬렁거리시는 줄 알았는데, 쉬는 김에 도와주러 오신 것뿐이라니……. 어쩔 수 없네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"괜찮아요. 이 정도 높이까지는 손이 닿으니까요. 그나저나 아까부터 계속 어딜 보고 계신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/touch.ogg"},"터치2":{"voiceline":"시트뿐만 아니라, 지휘관님의 머릿속에 있는 이상한 발상도 모두 깨끗이 씻어내야겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/touch2.ogg"},"입수시":{"voiceline":"휴우… 이걸로 거의 끝났네요. 다음은… 지휘관님? 왜 여길?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201341/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":n