[{"클뜯 id":10800080,"클뜯 함순이 id":1080008,"함순이 이름":"2대","한글 함순이 + 스킨 이름":"2대","영문 함순이 + 스킨 이름":"The 2nd","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800080/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800080/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800080/shipyard.png","설명":"아니 여긴 대체… 아, 처음 뵙겠습니다. 저는 2대라고 합니다. 그리드나이트 동맹을… 이라고 해봤자 여기에서는 별 상관없는 이야기일지도 모르겠네요.","자기소개":{"voiceline":"저는 2대, 그리드나이트 동맹 소속으로 여러 괴수의 위협으로부터 세상을 지키고 있…는데, 여긴 좀 다른 것 같네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/profile.ogg"},"메인1":{"voiceline":"이만큼 규모가 큰 재난이라면 분명 괴수와 관련된 일일 거라고 생각했는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/main1.ogg"},"메인2":{"voiceline":"여기 무기, 다이나제논보다도 작은데도 출력이 굉장하네요…. 어떻게 작동하는 걸까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/main2.ogg"},"메인3":{"voiceline":"여기도 세이렌이 없는 쪽이 올바른 세상인 걸까요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/main3.ogg"},"전투개시":{"voiceline":"자, 여러분! 마음 다잡고 열심히 해봐요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/battle.ogg"},"상세확인":{"voiceline":"괴수는 아니지만 괴수 같은 것… 그렇게 생각하면 저희가 이 세상에 온 것엔 다 이유가 있는 걸지도 모르겠네요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/detail.ogg"},"드랍 설명":{"voiceline":"아니 여긴 대체… 아, 처음 뵙겠습니다. 저는 2대라고 합니다. 그리드나이트 동맹을… 이라고 해봤자 여기에서는 별 상관없는 이야기일지도 모르겠네요.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 맡아 떠난 사람들이 돌아온 것 같네요. 마중하러 나가요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/expedition.ogg"},"실망":{"voiceline":"하아… 뭐, 업무의 일부니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/feeling1.ogg"},"낯섦":{"voiceline":"가게 같은 곳도 몇 군데 있나요? 흠… 가지고 있는 돈도 쓸 수 있으려나…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/feeling2.ogg"},"호감":{"voiceline":"지휘관님, 고생 많으셨습니다. 바쁘시겠지만 휴식도 틈틈이 취하시길 바라요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/feeling3.ogg"},"기쁨":{"voiceline":"어머? 지휘관님, 한가하신 것 같네요. 그럼 데이트 하실래요? 제가 살게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/feeling4.ogg"},"사랑":{"voiceline":"후후, 즐거워요. 어느 세상이든 일상을 영위하는 사람들이 있고, 그걸 지키는 사람들이 있어서… 멋진 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/feeling5.ogg"},"터치3":{"voiceline":"앗?! 아, 왜 그러세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/headtouch.ogg"},"모항귀환":{"voiceline":"아, 어서 오세요. 무사히 귀환하셔서 다행입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/home.ogg"},"hp 경고":{"voiceline":"픽서 빔은… 못 쓰겠죠….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/hp_warning.ogg"},"로그인":{"voiceline":"어머? 오늘도 만났네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/login.ogg"},"실패":{"voiceline":"아야야야… 역시 좀 무리긴 하죠, 이런 건…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/lose.ogg"},"우편":{"voiceline":"지휘관님, 연락이 온 것 같은데요? 꼭 확인하셔야 해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/mail.ogg"},"임무":{"voiceline":"지휘관님~ 아직 업무가 덜 끝난 것 같은데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/mission.ogg"},"임무완료":{"voiceline":"네, 임무 완료입니다. 보상도 잊지 말고 수령해 두세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/mission_complete.ogg"},"서약":{"voiceline":"지휘관님께는 정말 정말 신세를 많이 져서 감사한 마음뿐입니다. 그렇지만 저… 아니, 아무것도 아니에요. 꼭 보답하고 싶으니까 뭐가 좋을지 생각해 두세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/propose.ogg"},"스킬":{"voiceline":"제가 나설 차례인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/skill.ogg"},"터치1":{"voiceline":"어머? 좀 다른 느낌인가요? 후후, 사실은 저 말이죠……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/touch.ogg"},"터치2":{"voiceline":"지휘관님, 머리부터 확 물리고 싶으신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/touch2.ogg"},"입수시":{"voiceline":"아니 여긴 대체… 아, 처음 뵙겠습니다. 저는 2대라고 합니다. 그리드나이트 동맹을… 이라고 해봤자 여기에서는 별 상관없는 이야기일지도 모르겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/unlock.ogg"},"강화성공":{"voiceline":"순수하게 강화 목적이라는 것도 꽤 괜찮네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"휴우, 평소랑 상황이 좀 다르긴 하지만… 어떻게든 되긴 되네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/win_mvp.ogg"},"전투개시_ex":{"voiceline":"자, 지휘관님! 명령을 내려주세요!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/battle_ex.ogg"},"상세확인_ex":{"voiceline":"실은 저, 엄청난 비밀을 가지고 있는데… 지휘관님, 알고 싶으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800080/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"각자 맡고 있는 역할이 있어 아무리 노력해도 만남이 일