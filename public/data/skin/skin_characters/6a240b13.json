om/Fernando2603/AzurLane/main/audio/voiceline/10800081/detail.ogg"},"드랍 설명":{"voiceline":"잠깐만 기다려주시겠어요? 이 보고만… 지휘관님도 커피면 되나요? 아… 죄송합니다. 컵은 이것뿐이라… 같이 마셔도 괜찮을까요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"죄송해요, 미처 옷을 다 갈아입지 못해서… 신경 쓰이신다구요? 그, 그러시군요… 그렇게 말씀하시니 갑자기 저도……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800081/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"변변치 못한 대접이나마 괜찮으시다면 편히 쉬다가 가세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800081/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"그런 실례되는 말을! 지금은 잘 씻는다구요! …샤워만으로 끝낼 때가 많긴 하지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800081/touch.ogg"},"터치2":{"voiceline":"개인적으로 과도한 스킨십은 가급적 피하시는 걸 추천드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800081/touch2.ogg"},"입수시":{"voiceline":"잠깐만 기다려주시겠어요? 이 보고만… 지휘관님도 커피면 되나요? 아… 죄송합니다. 컵은 이것뿐이라… 같이 마셔도 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800081/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"홈웨어","상점 id":70869,"상점 카테고리 id":20,"스킨 태그":"배경, 브금","입수 영상":"X","재화":900,"기간":null,"진영":"SSSS","레어도":"SSR","ex_chat_status":0}]