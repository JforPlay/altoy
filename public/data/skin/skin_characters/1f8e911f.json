ando2603/AzurLane/main/images/skin/205065/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205065/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205065/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205065/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205065/shipyard.png","설명":"늦었네, 지휘관. 생각지도 못하게 혼자만의 시간이 생겨서 악기에 손을 뻗고 말았는데…… 숙녀를 너무 기다리게 하면 못써. 어쨌든 한 곡 들은 다음에 출발하는 건 어때?","자기소개":null,"메인1":{"voiceline":"기사대라고 해서 싸우는 게 전부는 아니야. 다재다능이야말로 로열 나이트로서 갖추어야 할 소양…이라고 하고 싶지만, 그렇지 않은 애도 있거든. 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/main1.ogg"},"메인2":{"voiceline":"정장을 갖춰 입고 콘서트를 하는 것도 멋지지만, 마음 편한 동료와 함께 세션을 하는 것도 즐거워. 당신도 무언가 시작해 보는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/main2.ogg"},"메인3":{"voiceline":"오이겐, 지휘관에게 대체 몇 잔이나 마시게 할 셈이야? 설마 당신 혼자만이 아니라, 지휘관까지 취하게 해서 같이 동료들을 붙들고 늘어질 생각은 아니겠지? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/main3.ogg"},"전투개시":{"voiceline":"승리의 축포가 정말 기대되네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/battle.ogg"},"상세확인":{"voiceline":"이 칠흑빛 드레스… 마치 반짝이는 은하수가 수 놓인 어두운 밤을 그대로 몸에 두른 것 같네. 요크식으로 표현하면 그렇달까? 지휘관, 의상을 칭찬해 주는 건 고맙지만, 적당히 안 하면 나까지 부끄러워진다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/detail.ogg"},"드랍 설명":{"voiceline":"늦었네, 지휘관. 생각지도 못하게 혼자만의 시간이 생겨서 악기에 손을 뻗고 말았는데…… 숙녀를 너무 기다리게 하면 못써. 어쨌든 한 곡 들은 다음에 출발하는 건 어때?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"피곤한 것 같네, 지휘관. 그래, 잠깐 내 연주를 듣고 가지 않을래? 당신만을 위한 솔로 콘서트로 그 피로를 풀어줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어머, 지휘관. 드디어 깨어났네? 기사대가 연주하는 잔잔한 알토의 선율… 후후, 꿈만 같다…고 말해도 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"연주 중에 연주자를 만지는 건 기본적으로 엄금이지만… 부드러운 터치의 편안함은 거부할 수 없지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/touch.ogg"},"터치2":{"voiceline":"지휘관? 옷이 흐트러지면 제대로 정리해 줄 거야? 설마 흐트러진 채로 연주를 시키려는 건 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/touch2.ogg"},"입수시":{"voiceline":"늦었네, 지휘관. 생각지도 못하게 혼자만의 시간이 생겨서 악기에 손을 뻗고 말았는데…… 숙녀를 너무 기다리게 하면 못써. 어쨌든 한 곡 들은 다음에 출발하는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205065/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70909,"상점 카테고리 id":7,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":900,"기간":"상시","진영":"HMS","레어도":"SSR","ex_chat_status":0}]