[{"클뜯 id":107090,"클뜯 함순이 id":10709,"함순이 이름":"에식스","한글 함순이 + 스킨 이름":"에식스","영문 함순이 + 스킨 이름":"Essex","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107090/shipyard.png","설명":"에식스급 항공모함 - 에식스 (CV-9)","자기소개":{"voiceline":"에식스급의 네임쉽, 에식스입니다. 건조된 후 많은 기대를 받아왔었지만, 역시 저보다 엔터프라이즈 선배의 활약이 더욱 주목 받게 되었죠……저도 조금만 더 빨리 전투에 참가했더라면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/profile.ogg"},"메인1":{"voiceline":"모두 에식스급은 강하다고 인정해주지만, 늘 입에 담는 건 역시 엔터프라이즈 선배뿐…하아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/main1.ogg"},"메인2":{"voiceline":"제겐 동형함이 많이 있습니다. 네임쉽으로써, 열심히 본보기가 되어야 할 텐데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/main2.ogg"},"메인3":{"voiceline":"무사시와 야마토 말씀입니까? 그녀들은…흠, 존경할만한 훌륭한 라이벌입니다. 언젠가 또 만났으면 좋겠군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/main3.ogg"},"전투개시":{"voiceline":"항공대, 호위 비행 배치 완료. 방공 태세, 준비 완료…전 함, 최대 속력으로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/battle.ogg"},"상세확인":{"voiceline":"지휘관님께선 무엇을 알고 싶으십니까? 제가 알고 있는 거라면 무엇이든지 알려 드리겠습니다만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/detail.ogg"},"드랍 설명":{"voiceline":"에식스급 항공모함 - 에식스 (CV-9)","voicelink":null},"의뢰 완료":{"voiceline":"우리 에식스급이 탄생할 수 있었던 건, 강한 병참 부서가 있었기 때문입니다. 제대로 모두에게 감사하지 않으면 안 되겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/expedition.ogg"},"실망":{"voiceline":"엔터프라이즈 선배, 이런 지휘관을 꾹 참고 따르고 있는 건가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/feeling1.ogg"},"낯섦":{"voiceline":"거함거포주의 시대의 종말을 이 눈으로 똑똑히 지켜봤었습니다. 항공모함의 시대도, 언젠가 끝을 맞이하진 않을까요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/feeling2.ogg"},"호감":{"voiceline":"질투? 아뇨, 그런 건 없습니다. 엔터프라이즈 선배는 우리 모두에게 존경받는 영웅입니다. 다만, 선배의 후광을 받는 건, 제겐 역시 좀……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/feeling3.ogg"},"기쁨":{"voiceline":"저, 에식스는 누구에게도 지지 않습니다. 설령 상대가 엔터프라이즈 선배라고 해도 말입니다……하지만, 어떻게 해야 모두에게 그걸 인정받을 수 있을지…지휘관님, 당신이라면 분명 알고 계시겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/feeling4.ogg"},"사랑":{"voiceline":"엔터프라이즈 선배 같은 영웅이 될 수 없을지도 모릅니다. 하지만, 선배처럼 사람들의 기억 속에 남는 존재는 될 수 있을 것 같습니다……왜냐하면 지휘관님과 함께라면 저, 뭐든지 할 수 있을 것 같은 기분이 드니까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/feeling5.ogg"},"터치3":{"voiceline":"으… 으읏… 아! 따, 딱히 이상한 소리 낸 거 아니에요! 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/headtouch.ogg"},"모항귀환":{"voiceline":"출격 함대…무사히 모항에 귀환했습니다. 지휘관님, 전투 보고는 이미 사전 준비가 완료 되어있습니다. 시간이 아까우니, 지금부터 보고드리도록 하지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/home.ogg"},"hp 경고":{"voiceline":"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/hp_warning.ogg"},"로그인":{"voiceline":"이제서야 왔군요…모든 건 준비되었습니다. 지휘관님, 출격 지시를!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/login.ogg"},"실패":{"voiceline":"이대로는 끝나지 않아……절대로!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/lose.ogg"},"우편":{"voiceline":"새로운 우편입니다. 여기 있습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/mail.ogg"},"임무":{"voiceline":"아직 새로운 임무가……제게도 맡겨 주시지 않겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/mission.ogg"},"임무완료":{"voiceline":"임무 보수가 도착했습니다. 받으러 가지 않으셔도 괜찮겠습니까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/mission_complete.ogg"},"서약":{"voiceline":"서로 버팀목이 되어주는 행복한 기분은, 한 번이라도 느껴버리면 헤어나올 수 없게 되는군요. 지휘관님, 감사합니다. 에식스가 어떻게 해야 모두에게 인정받을 수 있을지 혼자서 고민할 필요가 없어졌으니까요…에식스, 앞으로는 언제나 당신의 곁에서, 당신과 함께 걸어나갈 것을 맹세합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/propose.ogg"},"스킬":{"voiceline":"드넓은 하늘을 날아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/skill.ogg"},"터치1":{"voiceline":"!! 출격입니까? 제게 맡겨주십시오! …하아, 잡담하고 싶었을 뿐이었나요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/touch.ogg"},"터치2":{"voiceline":"이, 이런 거! 저, 저는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/touch2.ogg"},"입수시":{"voiceline":"여기가 엔터프라이즈 선배의…크, 크흠! 이글 유니온의 최신예 항공모함 에식스, 정식 착임 했습니다. 지휘관님, 제 활약을 기대하여 주십시오! 모두의 기대를 절대 저버리지 않겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/unlock.ogg"},"강화성공":{"voiceline":"제트기는 언제쯤이 되어야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"엔터프라이즈 선배, 나의 활약을 잘 보았습니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관님의 사랑과 신뢰, 제대로 느끼고 있어요…… 그때 지휘관님이 내리신 결정이 옳았다는 걸, 제 평생을 걸고 증명해 보일게요. 네. 저는 지휘관님께 있어서 가장 소중한 에식스니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"조금만 더… 이대로 곁에 있어 주셨으면 해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 귀환을 환영합니다! ……어, 어라? 너무 딱딱했나요? 이, 이건… 음… 지휘관님께서 돌아오셨으니 최대한 정중하게 맞이해드리고 싶어서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"어, 잡담인가요? 맡겨주세요! ……네? 이번엔 출격인가요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/touch_ex.ogg"},"터치2_ex":{"voiceline":"기, 기습을 하시다니……?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관님과 함께 이렇게 평온한 오후를 보내는 것도 좋네요…… 후후, 괜찮으시면 커피라도 내려 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/main5_ex.ogg"},"메인6_ex":{"voiceline":"…아, 지난 작전 기록을 보고 있었어요. …아니, 전술 분석을 하려던 게 아니라, 영상 속에 지휘관님의 모습이 있어서, 그만… 눈을 뗄 수 없게 되어서요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"……언젠가 에식스도 후배들의 동경을 받는 존재가 된다면… 그건 분명 지휘관님이 「동경 받을 수 있는 용기」를 주셨기 때문일 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107090/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":107091,"클뜯 함순이 id":10709,"함순이 이름":"에식스","한글 함순이 + 스킨 이름":"66번 국도 여행","영문 함순이 + 스킨 이름":"A Trip Down Route 66","스킨 타입":"Casual","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107091/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107091/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107091/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107091/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107091/shipyard.png","설명":"종점만을 향하는 것이 아닌 주변 풍경을 즐기는 여행이라, 굉장히 재미있어 보입니다. 지휘관님, 함께 도로 여행의 즐거움을 느껴봅시다.","자기소개":null,"메인1":{"voiceline":"엔터프라이즈 선배가 말했죠. 전투 외에도 해볼만한 일이 많다고… 아마 이것이 그 중 하나인 것 같습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/main1.ogg"},"메인2":{"voiceline":"전투는 최선을 다해야 하지만, 라이딩에선 계속 전력 질주하면 안돼, 음…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/main2.ogg"},"메인3":{"voiceline":"너도 우리를 계속 쫒아왔구나. 정말 대단한 매야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"2448 마일, 그 짧은 경치로도 기분이 좋아집니다… 완주하지 못하더라도 이런 경험을 했다는 것 만으로도 이미 만족스럽습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/detail.ogg"},"드랍 설명":{"voiceline":"종점만을 향하는 것이 아닌 주변 풍경을 즐기는 여행이라, 굉장히 재미있어 보입니다. 지휘관님, 함께 도로 여행의 즐거움을 느껴봅시다.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"쉬고 싶으십니까? 알겠습니다. 기다리지요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 헬멧은 쓰셨습니까? 계속 출발하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"후… 음? 제게 주시는 물입니까? 그럼 감사히 받도록 하겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/touch.ogg"},"터치2":{"voiceline":"지휘관님 혹시… 라이딩 때문에 어지러우신 건 아닙니까?! 역, 역시 쉬는 것이 좋겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/touch2.ogg"},"입수시":{"voiceline":"종점만을 향하는 것이 아닌 주변 풍경을 즐기는 여행이라, 굉장히 재미있어 보입니다. 지휘관님, 함께 도로 여행의 즐거움을 느껴봅시다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107091/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"사복","상점 id":70245,"상점 카테고리 id":9,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2024/08/21)","진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":107092,"클뜯 함순이 id":10709,"함순이 이름":"에식스","한글 함순이 + 스킨 이름":"Craft Fairytail","영문 함순이 + 스킨 이름":"Craft Fairytail","스킨 타입":"Party Dress","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107092/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107092/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107092/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107092/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107092/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107092/shipyard.png","설명":"앗? 전 절대 취해서 바람을 쐬러 나온 것이 아닙니다. 좋아요, 확실히 조금 많이 마시긴 했네요... 다, 단지 그 뿐입니다, 지휘관님 비밀을 지켜주세요!","자기소개":null,"메인1":{"voiceline":"제가 이글에게 특별한 드레스를 준비해줬어요. 보세요, 지금은 집사의 느낌이 물씬 나죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/main1.ogg"},"메인2":{"voiceline":"여쭤볼게요... 지휘관님, 저기, 엔터프라이즈 선배가 술에 취한 걸...... 본 적 있으신가요? 그냥 좀 궁금해서요. 선배가 취한 모습은 도무지 상상이 안되거든요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/main2.ogg"},"메인3":{"voiceline":"아, 지휘관님, 전 잠깐만 쉬면 돼요. 걱정하지 마세요. 오히려 지휘관님이 자리를 너무 오래 비우시면 걱정의 대상은 지휘관님이 되지 않을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"저기, 지휘관님, 이쪽으로 오는 사람 없죠? 그, 그럼 됐어요. 엔터프라이즈 선배가 보거나 샹그릴라에게 이 모습을 사진이라도 찍힌다면...... 저, 저는 어서... 음, 정신을... 엇!? 샤, 샹그릴라!? 안돼 안돼! 찍지마아아아아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/detail.ogg"},"드랍 설명":{"voiceline":"앗? 전 절대 취해서 바람을 쐬러 나온 것이 아닙니다. 좋아요, 확실히 조금 많이 마시긴 했네요... 다, 단지 그 뿐입니다, 지휘관님 비밀을 지켜주세요!","voicelink":null},"의뢰 완료":{"voiceline":"음, 이럴 때 의뢰조가 돌아온 건가요? 제가 가보도록——앗, 죄송합니다. 지금의 저는 도와드릴 수 없을 것 같아요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"공주는 왕자에게 기대어 성 상공의 별의 바다를 감상하고 있다......앗!? 지휘관님 들으셨나요!? 됐어요, 그냥 제가 완전히 취한 걸로 해요. 바로 지금만, 지휘관님에게 좀 더 오래 기댈 수 있게 해주세요! 헤헤, 에헤헤......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"연회에서 모두 줄줄이 저에게 안부를 묻더군요. 당시에 저는 \"나도 원래 이렇게 환영을 받는구나!\"라고 생각해서, 충동적으로 권하는 술을 몽땅 받아줬습니다... 끅...! 너무 마음이 연해서...!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"저기, 지휘관님, 저 좀 부축해줄 수 있나요? 감사합니다. 후, 왜 드레스 뒤끝을 이렇게 길게 만들어 놓은 건지......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새로운 임무인가요? 그, 그럼 전 빠르게 컨디션을 조절해야겠네요——음, 머, 머리가 아직도 조금 어지럽네요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/mission.ogg"},"임무완료":{"voiceline":"임무 보상을 받으셨다고요? 그, 그럼 잘 됐네요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"한 잔만 더 한다면... 지휘관님, 같이 마셔주세요——! 지휘관님이 평소 모두를 위해 많은 일을 하신 것에 대한 저의 감사의 마음이라고 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/touch.ogg"},"터치2":{"voiceline":"지휘관님! 이게 뭐하는 거예요——! 서, 설마 지휘관님도 취했나요!? 이, 이걸 어떻게 하면 좋담......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/touch2.ogg"},"입수시":{"voiceline":"앗? 전 절대 취해서 바람을 쐬러 나온 것이 아닙니다. 좋아요, 확실히 조금 많이 마시긴 했네요... 다, 단지 그 뿐입니다, 지휘관님 비밀을 지켜주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107092/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"파티","상점 id":70419,"상점 카테고리 id":7,"스킨 태그":"L2D, 특수배경 (움짤)","입수 영상":"X","재화":1200,"기간":"상시","진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":107093,"클뜯 함순이 id":10709,"함순이 이름":"에식스","한글 함순이 + 스킨 이름":"필묵으로 그린 건곤","영문 함순이 + 스킨 이름":"Brush and Ink","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107093/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107093/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107093/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107093/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107093/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107093/shipyard.png","설명":"이스트 글림의 복식과 필묵... 그랬군요. 입어보니 확실히 동양예술에 가까워진 기분이에요! 항구의 춘절 준비에 저도 솜씨 좀 발휘해야겠는걸요!","자기소개":null,"메인1":{"voiceline":"이게 바로 특수 갑판을 조작할 수 있는 기술…괜찮습니다! 엔터프라이즈 선배님을 위해서라면 저도 열심히 배우겠어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/main1.ogg"},"메인2":{"voiceline":"nil","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/main2.ogg"},"메인3":{"voiceline":"두려워할 거 없어요. 그거 알아요. 저 별은 동양에서도 \"수성\"이라고 부른답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/main3.ogg"},"전투개시":{"voiceline":"하늘이다! 공격부대, 출격 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/battle.ogg"},"상세확인":{"voiceline":"첫째, 너무 완벽을 추구하지 말 것; 둘째, 종이와 필묵 사이의 조화에 주의할 것...... 음...대충 이런 느낌인가요? 흠...아무래도 좀 아닌 거 같은데...어렵네요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/detail.ogg"},"드랍 설명":{"voiceline":"이스트 글림의 복식과 필묵... 그랬군요. 입어보니 확실히 동양예술에 가까워진 기분이에요! 항구의 춘절 준비에 저도 솜씨 좀 발휘해야겠는걸요!","voicelink":null},"의뢰 완료":{"voiceline":"운송 거리가 멀 수록 그 과정은 어렵군요. 보급 유지에 힘쓰고 있는 동료들에게 감사해야겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"수고하셨습니다. 언제든지 명령을 내려주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이곳에 다시 획을 긋는 게 나을까요? 알겠어요. 음... 이렇게요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/touch.ogg"},"터치2":{"voiceline":"여기에 다시 한 획을...앗!? 지휘관!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/touch2.ogg"},"입수시":{"voiceline":"이스트 글림의 복식과 필묵... 그랬군요. 입어보니 확실히 동양예술에 가까워진 기분이에요! 항구의 춘절 준비에 저도 솜씨 좀 발휘해야겠는걸요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"이런 건 어떠세요! 지휘관 그리고 엔터프라이즈 선배님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107093/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70484,"상점 카테고리 id":3,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":900,"기간":"상시","진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":107094,"클뜯 함순이 id":10709,"함순이 이름":"에식스","한글 함순이 + 스킨 이름":"탐정 에식스","영문 함순이 + 스킨 이름":"Detective Essex","스킨 타입":"Others","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107094/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107094/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107094/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107094/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107094/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107094/shipyard.png","설명":"행방불명된 이글…. 엔터프라이즈 선배가 말한 대로 이건 모항의 불가사의……. 아니, 사건 냄새가 납니다! 지휘관님, 저랑 같이 조사하러 가시죠!","자기소개":null,"메인1":{"voiceline":"증거품, 엔터프라이즈 선배의 모습…. 마시다 남긴 음료수에… 레몬? 앗, 아뇨. 아무것도 아닙니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/main1.ogg"},"메인2":{"voiceline":"증거품, 참고 증인의 사진…. 아, 떨어질 거 같군요. 접착제로 다시 붙여야… 그러고 보니 접착제는 어디에다 뒀더라…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/main2.ogg"},"메인3":{"voiceline":"증거품, 체셔에게 불시검문 중인 만쥬들…. 듣자 하니 '에식스 퍼블릭'이라는 조직인 듯 함…. 수상하군요. 다음에 붙잡아 조사할 필요가 있겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/main3.ogg"},"전투개시":{"voiceline":"길을 열어라! 탐정 항공모함 에식스 출동이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/battle.ogg"},"상세확인":{"voiceline":"시원하게 진실을 밝혀내는 자, 그것은 바로 나, 탐정 항공모함 에식스! ……좋았어, 트레이드 마크 대사는 이걸로 하고…. 인트레피드네 앞에서는 끝까지 멋진 모습을 유지해야 해….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/detail.ogg"},"드랍 설명":{"voiceline":"행방불명된 이글…. 엔터프라이즈 선배가 말한 대로 이건 모항의 불가사의……. 아니, 사건 냄새가 납니다! 지휘관님, 저랑 같이 조사하러 가시죠!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 귀환했습니다. 자메이카 미안, 잠깐 오토바이 좀 빌려줘! 지금 마중나… 목격 증인에게 이야기를 듣고 오겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"축배를 들 때일수록 긴장을 늦춰서는 안 되겠죠. 자신의 미숙함을 떠올려, 정신 차리고 행동해야…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"이글… 잡아먹히지 않았으면 좋겠는데…. 지금은 걱정이나 할 때가 아니죠. 우선은 조사에 집중해야 합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"조사하기 좋은 날입니다, 지휘관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 도착했습니다. 이 이상한 마트료시카는 대체……? 후후, 아하하하, 얼굴이 이상해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"사진 분석은 샹그릴라에게 맡기는 편이 좋겠지요. 우리는 현장 조사하러 가요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/touch.ogg"},"터치2":{"voiceline":"가, 갑자기 왜 그러시죠?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/touch2.ogg"},"입수시":{"voiceline":"행방불명된 이글…. 엔터프라이즈 선배가 말한 대로 이건 모항의 불가사의……. 아니, 사건 냄새가 납니다! 지휘관님, 저랑 같이 조사하러 가시죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"'무해한 얼굴에 현혹되면 큰코다친다'란, 바로 이걸 말하는 겁니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"증거품…이 아니라 이건 벙커힐이잖아요! 정말, 뭘 신나서 이런 사진까지 찍으신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":{"voiceline":"이 지점 조사는…… 앗?! 그런 증거도 있었나요?! 지휘관님, 역시 대단하십니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107094/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"기타","상점 id":70734,"상점 카테고리 id":9999,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":107095,"클뜯 함순이 id":10709,"함순이 이름":"에식스","한글 함순이 + 스킨 이름":"크로스본 엑스트라","영문 함순이 + 스킨 이름":"Crossbones Especial","스킨 타입":"On The Job","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107095/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107095/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107095/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107095/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107095/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107095/shipyard.png","설명":"\"닻을 올려라! 해적 항공모함 에식스 님이 나가신다! 이 세상 모든 것이 있는 곳으로 출발이다!\" …딸꾹, 에헤헤… 해적이란 거... 참 좋군요~","자기소개":null,"메인1":{"voiceline":"…캬아♪ 레몬의 새콤한 맛이 느껴져서 상쾌하네요! 이건 엔터프라이즈 선배에게…… 아, 역시 관둘래요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/main1.ogg"},"메인2":{"voiceline":"끝이 안 보이는 사무 작업… 이것이야말로 지휘관님께서 평소에 고군분투하시는 전투…! 에식스, 너무 얕잡아 본 것 같군요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/main2.ogg"},"메인3":{"voiceline":"보았는가! 항공모함 에식스, 드디어 최고의 보물을 손에 넣었노라! …샹그릴라?! 자, 자, 자, 잠깐만요! 죄송해요! 죄송하다니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/main3.ogg"},"전투개시":{"voiceline":"흰 독수리의 템페스타… 자, 잘못 말했어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/battle.ogg"},"상세확인":{"voiceline":"으으… 머리가 아파요…. 왠지 저, 어제 엉뚱한 짓을 저지른 것 같은데…… 지휘관님, 혹시 뭐 아시는 거 있으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/detail.ogg"},"드랍 설명":{"voiceline":"\"닻을 올려라! 해적 항공모함 에식스 님이 나가신다! 이 세상 모든 것이 있는 곳으로 출발이다!\" …딸꾹, 에헤헤… 해적이란 거... 참 좋군요~","voicelink":null},"의뢰 완료":{"voiceline":"샹그릴라, 부탁이니까 그것 좀 내려주실래요~?! 네? 의뢰팀이 돌아왔다고 알려주려던 것뿐이라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님도 힘드시죠…. 저도 이런 일을 매일매일 하다 보면 해적이 되고 싶은 마음까지 든다구요…. 방금 건 농담이에요~ 지휘관님의 부담을 덜어드리기 위해서라면 저 얼마든 참을 수 있답니다~ 에헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님! 어서 오세요오~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관니~임? 후후… 저 안 취했거든요~? 일하다 쉬면서 이거 딱 3캔만 깠다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/login.ogg"},"실패":{"voiceline":"패배로 늘어난 서류 작업을 생각하니… 윽!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/lose.ogg"},"우편":{"voiceline":"새 우편 말씀이신가요? 어디 뒀더라….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/mail.ogg"},"임무":{"voiceline":"새 임무… 즉 사무 작업도 추가됐다는 의미겠죠… 윽!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/mission.ogg"},"임무완료":{"voiceline":"임무 보상… 이것만 있으면 에식스… 즐겁게 일할 수 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님, 에식스네 배 안 타실래요? 어라… 지휘관님이 타면 선장은 지휘관님이 되는 거죠…? 그럼 에식스는 어떻게…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/touch.ogg"},"터치2":{"voiceline":"잠깐, 지휘관님?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/touch2.ogg"},"입수시":{"voiceline":"\"닻을 올려라! 해적 항공모함 에식스 님이 나가신다! 이 세상 모든 것이 있는 곳으로 출발이다!\" …딸꾹, 에헤헤… 해적이란 거... 참 좋군요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107095/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"사무 업무보단 역시 전투 쪽이 좋죠! 그렇죠?!","voicelink":"https://raw.githubuse