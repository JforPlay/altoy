[{"클뜯 id":399020,"클뜯 함순이 id":39902,"함순이 이름":"이즈모","한글 함순이 + 스킨 이름":"이즈모","영문 함순이 + 스킨 이름":"Izumo","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399020/shipyard.png","설명":"전함 - 이즈모 ","자기소개":{"voiceline":"사쿠라 엠파이어 함대 소속 전함, 이즈모다. 야마토급의 설계안으로써 존재했고, 건조는 되지 못했다…만, 나의 실력을 조금이라도 얕본다면 주포의 일제사격을 받을 각오는 해두는 게 좋을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/profile.ogg"},"메인1":{"voiceline":"칼 손질에는 심혈을 기울여야 하지. 당연한 것 아니겠나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/main1.ogg"},"메인2":{"voiceline":"자매…라. 이즈모급은 나밖에 없어서인지, 조금은 부럽기도 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/main2.ogg"},"메인3":{"voiceline":"지휘관, 강해져라. 네가 우리들을 지킬 수 있을 정도로 강해진다면… 그리된다면, 나는……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/main3.ogg"},"전투개시":{"voiceline":"전 함, 진형을 갖춰라! 목표, 전방의 적!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/battle.ogg"},"상세확인":{"voiceline":"나를 보고 있을 시간이 있다면 일이라도 하는 게 어떤가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/detail.ogg"},"드랍 설명":{"voiceline":"전함 - 이즈모 ","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료다…한 번 직접 출격해보는 건 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/expedition.ogg"},"실망":{"voiceline":"이 칼날을 휘두르게 할 자격도 없구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/feeling1.ogg"},"낯섦":{"voiceline":"이 칼날은 나의 반신. 부주의하게 만졌다간 다친다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/feeling2.ogg"},"호감":{"voiceline":"하아……지휘관은 어째서 늘 이렇게 축 처진 얼굴을 하고 있는 건가? 나도 모르게…설교하고 싶어지지않나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관도 최근엔 어느 정도 태가 나는 것 같군…흠, 일단 네 그 노력은 인정해주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/feeling4.ogg"},"사랑":{"voiceline":"내 칼의 길은 언제나 고고하다고…그렇게 생각했었다만. 흥, 지휘관과 함께라면 의외로…괜찮을지도 모르겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔나. 시간 아까우니 바로 좀 전의 출격에 대해 반성해보지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/home.ogg"},"hp 경고":{"voiceline":"소, 소화작업을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/hp_warning.ogg"},"로그인":{"voiceline":"변함없이 늦는구나. 이 나를 언제까지 기다리게 할 셈이냐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/login.ogg"},"실패":{"voiceline":"큭…아직…싸울 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/lose.ogg"},"우편":{"voiceline":"편지다. 꼼꼼히 확인하지 않으면 보낸이에게도 실례겠지. 그렇게 생각 안 하나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/mail.ogg"},"임무":{"voiceline":"지휘관, 미완료 된 임무는 어떻게 할 셈이냐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/mission.ogg"},"임무완료":{"voiceline":"임무완료다…참나, 넌 언제쯤 스스로 알아차리게 될는지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/mission_complete.ogg"},"서약":{"voiceline":"또 축 처진 얼굴이나 하고, 정말 내버려둘 수 없는 녀석이군…어디, 오늘만큼은 나도 너의 그 노력을…그래, 재능이라는 걸 인정해주마! 전함 이즈모, 지휘관과 생사를 함께할 것을 이 칼날에 걸고 맹세한다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/propose.ogg"},"스킬":{"voiceline":"내 칼날을 받아 보아라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/skill.ogg"},"터치1":{"voiceline":"지휘관, 설마 나와 한없이 수다나 떨고 있을 정도로 한가하진 않을 텐데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/touch.ogg"},"터치2":{"voiceline":"…베, 베겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/touch2.ogg"},"입수시":{"voiceline":"전함 이즈모, 착임 했다. 네가 지휘관인가? 그다지 믿음직스러워 보이진 않네만…명심해라, 혹시 내 발목을 잡거나 하는 일이 생긴다면, 그냥 넘어가진 않을 테다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/unlock.ogg"},"강화성공":{"voiceline":"베는 맛이 좋아졌군. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리? 당연하다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":399021,"클뜯 함순이 id":39902,"함순이 이름":"이즈모","한글 함순이 + 스킨 이름":"구름을 벗어난 천 그루 벚꽃처럼","영문 함순이 + 스킨 이름":"Izumo's Thousand Cherry Trees","스킨 타입":"New Year Kimono","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/39902