[{"클뜯 id":203100,"클뜯 함순이 id":20310,"함순이 이름":"꼬마 체셔","한글 함순이 + 스킨 이름":"꼬마 체셔","영문 함순이 + 스킨 이름":"Little Cheshire","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203100/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203100/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203100/shipyard.png","설명":"중순양함 – 꼬마 체셔","자기소개":{"voiceline":"중순양함 체셔야! 서방님을 위해 여러모로 열심히 할게! 뭐부터 열심히 하면 될진 잘 모르겠지만, 어쨌든 열심히 할 거야! 꺄핫♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/profile.ogg"},"메인1":{"voiceline":"꼬마 벨파스트야~ 체셔한테 맛있는 과자 만드는 방법 좀 알려줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/main1.ogg"},"메인2":{"voiceline":"체셔가 야옹이처럼 귀엽다구? 에헤헷, 그런 말 하면 부끄럽잖아~ 서방님♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/main2.ogg"},"메인3":{"voiceline":"드레이크 언니! 체셔한테 선물 줘! 달콤하고 맛있는 걸로 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/main3.ogg"},"전투개시":{"voiceline":"체셔, 이거 줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/battle.ogg"},"상세확인":{"voiceline":"서방님~ 꼬옥…. 체셔, 서방님을 안고 있으면 잠이 오더라구……. 흐아암… 쿨쿨쿨….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/detail.ogg"},"드랍 설명":{"voiceline":"중순양함 - 꼬마 체셔","voicelink":null},"의뢰 완료":{"voiceline":"의뢰하러 나갔던 애들이 돌아왔어, 서방님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/expedition.ogg"},"실망":{"voiceline":"서방님에게 반했었는데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/feeling1.ogg"},"낯섦":{"voiceline":"체셔, 오늘도 서방님을 위해 이것저것 만들어 줄 거야♪ …음, 뭐부터 만드는 거더라…. 잘 모르겠다냥~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/feeling2.ogg"},"호감":{"voiceline":"우선은 소금? 설탕? 반죽 섞기부터? 아, 드레이크 언니한테 받은 신선한 과일도 있지! 서방님은 어떤 게 좋아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/feeling3.ogg"},"기쁨":{"voiceline":"아으… 서방님 말대로 그냥 대충 만드는 걸론 맛있는 과자는 못 만들겠네…. 그렇지만 체셔는 포기 안 해! 꼭 맛있는 걸 만들어 주고 말겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/feeling4.ogg"},"사랑":{"voiceline":"서방님, 이거 봐! 모두가 알려준 대로 만든 맛있는 쿠키야! …응? 왠지 움직이는 것 같은데…. 실수했다! 쿠키가 아니라 만쥬였네! 서방님, 죄송해용! >_<","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/feeling5.ogg"},"터치3":{"voiceline":"야옹이 귀 액세서리야! 어서 서방님도 해봐! 빨리! 빨리 해보라니깐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/headtouch.ogg"},"모항귀환":{"voiceline":"서방님~! 체셔에게 줄 선물은 까먹어도, 체셔를 안아주는 건 잊으면 안 된다구♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/home.ogg"},"hp 경고":{"voiceline":"체셔는 기죽지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/hp_warning.ogg"},"로그인":{"voiceline":"서·방·님~! 우냐앙~ 꼬옥. 응응, 우리 서방님, 따뜻하다~아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/login.ogg"},"실패":{"voiceline":"눈치채기 전에 역습해버릴까? 오잉? 안 된다구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/lose.ogg"},"우편":{"voiceline":"우편이야! 무슨 내용인지 궁금하지만, 체셔… 못 읽을 것 같아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203100/mail.ogg"},"임무":{"voiceline":"체셔가 못하는 임무도 서방님이라면 