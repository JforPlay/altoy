[{"클뜯 id":205140,"클뜯 함순이 id":20514,"함순이 이름":"로열 오크","한글 함순이 + 스킨 이름":"로열 오크","영문 함순이 + 스킨 이름":"Royal Oak","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205140/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205140/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205140/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205140/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205140/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205140/shipyard.png","설명":"리벤지급 전함 - 로열 오크","자기소개":{"voiceline":"다시 한번 자기소개를 해달라고? 응… 으음, 로열 네이비 소속 리벤지급 전함이고, 이름은 로열 오크야. 그 유틀란트 해전에서 활약했지만, 언제부턴가 묘하게 피해를 많이 입게 되어서… 여기선 악운에서 벗어날 수 있길 바랄 뿐이야….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/profile.ogg"},"메인1":{"voiceline":"저기, 지휘관 각하! 아… 방해하려던 건 아니었어… 그게… 이렇게 조용한 곳은 좀 익숙하지가 않고… 거기다 안 좋은 기억이 떠오를 것 같아서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/main1.ogg"},"메인2":{"voiceline":"지휘관 각하, 창문을 열어도 정말 유탄 같은 게 날아오거나 하진 않는 거지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/main2.ogg"},"메인3":{"voiceline":"적어도 이 서류만은 무사히 보내야지…. 좋아, 되도록 빨리 돌아올 수 있도록 노력할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/main3.ogg"},"전투개시":{"voiceline":"그, 그렇게 빨리 돌진하진 말아줘….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/battle.ogg"},"상세확인":{"voiceline":"얼마 전에 동료들의 연습을 견학하고 있었는데, 연습탄인 유탄에 맞아서… 아, 아니, 다친 건 아니야. 그렇지만… 너무 아프더라….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/detail.ogg"},"드랍 설명":{"voiceline":"리벤지급 전함 - 로열 오크","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아왔어. 혹시 괜찮으면 나도 같이 마중나가도 될까? 걷는 속도는 좀 느리지만….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/expedition.ogg"},"실망":{"voiceline":"분명 내가 지휘관 각하의 발목을 잡은 탓에 지휘관 각하가 이렇게 변해버린 거겠지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/feeling1.ogg"},"낯섦":{"voiceline":"기사대의 선배로서 모두를 이끌어주기는커녕, 동료들을 따라잡는 것만으로도 버거워…. 나, 사실은 이 함대에 필요 없는 존재인 건…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/feeling2.ogg"},"호감":{"voiceline":"이 다음 순찰 임무라면 내 속력으로도 괜찮을 것 같아. 좋아, 순찰이 무사히 끝나기를… 잠수함과 마주치지 않기를! 잠수함과 마주치기 않기를…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/feeling3.ogg"},"기쁨":{"voiceline":"정말…? 나, 그렇게나 지휘관 각하에게 도움이 되고 있는 거야? …예전의 나라면 절대 믿지 않았겠지…. 음… 더, 더 다양한 임무를 내게 맡겨줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/feeling4.ogg"},"사랑":{"voiceline":"로열 오크를 저버리지 않고, 게다가 여러모로 생각해 주고, 내게 자신감까지 심어줬지…. 이, 있잖아! 혹시 괜찮으면, 전투나 업무 말고도 더 가르쳐 줬으면 하는 게 있는데… 괜찮…을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 각하, 출격하느라 고생 많았어. 내가 도와줄 수 있는 건 없을까? …뭐든 괜찮아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/home.ogg"},"hp 경고":{"voiceline":"왜 항상 나만 이런 꼴을….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/hp_warning.ogg"},"로그인":{"voiceline":"꺅! 미안해! 일부러 문 뒤에 서 있었던 건… 아, 그… 난 괜찮아. 굳이 사과하거나 걱정할 필요는….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/login.ogg"},"실패":{"voiceline":"이렇게 열심히 했는데, 왜….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/lose.ogg"},"우편":{"voiceline":"앗… 아야! 우편을 종이비행기로 만들어서 날린 거, 누구야…??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/mail.ogg"},"임무":{"voiceline":"지휘관 각하, 임무는 되도록 빨리 해치우는 편이….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/mission.ogg"},"임무완료":{"voiceline":"다행이다…. 임무, 무사히 완료됐네. 아, 나… 지휘관 각하의 발목을 붙잡진 않았어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/mission_complete.ogg"},"서약":{"voiceline":"저, 정말? 나, 꿈 꾸는 거 아니지…? 그 지휘관 각하가 이렇게나 소중한 걸 내게 주다니…. 물론, 나도 언젠간 이렇게 되었으면 좋겠다고 기대하고 있었고, 이렇게 되었으니 더할 나위 없이 행복한데…! 어, 어쨌든 앞으로 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/propose.ogg"},"스킬":{"voiceline":"나쁘게 생각하진 마…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/skill.ogg"},"터치1":{"voiceline":"앗! 가, 갑자기 건드려서 깜짝 놀랐잖아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/touch.ogg"},"터치2":{"voiceline":"꺄아아악! 하아.. 하아.. 하, 하지 마세요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/touch2.ogg"},"입수시":{"voiceline":"안녕, 난 로열 네이비 소속 전함 로열 오크라고 해… 나 자신의 문제를 극복하고 모두의 발걸음을 따라가기 위해 노력할 거야. 그럼... 잘 부탁해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/unlock.ogg"},"강화성공":{"voiceline":"마이티 오크'… 나, 정말 할 수 있을까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/upgrade.ogg"},"vote":null,"승리":{"voiceline":"휴우, 임무는 착실히 다 해낸 거…지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/win_mvp.ogg"},"전투개시_ex":{"voiceline":"노력해서 모두를 따라 잡겠어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관 각하도 연습용 유탄이 근처에 날아온 경험 있어? 그렇구나…. 각하한테도 똑같은 경험이 있다는 말을 들으니까 왠지 마음이 놓이는 것 같은…… 저, 절대 놀리려고 한 말은 아니야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관 각하, 귀환을 환영해. 그… 문 여는데 그렇게까지 조심할 필요는 없어….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"휴우… 뭐, 뭐 필요한 거라도 있어? 로열 오크, 전력을 다해서 임할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/touch_ex.ogg"},"터치2_ex":{"voiceline":"이것도 내가 지휘관 각하에게 해줄 수 있는 일이니까……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"나, 나도 한다면 한다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['U-47'] :  가, 가, 가까이 오지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/couple_encourage1.ogg"},{"voiceline":"['리벤지'] :  기사대, 전진!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관 각하 곁에 있으면 날아 오는 유탄을 걱정할 필요는 없을 것 같아서… 아, 그냥 예를 들자면 그렇다는 거고, 절대 지휘관 각하를 방패막으로 쓰겠다는 의미는…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/main5_ex.ogg"},"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"리벤지! 자, 잠깐! 정말… 아직 서류 보낼 곳도 안 알려줬는데, 그냥 가버렸어…. 지휘관 각하, 어쩌면 좋지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205140/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":205141,"클뜯 함순이 id":20514,"함순이 이름":"로열 오크","한글 함순이 + 스킨 이름":"우울 소녀는 도망치고 싶어","영문 함순이 + 스킨 이름":"Bashful Oak","스킨 타입":"School Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205141/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205141/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205141/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205141/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205141/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205141/shipyard.png","설명":"지휘관 각하? 정말…… 우연이네. 각하도 여기로 도망…… 아니 쉬러 온 거야? 그…… 자리 양보해 줄까?","자기소개":null,"메인1":{"voiceline":"앉아서 공부하는 거라면 조금은 자신이 있어. 혹시 각하도 모르는 부분 있으면, 내, 내가 도와줄까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/main1.ogg"},"메인2":{"voiceline":"심심하면 독서는 어때? 이유는 모르겠지만 압수한 소설이랑 만화책을 여기에서 보관하고 있는 것 같아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/main2.ogg"},"메인3":{"voiceline":"그나저나 폐하께서는 평소에 학교에서 어떻게 지내고 계시려나…. 뭐? 폐하께서도 체육 수업은 질색이시라고…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"체육 수업은 악몽이야. 이어달리기에서 동료들 발목을 잡는 것도 싫고, 어딘가에서 날아오는 야구공에 맞고 싶지도 않은걸…. 어떻게든 빼먹을 수 있으면 좋겠는데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/detail.ogg"},"드랍 설명":{"voiceline":"지휘관 각하? 정말…… 우연이네. 각하도 여기로 도망…… 아니 쉬러 온 거야? 그…… 자리 양보해 줄까?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관 각하, 그렇게까지 신경 쓸 거 없어. (작은 목소리로) 곁에 있어주는 건 기쁘지만….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관 각하, 선생님이나 선도부가 뒤에 따라붙은 건 아니지? 휴우.. 아니면 다행이고….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지금 돌아가면 동료들한테 들키지 않을까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/touch.ogg"},"터치2":{"voiceline":"서, 선도부 눈에 띄기라도 하면 모두한테 들키고 만다구…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/touch2.ogg"},"입수시":{"voiceline":"지휘관 각하? 정말…… 우연이네. 각하도 여기로 도망…… 아니 쉬러 온 거야? 그…… 자리 양보해 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205141/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"학교","상점 id":70824,"상점 카테고리 id":4,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"HMS","레어도":"SSR","ex_chat_status":0}]