[{"클뜯 id":904020,"클뜯 함순이 id":90402,"함순이 이름":"스트라스부르","한글 함순이 + 스킨 이름":"스트라스부르","영문 함순이 + 스킨 이름":"Strasbourg","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/904020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/904020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/904020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/904020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/904020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/904020/shipyard.png","설명":"됭케르크급 순양전함 - 스트라스부르","자기소개":{"voiceline":"심판정 소속 스트라스부르야. 청취자이자 연주자이기도 해. 지휘관, 동료로서 한심하게 굴지는 말아줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/profile.ogg"},"메인1":{"voiceline":"심판관은 아니지만, 「그쪽」 일을 하는 애들한테 여러 가질 배웠어. 그나저나 지휘관은 대체 어떻게 심판정의 정보 요원들과도 견줄 수 있는 수준이 된 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/main1.ogg"},"메인2":{"voiceline":"됭케르크가 만들어 준 과자야. 그리고 이건…… 후후후, 당신 몫이야. 지휘관, 이제 내게 빚이 생겼네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/main2.ogg"},"메인3":{"voiceline":"어때? 오늘 연주는 마음에 들어? ……너, 너무 좋다고? 그렇게 직설적으로 감상을 밝힐 줄은…… 뭐, 고마워……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/main3.ogg"},"전투개시":{"voiceline":"잘 들어. 너희에게 선사하는 이 진혼곡을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/battle.ogg"},"상세확인":{"voiceline":"거짓도 배신도 없는, 사람의 손으로 만든 음률의 영역… 그 안에 머무는 한, 나와 나를 연주자답게 만드는 것 모두 합리적이고 완벽한 존재가 될 수 있어. 소리와 선율의 바다를 자유로이 누비는 것…… 정말 근사하지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/detail.ogg"},"드랍 설명":{"voiceline":"됭케르크급 순양전함 - 스트라스부르","voicelink":null},"의뢰 완료":{"voiceline":"여기, 의뢰팀이 가지고 돌아온 거야. 이건 내가 정리한 목록이고. 지휘관, 확인해 줘. …자, 잘했다고? 뭐, 뭐어… 칭찬이라면 감사히 받겠지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/expedition.ogg"},"실망":{"voiceline":"내게 당신은 청취자가 아니고, 당신에게도 나는 연주자가 아니야. 서로 평행선인 거지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/feeling1.ogg"},"낯섦":{"voiceline":"스트라스부르가 연주하는 곡조는 느긋한 느낌이라고? 음… 청취자의 취향에 맞춰서 음표를 울리는 것이야말로 연주자의 역할… 사람을 대하는 것도 마찬가지겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/feeling2.ogg"},"호감":{"voiceline":"(휴우…… 이제야 좀 후련하네… 응? 누가 문을 두드리는 소리가…?) …지, 지휘관?! 당신이 왜 여길… 격렬한 음악이 들려와서 와봤다고…? 그, 그래! 내가 연주한 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/feeling3.ogg"},"기쁨":{"voiceline":"이 빈방은 아무도 안 쓰는 것 같아서 이렇게 나만의 음악실로 만들었어. 그, 그런 표정 짓지 마. 누구에게나 남에게 보이기 싫은 일면 정도는…… (작은 목소리로) 아무에게도 알리고 싶지 않은 내 비밀, 그리고 내 「스트레스」… 이제 앞으로는 당신도 함께 짊어져야 할 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/feeling4.ogg"},"사랑":{"voiceline":"후우…… 있잖아, 지휘관. 내 눈동자에 비치고 있는, 내게 푹 빠져 애태우고 있는 그 모습은 진짜야? 이제 난 그런 당신에게서… 벗어날 수 없어. 좋아해. 사랑해…… 당신 눈동자에도 내 마음이 비치고 있지? 이대로 눈을 돌리지 말고 나를 계속 바라봐 줘…… 부탁이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/feeling5.ogg"},"터치3":{"voiceline":"지휘관… 정말 어쩔 수 없다니까……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/headtouch.ogg"},"모항귀환":{"voiceline":"돌아왔네. 긴장으로 팽팽해진 신경을 느긋한 선율로 달래는 건 어때? ……아니, 방금 건 호의를 표하려고 취한 행동은 아니야. …아, 아니라면 아닌 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/home.ogg"},"hp 경고":{"voiceline":"윽…… 내 실수인가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/hp_warning.ogg"},"로그인":{"voiceline":"안녕, 지휘관. 어머, 벌써 오늘의 성스러운 책무를 시작했네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/login.ogg"},"실패":{"voiceline":"이럴 수가……! 내가……!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/lose.ogg"},"우편":{"voiceline":"새로운 우편이야. 자, 여기 둘게. 지휘관이라면 바로 확인해 주겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있어. 꽤 바쁜 것 같네. 안 그래, 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/mission.ogg"},"임무완료":{"voiceline":"임무 완료야. 완벽하게 연주된 악곡처럼 조화롭고 흠잡을 데 없어. 아주 우아해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/mission_complete.ogg"},"서약":{"voiceline":"나… 나한테? 정말? 왜…? 다른 애들도 있는데…… 있잖아, 지휘관. 한 번만 더 확인할게! 나를, 스트라스부르를 선택한 거 맞지? 그렇다면 나, 진짜 진심으로… 진짜 당신을 꼭 껴안고, 누구에게도 빼앗기지 않을 거야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/propose.ogg"},"스킬":{"voiceline":"이건 내가 베푸는 자비야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/skill.ogg"},"터치1":{"voiceline":"어머, 뭘 노리고 스킨십을 한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/touch.ogg"},"터치2":{"voiceline":"어머…… 현으로 양팔이 묶이면 어떤 느낌인지 알고 싶은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/touch2.ogg"},"입수시":{"voiceline":"심판정 소속 연주자 스트라스부르야. 당신이 그 유명한 지휘관 맞지? 그래…… 후후후, 그렇군. 앞으로 보여줄 활약, 기대하고 있겠어. 지·휘·관♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/unlock.ogg"},"강화성공":{"voiceline":"음… 힘이 있어서 나쁠 건 없지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"연주 끝.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":{"voiceline":"의뢰가 완료됐네. ……저기, 지휘관. 슬슬 칭찬해 줄 때 되지 않았어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/expedition_ex.ogg"},"사랑_ex":{"voiceline":"이렇게 늘 불안해하고 강한 척만 하는 날 이렇게까지 바꾼 건 지휘관, 바로 당신이야. 그 벌로 이제부터 당신을 꽉 붙들어 나만 보고, 나만 고르게 할 거야…… 왜냐하면 나를… 세상에서 가장 행복한 사람으로 만들어 버렸으니까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"지휘관, 너무 기다리게 하는 거 아니야? 이렇게 날 애태우게 만든 건 지휘관, 바로 당신이야. 확실히 책임을 져야겠지? …「음악실」로 같이 가줘야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"안녕, 지휘관. 난 벌써 이미 집무에 착수했어. 그래, 오늘은 나 혼자서도 충분해. 이거라면 익숙하거든♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"새로운 임무네. 임무가 어려워질수록 내 힘이 필요해지겠지. 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무 완료야. 막 구운 과자처럼 신선함과 안도감이 동시에 느껴지는 기쁨의 맛… 정말 우아해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"그건 마음에 드니까, 더 대담하게 해줘도 괜찮아. 지·휘·관♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/touch_ex.ogg"},"터치2_ex":{"voiceline":"무척이나 흡족한 표정이네. 좋아. 그대로 당신의 모든 걸 내게 맡기도록 해♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"포상으로 과자를 주기로 했지♪ 후후후, 오늘은 특별히 맛있는 걸로 부탁해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/904020/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['됭케르크'] :  과자 좀… 더 만들어 줄래?","voicelink":"https://