[{"클뜯 id":205090,"클뜯 함순이 id":20509,"함순이 이름":"하우","한글 함순이 + 스킨 이름":"하우","영문 함순이 + 스킨 이름":"Howe","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/205090/shipyard.png","설명":"킹 조지 V급 전함—하우 (HMS Howe)","자기소개":{"voiceline":"태평양으로 나가기 전에, 나는 대부분의 시간 동안 킹 조지 5세와 함께 행동했어. 그녀와 함께 사르데냐의 두 중요한 맹우를 맞이하기도 했지. 그외엔… 호송 말고는 딱히 특별한 일은 없는 것 같기도...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/profile.ogg"},"메인1":{"voiceline":"웨일즈와 듀크 오브 요크는 훌륭한 사람들이야. 가끔은 그녀들의 페이스를 따라갈 수 없을 때가 있긴 하지만...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/main1.ogg"},"메인2":{"voiceline":"킹 조지 5세 언니는 나한테 엄청 잘해줘. 종종 간식을 주기도 해... 매번 아이취급을 하지만 말았으면 더 좋겠는데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/main2.ogg"},"메인3":{"voiceline":"모항의 동료들은 다들 개성이 강하지. 그녀들과 사이좋게 지내는 게 어렵다고 느껴진다면… 음… 먼저 다같이 디저트 타임을 가져보는 건  어떨까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/main3.ogg"},"전투개시":{"voiceline":"결코 적에게 베풀 자비 같은 건 없다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/battle.ogg"},"상세확인":{"voiceline":"동료를 위해서는 물불을 가리지 않고, 적에겐 배려할 필요가 없다는 것이 나의 준칙이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/detail.ogg"},"드랍 설명":{"voiceline":"킹 조지 5세급 전함—하우","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조 호송이 필요해? 난 전문가라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/expedition.ogg"},"실망":{"voiceline":"선의를 베풀면 반드시 선의의 보답을 얻을 수 있다고 생각했는데… 내가 너무 순진했던 건가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/feeling1.ogg"},"낯섦":{"voiceline":"「Utcumque placuerit deo」——만약 신이 존재한다면, 그가 기대하는 세상은 어떤 모습일까? 적어도 끝없는 분쟁과 전쟁은 보고 싶지 않았겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/feeling2.ogg"},"호감":{"voiceline":"지휘관, 기분 안 좋아? 아니면 힘들어? 이럴 때는, 쿠키를 먹으면 돼. 기분도 정신도 금방 나아질 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 다음 디저트 타임 때 올래? 네가 있다면, 분위기가 훨씬 편안해질 거야. 나 개인적으로도 지휘관과 함께는 시간이 더 많아졌으면 좋겠고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/feeling4.ogg"},"사랑":{"voiceline":"돌려 말하는 건 내 스타일이 아니니까… 음. 지휘관, 좋아해, 함대의 리더로서도 늘 곁에 있는 사람으로서도. 너는 나에 대해… 어떻게 생각해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/feeling5.ogg"},"터치3":{"voiceline":"……？","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/headtouch.ogg"},"모항귀환":{"voiceline":"출격 나가서 고생했어. 기운이 남았으면, 바로 총결산 보고할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/home.ogg"},"hp 경고":{"voiceline":"아직… 더 버틸 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/hp_warning.ogg"},"로그인":{"voiceline":"드디어 왔구나, 좋아, 같이 오늘의 난제를 해결해보자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/login.ogg"},"실패":{"voiceline":"다음엔… 지지 않을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/lose.ogg"},"우편":{"voiceline":"이건 네 우편인 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/mail.ogg"},"임무":{"voiceline":"임무 있어? 내가 도와줄 일은 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/mission.ogg"},"임무완료":{"voiceline":"임무 완료했어. 보수 정리 같은 일은 나한테 맡겨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/mission_complete.ogg"},"서약":{"voiceline":"아, 이게 지휘관의 대답이야? 고마워, 기꺼이 받을게. 음… 생사를 함께할 수는 없다고 해도, 매일 내 옆에 있어줄 수 있다면 그걸로 충분해… 후후, 방금 나답지 않은 말을 한 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/propose.ogg"},"스킬":{"voiceline":"망설일 필요 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/skill.ogg"},"터치1":{"voiceline":"아직 힘들지 않아, 마사지는 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/touch.ogg"},"터치2":{"voiceline":"…? 뭘 하려는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/touch2.ogg"},"입수시":{"voiceline":"만나서 반가워, 지휘관. 난 킹 조지 5세급의 마지막 일원 하우야. 앞으로 잘 부탁할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/unlock.ogg"},"강화성공":{"voiceline":"후… 이 은혜, 전장에서 보답하도록 할게, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"후후, 오늘 상태 괜찮네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"후후훗, 다음 데이트 땐 어딜 갈까나… 참, 저번에 꽤 괜찮아 보이는 디저트 가게 봤었는데. 우리 둘이 같이 가자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"출격 수고했어. 우선 쉬면서 쿠키 좀 먹은 다음에 총결산 보고할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/205090/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어서 와, 오늘은 하루종일 나랑 같이 있을 수 있지?","voiceli