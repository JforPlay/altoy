l,"모항귀환":{"voiceline":"후우… 지휘관! 피곤하면 캐러밴에서 쉬어도 돼. 좀 좁고 많이 흔들리지만 그래도 괜찮으면… 에헤헤♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408042/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"「흐흐흐~! 짐 아니면 목숨을 내놓고 가라!」 …어때? U-556은 악역도 완벽하지? 후후훗, 이 정도면 여차할 때도 써먹을 수 있겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408042/login.ogg"},"실패":null,"우편":{"voiceline":"자, 여기 현상금 수배서야! 농담~♪ 지휘관, 새로운 우편이 왔으니까 확인해 줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408042/mail.ogg"},"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"고삐를 잡으면서 탄환을 채워야… 으아아?! 으으, 좀 어려운데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408042/touch.ogg"},"터치2":{"voiceline":"으아아?! 지, 지휘관… 방금 거 꽤 위험했거든…? ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408042/touch2.ogg"},"입수시":{"voiceline":"「바다의 퍼시벌」은 육지에서도 여전히 늠름한 기사야! 언니가 맡긴 짐은 내가 꼭 지켜내고야 말겠어! 자, 덤빌 테면 덤벼봐~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408042/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"좋아! 뿌리쳤어! 지휘관, 슬슬 원래 항로로 돌아가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/408042/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"웨스턴","상점 id":71040,"상점 카테고리 id":25,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"한정 (2025/09/11)","진영":"KMS","레어도":"SR","ex_chat_status":0}]