[{"클뜯 id":303080,"클뜯 함순이 id":30308,"함순이 이름":"나치","한글 함순이 + 스킨 이름":"나치","영문 함순이 + 스킨 이름":"Nachi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303080/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303080/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303080/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303080/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303080/shipyard.png","설명":"묘코형 중순양함 2번함·나치","자기소개":{"voiceline":"묘코형 중순양함 2번함 나치야. 2번함이라 해도 여동생이 아니니까. 그 대전쟁에선 남방에서 북방에 이르기까지 활약했고, 오랜 기간 기함으로 있었어. 가장 우수한 중순양함── 그게 내 실력이라구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/profile.ogg"},"메인1":{"voiceline":"제5 함대 애들? 그립네… 아냐! 그렇게 생각하는 건 가끔, 아주 가끔이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/main1.ogg"},"메인2":{"voiceline":"밤중에 훈련장에서 유령이 나온다고? 그, 글쎄! 그런 괴담을 믿다니, 지휘관은 어린아이인 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/main2.ogg"},"메인3":{"voiceline":"솔트레이크시티? 운이 좋았을 뿐이야! 그런 운은 언제까지고 계속되지 않을 거란 사실을 언젠가 반드시 깨닫게 해주겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/main3.ogg"},"전투개시":{"voiceline":"흥! 눈은 장식으로 달고 다니는 멍청이들!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/battle.ogg"},"상세확인":{"voiceline":"뭐? 내 꼬봉이 되고 싶다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/detail.ogg"},"드랍 설명":{"voiceline":"묘코형 중순양함 2번함·나치","voicelink":null},"의뢰 완료":{"voiceline":"응응♪ 부지런한 것도 중요하다구? 물론 난 예외지만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/expedition.ogg"},"실망":{"voiceline":"너한테 말하는 거 아니거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 몸가짐에 신경 쓰지 않는 사람은 주위에서 좋아해 주지 않는다구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/feeling2.ogg"},"호감":{"voiceline":"노력? 전혀? 나 같은 천재에게 노력 같은 건 필요 없다구. 왜냐면 이렇게 숨을 쉬고 있기만 해도 그만큼 강해지니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/feeling3.ogg"},"기쁨":{"voiceline":"에에! 지휘관!? 어째서 오밤중에 훈련장에!? 뭐? 내가 걱정되어서? 나, 난 그저 한가해서 산책 나왔을 뿐… 사격 소리? 아, 그건...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/feeling4.ogg"},"사랑":{"voiceline":"나, 그다지 솔직하지 못하니까, 노력하는 모습을 보여버리는 게 가장 싫어… 하지만 지휘관은 예외야. 지휘관이라면, 내 어떤 모습이라도 분명…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어~ 하지만, 10배 더 노력해도 나한텐 못 이겨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"따, 딱히 훈련하고 있는 게 아니라구? 여기서 느긋하게, 저쪽에서 땀을 흘리고 있는 아이들을 보고 그저 웃어줬을 뿐이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/login.ogg"},"실패":{"voiceline":"칫── 어디가 잘못 됐다는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/lose.ogg"},"우편":{"voiceline":"편지를 넘겨달라고? 애원이라도 한다면 생각해볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/mail.ogg"},"임무":{"voiceline":"이런 간단한 임무, 완료하지 못하는 건 바보 뿐이라구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/mission.ogg"},"임무완료":{"voiceline":"흐응, 역시 내 도움이 필요하다는 거네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/mission_complete.ogg"},"서약":{"voiceline":"나는, 솔직하진 않지만… 그치만── 널 절대로 세상에서 가장 행복한 사람으로 만들어 보이겠어! 그래! 이 나치의 이름을 걸고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/propose.ogg"},"스킬":{"voiceline":"내 주포 앞에 무릎 꿇어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/skill.ogg"},"터치1":{"voiceline":"지휘관, 외로워? 흐응, 나도 마침 한가해서 곤란한 참이었는데 말야~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/touch.ogg"},"터치2":{"voiceline":"…!? 바, 바보! 나한테 푹 빠진 거야!? 적어도, 적어도 양해를 구하고 나서 하란 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/touch2.ogg"},"입수시":{"voiceline":"나는 나치. 사쿠라 엠파이어 최초의 조약형 중순양함으로서, 나무랄 데 없는 완전무결한 설계가 되어 있어. 앞으로 잘 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/unlock.ogg"},"강화성공":{"voiceline":"나의 완벽함이 한층 더 진화한 모양이네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/upgrade.ogg"},"vote":null,"승리":{"voiceline":"흐~응♪ 당연하잖아? 이런 거.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303080/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_status":0},{"클뜯 id":303089,"클뜯 함순이 id":30308,"함순이 이름":"나치","한글 함순이 + 스킨 이름":"나치·改","영문 함순이 + 스킨 이름":"Nachi (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303089/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303089/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303089/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303089/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303089/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303089/shipyard.png","설명":"어때, 개조 완료로 더욱 완벽해진 이 나치의 모습은?! 이제 솔직하지 못한 지휘관도 드디어 내 실력을 인정해 주려나? 의장 숙련을 위해서 요즘 들어 늦게 일어나는 것 같다고…… 조, 조용히 해!","자기소개":null,"메인1":{"voiceline":"얼마 전에 또 하구로랑 아침에 마주쳤지 뭐야… 응? 트레이닝 장소를 바꾸는 게 어떠냐고? 글쎄… 그럼, 사쿠라 엠파이어 숙소가 아니라 지휘관의…… 그런 건 당연히 무리지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/main1.ogg"},"메인2":{"voiceline":"불안해? 그러면… 뭐라도 수예든 작업이든 집중해서 마음을 다잡는 건 어때? 예를 들면 종이학을 접어본다던가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/main2.ogg"},"메인3":{"voiceline":"어머, 아주 대놓고 게으름을 피우고 있네… 후훗, 그럼 나도 게으름 피우…면 안 되지! 얌마, 지휘관! 아직 일 덜 끝났잖아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"간식? 딱히 이런 걸 사 오라고 한 적은… 아하~ 이거 내가 하도 심부름을 시켜서 빵셔틀이 습관이 된 모양이네. 그럼… 사양하지 않고 잘 받을게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/detail.ogg"},"드랍 설명":{"voiceline":"어때, 개조 완료로 더욱 완벽해진 이 나치의 모습은?! 이제 솔직하지 못한 지휘관도 드디어 내 실력을 인정해 주려나? 의장 숙련을 위해서 요즘 들어 늦게 일어나는 것 같다고…… 조, 조용히 해!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 꽤 열심히 하고 있네. 후훗, 어서 보상을 확인하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"수고 많았어~ 어머, 전과가 꽤 괜찮네…… 뭐… 지휘관도 예전에 비해 15배 정도는 분발하고 있잖아? 날 따라잡기 시작한 것도 이상하진 않지~//","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"네 오늘 일정은 이 완벽한 나치가 짜뒀어! 자, 같이 열심히 하자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/login.ogg"},"실패":{"voiceline":"뭐가 잘못된 건지는 모르겠지만… 일단 도망쳐, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/lose.ogg"},"우편":null,"임무":{"voiceline":"이렇게 간단한 임무라면 순식간에 끝나겠지. 나야 물론이고 지휘관도 할 수 있잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/mission.ogg"},"임무완료":{"voiceline":"내가 도와줄 필요도 없겠네! 후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 외로워? 후훗, 나도 마침 외로……운 게 아니라, 너무 한가해서 죽겠다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/touch.ogg"},"터치2":{"voiceline":"응? 왜 그래…… 꺅?! 자, 잠깐 방금 그건 무슨 의미야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/touch2.ogg"},"입수시":{"voiceline":"어때, 개조 완료로 더욱 완벽해진 이 나치의 모습은?! 이제 솔직하지 못한 지휘관도 드디어 내 실력을 인정해 주려나? 의장 숙련을 위해서 요즘 들어 늦게 일어나는 것 같다고…… 조, 조용히 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"엎드려서 사과하면 용서해 줄게♪ 이래 봬도 나, 꽤 관대한 편이라고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303089/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스