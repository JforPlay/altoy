[{"클뜯 id":302090,"클뜯 함순이 id":30209,"함순이 이름":"아부쿠마","한글 함순이 + 스킨 이름":"아부쿠마","영문 함순이 + 스킨 이름":"Abukuma","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302090/shipyard.png","설명":"나가라형 경순양함 6번함·아부쿠마","자기소개":{"voiceline":"나는 나가라형 경순양함 아부쿠마. 제1 수뢰 전대에서 오래 일했어. 겉모습은 도깨비처럼 보이지만, 사실은 낚시 같은 걸 좋아해서… 키스카섬에서도 그랬지만, 아마 난 사람을 지키는 일을 하는 편이 더 잘 맞을지도.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/profile.ogg"},"메인1":{"voiceline":"지휘관, 낚시하러 가지 않을래? 장기를 둬도 좋다구?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/main1.ogg"},"메인2":{"voiceline":"이름은 좀 쓰기 어렵지만, 읽기는 쉽다구? 지휘관도 읽어볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/main2.ogg"},"메인3":{"voiceline":"겉모습? 하아… 이 양말, 실은 갈아신을 수도 있다구? 지휘관도 신어볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/main3.ogg"},"전투개시":{"voiceline":"제1 수뢰 전대, 아부쿠마, 출격.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/battle.ogg"},"상세확인":{"voiceline":"지휘관, 너무 무리하진 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/detail.ogg"},"드랍 설명":{"voiceline":"나가라형 경순양함 6번함·아부쿠마","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 모항에 낚시라도 하러 가지 않을래? 마침 의뢰 나갔던 아이들도 돌아올 시간이고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/expedition.ogg"},"실망":{"voiceline":"만지지 마…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/feeling1.ogg"},"낯섦":{"voiceline":"지휘관. 무슨 일이야? 용무가 없다면 좀 조용히 해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/feeling2.ogg"},"호감":{"voiceline":"싸움 좋아할 것 같아 보여? 그래… 싸우는 것보다 호위 임무 쪽을 좋아하는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 낚시하러 가지 않을래? 아… 일이 아직 남아 있구나… 그럼 끝날 때까지 기다릴게. 응? 괜찮아, 지휘관이랑 같이 있는 편이 즐거우니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/feeling4.ogg"},"사랑":{"voiceline":"난 딱히 저주를 하거나 모질게 굴거나 하지 않아, 그저 「아부쿠마」일 뿐이야… 하지만, 만약 누군가가 지휘관을 다치게 하려 한다면, 내가 귀신이 되어줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"돌아왔어. 음, 다들 장하네. 이번엔 내 발을 밟은 아이가 없었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/home.ogg"},"hp 경고":{"voiceline":"당황하지 마… 지금은 시기를 엿보는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/hp_warning.ogg"},"로그인":{"voiceline":"어서 와. 어뢰 먹을래? 아삭아삭, 사각사각이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/login.ogg"},"실패":{"voiceline":"전 함, 전진… 내가 후미를 맡을게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/lose.ogg"},"우편":{"voiceline":"편지 왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/mail.ogg"},"임무":{"voiceline":"새 임무? 알았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/mission.ogg"},"임무완료":{"voiceline":"좋은 보상…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302090/mission_complete.ogg"},"서약":{"voiceline":"제1 수뢰 전대의 다른 아이가 아니라, 내가 이걸 받아도