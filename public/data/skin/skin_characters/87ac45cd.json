[{"클뜯 id":305100,"클뜯 함순이 id":30510,"함순이 이름":"무사시","한글 함순이 + 스킨 이름":"무사시","영문 함순이 + 스킨 이름":"Musashi","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305100/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305100/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305100/shipyard.png","설명":"야마토급 전함 2번함 - 무사시","자기소개":{"voiceline":"내 이름은 무사시, 그 대전에서 사쿠라 엠파이어를 잠식한 광란을 만회했어야 할 존재……. 뭐, 좋아. 과거를 비탄하는 건 무의미하고, 내 방식에도 어긋나. 적어도 이번에는… 어떠한 대가를 치르더라도 모든 것을 지켜내고야 말겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/profile.ogg"},"메인1":{"voiceline":"우는 것은 두견새의 본능. 그러니 그 녀석이 울지 않으면 그저 기다리면 될 일이지. 그대는 이 이치를 알겠어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main1.ogg"},"메인2":{"voiceline":"때로는 그대도 마음을 가라앉히고 자신의 우군에 대해 생각하는 것이 적을 치는 것보다 중요할 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main2.ogg"},"메인3":{"voiceline":"피곤하다면 잠을 청하도록 해. 내가 그대를 지키고, 그대의 소임을 대신 잘 처리해줄테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main3.ogg"},"전투개시":{"voiceline":"무사시는 여기 있어. 두려움도 초조함도 필요치 않아. 담담히 나아가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/battle.ogg"},"상세확인":{"voiceline":"추종자를 비호하는 것은 위에서 군림하는 자의 책무지. 지휘관인 그대는… 내가 지켜줄게. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/detail.ogg"},"드랍 설명":{"voiceline":"야마토급 전함 2번함 - 무사시","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 아이들이 귀환했어. 귀로 호위를 해주러 달려 나갈 수는 없지만, 다들 무사히 돌아온 모습을 볼 수 있는 것만으로도 흡족해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/expedition.ogg"},"실망":{"voiceline":"그대로 갈길을 가겠다면 굳이 그대를 막지 않겠지만…. 재주복주의 이치를 잘 기억해 둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/feeling1.ogg"},"낯섦":{"voiceline":"모난 돌은 정을 맞고, 뛰어난 매는 그 발톱을 숨기지…. 그대도 신분이 높아지면 그에 따라 말도 행동도 조심하는 것이 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/feeling2.ogg"},"호감":{"voiceline":"내 화난 모습을 한번도 못 봤다고? …후후후, 순종적인 짐승도 송곳니를 드러내는 법인데, 겉모습으로 상대를 판단하다가는 쓴맛을 보게 될 거야. 물론, 날 화나게 하는 건 보통 사람은 불가능한 일이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/feeling3.ogg"},"기쁨":{"voiceline":"사람에게는 다들 섬세한 면이 있어. 그대에게도, 그리고 물론 내게도……. 내 그런 모습을 보고 싶다고? 후후후, 그대의 노력 여하에 달려 있다…고 말해둘게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/feeling4.ogg"},"사랑":{"voiceline":"어때? 내 품 안에서 잠에 못 들겠어? 불안함, 초조함을 쉽게 떨쳐버리기 힘든 거야? …후후후, 그대가 가진 모든 의심과 두려움은 버려둬. 이 무사시의 품 안에 있는 한, 그대에게 상처를 주는 건 나타날 수 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/feeling5.ogg"},"터치3":{"voiceline":"담력이 대단한 아이네……. 후후후, 이 느낌도 나쁘지 않은걸….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/headtouch.ogg"},"모항귀환":{"voiceline":"무사히 돌아왔으면 그걸로 됐어. 우선은 푹 쉬어. 자신의 업을 짊어지고 앞으로 나아가는 것이야말로 인간…. 공적에 눈이 멀어 초조히 내달리는 건 금물이지. 그대에게는 아직 해야 할 일이 많아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/home.ogg"},"hp 경고":{"voiceline":"어떤 상황에서도 반드시 지켜낼 거야……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 오늘은 무엇부터 시작해? 그대에게 안건이 없다면, 내가 대신 준비해줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/login.ogg"},"실패":{"voiceline":"너무 깊이 생각하지 말고, 당황하지 마. 그대들은 내가 확실히 지켜줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/lose.ogg"},"우편":{"voiceline":"자, 받아. 그대에게 편지가 왔길래 가지고 왔어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/mail.ogg"},"임무":{"voiceline":"새로운 임무인가? 땅에 발을 붙이고 찬찬히, 그리고 확실하게 해내도록 해. 공적에 눈이 멀어 서두르는 건 금물이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/mission.ogg"},"임무완료":{"voiceline":"임무 보수를 확인했어. 모항의 물자 비축도 더 윤택해지겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/mission_complete.ogg"},"서약":{"voiceline":"네 불안, 당황, 두려움은 모두 내게 맡기고, 망설이지 말고 앞으로 나아갈 생각만 하면 돼. 자, 나를 더욱 더 많이 의지하도록 해. 사랑하는 지휘관, 어떠한 존재도 내게서 널 빼앗을 수 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/propose.ogg"},"스킬":{"voiceline":"때가 왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/skill.ogg"},"터치1":{"voiceline":"불안해서 덜컥 겁이 날 때면 내 곁으로 와. 이곳은 네게 있어서 안전한, 돌아갈 집과도 같은 곳이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/touch.ogg"},"터치2":{"voiceline":"정말 귀여운 아이라니까…. 사람의 살결이 그리우면, 부끄러워 하지 말고 내 품속으로 뛰어들렴.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/touch2.ogg"},"입수시":{"voiceline":"나는 야마토급 전함, 무사시다. 내게 인정을 받고 싶다면, 바다의 폭풍을 휘어잡을 기세를 보여야 한다. 다만, 이러한 규모의 함대를 통솔하는 너에게, 어려운 일은 아니겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/unlock.ogg"},"강화성공":{"voiceline":"\"아름드리나무도 털끝만한 씨앗에서 자라난다.\" ……오늘은 티끌같이 사소한 일이라도, 쌓이면 적을 막고 자기가 사랑하는 자들을 지키는 큰 봉우리가 될 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"고작 승리한 걸로 들떠서는 안 되지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":{"voiceline":"의뢰팀 아이들이 귀환했어. 마중에는 나도 동행하게 해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/expedition_ex.ogg"},"사랑_ex":{"voiceline":"오늘 공무가 끝나면 내 곁으로 돌아오도록 해. …돌아오라니 무슨 말이냐고? 말 그대로의 의미겠지. 자고 있는 그대의 목덜미를 베… 아니, 그대의 침소를 덮치려는 아이가 나타나더라도 내 곁이라면 안전하겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"벌써 돌아온 거야? 귀로 호위는 내가 하게 해달라고 분명 말했을 텐데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 그대가 처리할 오늘 업무 준비는 내가 이미 끝내뒀어. 우선은…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/login_ex.ogg"},"실패_ex":{"voiceline":"사투는 상책이 아니야. 어서 후퇴해. 태세를 가다듬고 다시 싸우면 될 일이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/lose_ex.ogg"},"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"내 무릎은 이미 준비 완료야. 어서 여기 눕도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/touch_ex.ogg"},"터치2_ex":{"voiceline":"이 감촉이 맘에 든 거면, 머리를 파묻어도 상관없어. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"안심하고 승리의 여운에만 취하도록 해, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['미카사'] :  지금까지 고생 많았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/couple_encourage1.ogg"},{"voiceline":"['나가토'] :  내 뒤에 숨어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/couple_encourage2.ogg"},{"voiceline":"['시나노 '] :  야마토급의 위력을 보여주도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/couple_encourage3.ogg"},{"voiceline":"['아마기'] :  그대의 보좌만 있으면, 나도 전력을 다해서 싸울 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/couple_encourage4.ogg"}],"메인4":{"voiceline":"여가를 보낼 때는… 족욕을 하는 게 취미야. 머리와 가장 멀리 떨어진 발을 탕에 담그면, 정신이 편안해져. 참 기묘하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"동료 중에 거북한 아이가 있다고? 후후후, 그런 아이를 상대해야 할 때는 나도 데려가도록 해. 그대에게 대적하는 아이라면, 나도… 그런 게 아니라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main6_ex.ogg"},"메인7_ex":{"voiceline":"휴우… 조금 피곤하네. 같이 족욕이라도 할래? 그대도 슬슬 쉬고 싶을 때가 됐을 텐데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main7_ex.ogg"},"메인8_ex":{"voiceline":"좋아하는 음식? 도미야. 특히 갓 튀긴 도미 튀김은 정말 일품이라고 할 수 있지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"가끔 여기서 잠든 시나노의 모습이 보여. 그대가 준 꿈이 영원히 계속되기만을 바랄 뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":{"voiceline":"사람을 다루는 일이라면 내게 맡겨둬. 안심해. 평소처럼 그대 대신 잘 처리해 줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305100/main9_ex.ogg"},"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"UR","ex_chat_status":1},{"클뜯 id":305101,"클뜯 함순이 id":30510,"함순이 이름":"무사시","한글 함순이 + 스킨 이름":"보랏빛 달그림자","영문 함순이 + 스킨 이름":"Violet Moonglow","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305101/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305101/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305101/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305101/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305101/shipyard.png","설명":"어서 오세요, 주인님'이라고 음식점 아이들이 입을 모아 그대에게 웅얼거리고 있네. 후후후, 무슨 풍습 같은 건가?","자기소개":null,"메인1":{"voiceline":"빛나는 승리를 거둔 동료들의 전공을 치하하는 과자라면 이미 준비해뒀어. 후후후, 축하 상품이니 요금은 안 받아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/main1.ogg"},"메인2":{"voiceline":"아까 주문한 과자가 아직도 전달이 안 됐다고? 어떤 상황인지 말 안해도 알겠네……. 사카와, 이쪽으로 와 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/main2.ogg"},"메인3":{"voiceline":"이 아이들 모두 음식점에서 최선을 다해주고 있어. 사소한 실수는 너그럽게 봐주는 것이 도리인데, 끝까지 집요하게 추궁하는 무례한 자가 있으면 교훈을 주는 수밖에 없겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/main3.ogg"},"전투개시":{"voiceline":"깨끗한 곳을 어지럽히는 녀석들을 없애주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/battle.ogg"},"상세확인":{"voiceline":"음식점 일 좀 도와주지 않을래? 후후후, 계속 여기 앉아 있기만 하면 돼. 그대가 내 시선 안에 없으면 아무래도 걱정이 되어서…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/detail.ogg"},"드랍 설명":{"voiceline":"어서 오세요, 주인님'이라고 음식점 아이들이 입을 모아 그대에게 웅얼거리고 있네. 후후후, 무슨 풍습 같은 건가?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"출격하느라 수고 많았어. 마음에 드는 자리에서 쉬고 있어. 수중의 자질구레한 일 처리가 끝나면, 내가 직접 그대를 접객하러 갈테니. 우후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"원하는 건 안주? 아니면 과자? 후후후, 내가 직접 그대에게 먹여주지. 자, 아~ 해봐….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/login.ogg"},"실패":{"voiceline":"우선은 이 한 벌뿐인 옷부터 다시 가다듬어야겠어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/lose.ogg"},"우편":null,"임무":{"voiceline":"기왕 왔으니 안심하고 쉬도록 해. 임무에 대한 건 나중에 생각해도 되니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"누가 접객을 소홀히 했다고…? 바로 한소리 해주러…… 아니야? 그냥 추가 주문이라고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/touch.ogg"},"터치2":{"voiceline":"내 품에서 편히 쉬어. 여기에서는 아무도 그대를 방해할 수 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/touch2.ogg"},"입수시":{"voiceline":"어서 오세요, 주인님'이라고 음식점 아이들이 입을 모아 그대에게 웅얼거리고 있네. 후후후, 무슨 풍습 같은 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305101/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70739,"상점 카테고리 id":17,"스킨 태그":"X","입수 영상":"X","재화":800,"기간":"상시","진영":"IJN","레어도":"UR","ex_chat_status":0},{"클뜯 id":305102,"클뜯 함순이 id":30510,"함순이 이름":"무사시","한글 함순이 + 스킨 이름":"자색 토끼의 스나이핑 게임","영문 함순이 + 스킨 이름":"The Purple Rabbit's Marksmanship","스킨 타입":"Dreamland Park","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305102/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305102/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305102/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305102/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305102/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305102/shipyard.png","설명":"…흠! 이 무사시가 나서면 이 정도 과녁 맞추기야 식은 죽 먹기지… 지휘관, 그대가 원하는 상품을 말해 보거라. 부탁한 아이들 몫까지 함께 따주마.","자기소개":null,"메인1":{"voiceline":"축제 사격은 내게 낯선 일은 아니다. 후후후, 그대 또한 총을 다루는 건 익숙할 테지. 한 자루씩 들고 우열을 가리는 것도 즐겁겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/main1.ogg"},"메인2":{"voiceline":"모항의 동료들을 즐겁게 해주려고 마련한 수많은 수상 놀이기구와 즐길 거리들… 그 노력, 참으로 기특하군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/main2.ogg"},"메인3":{"voiceline":"우리가 이런 모습을 한 것은 그대가 이 유원지에서 우리를 즐겁게 해주는 것처럼 그대 눈을 즐겁게 해주기 위함이지. 물론 더 많은 서비스를 원한다면 응해주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/main3.ogg"},"전투개시":{"voiceline":"삼단 사격이 아닌, 삼단 자세로 임하도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/battle.ogg"},"상세확인":{"voiceline":"「토끼 덫에 여우 걸린다」고 하던가. 지금 나는 그대에게 있어 토끼일까? 아니면 여우일까? 이것 또한 흥미롭군… 후후후♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/detail.ogg"},"드랍 설명":{"voiceline":"…흠! 이 무사시가 나서면 이 정도 과녁 맞추기야 식은 죽 먹기지… 지휘관, 그대가 원하는 상품을 말해 보거라. 부탁한 아이들 몫까지 함께 따주마.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 아이들이 돌아온 모양이군. 이 경품과 네 마중으로 그녀들의 노고를 위로하도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"놀다 지쳤으면 다른 곳으로 이동해서 같이 쉬는 건 어떤가? 안심해라. 그대를 잡아먹을 생각은 없으니. 오히려 그대를 만족시키기 위해서라면 뭐든…… 후후후, 착한 아이로구나♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"한 바퀴 돌았나? 그럼 거기 앉아서 잠깐 쉬어라. 지금 바로 최고 기록을 경신해 보일 테니……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"잘 왔다. 그대의 취향에 맞춘 이 토끼 의상에 물총… 이 유원지와 놀이기구에 참으로 걸맞은 모습이지 않은가? 그대도 솔직한 마음으로 즐겼으면 좋겠다만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새로운 임무로군. 형세가 아무리 격렬하게 변한다 해도, 조급해 하지 않고 침착하게만 대처하면 괜찮을 거다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐군. 이 보상과 경품으로 네 노력에 보답하마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"관심이 있는 것은 총인가? 아니면… 이 옷의 옥감인가? 후후후…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/touch.ogg"},"터치2":{"voiceline":"토끼의 습성… 설마 그걸 모르는 건 아닐 테지? ♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/touch2.ogg"},"입수시":{"voiceline":"…흠! 이 무사시가 나서면 이 정도 과녁 맞추기야 식은 죽 먹기지… 지휘관, 그대가 원하는 상품을 말해 보거라. 부탁한 아이들 몫까지 함께 따주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"예상대로 승리했군. 경품은 네 기쁨과 안도 정도면 합당하겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305102/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"번개를 내리치는 참격과도, 의장을 이용한 포격과도 느낌이 다르지만… 그편이 오히려 도전할 가치가 있지. 그러니 걱정하지 말고 평소대로 이 무사시가 노려야 할 적을 가리키기만 하면 된다.","