[{"클뜯 id":203020,"클뜯 함순이 id":20302,"함순이 이름":"슈롭셔","한글 함순이 + 스킨 이름":"슈롭셔","영문 함순이 + 스킨 이름":"Shropshire","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203020/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203020/shipyard.png","설명":"런던급 중순양함·슈롭셔 (HMS Shropshire)","자기소개":{"voiceline":"런던급의 막내, 언니들과 떨어져 수양딸로 보내진 것이 바로 저랍니다~ 아, 딱히 동정심을 바라고 말한 게 아니라, 아주 쪼─금 그 부분에 대해 신경 써주신다면 지휘관에게 후한 점수를 매겨드릴지도! …약았다고요? 싫다~, 사적으론 성실하게 하고 있답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/profile.ogg"},"메인1":{"voiceline":"지휘관이랑 단둘이 있을 때는 긴장되지만, 지휘관뿐이라면 얼버무릴 (얼버무리며) …안심할 수 있으니까 뭐 됐나~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/main1.ogg"},"메인2":{"voiceline":"지·휘·과·안~ 살려줘요~ 부탁이에요, 의지할 사람이 지휘관 뿐이라구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/main2.ogg"},"메인3":{"voiceline":"지휘관, 그거 알아요? 사람은 가끔 실수하는 편이 더 귀엽게 보인다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/main3.ogg"},"전투개시":{"voiceline":"나는 딱히 상관없지만, 지휘관에게 승리를 가져다드리지 않으면~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/battle.ogg"},"상세확인":{"voiceline":"지휘관은 한가해 보이네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/detail.ogg"},"드랍 설명":{"voiceline":"런던급 중순양함·슈롭셔 (HMS Shropshire)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관? 저를 계속 바라보셔도 괜찮지마안, 의뢰 나간 아이들은 벌써 돌아왔다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/expedition.ogg"},"실망":{"voiceline":"지휘관, 좀 방해돼요, 비켜요 비켜─","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/feeling1.ogg"},"낯섦":{"voiceline":"무슨 일인가요? 지금 일하는 중이니까, 헌팅은 좀 봐주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/feeling2.ogg"},"호감":{"voiceline":"지휘관은 좋은 사람인 데다 장래도 밝으시지만, 그래도 냉정하게 생각하면 아직은 이르니까요, 그러니까 죄송해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 같은 분은 제 타입이지만 지금은 좋아하게 될 이유가 딱히 없으니까요, 그러니까 죄송해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/feeling4.ogg"},"사랑":{"voiceline":"좀 더 시간과 장소와 무드에 신경 써주셨으면 하니까요, 그러니까 죄송해요! …아, 저, 고백했던 횟수 같은 건 신경 안쓴다구요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 멋있어! 나도 열심히 해야지~ …어때요? 전장에서 상처 입은 마음이 제 후배 파워로 치유되어버렸나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/home.ogg"},"hp 경고":{"voiceline":"이거 위험해, 겁나 위험하다구…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/hp_warning.ogg"},"로그인":{"voiceline":"아, 지휘관 이제 왔어요? 마중 가려던 참이었어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/login.ogg"},"실패":{"voiceline":"약간 부족해 보이는 아이가, 귀엽다고들 하잖아요? 엣헴~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/lose.ogg"},"우편":{"voiceline":"지휘관에게~ 새로운 편지가 왔어요~ 저기~ 러브레터인가요? 러브레터인 거죠? 열어봐요~ 열어봐요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/mail.ogg"},"임무":{"voiceline":"새로운 미션… 지휘관이 제대로 해낸다면 저, 정─말로 다시 보게 될지도 몰라요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/mission.ogg"},"임무완료":{"voiceline":"보너스가 내려왔어요~ 아니면~ 지휘관은 제가 내리는 상을 받고 싶으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/mission_complete.ogg"},"서약":{"voiceline":"죄송해요… 라고, 말할 거라 생각하셨나요? 좋아요, 지휘관. 앞으로는 확실히, 책임져 주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/propose.ogg"},"스킬":{"voiceline":"열심히 해야겠네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/skill.ogg"},"터치1":{"voiceline":"제대로 일하지 않으면, 저라도 '뿌우─' 할 거라구요? 지·휘·과·안?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/touch.ogg"},"터치2":{"voiceline":"꺄앗! 지휘관, 이런 건 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/touch2.ogg"},"입수시":{"voiceline":"런던급의 막내 슈롭셔─ 착임했습니다~ 곧잘 순진하다거나 속기 쉽다거나 하는 말을 들으니까, 지휘관에게 폐를 끼쳐버릴지도~ 그럼, 잘 부탁드려요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/unlock.ogg"},"강화성공":{"voiceline":"강해지지 않아도 괜찮지만, 지휘관의 도움이 될 수 있다는 건 좋네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"저를 칭찬해주지 않으셔도 괜찮아요, 다른 자매들을 더욱 봐주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203020/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_chat_status":0},{"클뜯 id":203029,"클뜯 함순이 id":20302,"함순이 이름":"슈롭셔","한글 함순이 + 스킨 이름":"슈롭셔·改","영문 함순이 + 스킨 이름":"Shropshire (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203029/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203029/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203029/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203029/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203029/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/203029/shipyard.png","설명":"런던급 막내 슈롭셔, 다시 착임했습니다. 잘 부탁드립니다~ 흐흠, 지금은 아주 야무지고 유능해 보이지 않나요? 이제 어느 정도는 지휘관의 골칫거리를 줄여 줄 수 있겠죠~","자기소개":null,"메인1":{"voiceline":"아, 여기 틀렸네요…. 설마 지금 지휘관님, 일부러 얼빠진 척 하는 거예요? 엥? 진짜로 틀린 거라구요??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/main1.ogg"},"메인2":{"voiceline":"지·휘·관·님~ 도와주세요~ 부탁이에요~ 의지할 수 있는 건 지휘관님 뿐이에요~ ……자, 이거 해주시면 돼요♪ 에헤헷.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/main2.ogg"},"메인3":{"voiceline":"의상이 바뀌면 기분도 바뀐다…고 런던 언니가 그랬는데, 바뀌는 건 누구의 마음이려나요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/main3.ogg"},"전투개시":{"voiceline":"딱 지금만 유능한 슈롭셔, 갑니다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 한가해 보이네요~ 그러다 서식스한테 한소리 들어요. 정말, 그 애는 조금은 얼빠진 면이 있어야 멋있다는 걸 모른다니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/detail.ogg"},"드랍 설명":{"voiceline":"런던급 막내 슈롭셔, 다시 착임했습니다. 잘 부탁드립니다~ 흐흠, 지금은 아주 야무지고 유능해 보이지 않나요? 이제 어느 정도는 지휘관의 골칫거리를 줄여 줄 수 있겠죠~","voicelink":null},"의뢰 완료":{"voiceline":"더 보셔도 돼요~ 의뢰 보상 확인만 안 까먹으셨다면♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관님, 대단해~! 저, 또 반했어요! …지금은 이 정도면 되겠죠? 하하하, 너무 칭찬해서 들뜨면 큰일이잖아요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"후훗, 지휘관님, 저 기다리고 있다구요. 오늘도 유능해 보이는 슈롭셔가 당신의 비서함이 되어 드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/login.ogg"},"실패":{"voiceline":"방금 건 일부러 그런 게 아니라구요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/lose.ogg"},"우편":null,"임무":{"voiceline":"새로운 미션……. 지휘관님이 잘 해내면 저, 완전 지휘관님 다시 볼 거 같아요~ 정말이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/mission.ogg"},"임무완료":{"voiceline":"임무 완료에 대한 제 포상, 그건…다음에 서식스한테 잔소리 들을 때 조금 도와드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님의 구원 요청인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/touch.ogg"},"터치2":{"voiceline":"이러면 안 돼!라고 해도 어차피 안 들으시겠죠~ 흥.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/touch2.ogg"},"입수시":{"voiceline":"런던급 막내 슈롭셔, 다시 착임했습니다. 잘 부탁드립니다~ 흐흠, 지금은 아주 야무지고 유능해 보이지 않나요? 이제 어느 정도는 지휘관의 골칫거리를 줄여 줄 수 있겠죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"저도, 다른 애들도 다 칭찬해줘야 유능한 지휘관이겠죠? 후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/203029/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치