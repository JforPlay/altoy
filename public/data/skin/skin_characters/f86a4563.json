,"드랍 설명":{"voiceline":"하아… 정말 운이 없네. 하필 이런 타이밍에 폭우를 만날 줄이야… 미안해, 지휘관. 아무래도 우리, 운이 없게도 잠깐 여기서 비를 피해야 할 것 같아…….","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"비가 그치면 욕탕에 들어가서 느긋하게 쉬어야겠어. 지휘관, 어때? 혹시 같은 생각이면 나랑 같이 들어갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605024/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"아직 비가 내리는데 어딜 가려고? 그냥 얌전히 내 곁에 있지 그래? 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605024/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"응? 평소엔 볼 수 없는 흠뻑 젖은 리토리오를 보고 넋을 잃은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605024/touch.ogg"},"터치2":{"voiceline":"실은 말이지, 지금은 그럴 분위기가 아니라고 말하고 싶은데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605024/touch2.ogg"},"입수시":{"voiceline":"하아… 정말 운이 없네. 하필 이런 타이밍에 폭우를 만날 줄이야… 미안해, 지휘관. 아무래도 우리, 운이 없게도 잠깐 여기서 비를 피해야 할 것 같아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/605024/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"오피스 타임","상점 id":70866,"상점 카테고리 id":23,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2025/04/02)","진영":"RN","레어도":"SSR","ex_chat_status":0}]