[{"클뜯 id":405010,"클뜯 함순이 id":40501,"함순이 이름":"비스마르크","한글 함순이 + 스킨 이름":"비스마르크","영문 함순이 + 스킨 이름":"Bismarck","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405010/shipyard.png","설명":"비스마르크급 전함 - 비스마르크 ","자기소개":{"voiceline":"내가 바로 비스마르크의 이름을 잇는 메탈 블러드 전함. 메탈 블러드식 방어와 장갑설계로 어떤 전장에서라도 최고의 실력을 발휘하지. 기대해도 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/profile.ogg"},"메인1":{"voiceline":"곤란한 일이 생겼다고? 내 전투경험이 도움이 될까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/main1.ogg"},"메인2":{"voiceline":"\"라인 연습\"이라고? 별로 좋은 기억은 없는 것 같네...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/main2.ogg"},"메인3":{"voiceline":"지휘관, 또 나른해보이는 표정이나 하고…자, 얼굴을 들고 가슴을 펴고 눈을 크게 떠! 그래, 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/main3.ogg"},"전투개시":{"voiceline":"오이겐이 아니라, 날 따라와! 자아, 적이 몇이든지간에 한번에 덤벼 보시지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/battle.ogg"},"상세확인":{"voiceline":"내 얼굴에 뭐가 묻어있기라도 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/detail.ogg"},"드랍 설명":{"voiceline":"비스마르크급 전함 - 비스마르크","voicelink":null},"의뢰 완료":{"voiceline":"……의뢰팀이 돌아온 모양이네. 내가 먼저 마중을 나갈게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/expedition.ogg"},"실망":{"voiceline":"혼자 있게 해 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/feeling1.ogg"},"낯섦":{"voiceline":"나, 그렇게 쉽게 기뻐하지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/feeling2.ogg"},"호감":{"voiceline":"당신, 괜찮은 지휘관이네…뭐? 내가 칭찬하는 게 그렇게 이상해?......너무 하나하나 반응하지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/feeling3.ogg"},"기쁨":{"voiceline":"뭘 그렇게 쳐다보는 거야? 내 얼굴에 뭐 묻었어? 예쁘다고?......고, 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/feeling4.ogg"},"사랑":{"voiceline":"난 감정 표현이 서툴지만, 그래도……당신이 알아줬으면 좋겠어. 당신이 곁에 있어 주면 내가 행복하다는 걸……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어, 잠깐 쉬어도 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/home.ogg"},"hp 경고":{"voiceline":"다들…..내 뒤에 숨어 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/hp_warning.ogg"},"로그인":{"voiceline":"당신에게는 기대가 커.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/login.ogg"},"실패":{"voiceline":"내 자존심을 상처입힌 죄는…다음 번에 목숨으로 받겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/lose.ogg"},"우편":{"voiceline":"새로운 메일은 최대한 빨리 확인하도록 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/mail.ogg"},"임무":{"voiceline":"임무도 제대로 수행하지 못하는 인간에게 전장에 나갈 자격은 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/mission.ogg"},"임무완료":{"voiceline":"임무의 보수는 필수한 것이다. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405010/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 이럴 때 어떤 표정을 지어야 할 지 모르겠어. …웃으면……되는 거야?","voicelink":"https://raw.githubu