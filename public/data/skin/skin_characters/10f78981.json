9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70638,"상점 카테고리 id":17,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"KMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":405013,"클뜯 함순이 id":40501,"함순이 이름":"비스마르크","한글 함순이 + 스킨 이름":"언팩드 서프라이즈","영문 함순이 + 스킨 이름":"Unpacked Surprise","스킨 타입":"Christmas","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405013/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405013/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405013/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405013/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405013/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/405013/shipyard.png","설명":"지, 지휘관…? 그래, 보는 것처럼 크리스마스 서프라이즈를 준비하던 중이었는데…… 들켰으니 이미 실패했네. …이럴 때는 메리 크리스마스라고 하면 되려나?","자기소개":null,"메인1":{"voiceline":"확실히 조금 술이 들어간 상태이기는 해. 이런 걸 하는 건 처음이고… 알코올의 힘을 빌리면 이렇게… 더 솔직해지고 용기가 생기니까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/main1.ogg"},"메인2":{"voiceline":"널 깜짝 놀라게 해 줄 절호의 기회였는데… 소리가 나지 않게 조심했더라면, 분명 다른 전개를 맞이할 수 있었을 텐데 말이지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/main2.ogg"},"메인3":{"voiceline":"이 모습이 신경 쓰여? 그래… 마음에 든다면 「선물」로서는 성공했네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"왜 이러기로 했는지 궁금하다고? 말로는 감정 표현이 서투니까, 행동으로 마음을 전하는 편이 좋을 거라고 오이겐이 조언해 줘서… 그 말에 따른 것뿐이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/detail.ogg"},"드랍 설명":{"voiceline":"지, 지휘관…? 그래, 보는 것처럼 크리스마스 서프라이즈를 준비하던 중이었는데…… 들켰으니 이미 실패했네. …이럴 때는 메리 크리스마스라고 하면 되려나?","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀을 맞이하는 건 지휘관에게 맡길게. 이런 모습으로는 도저히…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"사실 오이겐의 제안으로 저지른 일이기는 하지만, 애정 표현을 행동으로 어떻게 보여줄지 꽤 고민했어. 안타깝게도 결국은 실패로 끝났지만…… 잠깐 눈 좀 감아줄래? (쪽) 이제 됐어. Frohe Weihnachten(메리 크리스마스).","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/feeling5.ogg"},"터치3":{"voiceline":"머리를 묶어준 답례로… 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/headtouch.ogg"},"모항귀환":{"voiceline":"고생 많았어, 지휘관. 잠깐 쉰 다음에 나 좀 도와줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"네 눈앞에서 「선물」을 포장하는 건… 그래도 좀 너무 이상하지 않을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/login.ogg"},"실패":null,"우편":{"voiceline":"우편이랑 엽서가 같이 왔어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/mail.ogg"},"임무":{"voiceline":"처리해야 할 임무가 남아있으면 나한테도 나눠줘. 어서 처리해야 그만큼 오래 휴일을 즐길 수 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/mission.ogg"},"임무완료":{"voiceline":"뭐랄까… 이번 보상은 평소보다 호화로운 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"선물 포장 푸는 거 도와줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/touch.ogg"},"터치2":{"voiceline":"「선물」로서는 조금 애매해졌지만, 네가 마음에 든다면…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/touch2.ogg"},"입수시":{"voiceline":"지, 지휘관…? 그래, 보는 것처럼 크리스마스 서프라이즈를 준비하던 중이었는데…… 들켰으니 이미 실패했네. …이럴 때는 메리 크리스마스라고 하면 되려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/405013/unlock.ogg"},"강화성