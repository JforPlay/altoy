[{"클뜯 id":107010,"클뜯 함순이 id":10701,"함순이 이름":"랭글리","한글 함순이 + 스킨 이름":"랭글리","영문 함순이 + 스킨 이름":"Langley","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107010/shipyard.png","설명":"랭글리급 항공모함·랭글리 (CV-1)","자기소개":{"voiceline":"크흠! 저는 이글 유니온 최초의~ 최·초·의 항공모함·랭글리예요! 전투능력은 아쉽지만, 훌륭한 파일럿을 수 없이 배출해냈어요! 이글 유니온의 항공모함의 역사는 바로 저로부터 시작되는 거라구요! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/profile.ogg"},"메인1":{"voiceline":"지휘관! 좀, 더 잘할 수 있는데, 어째서 성실하게 임하지 않는 거죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/main1.ogg"},"메인2":{"voiceline":"이대로라면 함대는 아무것도 변하는 게 없을 거예요! 지휘관도 조금은 노력해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/main2.ogg"},"메인3":{"voiceline":"지휘관? 제 얘기 제대로 듣고 계신 건가요? 분필 던질 거예요~! 랭글리는 말을 듣지 않는 사람을 가장 싫어한다구요! 흥!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/main3.ogg"},"전투개시":{"voiceline":"공부의 성과를 보여줄 찬스에요. 확실히 하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/battle.ogg"},"상세확인":{"voiceline":"지휘관, 아까부터 절 빤히 보고 계시는데, 제 질문엔 뭐라고 대답할 생각이신지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/detail.ogg"},"드랍 설명":{"voiceline":"랭글리급 항공모함·랭글리 (CV-1)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 반의 아이들이 돌아왔어요. 자, 성과를 체크하겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/expedition.ogg"},"실망":{"voiceline":"저라도 가르칠 방도가 없는 학생이 있을 줄은… 그만두는 편이 더 낫겠어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/feeling1.ogg"},"낯섦":{"voiceline":"뭘 그리 두리번거리고 있나요!? 보충은 성실하게 받으세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/feeling2.ogg"},"호감":{"voiceline":"최근엔 좀 나아지고 있네요── 에? 제 덕분이라고요? 아, 우으… 벼, 별말씀을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/feeling3.ogg"},"기쁨":{"voiceline":"가르칠 것은 이제 아무것도 없어요── 에? 저에 대해서도 가르쳐 달라고요? 바, 바보오… 우으…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/feeling4.ogg"},"사랑":{"voiceline":"랭글리 선생님은 공과 사를 혼동하지 않아요! 사이가 좋아진다고 너그러이 봐줄 거라 생각하면 큰 오산이에요! …사, 사적인 일이라면 괜찮지만요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 어딜 가시는 거죠? 다음은 반성회라구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 오늘도 전력으로 당신을 보좌하겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/login.ogg"},"실패":{"voiceline":"으으… 교사 실격이에요… 귀환하고 급탄 임무로 다시 돌아갈까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/lose.ogg"},"우편":{"voiceline":"정기적으로 우편함을 체크하는 건 좋은 습관 중 하나라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/mail.ogg"},"임무":{"voiceline":"크흠… 오늘 숙제 임무는 제대로 해 왔나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/mission.ogg"},"임무완료":{"voiceline":"노력한 보상이 내려왔어요. 다음에도 열심히 하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/mission_complete.ogg"},"서약":{"voiceline":"사적인 부분에서조차 칠칠치 못한 게 아닐까 걱정되었지만… 앞으로는 랭글리 선생님이 당신의 생활도 바로잡아 주겠어요! 도망칠 생각은 하지 말아주세요, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/propose.ogg"},"스킬":{"voiceline":"지휘관, 제 움직임을 자─알 보세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/skill.ogg"},"터치1":{"voiceline":"애 취급하지 말아 주세요~! 저는 선생님이라구요! 선·생·니·임!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/touch.ogg"},"터치2":{"voiceline":"헌병입니까. 네, 예의 그 장소에 예의 그 사람이…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/touch2.ogg"},"입수시":{"voiceline":"당신을 보좌하기 위해 새롭게 파견된 랭글리에요. 아시겠어요? 당신의 단점을 철저히 뜯어고쳐서, 함대 운영을 다시 본래 궤도로 올려 보이겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/unlock.ogg"},"강화성공":{"voiceline":"강해지고도, 자신이 왜 강해졌는지를 모르면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"여러분, 알겠나요? 지금부터는 이 페이스로 갈 거라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"N","ex_chat_status":0},{"클뜯 id":107019,"클뜯 함순이 id":10701,"함순이 이름":"랭글리","한글 함순이 + 스킨 이름":"랭글리·改","영문 함순이 + 스킨 이름":"Langley (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107019/painting.png","확대 일러"