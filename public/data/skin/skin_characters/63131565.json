g"},"메인3":{"voiceline":"그러고 보니, 제 머리위에 앉아 있는 아이를 제가 이름으로 부른 적이 있었던가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301622/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"하마카제는 접객, 저는 청소를 담당하고 있어요. 둘이서만 하는 건 아니에요. 도와주는 아이들이 많아서, 음식점도 잘 돌아가고 있어요. 지휘관 씨가 볼 때는 어떤 거 같아요? …잘 돌아가고 있는 거 맞죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301622/detail.ogg"},"드랍 설명":{"voiceline":"지휘관 씨, 전 지금 청소 중이에요. 그쪽 바닥은 미끄러우니까 쉽게 넘어질 수… 꺄!… 아야야, 넘어진 건 저 자신이네요…… 쉽게 넘어질 수 있는 건 사실 이쪽 바닥인 것 같네요, 아하하……","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관 씨, 어서 오세요! 언제 누가 오더라도 깨끗한 환경에서 맞이할 수 있도록 신경을 쓰고 있답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301622/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어때요? 꽤 깨끗해졌죠? 아… 양동이가?! (철퍼덕) …흐흑, 또 청소를 처음부터 다시 해야 해요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301622/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관 씨도 도와주시려구요? 그럼, 이 빗자루를 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301622/touch.ogg"},"터치2":{"voiceline":"꺅! 양동이를 뒤엎을뻔 했잖아요! 정말~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301622/touch2.ogg"},"입수시":{"voiceline":"지휘관 씨, 전 지금 청소 중이에요. 그쪽 바닥은 미끄러우니까 쉽게 넘어질 수… 꺄!… 아야야, 넘어진 건 저 자신이네요…… 쉽게 넘어질 수 있는 건 사실 이쪽 바닥인 것 같네요, 아하하……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301622/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인