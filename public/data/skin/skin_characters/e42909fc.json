https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101254/battle.ogg"},"상세확인":{"voiceline":"뭐, 뭘 생각하는 거야! 난 크리스마스 선물이 되고 싶은 마음 추호도 없거든! ...저, 정말로 뭘 선물하면 좋을지 도저히 생각이 나지 않는 이상은, 절대...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101254/detail.ogg"},"드랍 설명":{"voiceline":"이, 이게 무슨 \"깜짝 크리스마스\"야! 역시 심즈 말을 듣는 게 아니었어... 너, 너 멍하니 뭐하는 거야? 얼른 내 손에 리본이나 풀어줘!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"왜 나를 선물 상자 안에 혼자 남겨둔 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101254/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"손이 묶여있어도, 혼자 앉을 수 있어! 으으으읍——! ...하아, 아, 안되겠다... 어, 얼른 도와줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101254/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"너, 너무 가깝잖아 멍청아! ... 머, 멀리 떨어지라고는 안했어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101254/touch.ogg"},"터치2":{"voiceline":"설마 이 틈을 타서... 절대 용서하지 않을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101254/touch2.ogg"},"입수시":{"voiceline":"이, 이게 무슨 \"깜짝 크리스마스\"야! 역시 심즈 말을 듣는 게 아니었어... 너, 너 멍하니 뭐하는 거야? 얼른 내 손에 리본이나 풀어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101254/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"크리스마스","상점 id":70456,"상점 카테고리 id":1,"스킨 태그":"특수배경 (움짤)","입수 영상":"X","재화":800,"기간":"상시","진영":"USS","레어도":"R","ex_chat_status":0},{"클뜯 id":101255,"클뜯 함순이 id":10125,"함순이 이름":"허먼","한글 함순이 + 스킨 이름":"Blushing Fellow","영문 함순이 + 스킨 이름":"Blushing Fellow","스킨 타입":"Race Queen","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101255/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101255/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101255/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101255/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101255/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101255/shipyard.png","설명":"어, 어째서 허먼이 이런 모습으로 지휘관을 응원해야 하는 건데… 꼭 이런 옷을 입어야 해…? 으으, 부끄럽지만… 그렇다고 도망치면 심즈랑 다른 함선들이 놀릴 텐데, 어떡하지… 으아?! 지, 지휘관?!","자기소개":null,"메인1":{"voiceline":"수영복도 아닌데 배를 다 드러내놓고… 지, 지휘관! 이거 진짜 응원하려고 입는 옷 맞아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/main1.ogg"},"메인2":{"voiceline":"사진은 금지야! 절대 안 돼! 허먼의 이런 모습을 사진으로 남기면 너무 부끄러워서 기절할 거야! …그럼, 동영상으로 남기겠다고? 그게 그거잖아!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/main2.ogg"},"메인3":{"voiceline":"포즈…? 이, 이렇게? 역시 부끄러워하는 포즈 쪽이 더 좋다고…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/main3.ogg"},"전투개시":{"voiceline":"허, 허먼이 해치워 줄게!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/battle.ogg"},"상세확인":{"voiceline":"겨, 경기하느라 수고했어… 그래도 허먼이 응원해 주고 있는데 격려 한 마디라도 건네주지 그래! 이러고 밖으로 나가는 건 아무래도 너무 부끄러워서 무리지만…… 지, 지금 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/detail.ogg"},"드랍 설명":{"voiceline":"어, 어째서 허먼이 이런 모습으로 지휘관을 응원해야 하는 건데… 꼭 이런 옷을 입어야 해…? 으으, 부끄럽지만… 그렇다고 도망치면 심즈랑 다른 함선들이 놀릴 텐데, 어떡하지… 으아?! 지, 지휘관?!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어! 가, 같이 가주진 않을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"따, 딱히 허먼은 무리하고 있지도 않고, 억지로 하는 것도 아니야! 지휘관이 기뻐할 것 같아서 열심히 하는 거니까 제대로 칭찬해 줘! 귀, 귀엽고 잘 어울린다고…? 거거거거거짓말 하지 마!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어, 어서 와… 허먼이 마중 나와서 불만이야?! 좀 더 평범하게 인사할 순 없냐고…? 허, 허먼한테 뭘 시키려는 거야! 이 변태!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어어어어어딜 보는 거야! 이쪽으로 고개 돌리지 마! 우, 우산으로 때린다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"빨리 미션을… 허먼이 아니라 미션을 보라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"허, 허먼한테 여기서 뭘 더 시키려고…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/touch.ogg"},"터치2":{"voiceline":"여, 역시 이럴 속셈으로 일부러 허먼한테 이런 옷 입힌 거지?! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/touch2.ogg"},"입수시":{"voiceline":"어, 어째서 허먼이 이런 모습으로 지휘관을 응원해야 하는 건데… 꼭 이런 옷을 입어야 해…? 으으, 부끄럽지만… 그렇다고 도망치면 심즈랑 다른 함선들이 놀릴 텐데, 어떡하지… 으아?! 지, 지휘관?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"허먼이 MVP?! 신난다! …따, 딱히 흥분한 거 아니거든?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101255/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그