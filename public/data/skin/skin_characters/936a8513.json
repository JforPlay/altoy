[{"클뜯 id":9600010,"클뜯 함순이 id":960001,"함순이 이름":"로열 포춘","한글 함순이 + 스킨 이름":"로열 포춘","영문 함순이 + 스킨 이름":"Royal Fortune","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600010/shipyard.png","설명":"해적선 - 로열 포춘","자기소개":{"voiceline":"내 과거? 음~ 이야기에 나오는 해적처럼 나쁜 사람이었고, 맘에 안 드는 녀석들은 괴롭히고, 똑같은 생활이 이틀 이상 계속되지 않는 나날을 보냈지. 그러다 만만치 않은 녀석이랑 마주쳐서 게임 오버~ 참 운이 없었지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/profile.ogg"},"메인1":{"voiceline":"영화! 게임! 요즘 세상의 오락 거리는 정말 최고야! 바다에 나가지 않더라도 지루할 틈이 없다니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/main1.ogg"},"메인2":{"voiceline":"도박이라는 건 결국 운이 누구 편을 들어주냐는 것뿐이야. 거기엔 승자도 패자도 없어. 운이 좋니 나쁘니 착각하는 머리 나쁜 녀석들이나 휘둘리지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/main2.ogg"},"메인3":{"voiceline":"해적에게는 그 나름의 규칙이란 게 있어. 그렇지 않으면 체면이 안 설테니. 말이 나와서 말인데, 지휘관네 규칙은 뭐야~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/main3.ogg"},"전투개시":{"voiceline":"돌격~! 보물은 가장 빠른 사람 차지라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/battle.ogg"},"상세확인":{"voiceline":"자자, 착한 아이들은 잘 시간이야. 해적 이야기는 또 다음에 들려줄게. 응? 지휘관도 관심 있어? 방금 것도 괜찮긴 하지만, 지휘관한테 들려줄 거면 역시 '성인'용 이야기가 더 낫겠지~ 하하하하♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 로열 포춘","voicelink":null},"의뢰 완료":{"voiceline":"성과물을 가득 싣고 의뢰팀이 돌아왔어! 분류 작업을 기다리고 있을테니 어서 가봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/expedition.ogg"},"실망":{"voiceline":"하아… 예전같으면 쿨하게 상어밥으로 주던가, 무인도에 버리고 가는 외톨이형에 처했을 텐데 말이지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/feeling1.ogg"},"낯섦":{"voiceline":"지금 이 순간을 산다는 건, 지금 자신이 즐거운 걸 하고, 고민이나 거리낌은 버리라는 거야! …그렇다고 다른 사람 걸 멋대로 뺏으면 안 된다고? 쳇, 시시해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/feeling2.ogg"},"호감":{"voiceline":"해적의 보물에 눈이 먼 사람들은 아직도 많이 있어. 뭐, 반짝이는 금은보화로 가득한 보물상자의 유혹에 넘어가지 않는 인간은 그리 많지 않지만 말이야… 응? 그런 보물이 어디있냐고? 땡! 반칙은 안 돼. 보물은~ 온전히 자기 힘으로 찾아야지~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/feeling3.ogg"},"기쁨":{"voiceline":"…지휘관, 같이 바다로 나와준 거, 혹시 보물 찾으려고 그런 건 아니지? 단순히 자극을 추구하는 걸로도 안 보이는데… 설마, 굳이 날 위해서? 꺄아~ 정말 그런 거려나~ …헉, 왜 반박 안 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/feeling4.ogg"},"사랑":{"voiceline":"목적지를 못 정했으면 이 로열 포춘이 대신 정해줄까? 예를 들면… 요즘 해적의 보물이 있다는 소문이 돌고 있는 무인도라던가? 에헤헤, 괜찮아 괜찮아. 최악의 상황에는 둘이서 무인도를 떠도는 것도 나쁘지 않잖아? 가자 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/feeling5.ogg"},"터치3":{"voiceline":"아, 멋대로 모자 만지는 거, 좀 거슬리는데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와! 뭐 재미있는 일 없었어? 폭풍 속에서 상어에게 쫓기다가, 파도에 휩쓸려 탈출했다던가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/home.ogg"},"hp 경고":{"voiceline":"행운의 여신이 누구 편을 들어줄지, 어디 한 번 보자고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/hp_warning.ogg"},"로그인":{"voiceline":"아하하하, 지휘관. 이제야 돌아왔네~ 빨리 일 마무리 하라구. 그런 다음 우리 같이 모험을 떠나는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/login.ogg"},"실패":{"voiceline":"정말! 제비 같은 건 질색이야! 어디로든 사라져버려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/lose.ogg"},"우편":{"voiceline":"우편? 아하, 지명수배 같은 거 아니야? 지휘관이 지명수배 당하면 현상금은 어느 정도려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/mail.ogg"},"임무":{"voiceline":"새로운 임무? 어디 보자… 조금 리스크는 크지만, 그만큼 보상도 괜찮네… 좋았어, 이걸로 결정이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/mission.ogg"},"임무완료":{"voiceline":"임무를 완료했어! 그러고 보니 비서함인 내 몫은 어느 정도야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/mission_complete.ogg"},"서약":{"voiceline":"그… 정말 괜찮은 거지? 나랑 같이 있는 건 꽤 힘들텐데? 나중에 무르기 없기다? …그럼… 자, 내 손을 잡고 반지를 끼워줘. 그리고 내 배를 타고 출항하는 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/propose.ogg"},"스킬":{"voiceline":"한 번에 날려주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/skill.ogg"},"터치1":{"voiceline":"하하하, 지루한 서류 작업에 질려서 외출이라도 하고 싶어진 거야? 언제든 어울려줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/touch.ogg"},"터치2":{"voiceline":"독 먹고 깨꼬닥, 칼로 푹찍푹찍, 바다에 빠져서 꼬르르륵… 자~ 어떤 걸로 할래?♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/touch2.ogg"},"입수시":{"voiceline":"수수께끼로 가득한 귀엽고 매력적인 로열 포춘, 지금 도착했어! …어머? 놀랐어? 신경 쓰지마, 신경 쓰지마～ 그래서 우리 이제 어디 가는 거야? 전설 속의 보물이 묻혀있는 해안가? 아니면 잔해가 수북한 암초? 어디든 좋으니까 아무튼 일단 돛을 올리고 출발하자고~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/unlock.ogg"},"강화성공":{"voiceline":"강해졌으니까, 두근두근 설레는 모험길에 나서자구~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"에헴, 맘에 안 드는 녀석들은 모두 상어 밥이다!","voicelink":"https