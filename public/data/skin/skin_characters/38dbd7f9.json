[{"클뜯 id":407010,"클뜯 함순이 id":40701,"함순이 이름":"그라프 체펠린","한글 함순이 + 스킨 이름":"그라프 체펠린","영문 함순이 + 스킨 이름":"Graf Zeppelin","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/407010/shipyard.png","설명":"항공모함 그라프 체펠린","자기소개":{"voiceline":"나는 체펠린……이 이름은 버려도 상관없지만, 부르기 쉽다면 날 이렇게 불러라. …소원 말인가, 세계를 멸하는 것이다……허나 지금은, 경의 부름에 응하도록 하지. 경은 이제 우리 전군의 일부가 되었으니 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/profile.ogg"},"메인1":{"voiceline":"높은 곳은 좋아한다. 모든 걸 내려다보며, 모든 것의 파멸을 눈에 담을 수 있으니 말이지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/main1.ogg"},"메인2":{"voiceline":"잃어버려도 되찾을 수 있는 건……처음부터 존재해선 안 된다. 그렇지 않나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/main2.ogg"},"메인3":{"voiceline":"인생이 결국 나눠 받은 카드로 게임을 하는 것뿐이라면, 더욱 게임 그 자체를 부숴버리고 싶어지진 않나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/main3.ogg"},"전투개시":{"voiceline":"그럼 시작하지, 우리의 파괴를","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/battle.ogg"},"상세확인":{"voiceline":"만약 신이 있다면, 그 녀석부터 묻어버리도록 하지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/detail.ogg"},"드랍 설명":{"voiceline":"항공모함 그라프 체펠린","voicelink":null},"의뢰 완료":{"voiceline":"돌아왔나……흥, 항구에서 기뻐하고 있는 것 같군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/expedition.ogg"},"실망":{"voiceline":"경은 아니란 건가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/feeling1.ogg"},"낯섦":{"voiceline":"아아…이 얼마나 감미로운…하지만 감미로운 것은 단명하는 법…영원히 살아갈 수 있는 건 그저 차가운 증오뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/feeling2.ogg"},"호감":{"voiceline":"신을 향한 기도는 과연 의미가 있는가? 신이 대답해주는가? Nein, 신은 자비가 없기에 신이 될 수 있는 거다. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/feeling3.ogg"},"기쁨":{"voiceline":"운명을 믿을 생각은 없지만, 경과의 만남이 운명이라면……흥, 아이러니하군. 최악의 과거와 최선의 미래를 동시에 주다니……그럼 내 증오는 과연 어떤 의미를 갖게 되는 걸까……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/feeling4.ogg"},"사랑":{"voiceline":"경이 있는 세상이라면 그리 시시하고 증오스럽지만은 않겠지. 안심하도록. 경이 세상의 적이 된다 해도, 내가 경의 편에 설 것이다. 오히려, 그날이 오길 기대하고 있다고. 후후후……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"경들의 싸움도, 발버둥도, 전부 종언의 양식이 될 뿐…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/home.ogg"},"hp 경고":{"voiceline":"철과 피의 냄새……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/hp_warning.ogg"},"로그인":{"voiceline":"검은 산양의 뿔피리는 이미 울려 퍼지고 있다. 초조해할 거 없어, 신중히 기다리는 게 좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/login.ogg"},"실패":{"voiceline":"다음에야말로 죽음보다 깊은 절망을 맛보게 해주지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/lose.ogg"},"우편":{"voiceline":"사람과 접하는 시간을 소중히 하는 게 좋아. 이제 그럴 시간도 없어질 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/mail.ogg"},"임무":{"voiceline":"임무를 주는 자가, 과연 경이 진정 노력을 바칠 만한 존재일까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/mission.ogg"},"임무완료":{"voiceline":"임무의 보수……받아 두도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/mission_complete.ogg"},"서약":{"voiceline":"흠? 경은 드디어 세상의 적이 될 결심을 한 것인가……뭐…? 나와 함께 하고 싶을 뿐, 이란 건가. 뭐 좋아, 우리 앞을 가로막는 모든 것들을 없애버린다. 그것 또한 재미있겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/propose.ogg"},"스킬":{"voiceline":"끝이다……Funebre!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/skill.ogg"},"터치1":{"voiceline":"증오한다, 모든 것을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/touch.ogg"},"터치2":{"voiceline":"후후후…과연 내가 선택한 자……좋은 배짱이군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/touch2.ogg"},"입수시":{"voiceline":"지휘관인가……나의 이름은 체펠린. 자, 조건이 모두 갖추어졌다. 그럼 막을 열도록 하지…… 종언의 교향곡을.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/unlock.ogg"},"강화성공":{"voiceline":"흥, 힘만으로 모든 게 정해진다면 좋으련만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"적에게 걸맞은 곳은 무덤밖에 없으리니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/407010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":407011,"클뜯 함순이 id":40701,"함순이 이름":"그라프 체펠린","한글 함순이 + 스킨 이름":"모래사장