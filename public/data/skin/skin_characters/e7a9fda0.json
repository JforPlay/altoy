[{"클뜯 id":303070,"클뜯 함순이 id":30307,"함순이 이름":"묘코","한글 함순이 + 스킨 이름":"묘코","영문 함순이 + 스킨 이름":"Myoukou","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303070/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303070/shipyard.png","설명":"묘코형 중순양함 1번함·묘코","자기소개":{"voiceline":"사쿠라 엠파이어 함대·묘코형 중순양함 묘코다. 영광스러운 자바 해전에도, 굴욕적인 레이테만 해전에도 참가했다. 그 뒤, 어뢰를 맞고, 잠수함의 추격을 뿌리치며 남방에서 종전을 맞이했지만, 이렇게 된 것이 행운이었는지 불행이었는지는 사람마다 다르게 평가하고 있다. 지휘관, 혹시 고민거리가 있으면 언제라도 말을 걸어줘. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/profile.ogg"},"메인1":{"voiceline":"하츠카제… 기회가 있다면 다시 한번 그 아이를 쓰다듬어주고 싶군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/main1.ogg"},"메인2":{"voiceline":"살쪘다고!? 지휘관, 아무리 당신이라도 그런 이야기는…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/main2.ogg"},"메인3":{"voiceline":"버걸!? 하, 하아… 그 아이 이야기가 아니었나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/main3.ogg"},"전투개시":{"voiceline":"훈련의 성과를 보여줄 때다! 포격전, 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/battle.ogg"},"상세확인":{"voiceline":"지휘관, 충분한 정보는 승리의 주춧돌이 된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/detail.ogg"},"드랍 설명":{"voiceline":"묘코형 중순양함 1번함·묘코","voicelink":null},"의뢰 완료":{"voiceline":"의뢰를 끝마친 것 같군. 모두, 제대로 성실하게 하고 있나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/expedition.ogg"},"실망":{"voiceline":"지휘관, 지나치게 해이해져 있군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/feeling1.ogg"},"낯섦":{"voiceline":"해전에서는, 소수가 다수를 이기는 경우가 결코 드문 일이 아니다. 전황은 순간의 선택으로 정해질 수 있지. 때문에 올바른 판단을 뒷받침할 역량으로써 평소의 훈련이 중요한 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/feeling2.ogg"},"호감":{"voiceline":"지휘관, 좀 쉬도록 하지. 체력이 떨어지면 일의 효율도 떨어진다. 무릎베개…? 난 상관없지만, 이걸로 정말 체력을 회복할 수 있는 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/feeling3.ogg"},"기쁨":{"voiceline":"방에 불이 켜져 있길래 와봤더니, 아직도 일을 하고 있었을 줄은! 정말이지, 터무니없음에도 정도가 있지! 지휘관이 침대에 누워 잠들 때까지 여기서 떠나지 않겠다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 아아, 그 서류는 전부 대응해 뒀다. 좋아, 이걸로 일은 일단락되었군. 도시락을 싸 왔으니 같이 먹자… 어떤가? 입에 맞나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/feeling5.ogg"},"터치3":{"voiceline":"…이런 건 구축함 애들에게나 해 주도록.","voicelink":null},"모항귀환":{"voiceline":"마음을 놓기엔 아직 이르다. 피곤하다면 이 수제 영양 드링크를 마셔라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"갓 구운 수제 팬케이크다. 지휘관, 괜찮다면, 부디 먹어보도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/login.ogg"},"실패":{"voiceline":"훈련을 감독하는 내가 느슨해진 탓이다… 모두, 미안하다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/lose.ogg"},"우편":{"voiceline":"우편이다. 최신 훈련 일람인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/mail.ogg"},"임무":{"voiceline":"임무라면, 내게 맡겨줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/mission.ogg"},"임무완료":{"voiceline":"고작 임무 하나 했다고 해서, 머물러 있지 마라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 당신의 몸은 더 이상 당신만의 것이 아니다. 그러니까… 아무쪼록, 자중해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/propose.ogg"},"스킬":{"voiceline":"지금 네 눈에 비치고 있는 마지막 풍경을 깊이 새겨두는 게 좋을 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/skill.ogg"},"터치1":{"voiceline":"지금 구축함들이 훈련하는 걸 보고 있다. 급한 용무가 아니라면 나중에 해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/touch.ogg"},"터치2":{"voiceline":"…지휘관, 자중해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/touch2.ogg"},"입수시":{"voiceline":"묘코형 중순양함 1번함, 묘코다. 지휘관, 내가 도움이 될 수 있는 일은 없나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/unlock.ogg"},"강화성공":{"voiceline":"이 정도 강화로 자만하거나 하진 않는다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"모두 하나가 되어 얻어낸 성과다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"R","ex_chat_status":0}]