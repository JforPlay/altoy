[{"클뜯 id":10800060,"클뜯 함순이 id":1080006,"함순이 이름":"아스카가와 치세","한글 함순이 + 스킨 이름":"아스카가와 치세","영문 함순이 + 스킨 이름":"Chise Asukagawa","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800060/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800060/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800060/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800060/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800060/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10800060/shipyard.png","설명":"우왓, 전혀 모르는 곳에 온 것 같은데…… 아, 저는 아스카가와 치세입니다! 당분간 신세를 지게 될 것 같네요, 잘 부탁합니다!","자기소개":{"voiceline":"아스카가와 치세, 여기선 항공모함으로 활약하고 있어요! 바다 위에서 싸우는 건 신선하기도 하고, 꽤 즐거워요! 여기 오기 전에 미리 팔토시를 방수되는 걸로 바꿔놓길 잘했네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/profile.ogg"},"메인1":{"voiceline":"흐음, 여기에도 학교는 있네요. 네? 다니고 싶냐구요? 아, 가급적이면 다니고 싶지 않은데…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/main1.ogg"},"메인2":{"voiceline":"앉아! 엎드려! 손! 아, 지휘관님, 이 지휘냥이라는 애들 엄청 똑똑하네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/main2.ogg"},"메인3":{"voiceline":"오, 지휘관님! 왠지 좀 피곤하신 것 같네……. 아까 사탕 샀는데 하나 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/main3.ogg"},"전투개시":{"voiceline":"저도 싸울 수 있다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/battle.ogg"},"상세확인":{"voiceline":"아, 지휘관님이시다! 지금 게임하고 있었는데, 무슨 일이세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/detail.ogg"},"드랍 설명":{"voiceline":"우왓, 전혀 모르는 곳에 온 것 같은데…… 아, 저는 아스카가와 치세입니다! 당분간 신세를 지게 될 것 같네요, 잘 부탁합니다!","voicelink":null},"의뢰 완료":{"voiceline":"앗, 다들 돌아온 것 같아요! 선물이라도 사가지고 왔으려나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/expedition.ogg"},"실망":{"voiceline":"저, 지휘관님 같은 사람만은 되고 싶지 않네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/feeling1.ogg"},"낯섦":{"voiceline":"이 팔토시 밑에는 뭐가 있냐구요? 당연히 비밀이죠~! 아, 제가 자고 있을 때 몰래 들춰보면 화낼 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/feeling2.ogg"},"호감":{"voiceline":"이 의장을 보면 네가 떠올라. 잘 지내고 있을까. 세상에서 가장 멋진, 내 친구…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 오늘도 바쁘신 것 같네요. 아, 그래. 제가 일 좀 도와 드려봐도 될까요? 아주 조금 정도면 저도 할 수 있을 것 같은데~.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/feeling4.ogg"},"사랑":{"voiceline":"지휘관님은 제가 이 세상에 온 이후로 처음으로 생긴 친구예요! 항상 여기저기 데려가 주셔서 고마워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/feeling5.ogg"},"터치3":{"voiceline":"왜, 왠지 좀 부끄럽네요~…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/headtouch.ogg"},"모항귀환":{"voiceline":"출격 수고 많으셨습니다! 다음에는 저도 데려가 주세요! 계속 벤치 신세여도 괜찮으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/home.ogg"},"hp 경고":{"voiceline":"지금부터가 진짜라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 왠지 좀 졸려 보이네요. 이제 업무 시작해야 하니까, 빨리 일어나요~.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/login.ogg"},"실패":{"voiceline":"으아아아! 거짓말 거짓말 거짓말! 역시 내겐 무리였던 건가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/lose.ogg"},"우편":{"voiceline":"지휘관님, 편지 왔어요! 설마, 애인한테 온 거 아니에요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/mail.ogg"},"임무":{"voiceline":"나머지 임무는 제가 대신 처리해드릴까요?! ……라고 말할 수 있었으면 좋겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/mission.ogg"},"임무완료":{"voiceline":"임무 완료네요! 그나저나 이거, 시급 얼마였죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/mission_complete.ogg"},"서약":{"voiceline":"이 세상에 와서, 동료들과 같이 싸울 수 있어서 저, 엄청 즐거워요! 이것도 다 지휘관님 덕분이니까……. 정말로 정말, 감사드려요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/propose.ogg"},"스킬":{"voiceline":"타올라라! 골드번!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/skill.ogg"},"터치1":{"voiceline":"와아, 지휘관님은 맨날 쉬지도 않고 일하시고 대단해요. 이게 바로 직장인이라는 건가…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/touch.ogg"},"터치2":{"voiceline":"헐……. 그런 취미가 있으실 줄이야…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/touch2.ogg"},"입수시":{"voiceline":"우왓, 전혀 모르는 곳에 온 것 같은데…… 아, 저는 아스카가와 치세입니다! 당분간 신세를 지게 될 것 같네요, 잘 부탁합니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/unlock.ogg"},"강화성공":{"voiceline":"파워업했네요! 고맙습니다, 지휘관 님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/upgrade.ogg"},"vote":null,"승리":{"voiceline":"해냈다, 해냈어! 제 승리에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/win_mvp.ogg"},"전투개시_ex":{"voiceline":"여러분, 다녀올게요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관님! 어디 재밌는 데라도 데려가 주세요~! 방에서 TV만 보는 건 질렸다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"어라, 지휘관님. 왜 그런 얼굴로……. 혹시 고민이라도 있는 거예요? 저라도 괜찮다면 말씀해보세요. 그래도 우린 친구잖아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"오~, 오늘은 확실히 깨어 계시네요! 역시 지휘관님이십니다~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"후딱 임무 끝내고, 같이 어디 놀러가요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/mission_ex.ogg"},"임무완료_ex":{"voiceline":"지휘관니~임! 임무를 끝냈더니 뭐가 많이 와 있어요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"뭐, 뭐 하시는 거예요, 지휘관님. 경찰 부를 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"지휘관니~임! 방금, 보셨어요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['미나미 유메'] : 맡겨만 주세요, 미나미 씨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/couple_encourage1.ogg"},{"voiceline":"['무지나'] : 어제의 적은 오늘의 친구네요, 무지나 씨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/couple_encourage2.ogg"},{"voiceline":"['신죠 아카네'] : 저 멋지죠? 신죠 씨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"이 집무실, 물건이 많은데도 엄청 깨끗하네요. 청소같은 건 누가 하는 거예요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10800060/main5_ex.ogg"},"메인6_ex":{"voiceline":"