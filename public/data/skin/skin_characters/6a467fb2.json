[{"클뜯 id":10100040,"클뜯 함순이 id":1010004,"함순이 이름":"벨(콜라보)","한글 함순이 + 스킨 이름":"벨(콜라보)","영문 함순이 + 스킨 이름":"Vert","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/10100040/shipyard.png","설명":"저는 린 박스의 여신, 벨이라고 합니다. 슈팅 게임도 특기니까, 맡겨두세요!","자기소개":{"voiceline":"저는 린 박스의 여신, 벨이라고 합니다. 좋아하는 건 홍차와 게임, 그리고 귀여운 여동생들이에요! …네? 여동생 같은 거 없지 않냐고요? 제가 여동생이라 인정하면 여동생인 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/profile.ogg"},"메인1":{"voiceline":"우후훗, 지휘관 씨는 제가 지켜 드리도록 하지요. 마음 푹~ 놓아주셔요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/main1.ogg"},"메인2":{"voiceline":"앗?! 저 아이, 저 아이는 대체 누군가요? 제발, 부디 저의 여동생이 되어주세요~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/main2.ogg"},"메인3":{"voiceline":"귀여운 아이가 잔뜩 있어, 전 정말로 기쁘답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/main3.ogg"},"전투개시":{"voiceline":"지휘관 씨, 준비는 되셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/battle.ogg"},"상세확인":{"voiceline":"우후훗, 제게 무슨 용무라도?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/detail.ogg"},"드랍 설명":{"voiceline":"저는 린 박스의 여신, 벨이라고 합니다. 슈팅 게임도 특기니까, 맡겨두세요!","voicelink":null},"의뢰 완료":{"voiceline":"모두가 돌아온 모양이네요. 마중 나가도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/expedition.ogg"},"실망":{"voiceline":"이제 돌아가도 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/feeling1.ogg"},"낯섦":{"voiceline":"다음에 제가 플레이 하는 온라인 게임을 같이 안 할래요? 물론 하나부터 열까지 서포트 해드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/feeling2.ogg"},"호감":{"voiceline":"오늘은 온라인 게임의 정모를 열 생각입니다~ 지휘관 씨는 물론 참가하시겠죠? 참가자는 저와 지휘관 씨 2명으로 예정되어 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 씨, 잠깐 상담을 부탁드려도 될까요? 요즘 신경 쓰이는 분이 계신데, 어떻게 접근해야 좋을지… 아니, 역시 잊어주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/feeling4.ogg"},"사랑":{"voiceline":"지휘관 씨와 함께 있으면, 마음이 따뜻해진답니다. 네, 제가 좋아하는 홍차와도 같이 말이죠. 영원히 이 시간이 계속되었으면 좋겠다고 생각하지만, 제 욕심일까요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고하셨어요. 티타임을 갖도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/home.ogg"},"hp 경고":{"voiceline":"그렇게 나오셔야, 제 상대로 부족함이 없죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/hp_warning.ogg"},"로그인":{"voiceline":"안녕하세요. 마침 홍차를 끓이고 있었어요. 지휘관 씨도 함께 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/login.ogg"},"실패":{"voiceline":"이게 패배…… 그렇군요, 가슴이 북받칠 정도로 즐거운 전투였어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/lose.ogg"},"우편":{"voiceline":"우편이 온 모양이에요. 꼼꼼히 체크하자고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/mail.ogg"},"임무":{"voiceline":"지휘관 씨라면, 5분만 있어도 임무는 여유 있으시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/mission.ogg"},"임무완료":{"voiceline":"임무 완료에요! 보너스를 받으러 가자고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/mission_complete.ogg"},"서약":{"voiceline":"제가 끓이는 홍차를 매일 마시고 싶다니… 기뻐요. 기쁜 마음으로 지휘관 씨… 아니, 당신이 좋아하는 홍차를 끓여 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/propose.ogg"},"스킬":{"voiceline":"린 박스의 여신의 힘, 보여 드리도록 하죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/skill.ogg"},"터치1":{"voiceline":"후후, 지휘관 씨는 장난꾸러기네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/touch.ogg"},"터치2":{"voiceline":"여성에겐 상냥하게 대하지 않으면 미움받는답니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/touch2.ogg"},"입수시":{"voiceline":"저는 린 박스의 여신, 벨이라고 합니다. 슈팅 게임도 특기니까, 맡겨두세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/unlock.ogg"},"강화성공":{"voiceline":"더욱더 위를 목표로 나아갈게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"제 사전에 패배라는 단어는 없다고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['블랑'] : 독서에는 홍차가 딱이라고 생각하는데, 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/couple_encourage1.ogg"},{"voiceline":"['넵튠(콜라보)', '느와르', '블랑'] : 저희를 적으로 만든 걸 후회하게 해드리죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/10100040/couple_encourage2.ogg"},{"voiceline":"['USS'] : 돌아가면, 제가 안아 드릴게요!","voicelink":"https://raw.