[{"클뜯 id":9706030,"클뜯 함순이 id":970603,"함순이 이름":"프린스턴·META","한글 함순이 + 스킨 이름":"프린스턴·META","영문 함순이 + 스킨 이름":"Princeton META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9706030/shipyard.png","설명":"항공모함 프린스턴, 지금 막 착임했습니다. 죄송해요. 아직 좀 혼란스러워서… 지금 어떤 상황인지 설명을 부탁드려도 될까요?","자기소개":{"voiceline":"인디펜던스급 2번함인 프린스턴… 과거에는 ANTI-X에 몸담고 있었죠. 어쩌다 여기 오게 된 건지도 모르고, 아직 충분히 상황 파악도 못 했지만…… 지휘관님을 본 순간, 믿을 수 있는 사람이라는 건 알았어요. 그러니 당신 명령에 따를게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/profile.ogg"},"메인1":{"voiceline":"새, 새러토가?! 존경하는 선배님인 새러토가 씨를 그냥 이름으로 편하게 부르라니… 말도 안 돼요! 새러토가 '씨'라고 부를게요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/main1.ogg"},"메인2":{"voiceline":"장비를 더 업데이트하면 전장에서 더 많은 역할을 할 수 있겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/main2.ogg"},"메인3":{"voiceline":"지휘관님을 보좌하는 것이 바로 비서함의 임무죠. 뭐라도 도와드릴 거 없을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/main3.ogg"},"전투개시":{"voiceline":"항공모함 프린스턴, 행동 개시!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/battle.ogg"},"상세확인":{"voiceline":"‘세이렌‘… 그런 식으로 불리고 있군요. 게다가 서로 적대를… 죄송해요. 물어보면 안 될 걸 물어본 것 같군요. 아직 모르는 부분이 많아서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/detail.ogg"},"드랍 설명":{"voiceline":"항공모함 프린스턴 <color=#92fc63>(만약 해당 META 캐릭터를 이미 획득했다면, 보상이 상응하는 캐릭터 결정으로 전환되며, 「META 연구실」-「에너지 활성화」에서 사용할 수 있습니다.)</color>'","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 돌아온 모양이군요. 제가 도와드릴 건 없을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/expedition.ogg"},"실망":{"voiceline":"지휘관님, 어디 몸이라도 안 좋으신가요? 잠시 휴식을 취하시는 편이 좋을지도 모르겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/feeling1.ogg"},"낯섦":{"voiceline":"괜찮으시면 지휘관님이 아는 범위 내라도 괜찮으니 저에 관한 걸 알려주시겠어요? 부하로서 이런 걸 물어보면 안 될 수도 있지만, 아무래도 신경이 쓰여서요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/feeling2.ogg"},"호감":{"voiceline":"어떤 특별한 임무를 수행하러 향하고 있었는데, 동료들과 떨어져 묘한 곳에 갇히고… 정신을 차려보니 이곳이었어요. 그날부터 이렇게나 많은 시간이 흘렀다니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 믿을 수 있는 존재라는 건 직감으로 알았지만, 지휘관님은 그걸 행동으로도 증명해 주셨죠. 그러니 사양 말고 제 힘을 마음껏 쓰셔도 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/feeling4.ogg"},"사랑":{"voiceline":"한번 잘못 내린 선택은 돌이킬 수 없어요. 하지만 뒤늦게라도 올바른 길을 걷는다면, 과거는 무의미하지 않아요. 지휘관님, 당신이 이끌어 줄 길을 믿어요. 저도 당신과 함께 그 길을…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 현장 상황은 어떤가요? 지원이 필요하다면 함께 할게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/home.ogg"},"hp 경고":{"voiceline":"아직 포기할 수는…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/hp_warning.ogg"},"로그인":{"voiceline":"항공모함 프린스턴, 오늘도 지휘관님의 명령에 따르겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/login.ogg"},"실패":{"voiceline":"실패하고 말았군요… 면목 없습니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/lose.ogg"},"우편":{"voiceline":"지휘관님 앞으로 우편이 왔군요. 어서 확인해 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/mail.ogg"},"임무":{"voiceline":"지휘관님, 아직 임무가 남아있네요. 잊어버리기 전에 부탁드려요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었군요. 보상은 물자 비축으로 충당되겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/mission_complete.ogg"},"서약":{"voiceline":"이, 이건 프린스턴을 선택해 주신다는 건가요? 설마 절 이렇게나 소중하게 생각해 주셨을 줄은… 그렇군요. 이렇게까지 해주시니 더더욱 지휘관님을 떠날 수 없겠네요. 네, 당신께 제 모든 것을 맡길게요. 그리고 새로운 미래를 향해, 함께 나아가요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/propose.ogg"},"스킬":{"voiceline":"놓치지 않겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/skill.ogg"},"터치1":{"voiceline":"왜 그러시죠? …제 표정이 그렇게 험악했나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/touch.ogg"},"터치2":{"voiceline":"지, 지휘관으로서 걸맞지 않은 행동은 그만두세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/touch2.ogg"},"입수시":{"voiceline":"항공모함 프린스턴, 지금 막 착임했습니다. 죄송해요. 아직 좀 혼란스러워서… 지금 어떤 상황인지 설명을 부탁드려도 될까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/unlock.ogg"},"강화성공":{"voiceline":"장비도 업데이트해야겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"작전이 잘 풀린 모양이네요. 지휘관님, 다음 지시를 내려주시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9706030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,