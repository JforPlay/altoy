eline":"칫, '그 녀석'이 없다 해도 '벨코' 가……! 전 함, 쏴라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202111/battle.ogg"},"상세확인":{"voiceline":"후우……연금술이란 심오하네요…그래도 이것만 할 수 있다면, 벨파스트 기금회가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202111/detail.ogg"},"드랍 설명":{"voiceline":"왜 그 녀석은 나랑 같이 학교에 오지 않는 거야… \"저는 폐하께 봉사하는 메이드니까요\" 라니, 나도 메이드라구! 학교를 다니면서 메이드를 할 수 없는 것도 아닌데… 칫…","voicelink":null},"의뢰 완료":{"voiceline":"벨파, 의뢰에 나갔던 아이들을 마중 나가기 전에 머리 좀 빗겨줄래? 머리가 좀 흐트러져서 말이야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202111/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":null,"hp 경고":null,"로그인":{"voiceline":"이 스트랩 귀엽죠? '그 녀석' 을 본떠서 만들었어요! 이름은……'벨코' 라 부르면 되려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202111/login.ogg"},"실패":{"voiceline":"베, 벨코는 괜찮죠?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202111/lose.ogg"},"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님도 드시고 싶으신가요? 자, 아~하세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202111/touch.ogg"},"터치2":{"voiceline":"지휘관?! 좀 나가 달라고요! 독서하는데 방해되잖아요! 방해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202111/touch2.ogg"},"입수시":{"voiceline":"왜 그 녀석은 나랑 같이 학교에 오지 않는 거야… \"저는 폐하께 봉사하는 메이드니까요\" 라니, 나도 메이드라구! 학교를 다니면서 메이드를 할 수 없는 것도 아닌데… 칫…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202111/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":nu