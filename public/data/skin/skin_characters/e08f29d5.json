[{"클뜯 id":202110,"클뜯 함순이 id":20211,"함순이 이름":"에든버러","한글 함순이 + 스킨 이름":"에든버러","영문 함순이 + 스킨 이름":"Edinburgh","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202110/shipyard.png","설명":"에든버러급 경순양함·에든버러 (HMS Edinburgh)","자기소개":{"voiceline":"로열 네이비 에든버러급 경순양함 네임쉽입니다. 너무 참한 여동생이 있으면 가끔 스트레스를 받게 되네요… 비스마르크와 샤른호르스트 추격 임무, 그리고 대서양·북해·지중해에서 수많은 정찰과 호위 임무에 참가했어요. 마지막엔 메탈 블러드의 어뢰에 금덩이와 함께 바다에 가라앉아 버렸어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/profile.ogg"},"메인1":{"voiceline":"후드 언니처럼 우아하게 되고 싶지만, 뭐어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/main1.ogg"},"메인2":{"voiceline":"에에에! …벨, 지금 어디야? 나 또 열쇠 잃어버렸어…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/main2.ogg"},"메인3":{"voiceline":"흐흥, 샤른호르스트도 이 에든버러 님 앞에서 꼬리를 말고 도망갈 수밖에 없었다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/main3.ogg"},"전투개시":{"voiceline":"어어어 어떡하지?? 우선 퇴…… 가 아니라 요격입니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/battle.ogg"},"상세확인":{"voiceline":"아무리 에든버러를 쳐다봐도 이건 안 줄 거라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/detail.ogg"},"드랍 설명":{"voiceline":"에든버러급 경순양함·에든버러 (HMS Edinburgh)","voicelink":null},"의뢰 완료":{"voiceline":"군사의뢰라 하면 저 프로거든요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/expedition.ogg"},"실망":{"voiceline":"지휘관이니까 더 경계해야 해… (빤히─)…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/feeling1.ogg"},"낯섦":{"voiceline":"「그 녀석」은 뭐든 잘 해내니까 전 좀 덜렁대도 문제없죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/feeling2.ogg"},"호감":{"voiceline":"또 벨파스트한테 혼났어요… 나가기 전에 문 잠그고 수도꼭지 잠그는 걸 잊어버려서… 뭐야! 그 녀석이 무슨 여동생이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/feeling3.ogg"},"기쁨":{"voiceline":"흐음…… 겨우 지휘관을 찾았어요. 실은…… 아앗── 누구야! 여기에 바나나 껍질 버린 사람!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 어두워지기 전에 같이 해변을 걷는 건 어때요? 네, 안심해주세요. 불도 껐고, 문단속도 괜찮고, 만사 OK라구요! ……어, 어라… 여, 열쇠 어디 갔지─!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/feeling5.ogg"},"터치3":{"voiceline":"감사합니다. 조금 기운 났어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/headtouch.ogg"},"모항귀환":{"voiceline":"쿠키를 구워왔어요, 부디 드셔보세요. 벨과 똑같은 맛이라구요? 어머, 저희는 자매니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/home.ogg"},"hp 경고":{"voiceline":"큿…… 적어도 금덩이만큼은……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/hp_warning.ogg"},"로그인":{"voiceline":"아우! 이상한 짓 안 했어요! 금덩이를 방에 「수송」하고 있을 뿐이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/login.ogg"},"실패":{"voiceline":"큭…… 내 금덩이가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 편…… 어, 어라? 편지는? 어디다 뒀더라…??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/mail.ogg"},"임무":{"voiceline":"임무는 제대로 합시다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/mission.ogg"},"임무완료":{"voiceline":"뭔가 잊은 것 같은데…… 뭐 어때!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/mission_complete.ogg"},"서약":{"voiceline":"우후후, 에든버러의 금전운이라면 조금 나눠드릴 수 있어요. …금덩이? 안 돼요! 그건 벨파스트 기금이라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/propose.ogg"},"스킬":{"voiceline":"장갑은 두꺼워도 돈의 힘에는 못 이긴다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/skill.ogg"},"터치1":{"voiceline":"우와아! 만지지 마세요! 떨어뜨린다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/touch.ogg"},"터치2":{"voiceline":"지휘관, 레이디는 금덩이를 이런 곳에 숨기지 않아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/touch2.ogg"},"입수시":{"voiceline":"제 차례란 거죠! 전 「그 녀석」의 언니, 에든버러에요! 다른 의미로 「가장 비싼」 경순양함이죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/unlock.ogg"},"강화성공":{"voiceline":"운도 좋아진 것 같아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"적을 우아하게 때려 부순다…… 이거야말로 로열 네이비의 우아한 에든버러 님이랍니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['벨파스트'] : 벨파스트와 함께 전투할 수 있을 줄은 몰랐어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/couple_encourage1.ogg"},{"voiceline":"['셰필드'] : 셰피, 여긴 너한테 맡길게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202110/couple_encourage2.og