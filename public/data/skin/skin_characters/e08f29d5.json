져온 것 같은데...","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"벨파스트가 또 메이드장 일을 핑계로 핼러윈 이벤트를 거절했어요... 진짜, 가끔 언니랑 같이 해주면 어디가 덧나나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202112/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어엇! 단지 호박을 이용해서 금괴를 방으로 \"운송\"하고 있을 뿐이에요! 이상한 짓 안 했다구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202112/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"핼러윈 사탕 나누어 주는 중! 지휘관님, 여왕 폐하님도 칭찬을 아끼시지 않은 사탕을 드셔보실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202112/touch.ogg"},"터치2":{"voiceline":"안경 안 썼다고 지휘관님이 안 보일 줄 아세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202112/touch2.ogg"},"입수시":{"voiceline":"으흠, 이건 제가 핼러윈을 맞이해 특별히 준비한 사탕이에요! 받으세요, 지휘관님! 사탕 여기 드릴—— 앗? 꺅! 아파라... 누, 누가 호박을 여기에 둔 거예요! 응? 내가 가져온 것 같은데...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202112/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"할로윈","상점 id":70254,"상점 카테고리 id":8,"스킨 태그":"배경","입수 영상":"X","재화":780,"기간":"상시","진영":"HMS","레어도":"SR","ex_chat_status":0}]