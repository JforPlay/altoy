[{"클뜯 id":101150,"클뜯 함순이 id":10115,"함순이 이름":"스펜스","한글 함순이 + 스킨 이름":"스펜스","영문 함순이 + 스킨 이름":"Spence","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101150/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101150/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101150/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101150/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101150/shipyard.png","설명":"플레처급 구축함·스펜스 (DD-512)","자기소개":{"voiceline":"저, 저어… 플레처급 리틀·비버즈의… 스펜스예요… 언니들과 함께 마리아나의 칠면조 사냥에 참전했어요. 그, 그런데… 태, 태풍이 와서… 하으으읏…! 긴장해서 아무것도 떠오르질 않아요오─ ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/profile.ogg"},"메인1":{"voiceline":"지휘관 씨, 여긴 따뜻해서 안심이 돼요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/main1.ogg"},"메인2":{"voiceline":"아앗─! 대, 대처 언니 거기 있는 거야!? 놀랬잖아아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/main2.ogg"},"메인3":{"voiceline":"오스본 언니는 대처 언니완 달리 언제나 저를 도와줘요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/main3.ogg"},"전투개시":{"voiceline":"지휘관 씨… 스펜스, 기대에 부응할 수 있게 힘낼게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/battle.ogg"},"상세확인":{"voiceline":"아앗─! 이, 이상한 곳 만지지 말아주세요오~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함·스펜스 (DD-512)","voicelink":null},"의뢰 완료":{"voiceline":"자매들이 돌아왔어요! 모두 굉장해서, 스펜스는 부러워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/expedition.ogg"},"실망":{"voiceline":"지휘관 씨는, 싫어요… (움찔 움찔)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/feeling1.ogg"},"낯섦":{"voiceline":"으아앗! 지, 지휘관 씨… 깜짝 놀랐어요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/feeling2.ogg"},"호감":{"voiceline":"언니가, 지휘관은 믿을 수 있는 분이라고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/feeling3.ogg"},"기쁨":{"voiceline":"지, 지지, 지휘관, 천둥이 칠 때는, 지, 지휘관이랑 같이 자도 될까요? 스펜스는 천둥소리가 가장 무서워요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/feeling4.ogg"},"사랑":{"voiceline":"지, 지지, 지휘관, 으으… 스펜스, 영화를 봤어요. 두 사람이 서로 사랑하고 있는데도 함께 있을 수 없게 되다니… 지휘관은 스펜스의 곁에서 떠나지 않으실 거죠…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관 씨가 무사해서… 다행이에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지, 지휘관 씨… 아, 아뇨… 스펜스, 많이 기다린 거 아니니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/login.ogg"},"실패":{"voiceline":"우와아아, 무, 무서워어─!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/lose.ogg"},"우편":{"voiceline":"지, 지휘관 씨… 편지에요오…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/mail.ogg"},"임무":{"voiceline":"지, 지휘관 씨… 아직 끝내지 않은 임무가…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/mission.ogg"},"임무완료":{"voiceline":"보, 보너스… 받는 거… 잊지 말아줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/mission_complete.ogg"},"서약":{"voiceline":"엣, 지휘관도 스펜스를 좋아, 한다구요? 어, 어어, 어쩌지… 너무 기뻐서 눈물이 멈추지 않아요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101150/propose.ogg"},"스킬":{"voiceline":"스, 스스, 스펜스, 힘낼게요!","voi