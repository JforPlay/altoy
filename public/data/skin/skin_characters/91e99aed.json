[{"클뜯 id":201110,"클뜯 함순이 id":20111,"함순이 이름":"폭스하운드","한글 함순이 + 스킨 이름":"폭스하운드","영문 함순이 + 스킨 이름":"Foxhound","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201110/shipyard.png","설명":"F급 구축함·폭스하운드 (H69)","자기소개":{"voiceline":"나는 로열 네이비 F클래스의 구축함 폭스하운드! 여우 사냥이 특기지. 다른 자매함과 비교하면 처음으로 확장 설계를 받았기 때문에 발육이 조금 좋다는 느낌! 헤헤헤……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/profile.ogg"},"메인1":{"voiceline":"추운 곳은 싫어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/main1.ogg"},"메인2":{"voiceline":"지휘관, 나를 작은 동물 취급한다면, 적어도 여우가 아니라 멍멍이로 해! 알겠지? 아, 하지만 멍멍이로 하기도 없기야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/main2.ogg"},"메인3":{"voiceline":"지휘관, 나에게 뼈를 던져주면 물 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/main3.ogg"},"전투개시":{"voiceline":"자, 뭐가 있을지 보도록 하겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/battle.ogg"},"상세확인":{"voiceline":"언니는 내 쪽이 좀 더 어른으로 보인다고 했지만…. 어디가 그런 거지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/detail.ogg"},"드랍 설명":{"voiceline":"F급 구축함·폭스하운드 (H69)","voicelink":null},"의뢰 완료":{"voiceline":"(킁킁) 의뢰 팀의 냄새야. 아마도 벌써 돌아왔나 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/expedition.ogg"},"실망":{"voiceline":"지휘관에게서 이상한 냄새가 나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/feeling1.ogg"},"낯섦":{"voiceline":"(킁킁) ……지휘관에게서 좋은 냄새~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/feeling2.ogg"},"호감":{"voiceline":"지휘관, 뺨에 뭐가 있는데? 가만히 있어 봐, 떼줄게… (핥짝) 어? 어째서 핥은 거냐고? …그, 몸이 멋대로…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/feeling3.ogg"},"기쁨":{"voiceline":"지휘관! (쓱쓱) 에헤헤…… 역시 지휘관의 품이 제일 기분 좋은걸! 하아아~ 쿠울… 흐으…… Zzzzzzz……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/feeling4.ogg"},"사랑":{"voiceline":"지휘관이 정말 좋아! (텁) 지휘관이 정말 좋아! (쓱쓱) 지휘관이 너무너무너무 좋아! (스윽스윽스윽)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"아우우…… 멍멍! ……들어버렸어? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관~ 헤헤헤, 오늘은 뭔가 재미있는 일을 하고 싶네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/login.ogg"},"실패":{"voiceline":"후우… 도망치는 게 빨라서 살았다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/lose.ogg"},"우편":{"voiceline":"새로운 편지가 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/mail.ogg"},"임무":{"voiceline":"완료 안 된 미션이 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/mission.ogg"},"임무완료":{"voiceline":"보너스 수령, 기억해둬!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 이건 뭐야? 목걸이가 아닌 것 같은데…… 에, 나에게? 갖고 싶어 갖고 싶어! 지휘관이 준 물건이라면, 뭐든 소중히 할게! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/propose.ogg"},"스킬":{"voiceline":"여우가 아니라 멍멍이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/skill.ogg"},"터치1":{"voiceline":"쿠응…… 만지는 걸 그만해줘…… 손이 뜨거워……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/touch.ogg"},"터치2":{"voiceline":"왓! 아우!? 뭘 생각하는 거야! 여기저기 손대는 건 그만둬어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/touch2.ogg"},"입수시":{"voiceline":"폭스하운드, 지휘관에게 보고야! 어, 여우? 틀려! 나는 여우가 아니고 개라니까! ……아무튼, 앞으로 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/unlock.ogg"},"강화성공":{"voiceline":"응…… (킁킁) 색적 기능이 강해졌어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"헷헷헤~ 여우가 아무리 교활해도 이 하운드 멍멍에게 이길 수 없으니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/201110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"N","ex_chat_status":0},{"클뜯 id":201119,"클뜯 함순이 id":20111,"함순이 이름":"폭스하운드","한글 함순이 + 스킨 이름":"폭스하운드·改","영문 함순이 + 스킨 이름":"Foxhound (Retrofit)","스킨 타입":"Retrofit","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201119/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201119/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/201119/icon.png","쥬스타 아이콘 