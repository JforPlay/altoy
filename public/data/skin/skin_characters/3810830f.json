[{"클뜯 id":108030,"클뜯 함순이 id":10803,"함순이 이름":"카발라","한글 함순이 + 스킨 이름":"카발라","영문 함순이 + 스킨 이름":"Cavalla","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108030/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/108030/shipyard.png","설명":"가토급 잠수함 카발라, SS-244 ","자기소개":{"voiceline":"나, 첫번째 순항임무에서 기회를 틈 타 사쿠라 엠파이어의 항공모함을 격침시켰어! 쉬웠냐고? 전혀! 앞뒤로 대위기였다구! 하지만 나는 모두 이겨냈지! 지휘관이 흥미가 생겼다면 이 이야기는 천천히 들려주도록 할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/profile.ogg"},"메인1":{"voiceline":"잠수함은 앞으로 더 강해질까? 예를 들면… 더 강력한 무기를 쓴다거나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/main1.ogg"},"메인2":{"voiceline":"여기서 가만히 아무것도 안 하는 건 너무 공허해… 지휘관! 뭐라도 시켜줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/main2.ogg"},"메인3":{"voiceline":"후와~ 육지에서도 바다에 뒤지지 않는 편안한 바람을 느낄 수 있구나!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/main3.ogg"},"전투개시":{"voiceline":"모두들, 나에게 용기를!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/battle.ogg"},"상세확인":{"voiceline":"잠수함은 바닷 속에서만 적을 섬멸하는 게 아니야. 수면 위라도 나는 똑같이 싸울 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/detail.ogg"},"드랍 설명":{"voiceline":"가토급 잠수함 카발라, SS-244","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 무사히 돌아왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/expedition.ogg"},"실망":{"voiceline":"완전 싫어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/feeling1.ogg"},"낯섦":{"voiceline":"실패에 대한 공포감은 용기로 극복하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/feeling2.ogg"},"호감":{"voiceline":"용기만으로는 쉽게 이길 수 없어! …이럴 때 지휘관의 힘이 필요한거야! 지휘관의 지시가 있으면 우리는 어떤 어려움도 이겨낼 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/feeling3.ogg"},"기쁨":{"voiceline":"요즘 겁이 많아진 것 같아… 출격해서도 예전처럼 과감하지도 않고… 뭔가 생각하면 계속 지휘관이 떠올라. 전부 지휘관 잘못이야! …그런데 정말로 지휘관의 잘못일까…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/feeling4.ogg"},"사랑":{"voiceline":"꿈을 꿨는데, 지휘관이 날 아이처럼 안고 온 항구를 뛰어다녔어....이상하지? 더 이상한건 내가 아주 기뻐했다는거야...왜일까... ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관, 잠수함의 활약이 필요할 때는 언제든 나를 찾아줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/home.ogg"},"hp 경고":{"voiceline":"아무리 힘들어도 포기하지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침, 지휘관! 오늘도 정시 도착이네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/login.ogg"},"실패":{"voiceline":"우으으… 바닷물… 너무 짜…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/lose.ogg"},"우편":{"voiceline":"새로운 소식! 잠수함 친구들이 보낸 게 아닐까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/mail.ogg"},"임무":{"voiceline":"임무를 마치면 많은 보상이 기다리고 있겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/mission.ogg"},"임무완료":{"voiceline":"와아! 보상이 잔뜩! 지휘관, 맛있는 게 먹고싶어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/mission_complete.ogg"},"서약":{"voiceline":"에, 잠깐만. 지휘관, 왜 나를 안아올려? 뭐, 뭐하려고? 웨이트 트레이닝? 자,장난치지마! 다들 보고 있잖아! 얼른 내려놔!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/propose.ogg"},"스킬":{"voiceline":"이 기회, 오래 기다렸어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/skill.ogg"},"터치1":{"voiceline":"아하, 하하하!……마, 만지지마! 간지럽단 말야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/touch.ogg"},"터치2":{"voiceline":"체, 체포될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/touch2.ogg"},"입수시":{"voiceline":"나는 유니온의 잠수함, 카발라! 함대를 위해 더 많은 전과를 올릴테니 지켜봐달라고, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/unlock.ogg"},"강화성공":{"voiceline":"강해졌어! 흐흥~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이번 승리는 내 덕분이라구. 히히~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관이 정말로 이런 일을 벌이다니, 진짜 깜짝 놀랬다고...하지만, 정말 기뻐! 헤헤~ 오늘부터, 항상 곁에 있을게! 대신, 먼저 말해두겠는데, 다시는 날 어린애 취급하면 안돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['알바코어'] : 누가 더 대단한지 겨뤄보자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/108030/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 