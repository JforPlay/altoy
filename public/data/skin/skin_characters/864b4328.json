/voiceline/202153/detail.ogg"},"드랍 설명":{"voiceline":"‘다음은 오로라가 이스트 글림에 내려오는 비기, 천극 변검을 선보이겠습니다! 채널 고정, 잊지 마세요!’ ——우후후, 지휘관님. 이런 느낌은 어떠신가요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관님. 혹시 가면 중에…… 사랑을 뜻하는 가면은 없을까요? 에? 제 얼굴로 충분하다고요? 정, 정말이지. 레이디는 이런 것에 동요해서는 안 되는데요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202153/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어요~ 그렇다면 차와 땅콩을 곁들인 오로라의 공연을 즐겨주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202153/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"그렇다면, 오늘은 지휘관님을 위해 어떤 공연을 준비해 볼까요——선택지가 많은 것도 어려운 일이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202153/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"뒤에 있는 무기걸이요? 비록 지금은 화단이지만 저는 항상 도마단을 해보고 싶었거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202153/touch.ogg"},"터치2":{"voiceline":"지, 지휘관님? 계속이러시면 제 뒤의 칼이 가만 있지 않을거예요… 아플 거라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202153/touch2.ogg"},"입수시":{"voiceline":"‘다음은 오로라가 이스트 글림에 내려오는 비기, 천극 변검을 선보이겠습니다! 채널 고정, 잊지 마세요!’ ——우후후, 지휘관님. 이런 느낌은 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202153/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70314,"상점 카테고리 id":3,"스킨 태그":"L2D, 