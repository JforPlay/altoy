[{"클뜯 id":202150,"클뜯 함순이 id":20215,"함순이 이름":"오로라","한글 함순이 + 스킨 이름":"오로라","영문 함순이 + 스킨 이름":"Aurora","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202150/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202150/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202150/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202150/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202150/shipyard.png","설명":"아레투사급 경순양함 - 오로라 (HMS Aurora) ","자기소개":{"voiceline":"로열 네이비 아레투사급 4번함, 오로라라고 합니다. '새벽의 여신'이라든지 '은색의 환영'이라고 불리고 있습니다만, 저로서는 아직 여신 쪽이…… 그것보다, 지휘관 씨는 제 또 다른 이름도 알고 계신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/profile.ogg"},"메인1":{"voiceline":"이스트 글림 말인가요? 거긴 좋은 곳이에요. 음, 예를 들면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/main1.ogg"},"메인2":{"voiceline":"저를 계속 바라보고 있어도 상관은 없습니다만… 업무를 소홀히 하면 안 돼요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/main2.ogg"},"메인3":{"voiceline":"지휘관 씨, 잠시만요. 지금 입가를…… 자, 일 열심히 하세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/main3.ogg"},"전투개시":{"voiceline":"승리에 여신의 축복이 있기를!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/battle.ogg"},"상세확인":{"voiceline":"지휘관 씨…… 장비에 관해서 도와드릴 건 없나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/detail.ogg"},"드랍 설명":{"voiceline":"아레투사급 경순양함 - 오로라 (HMS Aurora)","voicelink":null},"의뢰 완료":{"voiceline":"지휘관 씨? 저를 빤히 바라보셔도, 의뢰를 잊으면 안 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/expedition.ogg"},"실망":{"voiceline":"지휘관 씨, 공공장소에서 이런 짓을 하시면… 곤란해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/feeling1.ogg"},"낯섦":{"voiceline":"제가 기른 장미, 지휘관 씨도 한번 보시겠어요? 여러 종류가 있답니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/feeling2.ogg"},"호감":{"voiceline":"여신 오로라는 '장밋빛의 손가락을 가지고 있다'라고 전해집니다만, 저도 장미 향 정도는 가지고 있답니다. 조금 맡아보시겠어요 지휘관 씨? 우후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 씨, 잠깐 이쪽으로…… 우후후, 역시 이 장미는 지휘관 씨에게 어울리네요~ 앗, 딱히 놀리는 건 아니에요. …정말, 그렇게 신경 쓰이시면 제게 꽂을 장미도 골라 보시겠어요? 지휘관 씨가 고른 거라면 뭐든지 좋아요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/feeling4.ogg"},"사랑":{"voiceline":"제가 지휘관 씨의 시간을 독점하고 있다는 얘길 들었어요… 우후후, 하지만 이것만은 모두에게 양보할 수 없는걸요. 지휘관 씨도 다른 아이들이 삐질 테니까 각오해주세요~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고하셨습니다. 푹 쉬세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/home.ogg"},"hp 경고":{"voiceline":"새벽의 빛이여, 우리들의 앞길을…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/hp_warning.ogg"},"로그인":{"voiceline":"제 이름에는 '새벽의 빛'이라는 의미도 있습니다. 우후후♪ 저를 보고 아침인 것처럼 기운이 나셨나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/login.ogg"},"실패":{"voiceline":"전장에는 역시 좀 익숙해지지 않네요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/lose.ogg"},"우편":{"voiceline":"새로운 우편입니다. 읽어드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/mail.ogg"},"임무":{"voiceline":"지휘관 씨, 새로운 임무의 지령서가 도착했어요. 아, 요점은 꽃잎으로 표시했으니 확인해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/mission.ogg"},"임무완료":{"voiceline":"받지 않은 임무 보수가 있어서, 가져왔어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/mission_complete.ogg"},"서약":{"voiceline":"장미는 어떤 이름으로 불러도, 똑같이 달콤한 향기가 납니다. 저도 그렇답니다. 오로라도, 새벽의 여신도, '충칭' 도… 저라는 것은 변하지 않아요. 네, 당신의 곁에 있는 저로서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/propose.ogg"},"스킬":{"voiceline":"지휘관 씨의 고민을 해결하는 것도 일이네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/skill.ogg"},"터치1":{"voiceline":"지휘관 씨, 함께 꽃에 물을 주지 않을래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/touch.ogg"},"터치2":{"voiceline":"지휘관 씨! 화, 화낼 거에요! …정말, 진짜로 화낼 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/touch2.ogg"},"입수시":{"voiceline":"안녕하신가요, 지휘관 씨♪ 저는 아레투사급 경순양함의 4번함 오로라라고 합니다. 오늘부로 지휘관 씨의 비서를 맡게 되었습니다. 어떤 질문이라도 사양 말고 제게 물어봐 주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/unlock.ogg"},"강화성공":{"voiceline":"좀 더 지휘관 씨에게 이것저것 해드릴 수 있겠네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관 씨, 우리가 이겼습니다! 축하해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['핑하이', '닝하이'] : 핑하이, 닝하이. 같이 연습할까요? 네? 돈을 벌기 위해서라고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202150/couple_encourage1.ogg"},{"voiceline":"['하나즈키'] : 망설이는 것보다 장미를 시험해 보는 것이 낫지 않을까요？","voicelink":"https://raw.githubusercontent.com/Fernando26