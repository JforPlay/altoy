s://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/main1.ogg"},"메인2":{"voiceline":"지휘관 씨는 악기에 관심이 있나요? 사심을 말하자면, 지휘관 씨가 피아노를 치고 저와 합주했으면 좋겠어요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/main2.ogg"},"메인3":{"voiceline":"지휘관 씨, 당신이 어둠 속에 빠져 빛을 잃었을 때, 저의 연주를 들으러 오세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관 씨, 저는 평소에 광장에서 연주하곤 하니까 관심 있으시면 와서 감상해도 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/detail.ogg"},"드랍 설명":{"voiceline":"저는 항상 음악이 사람의 마음을 흔들 수 있는 독특한 힘을 가지고 있다고 생각했어요. 그래서 바이올린을 배웠었죠. 지휘관 씨, 제 연주를 감상해주세요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관 씨, 전쟁이 끝나면 같이 여행가요. 다른 지역에서 연주하고, 다른 사람들을 위해 축복해주는 것은 저희만이 해낼 수 있는 일이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"수고했어요, 지휘관 씨. 제가 음악으로 마음을 치유해 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/home.ogg"},"hp 경고":null,"로그인":null,"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"일은 마무리되었나요? 그럼 어떤걸 듣고 싶으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/touch.ogg"},"터치2":{"voiceline":"정말이지, 지휘관 씨, 이러면 연주에 방해된다구요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/touch2.ogg"},"입수시":{"voiceline":"저는 항상 음악이 사람의 마음을 흔들 수 있는 독특한 힘을 가지고 있다고 생각했어요. 그래서 바이올린을 배웠었죠. 지휘관 씨, 제 연주를 감상해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202152/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex"