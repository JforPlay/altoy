[{"클뜯 id":101510,"클뜯 함순이 id":10151,"함순이 이름":"라피Ⅱ","한글 함순이 + 스킨 이름":"라피Ⅱ","영문 함순이 + 스킨 이름":"Laffey II","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101510/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101510/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101510/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101510/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101510/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101510/shipyard.png","설명":"알렌 M. 섬너급 구축함—라피II, 현호 DD-724","자기소개":{"voiceline":"...알렌 M. 섬너급? 응, 아마 그럴 거야. 지휘관, 라피의 새로운 의장, 마음에 들어? …라피, 칭찬해달라고 그러는 거 아니야… 응, 진짜 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/profile.ogg"},"메인1":{"voiceline":"의장에 앉아서 학교까지 날아가고 싶었지만… 결국은 걸었어. 라피, 안 걷고 타는 게 좋아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/main1.ogg"},"메인2":{"voiceline":"무언가를 기억하고 싶을 때는 패널에 삑삑… 너무 편리해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/main2.ogg"},"메인3":{"voiceline":"라피, 강해진 것 같아? …의장에 앉아서 잘 수 있어서? …아니야? 음…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/main3.ogg"},"전투개시":{"voiceline":"우선은 적을 쓰러트려야지… 응, 빨리…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/battle.ogg"},"상세확인":{"voiceline":"응… 지휘관은 계속 라피를 지켜봐주고 있어… 라피, 기뻐…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/detail.ogg"},"드랍 설명":{"voiceline":"알렌 M. 섬너급 구축함 - 라피Ⅱ DD-724","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀, 돌아왔어… 지휘관, 알고 있었어? 그럼, 라피는 돌아가서 잘게……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/expedition.ogg"},"실망":{"voiceline":"지휘관, 라피를 깨우다니… 무슨 볼일이라도…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/feeling1.ogg"},"낯섦":{"voiceline":"라피, 의욕이 없는 것 같아…? 그렇지 않아… 라피, 의욕 만땅… 쿨쿨……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/feeling2.ogg"},"호감":{"voiceline":"라피, 아직 완전히 깬 건 아니지만… 몸도 마음도 요격 준비는 마친 상태야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/feeling3.ogg"},"기쁨":{"voiceline":"지휘관이 지금 라피를 어떻게 생각하는지… 라피는 신경 안 써. 응, 전혀… 신경 안 써……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/feeling4.ogg"},"사랑":{"voiceline":"라피도 변할 때가 있어… 그렇지만 아무리 변해도… 지휘관이랑 같이 있고 싶은 마음은 변하지 않아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/feeling5.ogg"},"터치3":{"voiceline":"지휘관…? 쉬고 싶어…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관… 흐아아암…… 어서 와… 쿨쿨…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/home.ogg"},"hp 경고":{"voiceline":"쏠 수 있는 한 포기하지 않아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/hp_warning.ogg"},"로그인":{"voiceline":"응. 라피… 많이 코- 자서 괜찮아… 아마도. 지휘관은?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/login.ogg"},"실패":{"voiceline":"라피의 싸움은… 이걸로 끝이 아니야… 응.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 온 우편… 라피, 여기 둘게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/mail.ogg"},"임무":{"voiceline":"새로운 임무가 왔어. 지휘관, 일할 시간… 라피도……?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/mission.ogg"},"임무완료":{"voiceline":"보상을 수령했어. 지휘관, 지금 확인할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/mission_complete.ogg"},"서약":{"voiceline":"…지휘관이 늘 걱정해 주니까 지금 라피가 있는 거야… 라피를 계속 지켜봐 준 지휘관이니까… 응, 라피는 지휘관이랑 약속할게… 앞으로도 계속 지휘관이랑 함께……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/propose.ogg"},"스킬":{"voiceline":"접속 완료, 전개…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/skill.ogg"},"터치1":{"voiceline":"앉아 있다가 잠들었어… 음… 괜찮아, 안 떨어져…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/touch.ogg"},"터치2":{"voiceline":"지휘관… 역시 변태였어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/touch2.ogg"},"입수시":{"voiceline":"하암…… 라피, 의욕 만땅에 준비도 완벽해… 바뀐 건 의장뿐이고… 라피는 똑같아… 그러니까 지휘관, 이 귀도 진짜 귀는 아니니까… 만지지 마……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/unlock.ogg"},"강화성공":{"voiceline":"……그래서 말인데, 조금만 코- 자도 괜찮아…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼어… 라피, 코- 자러 갈 시간…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/win_mvp.ogg"},"전투개시_ex":{"voiceline":"라피도 지휘관도 의욕 만땅…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/battle_ex.ogg"},"상세확인_ex":null,"의뢰 완료_ex":{"voiceline":"의뢰팀이 돌아왔어… 라피, 아직 조금 졸려… 그렇지만 지휘관이랑 같이 동료들을 마중하러 나가고 싶어…… 으응…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/expedition_ex.ogg"},"사랑_ex":{"voiceline":"지휘관, 잠깐 시간 괜찮아? ……괜찮아, 라피는 곁에서 잠깐 자고 싶은 것뿐… 라피… 조용히 있을게…. 쿨쿨……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101510/feeling5_ex.ogg"},"터치3_ex":{"voiceline"