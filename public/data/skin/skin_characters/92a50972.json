ink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/headtouch.ogg"},"모항귀환":{"voiceline":"하암…… 눈을 뜨니까, 보좌관이 돌아와 있네…… 좋다…… 위대한 토끼토끼 성주의 신하라면…… 앞으로는 라피가 허락할 때까지는… 절대 곁을 떠나면 안 돼……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"보좌관, 어서 와…… 순찰… 얼마나 남았어……? 하루 종일……?! 라피 영지의 크기 설정… 좀 줄이면 안 될까……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/login.ogg"},"실패":null,"우편":{"voiceline":"토끼토끼들이 보좌관한테 우편을 가져다줬어…… 꼭 받아 줘……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/mail.ogg"},"임무":{"voiceline":"토끼토끼 성의 정무도 있으니까…… 라피, 보좌관이 먼저 임무를 처리할 수 있게 허락할게……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/mission.ogg"},"임무완료":{"voiceline":"정무는 다 끝냈어…… 순찰… 계속할 수 있어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"보좌관도… 선선한 곳이 좋아……? 라피 곁이… 가장 선선하고 쾌적해……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/touch.ogg"},"터치2":{"voiceline":"끈이 풀렸어…… 옷이 흘러내리겠어…… 보좌관, 변태……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/touch2.ogg"},"입수시":{"voiceline":"음… 졸려…… 토끼토끼성의 위대한 성주인 라피는 잠깐 쉬고 싶어…… 지휘관…이 아니라 보좌관, 영지 순찰은… 조금 기다린 다음에……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101512/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4