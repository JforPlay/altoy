m/Fernando2603/AzurLane/main/audio/voiceline/502073/main1.ogg"},"메인2":{"voiceline":"흡혈귀, 프랑켄슈타인, 마녀… 어디든 이런 괴이한 것들이 많이 있어서 참 재밌네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502073/main2.ogg"},"메인3":{"voiceline":"'과자를 안 주면 장난칠 거야'라고 하면, 이 과자를 나누어주면 된다는 거죠? 알겠습니다…… 대신 샤오빙을 줘도 괜찮을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502073/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"\"숲속에 흰옷을 입은 여자 유령이 여기저기 떠다니고, 게다가 이상한 바람 소리까지…\" 이상한 소문도 다 있네요… 저기… 지휘관님? 왜 그렇게 물끄러미 쳐다보시는 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502073/detail.ogg"},"드랍 설명":{"voiceline":"오래 기다리셨습니다. 옷과 초롱을 준비하는 데 시간이 좀 걸려서…… 네, '밤놀이'라고 하시길래 옛 선인의 지혜를 빌려 조금 준비해 봤어요. 그럼… 슬슬 출발할까요?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"지휘관님, 체력은 충분히 보충하셨나요? 아까 만들어 둔 샤오빙이…… 너, 너무 달았나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502073/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오늘 밤은 풍경이 참 아름답군요. 항구의 떠들썩한 곳을 벗어나 둘이 조용한 시간을 즐긴다… 왠지 '밀회' 같은 느낌 안 드시나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502073/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"마음껏 즐기는 날이니 임무는 조금 미뤄도 괜찮지 않을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502073/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"소, 손잡으실 건가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502073/touch.ogg"},"터치2":{"voiceline":"지, 지휘관님의 진짜 목적은 이거였나요…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502073/touch2.ogg"},"입수시":{"voiceline":"오래 기다리셨습니다. 옷과 초롱을 준비하는 데 시간이 좀 걸려서…… 네, '밤놀이'라고 하시길래 옛 선인의 지혜를 빌려 조금 준비해 봤어요. 그럼… 슬슬 출발할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voi