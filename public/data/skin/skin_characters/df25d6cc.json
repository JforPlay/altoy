[{"클뜯 id":502070,"클뜯 함순이 id":50207,"함순이 이름":"하이티엔","한글 함순이 + 스킨 이름":"하이티엔","영문 함순이 + 스킨 이름":"Hai Tien","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502070/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502070/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502070/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502070/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502070/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/502070/shipyard.png","설명":"하이티엔급 방호순양함—하이티엔","자기소개":{"voiceline":"이스트 글림 소속 하이티엔급 방호순양함인 하이티엔입니다. 제 과거에는 다소 형언하기 어려운 부분이 있어서……. \"시대를 잘못 태어났다\"라고 하는 표현이 타당할 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/profile.ogg"},"메인1":{"voiceline":"하이치는 여전히 활기가 넘치네요. 아…… 지휘관님께 폐를 끼치거나 한 건 아니겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/main1.ogg"},"메인2":{"voiceline":"집무실에 시집 사본을 가져다 뒀습니다. 지휘관님께서 한가하실 때 읽어보시면 좋을 것 같아서요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/main2.ogg"},"메인3":{"voiceline":"저녁 식사는 뭘로 하시겠어요? 혹시…… 마파두부 좋아하세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/main3.ogg"},"전투개시":{"voiceline":"전투를 끝낼 수 있는 방법은 오로지 전투 밖에 없는 걸까요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/battle.ogg"},"상세확인":{"voiceline":"\"미를 겨루는 꽃의 아리따움도 사랑스럽지만, 시들어 떨어지는 낙화의 외로움이 마음에 스미네\" ……제가 너무 감성적이었나요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/detail.ogg"},"드랍 설명":{"voiceline":"하이티엔급 방호순양함—하이티엔","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조 여러분이 무사히 돌아왔습니다. 그녀들에게 수고했다고 말씀해주고 오세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/expedition.ogg"},"실망":{"voiceline":"제발 말 걸지 말고 가만히 둬주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/feeling1.ogg"},"낯섦":{"voiceline":"시의 아름다움이란, 그 압운이나 대구법에 있는 것이 아니라, 행간에 숨겨진 다양한 감정에 있는 법……. 지휘관님, 혹시 시의 길에 흥미 있으신지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/feeling2.ogg"},"호감":{"voiceline":"작풍이란 건 천차만별이라, 대담무쌍하고 파란만장한 느낌을 줄 수도 있고, 애달한 정서를 실어 유유자적하게 절제미를 살릴 수도 있지요……. 지휘관님의 취향은 어느 쪽인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/feeling3.ogg"},"기쁨":{"voiceline":"휴우……. 아, 죄송합니다, 지휘관님. 무슨 일이 있는 건 아니예요. 그저…… 최근에 읽은 \"연모\"에 대한 시에 좀 공감이 가는 부분이 많아서……. 부디 괘념치 마시길. 하아…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 언젠가는 수평선 너머 머나먼 곳으로 출정해야 하는 날이 오겠죠……. 아무리 멀리 계셔도, 하이티엔이 여기 있다는 사실을 부디 잊지 마시길……. \"아무리 멀어도 늘 같은 달 아래\"인 걸요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/feeling5.ogg"},"터치3":{"voiceline":"어라……? 딱히 몸 상태가 안 좋은 건 아닌데요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 출격하느라 고생 많으셨습니다. 자양분이 풍부한 흰목이버섯 스프를 준비해뒀으니, 괜찮으시면 꼭 드시…… 어라? 너무 단가요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/home.ogg"},"hp 경고":{"voiceline":"안개가……?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/hp_warning.ogg"},"로그인":{"voiceline":"\"시간은 금이다\"……. 지휘관님, 슬슬 업무를 시작하지 않으시면 오늘 하루가 헛되이 흘러가고 말아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/login.ogg"},"실패":{"voiceline":"\"원숭이도 나무에서 떨어진다\"……고 했습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/lose.ogg"},"우편":{"voiceline":"종이에 적어 둔 한 글자 한 구절은…… 상대방이 전하고자 한 깊은 마음…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/mail.ogg"},"임무":{"voiceline":"지휘관님, 오늘 임무도 꼭 잊지 말고 수행해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐습니다. 이번에도 분명 괜찮은 보상이 기다리고 있겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/mission_complete.ogg"},"서약":{"voiceline":"\"흐르는 세월의 강물 속에서도, 날 이끌어줄 벗만 있다면 후회스럽지 않다\"……. 벗으로 끝나고 싶지 않다구요? 그렇다면……. 그, 그러니까…… 기꺼이…… 아, 죄, 죄송합니다……. 잠시만 마음의 정리를……. 정말 잠깐이면 돼요///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/propose.ogg"},"스킬":{"voiceline":"\"정성이 지극하면, 쇠와 돌도 가를 수 있다\"……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/skill.ogg"},"터치1":{"voiceline":"아…… 죄송합니다. 잠깐 아까 읽은 시집 생각을 하다가……. 네, 무슨 일이시죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/touch.ogg"},"터치2":{"voiceline":"이, 이런 예의도 모르는 분……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/touch2.ogg"},"입수시":{"voiceline":"처음 뵙겠습니다, 지휘관님. 이스트 글림 소속인 하이티엔입니다. 아직 좌우도 분별하지 못하는 미숙한 몸이지만, 모쪼록 잘 부탁드립니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/unlock.ogg"},"강화성공":{"voiceline":"\"장인의 걸작은 우선은 그 연장을 날카롭게 손질한 후에야 비로소 탄생한다\"……. 감사합니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/upgrade.ogg"},"vote":null,"승리":{"voiceline":"\"피로 물든 땅은 천리를 이루고, 탄알은 비처럼 쏟아지네\"……. 언제쯤 이 전쟁은 끝이 날까…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502070/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"제 안색이 