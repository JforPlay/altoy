ndo2603/AzurLane/main/audio/voiceline/502074/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"어서 오세요, 지휘관님. 맛있는 가오빙(糕餅)을 준비했답니다. …네? 하이티엔의 가슴에 있는 게 더 맛있겠다구요? 이, 이건 음식이 아니에요.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"「맛있는 음식은 많이 만날 수 있지만 지기는 찾기 어려우며, 사랑하는 사람과 함께 길일을 보내는 것은 더더욱 어려운 일…」 음? 지휘관님의 얼굴을 보니…… 후후, 하이티엔의 마음이 모두 전해진 것 같네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/feeling5.ogg"},"터치3":{"voiceline":"음… 반죽하듯이 주무르지 마세요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 고생 많으셨어요. 간식으로 가오빙을 가지고 왔습니다. …네? 달기가 적당해서 좋다고요? 다행이네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"오후에 가지는 티타임에는 바삭하고 맛있는 가오빙과 전다법으로 달인 녹차를 함께…… 후우, 벌써부터 기대가 되네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무가 아직 완료되지 않았네요. 열심히 완수하시면 하이티엔이 상을 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/mission.ogg"},"임무완료":{"voiceline":"후후후, 열심히 임무를 완수하셨군요. 그럼 이 새로운 맛의 가오빙도 드실 수 있게 해드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"어머… 또 배가 고프신 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/touch.ogg"},"터치2":{"voiceline":"이, 이건 떡이 아닌걸요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/touch2.ogg"},"입수시":{"voiceline":"어서 오세요, 지휘관님. 맛있는 가오빙(糕餅)을 준비했답니다. …네? 하이티엔의 가슴에 있는 게 더 맛있겠다구요? 이, 이건 음식이 아니에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/502074/unlock.ogg"},"강화성공":null,"vote":null,"승리":nu