.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관, 뛰어 내리기로 한 건 당신이 내린 선택이야. 이제 지휘관은 아미티의 손아귀 안이야. …아직도 모르겠어? 보물을 훔친 건 다 당신을 유인해내기 위해서였다고. 처음부터 아미티의 목적은 지휘관 당신… 아미티의 소중한 「보물」이었어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/feeling5.ogg"},"터치3":{"voiceline":"지휘관~ 모자 벗을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/headtouch.ogg"},"모항귀환":{"voiceline":"오~! 쫓아왔구나. 그럼 아미티는 잡히는 순간만을 손꼽아 기다리고 있을게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관, 계속 기다렸어. 과연 이번에는 이 아미티를 잡을 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/login.ogg"},"실패":null,"우편":{"voiceline":"지휘관한테 온 우편은 내가 잘 받았어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/mail.ogg"},"임무":null,"임무완료":{"voiceline":"지휘관, 임무는 이미 끝났잖아? 그런데도 계속 아미티를 쫓을 셈이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관, 더 가까이 와야지~ 이렇게 멀리서 날 어떻게 잡겠다는 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/touch.ogg"},"터치2":{"voiceline":"지휘관~ 손을 얌전히 두질 못하네… 후후, 묶이고 싶은 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/touch2.ogg"},"입수시":{"voiceline":"이런~ 이제 도망 못 치겠네. 농담이야♪ 이번에도 내가 이겼으니 보물은 가지고 갈게! 겁 안 나면 같이 뛰어내려 보던가~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600091/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스