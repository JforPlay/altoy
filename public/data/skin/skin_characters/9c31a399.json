[{"클뜯 id":9600090,"클뜯 함순이 id":960009,"함순이 이름":"아미티","한글 함순이 + 스킨 이름":"아미티","영문 함순이 + 스킨 이름":"Amity","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9600090/shipyard.png","설명":"범선 - 아미티","자기소개":{"voiceline":"난파선으로 위장해서 화포를 준비하고, 상대가 다가오면 허를 찔러서 단숨에 습격한다… 아미티에게 딱 맞는 전술이지? 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/profile.ogg"},"메인1":{"voiceline":"지휘관, 이거 찾고 있던 서류 맞지? 내가 찾았어. 어떻게 찾았냐고? ……아미티가 실수로 잘못 들고 나간 건 절대 아니거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/main1.ogg"},"메인2":{"voiceline":"응? 주스가 쓰다고? 어머, 미안. 실수로 주스 대신 아이스 커피를 만들었네♪ 지금 다시 가지고 올 테니까 잠깐 실례할게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/main2.ogg"},"메인3":{"voiceline":"업무를 돕는 것 정도야 해줄 수 있지만, 그 대신 내 부탁을 하나 들어줘야겠어. 아직 뭘 부탁할지 생각 못했으니까, 정하면 말해줄게~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/main3.ogg"},"전투개시":{"voiceline":"사냥감이 걸려들었네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/battle.ogg"},"상세확인":{"voiceline":"다른 사람이랑 친해지는 비결? …딱히 없는데? 아미티는 표정이나 눈치를 살피면서 분위기에 따라 말을 하는 것뿐이라… 뭐라고 할까… 상대방에게 맞춘다고 해야 하나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/detail.ogg"},"드랍 설명":{"voiceline":"범선 - 아미티","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아온 모양이야. 지휘관, 뭐 좋은 걸 들고오진 않았는지 같이 보러 가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/expedition.ogg"},"실망":{"voiceline":"어머, 적당히 거리를 두는 게 어때? 그러는 편이 서로한테 좋겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 한가하면 당신 이야기 좀 더 들려줘. 그러면 아미티에 대해서도 많이 알려줄게~ 지휘관은 나에 대해 더 많이 알고, 나도 지휘관에 대해 더 많이 아는 거지. 어때, 공평하지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/feeling2.ogg"},"호감":{"voiceline":"지휘관, 일이 끝나면 같이 돌아갈까? 모항이 너무 넓어서 나 혼자서는 길을 잃을 수도 있잖아? 후훗, 핑계 대는 거 아니야. 어때, 지휘관. 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 얼마 전에 업무 도와준 대신 부탁할 게 생각났어. 응, 일 끝나면 같이 해변을 산책하는 건 어때? …어머, 다행이네. 그럼, 어서 끝내고 정시에 퇴근하자! 물론 나도 도와줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/feeling4.ogg"},"사랑":{"voiceline":"? 응? 얼굴을 보니 아미티가 여기서 기다릴 거라고는 전혀 예상하지 못한 모양이네. 계속 기다려서 그런지 배가 너무 고파…… 그러니까 같이 야식 먹으러 가 줄 거지? 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/feeling5.ogg"},"터치3":{"voiceline":"지휘관, 아미티의 찰랑거리는 머릿결을 만져본 소감은 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 어서 와~ 후후, 이번에도 한가득 채워서 왔네. 수고했어♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/home.ogg"},"hp 경고":{"voiceline":"어쩔 수 없네…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 업무 관련 서류를 한 장도 남기지 않고 모조리 가지고 왔어. 같이 업무 시작할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/login.ogg"},"실패":{"voiceline":"상황이 이러니 일단은 후퇴하자…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/lose.ogg"},"우편":{"voiceline":"지휘관~ 우편 가지고 왔어. 그 보답으로 아미티에게 뭘 해주려나~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/mail.ogg"},"임무":{"voiceline":"지휘관은 임무가 참 많네… 어서 시작해. 보고만 있는다고 일이 저절로 줄어들지는 않겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/mission.ogg"},"임무완료":{"voiceline":"지휘관~ 으아! 뭘 그렇게 놀라! 보상으로 받은 음료를 볼에 가져다 댄 것뿐인데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/mission_complete.ogg"},"서약":{"voiceline":"반지도 꼈으니 후회해도 이젠 돌이킬 수 없어~ 이제 지휘관은 내 거니까 절대 안 놓칠 거야. 당연히 나도 지휘관 거니까 놓치지 않게 내 손, 꼭 잡아줄 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/propose.ogg"},"스킬":{"voiceline":"가라앉아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/skill.ogg"},"터치1":{"voiceline":"지휘관, 이 병 좀 열어줄래? …어머. 진짜로 안 열려서 도와달라는 거야. 정말이야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/touch.ogg"},"터치2":{"voiceline":"지휘관, 자꾸 이러면 뿔으로 들이받을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/touch2.ogg"},"입수시":{"voiceline":"어머, 지휘관. 나는 아미티야. 앞으로 사이좋게 지냈으면 좋겠어. 그럼 바로 서로에 대해 알아보는 시간부터 가져볼까? 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/unlock.ogg"},"강화성공":{"voiceline":"강해지는 느낌, 좋은데♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"너무 쉽게 이겼네. 이번에도♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/win_mvp.ogg"},"전투개시_ex":{"voiceline":"사냥 시작~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/battle_ex.ogg"},"상세확인_ex":{"voiceline":"응? 아미티한테 주는 거야? 후후, 지휘관… 내 「취향」에 맞춰 주려고 하는 거구나~? 그렇게 나랑 친해지고 싶어? ♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 야식 어디서 먹을지 정했어? 선택지는 내가 몇 개 줄 수 있는데. 이번에는 지휘관이 고르면 내가 사줄게! 어때? 빨리 정해서 출발하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"어머, 오늘은 일이 많네. 자, 지휘관. 어떻게 할래? 아미티한테 도움을 받는 것 말고는 선택지가 없는 것 같은데?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"지휘관, 새로운 임무가 왔어. 빨리 끝낼 수 있게 나도 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"어머~ 지휘관한테 잡혀버렸네♪ 날 어떻게 하려구? 너무 기대되네~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/touch_ex.ogg"},"터치2_ex":{"voiceline":"지휘관이 원한다면 얼마든지 상대해 줄게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"이겼어! 지휘관, 약속한 보상으로 뭘 받을지는 내가 고를 거야. 뭐가 좋을까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['팬시', '포츠머스 어드벤처'] : 이번 사냥감은? ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관은 늘 일정이 빡빡하네… 어디 무슨 수를 써서라도 오늘 지휘관을 하루 종일 독차지할 방법 없나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관, 오늘 일 끝나면 같이 돌아가자. 내가 빨리 끝낼 수 있게 도와줄게. 에이, 이번에는 공짜로 도와줄게♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9600090/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관, 슬슬 눈을 감고