[{"클뜯 id":401180,"클뜯 함순이 id":40118,"함순이 이름":"Z18","한글 함순이 + 스킨 이름":"Z18","영문 함순이 + 스킨 이름":"Z18","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401180/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401180/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401180/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401180/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401180/shipyard.png","설명":"1936년형 구축함 - Z18 한스 뤼데만","자기소개":{"voiceline":"1936년형의 차녀, Z18이에요~ 한스라 불러도 좋지만, 그래도 그건 남자아이 같아서 좀……응? 다른 메탈 블러드의 자매들과 다르다고요? 후훗, 미소는 역시 중요하다구요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401180/profile.ogg"},"메인1":{"voiceline":"메탈 블러드의 모두는 전투광이나 잘 알아듣지 못하는 말만 잔뜩 늘어놓는 아이들이지만…제 임무는 어느 쪽이든 미소 짓게 하는 거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401180/main1.ogg"},"메인2":{"voiceline":"웃는 얼굴은 공포를 이겨내는 처방전이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401180/main2.ogg"},"메인3":{"voiceline":"사람들의 마음 속 깊은 곳엔, 미소가 있으리라 믿고 있어요! 마음만 전해질 수 있으면, 누구라도 미소지을 수 있다고요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401180/main3.ogg"},"전투개시":{"voiceline":"Z18은 모두를 응원해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401180/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 자, 함께~~ 스마일☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401180/detail.ogg"},"드랍 설명":{"voiceline":"1936년형 구축함 - Z18 한스 뤼데만","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 임무를 완료하고 돌아왔어요~ 마중 안 가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401180/expedition.ogg"},"실망":{"voicelin