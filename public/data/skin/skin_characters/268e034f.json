[{"클뜯 id":1101010,"클뜯 함순이 id":110101,"함순이 이름":"에버트센","한글 함순이 + 스킨 이름":"에버트센","영문 함순이 + 스킨 이름":"Evertsen","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101010/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101010/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101010/shipyard.png","설명":"어드미랄렌급 구축함 - 에버트센","자기소개":{"voiceline":"튤리퍼 왕궁 소속 어드미랄렌급 구축함 에버트센입니다. 모항의 자연 생태계에 대해 관찰하며 연구하는 중이죠. 관심 있으시면 다음에 같이 해보시겠어요? 조용히요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/profile.ogg"},"메인1":{"voiceline":"지휘관님, 식물만 보시지 말고 업무에 집중하세요. …네? 이해하시기 쉽게 「식물」이라고 일괄적으로 묶어서 불러드리고 있는데, 궁금하시면 하나하나 설명해 드릴… 물론, 업무를 마친 다음에 말이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/main1.ogg"},"메인2":{"voiceline":"소나무 분재가 예전보다 건강해 보인다고요? 네, 마법을 걸었거든요. 참고하시라고 올바른 재배 방법을 쪽지에 써서 화분에 붙여뒀습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/main2.ogg"},"메인3":{"voiceline":"현미경으로 보시겠어요? 엽상체의 색 배합이 보통보다 진하고, 엽록소 함량도 확연히 늘어났어요… 자연이란 참으로 신비로워요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/main3.ogg"},"전투개시":{"voiceline":"준비가 끝나면 출발하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/battle.ogg"},"상세확인":{"voiceline":"조용히 해주세요. 지금 쌍꼬리부전나비의 산란 과정을 관찰하는 중이니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/detail.ogg"},"드랍 설명":{"voiceline":"어드미랄렌급 구축함 - 에버트센","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔군요. 이번 목적지는… 연구할 만한 가치가 있겠네요. 지휘관님, 이번에는 저도 함께 가게 해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/expedition.ogg"},"실망":{"voiceline":"지휘관님, 조용히 하세요. 이끼를 관찰하는 중이니 방해하지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/feeling1.ogg"},"낯섦":{"voiceline":"이건 제가 만든 소형 열대우림 생태계예요. 관심 있으시면 같이 관찰 일기를 써보는 건 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/feeling2.ogg"},"호감":{"voiceline":"……이 이끼는 예상보다 빠른 속도로 성장하고 있네요. 이거 보세요. 포자낭이 대조군보다 37%나 빨리… 네? 왜 그런 눈으로 보시는 거죠? 너무 말을 한 번에 많이 해서 그런가요…? 에버트센이 웃는 얼굴을 보고 싶었던 것뿐…이라고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님, 방에 있는 식물은 만지시면 안 돼요. 실험용이라 미량이나마 독을 품고 있는 것도 있어서…… 아, 찾았다. 제가 도라지꽃으로 만든 책갈피인데, 지휘관님께 드릴게요. 뒤에 꽃말도 적어뒀어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님 곁에 앉아서 최근 관찰한 데이터를 정리해도 될까요? ……감사합니다. ……네? 너무 가까이 붙어서 신경 쓰인다고요? 그렇지만 햇볕을 쬐려면 이 자리밖에 없어서… 신경이 쓰이는 것뿐이면, 여기 계속 있어도 별문제 없죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/feeling5.ogg"},"터치3":{"voiceline":"치유 마법의 일종인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/headtouch.ogg"},"모항귀환":{"voiceline":"돌아오자마자 바로 일하시는 건가요? ……마법으로 피로를 풀어 드릴 테니, 여기 앉으세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/home.ogg"},"hp 경고":{"voiceline":"괜찮아요. 이 정도는 저 혼자 치료할 수 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/hp_warning.ogg"},"로그인":{"voiceline":"식물이 많은 환경에서는 작업 효율이 상승하니, 틸란드시아와 선인장 화분을 몇 개 가져다 뒀어요. 다 돌보기 어렵지 않은 식물이라…… 그만 보시고 업무에 집중하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/login.ogg"},"실패":{"voiceline":"다친 사람은 없나요? 치료하는 걸 도와드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/lose.ogg"},"우편":{"voiceline":"우편이 왔군요. 잊지 말고 확인하시길.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/mail.ogg"},"임무":{"voiceline":"지휘관님, 임무를 잊지 말고 처리하세요. …먼저 마법으로 피로를 덜어 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/mission.ogg"},"임무완료":{"voiceline":"임무를 모두 완료하셨군요. 고생 많으셨습니다. 잘하셨어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/mission_complete.ogg"},"서약":{"voiceline":"…지휘관님, 이 안개꽃을 드릴게요. 마법으로 가장 아름다운 상태를 유지해 뒀으니, 말라버릴 걱정은 안 하셔도 돼요. ……네, 당신을 향한 제 사랑처럼 시들지 않고 영원히 말이죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/propose.ogg"},"스킬":{"voiceline":"되살아나라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/skill.ogg"},"터치1":{"voiceline":"마침 잘 오셨군요. 오늘 성장 실험에는 조수가 필요한데, 조금 도와주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/touch.ogg"},"터치2":{"voiceline":"……?! 그만하세요… 부끄러워요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/touch2.ogg"},"입수시":{"voiceline":"응? 당신이 지휘관님이신가요? 저는 에버트센… 잠깐만요. 이 기록을 마친 후에 다시 자세히 이야기를 나누죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/unlock.ogg"},"강화성공":{"voiceline":"마력이… 상승했군요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼군요. 다행이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"조용히 하세요… 아니, 소리는 내지 말고 이쪽으로 오세요. 꿀벌잡이노래기벌이 먹이를 노리는 중이니 놀라게 하면 안 되거든요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"식물이 햇빛과 물을 필요로 하듯, 에버트센에게는 지휘관님이 필요해요. 그것은 매우 간단하고도 아주 이해하기 쉬운… 당연한 이치죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"음… 지휘관님에게 치유된 기분이 드네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"피곤해 보인다…고요? 그렇군요… 요즘 며칠간 흰개미와 균류의 공생에 대한 데이터를 정리하고 있었거든요… 후우. 그래도 지휘관님을 보니 피로가 말끔히 풀려요. 이걸 보면 지휘관님도 일종의 「치유 마법」이라고 할 수 있겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관님, 오셨군요. 보세요, 전에 드린 식물에 벌써 꽃이 피었어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"포옹을 원하시나요? 음… 방금 샘플을 만져서… 손을 씻고 난 다음에 바로 해드리죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/touch_ex.ogg"},"터치2_ex":{"voiceline":"체온 상승이나 심박수 증가 모두 아주 자연스러운 생리 현상이에요…… 저는 지휘관님을 좋아…하니까요///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['드 제번 프로빈시엔'] : 패럿 튤립이 생기가 없는 것 같은데… 잠깐 봐주실 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"야래향은 매우 흥미로운 특성을 가지고 있어요. 자세히 설명해도 괜찮다면 설명해 드릴 수 있지만… 정말 듣고 싶으신 건가요? 꽤 길어질 거예요… 음. 그럼 햇볕이 잘 드는 곳으로 이동할까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/main5_ex.ogg"},"메인6_ex":{"voiceline":"업무를 계속 처리하고 싶으니 마법으로 피로를 풀어달라…고요? 안 돼요. 피로를 풀고 싶으신 거면 저랑 함께 밖으로 나가요. 자연과 접하는 것이 가장 피로 회복에 좋아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관님, 업무에 집중하세요… 자꾸 그렇게 보시면, 저까지 집중이 흐트러진다고요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101010/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":11,"레어도":"SR","ex_chat_status":1},{"클뜯 id":1101011,"클뜯 함순이 id":110101,"함순이 이름":"에버트센","한글 함순이 + 스킨 이름":"창문맡 일광욕","영문 함순이 + 스킨 이름":"Basking by the Window","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101011/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101011/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101011/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101011/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101011/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/1101011/shipyard.png","설명":"지휘관님, 아무 데나 편하게 앉으세요. ……왜 그렇게 멀리 앉으시는 거죠? 그러면 일광욕을 하실 수 없잖아요.","자기소개":null,"메인1":{"voiceline":"뭘 그렇게 물끄러미 보시나요? …제왕나비의 이동 궤적에서 발생하는 규칙성 편차에 관심 있으세요? ……그럼 제가 자세히 설명해 드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101011/main1.ogg"},"메인2":{"voiceline":"이건 관찰용 식물인데 독도 없고 사람에게 해롭지 않으니 가까이서 보셔도…… 자, 여기 앉아서 관찰하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/1101011/main2.ogg"},"메인3":{"voiceline":"쉬는 날의 제 모습이 아직 어색한가요? 저한테도 숨 돌릴 틈은 있어야 하니… 지휘관님도 그렇고요. 조금만 더 긴장을 푸시는 게 어때요?","voicelink":"https://raw.githubusercontent.com/Fer