[{"클뜯 id":202180,"클뜯 함순이 id":20218,"함순이 이름":"꼬마 벨파스트","한글 함순이 + 스킨 이름":"꼬마 벨파스트","영문 함순이 + 스킨 이름":"Little Bel","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202180/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202180/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202180/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202180/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202180/shipyard.png","설명":"에든버러급 경순양함 벨파스트 (HMS Belfast)","자기소개":{"voiceline":"할랜드 앤드 울프에서 태어난 벨파스트입니다. 네, 그 타이타닉과 같은 곳이에요. 실은 벨파스트, 언니가 있어요. 그다지 함께하진 못했지만……그리고, 이상이에요. 주인님은 어떤 분인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/profile.ogg"},"메인1":{"voiceline":"위스키랑 커피는……저기, 호, 홍차는 안 되나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/main1.ogg"},"메인2":{"voiceline":"주인님, 벨파스트에게 맡길 일은 없으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/main2.ogg"},"메인3":{"voiceline":"주인님, 지휘관 일을 농땡이 부리면 때찌, 에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/main3.ogg"},"전투개시":{"voiceline":"주인을 위해 위험을 배제하는 건 메이드의 임무죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/battle.ogg"},"상세확인":{"voiceline":"레이디의 인사는 양손으로, 이렇게……죄송해요, 실패했어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/detail.ogg"},"드랍 설명":{"voiceline":"에든버러급 경순양함 벨파스트 (HMS Belfast)","voicelink":null},"의뢰 완료":{"voiceline":"주인님, 의뢰를 완료한 아가씨들이 마중을 기다리고 있다고요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/expedition.ogg"},"실망":{"voiceline":"주인님은 부엌의 때보다도 손이 많이 가네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/feeling1.ogg"},"낯섦":{"voiceline":"다른 배들도 잔뜩……주인님, 지휘관이란 건 굉장한 부자인 조선소 오너란 뜻인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/feeling2.ogg"},"호감":{"voiceline":"긴장하진 않느냐고요? 주인님은 좋은 분이고, 여기 있는 분들 모두 저처럼 상선이 아니니까, 딱히 긴장하고 할 것도 없는걸요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/feeling3.ogg"},"기쁨":{"voiceline":"주인님이 생각하는 건 손바닥 들여다보듯이 잘 알겠어요…그러니까, 이게 말로만 듣던 '이심전심' 이란 건가요? 흐음, 혹시 주인님이 그냥 너무 알기 쉬운 건……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/feeling4.ogg"},"사랑":{"voiceline":"주인님, 벨파스트가 이다음에 크면, 제대로 주인님 마음에 드는 레이디가 될 수 있을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"주인님, 배고파지셨나요? 저도 배가 고파졌어요. 같이 안 드실래요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/home.ogg"},"hp 경고":{"voiceline":"주인님, 퇴각하는 편이 좋을까요……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/hp_warning.ogg"},"로그인":{"voiceline":"주인님, 홍차라도 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/login.ogg"},"실패":{"voiceline":"레이디는 실패했을 때도 우아하게……우으……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/lose.ogg"},"우편":{"voiceline":"주인님, 편지는 이걸로 괜찮나요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/mail.ogg"},"임무":{"voiceline":"주인님, 임무 서류를 저렇게 쌓아둬도 괜찮나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/mission.ogg"},"임무완료":{"voiceline":"임무 보수네요. 벨파스트도 주인님께 봉사하면 보수를 받을 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/mission_complete.ogg"},"서약":{"voiceline":"벨파스트를 인정해준다는 건가요? 고마워요. 그치만…벨파스트가 이 반지를 하게 되면 주인님이 여러모로 오해받을 거 같아서……지, 진짜로 잘 생각해보시는 편이 좋다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/propose.ogg"},"스킬":{"voiceline":"적 여러분, 다음 건 쪼~끔 아플 거에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/skill.ogg"},"터치1":{"voiceline":"주인님, 남에게 너무 기대면 몹쓸 사람이 된다구요. 가끔은 스스로……우윽, 별수 없네요. 이, 이번만…이에요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/touch.ogg"},"터치2":{"voiceline":"주인님, 안심해주세요. 수감되더라도, 벨파스트가 식사를 가져다줄게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/touch2.ogg"},"입수시":{"voiceline":"주인님이 지휘관…그러니까, 여기는 폐하의 방이 아닌가요? 잘 모르겠지만……당분간은 여기 머물러도 되죠? 저는 메이드인 벨파스트입니다, 잘 부탁해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/unlock.ogg"},"강화성공":{"voiceline":"전투에는 익숙하지 않지만, 기대해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/upgrade.ogg"},"vote":null,"승리":{"voiceline":"딱히……대단한 건 아니네요. 그렇죠? 주인님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202180/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"SR","ex_chat_status":0}]