[{"클뜯 id":903030,"클뜯 함순이 id":90303,"함순이 이름":"듀플렉스","한글 함순이 + 스킨 이름":"듀플렉스","영문 함순이 + 스킨 이름":"Dupleix","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903030/shipyard.png","설명":"쉬프랑급 중순양함 - 듀플렉스","자기소개":{"voiceline":"그 대전에서는 통상 파괴 작전에 참여했고, 나중에 침몰하기도 뜨기도 한 쉬프랑급 중순양함 듀플렉스야. 비시아 성좌의 컨시어지를 맡고 있어. 지휘관, 앞으로 사이좋게 지내자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/profile.ogg"},"메인1":{"voiceline":"책무, 책무책무책무…에 또 새로운 책무가…… 이걸 어떻게 다 처리하라는 거야…… 헉?! 크흠, 지휘관… 언제부터 있었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/main1.ogg"},"메인2":{"voiceline":"없어… 얼마 전에 쇼핑 가서 산 걸 또 잊어버렸어… 지, 지휘관… 어떡하면 좋지??","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/main2.ogg"},"메인3":{"voiceline":"클레망소 님 같은 매니지먼트 능력만 있었다면 지휘관과의 휴식 시간을 확보할 수 있었을 텐데…… 미안해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/main3.ogg"},"전투개시":{"voiceline":"더는 성스러운 책무를 늘리지 않기 위해서라도… 화려하게 흩어져 버려!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/battle.ogg"},"상세확인":{"voiceline":"그날그날 성스러운 책무를 처리하지 않으면, 시효성이 사라져서 다음날에 리스크가 되서 돌아오잖아. 그래서 책무를 끝내기 전까지는 쉴 수 없는 거야. 그 느낌 알아? 일을 다 끝내지도 못했는데 쉬어야 할 때, 그 온몸이 지끈거리면서 짜증이 치미는 느낌…… 그거 진짜 최악이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/detail.ogg"},"드랍 설명":{"voiceline":"쉬프랑급 중순양함 - 듀플렉스","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료됐어, 지휘관. 이건 기입을 완료한 물자 목록이야. 확인해 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/expedition.ogg"},"실망":{"voiceline":"일이 밀려드는 원인을 찾았어…… 지휘관이었지? 지휘관 때문인 거 맞지?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/feeling1.ogg"},"낯섦":{"voiceline":"이렇게 많은 책무를 앞에 두고 얼굴색 하나 변하지 않다니, 지휘관은 정말 대단해. 나도…… 좀 더 정신을 차려야지. 난… 지휘관의 누나니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/feeling2.ogg"},"호감":{"voiceline":"지휘관 앞에서는 나도 모르게 긴장이 풀려서, 결국은 지휘관에게 기대고 말아…… 으으, 이대로는 안 돼! 듀플렉스는 지휘관에게 든든한 누나가 되어 줘야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/feeling3.ogg"},"기쁨":{"voiceline":"지휘관~ 내기 하나 할래? 만약… 오늘 누나가 예정보다 빨리 책무를 모두 처리하면, 지휘관의 휴식 시간을 전부…… 정말?! 알았어! 절대 안 질 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/feeling4.ogg"},"사랑":{"voiceline":"드디어 오늘 밤에는 승부를 내겠네…… 전부 계획대로 잘 흘러가고 있고…… 자, 잠깐?! 이 시간에 추가로 책무가 들어오다니, 그게 말이 돼?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/feeling5.ogg"},"터치3":{"voiceline":"워라벨이라…… 그러니까 좀 쉬라는 거지? 지휘관, 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/headtouch.ogg"},"모항귀환":{"voiceline":"어서 와, 지휘관. 이쪽은 정리가 끝난 거고, 네 몫도 일단은 같이 해 뒀어. 그럼, 같이 쉴까? 이제 휴식 시간 맞지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/home.ogg"},"hp 경고":{"voiceline":"역시 난 이런 거에는 소질이 없어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/hp_warning.ogg"},"로그인":{"voiceline":"오늘 일은 반드시 오늘 내로 처리해야 해. 지휘관, 각오는 되어 있지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/login.ogg"},"실패":{"voiceline":"전투 실패 회고…… 자원 손실…… 하, 하하하…… 내 수면 시간과 지휘관과의 데이트 계획이……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/lose.ogg"},"우편":{"voiceline":"지휘관 앞으로 우편이 왔어. 늦지 않게 확인해 줘. 꼭 확인해야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/mail.ogg"},"임무":{"voiceline":"새로운 임무…… 지휘관, 일이 너무 많은 거 아니야? 내 쪽으로 좀 돌리는 편이 낫지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/mission.ogg"},"임무완료":{"voiceline":"임무 완료! 드디어 성스러운 책무가 하나 끝났네…… 지휘관 덕분이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/mission_complete.ogg"},"서약":{"voiceline":"지휘관, 왜 그래? 책무가 끝나자마자 부랴부랴 말을 다 걸고… 눈을 감아보라고? 알겠는데, 왜… 뭐? 이, 이거… 설마 나한테?! 가, 갑자기 왜 눈물이…… 아아, 드디어… 드디어 이걸 내 손에 넣었어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/propose.ogg"},"스킬":{"voiceline":"사무직을 깔보지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/skill.ogg"},"터치1":{"voiceline":"어머…… 이게 지휘관의 스트레스 해소법이야? 꽤 개성적이네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/touch.ogg"},"터치2":{"voiceline":"지, 지휘관… 그 손으로 뭘……?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/touch2.ogg"},"입수시":{"voiceline":"나는 비시아 성좌 소속 컨시어지인 듀플렉스야. 지휘관, 시간은 우릴 기다려주지 않으니… 자, 여기 오늘 일정표야. 어서 성스러운 책무를 시작하자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/unlock.ogg"},"강화성공":{"voiceline":"손발 끝이 따끈따끈해서…… 기분 좋아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/upgrade.ogg"},"vote":null,"승리":{"voiceline":"괜찮은 전투 보고서를 남기려면 빨리 복귀하는 편이 좋을 것 같은데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"(헉…? 누나 강제 야근 금지 데이라고…?! 지휘관도 참, 이런 짓궂은 장난을… 윽… 안 지키면 데이트를 안 할 거라니… 어, 어떻게든 참아내고야 말겠어…! ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"오늘은 꼭 성공할 거야… 지휘관이랑 단둘이고, 「필살 아이템」도 준비했으니까…… 그래… 지금 누나는 무적이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":{"voiceline":"어서 와, 지휘관. 지금은 지휘관의 휴식 시간이지만, 누나의 휴식 시간이기도 해. 그, 그러니까 그…… 그게 무슨 말인지는… 알지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관이 오기 전에 우선순위대로 서류를 정리해 뒀어. 호, 혹시 한가하면 조금 이따가 일 끝나고 같이 어디든…… 어, 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관이 있으면 쿠션도 필요 없겠네. ……좋아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/touch_ex.ogg"},"터치2_ex":{"voiceline":"지휘관은… 이런 몸도 괜찮아…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['쉬프랑'] :  쉬프랑, 다음 쉬는 날에 같이 외출이라도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/couple_encourage1.ogg"},{"voiceline":"['포슈'] :  포슈, 내가 지원할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"책무… 드디어 책무가 끝났어! 신난다! 다음은…… 아… 이제 곧 새벽이잖아?! 그, 그럼 같이 산책하다가 일출 보러 가도… 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/main5_ex.ogg"},"메인6_ex":{"voiceline":"에취! 쌀쌀하네…… 응? 지휘관이 따뜻하게 해주려고…? 후후후, 지휘관은 정말 따뜻하네♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"사실은 여러 업무에서 활약하고 있어. 후후후, 전투의 전날 밤…… 존재할 리 없던 알마(Alma)… 지휘관, 그게 궁금하면 누나랑 데이트해야 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903030/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"MNF","레어도":"SR","ex_chat_status":1},{"클뜯 id":903031,"클뜯 함순이 id":90303,"함순이 이름":"듀플렉스","한글 함순이 + 스킨 이름":"Final Check","영문 함순이 + 스킨 이름":"Final Check","스킨 타입":"Race Queen","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903031/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903031/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903031/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903031/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903031/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/903031/shipyard.png","설명":"지휘관, 마침 잘 왔어. 사실 확인해야 하는 파라미터가 있는데… 자, 안전과 관련된 문제니까 검사 담당으로서 그냥 내버려둘 수는 없잖아? …일단 내 옆에 앉아봐.","자기소개":null,"메인1":{"voiceline":"레이스가 끝나도 처리할 일은 줄어들지 않아…… 생각만 해도 피곤해…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/main1.ogg"},"메인2":{"voiceline":"(검사가 끝나면 꼭 최고의 관전 지점을 찾고 말겠어. 지휘관의 레이스만은 절대로 놓칠 수 없어…!)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/main2.ogg"},"메인3":{"voiceline":"덥네… 응? 나한테? 고, 고마워… 누나한테 마실 것도 다 가져다주고, 정말 기뻐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"검사 담당으로서 레이스가 시작되기 전에 되도록 상세하게 확인을 하는 게 내 의무야. 안전에 관련된 건 모두 기준점을 충족해야 해. 물론 지휘관이 몸에 걸치고 있는 것도 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/detail.ogg"},"드랍 설명":{"voiceline":"지휘관, 마침 잘 왔어. 사실 확인해야 하는 파라미터가 있는데… 자, 안전과 관련된 문제니까 검사 담당으로서 그냥 내버려둘 수는 없잖아? …일단 내 옆에 앉아봐.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"확실히 일 때문에 바쁘기는 하지만, 지휘관이 차를 타고 코스를 질주할 걸 생각하면 아무리 힘든 업무라도 별거 아닌 것처럼 느껴져. 뭐, 그래도 열심히 일한 만큼 보상을 받고 싶은 게 누나의 솔직한 마음인데… 지휘관, 보답해 줄 거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/feeling5.ogg"},"터치3":{"voiceline":"좌석에 안전벨트… 차량용 소화기도 문제없어. 지휘관, 이제 안심이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 고생이 많아. 마침 이쪽도 일단락된 참이니… 누나랑 같이 쉬지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"체크리스트 항목이 이렇게나…… 지, 지휘관?! 잠깐만 기다려…… 금방 정리할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"레이스가 끝나면 또 평소 페이스로 돌아가네. …있잖아, 지휘관. 지금 잠깐 누나랑 데이트할래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/touch.ogg"},"터치2":{"voiceline":"꺅?! 지휘관, 이 검사가 끝난 다음에……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/touch2.ogg"},"입수시":{"voiceline":"지휘관, 마침 잘 왔어. 사실 확인해야 하는 파라미터가 있는데… 자, 안전과 관련된 문제니까 검사 담당으로서 그냥 내버려둘 수는 없잖아? …일단 내 옆에 앉아봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/903031/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":nu