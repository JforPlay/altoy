[{"클뜯 id":11300020,"클뜯 함순이 id":1130002,"함순이 이름":"아일라 폰 뒤러","한글 함순이 + 스킨 이름":"아일라 폰 뒤러","영문 함순이 + 스킨 이름":"Isla von Duerer","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300020/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300020/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300020/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300020/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300020/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11300020/shipyard.png","설명":"나는 아일라 폰 뒤러! 아일라라고 불러! 유스테라 기사단 소속이고, 알라디스 조사단에도 참여하고 있는데… 어쩌다 이런 곳에 와 버린거지!? 너, 뭐 아는 거 없어?","자기소개":{"voiceline":"아일라 폰 뒤러야. 기사단에 소속되어 있어! 기사단에서는 여러가지 업무를 담당하고 있지! 예를 들면 마물퇴치라던가… 그런 건 지금은 상관없나? 아, 아무리 전투 중이라도 패션을 포기할 순 없어! 패션의 최첨단을 향해 가보자구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/profile.ogg"},"메인1":{"voiceline":"이곳에 와서 여러가지 굉장한 기술을 체험할 수 있었어. 그렇지만 이것은 연금술이 아니라고 하고……정말, 세계는 미스터리로 가득차 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/main1.ogg"},"메인2":{"voiceline":"원래 세계라면 모험을 하러 가면 모피라던가 손에 넣었지만, 이세계에서는 어려울것 같…에? 해수라면 손에 넣을 수 있어? 그렇다면 흥미가 생기는데……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/main2.ogg"},"메인3":{"voiceline":"지휘관의 옷을 꿰매봤는데…어때? 멋있는 것 부터 귀여운 것까지 여러가지 준비할 테니까…입어 봐주지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/main3.ogg"},"전투개시":{"voiceline":"그럼 간다~! 다들 조심해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/battle.ogg"},"상세확인":{"voiceline":"나, 옷이나 액세서리 같은 거에 관심이 있어! 여기 디자인은 종류가 다양해서 굉장히 흥미로워!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/detail.ogg"},"드랍 설명":{"voiceline":"나는 아일라 폰 뒤러! 아일라라고 불러! 유스테라 기사단 소속이고, 알라디스 조사단에도 참여하고 있는데… 어쩌다 이런 곳에 와 버린거지!? 너, 뭐 아는 거 없어?","voicelink":null},"의뢰 완료":{"voiceline":"기사단 같은 애들이 돌아왔다던데. 좋아! 맞이하러 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/expedition.ogg"},"실망":{"voiceline":"뭐, 인정을 베풀어 두는 편이 나중에 뭔가 도움이 될 것 같기는 한데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/feeling1.ogg"},"낯섦":{"voiceline":"아하하, 그렇게 격식 차릴 필요 없어! 서로 편하게 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/feeling2.ogg"},"호감":{"voiceline":"어라? 지휘관, 한가하면 나랑 쇼핑하러 갈래? 분명 재밌을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/feeling3.ogg"},"기쁨":{"voiceline":"응, 뭐든 말해도 돼. 우리는 친구잖아? 힘이 될 수 있다면 돕고 싶은 건… 당연한 거잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/feeling4.ogg"},"사랑":{"voiceline":"내가 여기 온 데에는 분명 굉장히 중요한 이유가 있을 것 같은데… 지휘관 곁에서라면 찾을 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/feeling5.ogg"},"터치3":{"voiceline":"응? 지금 필요한 거 있어? 괜찮아, 내가 도와줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 어서와. 어땠어? 잘하고 왔어? 아하, 그랬구나.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/home.ogg"},"hp 경고":{"voiceline":"이 정도쯤은 아무것도 아니지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/hp_warning.ogg"},"로그인":{"voiceline":"좋아! 지휘관, 오늘도 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/login.ogg"},"실패":{"voiceline":"아야야… 정말! 조금은 봐줘야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/lose.ogg"},"우편":{"voiceline":"그러고 보니 지휘관 앞으로 모두가 보낸 편지가 와있더라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/mail.ogg"},"임무":{"voiceline":"힘들다고 임무를 뒤로 미루면 나중에 큰일 날 걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/mission.ogg"},"임무완료":{"voiceline":"이쪽 임무는 끝났어! 방치하면 안 돼, 절대!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/mission_complete.ogg"},"서약":{"voiceline":"어휴, 놀리지 마! 갑자기 그런 말을 하면 나… 어떻게 대답해야 할지…… 뭐랄까, 아직 이 관계가… 아직 익숙해지 않은 걸지도 몰라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/propose.ogg"},"스킬":null,"터치1":{"voiceline":"응? 어딘가 찢어졌어? 괜찮아! 이래 봬도 나, 수선은 어느 정도 할 수 있거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/touch.ogg"},"터치2":{"voiceline":"응!? 잠깐! 뭐하는거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/touch2.ogg"},"입수시":{"voiceline":"나는 아일라 폰 뒤러! 아일라라고 불러! 유스테라 기사단 소속이고, 알라디스 조사단에도 참여하고 있는데… 어쩌다 이런 곳에 와 버린거지!? 너, 뭐 아는 거 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/unlock.ogg"},"강화성공":{"voiceline":"어때? 이걸로 또 강해졌어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/upgrade.ogg"},"vote":null,"승리":{"voiceline":"성공! 내가 이겼어!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/win_mvp.ogg"},"전투개시_ex":{"voiceline":"준비는 끝났어? 그럼, 출발!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/battle_ex.ogg"},"상세확인_ex":{"voiceline":"연금술 같이 신기한 걸 지금까지 여러가지 경험해 왔지만, 여기서 일어나는 일은 또 다른 재미를 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"언젠가는 원래 세상으로 돌아가게 될지도 몰라. 하지만 그렇게 되더라도 여기서 쌓은 경험이 다 사라지는 건 아니고… 어떤 형태로든 연결된 마음은 언제까지고 남아 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/feeling5_ex.ogg"},"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"좋은 아침. 처음으로 만나는 사람이 지휘관이라니, 오늘도 좋은 날이 되겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"봐, 아직 일이 덜 끝났잖아! 힘내자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/mission_ex.ogg"},"임무완료_ex":{"voiceline":"오! 일이 끝났다고? 대단해~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"꼬옥~ 안아줬으면 하면 안아달라고 확실히 말해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"굉장해… 굉장하다구, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['유미아 리스펠트'] : 앞은 네게 맡길게, 유미아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/couple_encourage1.ogg"},{"voiceline":"['니나 프리드'] : 니나 씨, 방금 공격 너무 멋졌어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/couple_encourage2.ogg"},{"voiceline":"['레이냐'] : 레이냐, 다음 공격에 맞춰!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/couple_encourage3.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관, 여기서 옷 같은 걸 좀 보고 싶은데… 응? 안내해 주려고? 좋아! 그럼 바로……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11300020/main5_ex.ogg"},"메인6_ex":{"voiceline":"응, 무기 정리랑 전투 준비는 내가 할 테니까, 지휘관은 쉬고 있어! 그게 지금 지휘관이