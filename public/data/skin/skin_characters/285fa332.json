[{"클뜯 id":302240,"클뜯 함순이 id":30224,"함순이 이름":"노시로(μ장비)","한글 함순이 + 스킨 이름":"노시로(μ장비)","영문 함순이 + 스킨 이름":"Noshiro μ","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302240/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302240/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302240/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302240/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302240/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/302240/shipyard.png","설명":"아가노급 2번함 노시로, 지금부터 \"μ장비\" 실험 임무를 시작합니다. 아이돌 활동도 작전 임무도 모두 전력을 다해 도전할 생각이니 걱정하지 않으셔도 돼요.","자기소개":{"voiceline":"아가노 언니와 사카, 그리고 무엇보다 당신의 기대에 부응하기 위해… 경순양함 노시로는 오늘도 아이돌 레슨 임무를 완수하고 있어요. 지금 느낌은 어떤가요? \"Alizarin\"의 멤버로서 만족스러우신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/profile.ogg"},"메인1":{"voiceline":"아이돌 활동을 할 때는 영양 섭취에도 더욱 신경을 써야겠죠… 말이 나온 김에 당신의 세 끼 식사도 제가 관리해 드리는 건…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/main1.ogg"},"메인2":{"voiceline":"애드리브도 좋지만… 계획에 없는 걸 하는 건 아무래도 불안해요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/main2.ogg"},"메인3":{"voiceline":"일하는틈틈이쉬는 것도 중요해요. 차라도 가지고 올까요? 너무 뜨거워지지 않도록 조심할 테니 걱정하지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/main3.ogg"},"전투개시":{"voiceline":"리허설 때처럼 싸워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/battle.ogg"},"상세확인":{"voiceline":"차분하게 뒤돌아보면서 레슨을 모두 마치고, 한 순간의 퍼포먼스를 영원한 빛으로 만드는… 제가 목표로 하는 아이돌은 그런 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/detail.ogg"},"드랍 설명":{"voiceline":"아가노급 2번함 노시로, 지금부터 \"μ장비\" 실험 임무를 시작합니다. 아이돌 활동도 작전 임무도 모두 전력을 다해 도전할 생각이니 걱정하지 않으셔도 돼요.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료되었어요. 당신 계획대로군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/expedition.ogg"},"실망":{"voiceline":"지휘관님, 자꾸 그러시면 훈련에 지장이 초래될 수 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/feeling1.ogg"},"낯섦":{"voiceline":"바쁘신데 일부러 레슨 임무를 보러 와주셔서 감사합니다. …그나저나 어떤가요? 노시로의 퍼포먼스 중에 개선할 부분이라도 있었나요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/feeling2.ogg"},"호감":{"voiceline":"\"Alizarin\"의 비매품 응원 굿즈와 노시로의 사인… 괜찮으시면 받아주시겠어요? 후후후, 이런 풋풋한 느낌도 가끔씩은 괜찮겠죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/feeling3.ogg"},"기쁨":{"voiceline":"노래할 때 모습이 멋지다고요…? 가, 감사합니다… 그 말은 노시로가 아직 안정감과는 거리가 멀다는 의미일까요…? 후후후, 역시 그렇군요. 당신은 늘 그렇게 아무렇지 않은 듯 칭찬해 주시죠. ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/feeling4.ogg"},"사랑":{"voiceline":"이건… 당신에게만 드리는 특별한 굿즈예요. 부디 받아주시길… 이 붉은 자국은… 음... 이건 입술…… 아니, 아무것도 아니에요.///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/feeling5.ogg"},"터치3":{"voiceline":"응? 머리가 흐트러졌다고요? 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/headtouch.ogg"},"모항귀환":{"voiceline":"후우…… 쿨…… 아, 지, 지휘관님…… 어서 오세요. 죄송해요, 그만 잠이 들어서… 새로운 레슨 임무인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/home.ogg"},"hp 경고":{"voiceline":"다들 정신 차려요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님, 어서 오세요. 오늘 레슨 계획 기안은 이미 작성했습니다. 여기…… 음… 이건 노시로가 할일이 아니라 당신이 할일이라고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/login.ogg"},"실패":{"voiceline":"역시 연습이 부족……한 건가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/lose.ogg"},"우편":{"voiceline":"우편…? 새로운 라이브 임무인가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/mail.ogg"},"임무":{"voiceline":"임무를 완수하는데 노시로의 도움이 필요한가요? 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어요. 역시 당신은 의지가 되네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/mission_complete.ogg"},"서약":{"voiceline":"생각보다 더 빨리 이 날이 찾아왔군요… 알고 있어요. 더 큰 무대로 같이 올라가고 싶어서 못 참겠다는 거죠? 당신이라면 분명……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/propose.ogg"},"스킬":{"voiceline":"기회다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/skill.ogg"},"터치1":{"voiceline":"당신… 방금 건 지도하려고 그러신 거… 맞죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/touch.ogg"},"터치2":{"voiceline":"그, 그만하세요…… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/touch2.ogg"},"입수시":{"voiceline":"아가노급 2번함 노시로, 지금부터 \"μ장비\" 실험 임무를 시작합니다. 아이돌 활동도 작전 임무도 모두 전력을 다해 도전할 생각이니 걱정하지 않으셔도 돼요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/unlock.ogg"},"강화성공":{"voiceline":"실력이 향상됐어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"이 노랫소리와 지휘관님이 준 용기만 있으면 누구에게도 지지 않을 것 같아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/302240/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_e