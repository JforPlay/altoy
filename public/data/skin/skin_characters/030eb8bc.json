main/audio/voiceline/307058/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요, 지휘관님. 후후…… 잠깐 서로 따로 행동을 하는 새에 제가 그리워지신 것 같네요? 당연히 저도 마찬가지랍니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307058/login.ogg"},"실패":{"voiceline":"선배님들이 웃으시겠네요… 지휘관님, 죄송하지만… 몇 마디 거들어주실 수 있으세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307058/lose.ogg"},"우편":null,"임무":{"voiceline":"지휘관님과의 이 평온한 시간을 좀 더 즐기고 싶지만… 임무를 완수하는 것도 잊지 마세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307058/mission.ogg"},"임무완료":{"voiceline":"임무가 완료되었네요. 지휘관님은 변함없이 의지가 되는 분이세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307058/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"이번에는 지휘관님이 쇼카쿠의 몸을 주물주물할 차례인가요? 감사합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307058/touch.ogg"},"터치2":{"voiceline":"지휘관님께서 기대하고 계시던 것… 전력을 다해 이뤄드리죠…♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307058/touch2.ogg"},"입수시":{"voiceline":"지휘관님과 친밀한 관계를 맺으면서 지금까지 행복한 추억을 많이 쌓았죠. 앞으로는 새로운 목표를 향해 재출발! …이라고 할까요? 후후, 방금 건 농담이 아니라 진담이랍니다. 모자란 몸이지만, 앞으로 잘 부탁드려요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307058/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"지휘관님의 자랑스러운 승리… 쇼카쿠에게 있어서도 자랑스러운 활약이랍니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307058/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"지휘관님, 여기 볼일이 끝나면 아카기 선배가 뭐 하는지 보러 갈까요? 당고를 좋아하신다고 하길래, 선물로 좀 드릴까 하고요♪","voicelink":"https://raw.githubusercontent.c