[{"클뜯 id":307050,"클뜯 함순이 id":30705,"함순이 이름":"쇼카쿠","한글 함순이 + 스킨 이름":"쇼카쿠","영문 함순이 + 스킨 이름":"Shoukaku","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/307050/shipyard.png","설명":"쇼카쿠형 항공모함·쇼카쿠","자기소개":{"voiceline":"선배들이 먼저 이 세상을 떠버리는 바람에, 항공부대의 중심을 담당하게 되었습니다. 여동생과 선배들 이상으로 노력했는데, 왜인지 약하다는 이미지가 생겨버려서…… 다시 소개 올리지요, 사쿠라 엠파이어의 '피해 담당', 쇼카쿠입니다. 잘 부탁드려요, 우후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/profile.ogg"},"메인1":{"voiceline":"1항전 선배들에게 휘둘려져선, 지휘관도 큰일이네요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/main1.ogg"},"메인2":{"voiceline":"이전엔 가해자와 피해자였지만…앞으로도 잘 부탁드려요, 렉싱턴씨.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/main2.ogg"},"메인3":{"voiceline":"즈이카쿠, 이글 유니온의 동료들에게 또 폐를 끼치면, 오늘밤 덴푸라는… 양을 늘려놓을게? 우후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/main3.ogg"},"전투개시":{"voiceline":"완성형 정규 항공모함… 쇼카쿠, 갑니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/battle.ogg"},"상세확인":{"voiceline":"이 피리 소리는 망자를 달래는 진혼곡…… 지휘관, 한 곡 어떠신지요? 우후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/detail.ogg"},"드랍 설명":{"voiceline":"쇼카쿠형 항공모함·쇼카쿠","voicelink":null},"의뢰 완료":{"voiceline":"마루5계획을 위해, 의뢰임무 수행도 필요하네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/expedition.ogg"},"실망":{"voiceline":"지휘관이…… 아카기 선배에게 찔리는 미래가 보여요. 우후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/feeling1.ogg"},"낯섦":{"voiceline":"여동생과 그 가장 험했던 2년 간을 견뎌냈지만, 그 '선배' 들이 좀 더 노력해 줬으면 했었어요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/feeling2.ogg"},"호감":{"voiceline":"선배에 대한 불만? 네에, 있고 말고요~ 그런 상황을 만들어놓고, 뻔뻔하게 할 말은 있나봐요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/feeling3.ogg"},"기쁨":{"voiceline":"들어주세요 지휘관! 선배들은 치사해요! 조금만 더 하면 앞지를 수 있었는데… 또 금방 한참 위로 가버리고! 정말이지… 진짜 치사해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 잠시 어깨를 빌릴 수 있을까요? …응… 제게도 멍하니 있고 싶어질 때가 있답니다…… 앞으로도, 이렇게 바싹 붙어있어도 될까요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"모두 무사히 모항에 돌아왔네요. 그래요, 우리들 5항전 처럼, 말이죠♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/home.ogg"},"hp 경고":{"voiceline":"반대쪽에 주수! 서둘러!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/hp_warning.ogg"},"로그인":{"voiceline":"지성은 여자의 매력이라고 합니다만…… 덕분에 '선배들' 과는 자주 껄끄러워져요… 우후훗, 곤란하네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/login.ogg"},"실패":{"voiceline":"히류 선배라면 가라앉을 때까지 싸울지도 모르지만… 전 달라요. 우후훗, 유감이네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/lose.ogg"},"우편":{"voiceline":"본부로 부터, 함대 결전 작전을 결행하라 우편이…… 우후훗♪지금 건 농담이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/mail.ogg"},"임무":{"voiceline":"임무를 확인해볼게요. ……산호해가 아니구나, 아쉽네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/mission.ogg"},"임무완료":{"voiceline":"점감 요격… 실행 안 하시나요? 칫","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/mission_complete.ogg"},"서약":{"voiceline":"이 피리가 연주하는 선율은, 진혼곡이 아니랍니다── 5항전·쇼카쿠, 앞으로는 계속, 당신의 곁에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/propose.ogg"},"스킬":{"voiceline":"언니의 특권입니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/skill.ogg"},"터치1":{"voiceline":"지휘관, 이 피리 소리, 들어보지 않으시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/touch.ogg"},"터치2":{"voiceline":"지휘관, 이 쇼카쿠에게 더욱 빠져들어도 괜찮아요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/touch2.ogg"},"입수시":{"voiceline":"제5 항공전대 기함, 쇼카쿠입니다. ……1항전 선배님들에 대해? …\"선배들을 목표로 힘내겠습니다!\"는 어떤가요? 후훗♪ 지금 건 일·부·러 한 거랍니다?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/unlock.ogg"},"강화성공":{"voiceline":"이걸로 즈이카쿠를 더 잘 지킬 수 있겠네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"5항전의 영광, 이곳에 있나니! …우후훗♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['즈이카쿠'] : 즈이카쿠, 전력 출격이야! 내가 엄호할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/couple_encourage1.ogg"},{"voiceline":"['아카기'] : 제 실력을 보셨나요? 아카기 선배!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/307050/couple_encourage2.ogg"},{"voiceline":"['카가'] : 이번에야말로… 반드시 인정하게 만들어줄 테니까!","voicelink":null