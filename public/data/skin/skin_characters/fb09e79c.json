nando2603/AzurLane/main/images/skin/207024/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207024/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207024/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/207024/shipyard.png","설명":"좋아, 지휘관. 이 가게에 들어가자. 주문은 어떻게 할래? 나도 똑같은 걸 주문하려고 하는데…. 뭘, 가끔은 같이 커피라도 한잔할까 해서 말이지.","자기소개":null,"메인1":{"voiceline":"으음, 이 원두는 향기가 훌륭하군. …그렇게 의외라는 표정을 짓다니, 이거 섭섭한데? 나도 이렇게 커피를 즐길 때 정도는 있다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207024/main1.ogg"},"메인2":{"voiceline":"각, 각하… 그 카메라는 왜 들고 있는 거지?! 서, 설마… 다 들킨 건가?! …응? 각하의 개인 소지품이라고? …그렇군, 훗…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207024/main2.ogg"},"메인3":{"voiceline":"매장 내부는 늘 녹화 중이다. 어디까지나 안전을 지키기 위해서 그런 거란 걸 말해두지. 수상쩍은 부분은 아무것도 없다! 전혀!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207024/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"이 가게에는 몇 번 와본 적이 있다만… 평소 행실 때문인지 구축함 동생들과 가까운 자리로는 안내해주지 않더군…. 그렇지만 상관없다. 다 예상한 일이니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207024/detail.ogg"},"드랍 설명":{"voiceline":"좋아, 지휘관. 이 가게에 들어가자. 주문은 어떻게 할래? 나도 똑같은 걸 주문하려고 하는데…. 뭘, 가끔은 같이 커피라도 한잔할까 해서 말이지.","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"구축함 동생들도 무사히 돌아온 것 같아 안심했다. 무슨 일이 생길 것 같으면 내가 곁에… 아니, 방금 말은 잊어라. 난 여기서 한 발짝도 벗어나지 않을 테니. 알겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207024/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"돌아온 모양이군. 사실은 슬슬 돌아올 거라고 '알고 있었다'만 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207024/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"안 된다! 구축함 동생들