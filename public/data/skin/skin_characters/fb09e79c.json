소개":null,"메인1":{"voiceline":"거기! 줄 제대로 서라! 위험하니까 끼어들지 마! …각하, 어때? 너무 고압적이라고 뭐라고 하진 않겠지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/main1.ogg"},"메인2":{"voiceline":"이 키재기판은 어린이 가격 적용 여부를 판단하기 위한 것이지, 절대 구축함 동생들에게 접근하기 위해서 가져온 게 아니라고! ……지휘관도 재볼 텐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/main2.ogg"},"메인3":{"voiceline":"왜 질서 유지 담당에 지원했냐고? 음, 그야 내 마음에 품은 정의와 질서에 대한 동경 때문이지! …변명이 너무 어설프다고? 쿨럭, 쿨럭…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"각하! 놀러 온 건가? 나는 지금 유원지의 질서 유지를 담당하고 있지! 재밌을 것 같다고…? 그럼 각하, 마음껏 견학해라!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"일이 끝난 다음 계획 말인데… 이 유원지, 밤에는 불꽃놀이가 열린다더군. 크흠. …각하, 괜찮으면 같이 보지 않겠나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/feeling5.ogg"},"터치3":{"voiceline":"지금은 만져도 되지만… 질서를 정돈할 때는 만지지 않았으면 하는군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/headtouch.ogg"},"모항귀환":{"voiceline":"응? 각하가 돌아왔군. 유원지 상태가 걱정돼서 왔다고…? 아무 문제 없으니 안심해라! 이 정도 질서 유지쯤이야 식은 죽 먹기지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"각하, 어디부터 돌아볼 건가? 타고 싶은 놀이기구는? 원하면 내가 주변에 있는 재밌는 어트랙션을 소개해 주지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"각하, 마음껏 놀기 전에 우선은 임무를 모두 처리하는 편이 좋을 거다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"질서 유지 일이 끝난 다음에는 뭐 할 거냐고? 음…… 아직 생각 안 해봤는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/207025/touch.ogg"},"터치2":{"voiceline":