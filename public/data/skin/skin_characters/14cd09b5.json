ontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/main1.ogg"},"메인2":{"voiceline":"냐하하하☆ 블뤼허가 너무너무너무 좋아하는 지휘관을 지켜줄게♪ 어때? 블뤼허 곁에 있으면 마음이 푹 놓이지? 전혀? …히잉T_T","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/main2.ogg"},"메인3":{"voiceline":"드래곤 파이어! 뜨거운 숨결이 느껴져? 냐하하하☆ 블뤼허가 지휘관을 좋아하는 마음도 드래곤에게 지지 않을 정도로… 으아아아?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/main3.ogg"},"전투개시":{"voiceline":"드래곤 나이트! Los! Los!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/battle.ogg"},"상세확인":{"voiceline":"같이 하늘을 날아보고 싶다고 생각한 적은 있지만, 드래곤을 타고 날아갈 거라곤 생각도 못했어…… 냐하☆ 지휘관! 블뤼허를 꽉 껴안고 있어~ 안 그러면 떨어질… 으아아아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/detail.ogg"},"드랍 설명":{"voiceline":"냐하☆ 마왕군 소속 드래곤 나이트, 블뤼허야~ …드래곤을 조종하는 게 아니라 끌려다니는 것 같다고? 그건 사실인데… 으아아아! 드래곤이 내 말을 안 들어! 지휘관, 도와줘~!","voicelink":null},"의뢰 완료":{"voiceline":"으음~ ……드래곤을 타고 있으니까 다들 어디에 있는지 잘 보이네! 어서 마중하러 나가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"블뤼허랑 여기저기 더 많이 가보고 싶다고? …냐하♡ 물론, 좋아! 너무너무너무 좋아하는 지휘관, 다음은 어디로 갈까? 이 세상이 아무리 넓다고 해도, 드래곤을 타고 있으면 어디든 금방 갈 수 있어! 응! 그럼, 출발♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"사, 살아서 돌아왔네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"냐, 냐하…☆ 지, 지휘관… 드래곤을 타고 같이 바람을 느낄 준비는 됐어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/login.ogg"},"실패":{"voiceline":"윽…… 드래곤 나이트라는 거, 꽤 힘드네… 정말! 이 상처 입은 블뤼허의 영혼을 달래려면 지휘관의 키스가 필요해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/lose.ogg"},"우편":{"voiceline":"새로운 우편…… 아니, 으아아! 브레스를 뿜으면 어떡해! 지휘관한테 줄 러브레터도 들어있단 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/mail.ogg"},"임무":{"voiceline":"냐, 냐하☆ 지휘관, 빨리 임무 처리하고 블뤼허 좀 도와줘…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/mission.ogg"},"임무완료":{"voiceline":"냐하☆ 지휘관과 쌓은 새로운 추억은 좀 요란스러웠지~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관도 드래곤을 조종해서 날고 싶어? 배우고 싶으면 뭐든 블뤼허가 알려줄게♪ 응…… 아마도!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/touch.ogg"},"터치2":{"voiceline":"으아?! 이런 상황에서도 하는 거야…? 저, 적어도 얘가 좀 얌전하게 날기 시작한 다음에…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/touch2.ogg"},"입수시":{"voiceline":"냐하☆ 마왕군 소속 드래곤 나이트, 블뤼허야~ …드래곤을 조종하는 게 아니라 끌려다니는 것 같다고? 그건 사실인데… 으아아아! 드래곤이 내 말을 안 들어! 지휘관, 도와줘~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403022/unlock.ogg"},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이세계 모험","상점 id":70992,"상점 카테고리 id":24,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2026/02/25)","진영":"KMS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":403023,"클뜯 함순이 id":40302,"함순이 이름":"블뤼허","한글 함순이 + 스킨 이름":"방과 후의 기다림☆","영문 함순이 + 스킨 이름":"The After-School Wait","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403023/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403023/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403023/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403023/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403023/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403023/shipyard.png","설명":"냐하☆ 역시 꼭 만나러 와 줄 줄 알았어~! 다음에는 그렇게 서두르지 않아도 돼. 블뤼허는 언제까지든 기다릴 수 있거든. 게다가 너~무 좋아하는 지휘관이 블뤼허 때문에 힘들어지면 안 되잖아!","자기소개":null,"메인1":{"voiceline":"지휘관! 저기 봐! 오늘의 노을, 진짜 아름다워~! 이런 최고의 풍경을 놓치는건 있을 수 없어! 같이 사진 찍자~! 3, 2, 1, 예이☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/main1.ogg"},"메인2":{"voiceline":"불시 체크~☆지휘관이 블뤼허에게 써준 메모에는 뭐라고 쓰여 있을까나~?……에! 아무것도 안 쓰여 있잖아!? 여기에……「정말정말정말 좋아하는 블뤼허」라고 써줘♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/main2.ogg"},"메인3":{"voiceline":"지휘관, 조금만 숙여 줄래~? 이마의 땀을 닦아 줄게~. 응? 이 손수건? 블뤼허가 잘 사용하는 손수건이야. 원한다면 줄게~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관~! 아직 시간 있는데 어딘가에 들를까? 상점가? 게임센터? 아니면……뭐어어!? 돌아가서 숙제하는 거야!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/detail.ogg"},"드랍 설명":{"voiceline":"냐하☆ 역시 지휘관이라면 절대로 마중나와 줄 거라고 생각했어~! 다음부터는 그렇게 서두르지 않아도 좋아! 블뤼허는 얼마든지 기다려 줄 거고, 정말정말정말 좋아하는 지휘관이 지쳐버리면 안되니깐! ","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"지휘관, 피곤하면 언제든지 블뤼허의 무릎에 누워~. 이 무릎베개는 정말정말정말 좋아하는 지휘관만의 특등석이니깐!! 벌써  시간이 늦었다고? 그런 거 관계없잖아~! 지휘관과 함께라면 이대로 아침까지 지내도 좋아♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/feeling5.ogg"},"터치3":{"voiceline":"포상이 쓰담쓰담뿐이라니 안돼~! 좋아! 벌로 블뤼허를 10분간 꼬~옥 안아줘야 해! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/headtouch.ogg"},"모항귀환":{"voiceline":"냐하☆ 지휘관~ 오늘은 블뤼허, 하루 종일 열심히 공부했으니깐! 상으로 방과 후의 데이트, 해 줄거지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"냐하☆ 지휘관~! 왜 그렇게 떨어진 곳에 앉아 있는 거야? 좀더 이쪽으로~ 좀더 좀더~! 오케이~이렇게 하면 꼬~옥 안고 있을 수 있어! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"헤헤~, 지휘관의 마사지……뭔가 간지러워~! 아하하하, 그, 그곳은 안돼~! 하하하하하……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/touch.ogg"},"터치2":{"voiceline":"꺄아!? 아직 교실인데……헤헤, 지휘관의 그런 흐름에도 완벽!하게 맞춰줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/touch2.ogg"},"입수시":{"voiceline":"냐하☆ 역시 지휘관이라면 절대로 마중나와 줄 거라고 생각했어~! 다음부터는 그렇게 서두르지 않아도 좋아! 블뤼허는 얼마든지 기다려 줄 거고, 정말정말정말 좋아하는 지휘관이 지쳐버리면 안되니깐! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403023/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":0}]