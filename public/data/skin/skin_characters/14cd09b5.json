busercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/expedition.ogg"},"실망":{"voiceline":"이런 지휘관이라도, 블뤼허는 너무 좋아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/feeling1.ogg"},"낯섦":{"voiceline":"냐하☆ 날씨 좋다~ 지휘관~ 블뤼허의 의장을 타고 같이 어딘가 놀러 가자~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/feeling2.ogg"},"호감":{"voiceline":"냐하☆ 지휘관이 곁에 있으면 블뤼허는 두근두근 콩닥콩닥해서 하늘까지 둥둥 뜨는 기분이야! 뭐, 의장 덕에 진짜로 떠다니고 있기는 하지만♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/feeling3.ogg"},"기쁨":{"voiceline":"지휘관이 안아주지 않으면, 전~혀 의욕이 생기질 않아…. 에헤헷, 더 안아줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/feeling4.ogg"},"사랑":{"voiceline":"지휘관… 정말 무지무지무지무지 좋아해! 있잖아, 다음 데이트는 언제로 할까? 다음 달? 다음 주? 내일? 더는 못 기다리겠으니까, 좀 있다 바로 가도 괜찮지? 냐하하하☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"냐하☆ 지휘관, 어서 와! 안아줘~ 에헤헷~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/home.ogg"},"hp 경고":{"voiceline":"사랑에 불가능이란 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/hp_warning.ogg"},"로그인":{"voiceline":"냐하☆ 지휘관, 날 보면 막 활력이 샘솟고 그러지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/login.ogg"},"실패":{"voiceline":"으윽……. 블뤼허가 다시 일어서려면, 지휘관의 키스가 필요해…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/lose.ogg"},"우편":{"voiceline":"냐하☆ 새로운 우편…이랑, 블뤼허가 주는 러브레터야~ 꼭 읽어야 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/mail.ogg"},"임무":{"voiceline":"냐하☆ 지휘관, 나랑 같이 사랑의 수행길로 떠나자~!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403020/mission.ogg"},"임