[{"클뜯 id":601100,"클뜯 함순이 id":60110,"함순이 이름":"아틸리오 레골로","한글 함순이 + 스킨 이름":"아틸리오 레골로","영문 함순이 + 스킨 이름":"Attilio Regolo","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601100/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601100/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601100/shipyard.png","설명":"카피타니 로마니급 대형 구축함 - 아틸리오 레골로","자기소개":{"voiceline":"내 이름은 아틸리오 레골로, 사르데냐 엠파이어 소속인 카피타니 로마니급 구축함이야! 함선과 지휘관의 관계는 동화 속 공주님과 기사님이랑 비슷한 거 같지 않아? 함선이 기사님이고 지휘관은 공주님이라는 애도 있던데….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/profile.ogg"},"메인1":{"voiceline":"내일 점심 메뉴로 양파 괴물이랑 악당 피망이 나오지 않기를…. 마, 만약 나오더라도 지휘관이 구해주겠지만!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/main1.ogg"},"메인2":{"voiceline":"지휘관, 내가 어깨 안마해 줄게! 아틸리오가 귀여운 토끼들이랑 지휘관의 피로를 풀어줄 거야~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/main2.ogg"},"메인3":{"voiceline":"아틸리오는 말이야, 지휘관네 성이 너무 좋아! 여기에선 토끼들이랑 야옹이들이랑 느긋하게 놀 수 있고, 멀리 안 나가도 되고, 햇볕을 쬐지 않아도 되니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/main3.ogg"},"전투개시":{"voiceline":"잘 봐! 악당들은 아틸리오가 전부 내쫓아 줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/battle.ogg"},"상세확인":{"voiceline":"아틸리오 말고 성에 있는 다른 동료들도 지휘관이 꼭 지켜 줬으면 해! 지휘관은 대단한 사람이니까, 분명 할 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/detail.ogg"},"드랍 설명":{"voiceline":"카피타니 로마니급 대형 구축함 - 아틸리오 레골로","voicelink":null},"의뢰 완료":{"voiceline":"언니들이 뭘 엄청 가지고 왔어! 밖에서 모험이라도 하고 온 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/expedition.ogg"},"실망":{"voiceline":"지, 지휘관… 설마 양파 괴물의 부하야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/feeling1.ogg"},"낯섦":{"voiceline":"야~ 새야~ 내려와 봐! 내가 맛있는 바칼라우 줄게! …음~ 왜 먹고 나면 바로 가버리는 걸까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/feeling2.ogg"},"호감":{"voiceline":"지휘관, 이거 봐! 얘는 하얀 토끼, 얘는 까만 토끼, 그리고 얘는 흑백 토끼 공작님! 얘네들 말고도 야옹이 대장이랑 만쥬 호위병도 있어! 다들, 같이 지휘관이랑 놀자~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/feeling3.ogg"},"기쁨":{"voiceline":"까만 토끼랑 하얀 토끼는 맨날 같이 노는 가장 친한 친구야! 지휘관이랑 아틸리오도 맨날 같이 노니까 가장 친한 친구지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/feeling4.ogg"},"사랑":{"voiceline":"착한 사람은 다들 행복해지고, 나쁜 사람은 다들 벌을 받고, 좋아하는 사람은 다들 함께하는 게… 아틸리오의 소원이야. 아틸리오는 어떻냐구? 에헤헷, 지휘관이랑 같이 있으니까 이미 소원은 이뤄진 거나 다름없는걸!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/feeling5.ogg"},"터치3":{"voiceline":"에헤헤… 기분 좋아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관이 돌아왔네! 있잖아~ 혹시 오다가 돌고래 기사랑 상어 대장을 만나진 않았어? 성 밖에서 있었던 재밌는 이야기, 빨리 아틸리오한테도 들려줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/home.ogg"},"hp 경고":{"voiceline":"으아앗! 악당한테 지겠어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 펄럭펄럭하는 서류 병사들을 정렬해 놨어! 그럼, 나머지는 잘 부탁해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/login.ogg"},"실패":{"voiceline":"바, 방금 건 없던 일로 해! 다음에 지휘관이랑 같이 혼내주고 말 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/lose.ogg"},"우편":{"voiceline":"지휘관, 우편이야! 아틸리오는 우편을 전해주는 토끼~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/mail.ogg"},"임무":{"voiceline":"임무란 건 뭐야? 일을 도와주면 보상을 준다는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/mission.ogg"},"임무완료":{"voiceline":"지휘관, 보상이 왔어! 바로 성안으로 옮겨 놓자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/mission_complete.ogg"},"서약":{"voiceline":"에헤헷, 아틸리오는 지휘관이 너무 좋아! 맞다! 조금만 몸 좀 숙여볼래? 응응~ 이 정도면 지휘관 뺨에 뽀뽀할 수 있겠어! 자, 쪽! 동화 속 왕자님이랑 공주님처럼 계속 계속 행복하게 살자구~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/propose.ogg"},"스킬":{"voiceline":"아틸리오는 안 져!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/skill.ogg"},"터치1":{"voiceline":"아틸리오하고 토끼들이랑 같이 놀래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/touch.ogg"},"터치2":{"voiceline":"아하하하하~ 간지러워~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/touch2.ogg"},"입수시":{"voiceline":"다치지 않도록 평생 지켜주겠다고 맹세한 붉은 인연의 실로 맺어진 지휘관! 아틸리오의 운명적인 단짝! 드디어 만났어! 에헤헷, 자~ 아틸리오를 지휘관의 성으로 데려가 줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/unlock.ogg"},"강화성공":{"voiceline":"아틸리오, 강해졌다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다~! 아틸리오, 동료들이랑 악당을 물리쳤어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관~! 만나고 싶었어~! 에헤헷~ 꼬옥~","voicelink":"https://raw.githubu