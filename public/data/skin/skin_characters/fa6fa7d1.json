[{"클뜯 id":401520,"클뜯 함순이 id":40152,"함순이 이름":"Z52","한글 함순이 + 스킨 이름":"Z52","영문 함순이 + 스킨 이름":"Z52","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401520/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401520/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401520/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401520/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401520/shipyard.png","설명":"1944년형 구축함 - Z52","자기소개":{"voiceline":"나는 메탈 블러드의 Z52야. 장거리 작전이 주특기지. 그 대전에서는 전장에 나서지 못했지만, 실전 훈련은 충분히 했어! 헤헤헤~ 네 힘이 되어줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/profile.ogg"},"메인1":{"voiceline":"천장에 저거… 벌레야? 처음 보는 거라 올라가서 가까이에서 보고 싶은데…… 응? 선반 위에 올라가면 안 된다고…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/main1.ogg"},"메인2":{"voiceline":"지휘관! 자! 요즘 인기 폭발인 디저트야! 먹어봐! 나도 궁금해서 상점가에서 사 왔어! …물론 최고 속력으로 말이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/main2.ogg"},"메인3":{"voiceline":"뛰어넘어서 착지! 지휘관? 어때? 내 콩 볼트 기술 멋있지? 헤헷♪ …아, 당연히 잠깐 연습한 거야. 집무실에서 파쿠르를 하면 안 된다는 것쯤은 나도 알아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/main3.ogg"},"전투개시":{"voiceline":"썬더 하트! 버스트!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/battle.ogg"},"상세확인":{"voiceline":"지휘관은 의장 구조에 대해 잘 알아? 엄청 궁금해서 그런데 알려줘! ……아. 응? 뭐? 조, 조금만 더 천천히…! 너무 복잡해서 모르겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/detail.ogg"},"드랍 설명":{"voiceline":"1944형 구축함-Z52","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 돌아왔네! 다음에는 나도 보내줘! 장거리 임무는 내 주특기니까 분명 큰 도움이 될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/expedition.ogg"},"실망":{"voiceline":"너 말이야… 운동을 소홀히 하면 안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 평소에 스포츠 같은 거 해? ……오, 그렇구나! 나도 그럭저럭 자신 있는 거니까, 다음에 같이 해볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/feeling2.ogg"},"호감":{"voiceline":"모항 파쿠르 대회에 출전 신청을 넣어놨으니까 꼭 응원하러 와야 돼! 네 응원만 있으면 나… 분명 멋지게 우승할 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/feeling3.ogg"},"기쁨":{"voiceline":"레겐스부르크가 썬더 하트를 개조해 줘서, 지금은 사람의 마음까지 꿰뚫을 수 있게 됐어! 지휘관이 지금 생각하고 있는 건…… 음…… 아무것도 안 보이잖아! 더 가까이 가면…… 어, 어라?! 왜 갑자기 껴안는 거야…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 어서 와! 무슨 일로 왔어? …별일 아니니까 그렇게 서둘러서 올 거 없다고…? 괜찮아! 네가 부르면 언제든 최고 속력으로 달려갈 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/feeling5.ogg"},"터치3":{"voiceline":"썬더 하트가 신경 쓰여? 후훗, 이건 사물의 본질을 꿰뚫는 마스크야! 멋있지?! 어떻게 꿰뚫냐니…… 나, 나도 연구 중이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/headtouch.ogg"},"모항귀환":{"voiceline":"오늘 출격은 어디 다녀왔어? 흐음~ 나도 가본 적이 없는 곳이네…… 그래서 무슨 재미있는 일은 있었어? 맛있는 건? 아니, 지금 당장 거기 다녀올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/home.ogg"},"hp 경고":{"voiceline":"썬더 하트… 고장 났나……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/hp_warning.ogg"},"로그인":{"voiceline":"오, 지휘관! 왔구나! 이거 오늘 다 처리해야 하는 거야? 어디 보자…… 오! 꽤 재밌을 것 같네! 나도 할래!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/login.ogg"},"실패":{"voiceline":"지휘관, 추격할까? 아무리 멀리 도망쳐도 반드시 따라잡아서 해치울 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/lose.ogg"},"우편":{"voiceline":"휙! 하고 달려서… 지휘관! 우편을 전해주러 왔어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/mail.ogg"},"임무":{"voiceline":"지휘관, 새로운 임무가 있어. ……어라? 이건 어떻게 하는 거지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/mission.ogg"},"임무완료":{"voiceline":"수고 많았어! 보상은 내가 확인했으니까, 너는 천천히 쉬면서…… 응? 하는 방법이 틀렸다고? 그럼 어떻게 하면 되는지 알려주라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/mission_complete.ogg"},"서약":{"voiceline":"아아… 너무 기뻐! 고마워, 지휘관! 소중히 간직할게! ……지휘관? 지휘관~! 방금 내가 너무 세게 돌렸나…? 으아아! 미안해! 너무 기뻐서 나도 모르게…! 어서 앉아! 지금 물 가지고 올게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/propose.ogg"},"스킬":{"voiceline":"날아라, 버스트! 타올라라, 썬더 하트!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/skill.ogg"},"터치1":{"voiceline":"왜 그래? 뭐 재밌는 거라도 있어? 나한테도 보여줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/touch.ogg"},"터치2":{"voiceline":"뭐, 뭐야?! 구, 궁금할 거 하나 없는 곳이잖아…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/touch2.ogg"},"입수시":{"voiceline":"Z52! 지금 막 왔…… 으아아아! 속도를 너무 냈어! ……후우. 흠! 네가 지휘관이야? 꽤 괜찮은 녀석인 것 같네! 앞으로 업무든 전투든 뭐든 내게 지시해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/unlock.ogg"},"강화성공":{"voiceline":"어떤 장애물이든 뛰어넘을 수 있어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/upgrade.ogg"},"vote":null,"승리":{"voiceline":"지휘관, 어때? 나 진짜 멋있지? 헤헷♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"응…? 오늘은 이상하게 얌전하다고? 지금 막 파쿠르 대회에 참가하고 온 참이라 잠깐 쉬려고…… 가끔은 이렇게 곁에 얌전히 있는 것도 괜찮지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관은 내가 꼭 지킬 거야! 어떤 적이나 장애물이 있더라도 나, 다 내팽개치고 지휘관 곁으로 누구보다 빨리 달려갈게! ……방금 건 누가 알려준 게 아니라, 진짜 내 진심이야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"좋아! 격려받았어! 덕분에 지금은 뛰어오를 듯이 의욕이 넘치는 상태야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"으아아아!! …전속력으로 달려서 마중 나오려고 했는데, 네가 먼저 돌아와서 잘 멈춰지지가 않네… 에헤헤…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 오늘 서류는 정리해 뒀어.. 자, 여기. 응? 틀렸어? 열심히 했는데…… 그, 그러면 어떻게 하면 되는지 알려줘! 다음에는 꼭 도움이 될 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"응? 긁힌 상처…? 아마 파쿠르 연습하다가 생긴 것 같은데…… 반창고? 에이, 괜찮아…… 앗… 고, 고마워…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/touch_ex.ogg"},"터치2_ex":{"voiceline":"응? 화, 확실히 나… 여러모로 크기는 해……///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['Z16'] :  크르릉! …방금 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/couple_encourage1.ogg"},{"voiceline":"['인디애나'] :  와아…! 평소에 에너지 드링크 뭐 마셔?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/couple_encourage2.ogg"}],"메인4":{"voiceline":"지휘관, 잠깐 창문 열어서 환기 좀 할게. 맑은 공기를 마시면 기분이 좋아진다구…… 으앗! 눈에 모래가… 응? 불어서 빼준다고? 고, 고마워… ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"쿨… 어라? 나 잠들었었어…? 지휘관 일을 도와주겠다고 큰소리 쳐놓고…… 이불까지 덮어준 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/main5_ex.ogg"},"메인6_ex":{"voiceline":"저기, 지휘관. U-31이 지휘관을 잘 지킬 수 있는 방법을 알려줬거든. 나중에 시험해 보게 해줘. …응? 그럴 필요 없다고? 왜?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/main6_ex.ogg"},"메인7_ex":{"voiceline":"지휘관, 눈썹 찡그리고 있네. 무슨 고민이라도 있어? 걱정하지 마… 고민 따위 사라져 버려라! …그렇지, 같이 잠깐 달리고 올까? 달리면 고민 같은 건 금방 잊을 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/main7_ex.ogg"},"메인8_ex":{"voiceline":"지휘관, 배고파? 먹을 거라도 사가지고 올까? 바삭바삭한 치킨이나 슈바인스학세는 어때? 갓 만든 따끈따끈한 걸 먹게 해줄 테니 나한테 믿고 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/401520/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"UR","ex_chat_status":1},{"클뜯 id":401521,"클뜯 함순이 id":40152,"함순이 이름":"Z52","한글 함순이 + 스킨 이름":"달리는 바니걸!","영문 함순이 + 스킨 이름":"The Rapid Rabbit","스킨 타입":"Bunny Girl","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401521/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401521/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401521/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401521/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401521/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/401521/shipyard.png","설명":"음… 가게가 어디더라…? 음…… 아, 지휘관! 나 아직 안 늦었지?! 최고 속력으로 달려왔어!","자기소개":null,"메인1":{"voiceline":"이런 모습으로 일하는 건 처음이라 조금 신선하기는 한데, 무슨 일을 하는 건지 궁금하네… 응? 그 얼굴… 지휘관, 알고 있는 거야?! 어서 알려줘!","voi