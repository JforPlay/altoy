[{"클뜯 id":305110,"클뜯 함순이 id":30511,"함순이 이름":"미카사","한글 함순이 + 스킨 이름":"미카사","영문 함순이 + 스킨 이름":"Mikasa","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305110/shipyard.png","설명":"시키시마급 전함 4번함 - 미카사","자기소개":{"voiceline":"나는 시키시마급이자 66함대계획의 마지막 전함, 미카사다. 나중에는 전장에서와 완전히 다른 삶을 살게 되었지만…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/profile.ogg"},"메인1":{"voiceline":"승리란 우연히 오는 것이 아니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/main1.ogg"},"메인2":{"voiceline":"로열 네이비의 요리? 됐네…그건 좀 질려서 말야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/main2.ogg"},"메인3":{"voiceline":"하늘을 날고 있는 그 '비행기' 라는 거… 예전에는 다 별 볼 일 없었는데 말이야… 안 그런가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/main3.ogg"},"전투개시":{"voiceline":"사쿠라 엠파이어의 흥망! 이 전투에 달렸으니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/battle.ogg"},"상세확인":{"voiceline":"기함이란 최전선에서 지휘를 맡는 법. 당연하지 않은가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/detail.ogg"},"드랍 설명":{"voiceline":"시키시마급 전함 4번함 - 미카사","voicelink":null},"의뢰 완료":{"voiceline":"병참업무를 소홀히 하면, 제아무리 거함거포라 해도 오합지졸에 불과하다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/expedition.ogg"},"실망":{"voiceline":"쇼와 출생의 바보야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/feeling1.ogg"},"낯섦":{"voiceline":"동기의 동료들과 만나지 못하는 건 확실히……하지만, 아직 부족한 후배들을 위해서라도, 제대로 해야겠지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/feeling2.ogg"},"호감":{"voiceline":"전쟁을 끝낼 방법을 정할 수 없다면, 전쟁을 일으켜선 안돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/feeling3.ogg"},"기쁨":{"voiceline":"그대의 노력은 인정하마…허, 허나! 이까짓 일로 해이해져선 아니 된다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/feeling4.ogg"},"사랑":{"voiceline":"그렇게 필사적이지 않아도 돼. 진정하게, 잠깐 동안 만이라면 쉬어도 내 눈감아 주도록 하지…무릎베개가 그리워졌다고? 벼, 별수 없군…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"좋아! 전투의 천칭은 나에게 기울어 있는 게다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/home.ogg"},"hp 경고":{"voiceline":"당황하지 마라! 승부는 지금부터다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/hp_warning.ogg"},"로그인":{"voiceline":"인류에게 바다를 되찾아 줄 때까지, 용왕매진을 멈춰서는 아니 된다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/login.ogg"},"실패":{"voiceline":"단노우라와 같음이란 이런 것인가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/lose.ogg"},"우편":{"voiceline":"칭찬 도장은 몇 개가 있어도……에헤헤~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/mail.ogg"},"임무":{"voiceline":"음, 오늘의 함대 계획은 내가 세우는 건가? 그렇다면……사쿠라 엠파이어의 흥망! 이 전투에…우웁! …왜 내 입을 막는 것이냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/mission.ogg"},"임무완료":{"voiceline":"흠, 그럼 승리의 과실을 빼앗……는게 아니라, 수령하는 것이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/mission_complete.ogg"},"서약":{"voiceline":"존경받기엔 아직 정진이 한참 부족하구나! …우후후, 그러니 그때까지 계속 어울려 주도록 하마♪ 이 나조차 닿지 못하는 높은 곳에 올라갈 때까지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/propose.ogg"},"스킬":{"voiceline":"전원, 의기투합하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/skill.ogg"},"터치1":{"voiceline":"제아무리 노력하는 자라도 가끔은 게을러지지. 그렇게 되지 않도록 간언하는 게 나의 본분인 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/touch.ogg"},"터치2":{"voiceline":"축하연의 댄스 상대를 원하는가? ……어, 어쩔 수 없지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/touch2.ogg"},"입수시":{"voiceline":"나는 탄약이 빗발치는 전장을 헤치고 승리를 위해 싸울 자… 사쿠라 엠파이어 함대의 전함 미카사, 참전하도록 하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/unlock.ogg"},"강화성공":{"voiceline":"우수한지 평범한지는, 전장에서만 분간할 수 있는 법.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"크게 형통하고 바름은 하늘의 도일지니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":305111,"클뜯 함순이 id":30511,"함순이 이름":"미카사","한글 함순이 + 스킨 이름":"벚꽃 도시의 바람","영문 함순이 + 스킨 이름":"Style of the Sakura Capital","스킨 타입":"Others","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305111/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305111/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305111/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305111/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305111/shipyard.png","설명":"수납장을 정리하다보니 옛 생각이 드는 옷이 한 벌 나와서 말이야. 자, \"여행 채비를 마치고, 나와 함께 떠나자꾸나!\" …지휘관, 어떤가?","자기소개":null,"메인1":{"voiceline":"이 옷을 몸에 걸치니 왠지 젊어지는 것 같구나…그래! 마치 생애 첫 여행을 떠나려 하는 아이같은 심경이야, 후후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/main1.ogg"},"메인2":{"voiceline":"예전에는 유학을 가기 위해 바다 건너 로열 네이비로 떠나는 이가 많았지. 자, 나와 함께 로열 네이비에 견학이라도 가지 않겠는가? 숙소라면 바로 몇 분 거리에 있다네. 하하하핫!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/main2.ogg"},"메인3":{"voiceline":"그 시절에는 아직도 그리움이 약간 남아있지만……지금은 이 함대야 말로 내가 있을 곳이라네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"후우~ 기분 좋은 바람이군, 이게 바로 '여행 떠나기 딱 좋은 날씨' 라는 거겠지. ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/detail.ogg"},"드랍 설명":{"voiceline":"수납장을 정리하다보니 옛 생각이 드는 옷이 한 벌 나와서 말이야. 자, \"여행 채비를 마치고, 나와 함께 떠나자꾸나!\" …지휘관, 어떤가?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"아직 학생이었던 내가 벚꽃이 흩날리는 계절에 그대를 만나, 몇 번이고 계절을 함께 나는 것……이런 것도, 후후훗, 꽤 괜찮을지도 모르지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"다들 무사히 귀환했는가? 수고많았네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"흠, 기분 좋은 아침이군, 조식은 들었는가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":null,"터치2":{"voiceline":"이봐! 장난치지 말게! 가방이 쓰러질 뻔 했지 않나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/touch2.ogg"},"입수시":{"voiceline":"수납장을 정리하다보니 옛 생각이 드는 옷이 한 벌 나와서 말이야. 자, \"여행 채비를 마치고, 나와 함께 떠나자꾸나!\" …지휘관, 어떤가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305111/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"기타","상점 id":70090,"상점 카테고리 id":9999,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"한정 (2025/04/02)","진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":305112,"클뜯 함순이 id":30511,"함순이 이름":"미카사","한글 함순이 + 스킨 이름":"벚꽃놀이 가기 좋은 날","영문 함순이 + 스킨 이름":"Blossom-Viewing Season","스킨 타입":"Others","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305112/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305112/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305112/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305112/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305112/shipyard.png","설명":"슬슬 벚꽃이 피는 계절인가. 세월이란 참 빨리도 흐르는군……크흠, 지휘관, 어디, 나와 같이 꽃구경이라도 가지 않겠나? ","자기소개":null,"메인1":{"voiceline":"오오, 히에이냐. 술상에 자리까지 마련하느라 고생했다. 자네도 동석해서 지휘관과 함께 즐기도록!","voicelink":null},"메인2":{"voiceline":"나