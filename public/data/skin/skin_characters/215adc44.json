https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305114/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305114/shipyard.png","설명":"사쿠라 엠파이어의 테마샵에 온 걸 환영한다…… 어, 지휘관이잖아! 모두들 널 기다리고 있어. 자, 우리 사쿠라 엠파이어 함대의 정성어린 환대를 만끽하라고!——그렇게 긴장하지 않아도 괜찮아, 후후훗.","자기소개":null,"메인1":{"voiceline":"음식점 메뉴 말인데, 사쿠라 엠파이어 과자만 있으면 언젠가는 질리고 말겠지…. 카레나 서양식의 간단한 식사 메뉴도 도입해야 하려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/main1.ogg"},"메인2":{"voiceline":"무츠, 이 녀석! 먹보인 건 안다만, 그래도 가게에서 내는 메뉴를 훔쳐먹으면 못 쓰지! 직원용 음식은 이쪽이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/main2.ogg"},"메인3":{"voiceline":"음, 나도 실력을 발휘해서 뭐라도 만들어볼까. 지휘관은 뭐가 좋은가? 차림판에 없는 거라도 괜찮으니 말해 봐라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/main3.ogg"},"전투개시":null,"상세확인":null,"드랍 설명":{"voiceline":"사쿠라 엠파이어의 테마샵에 온 걸 환영한다…… 어, 지휘관이잖아! 모두들 널 기다리고 있어. 자, 우리 사쿠라 엠파이어 함대의 정성어린 환대를 만끽하라고!——그렇게 긴장하지 않아도 괜찮아, 후후훗.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 떠난 동료들이 돌아온 모양이군. 새로운 메뉴를 기대하도록 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"음, 무사히 잘 귀환했다! …아, 이런 경우에 요즘 식으로 말하면… 크흠, '어서 오세요, 주인님!'인 건가? 무리해도 어쩔 수 없나….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"음, 오늘도 정리정돈이 잘 되어 있군. 좋아, 그럼 나와 함께 첫 인사를 해보자꾸나. 어서 오세요! 지휘관님!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"오늘 음식점의 경영 계획은 내가 세우도록 하마. 지휘관은 임무에 전념하도록 해라.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"나도 주문을 받아야겠군. 하하하.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/touch.ogg"},"터치2":{"voiceline":"너, 혹시 무슨 착각이라도 한 거 아닌가…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/touch2.ogg"},"입수시":{"voiceline":"사쿠라 엠파이어의 테마샵에 온 걸 환영한다…… 어, 지휘관이잖아! 모두들 널 기다리고 있어. 자, 우리 사쿠라 엠파이어 함대의 정성어린 환대를 만끽하라고!——그렇게 긴장하지 않아도 괜찮아, 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"하하하, 이거 아무래도 축하 연회 메뉴를 더 호화롭게 해야겠는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305114/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70745,"상점 카테고리 id":17,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":305115,"클뜯 함순이 id":30511,"함순이 이름":"미카사","한글 함순이 + 스킨 이름":"쪽빛 미녀","영문 함순이 + 스킨 이름":"Beauty in Indigo","스킨 타입":"New Year Kimono","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305115/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305115/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305115/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305115/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305115/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305115/shipyard.png","설명":"단둘이서 여행을 떠나자고 했을 때는 무슨 일인가 했다만, 뭐… 덕분에 관광도 즐기고 이런 멋진 의상도 입게 되었군. 지휘관, 지금은 마음껏 즐기도록 하자고! 하하하!","자기소개":null,"메인1":{"voiceline":"그렇군. 이게 바로 '누구나 돌아보는 미녀'라는 겐가…. 윽, 그렇지만 네 입으로 들으니 왠지 좀 부끄럽군….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/main1.ogg"},"메인2":{"voiceline":"'여행은 길동무가 중요하다'라… 일리 있는 말이지. 너도 나와 함께 여행하는 것이 즐거웠으면 좋겠다만…. 하하하! 암, 그래야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/main2.ogg"},"메인3":{"voiceline":"으흠... 명산, 명소뿐만 아니라 사찰, 성터까지 이렇게 많아서야 한 번에 다 도는 건 무리겠군…. 이런 경우엔 분명… '재방문'이라고 했었던가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/main3.ogg"},"전투개시":{"voiceline":"전함 미카사, 출격이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/battle.ogg"},"상세확인":{"voiceline":"다른 아이들과 비교하면 색감이 조금 다르지만, 이건 또 이거대로 내게 잘 어울린다고? ……너, 점점 달변이 되어가는 기분이 든다만? 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/detail.ogg"},"드랍 설명":{"voiceline":"단둘이서 여행을 떠나자고 했을 때는 무슨 일인가 했다만, 뭐… 덕분에 관광도 즐기고 이런 멋진 의상도 입게 되었군. 지휘관, 지금은 마음껏 즐기도록 하자고! 하하하!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 귀환한 모양이로군. 그 아이들 줄 선물도 잊지 말라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"걸음을 멈추고 지휘관이 지켜온 평화를 만끽하자. 격전 사이에 잠시 휴식을 취하는 것 또한 지휘관의 책무다. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"예스러운 거리도 지휘관과 함께하니 다른 운치가 느껴지는군. 그럼 길 안내, 잘 부탁하마♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"임무 계획은 네가, 여행 계획은 내가 세우도록 하지! ……이 태블릿은 음… 어떻게 쓰는 겐가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/mission.ogg"},"임무완료":{"voiceline":"임무를 완료했나? 나도 이 지점의 점검을 마친 참이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"응? 이 옷에 얽힌 이야기가 듣고 싶은 겐가? 그럼 어디... 미카사 대선배님의 관광 강좌를 시작해볼까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/touch.ogg"},"터치2":{"voiceline":"이 녀석! 허리띠 건드리지 마라! …휴우, 방금 그것 때문에 식은땀이 다 나는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/touch2.ogg"},"입수시":{"voiceline":"단둘이서 여행을 떠나자고 했을 때는 무슨 일인가 했다만, 뭐… 덕분에 관광도 즐기고 이런 멋진 의상도 입게 되었군. 지휘관, 지금은 마음껏 즐기도록 하자고! 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305115/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"정월","상점 id":70842,"상점 카테고리 id":2,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":305118,"클뜯 함순이 id":30511,"함순이 이름":"미카사","한글 함순이 + 스킨 이름":"무구함상","영문 함순이 + 스킨 이름":"Untarnished Splendor","스킨 타입":"Oath","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305118/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305118/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305118/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305118/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305118/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/305118/shipyard.png","설명":"전함 미카사, 너와 서로 의지하고, 서로 사랑하고, 보조하며, 평생을 함께할 것을 맹세한다. 부족한 몸이지만, 잘 부탁한다——","자기소개":null,"메인1":{"voiceline":"지휘관으로서 절대 학습에 태만하면 안돼. 정 안되겠다면 내가 강의를 열어서 가르쳐 줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/main1.ogg"},"메인2":{"voiceline":"오늘은 저녁 식사는... 나와 인연이 있는 항구의 특산 해군 카레를 만들어 줄까? 상당히 맛있다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/main2.ogg"},"메인3":{"voiceline":"저게 바로 비행기인가... 신선한 사물은 종종 한 눈에 가치를 분별하기 어렵지. 노력해야만 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/main3.ogg"},"전투개시":{"voiceline":"그릇된 생각을 버리고 올바른 도리를 행하여 적을 토벌하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/battle.ogg"},"상세확인":{"voiceline":"마침 잘 왔어, 음... 사이즈는 이 정도면 얼추 맞겠고... 지휘를 맡은 사람은 모으는 것을 소홀히하면 안돼. 전장에 나가면 옷은 손상되지 마련이니, 평상시에 여러 벌을 준비해 둬야해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/detail.ogg"},"드랍 설명":{"voiceline":"전함 미카사, 너와 서로 의지하고, 서로 사랑하고, 보조하며, 평생을 함께할 것을 맹세한다. 부족한 몸이지만, 잘 부탁한다——","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"모두를 안전히 데리고 돌아왔군! 그래, 아주 잘했다고! 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"\"소녀\", \"부군\" 같은 것들은, 아직 적응이 잘 안되는 군... 이전의 호칭이 친근하니, 계속 쓴다면 좋을 텐...데? 음, 네가 괜찮다면야...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/login.ogg"},"실패":{"voiceline":"지휘관의 노력까지 더해도, 해낼 수 없는 건가...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/lose.ogg"},"우편":{"voiceline":"이 훈장과 보상들... 음, 모두 너와 함께 얻은 것이지. 잘 확인해 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/mail.ogg"},"임무":{"voiceline":"어이~ 멍 때리지 말라고! 이 임무 확인 끝나고나서 쉴 수 있다고 말했잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/mission.ogg"},"임무완료":{"voiceline":"응, 좋아! 임무를 마쳤어! 즈이카쿠들에게도 비결을 가르쳐줘야겠는걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"음, 이 \"휴대폰\"은 어떻게 사용하는 거지?... 음......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/touch.ogg"},"터치2":{"voiceline":"그렇게 노력했는데, 이 정도 일은 어쩔 수 없겠지...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/touch2.ogg"},"입수시":{"voiceline":"전함 미카사, 너와 서로 의지하고, 서로 사랑하고, 보조하며, 평생을 함께할 것을 맹세한다. 부족한 몸이지만, 잘 부탁한다——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"온 정신을 집중하기만 하면, 이길 수 없는 적은 없다! 계속 노력하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/305118/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"서약","상점 id":0,"상점 카테고리 id":9998,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":0}]