에서 잠깐 쉬시는 건 어떨까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399041/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 잠시 시간 괜찮으실까요? 잠깐이면 돼요. 가끔은 저도 지휘관님을 독점하고 싶다는 생각에… 우후후. 장난이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399041/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님. 설날 밤은 정말 떠들썩하네요. 하지만 외출하실 때는 감기 조심하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399041/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"지휘관님 곁에 있는 것만으로도 즐겁답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399041/touch.ogg"},"터치2":{"voiceline":"이런 건 안 돼요. 적어도, 지금은요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399041/touch2.ogg"},"입수시":{"voiceline":"지휘관님? 아, 아직 옷도 덜 입었고 머리도 못 말렸는데…… 죄송합니다. 잠시만 기다려주시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399041/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['키타카제'] : 키타카제씨, 길을 잃으면 안 돼요?","voicelink":null}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70300,"상점 카테고리 id":3,"스킨 태그":"L2D, 특수배경 (움짤)","입수 영상":"X","재화":1200,"기간":"상시","진영":"IJN","레어도":"UR","ex_chat_status":0},{"클뜯 id":399042,"클뜯 함순이 id":39904,"함순이 이름":"아즈마","한글 함순이 + 스킨 이름":"신랑의 진로 상담","영문 함순이 + 스킨 이름":"Career Counseling for the Groom","스킨 타입":"On The Job","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399042/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399042/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399042/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399042/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399042/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/399042/shipyard.png","설명":"슬슬 진로 상담을 시작할게요. 불가능해 보이는 작전조차 성공시키는 위대한 장군, 아니면 모두에게 사랑받는 모항의 지도자… 지휘관님이 장차 되고 싶은 건 뭐죠? 아니면…… 후후, 굳이 물어볼 필요는 없겠네요♪","자기소개":null,"메인1":{"voiceline":"지휘관님이 보충 수업을 받는 모습은 좀처럼 상상이 안 가요. 다른 아이들을 가르치는 모습이라면 모를까… 그렇지만 그런 상황이면 전 없는 편이 자연스러울지도…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/main1.ogg"},"메인2":{"voiceline":"모항의 풍기가 문란한 건 전부 지휘관님 탓이랍니다. 알고 계신가요? 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/main2.ogg"},"메인3":{"voiceline":"으음… (꾸욱꾸욱) 지휘관님은 이런 느낌이 더 좋으신가요? 그렇군요. 아직 저도 갈 길이 멀었네요… 네? 그런 건 굳이 안 배워도 된다…고요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"시험 삼아 혼나보고 싶다…고요? 그럼… 음흠. 지휘관님. 방금 보면 안 되는 곳을 보셨죠? 어디를 봤는지 솔직하게 말해보시겠어요? ……방향성이 좀 어긋났나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/detail.ogg"},"드랍 설명":{"voiceline":"슬슬 진로 상담을 시작할게요. 불가능해 보이는 작전조차 성공시키는 위대한 장군, 아니면 모두에게 사랑받는 모항의 지도자… 지휘관님이 장차 되고 싶은 건 뭐죠? 아니면…… 후후, 굳이 물어볼 필요는 없겠네요♪","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"음… 역시 지휘관님의 진로를 지도하는 건 어렵네요. 지휘관님은 지휘관 그 자체셔서 다른 직업을 가지는 모습은 도저히 상상이… 아, 후후후… 직업은 아니지만… 제 신랑이 되는 건… 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"어서 오세요, 지휘관님. 무엇을 하고 싶은지, 어떤 존재가 되고 싶은지…… 말로든, 몸으로든 솔직하게 제게 알려주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관님, 서류는 모두 제출하셨나요? 혹시라도 부족한 부분이 있다면 제가 끝까지 함께 도와드릴게요. 물론… 곁에 바싹 붙어서요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"어려운 임무라도 있었나요? 후후, 부끄러워하지 말고, 편하게 말씀해 보세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/mission.ogg"},"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"방금 그건 「만져줬으면 한다」는 신호… 맞죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/touch.ogg"},"터치2":{"voiceline":"음… 밖에 누가… 자, 지휘관님. 가까이 오세요. 지금 여기엔 우리 둘뿐이랍니다…♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/touch2.ogg"},"입수시":{"voiceline":"슬슬 진로 상담을 시작할게요. 불가능해 보이는 작전조차 성공시키는 위대한 장군, 아니면 모두에게 사랑받는 모항의 지도자… 지휘관님이 장차 되고 싶은 건 뭐죠? 아니면…… 후후, 굳이 물어볼 필요는 없겠네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"지휘관님은 우등생이시니까요. 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/399042/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"오피스 타임","상점 id":71154,"상점 카테고리 id":23,"스킨 태그":"L2D, 배경","입수 영상":"O","재화":1180,"기간":"한정 (2025/07/23)","진영":"IJN","레어도":"UR","ex_chat_status":0},{"클뜯 id":39