[{"클뜯 id":202210,"클뜯 함순이 id":20221,"함순이 이름":"퀴라소","한글 함순이 + 스킨 이름":"퀴라소","영문 함순이 + 스킨 이름":"Curacoa","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202210/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202210/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202210/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202210/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202210/shipyard.png","설명":"세레스급 경순양함 - 퀴라소 (HMS Curacoa) ","자기소개":{"voiceline":"로열 네이비의 경순양함, 퀴라소라고 합니다. 함력 중에는 몇 개인가의 전쟁에 참가한 적이 있고, 작전경험도 그럭저럭 풍부하다고 할 수 있습니다. 이 경험으로 주인님 및 모항에 계신 여러분의 도움이 될 수 있다면 기쁠 것입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/profile.ogg"},"메인1":{"voiceline":"파리입니까? 걱정하지 마시길, 다음 순간에는 사라져 있을 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/main1.ogg"},"메인2":{"voiceline":"벨파스트 같은 훌륭한 아이가 있으니 저도 의욕이 나네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/main2.ogg"},"메인3":{"voiceline":"집무실의 청소는 완료했습니다. 주인님에게는 쾌적한 작업환경이 필요하다고 생각되는군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/main3.ogg"},"전투개시":{"voiceline":"로열 네이비의 관례에 따라, 용감하게 나아갑시다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/battle.ogg"},"상세확인":{"voiceline":"여성은 카메라 앞에 섰을 때야말로 가장 매력을 발휘할 수 있는 건지도 모르겠네요…… 주인님, 예쁜 사진을 찍어 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/detail.ogg"},"드랍 설명":{"voiceline":"세레스급 경순양함 - 퀴라소 (HMS Curacoa)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰에서 돌아온 아이들을 맞이하러 다녀올까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/expedition.ogg"},"실망":{"voiceline":"죄송합니다. 조금 거리를 두는 것이 좋을까 하여.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/feeling1.ogg"},"낯섦":{"voiceline":"과자는 어떠십니까? 옛날에 수업했던 아이들이 좋아하던 것입니다. 맛있게 드십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/feeling2.ogg"},"호감":{"voiceline":"다음에 대강당에서 수업할 때에는 주인님도 견학하시는 건 어떠십니까? 참가하는 아이들에게 아주 좋은 경험이 될 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/feeling3.ogg"},"기쁨":{"voiceline":"가끔 생각합니다만, 만약 메이드의 일을 하루 쉬고 하고 싶은 일을 할 수 있다고 한다면…… 어머, 오늘은 주인님의 봉사에 집중할 수 있겠네요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/feeling4.ogg"},"사랑":{"voiceline":"주인님, 제게 더욱더 기대셔도 됩니다. 당신이 기대주시는 것이야말로 저에게 있어 가장 기쁜 일입니다. 메이드로서도, 당신에게 있어 소중한 존재로서도…… 후후후, 오늘의 과자입니다. 맛있게 드세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"출격 수고하셨습니다. 다음 행동 전에 조금 쉬는 건 어떠십니까? 시간은 충분히 있으니 몸을 소중히 하셔야…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/home.ogg"},"hp 경고":{"voiceline":"승패를 신경 쓰신다고 하면… 전력으로 가겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/hp_warning.ogg"},"로그인":{"voiceline":"만반의 준비가 되었습니다. 주인님, 명령을 내려주십시오. 이 아이들이 확실히 임무를 완수해 낼 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/login.ogg"},"실패":{"voiceline":"부끄럽군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/lose.ogg"},"우편":{"voiceline":"우편입니다. 나쁜 정보는 없는 것 같군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/mail.ogg"},"임무":{"voiceline":"임무를 방치하는 것은 좋지 않습니다. 해내기 위한 계획이라도 만들까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/mission.ogg"},"임무완료":{"voiceline":"임무 보수를 받을 준비를 하겠습니다, 주인님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/mission_complete.ogg"},"서약":{"voiceline":"주인님이 이렇게 껴안아 주시는 것만큼 행복한 것은 존재하지 않습니다. ……앞으로도 잘 부탁드리겠습니다. 사랑하는 주인님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/propose.ogg"},"스킬":{"voiceline":"괜찮습니다, 저는 계속 여기에 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/skill.ogg"},"터치1":{"voiceline":"지시할 일이 있으시다면 언제든지 말씀해 주시기 바랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/touch.ogg"},"터치2":{"voiceline":"저에게 어리광부리고 싶으십니까? 여기는 장소가 조금……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/touch2.ogg"},"입수시":{"voiceline":"주인님을 뵙는 것은 처음인데도 뭔가 그리운 느낌이 드네요… 퀴라소라고 합니다. 앞으로 모항의 운영 사무 등에 대응해 나가도록 하겠사오니, 아무쪼록 기대해주십시오.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/unlock.ogg"},"강화성공":{"voiceline":"대공 성능이 또 강화되었군요. 기쁜 일입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/upgrade.ogg"},"vote":null,"승리":{"voiceline":"제가 1위라니… 송구합니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202210/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"HMS","레어도":"R","ex_c