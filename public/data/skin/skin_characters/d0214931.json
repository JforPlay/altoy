[{"클뜯 id":105110,"클뜯 함순이 id":10511,"함순이 이름":"웨스트버지니아","한글 함순이 + 스킨 이름":"웨스트버지니아","영문 함순이 + 스킨 이름":"West Virginia","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105110/shipyard.png","설명":"콜로라도급 전함 웨스트 버지니아 (BB-48)","자기소개":{"voiceline":"그 '해군 휴일'이라고 불렸던 날들 속에서, 나와 언니들은 세계 최강의 전함으로서 '빅 세븐'이라는 영광스러운 칭호를 받았다. 그러나 시대가 변했다고는 해도, 우리 세 자매가 함대를 지원할 수 있을 정도의 실력을 갖추고 있는 것에는 변함이 없어. 이것만은 잊지 말아줬으면 해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/profile.ogg"},"메인1":{"voiceline":"연습전의 결과는……별로 좋지 않은 것 같다. 지휘관, 혹시 또 게으름을 피우고 있었나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/main1.ogg"},"메인2":{"voiceline":"그날 받은 굴욕, 평생 잊지 않아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/main2.ogg"},"메인3":{"voiceline":"그 스리가오 해협의 밤, 나는 몇몇 사쿠라 엠파이어 함대의 최후를 지켜봤어. 그녀들은… 확실히 존경할만한 상대였다……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/main3.ogg"},"전투개시":{"voiceline":"과거에 받았던 굴욕, 전부 몇 배로 돌려주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/battle.ogg"},"상세확인":{"voiceline":"지휘관, 내 힘은 의심하지 않아도 좋다. 걱정할 것 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/detail.ogg"},"드랍 설명":{"voiceline":"콜로라도급 전함 웨스트 버지니아 (BB-48)","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 활약하는 모습은 꽤 훌륭하군. 지휘관도 조금은 그녀들을 본받아 주었으면……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/expedition.ogg"},"실망":{"voiceline":"지휘관, 게으름이 지나치군. 나에게도 인내의 한계가 있다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/feeling1.ogg"},"낯섦":{"voiceline":"그 대전에서는 큰 부상을 입었지만 수리를 받아 더욱 강한 힘을 손에 넣을 수 있었지. 이것이… '전화위복'이라는 걸까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/feeling2.ogg"},"호감":{"voiceline":" '빅 세븐', 이것은 내가 자랑스러워하는 칭호이다. 하지만 이제는 항공모함의 시대인가… 나는 지금, 자신의 이 힘이 도대체 무엇을 위해 존재하는지 고민하기 시작했다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/feeling3.ogg"},"기쁨":{"voiceline":"지휘관의 함대에 들어감으로써 드디어 해답을 찾을 수 있을 것 같다… 이 힘은, 지휘관과 모두를 보호하기 위해 있는 것이다. 비록 다시는 전장의 주역이 될 수 없다 해도, 나와 내 힘에는 아직 가치가 있을 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/feeling4.ogg"},"사랑":{"voiceline":"지휘관은 이제 전장을 맡길만한 인물이 된 것 같군. 이걸로 드디어 나에게도 힘을 맡길 수 있을 만한 사람이… 뭐? 사랑 고백? 그, 그런 걸 내게 말하게 하는 것 아니야, 이 바보가~~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"여기 항구는 조용하구나, 그 대전 직전의 하와이가 떠오르는군……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/home.ogg"},"hp 경고":{"voiceline":"어뢰를 맞는 이 감각, 실로 불쾌하다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/hp_warning.ogg"},"로그인":{"voiceline":"늦었군… 슬슬 연습전이 시작된다. 지각하지 말도록.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/login.ogg"},"실패":{"voiceline":"또다시, 그날 받았던 굴욕을 떠올리게 하겠다는 것인가…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/lose.ogg"},"우편":{"voiceline":"혹시 언니들이 보낸 편지인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/mail.ogg"},"임무":{"voiceline":"임무 수행 역시 함대의 실력을 키우기 위해 반드시 필요한 것이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/mission.ogg"},"임무완료":{"voiceline":"제대로 임무를 수행한 것 같군, 훌륭했다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/mission_complete.ogg"},"서약":{"voiceline":"나와 연을 맺겠다는 것인가? 대담한 결정을 했구나, 지휘관…… 그렇다면 나도 그 기대에 부응하겠어. 이 힘과 생명이 있는 한 당신을 지켜나가도록 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/propose.ogg"},"스킬":{"voiceline":"16인치 포탄의 무게를 깨닫도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/skill.ogg"},"터치1":{"voiceline":"이것은… 호의를 나타내는 행동, 인가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/touch.ogg"},"터치2":{"voiceline":"…!? 지휘관, 각오는 하고 있겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/touch2.ogg"},"입수시":{"voiceline":"이제야 내 힘을 보여줄 때가 왔군… 콜로라도급 전함 3번함, 웨스트버지니아, 운명의 인도에 따라 당신 함대의 일원이 되겠어","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/unlock.ogg"},"강화성공":{"voiceline":"이번 스포캔 트로피도 문제 없겠군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"봤나? 이것이 '빅 세븐'에 도전하고자 한 결과다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상"