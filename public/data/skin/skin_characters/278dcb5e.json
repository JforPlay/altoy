icelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/feeling1.ogg"},"낯섦":{"voiceline":"저, 조금 겁쟁이라서… 말하고 싶은 걸 제대로 말하지 못해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/feeling2.ogg"},"호감":{"voiceline":"지, 지휘관님…… 저, 곤란해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/feeling3.ogg"},"기쁨":{"voiceline":"점심 드셨으면, 차라도…… 따, 따따딱히 데이트는 아니에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/feeling4.ogg"},"사랑":{"voiceline":"지, 지휘관, 하고 싶은 얘기가 있어요…… 그, 그게, 저기 혹시 지휘관의 품속에서라면 말할 수 있지 않을까 해서…… 어, 어떠세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님 수고하셨어요, 제가 도와드릴 일이 있나요? 에… 없나요…… ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"아, 암호 기억하시죠…… 하, 하아… 진짜 지휘관님이구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/login.ogg"},"실패":{"voiceline":"하아… 하아… 저, 적이 따라오고 있는 건 아니죠?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/lose.ogg"},"우편":{"voiceline":"새로 온 우편이에요, 열어서 확인하시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/mail.ogg"},"임무":{"voiceline":"지휘관님, 저기, 아직 안 끝난 임무가 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/mission.ogg"},"임무완료":{"voiceline":"지휘관님, 저기, 보너스 수령을 아직 안 했는데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/mission_complete.ogg"},"서약":{"voiceline":"지휘관님과 늘 함께인가요? 지휘관님만 좋으시다면, 저, 저는… 물론 괜찮아요! 지, 지휘관님은…… 어떠…세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101300/propose.ogg"},"스킬":{"vo