iceline":"희망을 전하고 용기를 주는 위대한 모험담을 가요로 완성하는 것… 이것이야말로 내 모험이지.","voicelink":null},"메인2":{"voiceline":"내가 딱히 무엇을 하지 않더라도 지휘관은 내 피리소리의 포로가 될 테지…","voicelink":null},"메인3":{"voiceline":"용감하고 강하며, 이상과 희망을 계속 품고… 무엇보다 중요한 부분은 사람을 끌어당기는 그 매력… 훌륭한 음유시인이 될 자질이 보이는군.","voicelink":null},"전투개시":null,"상세확인":{"voiceline":"버드 Z46, 피리 연주가 Z46…… 이 기나긴 여행에서 내게는 어떠한 호칭이 주어지려나?","voicelink":null},"드랍 설명":{"voiceline":"응? 이 피리소리에 이끌려 따라온 건가? 음…… 나를 여행에 데려가는 대가로 네 이야기를 들려줬으면 하는군.","voicelink":null},"의뢰 완료":{"voiceline":"음…… 귀환을 축하하는 곡을 연주할까? 그러면 그녀들의 노고를 치하할 수 있겠지.","voicelink":null},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"여행에서 일어난 일은 새로운 노래로 만들어 이 피리소리로 널리 전할 생각이다… 내 소중한 사람인… 너와의 이야기니까.","voicelink":null},"터치3":null,"모항귀환":{"voiceline":"무슨 일이 있더라도 희망을 버려서는 안 된다. 그것이야말로 \"음유시인\"의 행동 법칙이지. 내 여행에 합류한 걸 환영한다.","voicelink":null},"hp 경고":null,"로그인":{"voiceline":"준비는 끝났나? …나와 함께 노래와 음악으로 적에게 맞서자.","voicelink":null},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"이 피리를 빌리고 싶다고? ……이 피리의 힘에 현혹되어서는 안 된다.","voicelink":null},"터치2":{"voiceline":"이렇게 하면… 곡이 변조될 거라고 기대하는 건가?","voicelink":null},"입수시":{"voiceline":"응? 이 피리소리에 이끌려 따라온 건가? 음…… 나를 여행에 데려가는 대가로 네 이야기를 들려줬으면 하는군.","voicelink":null},"강화성공":null,"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"음유시인의 음악이나 아이돌의 노래 모두 마음을 요동치게 하는 힘이 있다는 점에서는 차이가 없지. 물론, 지휘관의 말도……","voicelink":null},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이세계 모험","상점 id":0,"상점 카테고리 id":24,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SSR","ex_chat_status":0}]