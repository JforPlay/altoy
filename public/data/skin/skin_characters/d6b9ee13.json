[{"클뜯 id":403120,"클뜯 함순이 id":40312,"함순이 이름":"꼬마 프린츠 오이겐","한글 함순이 + 스킨 이름":"꼬마 프린츠 오이겐","영문 함순이 + 스킨 이름":"Little Prinz Eugen","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403120/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403120/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403120/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403120/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403120/shipyard.png","설명":"아드미랄 히퍼급 중순양함—꼬마 프린츠 오이겐","자기소개":{"voiceline":"아드미랄 히퍼급 3번함 프린츠 오이겐이야. 아직 외출할 기회가 없어서 독서하며 시간을 보내는 걸 좋아해. 싫어하는 건 술…… 더 알고 싶은 거 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/profile.ogg"},"메인1":{"voiceline":"영차, 다음에는 손가락을 입에…. 냐핫, 지휘관의 그런 표정도 다 보고, 굳이 이 포즈를 흉내 낸 보람이 있네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/main1.ogg"},"메인2":{"voiceline":"동료들과 같이 출항할 수 있는 날만을 기다리고 있어…. 여기에만 계속 있는 건 심심하단 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/main2.ogg"},"메인3":{"voiceline":"술이 뭐가 맛있는 건지 잘 모르겠어. 그런 거, 냄새만 맡아도 어지러운데.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/main3.ogg"},"전투개시":{"voiceline":"전력을 다해서 갈게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/battle.ogg"},"상세확인":{"voiceline":"히퍼를 보고 있으면, 내가 더 어른처럼 느껴질 때가 있는데… 기분 탓이겠지. 봐, 말하려고 하니까 히퍼가 또 삐졌네♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/detail.ogg"},"드랍 설명":{"voiceline":"아드미랄 히퍼급 중순양함—꼬마 프린츠 오이겐","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 완료된 것 같네. …부탁하면 다음에는 나도 데려가 줄려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/expedition.ogg"},"실망":{"voiceline":"하아…. 이렇게나 기대를 저버릴 줄이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 얼마 전 임무에서 재밌는 일은 없었어? 그냥 계속 책만 읽었더니 좀 지루해진 것뿐이야. 재밌는 거 뭐 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/feeling2.ogg"},"호감":{"voiceline":"지휘관은 내가 낮잠을 자고 일어났을 때도 늘 일하고 있더라. 제대로 쉬고는 있는 걸까…. 뭐, 내가 걱정할 정도는 아닌가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/feeling3.ogg"},"기쁨":{"voiceline":"누가 지켜봐 주지 않으면 계속 일에만 푹 빠져 있으니까, 앞으로는 간식 타임마다 부르러 올게. 알았지? 지휘관은 좀 쉬었으면 좋겠고, 나도 간식이 먹고 싶으니까 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/feeling4.ogg"},"사랑":{"voiceline":"늘 재밌는 이야기를 들려줘서 고마워. 언젠가는 넓은 바다로 나가서 다양한 경치를 감상하고 싶어. 물론, 그때에는 지휘관도 함께여야겠지? …후후후, 기대하고 있을게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/feeling5.ogg"},"터치3":{"voiceline":"감히 나를 애처럼 취급하다니… 재밌네. 마음껏 덤벼 보라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 슬슬 간식 타임 가지지 않을래? 후후후, 더, 더 많이~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/home.ogg"},"hp 경고":{"voiceline":"아직이야, 지금부터라고…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침. 일 열심히 해. 나도 끝날 때까지 여기서 책 읽고 있을 테니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/login.ogg"},"실패":{"voiceline":"이것이 패배… 다음 기회는 없을 줄 알아…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/lose.ogg"},"우편":{"voiceline":"새로운 우편, 잊기 전에 확인해둬.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/mail.ogg"},"임무":{"voiceline":"임무야. 도움이 필요하면 알려줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/mission.ogg"},"임무완료":{"voiceline":"나한테도 포상 주는 거야? 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/mission_complete.ogg"},"서약":{"voiceline":"대답은 뭐냐니, 이제 와서 굳이 물어봐야 알겠어? \"장래의 약속을… 당신과 함께….\" …잘 안 들려. 자, 더 큰 목소리로! 더 크게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/propose.ogg"},"스킬":{"voiceline":"후후, 슬슬 때가 온 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/skill.ogg"},"터치1":{"voiceline":"휴우…. 샤워하니까 개운하네…. 흐암… 지휘관? 같이 낮잠 잘래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/touch.ogg"},"터치2":{"voiceline":"겉보기와 다르다는 건 바로 이럴 때 쓰는 말이지. 후후후~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관이야? 나는 프린츠 오이겐, 메탈 블러드 소속 중순양함이야. 자, 잘 부탁한다는 의미에서 악수~ 앞으로가 기대되네, 후후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/unlock.ogg"},"강화성공":{"voiceline":"괜찮은 느낌인걸. 다음에도 기대할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/upgrade.ogg"},"vote":null,"승리":{"voiceline":"손맛이 나쁘지 않은걸. 냐핫☆","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"히퍼를 달래주려고 찾았더니, 이번엔 지휘관이 질투를?! 후훗, 정말 둘 다 손이 많이 간다니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"뭐야? 그렇게 탐욕스러운 얼굴을 하고, 간식만으론 모자란 거야? …라는 말을 해보고 싶었을 뿐이야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어머, 벌써 업무 끝났어? 그럼, 책을 읽는 대신 좀 놀아주지 뭐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"임무… 한가해서 조금 해치워뒀어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"으응… 아직은 좀 이르잖아. 조금만 더 자자…. 음냐음냐……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/touch_ex.ogg"},"터치2_ex":{"voiceline":"이게 바로 어른의 놀이라는 건가? 우후훗.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"대단한 건 아니었어. 안 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/win_mvp_ex.ogg"},"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관이랑 함께라면, 계속 여기에 있어도 지루하지 않을 것 같다고… 요새는 그런 생각이 들더라구.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/main5_ex.ogg"},"메인6_ex":{"voiceline":"\"자신의 약점부터 극복하라\"니, 그게 뭐야? 히퍼는 정말 바보야. 아, 큰일이다…. 눈앞이 핑핑 돌아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"\"Mein Schatz\", 지휘관은 어른이니까, 어른의 말을 쓰는 편이 좋을 것 같아서 말이야. 후훗, 그렇게 얼굴 붉힐 건 없잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403120/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"KMS","레어도":"SR","ex_chat_status":1}]