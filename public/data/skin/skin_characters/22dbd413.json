,"모항귀환":{"voiceline":"저 경로를 통과하는 편이 더 빨리 배달할 수 있을 거라고? 고맙다! 네놈 지휘는 전장에서든 모항에서든 언제나 의지가 되는군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"하아… 하아… 크흠! 예, 예정 시간보다 더 빨리 집무실에 도착했군! 식기 전에 어서 먹어라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/login.ogg"},"실패":null,"우편":{"voiceline":"착신 알림…? 아, 네놈 앞으로 온 거로군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/mail.ogg"},"임무":{"voiceline":"임무는 이스트 글림 요리와 마찬가지로, 너무 늦기 전에 착수하는 게 제일이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/mission.ogg"},"임무완료":{"voiceline":"임무 보상 전해주러 왔다. 식기 전에 확인하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"평가를 해주겠다고? 흠, 이 호교 기사의 영예에 빛을 더해주려는 거라면 네놈의 그 칭찬, 고맙게 받아들이마. ……배달 평가 말하는 거였나?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/touch.ogg"},"터치2":{"voiceline":"네놈! 떨어뜨리면 책임질 거냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/touch2.ogg"},"입수시":{"voiceline":"으흠… 이 정도 거리면 도보로 이동하는 게 가장 빨리 도착할 것 같군. …눈이 온다고? 흥, 비에도 바람에도 지지 않는 명예로운 호교 기사에게 겨우 눈 따위는 아무런 문제가 안 돼! 다녀오마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"지켜 보아라! 축하연 요리도 이 비시아 성좌의 검은 창인 랭동타블이 전해줄 테니!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901132/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":