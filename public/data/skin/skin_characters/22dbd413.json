[{"클뜯 id":901130,"클뜯 함순이 id":90113,"함순이 이름":"랭동타블","한글 함순이 + 스킨 이름":"랭동타블","영문 함순이 + 스킨 이름":"L'Indomptable","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901130/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901130/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/901130/shipyard.png","설명":"르 팡타스크급 구축함 - 랭동타블","자기소개":{"voiceline":"르 팡타스크급 대형 구축함, 호교 기사 랭동타블이다. 이름처럼 명예로운 호교 기사는 한 발짝도 물러서지 않고, 절대 적에게 굴하지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/profile.ogg"},"메인1":{"voiceline":"어떤 상황에서도 늘 여유롭고 우아하게 행동하는, 본받고 싶은 우리 언니 르 말랭! …네놈, 그 묘한 표정은 뭐냐?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/main1.ogg"},"메인2":{"voiceline":"업무 완수 포상을 준다고? 그럼 마카롱… 크흠! 명예로운 호교 기사에게 포상 따윈 불필요하다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/main2.ogg"},"메인3":{"voiceline":"르 팡타스크급은 빠른 속도로 유명하지. 그렇다고 우리 화력을 우습게 보는 녀석은 큰 코 다친다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/main3.ogg"},"전투개시":{"voiceline":"자기 주제도 모르는 녀석들에게 뜨거운 맛을 보여주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/battle.ogg"},"상세확인":{"voiceline":"검은 의장 창(랜스)? 흥, 의장에 이 정도 위엄과 박력은 있어야 내게 어울린다는 걸 네놈이 알 리가 없지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/detail.ogg"},"드랍 설명":{"voiceline":"르 팡타스크급 구축함 - 랭동타블","voicelink":null},"의뢰 완료":{"voiceline":"보상 물자 확인 끝났어. 내가 있어서 살았다고? 흥, 이 정도는 당연하지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/expedition.ogg"},"실망":{"voiceline":"흥, 네놈같은 멍청이는 어차피 큰일이 나면 꽁지 빠져라 도망이나 치겠지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/feeling1.ogg"},"낯섦":{"voiceline":"명예와 책임감을 보여준다면 네놈을 인정해주마! 명예로운 호교 기사는 두말하지 않는다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/feeling2.ogg"},"호감":{"voiceline":"언니인 르 트리옹팡과 르 말랭도 네놈이 본받아야 할 존재들이지. …르 테리블? 또, 똑똑하기는 하지…만! 네놈까지 때때로 답하기 어려운 질문을 건네는 건 사절이다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/feeling3.ogg"},"기쁨":{"voiceline":"네, 네놈치고는 그럭저럭 우아하군…. 응? '고생 많았다'고? 딱히 고생이랄 건 없었고, 오히려 즐거…… 아, 아니다! 이 호교 기사를 치켜세워봤자 아무것도 안 나온다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/feeling4.ogg"},"사랑":{"voiceline":"흥, 네놈을 인정해주마! 난 네놈의 기사가 되어 네놈에게 충성을 맹세하고, 그리고 내 마음은……. 왜 그래? 호, 호교 기사로서 무척 평범한 말을 입에 올렸을 뿐이라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/feeling5.ogg"},"터치3":{"voiceline":"흥! 네놈의 건방진 짓에는, 윽… 헤헤헤헤… 흐아아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/headtouch.ogg"},"모항귀환":{"voiceline":"네놈 지휘는 훌륭했다! 내게 인정받고 싶으면 계속 그 기세로 분발하라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/home.ogg"},"hp 경고":{"voiceline":"난 명예로운 호교 기사라고…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/hp_warning.ogg"},"로그인":{"voiceline":"늦어! 네놈은 함대 지휘관이니 매일 집무실에 1등으로 들어오겠다는 각오가 필요하다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/login.ogg"},"실패":{"voiceline":"으윽…. 호교 기사로서의 긍지가….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/lose.ogg"},"우편":{"voiceline":"우편이군. …오호라, 이거 봉랍이 상당히 정교한걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/mail.ogg"},"임무":{"voiceline":"명예로운 우리 호교 기사는 네놈처럼 임무를 방치하지 않는다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/mission.ogg"},"임무완료":{"voiceline":"임무가 완료됐어. 보상은… 이것뿐…? 아, 아무것도 아니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/mission_complete.ogg"},"서약":{"voiceline":"네놈의 것이 되는데 굳이 이런 의식이 필요한가? 반지를 끼라고? …알았다! 그럼, 다음은 서약을 나누는 거지?! …소, 손을 잡아? 데이트? 어, 어, 어떻게 된 거냐?! 나, 나, 나… 감쪽같이 속은 건가?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/propose.ogg"},"스킬":{"voiceline":"비시아 성좌의 이름으로 심판을 내려주마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/skill.ogg"},"터치1":{"voiceline":"헤헷, 이 의장 창(랜스)을 마음껏 만끽해라! 내 명예의 상징이기도 하다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/touch.ogg"},"터치2":{"voiceline":"이, 이, 이… 무례한 놈!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/touch2.ogg"},"입수시":{"voiceline":"비시아 성좌의 호교 기사이자 르 팡타스크급 대형 구축함인 랭동타블 등장이다! 네놈은 그 신분에 걸맞은 명예를 가지고 있나? 흥, 말대답하지 마라! 그런 것쯤은 네놈과 함께 지내다 보면 곧 알게 될 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/unlock.ogg"},"강화성공":{"voiceline":"최고의 장비와 최고의 사용자는 서로를 보완할 수 있다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"MVP? 앗싸! …크흠! 노력이 보상받는 거야말로 내가 바라던 바지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관을 위해 어떤 고난이라도 헤쳐 보이마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/battle_ex.ogg"},"상세확인_ex":{"voiceline":"네놈에게 무례하게 구는 고얀 녀석은 내가 이 의장 창(랜스)만 내세우면 도망칠테니 안심하라고! 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"'목숨 바쳐 사랑하라'는 것에 대해서 말인데… 네놈을 배반할 생각은 절대 없다. 하지만 사랑에 목숨을 바치는 건 어떻게 하는 건지…. 딱히 그런 거창한 것까진 안 해도 된다고? 흥, 그럼 네놈에게 가르침을 청해야겠군! ……우, 우선은 데이트부터?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"뭐, 뭐어… 하고 싶으면 하지 그래? …흐아아앙 …그, 그, 그, 그만 하라고는 안 했잖아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"우아하고 우수한 네놈은 내가 따로 신경을 쓸 필요가 없어서 좋다! 그래야 내가 믿고 검을 맡길 수 있는 사람이지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"에잇! 게으름 피우지 말고 나처럼 바로 집무실로 돌아와야지! 네놈이 계속 곁에 없으면, 걱정이 된다고…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"훗훗훗~ 임무에 쫓길 때는 네놈의 검, 그러니까 내게 도움을 요청해라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/mission_ex.ogg"},"임무완료_ex":{"voiceline":"임무가 완료됐다! 분발한 만큼 보상을 조금 나눠 주는 거, 잊지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"또, 또, 또 이상한 짓을!!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"흥이다! 네놈 승리의 일등공신은 바로 나였다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['르 말랭'] :  르 말랭, 같이 싸우자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/901130/couple_encourage1.ogg"},{"voiceli