[{"클뜯 id":202040,"클뜯 함순이 id":20204,"함순이 이름":"다이도","한글 함순이 + 스킨 이름":"다이도","영문 함순이 + 스킨 이름":"Dido","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202040/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202040/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202040/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202040/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202040/shipyard.png","설명":"안녕하십니까, 주인님. 경순양함 다이도라고 합니다. 로열 메이드단의 일원으로서 주인님께 봉사하게 해주세요.","자기소개":{"voiceline":"저는 다이도급의 네임쉽, 다이도입니다. 대공에 특화되어 세계대전 기간 동안 쭉 지중해에서 복무해 왔지요. 저기… 시리우스가 폐를 끼치지는 않았지요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/profile.ogg"},"메인1":{"voiceline":"다른 아이들은 주인님께 버림받지 않았네…… 설마 아직 차례가 오지 않았을뿐인가? 그렇다면 설마 주인님이 다이도보다 그들을 더 좋아하신다거나?! 으으, 지고싶지 않아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/main1.ogg"},"메인2":{"voiceline":"주인님, 다이도가 도와드릴 일이 있나요? 아무리 사소한 것이라도 괜찮아요! 주인님께 봉사하는 것이 다이도의 유일한 존재 가치니까요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/main2.ogg"},"메인3":{"voiceline":"친애하는 주인님. 안녕하세요. 오늘도 다이도의 봉사로 편히 지내세요. 다이도는 주인님만의 메이드니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/main3.ogg"},"전투개시":{"voiceline":"열심히 해야 주인님께 도움이 될 수 있어…! 출격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/battle.ogg"},"상세확인":{"voiceline":"주인님, 다이도를 버리지 않으실 거죠? 정말 버리지 않으실 거죠? 믿어도 되는 거겠죠? 그렇죠? 아…… 주인님의 말이 사실이라면 다이도는 만족해요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/detail.ogg"},"드랍 설명":{"voiceline":"다이도급 경순양함 다이도(HMS Dido)","voicelink":null},"의뢰 완료":{"voiceline":"주인님. 이번 원정의 수확 목록입니다. 확인해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/expedition.ogg"},"실망":{"voiceline":"아아…… 어떻게 이럴 수가…… 주인님께서는 역시 다이도를 불쌍하게 여기셔서……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/feeling1.ogg"},"낯섦":{"voiceline":"로열 메이드로서 다이도는 주인님께 온 힘을 다해 봉사할 거예요. 어떤 명령이라도 반드시 받들어 보이겠습니다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/feeling2.ogg"},"호감":{"voiceline":"메이드단의 동료들은 여러가지로 허당이라 주인님의 관심을 받는 거겠죠…… 그에 비해 다이도는…… 아, 안돼! 자매함을 질투하다니, 메이드가 해서는 안 되는 일이에요…! 그저…… (속닥) 비겁하네요. 허당이라니…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/feeling3.ogg"},"기쁨":{"voiceline":"다이도는 모든 일에 능숙하니 걱정을 사지는 않지만… 주인님께서는 다이도를 걱정해주셨어요! 주인님의 이런 말씀이라니, 다이도는… 다이도는… 으아아……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/feeling4.ogg"},"사랑":{"voiceline":"무, 무슨 말씀이세요? 이렇게 평범한 메이드를 좋아하신다니……… 주인님, 저 믿을지도 몰라요? 그래도 정말 괜찮나요? …… 주인님이 날 좋아하신대, 주인님이…… 어떡해. 웃음이 멈추질 않아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/feeling5.ogg"},"터치3":{"voiceline":"우와아와아아아…………","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/headtouch.ogg"},"모항귀환":{"voiceline":"주인님, 무사하셔서… 정말 다행이예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/home.ogg"},"hp 경고":{"voiceline":"절대로 이 손 놓으시면 안 돼요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/hp_warning.ogg"},"로그인":{"voiceline":"주인님, 돌아오셨나요? 저도 별 일 없었습니다. 으아…… 주인님이 걱정해주시다니…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/login.ogg"},"실패":{"voiceline":"죄송합니다, 주인님! 제발 부탁이니 이 아이처럼 다이도를 버리지 말아주세요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/lose.ogg"},"우편":{"voiceline":"주인님. 편지가 왔습니다. 빨리 확인해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/mail.ogg"},"임무":{"voiceline":"다행이네요… 아직 끝내지 못한 임무가 있으니 다이도도 아직 쓸모가 있을테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/mission.ogg"},"임무완료":{"voiceline":"이번 임무의 보수도 엄청나네요. 역시 주인님이세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/mission_complete.ogg"},"서약":{"voiceline":"우…… 이 세상에 다이도처럼 쓸모 없는 메이드를 좋아해줄 사람이 있다니…… 주인님, 부탁드려요. 앞으로도 계속, 계속 다이도를 사랑해주세요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/propose.ogg"},"스킬":{"voiceline":"주인님의 영광을 위해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/skill.ogg"},"터치1":{"voiceline":"잘…했다고요…? 아아… 주인님…… 아, 아니요. 다이도가 당연히 해야할 일인걸요! 네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/touch.ogg"},"터치2":{"voiceline":"주, 주인님. 총애해 주시는 것은 영광이지만…… 이런건 옳지 않아요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/touch2.ogg"},"입수시":{"voiceline":"안녕하십니까, 주인님. 경순양함 다이도라고 합니다. 로열 메이드단의 일원으로서 주인님께 봉사하게 해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/unlock.ogg"},"강화성공":{"voiceline":"주인님, 감사하고 또 감사드립니다! 정말 감사드려요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼다! 주인님, 잘 됐네요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202040/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"