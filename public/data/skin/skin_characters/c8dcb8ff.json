celink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202041/detail.ogg"},"드랍 설명":{"voiceline":"일개 메이드가 이렇게 화려한 옷을 입고 주인님 곁에 서다니, 다이도가 이런 대담한 일을… 하지만, 하지만 나중에 주인님께 벌을 받더라도 다이도는…——에?! 주인님?!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"연회가 곧 시작하지만 주인님이 곁에서 다이도를 기다려주고 계시다는 건… 다이도를 버리지 않고 사랑해주신다는 말이네요… 아아, 시간이 이대로 멈췄으면 좋겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202041/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"주인님이 돌아오시기 전까지 화장을 끝내지 못했다니, 다이도는 정말 쓸모 없는 메이드예요. 으으……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202041/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"주, 주인님?! 설마 다이도가 너무 시간을 많이 낭비했나요?! 잠, 잠시만요. 금방 끝나요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202041/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"……?! 주인님, 설마 화장을 도와주시려고요? 그, 그럴 수는, 하지만, 하지만, 우……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202041/touch.ogg"},"터치2":{"voiceline":"저기, 주인님, 지금은 옷이 조금 흐트러져서…… 아, 지금은 안 돼요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202041/touch2.ogg"},"입수시":{"voiceline":"일개 메이드가 이렇게 화려한 옷을 입고 주인님 곁에 서다니, 다이도가 이런 대담한 일을… 하지만, 하지만 나중에 주인님께 벌을 받더라도 다이도는…——에?! 주인님?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202041/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":{"voiceline":"아카시 씨가 만든 \"자동 옷갈아입기\"는 정말 대단해요. 누군가가 옷 갈아입는 것을 도와주는 것 같은…… (작은 소리) 주인님이었으면 좋았겠지만요…///","voicelink":null},"메인1_ex":null,"메인5_ex":null