[{"클뜯 id":301880,"클뜯 함순이 id":30188,"함순이 이름":"와카츠키","한글 함순이 + 스킨 이름":"와카츠키","영문 함순이 + 스킨 이름":"Wakatsuki","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301880/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301880/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301880/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301880/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301880/shipyard.png","설명":"아키즈키급 구축함 6번함 - 와카츠키","자기소개":{"voiceline":"아키즈키급 구축함 와카츠키, 여기 있습니다!다른 동료들처럼 특기 분야는 대공이지만, 대함 전투에서도 지지 않아요! 안심하시길! 지휘관 각하의 명에 따르며, 지휘관 각하의 안전을 지키겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/profile.ogg"},"메인1":{"voiceline":"지휘관 각하, 이거 보세요! 창문 옆에 작은 새가… 아, 날아갔네요…. 음, 놀라게 하지 않고 접근할 수 있는 방법 없을까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/main1.ogg"},"메인2":{"voiceline":"지휘관 각하, 제가 도와드릴 수 있는 일은 없나요? 서류에는 잘 모르는 부분도 있지만, 열심히 공부하면 알 수 있을 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/main2.ogg"},"메인3":{"voiceline":"동료들이 곁에 없으면 왠지 좀 불안해요…. 지휘관 각하는 혼자 계실 때 괜찮으신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/main3.ogg"},"전투개시":{"voiceline":"선봉 와카츠키는 여기에 있다! 다들, 나를 따라 돌격하라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/battle.ogg"},"상세확인":{"voiceline":"에잇! 하압! ……지휘관 각하! 보시는 것처럼 지금은 휘두르기 연습 중입니다! 지휘관 각하도 함께 어떠신가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/detail.ogg"},"드랍 설명":{"voiceline":"아키즈키급 구축함 6번함 - 와카츠키","voicelink":null},"의뢰 완료":{"voiceline":"의뢰는 누가 맡기거나 부탁하는 거군요. 즉, 의뢰를 처리해주는 지휘관 각하는 의리가 넘치신다는 거겠죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/expedition.ogg"},"실망":{"voiceline":"왜 와카츠키를 혼자 두시는 거죠…. 저, 무슨 잘못이라도 한 건가요…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/feeling1.ogg"},"낯섦":{"voiceline":"사람을 돕는 이유… 흠… 제 얕은 생각에 대해 깊이 생각해 본 적은 없네요…. 지휘관 각하는 어떠신가요? 동료들이 다들 신세를 지고 있다고 하던데, 지휘관 각하의 이유는 어떤 건지 들려주실 수 있으실까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/feeling2.ogg"},"호감":{"voiceline":"힘을 손에 넣고 동료를 버리고 본심을 잃는 자, 즉 야심가로 변하는 무리들… 이야기 속에도 자주 나오는 적이지요! 그런 녀석들, 아주 만나기만 하면… 에헤헤.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/feeling3.ogg"},"기쁨":{"voiceline":"지휘관 각하, 멀리 나가시나요? …그, 그러시다면 와카츠키도 데리고 가주세요! 꼭 도움이 될게요! …게다가 지휘관 각하께서 자리를 비우시면 저… 모항 주변을 순찰하는 것뿐이라구요?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/feeling4.ogg"},"사랑":{"voiceline":"오늘도 평소처럼 지휘관 각하의 경호는 제가 맡을게요! ……응? 오늘은 한결 더 기분이 좋아 보인다구요? 당연하죠! 지휘관 각하 곁에서 도움을 드리는 건 제게 가장 큰 행복이니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/feeling5.ogg"},"터치3":{"voiceline":"와카츠키에게 주시는 보상인가요? 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/headtouch.ogg"},"모항귀환":{"voiceline":"무사히 귀환하셔서 다행입니다! 에헤헤, 지휘관 각하를 기다리고 있자니 저, 조금 안절부절 못하겠더라구요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/home.ogg"},"hp 경고":{"voiceline":"주, 중심을 잡아야 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/hp_warning.ogg"},"로그인":{"voiceline":"지휘관 각하! 지금부터 업무를 시작하실 건가요? 저도 미력하나마 도움이 되고자 합니다! 혹시 제가 도와드릴 일은 없나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/login.ogg"},"실패":{"voiceline":"후미는 제가 맡을테니, 다들 어서 도망가세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/lose.ogg"},"우편":{"voiceline":"지휘관 각하, 이거 보세요! 밀서가 왔어요! …그냥 평범한 편지라구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/mail.ogg"},"임무":{"voiceline":"임무 때문에 고민하실 때도 있으세요? 그럴 때는 제게 맡겨 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/mission.ogg"},"임무완료":{"voiceline":"임무 완료입니다! 전 아무것도 안 한 것 같은 기분이 들지만, 지휘관 각하와 함께 난관을 돌파하는 이 느낌, 좋은 것 같아요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/mission_complete.ogg"},"서약":{"voiceline":"알겠습니다! 이것이 바로 '주군과의 계약'이라는 거 맞죠?! 앞으로는 지휘관 각하 곁에서 지휘관 각하를 지킬 것을 약속 드립니다! 물론, 그 외에도 제게 맡길 일이 있으시다면 언제든 말씀해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/propose.ogg"},"스킬":{"voiceline":"맡겨 주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/skill.ogg"},"터치1":{"voiceline":"칼이 무거우니까 조심하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/touch.ogg"},"터치2":{"voiceline":"으아! 지, 지휘관 각하?! …이건 무릎 꿇고 사죄감이라구요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/touch2.ogg"},"입수시":{"voiceline":"아키즈키급 구축함 와카츠키, 각하의 부름에 응해 힘이 되고자 왔습니다! 용무가 있으시면 언제든지 말씀해주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/unlock.ogg"},"강화성공":{"voiceline":"몸놀림이 한층 더 가벼워졌어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승패는 결정났다! 무기를 버리고 신속히 항복해라! 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관 각하의 계책만 있다면, 대승은 따 놓은 당상이죠!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/battle_ex.ogg"},"상세확인_ex":{"voiceline":"이 목소리는…… 도움이 필요한 동료가 있어요! 지휘관 각하, 어려움에 빠진 동료를 내버려 두는 건 선에 어긋나요! 어서 구하러 가요!\"","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":{"voiceline":"좋은 일을 많이 하면, 지휘관 각하에게 더 많이 상을 받을 수 있겠죠?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/headtouch_ex.ogg"},"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"지휘관 각하… 다른 애들한테도 이런 거 하고 계시죠…. 그, 그러시면 안 된다고 생각해요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['스즈츠키'] :  지휘관 각하를 위해 같이 싸워요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/couple_encourage1.ogg"},{"voiceline":"['쇼카쿠', '즈이카쿠', '치토세', '치요다'] :  호위는 제게 맡기세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관 각하, 와카츠키… 서류는 아직 잘 모르겠지만, 수송 심부름이라면 괜찮아요! 여기 서류는 제가 보내도록 할게요! ……보낼 곳을 착각하지 않을게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관 각하, 같이 연습하면 상대와 더 가까워질 수 있다고 하던데… 한판 겨뤄보지 않으실래요? ……응? 더 좋은 방법이 있다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관 각하, 이것 보세요! 작은 새들이 이젠 절 무서워하지 않아요! 에헤헤, 늘 먹이를 줘서 그런가봐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301880/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":1},{"클뜯 id":301881,"클뜯 함순이 id":30188,"함순이 이름":"와카츠키","한글 함순이 + 스킨 이름":"좌충우돌 파랑새","영문 함순이 + 스킨 이름":"Slapdash Blue Sparrow","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301881/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301881/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301881/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301881/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301881/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301881/shipyard.png","설명":"으와앗, 각하 비켜주세요——! 각하의 옷을 더럽히지 않아서 다행입니다…… 저, 정말 죄송합니다! 바닥은 제가 깨끗이 치우겠습니다!","자기소개":null,"메인1":{"voiceline":"지휘관 각하, 작은 새를 몇 마리 기르면 가게 분위기가 더 밝아질 것 같지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/main1.ogg"},"메인2":{"voiceline":"하구로 씨, 괜찮으세요? 혹시 저 때문에… 괜찮으시다구요? 다행이다…. 다음에 또 누가 넘어지면 저, 무릎 꿇고 사죄할 수밖에 없겠어요….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/main2.ogg"},"메인3":{"voiceline":"지휘관 각하, 여긴 방금 청소했으니까 미끄러지지 않도록 조심하세요! ……더 이상 피해자를 늘릴 수는 없으니까요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"잘만 하면, 무사시 씨가 상으로 쓰담쓰담 해주세요! 사실은 오늘도 상을 많이 받았는데…. 지휘관 각하도 상을 주신다구요? 신난다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/detail.ogg"},"드랍 설명":{"voiceline":"으와앗, 각하 비켜주세요——! 각하의 옷을 더럽히지 않아서 다행입니다…… 저, 정말 죄송합니다! 바닥은 제가 깨끗이 치우겠습니다!","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":{"voiceline":"열심히 일한 포상, 잘 받았습니다! 에헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관 각하께 이런 꼴을 보여드리고 말았네요……. 음식점에서 모두에게 도움을 주려고 했는데, 오히려 폐만 끼치고 말았어요…. 아아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"어서 오세요, 지휘관 각하! 지금 자리로 안내해……. 아! 발 조심 하세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"네, 지금 가져다 드릴게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/touch.ogg"},"터치2":{"voiceline":"다, 다른 동료들한테 다 이를 거예요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/touch2.ogg"},"입수시":{"voiceline":"으와앗, 각하 비켜주세요——! 각하의 옷을 더럽히지 않아서 다행입니다…… 저, 정말 죄송합니다! 바닥은 제가 깨끗이 치우겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301881/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"메이드 타임","상점 id":70740,"상점 카테고리 id":17,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"IJN","레어도":"SSR","ex_chat_status":0},{"클뜯 id":301882,"클뜯 함순이 id":30188,"함순이 이름":"와카츠키","한글 함순이 + 스킨 이름":"봄을 기다리는 푸른 날개","영문 함순이 + 스킨 이름":"Blue Sparrow Heralding Spring","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301882/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301882/painting_n.png","sd 일러":"https://raw.githubuserconte