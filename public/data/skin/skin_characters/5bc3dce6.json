[{"클뜯 id":107250,"클뜯 함순이 id":10725,"함순이 이름":"카우펜스","한글 함순이 + 스킨 이름":"카우펜스","영문 함순이 + 스킨 이름":"Cowpens","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107250/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107250/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107250/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107250/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107250/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107250/shipyard.png","설명":"인디펜던스급 경항공모함 - 카우펜스","자기소개":{"voiceline":"후훗, 이글 유니온의 인디펜던스급 항공모함이자, 지휘관의 영양사인 카우펜스예요~ 안심하고 몸을 저에게 맡기세요~ 제대로 「영양을 보충시켜서」 매일 활력이 넘치게 해 드릴 테니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/profile.ogg"},"메인1":{"voiceline":"식이섬유가 부족한 것 같네요…… 내일부터 채소 비율을 좀 늘릴게요~ 지휘관… 전부 다 먹어 줄 거죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/main1.ogg"},"메인2":{"voiceline":"새로운 영양 강화 우유예요. 그나저나 지휘관은 달콤한 거랑 플레인 중에 어느 쪽이 좋으세요? 둘 다 준비해 드릴게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/main2.ogg"},"메인3":{"voiceline":"어떤 음식을 좋아하는지…… 전부 저에게 알려 주세요. 영양 식단을 짤 때 최대한 좋아하는 걸 넣어 드릴게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/main3.ogg"},"전투개시":{"voiceline":"전투 시작~ 괜찮아요, 지휘관. 제가 모두 지켜 줄게요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/battle.ogg"},"상세확인":{"voiceline":"지휘관~ 영양에 대해 더 알고 싶어요? 아니면…… 더 따뜻한 보살핌을 받고 싶어요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/detail.ogg"},"드랍 설명":{"voiceline":"인디펜던스급 경항공모함 - 카우펜스","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰팀 동료들이 돌아왔어요~. 무사히 돌아와 줘서 정말 다행이에요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/expedition.ogg"},"실망":{"voiceline":"지휘관…… 이대로는 안 되겠네요. 더욱 열심히 보살펴야겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/feeling1.ogg"},"낯섦":{"voiceline":"지휘관, 제가 시키는 대로 잘 따라야 해요. 다 지휘관의 몸을 위해서예요… 우유를 마시면 마음도 편안해질 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/feeling2.ogg"},"호감":{"voiceline":"지휘관~ 제 영양 식단, 효과가 정말 좋죠? 이대로 계속해 줘요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 야근하면 못써요~. 걱정되는 건 물론이고, 지휘관의 몸을 위해서라도 더 이상 계속해서는 안 돼요…… 이러다가는 저의 영양이 지휘관의 체력 소모를 따라잡을 수 없겠어요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/feeling4.ogg"},"사랑":{"voiceline":"친애하는 지휘관…… 당신의 건강과 활력이 저에게는 가장 큰 행복이에요. 당신을 위한 영원히 따뜻한 우유처럼…… 저의 사랑과 지켜 드리고 싶은 마음은 영원히, 영원히 식지 않을 거예요♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/feeling5.ogg"},"터치3":{"voiceline":"음~ 지휘관이 이렇게 만지니까…… 몸을 더 밀착시키고 싶어지잖아요……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 어서 와요~. 피곤하죠~? 자, 카우펜스에게 몸을 맡겨요… 그리고 따뜻한 허니 밀크를 마시면서 체력을 회복하는 거예요…… 싫다고 하긴 없기에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/home.ogg"},"hp 경고":{"voiceline":"조금 벅차네요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 어서 오세요~ 카우펜스의 마음이 담긴 따뜻한 우유는 어떠세요? 자, 사양하지 마세요~ 식기 전에 전부 마셔요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/login.ogg"},"실패":{"voiceline":"음~…… 식단을 조정해서 영양을 보충해야겠어요… 지휘관도 제대로 챙겨 먹어줄 거죠~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/lose.ogg"},"우편":{"voiceline":"지휘관, 우편을 확인하기 전에 이 체력 회복용 채소 주스부터 드세요. 지휘관 취향에 맞는 맛이랍니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/mail.ogg"},"임무":{"voiceline":"지휘관~ 임무도 중요하지만, 체력 관리도 기본 중의 기본이에요~. 자, 특제 에너지 우유라도 좀 마셔요…… 임무 수행은 그 다음에 해도 괜찮아요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/mission.ogg"},"임무완료":{"voiceline":"지휘관~ 피곤해요? 후후, 카우펜스의 특제 밀크 푸딩을 드세요♪ 적절한 영양 보충은 무엇보다 중요하니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/mission_complete.ogg"},"서약":{"voiceline":"처음에는 우유의 따스함과 영양으로 지휘관의 피로를 풀어 주려고 했지만… 어느새 치유하고 싶은 마음이 지휘관과의 평생의 유대가 되었네요…… 후후후, 저도 지휘관에게 늘 받고 있답니다. 사랑이라는 이름의 영양을요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/propose.ogg"},"스킬":{"voiceline":"얌전히 영양분을 섭취하세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/skill.ogg"},"터치1":{"voiceline":"우후후, 지휘관도 참~ 따뜻하게 안아 줬으면 해요? 괜찮아요, 카우펜스의 품은 언제나 지휘관을 기다리고 있으니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/touch.ogg"},"터치2":{"voiceline":"음? 지휘관…… 좀 더 「특별」한 영양을 보충하고 싶은 건가요~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/touch2.ogg"},"입수시":{"voiceline":"지휘관♪ 지금부터는 이 카우펜스가 잘 보살펴 드릴게요. 최상급 우유와 충분한 영양을 섭취하실 수 있도록 도와드리면서 몸을 챙겨 드릴 테니, 꼭…… 전부 제가 시키는 대로 해주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/unlock.ogg"},"강화성공":{"voiceline":"음~, 힘이 넘쳐나는 느낌…… 지휘관과 모두를 더더욱 잘 보조할 수 있도록 이 힘을 쓸게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우후후. 승리의 기쁨 또한 최고의 「영양」이죠~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/win_mvp.ogg"},"전투개시_ex":{"voiceline":"모두의 건강과 평화를 위해서…… 열심히 할게요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/battle_ex.ogg"},"상세확인_ex":{"voiceline":"지휘관이 우유를 마시고 만족스러워하는 모습을 보면, 「더 영양을 줘야지」하고 저도 모르게 생각하게 돼요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"지휘관, 저… 어느새 당신의 건강을 돌보는 것뿐만 아니라, 마음의 의지가 되고 싶어졌어요…… 우유와 포옹으로, 저의 모든 마음을 담아 당신을 보살피고, 당신을 따뜻하게 해 드리는 것…… 그것만으로도 너무 만족스럽고, 행복해요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"이 느낌…… 저기 지휘관, 이런 「영양」을 더 많이~ 저에게 주세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관, 수고했어요. 조금 피곤한 것 같네요… 따뜻한 우유가 있으니 우선 그걸 마시고 제게 전신 마사지라도 받는 게 어때요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"카우펜스의 품으로 어서 오세요~ 으음~ 이제야 마음이 놓이네요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/login_ex.ogg"},"실패_ex":{"voiceline":"슬슬 퇴각해야겠어요…… 괜찮아요, 아무 일 없을 테니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/lose_ex.ogg"},"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"음~ 지휘관의 체온은 카우펜스에게 가장 좋은 영양이랍니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/touch_ex.ogg"},"터치2_ex":{"voiceline":"우후후…… 지휘관도 참, 어쩜 그렇게 간절한 표정을 짓고 있나요~. 자아…… 마음껏 갈구하세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"다들 무사해서 다행이에요~. 돌아가면 영양 보충하는 것도 잊지 마세요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['바탄'] : 너무 멀리 떨어지지 말아요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/couple_encourage1.ogg"},{"voiceline":"['샌 재신토'] : 자, 함께 힘내 봐요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"voiceline":"지휘관, 잠시 저에게 몸을 맡겨 주세요. 카우펜스의 체온은 지휘관의 피로 해소에 굉장히 좋답니다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/main5_ex.ogg"},"메인6_ex":{"voiceline":"지휘관, 식재료는 자유롭게 고르셔도 괜찮아요. 영양사로서 이건 절대로 필요하다, 이게 없으면 안 된다는 건 없으니까요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/main6_ex.ogg"},"메인7_ex":null,"메인8_ex":null,"메인4_ex":{"voiceline":"지휘관~, 이 우유는… 저의 사랑이 담긴 거예요~. 한 방울도 남기지 말고 마셔야 해요♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107250/main4_ex.ogg"},"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":107251,"클뜯 함순이 id":10725,"함순이 이름":"카우펜스","한글 함순이 + 스킨 이름":"밀키 케어","영문 함순이 + 스킨 이름":"Milky Ministrations","스킨 타입":"Maid","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107251/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107251/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107251/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107251/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107251/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107251/shipyard.png","설명":"지휘관, 준비됐나요? 지금부터 가장 기분 좋은 영양 보충이 시작된답니다. 우선은 힘을 빼 줘