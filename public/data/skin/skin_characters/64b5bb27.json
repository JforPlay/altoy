[{"클뜯 id":11100050,"클뜯 함순이 id":1110005,"함순이 이름":"사이렌지 하루나","한글 함순이 + 스킨 이름":"사이렌지 하루나","영문 함순이 + 스킨 이름":"Haruna Sairenji","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100050/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100050/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100050/shipyard.png","설명":"만나서 반가워, 지휘관. 사이렌지 하루나라고 해. 앞으로 잠시동안 여기 머무를 테니 잘 부탁해. 내가 도와줄 게 있으면 언제든 말해줘.","자기소개":{"voiceline":"사이난 고등학교 2학년인 사이렌지 하루나라고 해. 작은 사고로 여기 왔지만…… 여기 일상은 내가 살던 곳과는 전혀 다르지만, 즐겁게 잘 지내고 있어. 꽤 마음에 들어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/profile.ogg"},"메인1":{"voiceline":"이래 봬도 반장이라서 서류 업무는 잘할 수 있을 거야. 그것 말고 다른 일도 열심히 할게. 모를 때는… 알려줄 거지…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/main1.ogg"},"메인2":{"voiceline":"메리 셀러스트 씨는 정말 유령이야…? 유령이 진짜로 있구나…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/main2.ogg"},"메인3":{"voiceline":"교복을 입고 모항을 돌아다니면 이상하지 않아…? 지휘관 생각은 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/main3.ogg"},"전투개시":{"voiceline":"조금 불안하지만… 열심히 해볼게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/battle.ogg"},"상세확인":{"voiceline":"의장이라고 불러…? 이게 무기가 되는 거구나. 신기하다. 빨리 잘 다룰 수 있게 더 많이 배워야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/detail.ogg"},"드랍 설명":{"voiceline":"만나서 반가워, 지휘관. 사이렌지 하루나라고 해. 앞으로 잠시동안 여기 머무를 테니 잘 부탁해. 내가 도와줄 게 있으면 언제든 말해줘.","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 돌아온 모양이야. 지휘관, 같이 마중하러 나가도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/expedition.ogg"},"실망":{"voiceline":"역시 여긴 안심할 수 있는 곳이 아닌 건가……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/feeling1.ogg"},"낯섦":{"voiceline":"나, 모항 사람들이랑 친해질 수 있을까 걱정했는데, 지휘관이 있으면 괜찮을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/feeling2.ogg"},"호감":{"voiceline":"지휘관은 정말 자상하구나. 계속 날 신경 써주고, 날 도와줘서 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/feeling3.ogg"},"기쁨":{"voiceline":"처음에는 불안감이나 걱정이 앞섰지만, 지휘관이랑 모항 사람들 덕분에 지금은 그런 마음이 사라졌어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/feeling4.ogg"},"사랑":{"voiceline":"지금은 벌써 지휘관이나 모항 사람들이랑 작별하는 게 슬퍼. 물론 내가 살던 곳도 그립지만…… 그 정도로 여기서 보낸 나날이 즐거웠어. 그러니까 추억을 더 많이 만들자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/feeling5.ogg"},"터치3":{"voiceline":"응? 무슨 일 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/headtouch.ogg"},"모항귀환":{"voiceline":"고생 많았어, 지휘관. 먼저 쉬어도 돼. 서류 업무는 나한테 맡겨!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/home.ogg"},"hp 경고":{"voiceline":"…안 돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 좋은 아침이야. 요즘 바쁜 것 같아서 업무 내용을 미리 정리해 봤어. 도움이 되었으면 해서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/login.ogg"},"실패":{"voiceline":"지휘관, 미안해… 좀 무서워서…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/lose.ogg"},"우편":{"voiceline":"지휘관, 잊지 말고 우편 확인해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/mail.ogg"},"임무":{"voiceline":"지휘관, 완료하지 않은 임무를 잊지 않도록 조심해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/mission.ogg"},"임무완료":{"voiceline":"임무를 다 완료했네. 고생 많았어. 푹 쉬어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/mission_complete.ogg"},"서약":{"voiceline":"이거, 지휘관이 인정했다는 증표…? 고마워! 앞으로도 도와줄 게 있으면 언제든 말해줘! 잘 해낼 수 있을지는 모르겠지만, 열심히 노력할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/propose.ogg"},"스킬":{"voiceline":"분명 해낼 수 있을 거야! 응!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/skill.ogg"},"터치1":{"voiceline":"무슨 일이야, 지휘관? 아, 시간 있으면 잠깐 이야기할까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/touch.ogg"},"터치2":{"voiceline":"꺅?! 안 돼……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/touch2.ogg"},"입수시":{"voiceline":"만나서 반가워, 지휘관. 사이렌지 하루나라고 해. 앞으로 잠시동안 여기 머무를 테니 잘 부탁해. 내가 도와줄 게 있으면 언제든 말해줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/unlock.ogg"},"강화성공":{"voiceline":"강해진 느낌? 응, 느껴져. 묘한 느낌이기는 하지만……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이겼나? 다행이다~! 지휘해 줘서 고마워.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"아직 의장의 원리까지는 모르겠지만, 라라 씨처럼 싸울 수 있는 게 너무 기뻐서… 당분간은 손에서 내려놓고 싶지 않아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"나, 여기서 꽤 열심히 지낸 것 같아. 처음에는 라라 씨처럼 전투에 능숙한 것도 아니라 자신감도 당연히 없었지만, 지휘관 덕분에 용기를 내서 도전할 수 있었어. 앞으로는 지켜지는 존재가 아닌, 누군가를 지키는 존재가 될 수 있도록 더욱 노력할게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"지휘관은 정말 상냥해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"의장에도 익숙해졌고, 전투 요령도 대강 파악하기 시작했으니, 다음 출격에서는 도움이 될 수 있을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관, 늘 고생이 많아. 오늘은 내가 비서함이니까 계획이나 여러 가질 미리 정리해 뒀어. 확인 부탁해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"임무 목록을 정리했어. 좀 도움이 되려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/mission_ex.ogg"},"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"아! 마침 묻고 싶었던 게 있었어. 맛있는 홍차잎 파는 가게 혹시 알아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/touch_ex.ogg"},"터치2_ex":{"voiceline":"아무리 지휘관이라도… 화낼 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"해냈어…! 모두를 확실히 지켜냈어… 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['라라 사타린 데빌룩'] : 라라 씨, 같이 열심히 하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/couple_encourage1.ogg"},{"voiceline":"['코테가와 유이'] : 역시 코테가와 씨야! 나도 열심히 해야지!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/couple_encourage2.ogg"}],"메인4":{"voiceline":"라라 씨는 벌써 여기 완전히 적응한 것 같아. 모두에게 짐이 되지 않도록 나도 노력해야지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/main4.ogg"},"메인1_ex":null,"메인5_ex":{"voiceline":"가사 노동이라면 어느 정도 할 수 있으니까 필요하면 언제든 말해줘. 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/main5_ex.ogg"},"메인6_ex":{"voiceline":"우유는 몸에 좋고 키도 커진다길래 마시고 있어. 그거 말고 다른 이유는 없어!! …지휘관도 자, 마셔.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/main6_ex.ogg"},"메인7_ex":{"voiceline":"돌핀 씨는 정말 돌고래 같아. 친절하면서도 상냥하고… 블로브피시까지 선물해 줬어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/main7_ex.ogg"},"메인8_ex":{"voiceline":"지휘관, 이 근처에도 수족관이 있다던데, 같이 갈래? 분명 내가 아는 것과는 다른 해양생물을 볼 수 있을 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/11100050/main8_ex.ogg"},"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":111,"레어도":"SR","ex_chat_status":1},{"클뜯 id":11100051,"클뜯 함순이 id":1110005,"함순이 이름":"사이렌지 하루나","한글 함순이 + 스킨 이름":"모든 것은 고요한 밤에","영문 함순이 + 스킨 이름":"On One Serene Night","스킨 타입":"Home Relaxation","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100051/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100051/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100051/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100051/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100051/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/11100051/shipyard.png","설명":"지휘관, 홍차 내렸으니까 같이… 어때? 내가 추천하는 찻잎으로 우린 거야.","자기소개":null,"메인1":{"voiceline":"밤마다 항상 복도에서 으스스한 소리가 들려서 너무 무서웠는데… 브리스톨 씨가 기숙사를 탐험하는 소리라는 걸 요즘 알아서 안심했어.","voi