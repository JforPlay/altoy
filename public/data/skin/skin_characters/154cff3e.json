[{"클뜯 id":107110,"클뜯 함순이 id":10711,"함순이 이름":"인트레피드","한글 함순이 + 스킨 이름":"인트레피드","영문 함순이 + 스킨 이름":"Intrepid","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107110/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107110/shipyard.png","설명":"에식스급 항공모함—인트레피드, 현호 CV-11 ","자기소개":{"voiceline":"나는 에식스급 3번함, 인트레피드. 전쟁 중에는 운이 좋지 않아 이상한 별명까지 생겨버렸지만… 흠흠, 별거 아냐! 중요한 건 지금이지. 지휘관의 지휘가 있다면 훨씬 더 잘 해낼 수 있다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/profile.ogg"},"메인1":{"voiceline":"지휘관, 별 보는 걸 좋아해? 아, 천체 관측까지는 아니어도 괜찮아. 만약 흥미가 있다면 우주 얘기를 해보는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/main1.ogg"},"메인2":{"voiceline":"잠수함도… 대단한 것 같네. 하지만 나로서도 상대할 수 있을 것 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/main2.ogg"},"메인3":{"voiceline":"에식스급 자매함들은 많지만, 각자의 특색이 있… 에? 함선의 성능을 빼고, 말인가? 생각해보지 않았는데. 음…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/main3.ogg"},"전투개시":{"voiceline":"이륙 준비 완료—— 함재기 부대, 가라! 롤 아웃!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/battle.ogg"},"상세확인":{"voiceline":"어떤 강적에게도 용감하게 도전해야 한다——말은 이렇게 하지만 여러 가지 이유로 전력을 다할 수 없게 되지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/detail.ogg"},"드랍 설명":{"voiceline":"에식스급 항공모함—인트레피드, 현호 CV-11","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료야. 보급은 이미 확보했어. 음, 역시 지휘관이야. 강한 전투력에는 반드시 든든한 병참 보조가 있어야 하지.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/expedition.ogg"},"실망":{"voiceline":"지휘관, 지금 그 행동은 마치 겁쟁이와도 같아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/feeling1.ogg"},"낯섦":{"voiceline":"나 인트레피드야말로 두려움 없는 용기야. 잘 기억해둬!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/feeling2.ogg"},"호감":{"voiceline":"요, 지휘관! 좋은 오후—— 아야야… 대체 누가 카트를 여기에 둔 거야? 대체 왜 나에게 이런 재수 없는 일이 또… 윽, 별거 아냐. 그러니까, 음, 내가 출격할 임무가 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/feeling3.ogg"},"기쁨":{"voiceline":"한가할 때는 책을 보거나 영화를 봐. 하지만 가장 좋아하는 건 역시 하늘에 가득 뜬 별을 보는 일이야. 아, 그래. 카사블랑카가 추천한 영화 티켓이 두 장 있는데 내일 같이 보러 가지 않을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/feeling4.ogg"},"사랑":{"voiceline":"하늘에 뜬 별은 우리와 몇 광년, 몇십 광년, 심지어 더 멀리 떨어져 있지만 두려움을 모르는 용기와 숱한 노력, 시간만 있다면 언젠간 닿을 수 있을지도 몰라—— 하지만 눈앞의 지휘관은 손만 뻗으면 언제든 닿을 수 있지. 바로 이렇게…! 후후, 그렇지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/feeling5.ogg"},"터치3":{"voiceline":"으아?! 머리를 다 헝클었어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/headtouch.ogg"},"모항귀환":{"voiceline":"후, 돌아왔어! 아, 수리와 보급, 전투 결과 브리핑은 5분 안에 끝낼 수 있을 것 같은데? 그 뒤에 다음 출격을 준비하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/home.ogg"},"hp 경고":{"voiceline":"망했다, 적이 생각보다 더 많아…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/hp_warning.ogg"},"로그인":{"voiceline":"오늘의 작전 계획에 내 이름은 있나? 없다면 내 이름을 넣어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/login.ogg"},"실패":{"voiceline":"또 수리해야 하는 건가… (작은 소리) 왜 항상 재수 없는 건 나인지… 아니, 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/lose.ogg"},"우편":{"voiceline":"새로운 우편… 역시 새로운 임무에 관한 것이겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/mail.ogg"},"임무":{"voiceline":"임무가 힘들어? 정 해결이 안 된다면 나에게 맡기는 건 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/mission.ogg"},"임무완료":{"voiceline":"Mission accomplished! 봐, 용감하게 나서면 해결하지 못할 일은 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/mission_complete.ogg"},"서약":{"voiceline":"이런 일에서는 지휘관이 더 용기 있을 줄은 몰랐네… 어쩔 수 없군… 앞으로도 잘 부탁해! 내가 곁에 있으니 두려워하지 말고 지휘관의 이상을 향해 앞으로 나아가!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/propose.ogg"},"스킬":{"voiceline":"인트레피드, Getting on!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/skill.ogg"},"터치1":{"voiceline":"마시고 싶은 것? 그렇다면—— ‘마티니, 쉐이킹 하지 않고 스티어로!’ ——Just Kidding!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/touch.ogg"},"터치2":{"voiceline":"너는… 하아, 네 용기를 칭찬하기보다는 혼내주고 싶은걸.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/touch2.ogg"},"입수시":{"voiceline":"에식스급의 파이터(The Fighting \"I\"), 인트레피드, 보고! 지휘관, 어서 전투 임무를 맡겨줘. 승리와 영예를 가져다 줄게! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/unlock.ogg"},"강화성공":{"voiceline":"조금 더 강해질 수 있을 것 같아. 예를 들면, 제트기라던가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"두려움을 모르는 자가 승리의 왕관을 쓰는 법!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"어떤 강적이라도 용감하게 도전하라—— 지휘관의 곁이라면 온 힘을 다할 수 있어! 그러니까 다음번 출격 라인 업에는 반드시 나를 넣어줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"잡았다! 후후, 별을 손에 넣는 것은 어렵지만 지휘관이라면 가뿐하지—— 장난이야. 오늘 같이 영화 보자. 이렇게 손을 꼭 잡고 말이야. 후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"♪~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"지휘관, 승리하고 온 걸 환영해! ——아야야야야! 장비에 부딪쳤다… 승리하고 돌아온 지휘관을 보니 조금 들떴네. 아하하…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"오늘의 출격 라인 업은…? 나도 같이 생각해 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":{"voiceline":"임무가 힘들어? 그러면 우리 둘이 함께 힘내서 난관을 헤쳐나가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/mission_ex.ogg"},"임무완료_ex":{"voiceline":"Mission accomplished! 용감하게 나서면 우리 둘이 해결하지 못할 일은 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":null,"터치2_ex":{"voiceline":"에?! 아, 아무리 지휘관이라도 이런 습격은 반칙이야?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['벙커힐', '인디펜던스'] : TaskForce38, Let's Rock!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/couple_encourage1.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"지휘관이 바다에 떨어진대도 내가 구해내면 돼. 걱정 마. 대략적인 위치만 알려주면 수성과 쌍둥이 자리를 찾았던 때처럼 빠르게 곁으로 갈 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"에식스는 노력파야. 하지만 선배의 평가에 너무 얽매이곤 해… 지휘관, 너는 어떻지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/main2_ex.ogg"},"메인3_ex":{"voiceline":"기지개 켜고 싶다… 잠시만, 저기, 지휘관? 옆에 부딪힐 만한 곳은 없지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107110/main3_ex.ogg"},"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":1},{"클뜯 id":107111,"클뜯 함순이 id":10711,"함순이 이름":"인트레피드","한글 함순이 + 스킨 이름":"인트레피드의 일투","영문 함순이 + 스킨 이름":"One Intrepid Pitch","스킨 타입":"Sports Time","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107111/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107111/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107111/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107111/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107111/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107111/shipyard.png","설명":"모항에서 야구 시합을 하려고 하는 것 같아. 이글 유니온의 동료들과 팀을 만들기 전에 실력을 키우기 위해 연습을 하고 싶어. 지휘관, 피칭 연습을 좀 도와줄 수 있어?","자기소개":null,"메인1":{"voiceline":"포니테일은 투구에 영향을 주는 것 같아… 음, 다음번에는 다르게 묶어봐야겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/main1.ogg"},"메인2":{"voiceline":"아, 전력으로 던지면 제구가 잘 안 돼. 미안!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/main2.ogg"},"메인3":{"voiceline":"좋아, 이번 공은 우주의 끝까지 던져 보이겠어! 아, 그러면 포수가 잡을 수 없는데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"나이스 캐치! 지휘관과 호흡이 잘 맞는데? 어때, 내 전속 포수가 될 생각은 없어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/detail.ogg"},"드랍 설명":{"voiceline":"모항에서 야구 시합을 하려고 하는 것 같아. 이글 유니온의 동료들과 팀을 만들기 전에 실력을 키우기 위해 연습을 하고 싶어. 지휘관, 피칭 연습을 좀 도와줄 수 있어?","voicelink":null},"의뢰 완료":null,"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":null,"터치3":null,"모항귀환":{"voiceline":"후, 잠깐 쉬자! 항상 같이 있어 줘서 고마워. 스포츠음료와 타올도 있으니까 사양하지 말고 사용하도록 해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"피칭뿐 아니라 타격도 연습해야… 아, 블루길도 요즘 연습을 하고 있었지. 같이 연습하면 되겠다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/login.ogg"},"실패":{"voiceline":"아, 홈런 맞았네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/lose.ogg"},"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"아, 새로운 피칭이 생각났어. 지휘관, 시험해 보자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/touch.ogg"},"터치2":{"voiceline":"지휘관, 아무리 보호구를 착용하고 있다고 해도 강속구를 맞으면 아프다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/touch2.ogg"},"입수시":{"voiceline":"모항에서 야구 시합을 하려고 하는 것 같아. 이글 유니온의 동료들과 팀을 만들기 전에 실력을 키우기 위해 연습을 하고 싶어. 지휘관, 피칭 연습을 좀 도와줄 수 있어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"내 공은 절대 받아치지 못해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107111/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,