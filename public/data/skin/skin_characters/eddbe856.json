[{"클뜯 id":601090,"클뜯 함순이 id":60109,"함순이 이름":"에마누엘레 페사노","한글 함순이 + 스킨 이름":"에마누엘레 페사노","영문 함순이 + 스킨 이름":"Emanuele Pessagno","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601090/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601090/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/601090/shipyard.png","설명":"나비가토리급 구축함 - 에마누엘레 페사노","자기소개":{"voiceline":"나비가토리급 구축함인 에마누엘레 페사노야. 그 때엔 사르데냐 엠파이어 사람들을 구하긴 했지만, 마지막 호위 임무 때에 조금만 더 조심했더라면….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/profile.ogg"},"메인1":{"voiceline":"먼 곳의 경치를 바라보는 걸 좋아해. 손이 닿는 거리보단, 관측 거리에서… 멀리 보이는 거리 쪽이 더 여러가지를 볼 수 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/main1.ogg"},"메인2":{"voiceline":"모항에도 괜찮은 풍경을 감상할 수 있는 곳은 많이 있을 거야. 가능하다면 전부 기록해두고 싶을지도….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/main2.ogg"},"메인3":{"voiceline":"레코, 출항할 땐 역시 평범한 항로를 고르는 편이 안전할걸……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/main3.ogg"},"전투개시":{"voiceline":"적함 발견… 요격 준비!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/battle.ogg"},"상세확인":{"voiceline":"망원경 렌즈는 잘 손질해둬야 해…. 부주의하게 다루다가 혹시 흠집이라도 나면 큰일이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/detail.ogg"},"드랍 설명":{"voiceline":"나비가토리급 구축함 - 에마누엘레 페사노","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 동료들이 돌아왔어. ……봐, 저기…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/expedition.ogg"},"실망":{"voiceline":"미안해. 혼자있게 해줘…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/feeling1.ogg"},"낯섦":{"voiceline":"지휘관도 망원경을 들여다 본 적 있지? ……그, 눈으로 직접 보는 거랑, 망원경으로 보는 건 어떻게 다른 것 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/feeling2.ogg"},"호감":{"voiceline":"망원경은 그… 먼 곳에서도 선명하게 사물을 볼 수 있게 해줘…. 멀리 떨어진, 누구에게도 폐를 끼치지 않는 곳에서도….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/feeling3.ogg"},"기쁨":{"voiceline":"아름다운 풍경은 한 번 바라보면 기억에 남으니까 그걸로 만족일 수도 있지만…. 그… 좋아하는 건, 그러니까… 가까이에서 만져보고 싶어지기도 하잖아….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/feeling4.ogg"},"사랑":{"voiceline":"저기…… 지휘관. 다음 주에 혹시 비어 있는 날 있어…? 꼭 가고 싶은, 그러니까… 지휘관이랑 같이 보고 싶은 풍경이 있어서…. 괜찮아? 저, 정말 가보고 싶었던 곳이거든….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/feeling5.ogg"},"터치3":{"voiceline":"내 리본은 왜……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/headtouch.ogg"},"모항귀환":{"voiceline":"……앗. 미안해. 멍하니 밖을 내다보다가 지휘관이 돌아온 줄도 몰랐어…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/home.ogg"},"hp 경고":{"voiceline":"모두의 발목을 잡을 수는…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/hp_warning.ogg"},"로그인":{"voiceline":"(빤히) 역시 망원경으로 볼 때랑은 다르네……. 아, 아무것도 아니야. 어서 와, 지휘관.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/login.ogg"},"실패":{"voiceline":"으음, 그러니까……. 지휘관, 너무 낙담하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/lose.ogg"},"우편":{"voiceline":"새 우편……. 관측 거리 너머 머나먼 곳에서…. 그… 먼 곳에서 온 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/mail.ogg"},"임무":{"voiceline":"아직 끝나지 않은 임무가 있네. 지휘관, 왠지 힘들 거 같아. ……잠깐 좀 쉴래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/mission.ogg"},"임무완료":{"voiceline":"임무 완료 보고서…. 확인하는 거 안 도와줘도 괜찮아? 만약 제출용 서류에 오탈자라도 있으면…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/mission_complete.ogg"},"서약":{"voiceline":"어? 이, 이걸 나한테? 고마워…. 이건 소중하게… 소중하게……. 에헤헷, 이제는 멀리서 바라보지 않아도 괜찮아…. 왜냐면 행복은 그… 이미 내 손이 닿는 거리에 와 있으니까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/propose.ogg"},"스킬":{"voiceline":"보였어……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/skill.ogg"},"터치1":{"voiceline":"망원경을 들여다보고 싶다고? 상관은 없는데…… 조, 조심해줘…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/touch.ogg"},"터치2":{"voiceline":"그, 그럼 안 돼…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/touch2.ogg"},"입수시":{"voiceline":"사르데냐 소속 구축함, 에마누엘레 페사노야. 음…… 가까이서 보는 지휘관은 망원경으로 봤을 때랑 다르네…… 더 뚜렷하게 보여서 그런가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/unlock.ogg"},"강화성공":{"voiceline":"관측 거리가 더 늘어난 걸까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"우리가 이긴 거야? 다행이다…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"혼자 여행하면, 감상은 모두 마음에 담아둘 뿐이지만… 둘이서 여행하면 언제든 이야기를 나눌 수 있지……. 에헤헤, 좋아하는 사람이 곁에 있어줘서, 정말 다행이야….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/601090/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"지, 지휘관……?","voicelink":"https://raw.githubusercon