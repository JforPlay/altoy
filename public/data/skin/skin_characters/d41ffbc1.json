[{"클뜯 id":402110,"클뜯 함순이 id":40211,"함순이 이름":"뒤스부르크","한글 함순이 + 스킨 이름":"뒤스부르크","영문 함순이 + 스킨 이름":"Duisburg","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402110/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402110/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402110/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402110/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402110/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/402110/shipyard.png","설명":"M급 경순양함 - 뒤스부르크","자기소개":{"voiceline":"나는 메탈 블러드의 뒤스부르크야. 취미는 여러 가지가 있어. 예를 들면 맛있고 보기 좋은 맛집 탐방, 귀엽고 정교한 액세서리 모으기…… 언젠가는 자그맣게 내 가게를 열고 싶어. 애초에 지금 가장 관심이 있는 건 지휘관 하나뿐이지만♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/profile.ogg"},"메인1":{"voiceline":"내 손톱에 관심 있어? 그럼…… 이렇게 서로 깍지를 끼우면… 지휘관의 피부톤이 잘 보이지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/main1.ogg"},"메인2":{"voiceline":"지휘관, 어떤 레스토랑의 새로운 음료 메뉴가 꽤 괜찮다고 리버풀이 그러더라고. 그런데 혼자 가면 좀 아까울 것 같아서♪ 어머… 같이 가주려고? 다행이다~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/main2.ogg"},"메인3":{"voiceline":"언젠가 가게를 열고 싶기는 한데…… 어떤 가게를 열지 아직 결정하지 못했어. …어머, 관심 있어? 그럼 나중에 이야기 좀 나눠볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/main3.ogg"},"전투개시":{"voiceline":"안 질 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/battle.ogg"},"상세확인":{"voiceline":"아~ 지휘관은 갑자기 사적인 질문 던지는 스타일이구나? 후후후♪ 지휘관한테면 알려줄 수 있어. 그 대신 지휘관 비밀도 알려줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/detail.ogg"},"드랍 설명":{"voiceline":"M급 경순양함-뒤스부르크","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 나간 동료들이 돌아왔어. 재밌는 선물을 많이 들고 왔으면 좋겠네♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/expedition.ogg"},"실망":{"voiceline":"아하하… 바, 방금 건 이해가 잘 안 가네. 알아봐 두는 편이 좋으려나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/feeling1.ogg"},"낯섦":{"voiceline":"좀 심심하네. 다이도, 차라, 피츠버그, 히퍼…… 낮에 다 같이 외출하기로 했는데, 지휘관도 같이 갈래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/feeling2.ogg"},"호감":{"voiceline":"(음… 요즘 지휘관이 왠지 차갑단 말이야… 설마 지금 화장이 별로 마음에 안 드나…?) ……응? 서, 서류 읽고 있던 거 아니었어? 왜 갑자기 그렇게 쳐다봐……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/feeling3.ogg"},"기쁨":{"voiceline":"응? 갑자기 귀여워졌다고? …우후후, 사실은 마법을 좀 부려봤달까…♪ 지휘관이 안 볼 때 몰래 화장을 고친 것뿐이야. 지금 립 컬러가 더 마음에 들어? 더 가까이에서 봐도 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/feeling4.ogg"},"사랑":{"voiceline":"있잖아, 지휘관~ 사람의 의지가 얼마나 강한지 확인하는 방법이 있다던데… 그래, 이렇게 지휘관 위에 올라타고 꼭 안아서… 만약 참을 수 있으면… 상을 줄게♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/feeling5.ogg"},"터치3":{"voiceline":"응? …으응? 갑자기 뭐야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관~ 어서 와~♪ 우후후… 뒤스부르크에게 꼭 알려주고 싶은 재미난 일은 없었어?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/home.ogg"},"hp 경고":{"voiceline":"이런 모습… 절대 지휘관에게는 보여줄 수 없어……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/hp_warning.ogg"},"로그인":{"voiceline":"약속 시간대로 와줬구나. 왠지 데이트하려고 만나는 것 같지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/login.ogg"},"실패":{"voiceline":"뭐야… 진짜 최악이야…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/lose.ogg"},"우편":{"voiceline":"응? 방금 건 우편이 왔다는 알림이야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/mail.ogg"},"임무":{"voiceline":"아직 임무가 덜 끝났어? 우후후♪ 슬슬 뒤스부르크한테 도와달라고 말할 시간 아니야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/mission.ogg"},"임무완료":{"voiceline":"아, 드디어 임무를 마쳤구나… 지금 바로 보상도 확인해 둘래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/mission_complete.ogg"},"서약":{"voiceline":"얼마 전에 필사적으로 참아서 겨우 손에 넣은 「상」을 벌써 쓰려고? 후후후, 좀 아깝지 않아? 딱히 「상」을 안 써도 언제든 들어줄 텐데… 어머, 이제 와서 후회해도 늦었어. 더 많이 나랑 사이좋게 지내자구♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/propose.ogg"},"스킬":{"voiceline":"가라앉아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/skill.ogg"},"터치1":{"voiceline":"뭐야~? 비밀 이야기라도 하게?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/touch.ogg"},"터치2":{"voiceline":"지, 지휘관…… 읏… 실수라고 하기만 해봐…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/touch2.ogg"},"입수시":{"voiceline":"어머, 드디어 만났구나. 네가 지휘관 맞지? 나는 뒤스부르크야. 사이좋게 지내자~ 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/unlock.ogg"},"강화성공":{"voiceline":"어머, 강하게 만들어 준 줄만 알았더니, 더 귀엽게도 만들어 줬네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/upgrade.ogg"},"vote":null,"승리":{"voiceline":"다들 열심히 한 덕분이야. 후후후♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"오늘은 뒤스부르크의 뭘 알려줄까? 지휘관의 비밀을 알려 주면, 나도 뭐든 알려…… 뭐? 그, 그건 좀…… 그건 알아서 뭘 하게…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"음… 이래 봬도 나, 직접적으로 마음을 표현하는 건 잘 못해… 그렇지만 적극적인 지휘관한테 미안하기도 하고, 한 번쯤은 내 쪽에서 도전해 보는 것도… 크흠. 조, 좋아해. 계속 예전부터…… 바, 방금 건 어땠어?! 이미 다 알고 있으니까 이제 와서 무리해서 말하지 않아도 된다고…? 뭐, 뭐야…!////","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/feeling5_ex.ogg"},"터치3_ex":{"voiceline":"우후후, 눈빛으로 이미 알았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/headtouch_ex.ogg"},"모항귀환_ex":{"voiceline":"어서 와~ 꽉 안아달라고? 자~ 지휘관 머리, 여기에 폭 파묻어도 괜찮아♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"지휘관♪ 후후후, 기다렸어. 오늘 일 끝나면 같이 할까? 외 출♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"가, 간지러워…… 갑자기 왜 그래…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/touch_ex.ogg"},"터치2_ex":{"voiceline":"후후후… 이다음에 댈 변명으로 나를 만족시킬 수 있다면……♥","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['오와리'] :  메이크업 어떻게 하는지 좀 알려줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/couple_encourage1.ogg"},{"voiceline":"['브레머튼', '리버풀'] :  얼마 전에 말한 가게에 나중에 같이 가볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/couple_encourage2.ogg"},{"voiceline":"['다이도', '시리우스'] :  메이드 일 하느라 고생이 많아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/couple_encourage3.ogg"},{"voiceline":"['피츠버그'] :  새로 나온 주스 마셔볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/402110/couple_encourage4.ogg"}],"메인4":null,"메인1_ex":null,"메인5_ex":{"v