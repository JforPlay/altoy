[{"클뜯 id":106550,"클뜯 함순이 id":10655,"함순이 이름":"카사블랑카","한글 함순이 + 스킨 이름":"카사블랑카","영문 함순이 + 스킨 이름":"Casablanca","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/106550/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/106550/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/106550/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/106550/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/106550/shipyard.png","설명":"카사블랑카급 호위 항공모함—카사블랑카, 현호 CVE-55 ","자기소개":{"voiceline":"그때, 1년여 라는 짧은 시간 동안 이글 유니온은 50척의 카사블랑카급 자매들을 만들어 냈습니다. 대부분이 전쟁이 끝난 뒤 얼마 되지 않아 자신의 사명을 마쳤지만… 이 함대에서 최선을 다하겠습니다. 운송이든 보급이든 맡겨만 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/profile.ogg"},"메인1":{"voiceline":"지휘관님, 함대 병참 보조에 관해 확인해드릴까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/main1.ogg"},"메인2":{"voiceline":"상황이 빠르게 변하는 위험한 최전선과 단조롭지만 중요한 후방…… 지휘관님, 만약 선택하셔야 한다면 어느 쪽을 선택하시겠어요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/main2.ogg"},"메인3":{"voiceline":"기회가 있다면 매사추세츠 선에게 카사블랑카 해전에 관한 이야기를 들어보고 싶군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/main3.ogg"},"전투개시":{"voiceline":"역시 최전선 작전인가요? 알겠습니다…! 지원은 저에게 맡겨주세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/battle.ogg"},"상세확인":{"voiceline":"최전선의 전투에는 알맞지 않지만, 해야 할 때는 저도 전력을 다해 싸우겠습니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/detail.ogg"},"드랍 설명":{"voiceline":"카사블랑카급 호위 항공모함—카사블랑카, 현호 CVE-55","voicelink":null},"의뢰 완료":{"voiceline":"의뢰로 획득한 자원은 모두 정리해두었습니다. 확인해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/expedition.ogg"},"실망":{"voiceline":"함대의 발전을 저해하는 주범이 지휘관님이셨군요…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/feeling1.ogg"},"낯섦":{"voiceline":"아미르에서 아라잔만, 그리고 다시 카사블랑카—— 모두가 의미 있는 이름을 좋아하는군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/feeling2.ogg"},"호감":{"voiceline":"저는 소설과 영화를 좋아합니다. 마음을 울리는 다양한 스토리는 생각해볼 점이 많죠. … 네? 어떤 주제를 좋아하냐고요? 그건… 비밀이라고 해둘까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/feeling3.ogg"},"기쁨":{"voiceline":"엘리제… 양자택일인가요… 이런 어려운 선택은 정말 하기가 힘드네요… 다행히 저는 이런 선택을 할 필요가… 에, 지휘관님?! 어어어언제 들어오신 거죠?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 다음번에 같이 영화 보러 가지 않으시겠어요? 음, 제가 제일 좋아하는… 로맨스 영화를 지휘관님과 함께 보러 가고 싶어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님, 다녀오셨습니까. 이번 작전의 보고서가… 책상 위의 소설…? 아! 흠, 흠흠… 아닙니다. 무시해주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/home.ogg"},"hp 경고":{"voiceline":"음… 계속 이러신다면 약간…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/hp_warning.ogg"},"로그인":{"voiceline":"지체해서는 안 됩니다. 오늘의 일을 시작하도록 하죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/login.ogg"},"실패":{"voiceline":"호위 항공모함으로 최전선에서 작전을 수행하는 것은 역시 한계가 있습니다…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/lose.ogg"},"우편":{"voiceline":"우편이 있군요. 사령부의 지령일까요? 지휘관님, 역시 봐두는 것이 좋겠지요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/mail.ogg"},"임무":{"voiceline":"이 임무를 끝내면 더 많은 보급을 얻을 수 있겠군요. 힘내세요, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/mission.ogg"},"임무완료":{"voiceline":"임무 완료입니다. 다행이군요. 이 정도 보급이 있다면 함대 운용도 조금 더 순조롭겠어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/mission_complete.ogg"},"서약":{"voiceline":"우여곡절이 많은 로맨스는 그 나름대로의 매력이 있지만 제 일이라고 생각한다면 역시 평범하지만 행복한 이야기가 좋겠지요…… 지휘관님도 그렇게 생각하시지요? 일단 저에게 서약의 증표를 주시고 이 의식을 마치는 게 어떨까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/propose.ogg"},"스킬":{"voiceline":"온 힘을 다해 모두를 지원하겠습니다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/skill.ogg"},"터치1":{"voiceline":"지휘관님, 무슨 일이라도 있으신가요? 아, 설마 제 넥타이가 비뚤어진 건가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/touch.ogg"},"터치2":{"voiceline":"으앗?! … 책, 책에는 이런 내용은 없었는데…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/touch2.ogg"},"입수시":{"voiceline":"안녕하세요, 지휘관님. 호위 항공모함 카사블랑카, 보고 드립니다. 제가 가장 잘하는 방식으로 함대를 지원할테니 안심하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/unlock.ogg"},"강화성공":{"voiceline":"감사합니다, 지휘관님.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/upgrade.ogg"},"vote":null,"승리":{"voiceline":"제가 MVP…? 후… 전면전은 생각한 것보다 어렵지 않군요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/win_mvp.ogg"},"전투개시_ex":{"voiceline":"지휘관님을 위해서… 지지 않아요! ","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/battle_ex.ogg"},"상세확인_ex":{"voiceline":"사막과 바다의 경계선에 위치한 작은 바, 시간을 따라서 사라지지만 여전히 그리운 기억 속 아이리스 리브레의 풍경…… 정말 아름답다고 생각하지 않으세요, 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/106550/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"다녀오셨나요, 지휘