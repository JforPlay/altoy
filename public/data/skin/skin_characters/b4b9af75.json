[{"클뜯 id":101550,"클뜯 함순이 id":10155,"함순이 이름":"클래런스 K 브론슨","한글 함순이 + 스킨 이름":"클래런스 K 브론슨","영문 함순이 + 스킨 이름":"Clarence K. Bronson","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101550/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101550/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101550/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101550/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101550/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/101550/shipyard.png","설명":"플레처급 구축함 - 클래런스 K 브론슨","자기소개":{"voiceline":"이글 유니온 소속 플레처급 구축함, 클래런스 K 브론슨… 설비 테스트 스태프야. 안정성이 보장되지 않은 새 설비를 체크리스트대로 검사·분석해서, 지휘관의 안전을 지켜 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/profile.ogg"},"메인1":{"voiceline":"어떤 설비든 테스트는 내게 맡겨. 잠재적 리스크를 전부 제거해 줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/main1.ogg"},"메인2":{"voiceline":"설비 테스트 보고서를 전부 정리했어. 개선해야 할 점이나 사용 시 잠재 리스크도 기록했으니까, 한번 훑어봐 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/main2.ogg"},"메인3":{"voiceline":"지휘관, 그 테스트 보고서 읽어 봤어? 어뢰랑 주포, 항공 폭탄 말이야. …우선은 소규모로 시험해 보고 싶다고? 걱정할 거 없어. 안전 테스트는 통과했고, 데이터는 절대 거짓말을 안 하니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/main3.ogg"},"전투개시":{"voiceline":"전 작전 유닛 검증 완료. 요격할게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/battle.ogg"},"상세확인":{"voiceline":"리스크가 높고 불안정한 설비일수록, 세심한 주의를 기울여 여러 번 검사해야 해. 그게 내 직책의 존재 이유이기도 하지. ……그래도 보험에 가입하는 건 잊지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/detail.ogg"},"드랍 설명":{"voiceline":"플레처급 구축함 - 클래런스 K 브론슨","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 위탁팀 동료들이 돌아왔어. 실은 설비 실전 데이터 수집을 부탁했거든. 같이 확인하러 가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/expedition.ogg"},"실망":{"voiceline":"일하는 중에는 방해하지 마. 테스트 결과의 신뢰성이 떨어질 수도 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/feeling1.ogg"},"낯섦":{"voiceline":"설비의 성능과 안전성은 현장에서 확인해야 해. …리스크 대처법이랑 예비안은 생각해 뒀으니까, 그렇게 걱정하지 마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/feeling2.ogg"},"호감":{"voiceline":"……설비의 안전 리스크를 제거할 수만 있다면, 야근 정도는 얼마든지 감수할 수 있어. 굳이 날 걱정하지 않아도 괜찮아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 조금 기술적인 문제로…… 혹, 혹시 괜찮으면…… 조언을 얻었으면 하는데…… 응, 지휘관의 조언이면…… 분명 힌트를 얻을 수 있을 거야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 아, 저기…… 이대로 잠시 안겨 있어도 될까……? 사실…… 클래런스에게 지휘관이 얼마나 소중한지 중요한 테스트 중이거든…… 결과가 나왔어. 나에게 지휘관은… 둘도 없는 존재야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/feeling5.ogg"},"터치3":{"voiceline":"윽……!? 서, 설비에 오류가 났어. 먼, 먼저 확인하고 올게…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관, 임무는 순조로워? 다음 출항 전까지 설비 가동 상태를 다시 한번 조사해 둘게. 컨디션을 최고 상태로 유지하기 위해서 말이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/home.ogg"},"hp 경고":{"voiceline":"방어 시스템에 긴급 정비가 필요해……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침이야, 지휘관. 정례적인 무작위 검사는 벌써 끝냈어. 확인이라도 해 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/login.ogg"},"실패":{"voiceline":"문제를 감지하지 못한 내 책임이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/lose.ogg"},"우편":{"voiceline":"지휘관, 새 우편이 도착했어. 받는 걸 잊으면, 나중에 또 알려 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/mail.ogg"},"임무":{"voiceline":"지휘관, 아직 처리 안 한 임무가 있는 것 같네. 이런 건 일찍 처리해야 리스크를 줄일 수 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/mission.ogg"},"임무완료":{"voiceline":"간신히 기한까지 일을 끝낸 모양이네. 좋아, 나머지는 나한테 맡겨 줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/mission_complete.ogg"},"서약":{"voiceline":"나랑… 서약을 맺는다고? 그, 그건 미지의 영역이니까…… 리스크를 제거해야 해! 우선, 반지 사이즈가 맞는지 확인해야…… 그러니까 지휘관, 그걸 이 손가락에 끼워 줄래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/propose.ogg"},"스킬":{"voiceline":"모든 리스크를 제거하겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/skill.ogg"},"터치1":{"voiceline":"테스트하느라 고생이 많다고……? 괘, 괜찮아…… 해야 할 일을 했을 뿐이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/touch.ogg"},"터치2":{"voiceline":"지, 지휘관……? 이러면… 센서 교정에 영향이…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/touch2.ogg"},"입수시":{"voiceline":"나는 클래런스 K 브론슨, 오늘부터 모항 설비의 테스트·평가·개선을 담당하게 됐어. 설비의 최신 상태를 알고 싶으면 언제든지 확인해 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/unlock.ogg"},"강화성공":{"voiceline":"장비 성능이 향상된 것 같아…… 바로 안정성은 어떤지 테스트하고 올게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/upgrade.ogg"},"vote":null,"승리":{"voiceline":"음…… 기준치에서 전투 성능이 벗어나지 않았네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/101550/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"「지휘관과 함께 있