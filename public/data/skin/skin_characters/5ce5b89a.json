[{"클뜯 id":107100,"클뜯 함순이 id":10710,"함순이 이름":"요크타운Ⅱ","한글 함순이 + 스킨 이름":"요크타운Ⅱ","영문 함순이 + 스킨 이름":"Yorktown II","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107100/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107100/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107100/shipyard.png","설명":"에식스급 항공모함—요크타운II, 현호 CV-10","자기소개":{"voiceline":"되살아난 파이팅 레이디, 에식스급 항공모함 요크타운이 돌아왔어요. ……후후후, 사실은 당신이 알고 있는 그 요크타운이 맞답니다. 이렇게 새로운 모습으로 동료들과 함께 싸울 수 있게 해주다니, 역시 지휘관님이에요. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/profile.ogg"},"메인1":{"voiceline":"…! 무슨 일인가요, 허먼. 그 모습은… 아, 하긴 저도 좀 변하긴 했죠…. 으음….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/main1.ogg"},"메인2":{"voiceline":"걱정해주는 건 고마워요. 그렇지만 너무 저만 바라보시는 것도 좀…. 지휘관님의 시간을 낭비할 순 없으니, 다른 동료들도 신경 써 주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/main2.ogg"},"메인3":{"voiceline":"아하, 이 의장은 이렇게 쓰는 거구나…. 고마워요, 에식스. 이런 모습이니까 그렇게 격식 차릴 필요는 없어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/main3.ogg"},"전투개시":{"voiceline":"자유와 승리를 위해…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/battle.ogg"},"상세확인":{"voiceline":"외교 상의 겉치레 인사는 전투 전의 매너일 뿐이기도 하지만, 사람 간의 분쟁을 끝내는 것 또한 외교를 통한 대화뿐이죠. 지휘관님께는 심려를 끼쳐드리겠지만….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/detail.ogg"},"드랍 설명":{"voiceline":"에식스급 항공모함—요크타운II, 현호 CV-10","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀 사람들이 무사히 귀환했어요. 너무 기다리게 하면 안 되겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/expedition.ogg"},"실망":{"voiceline":"이건 요크타운의 자립심을 기르기 위해 지휘관님이 주는 시련이 분명해. …아닌가요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/feeling1.ogg"},"낯섦":{"voiceline":"제게 빛을 내려주고, 절 구원해준 지휘관님과 전, 더 이상 상사와 부하의 관계가 아니에요. 제게 지휘관님은…… 그러니까, 그게… 왜, 왠지 좀 부끄럽네요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/feeling2.ogg"},"호감":{"voiceline":"으, 으흠. 아, 딱히 몸이 안 좋은 건 아니에요. 아무래도 이런 모습이라 지휘관님을 어떻게 대해야 할지 잘 모르겠어서… 정말 괜찮다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님뿐만 아니라, 엔터프라이즈, 호넷, 그리고 허먼까지…. 그래요. 제게 있어서 지휘관님은 이 모항에서의 행복한 나날을 선물해 준 소중한 사람, 그리고 제 모든 걸 걸고 지키고 싶은 존재예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/feeling4.ogg"},"사랑":{"voiceline":"행복의 빛 속에 있는 제가 손을 내밀어준 지휘관님을 위해 해야하는 것―― 후후후, 그건 계속 이대로 행복하게 사는 거라는 거죠? 저도 알아요. 그래야 모두에게 제 행복을 나눠줄 수 있으니까요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/feeling5.ogg"},"터치3":{"voiceline":"저도 아이처럼 어리광…부려 볼까요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님의 개선을 축하하는 의미에서 건배—— 네, 한 잔만요. 걱정해주는 건 기쁘긴 한데… 후후, 지휘관님, 왠지 엔터프라이즈네랑 비슷해진 것 같은데요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/home.ogg"},"hp 경고":{"voiceline":"여기서 무너질 수는 없어…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/hp_warning.ogg"},"로그인":{"voiceline":"어서 와요, 지휘관님. 오늘은 어떤 것부터 착수하시겠어요? 걱정 마세요, 저랑 동료들도 함께니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/login.ogg"},"실패":{"voiceline":"지휘관님이 주신 빛을… 여기서 잃을 수는 없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/lose.ogg"},"우편":{"voiceline":"이건… 호넷 택배? 아, 그러니까 우편을 말하는 거예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/mail.ogg"},"임무":{"voiceline":"어머, 이글이잖아? 아하, 임무를 완료한 거구나…. 바로 지휘관님께 알리고 올게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/mission.ogg"},"임무완료":{"voiceline":"고마워, 이글. 임무 보상이 도착했어. …아, 딱히 말을 알아듣는 건 아니고, 대충 이글이 뭘 전하려고 하는지만 아는 정도예요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/mission_complete.ogg"},"서약":{"voiceline":"맹세할게요. 요크타운의 이름이 짊어진 자유와 평화를, 요크타운이 바라는 행복한 나날을, 요크타운의 진심어린 사랑을…… 이 입술의 온기로 당신께――","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/propose.ogg"},"스킬":{"voiceline":"이 힘으로 미래를 열겠어요…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/skill.ogg"},"터치1":{"voiceline":"엔터프라이즈, 괜찮을까요…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/touch.ogg"},"터치2":{"voiceline":"당신이 새긴 요크타운의 각인은 계속 여기에 남아 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/touch2.ogg"},"입수시":{"voiceline":"에식스급 2번함, '파이팅 레이디' 요크타운이 당신 곁으로 다시 돌아왔어요. 어둠이 끝난 후 찾아오는 건 눈부신 행복의 빛—— 지휘관님, 함께 우리의 밝은 미래를 향해 걸어가요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/unlock.ogg"},"강화성공":{"voiceline":"강화 완료예요. 몸도 이 힘에 점점 익숙해지고 있네요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"앗. …죄송해요, 잠깐 발이 미끄러져서… 고마워요, 지휘관님. 지금 받아 주신 거, MVP 따낸 포상으로 여길게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"고민거리가 있으시면 털어놓으세요. 당신의 풀 죽은 얼굴을 보면 저도 슬퍼져요. 그렇게 되면 걱정하는 애들이 점점 더 늘어나겠죠……. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"의뢰팀 사람들이 무사히 귀환했어요. 같이 마중 나가죠.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"승리를 축하하는 의미로 와인이라도 딸까요? 걱정 마세요, 전 딱 한 잔만 마실 테니까. 실은 몇 잔이고 마셔서 적극적으로 변하고 싶지만… 아니, 아, 아무것도 아니에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"평안하신지요, 지휘관님. 업무는 문제 없나요? 요크타운이 도와드릴 수 있는 부분이 있다면 뭐든 말씀하세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":{"voiceline":"지휘관님, 왜 그러세요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/touch_ex.ogg"},"터치2_ex":{"voiceline":"지휘관님, 착하지, 착해……. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":{"voiceline":"음, 그러니까… \"MVP를 따낸 요크타운, 지휘관님 포상도 받고 싶다아~\" ……아하하, 여, 역시 이런 건 저한텐 안 어울리려나요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/win_mvp_ex.ogg"},"함대 특수대사":[{"voiceline":"['엔터프라이즈'] :  자유롭게 싸워요! 엔터프라이즈!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/couple_encourage1.ogg"},{"voiceline":"['호넷', '호넷Ⅱ', '허먼', '허먼Ⅱ'] :  저는 괜찮아요, 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/couple_encourage2.ogg"}],"메인4":{"voiceline":"렉싱턴, 다음 라이브는 언제에요? 엔터프라이즈랑 호넷도 데리고 응원하러 갈게요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/main4.ogg"},"메인1_ex":null,"메인5_ex":null,"메인6_ex":{"voiceline":"걱정하는 게 아니라, 요크타운과 같이 있고 싶은 것뿐? 네, 저도… 같은 마음이에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/main6_ex.ogg"},"메인7_ex":{"voiceline":"과거는 중요해요. 잊고 싶은 일도 있지만, 그것도 모두 저희의 일부분이니까…. 지금 이 행복도 모두가 힘써준 덕분이라고 생각해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/main7_ex.ogg"},"메인8_ex":{"voiceline":"지휘관님, 다음 휴일에는 어디로 갈까요? 멀리 나가지 않아도… 보세요, 모항 안에도 아직 가보지 않은 곳이 꽤 있답니다…. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/main8_ex.ogg"},"메인4_ex":null,"메인5":{"voiceline":"우리가 싸우기 위해서만 태어난 존재가 아니듯, 지휘관님도 일만 하기 위해 태어난 존재가 아니에요. 일이 잘 안 풀릴 땐 기분 전환이라도 해서 머리를 식혀주세요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/107100/main5.ogg"},"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"UR","ex_chat_status":1},{"클뜯 id":107101,"클뜯 함순이 id":10710,"함순이 이름":"요크타운Ⅱ","한글 함순이 + 스킨 이름":"밝은 하늘의 인어","영문 함순이 + 스킨 이름":"Bright-Sky Mermaid","스킨 타입":"Swimsuits","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107101/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107101/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107101/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107101/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107101/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/107101/shipyard.png","설명":"이런 느낌이면 되려나? ……아니, 괜찮겠지. 그것보다 조금 끈을 느슨하게 하는 편이 좋으려나…? 으음… 꺅?! 죄송해요, 지휘관님…. 괘, 괜찮으신 건가….","자기소개":null,"메인1":{"voiceline":"허먼이 보면 분명 오해할텐데…….