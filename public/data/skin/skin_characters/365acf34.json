do2603/AzurLane/main/audio/voiceline/317011/feeling5.ogg"},"터치3":{"voiceline":"으아… 내가 더 높은 곳에 있는데, 어떻게 지휘관이 내 머리를 쓰다듬는 거지…?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317011/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관도 이쪽으로 올라와~ 여기선 바닷바람이 확 느껴져서 하루 피로가 싹 풀려~ 자, 어서 외투 벗어. 내가 도와줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317011/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"지휘관도 집에 가는 중이야? 에헤헤, 그럼 이쪽으로 와. 여기서 보는 풍경이 아주 끝내줘. 높아서 이것저것 다 보여~ 헤헷, 미끄러지지 않도록 신발을 벗었으니까, 걱정할 필요 없어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317011/login.ogg"},"실패":null,"우편":null,"임무":null,"임무완료":null,"서약":null,"스킬":null,"터치1":{"voiceline":"왜 그래, 지휘관? 같이 관찰하려고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317011/touch.ogg"},"터치2":{"voiceline":"지, 지휘관……! 갑자기 그러면 균형이 무너져서…… 떨어지면 큰일 난다구!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317011/touch2.ogg"},"입수시":{"voiceline":"높다…! 그래도 괜찮아, 지휘관. 난 균형감각이 좋거든. 그것보다 이 아래 뭐가 있는지 같이 보자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317011/unlock.ogg"},"강화성공":null,"vote":null,"승리":null,"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"사복","상점 id":0,"상점 카테고리 id":9,"스킨 태그":"배경","입수 영상":"X","재화":null,"기간":null,"진영":"IJN","레어도":"SSR","ex_chat_status":0}]