[{"클뜯 id":317010,"클뜯 함순이 id":31701,"함순이 이름":"이13","한글 함순이 + 스킨 이름":"이13","영문 함순이 + 스킨 이름":"I-13","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317010/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317010/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317010/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317010/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/317010/shipyard.png","설명":"순잠 갑형 개2형 잠수함 이13 ","자기소개":{"voiceline":"저는 이13형 잠수함, 순잠 갑형 개2의 초함, 이13입니다. 이9형 5호함이라고도 불린 적이 있죠. 하지만 저는 함재기 \"세이란\"만을 탑재하도록 설계된 개량형이에요. 아주 대단하지 않나요? 별로 쓰임새는 없었지만......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/profile.ogg"},"메인1":{"voiceline":"지휘관님, 이건 조심해주세요. 제가 비행기를 좋아하긴 하지만, 잠수함인 저를 싫어하진 않는다구요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/main1.ogg"},"메인2":{"voiceline":"바다의 색은 하늘의 색이고, 하늘의 색은 저의 색이에요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/main2.ogg"},"메인3":{"voiceline":"99식, 97식, 코멧, 텐잔, 글로스터 미티어, 사이운, 그리고 저의 세이란...... 비행기와 관련된 것이라면, 전 모두 알고 있어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/main3.ogg"},"전투개시":{"voiceline":"더 노력할게요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/battle.ogg"},"상세확인":{"voiceline":"지휘관님, 잠수함에만 의지하면 할 수 있는 일에 한계가 있어요. 판을 좌우하려면 결국 하늘의 힘에 기대야해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/detail.ogg"},"드랍 설명":{"voiceline":"순잠 갑형 개2형 잠수함 이13","voicelink":null},"의뢰 완료":{"voiceline":"지휘관님, 의뢰 완료 시간이지 않나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/expedition.ogg"},"실망":{"voiceline":"지휘관님도 역시 저를 이해하지 않는군요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/feeling1.ogg"},"낯섦":{"voiceline":"제 방의 손님이 되신걸 환영합니다, 지휘관님. 함재기와 관련된 책은 여기에 전부 다 있어요, 원하는 대로 보셔도 돼요. 그리고, 진열장 안에 함재기 모형은 살살 다뤄주세요~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/feeling2.ogg"},"호감":{"voiceline":"지휘관님도 역시 제 취미가 이상하다고 생각하시나요? 하하, 어쩔 수 없네요. 하지만 지휘관님, 저의 잠수함 일생 중에 발견했는데, 잠수함의 힘은 한계가 있어요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/feeling3.ogg"},"기쁨":{"voiceline":"지휘관님이 중간에서 다리를 놓아주신 덕분에, 제가 여러 항공모함의 함재기에 가까이 갈 수 있게 되었네요. 저에게 이보다 더 기쁜 일은 없어요. 정말 고마워요, 지휘관님~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/feeling4.ogg"},"사랑":{"voiceline":"지휘관님, 저를 위해 이렇게 많은 일을 해주셨는데, 가끔은 저에게도 지휘관님을 위한 일을 하게 해주세요. 뭐든지 좋답니다? 왜냐면, 지휘관님이 항상 저를 지지해주는 것처럼, 저도 지휘관님에게 힘이 되고 싶으니깐요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/feeling5.ogg"},"터치3":{"voiceline":"으음... 살짝 쓰다듬는 것 정도라면 괜찮겠지...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/headtouch.ogg"},"모항귀환":{"voiceline":"지휘관님, 작전 수고하셨어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/home.ogg"},"hp 경고":{"voiceline":"이게 바로 잠수함의 한계인가......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/hp_warning.ogg"},"로그인":{"voiceline":"환영합니다, 지휘관님. 오늘 하늘도 온통 푸른색입니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/login.ogg"},"실패":{"voiceline":"역시, 잠수함에만 의지하는건 아무 소용이 없네요......","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/lose.ogg"},"우편":{"voiceline":"지휘관님, \"세이란\"이 편지를 가져왔어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/mail.ogg"},"임무":{"voiceline":"지휘관님, 잊지 말고 임무를 확인해야해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/mission.ogg"},"임무완료":{"voiceline":"지휘관님, \"세이란\"이 임무 보상을 가져왔어요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/mission_complete.ogg"},"서약":{"voiceline":"......헬캣!? TBF!? 허리케인!? 그리고 다른 함재기들...... 이건 특별히 저희를 축복하기 위해 가져온 거라고요? ......정말이지, 지휘관님. 안되는데. 이러시면, 제가 구제불능이 될 만큼 지휘관님을 좋아하게 된다구요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/propose.ogg"},"스킬":{"voiceline":"이게 바로, 제가 할 수 있는 최대치입니다——！","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/skill.ogg"},"터치1":{"voiceline":"지휘관님, \"세이란\"을 가지고 놀게 빌려드릴 수 있지만, 이 아이는 매우 소중하니 망가뜨리면 화낼거에요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/touch.ogg"},"터치2":{"voiceline":"\"세이란\"에게 기관총으로 지휘관님을 조준하게 할 겁니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/touch2.ogg"},"입수시":{"voiceline":"처음 뵙겠습니다 지휘관. 저는 잠수항모 이13이에요. 비행기랑 하늘을 쳐다보는 걸 좋아해요. 그리고 이 아이는 저의 친구, \"세이란\"이에요. 잘 부탁해요.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/unlock.ogg"},"강화성공":{"voiceline":"계속 더 강해지면, 세이란을 더 많이 탑재해도 되나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/upgrade.ogg"},"vote":null,"승리":{"voiceline":"이런 승리는 다른 부대에도 도움을 줄 수 있겠죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"같이 비행기 전람회 갔을 때 나만 신나서 계속 이것저것 떠들었는데… 지휘관은 혹시 지루했어……? 재, 재밌었다고? 지, 진짜…? 에헤헤~///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/317010/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline"