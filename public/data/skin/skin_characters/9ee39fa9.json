[{"클뜯 id":9703030,"클뜯 함순이 id":970303,"함순이 이름":"포슈·META","한글 함순이 + 스킨 이름":"포슈·META","영문 함순이 + 스킨 이름":"Foch META","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703030/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703030/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703030/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703030/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703030/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/9703030/shipyard.png","설명":"안녕. 반가워, 지휘관. 전장의 주재자 포슈야. 후후, 어디 주재자냐고? 그야… 당연히 지옥이지! 하하하, 앞으로 잘 부탁해♪","자기소개":{"voiceline":"나는 포슈야. 처음 만났을 때 인사한 것처럼 \"전장의 주재자\"지! 그러니까 어떤 지옥 같은 고민이든 다 나한테 털어놔! 내가 하나씩 해결해 줄 테니까!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/profile.ogg"},"메인1":{"voiceline":"모항에는 영원한 \"전간기\"가 있지. 이게 바로 \"평화\"라는 건가? 흠… 납득이 가기는 하네!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/main1.ogg"},"메인2":{"voiceline":"이 서류 더미가 지옥보다 천 배는 무서워… 네가 맨날 밤을 새우는 데는 다 이유가 있었군. 어떻게든 생활 리듬을 되찾아야 할 텐데…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/main2.ogg"},"메인3":{"voiceline":"아무것도 안 하고 쉴 수만 있는 곳은 어디에도 없어. 지옥도 8시간은 일해야 하거든. 하하하, 어때? 역시 살아있는 편이 낫지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/main3.ogg"},"전투개시":{"voiceline":"아하하하! 이게 바로 지옥으로 가는 급행열차다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/battle.ogg"},"상세확인":{"voiceline":"그나저나 지휘관은 뭐라고 불리고 싶어? 지옥의 대공? 아니면 지옥의 왕? 아하하, 그렇게 긴장할 필요 없어. 항상 그런 식으로 부르려는 건 아니니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/detail.ogg"},"드랍 설명":{"voiceline":"포슈호 중순양함<color=#92fc63>(1척만 소지할 수 있습니다. 중복으로 획득한 경우, 한계돌파 재료로 변환됩니다.)</color>","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료. 보러 안 가?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/expedition.ogg"},"실망":{"voiceline":"음, 으음…… 이건 분화구인지, 해구인지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/feeling1.ogg"},"낯섦":{"voiceline":"지휘관은 진짜 지옥을 본 적…… 아, 아니지. 미안. 네 일정표를 보니까 크게 다를 것도 없더라고……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/feeling2.ogg"},"호감":{"voiceline":"벼랑 끝에 몰렸을 때, 누군가 내 손을 잡아 주었지…… 그게 누군지는… 굳이 말 안 해도 알지, 지휘관♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/feeling3.ogg"},"기쁨":{"voiceline":"지옥에서도 노력하지 않으면 더욱 타락할 뿐…… 그런 건 이제 전혀 두렵지 않아. 지휘관이 내 곁에 있고, 설령 가라앉는다고 해도 그때는 나 혼자가 아닐 테니까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 오늘은 같이 신나는 여행이라도 떠나는 게 어때? 장소는… 그래, 지옥으로 하자! 후훗, 거절하면 안 돼. 왜냐면 이제 우리는 떼려야 뗄 수 없는 사이…잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/feeling5.ogg"},"터치3":{"voiceline":"음… 이건… 인사? 자꾸 그러면 내 머리가…… 아, 괜찮아. 흐트러져도 상관없어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/headtouch.ogg"},"모항귀환":{"voiceline":"드디어 돌아왔구나, 지휘관! 아직 음식은 따뜻해. 자, 어서 내 요리 솜씨를 확인하러 와♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/home.ogg"},"hp 경고":{"voiceline":"으아, 설마 여기까지……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/hp_warning.ogg"},"로그인":{"voiceline":"지휘관, 이거 다 처리해야 하는 서류야. 헉, 지옥이라도 본 것 같은 표정이네. …걱정 마, 나도 도와줄게!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/login.ogg"},"실패":{"voiceline":"음… 이거 또 같은 과오를 반복하고 말았네…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/lose.ogg"},"우편":{"voiceline":"새로운 우편이야. 아, 이 편지는 그냥 평범한 편지니까 열어봐도 돼.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/mail.ogg"},"임무":{"voiceline":"아직 완료하지 않은 임무가 있네, 지휘관♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/mission.ogg"},"임무완료":{"voiceline":"임무 보상이 도착했어. 어서 보러 와♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/mission_complete.ogg"},"서약":{"voiceline":"흠…… 아무리 나라도 이런 걸 받으니까 두근거리네. 아무튼 감사히 받을게! 네 말대로 앞으로 우리는 절대 서로 떨어질 수 없는 운명이니까! 하하하!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/propose.ogg"},"스킬":{"voiceline":"지옥에 떨어져 봐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/skill.ogg"},"터치1":{"voiceline":"응? 나랑 이야기하고 싶다고? 음, 잠깐 어울려 줄게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/touch.ogg"},"터치2":{"voiceline":"지휘관, 자꾸 그러면 되돌릴 수 없게 될걸♡","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/touch2.ogg"},"입수시":{"voiceline":"안녕. 반가워, 지휘관. 전장의 주재자 포슈야. 후후, 어디 주재자냐고? 그야… 당연히 지옥이지! 하하하, 앞으로 잘 부탁해♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/unlock.ogg"},"강화성공":{"voiceline":"아아, 용암에 휘몰아치는 뜨거운 바람…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"내 힘 잘 봤지? 그러니까 지휘관, 마음껏 의지하라고♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/9703030/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_e