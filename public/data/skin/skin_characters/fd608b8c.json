[{"클뜯 id":404050,"클뜯 함순이 id":40405,"함순이 이름":"브륀힐드","한글 함순이 + 스킨 이름":"브륀힐드","영문 함순이 + 스킨 이름":"Brünhilde","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/404050/shipyard.png","설명":"O급 순양전함 - 브륀힐드","자기소개":{"voiceline":"메탈 블러드 소속 순양전함 브륀힐드다. 네가 봐 온 여러 메탈 블러드 동료들과 마찬가지로, 그 Z계획에서 완성되지 못한 전함이지. 임무에는 전력을 다할 생각이니, 안심하고 맡겨주길 바란다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/profile.ogg"},"메인1":{"voiceline":"가능하다면 내가 사용했던 무기는 폐기하지 말고, 그대로 남겨주었으면 한다. 다음에 이 아이들을 볼 때, 그 당시 함께 싸워준 동료들을 떠올릴 수 있게 해줄 테니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/main1.ogg"},"메인2":{"voiceline":"방금 목록을 다시 한번 확인할 수 있게 해줬으면 해. 사소한 실수로 실패가 초래되는 것만은 막고 싶으니 말이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/main2.ogg"},"메인3":{"voiceline":"책상 위에 있는 이 물건, 꽤나 세월이 느껴지는군. 어디서 손에 넣은 거지? 아니, 좀 흥미가 있어서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/main3.ogg"},"전투개시":{"voiceline":"탄약 냄새…. 전장이여! 내가 돌아왔다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/battle.ogg"},"상세확인":{"voiceline":"이 오르골이 신경 쓰이나? 그래, 이제는 세월이 흐른 탓에 소리도 안 나지만, 버리기는 아까워서 가지고 있을 뿐이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/detail.ogg"},"드랍 설명":{"voiceline":"O급 순양전함 - 브륀힐드","voicelink":null},"의뢰 완료":{"voiceline":"의뢰팀이 모항으로 귀환했군. 마중 나갈 약속을 했으니 어길 순 없다. 어서 가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/expedition.ogg"},"실망":{"voiceline":"계속 그런 패기 없는 태도를 유지하면, 나도 널 얕볼 수밖에 없다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/feeling1.ogg"},"낯섦":{"voiceline":"난 골동품을 좋아한다. 보고 있으면 나도 과거로 돌아간 것 같은 기분이 들지. 그렇지만 '과거'라는 말 자체는 나와 무척이나 거리가 있는 것 같군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/feeling2.ogg"},"호감":{"voiceline":"골동품을 좋아하는 건, 가지지 못하는 것에 대한 동경에 가깝지. '만약 그 시절에 태어났다면, 무엇이 바뀌었을까'……. 이런 생각이 드는 것도 사람의 본성인가.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/feeling3.ogg"},"기쁨":{"voiceline":"과거로 돌아가고 싶다고 생각한 적 있나? 젊었던 자신에 대한 그리움, 다시 경험하고 싶은 일, 그 당시의 억울함을 이번에야말로 해소하고 싶다고…… 그렇게 생각한 적 없나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/feeling4.ogg"},"사랑":{"voiceline":"과거를 그리워하기 보단, 미래에 대한 설렘이 앞선다라… 유능한 자의 답 그 자체로군. 그럼 나와 하나 약속하지. 네가 바라는 그 미래에 당도할 때까지, 발을 멈추지 않겠다고. 만약 언젠가 네가 포기한다면, 그때에는 지금 이 대화로 내가 널 다시 일으켜 세워주마.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"무사히 귀환했나? 전장은 잔혹하지. 한 번 승리를 거둔 걸로 들떠서는 안 된다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/home.ogg"},"hp 경고":{"voiceline":"이런 하찮은 찰과상 따윈….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/hp_warning.ogg"},"로그인":{"voiceline":"제시간에 사무를 처리하러 왔군. 아무리 의무라고는 해도, 그 의지만은 칭찬받아 마땅하다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/login.ogg"},"실패":{"voiceline":"아직은 발할라에 이를 때가 아니다……. 일단은 퇴각하자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/lose.ogg"},"우편":{"voiceline":"네게 온 우편이다. 휴우…. 아니, 갑자기 깃털펜으로 양피지에 뭘 쓰고 싶어져서….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/mail.ogg"},"임무":{"voiceline":"새 임무가 통달 됐군. 기대에 어긋나지 않도록 노력하자고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/mission.ogg"},"임무완료":{"voiceline":"벌써 임무를 완료한 건가? 효율이 괜찮군.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/mission_complete.ogg"},"서약":{"voiceline":"언젠가 미래에 시간의 룬이 각인된 이 반지를 보고 널 처음 만난 순간을 떠올릴지도 모르겠군. 절차탁마하면서 앞으로 나아가마. 같은 위업을 짊어진 존재인 너와 함께…….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/propose.ogg"},"스킬":{"voiceline":"핵심을 찌르고, 꿰뚫는다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/skill.ogg"},"터치1":{"voiceline":"본론으로 들어가지. 단도직입적인 편이 더 바람직하니.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/touch.ogg"},"터치2":{"voiceline":"언제쯤 그 버릇이 고쳐질지….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/touch2.ogg"},"입수시":{"voiceline":"메탈 블러드의 전사, 순양전함 브륀힐드다. 함께 위업을 짊어진 존재로서, 절차탁마하면서 앞으로 나아가자.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/unlock.ogg"},"강화성공":{"voiceline":"고맙다. 출격할 때 불러줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/upgrade.ogg"},"vote":null,"승리":{"voiceline":"기대는 저버리지 않는다. 그래, 그것이 여러 명의 기대라 할지라도.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"무사히 귀환한 모양이군. 수많은 혈전을 상처 하나 없이 헤쳐 오다니, 너 또한 역시 보통내기는 아닌 것 같군. 후후후.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/404050/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":null,"실패_ex":{"voiceline":"같이 사선을 넘나들 각오, 칭찬받아 마땅하다… 그렇지만 지금은 그럴 때가 아니다. 일단은 퇴각하자.","voicelink":"http