[{"클뜯 id":303100,"클뜯 함순이 id":30310,"함순이 이름":"하구로","한글 함순이 + 스킨 이름":"하구로","영문 함순이 + 스킨 이름":"Haguro","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303100/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303100/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303100/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303100/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303100/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/303100/shipyard.png","설명":"묘코급 중순양함 4번함 - 하구로","자기소개":{"voiceline":"묘코급 중순양함 하구로임다. 보이는 것처럼 평범한 중순양함이고, 그 대전에서는 야전 같은 데서 여러모로 분발했슴다. 행운함…? 뭐, 행운함이라는 소리를 들은 적은 있지만… 면전에서 그 말을 들으니 부끄럽슴다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/profile.ogg"},"메인1":{"voiceline":"집무실 청소 말임까? 알았슴다. 음, 그럼 15분 동안 자리 좀 비워주시겠음까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/main1.ogg"},"메인2":{"voiceline":"흐아아아아아암~ 아침부터 묘코 언니한테 설교나 듣질 않나, 아시가라 언니한테는 걱정을 받고, 꼴이 이게 뭠까…. 아니, 다들 하구로를 위해서 그러는 건 알고 있지만….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/main2.ogg"},"메인3":{"voiceline":"음? 나가시는 검까? 그럼 하구로도…. 왜 그러심까? 따라가도 별 상관 없는 거 아님까…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/main3.ogg"},"전투개시":{"voiceline":"슬슬 일 좀 해주겠슴다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/battle.ogg"},"상세확인":{"voiceline":"좀 졸리네……. 음? 왜냐니… 으음, 그게 당신하고 무슨 상관이… 그래도 지휘관이고, 숨겨서 좋을 건 없겠지…. 네, 게임임다! 어제 밤새워서 게임 했음다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/detail.ogg"},"드랍 설명":{"voiceline":"묘코급 중순양함 4번함 - 하구로","voicelink":null},"의뢰 완료":{"voiceline":"의뢰 완료임다. 뭐냐니, 마중 나갈 시간 아님까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/expedition.ogg"},"실망":{"voiceline":"……해치워버릴까. 농담임다. 지휘관에게 그런 짓을 하면 다들 슬퍼할 검다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/feeling1.ogg"},"낯섦":{"voiceline":"흐아아아암…. 졸림다…. 지휘관은 안 졸림까? 너무 무리하는 건 좋지 않슴다. 다른 아이들도 신경 쓴다고 무리하고 말테니 말임다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/feeling2.ogg"},"호감":{"voiceline":"그럼 오늘은 지휘관의 심야 경호를… 어? 아, 아직 안 자고 있는 검까?! 이럴 리가 없는데…. 하, 하구로는 그… 같이 게임할 사람을 찾는 중임다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/feeling3.ogg"},"기쁨":{"voiceline":"지휘관에게 거짓말한 건 잘못했슴다…. 졸렸던 건 다 게임 때문만은 아니고, 사실은 밤에도 임무 같은 걸 해서…. 피, 핑계 따위 뭐든 상관없지 않슴까! 그렇다고요괴짓이라고 하면 아무도 안 믿을 검다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/feeling4.ogg"},"사랑":{"voiceline":"에헤헤, 지휘관. 이런 시간에 실례해서 죄송함다. 그… 혹시 괜찮으면 게임, 같이 하지 않겠슴까? 오늘은 임무도 없고, 어차피 못 자고 있을 거 같아서……. 호, 혹시 민폐임까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/feeling5.ogg"},"터치3":{"voiceline":"으음…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/headtouch.ogg"},"모항귀환":{"voiceline":"하아~암. 아… 돌아오셨음까? 그럼, 하구로의 집보기도 끝…이 아니라 이제는 업무 봐야 하잖슴까….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/home.ogg"},"hp 경고":{"voiceline":"동료들을 지킬 수 있다면 행운따윈 없어도…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/hp_warning.ogg"},"로그인":{"voiceline":"좋은 아침~ 아, 벌써 왔음까? 빠르시네….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/login.ogg"},"실패":{"voiceline":"개열받네…. 하아, 철수함다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/lose.ogg"},"우편":{"voiceline":"우편임다. 네네, 지금 가져오겠슴다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/mail.ogg"},"임무":{"voiceline":"지휘관의 임무임다. 하구로는 지휘관이 맡긴 임무에 집중하고 있으니, 그쪽은 잘 부탁함다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/mission.ogg"},"임무완료":{"voiceline":"응? 임무가 완료됐음까? 잘 했슴다. 굿잡.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/mission_complete.ogg"},"서약":{"voiceline":"서, 서약 반지?! 이건 무슨 농담…은 아닌 것 같슴다. 물론 좋지만, 정말 하구로로 괜찮은 검까? 그, 그러니까… 하구로는 그… 야행성인데…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/propose.ogg"},"스킬":{"voiceline":"하구로의 움직임은 따라 잡을 수 없음다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/skill.ogg"},"터치1":{"voiceline":"음~ 아, 왜 그러심까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/touch.ogg"},"터치2":{"voiceline":"……???","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/touch2.ogg"},"입수시":{"voiceline":"당신이 지휘관…… 안녕하심까, 그럼 오늘부터 잘 부탁드림다. 앞으로 서로 폐를 끼치지 않는 선에서 편안하게 지냈으면 좋겠슴다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/unlock.ogg"},"강화성공":{"voiceline":"요새 유행하는 그런 것도 좀 달아 주시면…. 아무 것도 아님다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리임다. 음, 딱히 할 말은 없슴다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"오늘 하구로가 해야 할 임무는 뭠까? 없슴까? 그냥 충분히 수면을 취하라니… 그게 임무임까? 아니면 묘코 언니처럼 설교하시려는 검까? 어, 어느 쪽이든 하구로를 위한 거니까, 따르겠지만 말임다….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/303100/detail_ex.ogg"},"의뢰 완료_ex":{"voicel