[{"클뜯 id":301540,"클뜯 함순이 id":30154,"함순이 이름":"키요나미","한글 함순이 + 스킨 이름":"키요나미","영문 함순이 + 스킨 이름":"Kiyonami","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301540/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301540/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301540/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301540/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/301540/shipyard.png","설명":"유구모급 구축함 8번함—키요나미 ","자기소개":{"voiceline":"저는 유구모급 구축함 8호함, 키요나미 입니다...대공 능력이 강화되었지만, 하늘을 나는 건 역시.... 유구레 그때도 마찬가지고... 만약 내가 더 분발했었다면... 그, 그래도 커리어가 그리 길지는 않지만 키요나미 도 어느 정도 전적이 있습니다... 이, 이번에도 최선을 다할거에요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/profile.ogg"},"메인1":{"voiceline":"유구레와 같이 있으면 미묘한 안정감이 생겨요, 합숙할 때도 정말 기뻤답니다...유구레 같은 마음이 통하는 친구들을 더 많이 사귈 수 있기를...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/main1.ogg"},"메인2":{"voiceline":"우와아아아...또, 또 공습입니까!!??—...웅...지휘관님 이런 식으로 놀래키지 마세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/main2.ogg"},"메인3":{"voiceline":"키요나미 는 언제든 지휘관과 모두를 따라갈 수 있게 노력할 거에요. 그, 그러니까 저를 혼자두면 안됩니다...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/main3.ogg"},"전투개시":{"voiceline":"엑!? 제, 제가 모두를 이끌어요!? ...웅.....모, 모두 힘내!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/battle.ogg"},"상세확인":{"voiceline":"웅...키요나미 를 계, 계속 그렇게 빤히 쳐다보지 말아줄래요...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/detail.ogg"},"드랍 설명":{"voiceline":"유구모급 구축함 8번함—키요나미 ","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 항구로 돌아왔어요, 음... 저도 마중나가야 겠죠...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/expedition.ogg"},"실망":{"voiceline":"모두들 지휘관 뒷담화를 하는 것 같아요... 지휘관님은 정말 그렇게 형편없나요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/feeling1.ogg"},"낯섦":{"voiceline":"엣, 왜 항상 다른 사람 뒤에 있냐구요? 음, 저도 모르게 그만... 그런데 느낌상 지휘관님 뒤에서 따라가는 게 맞는 것 같아요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/feeling2.ogg"},"호감":{"voiceline":"웅... 바, 밤길은 역시 조금... 지휘관님... 업무가 늦게 끝나면 저를 숙소까지 바래다 줄 수 있나요?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/feeling3.ogg"},"기쁨":{"voiceline":"사실, 키요나미 는 토토 말고도 많은 \"털복숭이 친구\"들이 있어요, 다, 다음에 키요나미 의 \"털복숭이 보관실\" 구경하실래요, 지휘관님?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/feeling4.ogg"},"사랑":{"voiceline":"지휘관님과 함께 있으면 늦은 밤의 어둠이든, 하늘의 비행기든 무서울게 없을 것 같아요...! 음...다음번에는 뒤에서 따라가는 게 아니라, 앞에서 지휘관님을 보좌해도 될까요...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"지휘관님 수고했어요... 토, 토토 쓰다듬어 보실래요? 털이 보드라워서 힐링 된답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/home.ogg"},"hp 경고":{"voiceline":"저, 전 끝까지 견딜 수 있어요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/hp_warning.ogg"},"로그인":{"voiceline":"지휘관님 드디어 돌아오셨군요...토토, 지휘관님께 인사드려야지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/login.ogg"},"실패":{"voiceline":"웅... 오, 오지마세요...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/lose.ogg"},"우편":{"voiceline":"우편이 왔어요, 지휘관님 어서 확인해보세요!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/mail.ogg"},"임무":{"voiceline":"임무가 아직 많이 남은 것 같아요... 지휘관님, 괜찮죠?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/mission.ogg"},"임무완료":{"voiceline":"임무...완성한 것 같아요. 지휘관님 정말 대단하십니다...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/mission_complete.ogg"},"서약":{"voiceline":"이 의식을 치른 후에 항상 지휘관님의 곁에 있을 수 있나요? 너무 좋아요...음... 유구레가 준 노트는 일부분 이해되지 않지만, 지금은 눈을 감고 지휘관님의 행동을 기다려야겠네요...——","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/propose.ogg"},"스킬":{"voiceline":"가, 같이 본때를 보여주자, 토토야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/skill.ogg"},"터치1":{"voiceline":"이건 토토에요. 너무 귀엽지 않나요? 히힛. 키요나미 는 매일 토토와 함께 잔답니다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/touch.ogg"},"터치2":{"voiceline":"확실하진 않지만...그래도...아하하, 간지러워요... 지휘관님 그만해요, 하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/touch2.ogg"},"입수시":{"voiceline":"유구모급 구축함, 키요나미 입니다. 죄, 죄송해요...이건 저의 친구 토토입니다...자, 잘 부탁드립니다...! 웅...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/unlock.ogg"},"강화성공":{"voiceline":"토토야, 키요나미  좀 강해진 것 같지 않아...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/upgrade.ogg"},"vote":null,"승리":{"voiceline":"M, MVP가 키요나미 라고? 이럴 수가...몰래 카메라 아니죠...?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/301540/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['유구레'] : 음…유구레…나도 따라가도 돼...?","voicelink":null}],"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null