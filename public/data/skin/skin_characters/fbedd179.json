[{"클뜯 id":403050,"클뜯 함순이 id":40305,"함순이 이름":"아드미랄 그라프 슈피","한글 함순이 + 스킨 이름":"아드미랄 그라프 슈피","영문 함순이 + 스킨 이름":"Admiral Graf Spee","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403050/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403050/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403050/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403050/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403050/shipyard.png","설명":"도이칠란트급 초갑순양함 - 아드미랄 그라프 슈피","자기소개":{"voiceline":"메탈 블러드 해군 도이칠란트급 장갑함 3번함, 아드미랄 그라프 슈피. 로열 네이비 순양함의 공격을 받아, 몬테비데오 항으로 도망쳤지만, 결국은 자침했다……지휘관, 이번엔 마지막까지……싸우겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/profile.ogg"},"메인1":{"voiceline":"싸움은 살육을 위해 있는 게 아니라, 승리를 위한 것이야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/main1.ogg"},"메인2":{"voiceline":"첫 전투가 마지막이 된다니…우리 메탈 블러드에겐 딱히 드문 일도 아니야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/main2.ogg"},"메인3":{"voiceline":"다 함께 수다…라고? 늘 혼자였으니까, 모두의 앞에선 무슨 말을 하면 좋을지…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/main3.ogg"},"전투개시":{"voiceline":"메탈 블러드의 존엄과 이익을 위해, 무궁한 영광을!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/battle.ogg"},"상세확인":{"voiceline":"승리할 확률이 아무리 낮더라도, 전장으론 향할 거야……그렇게 하는 편이 인간들에게 동경 받을 수 있으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/detail.ogg"},"드랍 설명":{"voiceline":"도이칠란트급 초갑순양함 - 아드미랄 그라프 슈피","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 끝났다고? 그럼 기습당하지 않았단 얘기네. 다행이다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/expedition.ogg"},"실망":{"voiceline":"어떤 지휘관이라 해도, 그라프 슈피는 명령에 따를 뿐……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/feeling1.ogg"},"낯섦":{"voiceline":"줄곧 혼자서, 항해하고, 전투하고, 침몰하고……이런 나라도, 메탈 블러드 해군에 공헌했다 할 수 있을까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/feeling2.ogg"},"호감":{"voiceline":"이 손은 승리를 움켜쥐기 위해……소중한 사람을 두 번 다신 안을 수 없게 되어도, 어쩔 수 없는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/feeling3.ogg"},"기쁨":{"voiceline":"지휘관, 이번엔 혼자서 가라앉는 게 아니라, 당신과 함께 마지막을 맞이할 수 있을까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/feeling4.ogg"},"사랑":{"voiceline":"아무리 싸워도 마음의 틈이 메워지지 않아……그 원인은 당신이야……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/feeling5.ogg"},"터치3":{"voiceline":"지휘관, 그렇게 쓰담쓰담하지 말아줄래…?","voicelink":null},"모항귀환":{"voiceline":"지휘관, 모항이 봉쇄되지 않았는지 확인했지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/home.ogg"},"hp 경고":{"voiceline":"조금 더 견딜 수 있다면……!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/hp_warning.ogg"},"로그인":{"voiceline":"당신을 위해 마지막까지 싸울 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/login.ogg"},"실패":{"voiceline":"졌나……아직이야, 아직 끝나지 않아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/lose.ogg"},"우편":{"voiceline":"이 편지는…… 다행이다, 리나운과는 관계가 없어서.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/mail.ogg"},"임무":{"voiceline":"어떠한 임무라도, 하달된 이상 수행할 필요가 있는 거야.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403050/mission.ogg"},"임무완료":{"voiceline":"그 때의 나와는 다르게, 임무는 제대로 처리했네.","voicelink":"https://r