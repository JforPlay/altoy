[{"클뜯 id":202360,"클뜯 함순이 id":20236,"함순이 이름":"트리니다드","한글 함순이 + 스킨 이름":"트리니다드","영문 함순이 + 스킨 이름":"Trinidad","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202360/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202360/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202360/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202360/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202360/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/202360/shipyard.png","설명":"피지급 경순양함 - 트리니다드","자기소개":{"voiceline":"로열 네이비 소속인 트리니다드야. 나에 대해 더 알고 싶어? 그럼, 잘 봐. 빨간 네일부터 손끝에서 풍기는 향기까지…… 모든 부분에 지휘관에게 알려 주고 싶은 비밀이 숨어 있어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/profile.ogg"},"메인1":{"voiceline":"어머, 네일이 뭔가 느낌이 안 오네 . 저기, 지휘관. 지금 다시 발라도 돼?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/main1.ogg"},"메인2":{"voiceline":"지휘관, 같이 게임 할래? 내가 뒤에서 껴안고 누군지 맞추는 건데… 뭐, 맞출 필요도 없으려나♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/main2.ogg"},"메인3":{"voiceline":"또 일하는 거야~? 이제 좀 쉬었으면 하는데, 같이 홍차라도 마시는 건 어때? 뭐야~ 왜 이렇게 대답을 안 해?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/main3.ogg"},"전투개시":{"voiceline":"진지할 때의 내가 좋다고? 그럼 잘 봐.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/battle.ogg"},"상세확인":{"voiceline":"어머…… 빨간색을 너무 좋아하는 것 같다고? 아름답고도 위험한 색이라 나랑 잘 어울리는 것 같은데…… 지휘관 생각은 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/detail.ogg"},"드랍 설명":{"voiceline":"피지급 경순양함 - 트리니다드","voicelink":null},"의뢰 완료":{"voiceline":"지휘관, 의뢰팀 동료들이 돌아왔어. 같이 마중하러 갈래? 다녀오면서…… 잠깐 다른 곳도 들르고 말이야♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/expedition.ogg"},"실망":{"voiceline":"지휘관은 이런 사람이었구나… 실망이야. 아무래도 「사냥」을 재개해야겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/feeling1.ogg"},"낯섦":{"voiceline":"후후후…… 왠지 나를 경계하는 것 같네. 뭐, 좋아. 오히려 그런 「사냥감」이 더 재밌거든.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/feeling2.ogg"},"호감":{"voiceline":"지휘관, 얼굴이 아주 빨갛네…… 상상한 것보다 훨씬 더 재밌어. 더 보고 싶어졌어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/feeling3.ogg"},"기쁨":{"voiceline":"지휘관에게 다가갈 때마다 들리는 두근거리는 소리…… 지휘관한테 들리는 걸까? 아니면 나한테서 나는 걸까……? 재밌어……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/feeling4.ogg"},"사랑":{"voiceline":"어머, 내가 먼저 빠져들 줄이야… 쫓는 건지 쫓기는 건지, 결국은 어느 쪽인 거지…? 뭐, 이제 그런 건 별로 중요하지 않지만.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/feeling5.ogg"},"터치3":{"voiceline":"어머, 지휘관 손… 좀 차갑네. 내가 따뜻하게 해줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/headtouch.ogg"},"모항귀환":{"voiceline":"수고했어, 지휘관님. 힘들면…… 내 무릎 위에서 쉬게 해 줄까? 어머, 부끄러워하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/home.ogg"},"hp 경고":{"voiceline":"괜찮아. 진정한 사냥꾼은 늘 반격할 기회를 찾아내는 법이니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/hp_warning.ogg"},"로그인":{"voiceline":"옷깃이 조금 흐트러졌네. …내가 고쳐줄게. 겸사겸사 감성을 풍부하게 해줄 향수도 뿌려줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/login.ogg"},"실패":{"voiceline":"후우…… 좀 흥분한 것 같네……","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/lose.ogg"},"우편":{"voiceline":"지휘관, 새로운 우편이 있는데? 내가 귓가에 속삭여줄까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/mail.ogg"},"임무":{"voiceline":"어머… 아직 안 끝난 임무가 있잖아. 같이 처리할까? 게으름 피우면 안 돼~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/mission.ogg"},"임무완료":{"voiceline":"임무 보상을 아직 안 받았어…? 지휘관, 혹시 나한테 「특별한 보상」이라도 기대하고 있는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/mission_complete.ogg"},"서약":{"voiceline":"앞으로 지휘관은 내 유일한 「사냥감」이야…… 아, 「동반자」라고 하는 편이 더 맞으려나♡ 날 고른 건 지휘관이니까, 지휘관과 나의… 쫓고 쫓기는 게임…… 영원히 계속해 줘야겠어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/propose.ogg"},"스킬":{"voiceline":"잡았다…!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/skill.ogg"},"터치1":{"voiceline":"응? 계속 보고 있었는데, 왜?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/touch.ogg"},"터치2":{"voiceline":"아아… 오늘 지휘관은 적극적이네… 이대로 멈출 거야? 아니면… 계속할 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/touch2.ogg"},"입수시":{"voiceline":"후후후, 지휘관님이라… 참 재밌어 보여… 공격할지, 사냥감이 되어 도망다닐지… 어떤 걸 좋아하는지 내가 맞춰볼까♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/unlock.ogg"},"강화성공":{"voiceline":"후후후… 얼마나 성장했는지 확인해 볼래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/upgrade.ogg"},"vote":{"voiceline":"拉票描述","voicelink":null},"승리":{"voiceline":"어머, 지휘관. 시선이 아주 뜨겁네. 내 활약에 반하기라도 한 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"반지를 껴도 쫓고 쫓기는 게임은 끝나지 않아. 이런 긴장감을 유지하는 편이 더 재밌지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/202360/detail_ex.ogg"},"의뢰 완료_ex":null,"사랑_ex":{"voiceline":"후후후, 이제 보니 내가 지휘관의 「사냥감」이 되어버린 것