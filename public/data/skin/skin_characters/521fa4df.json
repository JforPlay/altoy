[{"클뜯 id":403090,"클뜯 함순이 id":40309,"함순이 이름":"프린츠 하인리히","한글 함순이 + 스킨 이름":"프린츠 하인리히","영문 함순이 + 스킨 이름":"Prinz Heinrich","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403090/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403090/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403090/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403090/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/403090/shipyard.png","설명":"P급 장갑함—프린츠 하인리히","자기소개":{"voiceline":"자기소개? 음, 내 이름은 \"프린츠 하인리히\"이고 \"P급 장갑함\"이야, 이거 외에는 별로 얘기할 게 없네. 음~~ 아이젠은? 지휘관한테 하고 싶은 말 있어~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/profile.ogg"},"메인1":{"voiceline":"지휘관이 찾는 문서는 바로, 여기 있다! 음, 못 맞혔나?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/main1.ogg"},"메인2":{"voiceline":"항구 내에 다른 진영에도 나처럼 함력이 없는 동료들이 꽤 있네~ 메탈 블러드에만 있는 줄 알았는데~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/main2.ogg"},"메인3":{"voiceline":"페터는 항상 나한테 여러 일들을 하라고 알려줘. 가끔 좀 귀찮긴 해도, 그녀가 없었으면 정말 어떻게 되었을지 모르지, 아하하~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/main3.ogg"},"전투개시":{"voiceline":"전원 돌격! Los! Los!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/battle.ogg"},"상세확인":{"voiceline":"음~ 어떻게 해야 사람들이 이 아이를 무서워하지 않을 수 있을까... 귀여운 포스트잇을 붙여볼까?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/detail.ogg"},"드랍 설명":{"voiceline":"Hallo, 지휘관! P급 장갑함 1호, 프린츠 하인리히가, 바로 나야! 여긴 내 파트너 \"아이젠\", 너도 지휘관한테 인사해!——아, 지휘관 옷은 물면 안돼!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰조가 돌아왔어~ 다음에도 내가 나갈게, 알았지 알았지~?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/expedition.ogg"},"실망":{"voiceline":"지휘관이 무슨 일을 겪어서 지금의 모습처럼 변했는지는 모르지만... 누군가 꼭 끌어당겨야 정신을 차릴 수 있다면 내가 하게 해줘! 아무 말도 하지말고, 내 손 꽉 잡아!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/feeling1.ogg"},"낯섦":{"voiceline":"과거에 아무것도 가진게 없다면, 앞만보고 전진하는 용기를 얻을 수 있다! 헤헤, 말 엄청 잘하지 않았어, 아이젠? 지휘관?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/feeling2.ogg"},"호감":{"voiceline":"항구에서 동료들의 이야기를 들었는데, 정말 재밌더라고~ 나도 그렇게 \"경력\"이 많았다면, 지금 어떤 모습일까? 상상만 해도 재밌을 것 같아~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/feeling3.ogg"},"기쁨":{"voiceline":"지휘관! 나한테 네 이야기를 해줄 수 있어? 용감한 지휘 경험도 좋고, 업무 중의 황당한 일도 좋아. 무슨 이야기든지 듣고 싶어! 헤헤~ 말해줘, 말해줘~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/feeling4.ogg"},"사랑":{"voiceline":"지휘관, 오늘도 데이트하자! 시간...? 놀만큼 놀고 돌아오자! 장소...? 가면서 생각해! 에이, 뭐든지 시작을 해야 결과가 있지~ 가자 가자!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/feeling5.ogg"},"터치3":{"voiceline":"어어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/headtouch.ogg"},"모항귀환":{"voiceline":"항구에 있기보다 바다에 나가는 게 더 재미있어~ 다음에 출격할 때도 나 데리고 가~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/home.ogg"},"hp 경고":{"voiceline":"아직 좀 더 버틸 수 있어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/hp_warning.ogg"},"로그인":{"voiceline":"어~서~와~! 같이 힘내서 새로운 하루를 맞이하자고! 헤헤~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/login.ogg"},"실패":{"voiceline":"엑——? 설마 지다니!?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/lose.ogg"},"우편":{"voiceline":"아, 우편 먹으면 안 돼, 그럼 지휘관이 곤란해 진다고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/mail.ogg"},"임무":{"voiceline":"새로운 임무가 있어? 나한테 맡겨! 내가 적을 싹 쓸어 버릴게~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/mission.ogg"},"임무완료":{"voiceline":"또 싸인하고, 또 도장 찍고, 임무 하나 완료하는데 정말 귀찮네... 음, 보상은 여기...","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/mission_complete.ogg"},"서약":{"voiceline":"음, 반지 말고도 뭐가 빠진 것 같은 느낌인데... 아, 그래! 이거지~ ...... (쪽) 헤헤~ 앞으로도 잘 부탁해, 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/propose.ogg"},"스킬":{"voiceline":"바로 지금이라고 말해!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/skill.ogg"},"터치1":{"voiceline":"음~~ 아~ 이렇게 오래 일했는데, 지휘관도 피곤하지? 같이 어디 좀 가서 걸을까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/touch.ogg"},"터치2":{"voiceline":"Stooooop! 여기까지야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/touch2.ogg"},"입수시":{"voiceline":"Hallo, 지휘관! P급 장갑함 1호, 프린츠 하인리히가, 바로 나야! 여긴 내 파트너 \"아이젠\", 너도 지휘관한테 인사해!——아, 지휘관 옷은 물면 안돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/unlock.ogg"},"강화성공":{"voiceline":"강! 해! 졌! 다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/upgrade.ogg"},"vote":null,"승리":{"voiceline":"승리와 MVP 전부 내 차지! 하하~♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":{"voiceline":"와악, 함부로 움직이지마, 아이젠! 붙일 수가 없잖아! 지휘관, 도와줘!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/detail_ex.ogg"},"의뢰 완료_ex":{"voiceline":"내가 의뢰조 동료들을 돌려보내주고 왔어! 하하, 네가 그랬잖아, 내가 맞이하러 가도 된다고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/expedition_ex.ogg"},"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":{"voiceline":"다음엔 날 출격시켜 주거나, 나랑 같이 놀거나, 하나 골라! 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/home_ex.ogg"},"hp 경고_ex":null,"로그인_ex":{"voiceline":"어~서~와~! 오늘도 함께 힘내자! 지휘관!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/login_ex.ogg"},"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":{"voiceline":"지휘관 좀 못됐다. 나에게 이런 잘 못하는 문서 작업을 시키다니... 다하면 같이 보상 받으러 가자고? 그럼 좀 더 참고 해볼게.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/mission_complete_ex.ogg"},"스킬_ex":null,"터치1_ex":{"voiceline":"아, 또 하품했네. 지휘관, 차라리 밖에 나가서 좀 걸을래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/touch_ex.ogg"},"터치2_ex":{"voiceline":"왓!? 정말이지, 지휘관 너일줄 바로 알았어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/touch2_ex.ogg"},"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":[{"voiceline":"['라이프치히', '뉘른베르크'] : 아, 물고기 놀래키지면 안돼!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/couple_encourage1.ogg"},{"voiceline":"['도이칠란트', '아드미랄 그라프 슈피'] : 장갑함 돌격!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/couple_encourage2.ogg"}],"메인4":null,"메인1_ex":{"voiceline":"지휘관이 찾는 문서는 바로, 이거지? 헤헤, 안심하고 나한테 맡기라니까~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/main1_ex.ogg"},"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":{"voiceline":"오오~ 모두 신나게 떠들고 있네! 무슨 얘기해? ...\"만약 그때 건조되었다면...\"——음~~ 나라면 지휘관이 있는 이곳으로만 올 수 있으면 사실 상관없어~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/403090/main2_ex.ogg"},"메인3_ex":{"voiceline":"덤벼라, 정신적 지주! 네가 장갑함으로서 내린 결심