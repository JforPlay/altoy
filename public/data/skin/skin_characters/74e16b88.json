[{"클뜯 id":105130,"클뜯 함순이 id":10513,"함순이 이름":"워싱턴","한글 함순이 + 스킨 이름":"워싱턴","영문 함순이 + 스킨 이름":"Washington","스킨 타입":"Default","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105130/painting.png","확대 일러":null,"sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105130/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105130/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105130/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105130/shipyard.png","설명":"노스캐롤라이나급 전함 워싱턴 (BB-56)","자기소개":{"voiceline":"노스캐롤라이나 2번함이 바로 나다. 좋아하는 것은 적을 쳐부수는 것, 최근에는 스마일 연습을 하고 있지. …내 전투 성과? 그리 자랑스럽게 떠벌릴만한 건 아니어서 말이야. 뭐 어쨌든 이 스마일, 어떤 것 같아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/profile.ogg"},"메인1":{"voiceline":"좋은 미소라고? 이 자식…이 아니지. 웃자 웃자~ 감사합니다♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/main1.ogg"},"메인2":{"voiceline":"흥, 그 사우스다코타는 여전하구나. 지휘관 여기 좀 봐줘, 내가 그 녀석보다 훨씬 귀엽지 않아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/main2.ogg"},"메인3":{"voiceline":"친구인지 아닌지를 판단하는 것은 말이 아니라 행동이다. 그래서 저렇게 말만 번지르르한 놈들이 정말 싫어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/main3.ogg"},"전투개시":{"voiceline":"좋아, 운동이라도 해볼까","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/battle.ogg"},"상세확인":{"voiceline":"뭐? 내가 얼마나 강한지 보고 싶다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/detail.ogg"},"드랍 설명":{"voiceline":"노스캐롤라이나급 전함 워싱턴 (BB-56)","voicelink":null},"의뢰 완료":{"voiceline":"혹시 나보다 건망증 심한 건 아니겠지? 의뢰가 완료 됐다구, 마중 안 나갈 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/expedition.ogg"},"실망":{"voiceline":"네 녀석 약하구나. 이래선 끝까지 함께하기 어렵다고. 다시 단련하고 오도록","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/feeling1.ogg"},"낯섦":{"voiceline":"어떻게 해야 자연스럽게 웃을 수 있을까… 좋아하는 것을 생각해 본다거나? 그러고 보니, 사우스다코타에게 이겼을 때를 떠올리면 꽤 즐거워지지… 헤헤…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/feeling2.ogg"},"호감":{"voiceline":"아냐 아냐, 이러면 옛날이랑 바뀐 게 없잖아… 무리하지 않아도 된다고? 너 말야, 가끔은 좋은 말도 하는구나… 엇, 지금이 좋다고?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/feeling3.ogg"},"기쁨":{"voiceline":"요즘 내 웃음이 자연스러워 진 것 같다고? 음…뭐, 그 뭐냐, 새로운 취미라도 만들까 생각했거든, 그러면 너랑 같이 있는 편이 좋을 거라고…","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/feeling4.ogg"},"사랑":{"voiceline":"너를 보면 무심코 웃어버리게 돼, 이런 느낌은 처음이라… 그리고 말이야, 네가 괴롭힘을 당하면 어떤 표정이 될지도 보고 싶어져서 말이야~ 지휘관, 잠깐 나와봐♪","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"안 다쳐서 다행이다~ 뭐? 너한테 말한 거 아니거든!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/home.ogg"},"hp 경고":{"voiceline":"승리를 그렇게 간단히 뺏길까보냐!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/hp_warning.ogg"},"로그인":{"voiceline":"어서 오세요~ …이 스마일, 어때?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/login.ogg"},"실패":{"voiceline":"칫, 기억해둬라!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/lose.ogg"},"우편":{"voiceline":"어이, 네 앞으로 온 편지다.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/mail.ogg"},"임무":{"voiceline":"새로운 미션? 하하, 피가 끓어 오르는군!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/mission.ogg"},"임무완료":{"voiceline":"보너스는 직접 받아. 난 흥미 없으니까.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/mission_complete.ogg"},"서약":{"voiceline":"…잠깐, 그만그만그만! 이거, 그거지?! 날 놀리려고 준비한 거지!? …이 녀석…! 정말 이런 거 울어야 할지 웃어야 할지 모르겠어….","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/propose.ogg"},"스킬":{"voiceline":"비켜! 내가 하겠어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/skill.ogg"},"터치1":{"voiceline":"맘대로 친한 척 하면서 만지지 말라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/touch.ogg"},"터치2":{"voiceline":"…죽고 싶냐? (썩소)","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/touch2.ogg"},"입수시":{"voiceline":"여어, 지휘관. 나는 워싱턴이라고 해. 언니가 함대에 참가 할 거면 예전처럼 굴어선 안된다고 해서 말야, 스마일 연습을 하고는 있지만… 정말, 왜 시키는 대로 해야 하는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/unlock.ogg"},"강화성공":{"voiceline":"강해진 느낌은 나쁘지 않군","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/upgrade.ogg"},"vote":null,"승리":{"voiceline":"역시 적을 쳐부술 때가 제일 즐겁군~","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105130/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":null,"상점 id":0,"상점 카테고리 id":0,"스킨 태그":"X","입수 영상":"X","재화":null,"기간":null,"진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":105131,"클뜯 함순이 id":10513,"함순이 이름":"워싱턴","한글 함순이 + 스킨 이름":"스마일리 애니버서리","영문 함순이 + 스킨 이름":"Jubilant Smile","스킨 타입":"Empery'S Fineries","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105131/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105131/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105131/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105131/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105131/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105131/shipyard.png","설명":"오, 지휘관… 내 옷차림? 딱히 특별한 건 없어… 설마 지금 이상한 거 생각하고 있진 않겠지?… 확 날려 버린다!","자기소개":null,"메인1":{"voiceline":"어, 어서 오세요♪ …이게 아니지, 언니는 어떻게 했더라…?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/main1.ogg"},"메인2":{"voiceline":"사우스다코타의 피아노? 내 기량이 그렇게 뛰어난 건 아니라 비교해봤자 어쩔 도리가 없지…. 조금은 분하네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/main2.ogg"},"메인3":{"voiceline":"내뱉은 말에는 책임을 져야지, 지휘관. 오늘 인사하러 다닐 때는 나도 데리고 가줘.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/main3.ogg"},"전투개시":{"voiceline":"우리가 이기는 게 당연하잖아?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/battle.ogg"},"상세확인":{"voiceline":"맛있는 밥을 먹고, 맛있는 술을 마시면 자연스레 미소가 지어진다…라. 네 말대로야…. 그 말은 즉, 이제는 연습하지 않아도 된다는 거네?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/detail.ogg"},"드랍 설명":{"voiceline":"오, 지휘관… 내 옷차림? 딱히 특별한 건 없어… 설마 지금 이상한 거 생각하고 있진 않겠지?… 확 날려 버린다!","voicelink":null},"의뢰 완료":{"voiceline":"큰일이야, 의뢰팀 아이들이… 지휘관은 기억하고 있었구나. 역시 대단해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"후후후, 그래서 사우스다코타 녀석이랑… 아니, 내가 왜 이렇게 뭘 장황하게 떠들고 있는 거지? 너도 뭐 재밌는 이야기라도 해봐! 네 바람대로 충분히 웃어줬잖아…///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/feeling5.ogg"},"터치3":null,"모항귀환":{"voiceline":"상처가 없어서 다행이야. …아, 아니… 너 말하는 건…데……?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"그 히죽거리는 표정 좀 거둬주지 그래? …아니, 무슨 생각 하는지 뻔히 들여다보인다고! 언니 같은 그런 옷, 오늘은 절대 안 입을 거야!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/login.ogg"},"실패":null,"우편":null,"임무":{"voiceline":"새로운 미션이야. 식후 운동에 딱 좋을 것 같네.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/mission.ogg"},"임무완료":{"voiceline":"보너스는 수령했어? 아니, 딱히 궁금한 건 아니라고!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"벌써 쉬려고? 앉고 싶은 데 앉아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/touch.ogg"},"터치2":{"voiceline":"…?! 취했어?!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/touch2.ogg"},"입수시":{"voiceline":"오, 지휘관… 내 옷차림? 딱히 특별한 건 없어… 설마 지금 이상한 거 생각하고 있진 않겠지?… 확 날려 버린다!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/unlock.ogg"},"강화성공":null,"vote":null,"승리":{"voiceline":"축배를 들고 싶은 기분이네! 너도 그래?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105131/win_mvp.ogg"},"전투개시_ex":null,"상세확인_ex":null,"의뢰 완료_ex":null,"사랑_ex":null,"터치3_ex":null,"모항귀환_ex":null,"hp 경고_ex":null,"로그인_ex":null,"실패_ex":null,"우편_ex":null,"임무_ex":null,"임무완료_ex":null,"스킬_ex":null,"터치1_ex":null,"터치2_ex":null,"입수시_ex":null,"강화성공_ex":null,"승리_ex":null,"함대 특수대사":null,"메인4":null,"메인1_ex":null,"메인5_ex":null,"메인6_ex":null,"메인7_ex":null,"메인8_ex":null,"메인4_ex":null,"메인5":null,"메인6":null,"메인2_ex":null,"메인3_ex":null,"메인9_ex":null,"메인10_ex":null,"메인7":null,"스킨 타입 - 한글":"이스트 글림 스타일","상점 id":70708,"상점 카테고리 id":3,"스킨 태그":"배경","입수 영상":"X","재화":880,"기간":"상시","진영":"USS","레어도":"SSR","ex_chat_status":0},{"클뜯 id":105132,"클뜯 함순이 id":10513,"함순이 이름":"워싱턴","한글 함순이 + 스킨 이름":"야밤의 순회 진료","영문 함순이 + 스킨 이름":"Making the Rounds","스킨 타입":"Hospital Series","전체 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105132/painting.png","확대 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105132/painting_n.png","sd 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105132/chibi.png","아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105132/icon.png","쥬스타 아이콘 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105132/qicon.png","깔끔한 일러":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/images/skin/105132/shipyard.png","설명":"여어, 지휘관. 너스콜 누른 거 맞지? …안 눌렀다고? 음…… 누른 거 맞잖아!! 잘 들어! 환자면 환자답게 일은 멈추고 얌전히 진찰받아!","자기소개":null,"메인1":{"voiceline":"흥… 어쩌다 내가 당직을 서고 있던 것뿐이야… 그나저나 정말 체온이 올라가고 있네. 자세히 진찰하는 편이 좋겠어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/main1.ogg"},"메인2":{"voiceline":"정말 너스콜 울린 거 맞냐고? 안 그랬으면 이렇게 일부러 찾아왔겠어?! 삐비비비빅! 봐, 이제 알겠지? 순순히 진찰에 협조해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/main2.ogg"},"메인3":{"voiceline":"간호사로서 환자를 상냥하게 대해야 하지만, 지휘관이 말을 안 들으면… 억지로라도 듣게 해야겠지?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/main3.ogg"},"전투개시":null,"상세확인":{"voiceline":"지휘관… 그렇게 뚫어져라 보지 말라고. 간호사복이 그렇게 신기해? 난 그저 간호사로서의 책무를 다하러 온 것뿐이라고… 그러니까 그런 눈으로 보지 마!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/detail.ogg"},"드랍 설명":{"voiceline":"여어, 지휘관. 너스콜 누른 거 맞지? …안 눌렀다고? 음…… 누른 거 맞잖아!! 잘 들어! 환자면 환자답게 일은 멈추고 얌전히 진찰받아!","voicelink":null},"의뢰 완료":{"voiceline":"의뢰가 끝났다고? …마중 나가는 건 전체 검사가 끝난 다음에 하라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/expedition.ogg"},"실망":null,"낯섦":null,"호감":null,"기쁨":null,"사랑":{"voiceline":"잠깐, 너… 왜 갑자기 심박수가 상승하는 거야?! 내가 가까이 있어서 그렇다니… 이거 진찰이니까 어쩔 수 없잖아…! 아무튼 이대로 내버려둘 순 없으니, 간호 태세를 강화해야겠어. 오늘 밤은 곁에서 계속 돌봐줄 테니, 각오하라고. ///","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/feeling5.ogg"},"터치3":{"voiceline":"화, 환자면 환자답게 굴어!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/headtouch.ogg"},"모항귀환":{"voiceline":"너무 내 시야에서 벗어나지 마… 크흠! 한밤중에 돌아다니면 위험하니까 그래! 너는 환자잖아.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/home.ogg"},"hp 경고":null,"로그인":{"voiceline":"(웃어, 웃어야지…) 지휘관, 준비됐어? 작전 데이터는 저장하고 그만 진찰 받…… 뭘 그렇게 뚫어져라 보는 거야?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/login.ogg"},"실패":null,"우편":{"voiceline":"우편이 새로 왔다고? ……이런 상황에서 무슨 일을 한다고… 압수다, 압수!","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/mail.ogg"},"임무":{"voiceline":"아직 임무가 남았다고? 흥, 지금은 얌전히 쉬고나 있으라고.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/mission.ogg"},"임무완료":{"voiceline":"보너스가 뭐가 중요해. 지금은 진찰에 집중해.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/mission_complete.ogg"},"서약":null,"스킬":null,"터치1":{"voiceline":"진찰 중이야. 가만히 있어.","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/touch.ogg"},"터치2":{"voiceline":"아… 이거 상당히 위중한데~ 즉시 응급 처치를 실시해야겠는걸?","voicelink":"https://raw.githubusercontent.com/Fernando2603/AzurLane/main/audio/voiceline/105132/touch2.ogg"},"입수시":{"voiceline":"여어, 지휘관. 너스콜 누른 거 맞지? …안 눌렀다고? 음…… 누른 거 맞잖아!! 잘 들어! 환자면 환자답게 일은 멈추고 얌전히 진찰받아!","voicelink":"https://raw.githubusercontent.com/Fernando26