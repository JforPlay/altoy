{
  "name": "altoy",
  "type": "module",
  "version": "1.0.0",
  "description": "ALtoy - Azur Lane KR fan-made web viewer",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "predev": "npm run data:sync",
    "prestart": "npm run data:sync",
    "data:sync": "node scripts/sync-data.mjs",
    "data:split": "node scripts/split_story_data.mjs && node scripts/split_skin_data.mjs && node scripts/split_simulator_data.mjs && node scripts/split_skin_poll_data.mjs",
    "data:hearing": "node scripts/sync-equip-hearing.mjs",
    "data:skin-labels": "node scripts/sync-skin-labels.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:data": "node scripts/check-data-shape.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "lint": "eslint .",
    "report:route-boot": "node scripts/report-route-boot.mjs",
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "test:smoke": "playwright test",
    "build": "npm run data:sync && npm run check:versions && npm run check:data && npm run data:split && astro build && node scripts/minify.mjs",
    "build:no-minify": "npm run data:sync && npm run check:versions && npm run check:data && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@astrojs/compiler": "^4.0.0",
    "@playwright/test": "^1.60.0",
    "acorn": "^8.15.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "sharp": "^0.34.5",
    "terser": "^5.46.0"
  }
}
