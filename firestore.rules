rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Metadata: anyone authenticated can read
    match /metadata/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User votes: users can only read their own doc
    match /user_votes/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Vote queue: authenticated users can only create their own votes
    match /vote_queue/{voteId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.clientId is string
        && request.resource.data.skinName is string
        && request.resource.data.characterName is string;
      allow read, update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
